 xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\"viewBox=\"0 0 24 24\"\n","       width=\"24px\"\u003e\n","    \u003cpath d=\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\"/\u003e\n","  \u003c/svg\u003e\n","    \u003c/button\u003e\n","    \u003cscript\u003e\n","      (() =\u003e {\n","      const buttonEl =\n","        document.querySelector('#id_d1ce4f2c-ea1f-42bb-80ed-27148bafd9e2 button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () =\u003e {\n","        google.colab.notebook.generateWithVariable('screening_comparison');\n","      }\n","      })();\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","    \u003c/div\u003e\n","  \u003c/div\u003e\n"],"text/plain":["                           Measure  Expected  Observed  Matches\n","0                      TotalBuilds       378       378     True\n","1             TrainingPeriodBuilds       283       283     True\n","2           EvaluationPeriodBuilds        95        95     True\n","3                 RawExecutionRows     14057     14057     True\n","4            TrainingExecutionRows      9422      9422     True\n","5          EvaluationExecutionRows      4635      4635     True\n","6                ModelTrainingRows      2320      2320     True\n","7              ModelTrainingBuilds        57        57     True\n","8              ModelEvaluationRows       980       980     True\n","9            ModelEvaluationBuilds        20        20     True\n","10             ModelTrainingPasses      2256      2256     True\n","11           ModelTrainingFailures        64        64     True\n","12           ModelEvaluationPasses       958       958     True\n","13         ModelEvaluationFailures        22        22     True\n","14          MissingBuildTimestamps         0         0     True\n","15        UnmatchedExecutionBuilds         0         0     True\n","16          UnmatchedDatasetBuilds         0         0     True\n","17  DuplicateDatasetBuildTestPairs         0         0     True\n","18       MissingExecutionDurations         0         0     True"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","SUCCESS: Paho MQTT is loaded, chronologically split, and matches the saved screening results.\n"]}],"source":["# =========================================================\n","# PROJECT 4: PAHO MQTT — LOAD, SPLIT, AND VERIFY\n","# =========================================================\n","\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","PROJECT_NUMBER = 4\n","PROJECT_NAME = \"eclipse@paho.mqtt.java\"\n","PROJECT_SLUG = \"eclipse__paho.mqtt.java\"\n","\n","EXTRACT_ROOT = Path(\n","    \"/content/working_data/tcp_ci_full\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 1. Locate Project 4\n","# ---------------------------------------------------------\n","\n","project_matches = [\n","    dataset_file.parent\n","    for dataset_file in EXTRACT_ROOT.rglob(\n","        \"dataset.csv\"\n","    )\n","    if dataset_file.parent.name == PROJECT_NAME\n","]\n","\n","if len(project_matches) != 1:\n","    raise RuntimeError(\n","        f\"Expected exactly one {PROJECT_NAME} folder, \"\n","        f\"but found {len(project_matches)}.\"\n","    )\n","\n","PROJECT_PATH = project_matches[0]\n","\n","print(\"=== PROJECT 4: PAHO MQTT ===\")\n","print(\"Project:\", PROJECT_NAME)\n","print(\"Path:\", PROJECT_PATH)\n","\n","\n","# ---------------------------------------------------------\n","# 2. Obtain the saved screening expectations\n","# ---------------------------------------------------------\n","\n","project_screening_rows = (\n","    screening[\n","        screening[\"Project\"] == PROJECT_NAME\n","    ]\n","    .copy()\n",")\n","\n","if len(project_screening_rows) != 1:\n","    raise RuntimeError(\n","        \"Expected exactly one Paho MQTT screening row.\"\n","    )\n","\n","project_screening_row = (\n","    project_screening_rows.iloc[0]\n",")\n","\n","\n","def expected_integer(column_name):\n","    value = project_screening_row[\n","        column_name\n","    ]\n","\n","    if pd.isna(value):\n","        raise ValueError(\n","            f\"Screening value {column_name} is missing.\"\n","        )\n","\n","    return int(value)\n","\n","\n","# ---------------------------------------------------------\n","# 3. Load the six TCP-CI project files\n","# ---------------------------------------------------------\n","\n","required_files = [\n","    \"builds.csv\",\n","    \"exe.csv\",\n","    \"dataset.csv\",\n","    \"entity_change_history.csv\",\n","    \"id_map.csv\",\n","    \"contributors.csv\",\n","]\n","\n","missing_files = [\n","    file_name\n","    for file_name in required_files\n","    if not (\n","        PROJECT_PATH / file_name\n","    ).exists()\n","]\n","\n","if missing_files:\n","    raise FileNotFoundError(\n","        \"Paho MQTT is missing required files:\\n\"\n","        + \"\\n\".join(missing_files)\n","    )\n","\n","\n","builds_raw = pd.read_csv(\n","    PROJECT_PATH / \"builds.csv\"\n",")\n","\n","exe = pd.read_csv(\n","    PROJECT_PATH / \"exe.csv\"\n",")\n","\n","dataset = pd.read_csv(\n","    PROJECT_PATH / \"dataset.csv\"\n",")\n","\n","entity_change_history = pd.read_csv(\n","    PROJECT_PATH / \"entity_change_history.csv\"\n",")\n","\n","id_map = pd.read_csv(\n","    PROJECT_PATH / \"id_map.csv\"\n",")\n","\n","contributors = pd.read_csv(\n","    PROJECT_PATH / \"contributors.csv\"\n",")\n","\n","\n","# Compatibility variable used by later cells.\n","entity_change = (\n","    entity_change_history.copy()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Validate essential columns\n","# ---------------------------------------------------------\n","\n","required_build_columns = {\n","    \"id\",\n","    \"commits\",\n","    \"started_at\",\n","}\n","\n","required_execution_columns = {\n","    \"build\",\n","    \"test\",\n","    \"verdict\",\n","    \"duration\",\n","}\n","\n","required_dataset_columns = {\n","    \"Build\",\n","    \"Test\",\n","    \"Verdict\",\n","    \"Duration\",\n","}\n","\n","\n","if not required_build_columns.issubset(\n","    builds_raw.columns\n","):\n","    raise RuntimeError(\n","        \"builds.csv is missing required columns.\"\n","    )\n","\n","if not required_execution_columns.issubset(\n","    exe.columns\n","):\n","    raise RuntimeError(\n","        \"exe.csv is missing required columns.\"\n","    )\n","\n","if not required_dataset_columns.issubset(\n","    dataset.columns\n","):\n","    raise RuntimeError(\n","        \"dataset.csv is missing required columns.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Prepare chronological build table\n","# ---------------------------------------------------------\n","\n","builds_checked = (\n","    builds_raw.copy()\n",")\n","\n","builds_checked[\"id\"] = pd.to_numeric(\n","    builds_checked[\"id\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","builds_checked[\"started_at\"] = pd.to_datetime(\n","    builds_checked[\"started_at\"],\n","    errors=\"coerce\",\n","    utc=True,\n",")\n","\n","missing_build_timestamps = int(\n","    builds_checked[\n","        \"started_at\"\n","    ].isna().sum()\n",")\n","\n","builds_checked = (\n","    builds_checked\n","    .sort_values(\n","        [\n","            \"started_at\",\n","            \"id\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","builds_checked[\"build_order\"] = np.arange(\n","    1,\n","    len(builds_checked) + 1,\n",")\n","\n","builds = (\n","    builds_checked.copy()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Fixed chronological 75/25 split\n","# ---------------------------------------------------------\n","\n","split_index = int(\n","    np.floor(\n","        len(builds_checked) * 0.75\n","    )\n",")\n","\n","training_build_table = (\n","    builds_checked\n","    .iloc[:split_index]\n","    .copy()\n",")\n","\n","evaluation_build_table = (\n","    builds_checked\n","    .iloc[split_index:]\n","    .copy()\n",")\n","\n","training_build_ids = set(\n","    training_build_table[\n","        \"id\"\n","    ].astype(int)\n",")\n","\n","evaluation_build_ids = set(\n","    evaluation_build_table[\n","        \"id\"\n","    ].astype(int)\n",")\n","\n","\n","if training_build_ids.intersection(\n","    evaluation_build_ids\n","):\n","    raise AssertionError(\n","        \"Training and evaluation build IDs overlap.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Prepare raw execution history\n","# ---------------------------------------------------------\n","\n","for column in [\n","    \"build\",\n","    \"test\",\n","    \"verdict\",\n","]:\n","    exe[column] = pd.to_numeric(\n","        exe[column],\n","        errors=\"raise\",\n","    ).astype(int)\n","\n","exe[\"duration\"] = pd.to_numeric(\n","    exe[\"duration\"],\n","    errors=\"coerce\",\n",").astype(float)\n","\n","\n","build_order_map = (\n","    builds_checked\n","    .set_index(\"id\")[\n","        \"build_order\"\n","    ]\n","    .to_dict()\n",")\n","\n","exe_for_rec = (\n","    exe.copy()\n",")\n","\n","exe_for_rec[\"build_order\"] = (\n","    exe_for_rec[\"build\"]\n","    .map(build_order_map)\n",")\n","\n","\n","unmatched_execution_builds = int(\n","    exe_for_rec.loc[\n","        exe_for_rec[\n","            \"build_order\"\n","        ].isna(),\n","        \"build\",\n","    ].nunique()\n",")\n","\n","missing_execution_durations = int(\n","    exe_for_rec[\n","        \"duration\"\n","    ].isna().sum()\n",")\n","\n","\n","sort_columns = [\n","    \"build_order\",\n","]\n","\n","if \"job\" in exe_for_rec.columns:\n","    sort_columns.append(\n","        \"job\"\n","    )\n","\n","sort_columns.append(\n","    \"test\"\n",")\n","\n","exe_for_rec = (\n","    exe_for_rec\n","    .sort_values(\n","        sort_columns,\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","clean_training_history = (\n","    exe_for_rec[\n","        exe_for_rec[\"build\"].isin(\n","            training_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","clean_evaluation_history = (\n","    exe_for_rec[\n","        exe_for_rec[\"build\"].isin(\n","            evaluation_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Prepare model-ready dataset\n","# ---------------------------------------------------------\n","\n","for column in [\n","    \"Build\",\n","    \"Test\",\n","    \"Verdict\",\n","]:\n","    dataset[column] = pd.to_numeric(\n","        dataset[column],\n","        errors=\"raise\",\n","    ).astype(int)\n","\n","dataset[\"Duration\"] = pd.to_numeric(\n","    dataset[\"Duration\"],\n","    errors=\"coerce\",\n",").astype(float)\n","\n","\n","dataset_with_order = (\n","    dataset.copy()\n",")\n","\n","dataset_with_order[\n","    \"build_order\"\n","] = (\n","    dataset_with_order[\"Build\"]\n","    .map(build_order_map)\n",")\n","\n","\n","unmatched_dataset_builds = int(\n","    dataset_with_order.loc[\n","        dataset_with_order[\n","            \"build_order\"\n","        ].isna(),\n","        \"Build\",\n","    ].nunique()\n",")\n","\n","duplicate_dataset_build_test_pairs = int(\n","    dataset_with_order\n","    .duplicated(\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    )\n","    .sum()\n",")\n","\n","\n","dataset_with_order = (\n","    dataset_with_order\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"Test\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","clean_training_data = (\n","    dataset_with_order[\n","        dataset_with_order[\n","            \"Build\"\n","        ].isin(\n","            training_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","clean_evaluation_data = (\n","    dataset_with_order[\n","        dataset_with_order[\n","            \"Build\"\n","        ].isin(\n","            evaluation_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 9. Feature definitions\n","# ---------------------------------------------------------\n","\n","REC_FEATURE_COLUMNS = [\n","    column\n","    for column in dataset.columns\n","    if column.startswith(\"REC_\")\n","]\n","\n","MODEL_FEATURE_COLUMNS = [\n","    column\n","    for column in dataset.columns\n","    if column not in {\n","        \"Build\",\n","        \"Test\",\n","        \"Verdict\",\n","        \"Duration\",\n","    }\n","]\n","\n","\n","y_train_clean = (\n","    clean_training_data[\n","        \"Verdict\"\n","    ] != 0\n",").astype(int)\n","\n","y_evaluation_clean = (\n","    clean_evaluation_data[\n","        \"Verdict\"\n","    ] != 0\n",").astype(int)\n","\n","\n","# ---------------------------------------------------------\n","# 10. Calculate observed project counts\n","# ---------------------------------------------------------\n","\n","observed_counts = {\n","    \"TotalBuilds\":\n","        len(builds_checked),\n","\n","    \"TrainingPeriodBuilds\":\n","        len(training_build_ids),\n","\n","    \"EvaluationPeriodBuilds\":\n","        len(evaluation_build_ids),\n","\n","    \"RawExecutionRows\":\n","        len(exe_for_rec),\n","\n","    \"TrainingExecutionRows\":\n","        len(clean_training_history),\n","\n","    \"EvaluationExecutionRows\":\n","        len(clean_evaluation_history),\n","\n","    \"ModelTrainingRows\":\n","        len(clean_training_data),\n","\n","    \"ModelTrainingBuilds\":\n","        clean_training_data[\n","            \"Build\"\n","        ].nunique(),\n","\n","    \"ModelEvaluationRows\":\n","        len(clean_evaluation_data),\n","\n","    \"ModelEvaluationBuilds\":\n","        clean_evaluation_data[\n","            \"Build\"\n","        ].nunique(),\n","\n","    \"ModelTrainingPasses\":\n","        int(\n","            (y_train_clean == 0).sum()\n","        ),\n","\n","    \"ModelTrainingFailures\":\n","        int(\n","            (y_train_clean == 1).sum()\n","        ),\n","\n","    \"ModelEvaluationPasses\":\n","        int(\n","            (y_evaluation_clean == 0).sum()\n","        ),\n","\n","    \"ModelEvaluationFailures\":\n","        int(\n","            (y_evaluation_clean == 1).sum()\n","        ),\n","\n","    \"MissingBuildTimestamps\":\n","        missing_build_timestamps,\n","\n","    \"UnmatchedExecutionBuilds\":\n","        unmatched_execution_builds,\n","\n","    \"UnmatchedDatasetBuilds\":\n","        unmatched_dataset_builds,\n","\n","    \"DuplicateDatasetBuildTestPairs\":\n","        duplicate_dataset_build_test_pairs,\n","\n","    \"MissingExecutionDurations\":\n","        missing_execution_durations,\n","}\n","\n","\n","# ---------------------------------------------------------\n","# 11. Compare every observed value with screening\n","# ---------------------------------------------------------\n","\n","comparison_records = []\n","\n","for screening_column, observed_value in (\n","    observed_counts.items()\n","):\n","\n","    expected_value = expected_integer(\n","        screening_column\n","    )\n","\n","    matches = bool(\n","        int(observed_value)\n","        == expected_value\n","    )\n","\n","    comparison_records.append({\n","        \"Measure\":\n","            screening_column,\n","        \"Expected\":\n","            expected_value,\n","        \"Observed\":\n","            int(observed_value),\n","        \"Matches\":\n","            matches,\n","    })\n","\n","\n","screening_comparison = pd.DataFrame(\n","    comparison_records\n",")\n","\n","\n","if not screening_comparison[\n","    \"Matches\"\n","].all():\n","\n","    display(\n","        screening_comparison\n","    )\n","\n","    raise AssertionError(\n","        \"Paho MQTT counts do not match the saved \"\n","        \"screening results.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. Additional strict checks\n","# ---------------------------------------------------------\n","\n","if len(REC_FEATURE_COLUMNS) != 19:\n","    raise AssertionError(\n","        \"Expected exactly 19 REC features.\"\n","    )\n","\n","if len(MODEL_FEATURE_COLUMNS) != 150:\n","    raise AssertionError(\n","        \"Expected exactly 150 model predictors.\"\n","    )\n","\n","if missing_build_timestamps != 0:\n","    raise AssertionError(\n","        \"Paho MQTT contains missing build timestamps.\"\n","    )\n","\n","if unmatched_execution_builds != 0:\n","    raise AssertionError(\n","        \"Some execution builds are unmatched.\"\n","    )\n","\n","if unmatched_dataset_builds != 0:\n","    raise AssertionError(\n","        \"Some model-ready builds are unmatched.\"\n","    )\n","\n","if duplicate_dataset_build_test_pairs != 0:\n","    raise AssertionError(\n","        \"Duplicate model-ready Build-Test pairs exist.\"\n","    )\n","\n","if missing_execution_durations != 0:\n","    raise AssertionError(\n","        \"Raw execution durations contain missing values.\"\n","    )\n","\n","if clean_evaluation_data[\n","    \"Duration\"\n","].isna().any():\n","    raise AssertionError(\n","        \"Evaluation durations contain missing values.\"\n","    )\n","\n","if int(\n","    y_evaluation_clean.sum()\n",") == 0:\n","    raise AssertionError(\n","        \"Paho MQTT has no model-ready evaluation \"\n","        \"failures.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. Final output\n","# ---------------------------------------------------------\n","\n","print(\n","    \"\\n=== PAHO MQTT INITIALISATION COMPLETE ===\"\n",")\n","\n","print(\"\\nRaw file shapes:\")\n","print(\n","    \"builds.csv:\",\n","    builds_raw.shape,\n",")\n","print(\n","    \"exe.csv:\",\n","    exe.shape,\n",")\n","print(\n","    \"dataset.csv:\",\n","    dataset.shape,\n",")\n","print(\n","    \"entity_change_history.csv:\",\n","    entity_change_history.shape,\n",")\n","print(\n","    \"id_map.csv:\",\n","    id_map.shape,\n",")\n","print(\n","    \"contributors.csv:\",\n","    contributors.shape,\n",")\n","\n","\n","print(\"\\nChronological split:\")\n","print(\n","    \"Training-period builds:\",\n","    len(training_build_ids),\n",")\n","print(\n","    \"Evaluation-period builds:\",\n","    len(evaluation_build_ids),\n",")\n","\n","\n","print(\"\\nRaw execution partitions:\")\n","print(\n","    \"Training execution rows:\",\n","    len(clean_training_history),\n",")\n","print(\n","    \"Evaluation execution rows:\",\n","    len(clean_evaluation_history),\n",")\n","\n","\n","print(\"\\nModel-ready partitions:\")\n","print(\n","    \"Training rows:\",\n","    len(clean_training_data),\n",")\n","print(\n","    \"Training model-ready builds:\",\n","    clean_training_data[\n","        \"Build\"\n","    ].nunique(),\n",")\n","print(\n","    \"Evaluation rows:\",\n","    len(clean_evaluation_data),\n",")\n","print(\n","    \"Scored evaluation builds:\",\n","    clean_evaluation_data[\n","        \"Build\"\n","    ].nunique(),\n",")\n","\n","\n","print(\"\\nBinary outcomes:\")\n","print(\n","    \"Training passes:\