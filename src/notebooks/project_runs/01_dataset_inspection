  \"recent_window\": RECENT_WINDOW,\n","    \"noise_partition\": \"training only\",\n","    \"evaluation_partition\": \"clean\",\n","    \"noise_unit\": (\n","        \"individual raw training execution verdict\"\n","    ),\n","    \"flip_rule\": {\n","        \"pass_to_failure\": (\n","            \"0 is replaced by a failure subtype sampled \"\n","            \"from the clean project-specific failure \"\n","            \"subtype distribution\"\n","        ),\n","        \"failure_to_pass\": (\n","            \"every non-zero verdict is replaced by 0\"\n","        ),\n","    },\n","    \"randomisation\": (\n","        \"project-specific deterministic random streams; \"\n","        \"same seed uses nested masks across noise levels\"\n","    ),\n","    \"feature_handling\": (\n","        \"recompute all 19 verdict-dependent REC features\"\n","    ),\n","    \"training_instance_cohort\": (\n","        \"fixed TCP-CI model-ready training rows\"\n","    ),\n","    \"evaluation_metrics\": [\n","        \"APFDc\",\n","        \"APFD\",\n","    ],\n","    \"primary_metric\": \"APFDc\",\n","    \"ml_techniques\": ML_TECHNIQUES,\n","    \"baselines\": BASELINE_TECHNIQUES,\n","    \"status\": (\n","        \"pilot protocol; fixed-holdout and fixed-instance \"\n","        \"choices must be documented in the thesis\"\n","    ),\n","}\n","\n","\n","PROTOCOL_PATH = (\n","    NOTES_DRIVE /\n","    f\"{PROJECT_SLUG}_experiment_protocol_pilot_v1.json\"\n",")\n","\n","with open(\n","    PROTOCOL_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as protocol_file:\n","    json.dump(\n","        EXPERIMENT_PROTOCOL,\n","        protocol_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. CLEAN RAW TRAINING EXECUTION HISTORY\n","# ---------------------------------------------------------\n","\n","clean_training_history = (\n","    exe_for_rec[\n","        exe_for_rec[\"build\"].isin(\n","            training_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","clean_evaluation_history = (\n","    exe_for_rec[\n","        exe_for_rec[\"build\"].isin(\n","            evaluation_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(clean_training_history) == 0:\n","    raise RuntimeError(\n","        \"The raw training execution history is empty.\"\n","    )\n","\n","if len(clean_evaluation_history) == 0:\n","    raise RuntimeError(\n","        \"The raw evaluation execution history is empty.\"\n","    )\n","\n","\n","clean_training_history[\"verdict\"] = pd.to_numeric(\n","    clean_training_history[\"verdict\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","# ---------------------------------------------------------\n","# 4. PROJECT-SPECIFIC DETERMINISTIC RANDOM SEEDS\n","# ---------------------------------------------------------\n","\n","def stable_project_seed(\n","    project_name,\n","    repetition_seed,\n","    random_stream,\n","):\n","    \"\"\"\n","    Create a deterministic project-specific 32-bit seed.\n","\n","    This prevents different projects from receiving the\n","    exact same random sequence while retaining complete\n","    reproducibility.\n","    \"\"\"\n","\n","    seed_text = (\n","        f\"{project_name}|\"\n","        f\"{int(repetition_seed)}|\"\n","        f\"{random_stream}\"\n","    )\n","\n","    digest = hashlib.sha256(\n","        seed_text.encode(\"utf-8\")\n","    ).digest()\n","\n","    return int.from_bytes(\n","        digest[:8],\n","        byteorder=\"little\",\n","        signed=False,\n","    ) % (2 ** 32)\n","\n","\n","# ---------------------------------------------------------\n","# 5. TRAINING-VERDICT NOISE INJECTION\n","# ---------------------------------------------------------\n","\n","def inject_training_verdict_noise(\n","    execution_history,\n","    noise_percent,\n","    repetition_seed,\n","    project_name=PROJECT_NAME,\n","):\n","    \"\"\"\n","    Independently flip every raw training verdict with\n","    probability p.\n","\n","    Original failure: any verdict != 0\n","    Original pass: verdict == 0\n","\n","    The same project and repetition seed generate the same\n","    per-row random values at every noise level. Therefore,\n","    the masks are nested across increasing noise levels.\n","    \"\"\"\n","\n","    noise_percent = float(noise_percent)\n","\n","    if not 0 \u003c= noise_percent \u003c= 100:\n","        raise ValueError(\n","            \"noise_percent must be between 0 and 100.\"\n","        )\n","\n","    noisy_history = (\n","        execution_history\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    original_verdict = pd.to_numeric(\n","        noisy_history[\"verdict\"],\n","        errors=\"raise\",\n","    ).astype(int).to_numpy()\n","\n","    number_of_rows = len(noisy_history)\n","\n","    if number_of_rows == 0:\n","        raise ValueError(\n","            \"execution_history is empty.\"\n","        )\n","\n","    clean_failure_verdicts = (\n","        pd.Series(\n","            original_verdict[\n","                original_verdict != 0\n","            ]\n","        )\n","        .value_counts()\n","        .sort_index()\n","    )\n","\n","    if clean_failure_verdicts.empty:\n","        raise ValueError(\n","            \"No failure subtype exists in the clean \"\n","            \"training execution history.\"\n","        )\n","\n","    failure_subtypes = (\n","        clean_failure_verdicts\n","        .index\n","        .to_numpy(dtype=int)\n","    )\n","\n","    failure_subtype_probabilities = (\n","        clean_failure_verdicts\n","        .to_numpy(dtype=float)\n","    )\n","\n","    failure_subtype_probabilities /= (\n","        failure_subtype_probabilities.sum()\n","    )\n","\n","\n","    flip_rng = np.random.default_rng(\n","        stable_project_seed(\n","            project_name,\n","            repetition_seed,\n","            \"flip_mask\",\n","        )\n","    )\n","\n","    subtype_rng = np.random.default_rng(\n","        stable_project_seed(\n","            project_name,\n","            repetition_seed,\n","            \"failure_subtype\",\n","        )\n","    )\n","\n","\n","    row_uniforms = flip_rng.random(\n","        number_of_rows\n","    )\n","\n","    flip_mask = (\n","        row_uniforms\n","        \u003c noise_percent / 100.0\n","    )\n","\n","    sampled_failure_subtypes = (\n","        subtype_rng.choice(\n","            failure_subtypes,\n","            size=number_of_rows,\n","            replace=True,\n","            p=failure_subtype_probabilities,\n","        )\n","    )\n","\n","\n","    noisy_verdict = original_verdict.copy()\n","\n","    pass_to_failure_mask = (\n","        flip_mask\n","        \u0026 (original_verdict == 0)\n","    )\n","\n","    failure_to_pass_mask = (\n","        flip_mask\n","        \u0026 (original_verdict != 0)\n","    )\n","\n","    noisy_verdict[\n","        pass_to_failure_mask\n","    ] = sampled_failure_subtypes[\n","        pass_to_failure_mask\n","    ]\n","\n","    noisy_verdict[\n","        failure_to_pass_mask\n","    ] = 0\n","\n","    noisy_history[\"verdict\"] = noisy_verdict\n","\n","\n","    manifest = pd.DataFrame({\n","        \"NoiseRowID\":\n","            np.arange(number_of_rows),\n","        \"Build\":\n","            noisy_history[\"build\"].to_numpy(),\n","        \"Test\":\n","            noisy_history[\"test\"].to_numpy(),\n","        \"OriginalVerdict\":\n","            original_verdict,\n","        \"NoisyVerdict\":\n","            noisy_verdict,\n","        \"FlipUniform\":\n","            row_uniforms,\n","        \"Flipped\":\n","            flip_mask,\n","        \"PassToFailure\":\n","            pass_to_failure_mask,\n","        \"FailureToPass\":\n","            failure_to_pass_mask,\n","    })\n","\n","    if \"job\" in noisy_history.columns:\n","        manifest[\"Job\"] = (\n","            noisy_history[\"job\"].to_numpy()\n","        )\n","\n","\n","    number_flipped = int(\n","        flip_mask.sum()\n","    )\n","\n","    summary = {\n","        \"Project\": project_name,\n","        \"NoisePercentRequested\":\n","            noise_percent,\n","        \"RepetitionSeed\":\n","            int(repetition_seed),\n","        \"TrainingExecutionRows\":\n","            number_of_rows,\n","        \"NumberFlipped\":\n","            number_flipped,\n","        \"RealisedNoisePercent\":\n","            100.0\n","            * number_flipped\n","            / number_of_rows,\n","        \"PassToFailure\":\n","            int(\n","                pass_to_failure_mask.sum()\n","            ),\n","        \"FailureToPass\":\n","            int(\n","                failure_to_pass_mask.sum()\n","            ),\n","    }\n","\n","    return (\n","        noisy_history,\n","        manifest,\n","        summary,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. ALIGN RECONSTRUCTED REC FEATURES\n","# ---------------------------------------------------------\n","\n","def align_reconstructed_rec_features(\n","    reconstructed,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Return REC columns in exactly the same order as the\n","    requested model-ready rows.\n","    \"\"\"\n","\n","    reconstructed = reconstructed.copy()\n","\n","    requested_rows = (\n","        requested_rows\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    missing_rec_columns = [\n","        column\n","        for column in REC_FEATURE_COLUMNS\n","        if column not in reconstructed.columns\n","    ]\n","\n","    if missing_rec_columns:\n","        raise ValueError(\n","            \"Reconstruction is missing REC columns: \"\n","            + \", \".join(missing_rec_columns)\n","        )\n","\n","\n","    if {\n","        \"Build\",\n","        \"Test\",\n","    }.issubset(reconstructed.columns):\n","\n","        requested_with_order = (\n","            requested_rows[\n","                [\"Build\", \"Test\"]\n","            ]\n","            .copy()\n","        )\n","\n","        requested_with_order[\n","            \"_requested_row_order\"\n","        ] = np.arange(\n","            len(requested_with_order)\n","        )\n","\n","        reconstructed_subset = (\n","            reconstructed[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    *REC_FEATURE_COLUMNS,\n","                ]\n","            ]\n","            .copy()\n","        )\n","\n","        if reconstructed_subset.duplicated(\n","            [\"Build\", \"Test\"]\n","        ).any():\n","            raise ValueError(\n","                \"Reconstructed REC data contains \"\n","                \"duplicate Build-Test rows.\"\n","            )\n","\n","        aligned = (\n","            requested_with_order\n","            .merge(\n","                reconstructed_subset,\n","                on=[\"Build\", \"Test\"],\n","                how=\"left\",\n","                validate=\"one_to_one\",\n","            )\n","            .sort_values(\n","                \"_requested_row_order\"\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","        if aligned[\n","            REC_FEATURE_COLUMNS\n","        ].isna().all(axis=1).any():\n","            raise ValueError(\n","                \"At least one requested Build-Test row \"\n","                \"did not receive reconstructed features.\"\n","            )\n","\n","        return aligned[\n","            REC_FEATURE_COLUMNS\n","        ].copy()\n","\n","\n","    if len(reconstructed) != len(\n","        requested_rows\n","    ):\n","        raise ValueError(\n","            \"Reconstructed rows cannot be aligned: \"\n","            f\"{len(reconstructed)} reconstructed versus \"\n","            f\"{len(requested_rows)} requested.\"\n","        )\n","\n","    return (\n","        reconstructed[\n","            REC_FEATURE_COLUMNS\n","        ]\n","        .reset_index(drop=True)\n","        .copy()\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. MAP NOISY RAW VERDICTS TO MODEL-READY ROWS\n","# ---------------------------------------------------------\n","\n","def extract_model_ready_verdicts(\n","    noisy_execution_history,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Obtain the noisy verdict for every fixed model-ready\n","    Build-Test training row.\n","    \"\"\"\n","\n","    verdict_rows = (\n","        noisy_execution_history[\n","            [\"build\", \"test\", \"verdict\"]\n","        ]\n","        .copy()\n","    )\n","\n","    duplicate_groups = (\n","        verdict_rows\n","        .groupby(\n","            [\"build\", \"test\"],\n","            sort=False,\n","        )[\"verdict\"]\n","        .nunique()\n","    )\n","\n","    conflicting_duplicates = (\n","        duplicate_groups[\n","            duplicate_groups \u003e 1\n","        ]\n","    )\n","\n","    if len(conflicting_duplicates) \u003e 0:\n","        raise ValueError(\n","            \"The noisy raw history contains conflicting \"\n","            \"verdicts for duplicate Build-Test pairs.\"\n","        )\n","\n","    verdict_rows = (\n","        verdict_rows\n","        .drop_duplicates(\n","            [\"build\", \"test\"],\n","            keep=\"last\",\n","        )\n","        .rename(\n","            columns={\n","                \"build\": \"Build\",\n","                \"test\": \"Test\",\n","                \"verdict\": \"NoisyVerdict\",\n","            }\n","        )\n","    )\n","\n","    requested_with_order = (\n","        requested_rows[\n","            [\"Build\", \"Test\"]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    requested_with_order[\n","        \"_requested_row_order\"\n","    ] = np.arange(\n","        len(requested_with_order)\n","    )\n","\n","    aligned = (\n","        requested_with_order\n","        .merge(\n","            verdict_rows,\n","            on=[\"Build\", \"Test\"],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","        .sort_values(\n","            \"_requested_row_order\"\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    if aligned[\"NoisyVerdict\"].isna().any():\n","        missing_count = int(\n","            aligned[\"NoisyVerdict\"]\n","            .isna()\n","            .sum()\n","        )\n","\n","        raise ValueError(\n","            f\"{missing_count} model-ready training rows \"\n","            \"could not be linked to raw noisy verdicts.\"\n","        )\n","\n","    return (\n","        aligned[\"NoisyVerdict\"]\n","        .astype(int)\n","        .reset_index(drop=True)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. CREATE ONE NOISY MODEL-READY TRAINING DATASET\n","# ---------------------------------------------------------\n","\n","def create_noisy_model_training_data(\n","    clean_model_training_data,\n","    noisy_execution_history,\n","):\n","    \"\"\"\n","    Fixed-instance design:\n","\n","    Preserve the original TCP-CI model-ready training rows\n","    and non-REC predictors, but replace:\n","\n","    1. all 19 REC features with values reconstructed from\n","       the noisy raw execution history;\n","    2. the training verdict with the corresponding noisy\n","       verdict.\n","    \"\"\"\n","\n","    noisy_model_data = (\n","        clean_model_training_data\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    requested_rows = (\n","        noisy_model_data[\n","            [\"Build\", \"Test\"]\n","        ]\n","        .copy()\n","    )\n","\n","    reconstructed = (\n","        reconstruct_rec_features(\n","            noisy_execution_history,\n","            requested_rows,\n","            recent_window=RECENT_WINDOW,\n","        )\n","    )\n","\n","    aligned_rec = (\n","        align_reconstructed_rec_features(\n","            reconstructed,\n","            requested_rows,\n","        )\n","    )\n","\n","    noisy_model_data.loc[\n","        :,\n","        REC_FEATURE_COLUMNS,\n","    ] = aligned_rec.to_numpy()\n","\n","    noisy_model_data[\"Verdict\"] = (\n","        extract_model_ready_verdicts(\n","            noisy_execution_history,\n","            requested_rows,\n","        )\n","        .to_numpy()\n","    )\n","\n","    return noisy_model_data\n","\n","\n","# ---------------------------------------------------------\n","# 9. APFD AND APFDC\n","# ---------------------------------------------------------\n","\n","def calculate_apfd(\n","    actual_failures,\n","):\n","    \"\"\"\n","    APFD for one already-ranked evaluation build.\n","\n","    actual_failures must follow ranking order:\n","    1 = failing test\n","    0 = passing test\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    number_of_tests = len(failures)\n","    number_of_failures = int(\n","        failures.sum()\n","    )\n","\n","    if number_of_tests == 0:\n","        return np.nan\n","\n","    if number_of_failures == 0:\n","        return np.nan\n","\n","    failure_ranks = (\n","        np.flatnonzero(\n","            failures == 1\n","        )\n","        + 1\n","    )\n","\n","    apfd = (\n","        1.0\n","        - failure_ranks.sum()\n","        / (\n","            number_of_tests\n","            * number_of_failures\n","        )\n","        + 1.0\n","        / (\n","            2.0\n","            * number_of_tests\n","        )\n","    )\n","\n","    return float(apfd)\n","\n","\n","def calculate_apfdc(\n","    actual_failures,\n","    durations,\n","):\n","    \"\"\"\n","    Cost-aware APFD for one already-ranked evaluation\n","    build using midpoint failure-detection time.\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    durations = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","    if len(failures) != len(durations):\n","        raise ValueError(\n","            \"actual_failures and durations must have \"\n","            \"the same length.\"\n","        )\n","\n","    if len(failures) == 0:\n","        return np.nan\n","\n","    if failures.sum() == 0:\n","        return np.nan\n","\n","    if not np.isfinite(durations).all():\n","        raise ValueError(\n","            \"Durations contain missing or infinite values.\"\n","        )\n","\n","    if (durations \u003c 0).any():\n","        raise ValueError(\n","            \"Durations cannot be negative.\"\n","        )\n","\n","    total_duration = float(\n","        durations.sum()\n","    )\n","\n","    if total_duration \u003c= 0:\n","        return np.nan\n","\n","    cumulative_before = np.concatenate([\n","        np.array([0.0]),\n","        np.cumsum(durations)[:-1],\n","    ])\n","\n","    failure_mask = (\n","        failures == 1\n","    )\n","\n","    midpoint_detection_times = (\n","        cumulative_before[failure_mask]\n","        + 0.5\n","        * durations[failure_mask]\n","    )\n","\n","    apfdc = (\n","        1.0\n","        - np.mean(\n","            midpoint_detection_times\n","            / total_duration\n","        )\n","    )\n","\n","    return float(apfdc)\n","\n","\n","# Compatibility aliases.\n","compute_apfd = calculate_apfd\n","compute_apfdc = calculate_apfdc\n","\n","\n","# ---------------------------------------------------------\n","# 10. SELF-TEST: 0% MUST REPRODUCE CLEAN TRAINING DATA\n","# ---------------------------------------------------------\n","\n","(\n","    zero_noise_history,\n","    zero_noise_manifest,\n","    zero_noise_summary,\n",") = inject_training_verdict_noise(\n","    clean_training_history,\n","    noise_percent=0,\n","    repetition_seed=1,\n",")\n","\n","zero_noise_model_data = (\n","    create_noisy_model_training_data(\n","        clean_training_data,\n","        zero_noise_history,\n","    )\n",")\n","\n","\n","zero_label_mismatches = int(\n","    (\n","        zero_noise_model_data[\"Verdict\"]\n","        .to_numpy()\n","        != clean_training_data[\"Verdict\"]\n","        .to_numpy()\n","    ).sum()\n",")\n","\n","\n","zero_rec_mismatches = 0\n","\n","for rec_column in REC_FEATURE_COLUMNS:\n","\n","    reconstructed_values = pd.to_numeric(\n","        zero_noise_model_data[rec_column],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    original_values = pd.to_numeric(\n","        clean_training_data[rec_column],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    equal_mask = np.isclose(\n","        reconstructed_values,\n","        original_values,\n","        rtol=1e-10,\n","        atol=1e-12,\n","        equal_nan=True,\n","    )\n","\n","    zero_rec_mismatches += int(\n","        (~equal_mask).sum()\n","    )\n","\n","\n","if zero_noise_summary[\n","    \"NumberFlipped\"\n","] != 0:\n","    raise AssertionError(\n","        \"0% noise unexpectedly flipped verdicts.\"\n","    )\n","\n","if zero_label_mismatches != 0:\n","    raise AssertionError(\n","        \"0% reconstruction changed training labels.\"\n","    )\n","\n","if zero_rec_mismatches != 0:\n","    raise AssertionError(\n","        \"0% reconstruction changed REC features.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. SELF-TEST: 5% REPRODUCIBILITY\n","# ---------------------------------------------------------\n","\n","(\n","    five_history_a,\n","    five_manifest_a,\n","    five_summary_a,\n",") = inject_training_verdict_noise(\n","    clean_training_history,\n","    noise_percent=5,\n","    repetition_seed=1,\n",")\n","\n","(\n","    five_history_b,\n","    five_manifest_b,\n","    five_summary_b,\n",") = inject_training_verdict_noise(\n","    clean_training_history,\n","    noise_percent=5,\n","    repetition_seed=1,\n",")\n","\n","\n","same_seed_reproducible = np.array_equal(\n","    five_history_a[\"verdict\"].to_numpy(),\n","    five_history_b[\"verdict\"].to_numpy(),\n",")\n","\n","if not same_seed_reproducible:\n","    raise AssertionError(\n","        \"The same project, noise level and seed did \"\n","        \"not reproduce the same corruption.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. SELF-TEST: MANUAL APFD/APFDC EXAMPLE\n","# ---------------------------------------------------------\n","\n","manual_failures = [\n","    1,  # B fails\n","    1,  # D fails\n","    0,\n","    0,\n","    0,\n","]\n","\n","manual_durations_b_first = [\n","    5,\n","    1,\n","    1,\n","    1,\n","    1,\n","]\n","\n","manual_apfd = calculate_apfd(\n","    manual_failures\n",")\n","\n","manual_apfdc_b_first = (\n","    calculate_apfdc(\n","        manual_failures,\n","        manual_durations_b_first,\n","    )\n",")\n","\n","manual_apfdc_d_first = (\n","    calculate_apfdc(\n","        manual_failures,\n","        [1, 5, 1, 1, 1],\n","    )\n",")\n","\n","if not np.isclose(\n","    manual_apfd,\n","    0.80,\n","):\n","    raise AssertionError(\n","        \"Manual APFD validation failed.\"\n","    )\n","\n","if not (\n","    manual_apfdc_d_first\n","    \u003e manual_apfdc_b_first\n","):\n","    raise AssertionError(\n","        \"APFDc did not reward the quicker failing \"\n","        \"test being placed first.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. FINAL VALIDATION OUTPUT\n","# ---------------------------------------------------------\n","\n","print(\"=== CANONICAL HELPER VALIDATION ===\")\n","\n","print(\"\\nProtocol saved:\")\n","print(PROTOCOL_PATH)\n","\n","print(\"\\nTraining history:\")\n","print(\n","    \"Raw training execution rows:\",\n","    len(clean_training_history),\n",")\n","\n","print(\n","    \"Raw evaluation execution rows:\",\n","    len(clean_evaluation_history),\n",")\n","\n","print(\"\\nClean failure subtype distribution:\")\n","print(\n","    clean_training_history.loc[\n","        clean_training_history[\"verdict\"] != 0,\n","        \"verdict\",\n","    ]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","print(\"\\n0% validation:\")\n","print(\n","    \"Flipped verdicts:\",\n","    zero_noise_summary[\"NumberFlipped\"],\n",")\n","print(\n","    \"Training-label mismatches:\",\n","    zero_label_mismatches,\n",")\n","print(\n","    \"REC-value mismatches:\",\n","    zero_rec_mismatches,\n",")\n","\n","print(\"\\n5% seed 1 validation:\")\n","print(\n","    \"Flipped verdicts:\",\n","    five_summary_a[\"NumberFlipped\"],\n",")\n","print(\n","    \"Realised noise percentage:\",\n","    round(\n","        five_summary_a[\n","            \"RealisedNoisePercent\"\n","        ],\n","        6,\n","    ),\n",")\n","print(\n","    \"Pass to failure:\",\n","    five_summary_a[\"PassToFailure\"],\n",")\n","print(\n","    \"Failure to pass:\",\n","    five_summary_a[\"FailureToPass\"],\n",")\n","print(\n","    \"Same-seed reproducible:\",\n","    same_seed_reproducible,\n",")\n","\n","print(\"\\nMetric validation:\")\n","print(\n","    \"Manual APFD:\",\n","    round(manual_apfd, 6),\n",")\n","print(\n","    \"APFDc with long failure first:\",\n","    round(\n","        manual_apfdc_b_first,\n","        6,\n","    ),\n",")\n","print(\n","    \"APFDc with quick failure first:\",\n","    round(\n","        manual_apfdc_d_first,\n","        6,\n","    ),\n",")\n","\n","print(\n","    f\"\\nSUCCESS: canonical helpers for \"\n","    f\"{PROJECT_NAME} are ready.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":12147,"status":"ok","timestamp":1784851141755,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"ZQB0l8wjKeX5","outputId":"413ab5aa-e7fe-4c1f-9f6d-87e4f0ecdff4"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== FEATURE PROTOCOL ===\n","Original predictor columns: 150\n","Frozen zero-variance columns: 2\n","Active predictor columns: 148\n","\n","Zero-variance columns:\n"," - TES_COM_CountDeclMethodDefault\n"," - TES_COM_CountDeclMethodProtected\n","\n","SUCCESS: unified condition runner defined.\n","Model configuration saved:\n","/content/drive/MyDrive/Thesis_Experiment/Notes/apache__airavata_model_configuration_pilot_v1.json\n"]}],"source":["# =========================================================\n","# AIRAVATA — UNIFIED EXPERIMENT CONDITION RUNNER\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","import time\n","import warnings\n","\n","import numpy as np\n","import pandas as pd\n","\n","from sklearn.ensemble import RandomForestClassifier\n","from sklearn.naive_bayes import GaussianNB\n","\n","from xgboost import XGBClassifier\n","from lightgbm import LGBMClassifier\n","\n","\n","# ---------------------------------------------------------\n","# 1. FREEZE FEATURE PREPROCESSING\n","# ---------------------------------------------------------\n","\n","clean_feature_frame = (\n","    clean_training_data[\n","        MODEL_FEATURE_COLUMNS\n","    ]\n","    .apply(\n","        pd.to_numeric,\n","        errors=\"coerce\",\n","    )\n","    .replace(\n","        [np.inf, -np.inf],\n","        np.nan,\n","    )\n",")\n","\n","\n","# Zero-variance columns are identified using only the\n","# clean training partition and then frozen for all noise\n","# levels and all four ML models.\n","feature_variation = (\n","    clean_feature_frame\n","    .nunique(\n","        dropna=False\n","    )\n",")\n","\n","ZERO_VARIANCE_FEATURES = (\n","    feature_variation[\n","        feature_variation \u003c= 1\n","    ]\n","    .index\n","    .tolist()\n",")\n","\n","ACTIVE_FEATURE_COLUMNS = [\n","    column\n","    for column in MODEL_FEATURE_COLUMNS\n","    if column not in ZERO_VARIANCE_FEATURES\n","]\n","\n","\n","print(\"=== FEATURE PROTOCOL ===\")\n","print(\n","    \"Original predictor columns:\",\n","    len(MODEL_FEATURE_COLUMNS),\n",")\n","print(\n","    \"Frozen zero-variance columns:\",\n","    len(ZERO_VARIANCE_FEATURES),\n",")\n","print(\n","    \"Active predictor columns:\",\n","    len(ACTIVE_FEATURE_COLUMNS),\n",")\n","\n","print(\"\\nZero-variance columns:\")\n","for column in ZERO_VARIANCE_FEATURES:\n","    print(\" -\", column)\n","\n","\n","# ---------------------------------------------------------\n","# 2. FROZEN MODEL CONFIGURATION\n","# ---------------------------------------------------------\n","\n","MODEL_CONFIG = {\n","    \"RandomForest\": {\n","        \"n_estimators\": 100,\n","        \"criterion\": \"gini\",\n","        \"max_depth\": None,\n","        \"min_samples_split\": 2,\n","        \"min_samples_leaf\": 1,\n","        \"max_features\": \"sqrt\",\n","        \"bootstrap\": True,\n","        \"class_weight\": None,\n","    },\n","\n","    \"XGBoost\": {\n","        \"n_estimators\": 100,\n","        \"max_depth\": 6,\n","        \"learning_rate\": 0.1,\n","        \"subsample\": 1.0,\n","        \"colsample_bytree\": 1.0,\n","        \"objective\": \"binary:logistic\",\n","        \"eval_metric\": \"logloss\",\n","        \"tree_method\": \"hist\",\n","    },\n","\n","    \"LightGBM\": {\n","        \"n_estimators\": 100,\n","        \"learning_rate\": 0.1,\n","        \"num_leaves\": 31,\n","        \"objective\": \"binary\",\n","    },\n","\n","    \"NaiveBayes\": {\n","        \"variant\": \"GaussianNB\",\n","        \"var_smoothing\": 1e-9,\n","    },\n","}\n","\n","\n","MODEL_CONFIGURATION_PATH = (\n","    NOTES_DRIVE /\n","    f\"{PROJECT_SLUG}_model_configuration_pilot_v1.json\"\n",")\n","\n","with open(\n","    MODEL_CONFIGURATION_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as configuration_file:\n","    json.dump(\n","        {\n","            \"project\": PROJECT_NAME,\n","            \"active_feature_count\":\n","                len(ACTIVE_FEATURE_COLUMNS),\n","            \"zero_variance_features\":\n","                ZERO_VARIANCE_FEATURES,\n","            \"missing_value_rule\":\n","                \"training-partition median\",\n","            \"infinite_value_rule\":\n","                \"replace with missing, then median\",\n","            \"tie_rule\":\n","                \"score first, Test ascending\",\n","            \"models\":\n","                MODEL_CONFIG,\n","        },\n","        configuration_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. PREPARE SHARED ML MATRICES\n","# ---------------------------------------------------------\n","\n","def prepare_ml_matrices(\n","    noisy_training_data,\n","    clean_evaluation_data,\n","):\n","    \"\"\"\n","    Prepare the same train/evaluation matrices for all four\n","    supervised ML models.\n","\n","    Medians are learned only from the current training\n","    condition and then applied to both partitions.\n","    \"\"\"\n","\n","    X_train = (\n","        noisy_training_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [np.inf, -np.inf],\n","            np.nan,\n","        )\n","    )\n","\n","    X_evaluation = (\n","        clean_evaluation_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [np.inf, -np.inf],\n","            np.nan,\n","        )\n","    )\n","\n","    training_medians = (\n","        X_train\n","        .median(axis=0)\n","        .fillna(0.0)\n","    )\n","\n","    X_train = (\n","        X_train\n","        .fillna(training_medians)\n","        .astype(float)\n","    )\n","\n","    X_evaluation = (\n","        X_evaluation\n","        .fillna(training_medians)\n","        .astype(float)\n","    )\n","\n","    y_train = (\n","        noisy_training_data[\"Verdict\"] != 0\n","    ).astype(int)\n","\n","    if y_train.nunique() != 2:\n","        raise ValueError(\n","            \"The noisy training labels do not contain \"\n","            \"both classes.\"\n","        )\n","\n","    if X_train.isna().any().any():\n","        raise ValueError(\n","            \"Training features still contain missing values.\"\n","        )\n","\n","    if X_evaluation.isna().any().any():\n","        raise ValueError(\n","            \"Evaluation features still contain missing values.\"\n","        )\n","\n","    return (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. CREATE THE FOUR ML MODELS\n","# ---------------------------------------------------------\n","\n","def create_ml_models(\n","    repetition_seed,\n","):\n","    \"\"\"\n","    Construct all four models using deterministic,\n","    project-specific model seeds.\n","    \"\"\"\n","\n","    rf_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"RandomForest_model\",\n","    )\n","\n","    xgb_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"XGBoost_model\",\n","    )\n","\n","    lgbm_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"LightGBM_model\",\n","    )\n","\n","    models = {\n","        \"RandomForest\":\n","            RandomForestClassifier(\n","                **MODEL_CONFIG[\"RandomForest\"],\n","                random_state=rf_seed,\n","                n_jobs=-1,\n","            ),\n","\n","        \"XGBoost\":\n","            XGBClassifier(\n","                **MODEL_CONFIG[\"XGBoost\"],\n","                random_state=xgb_seed,\n","                n_jobs=-1,\n","                verbosity=0,\n","            ),\n","\n","        \"LightGBM\":\n","            LGBMClassifier(\n","                **MODEL_CONFIG[\"LightGBM\"],\n","                random_state=lgbm_seed,\n","                n_jobs=-1,\n","                verbosity=-1,\n","                deterministic=True,\n","                force_col_wise=True,\n","            ),\n","\n","        \"NaiveBayes\":\n","            GaussianNB(\n","                var_smoothing=(\n","                    MODEL_CONFIG[\n","                        \"NaiveBayes\"\n","                    ][\"var_smoothing\"]\n","                )\n","            ),\n","    }\n","\n","    return models\n","\n","\n","# ---------------------------------------------------------\n","# 5. POSITIVE-CLASS PROBABILITY\n","# ---------------------------------------------------------\n","\n","def get_failure_probability(\n","    fitted_model,\n","    feature_matrix,\n","):\n","    probabilities = (\n","        fitted_model\n","        .predict_proba(feature_matrix)\n","    )\n","\n","    classes = np.asarray(\n","        fitted_model.classes_\n","    )\n","\n","    positive_positions = np.where(\n","        classes == 1\n","    )[0]\n","\n","    if len(positive_positions) != 1:\n","        raise ValueError(\n","            \"Could not identify failure class 1.\"\n","        )\n","\n","    return probabilities[\n","        :,\n","        positive_positions[0],\n","    ]\n","\n","\n","# ---------------------------------------------------------\n","# 6. CREATE ONE RANKED BUILD\n","# ---------------------------------------------------------\n","\n","def rank_build_rows(\n","    build_rows,\n","    scores,\n","    technique,\n","    score_direction=\"descending\",\n","):\n","    \"\"\"\n","    Rank one evaluation build.\n","\n","    ML, LatestFail and Random:\n","        higher score first\n","\n","    QTF-Avg:\n","        lower average duration first\n","    \"\"\"\n","\n","    ranked = (\n","        build_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"Duration\",\n","                \"build_order\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    if len(ranked) != len(scores):\n","        raise ValueError(\n","            \"Number of scores does not match \"\n","            \"the number of tests.\"\n","        )\n","\n","    ranked[\"Technique\"] = technique\n","    ranked[\"Score\"] = np.asarray(\n","        scores,\n","        dtype=float,\n","    )\n","\n","    ranked[\"ActualFailure\"] = (\n","        ranked[\"Verdict\"] != 0\n","    ).astype(int)\n","\n","    ranked[\"Duration\"] = pd.to_numeric(\n","        ranked[\"Duration\"],\n","        errors=\"raise\",\n","    ).astype(float)\n","\n","    if score_direction == \"descending\":\n","        ascending = [\n","            False,\n","            True,\n","        ]\n","\n","    elif score_direction == \"ascending\":\n","        ascending = [\n","            True,\n","            True,\n","        ]\n","\n","    else:\n","        raise ValueError(\n","            \"score_direction must be ascending \"\n","            \"or descending.\"\n","        )\n","\n","    ranked = (\n","        ranked\n","        .sort_values(\n","            [\"Score\", \"Test\"],\n","            ascending=ascending,\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    ranked[\"Rank\"] = np.arange(\n","        1,\n","        len(ranked) + 1,\n","    )\n","\n","    return ranked\n","\n","\n","# ---------------------------------------------------------\n","# 7. SCORE ML TECHNIQUES\n","# ---------------------------------------------------------\n","\n","def create_ml_rankings(\n","    evaluation_data,\n","    technique,\n","    failure_probabilities,\n","):\n","    scored_data = (\n","        evaluation_data\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    scored_data[\"_FailureProbability\"] = (\n","        failure_probabilities\n","    )\n","\n","    rankings = []\n","\n","    for build_id, build_rows in (\n","        scored_data\n","        .groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","        rankings.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","                scores=(\n","                    build_rows[\n","                        \"_FailureProbability\"\n","                    ].to_numpy()\n","                ),\n","                technique=technique,\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","    return pd.concat(\n","        rankings,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. RANDOM BASELINE\n","# ---------------------------------------------------------\n","\n","def create_random_rankings(\n","    evaluation_data,\n","    repetition_seed,\n","):\n","    rankings = []\n","\n","    for build_id, build_rows in (\n","        evaluation_data\n","        .groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","        random_rng = np.random.default_rng(\n","            stable_project_seed(\n","                PROJECT_NAME,\n","                repetition_seed,\n","                f\"Random_baseline_build_{build_id}\",\n","            )\n","        )\n","\n","        random_scores = random_rng.random(\n","            len(build_rows)\n","        )\n","\n","        rankings.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","                scores=random_scores,\n","                technique=\"Random\",\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","    return pd.concat(\n","        rankings,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. HISTORY-BASED BASELINES\n","# ---------------------------------------------------------\n","\n","def initialise_history_baselines(\n","    noisy_training_history,\n","):\n","    \"\"\"\n","    LatestFail uses noisy verdict history.\n","\n","    QTF-Avg uses clean historical durations and is therefore\n","    initialized separately using clean training history.\n","    \"\"\"\n","\n","    latest_failure_order = {}\n","\n","    noisy_history_sorted = (\n","        noisy_training_history\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"job\",\n","                \"test\",\n","            ]\n","        )\n","    )\n","\n","    for row in (\n","        noisy_history_sorted\n","        .itertuples(index=False)\n","    ):\n","        test_key = str(row.test)\n","\n","        if int(row.verdict) != 0:\n","            latest_failure_order[\n","                test_key\n","            ] = int(row.build_order)\n","\n","\n","    duration_sum = {}\n","    duration_count = {}\n","\n","    clean_duration_history = (\n","        clean_training_history\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"job\",\n","                \"test\",\n","            ]\n","        )\n","    )\n","\n","    for row in (\n","        clean_duration_history\n","        .itertuples(index=False)\n","    ):\n","        test_key = str(row.test)\n","        duration = float(row.duration)\n","\n","        if not np.isfinite(duration):\n","            continue\n","\n","        duration_sum[test_key] = (\n","            duration_sum.get(\n","                test_key,\n","                0.0,\n","            )\n","            + duration\n","        )\n","\n","        duration_count[test_key] = (\n","            duration_count.get(\n","                test_key,\n","                0,\n","            )\n","            + 1\n","        )\n","\n","    return (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    )\n","\n","\n","def create_history_baseline_rankings(\n","    noisy_training_history,\n","):\n","    \"\"\"\n","    Process every evaluation-period build chronologically.\n","\n","    Rankings are produced only for model-ready evaluation\n","    builds, but pass-only intermediate builds still update\n","    the historical state after they occur.\n","    \"\"\"\n","\n","    (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    ) = initialise_history_baselines(\n","        noisy_training_history\n","    )\n","\n","    target_build_ids = set(\n","        clean_evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","    raw_eval_by_build = {\n","        int(build_id): rows.copy()\n","        for build_id, rows in (\n","            clean_evaluation_history\n","            .groupby(\n","                \"build\",\n","                sort=False,\n","            )\n","        )\n","    }\n","\n","    model_eval_by_build = {\n","        int(build_id): rows.copy()\n","        for build_id, rows in (\n","            clean_evaluation_data\n","            .groupby(\n","                \"Build\",\n","                sort=False,\n","            )\n","        )\n","    }\n","\n","    latest_fail_rankings = []\n","    qtf_rankings = []\n","\n","    ordered_evaluation_builds = (\n","        evaluation_build_table\n","        .sort_values(\n","            \"build_order\"\n","        )\n","    )\n","\n","    for build_row in (\n","        ordered_evaluation_builds\n","        .itertuples(index=False)\n","    ):\n","        build_id = int(build_row.id)\n","\n","        # Rank before seeing the current build's outcomes.\n","        if build_id in target_build_ids:\n","\n","            build_tests = (\n","                model_eval_by_build[\n","                    build_id\n","                ]\n","                .copy()\n","            )\n","\n","            latest_scores = []\n","\n","            qtf_average_scores = []\n","\n","            for test_value in (\n","                build_tests[\"Test\"]\n","            ):\n","                test_key = str(test_value)\n","\n","                latest_scores.append(\n","                    float(\n","                        latest_failure_order.get(\n","                            test_key,\n","                            -1,\n","                        )\n","                    )\n","                )\n","\n","                count = duration_count.get(\n","                    test_key,\n","                    0,\n","                )\n","\n","                if count \u003e 0:\n","                    average_duration = (\n","                        duration_sum[\n","                            test_key\n","                        ]\n","                        / count\n","                    )\n","                else:\n","                    average_duration = np.inf\n","\n","                qtf_average_scores.append(\n","                    float(average_duration)\n","                )\n","\n","            latest_fail_rankings.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","                    scores=latest_scores,\n","                    technique=\"LatestFail\",\n","                    score_direction=\"descending\",\n","                )\n","            )\n","\n","            qtf_rankings.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","                    scores=qtf_average_scores,\n","                    technique=\"QTF-Avg\",\n","                    score_direction=\"ascending\",\n","                )\n","            )\n","\n","\n","        # Update histories only after ranking the build.\n","        current_raw_rows = (\n","            raw_eval_by_build.get(\n","                build_id\n","            )\n","        )\n","\n","        if current_raw_rows is None:\n","            continue\n","\n","        current_raw_rows = (\n","            current_raw_rows\n","            .sort_values(\n","                [\"job\", \"test\"]\n","            )\n","        )\n","\n","        for execution_row in (\n","            current_raw_rows\n","            .itertuples(index=False)\n","        ):\n","            test_key = str(\n","                execution_row.test\n","            )\n","\n","            if int(\n","                execution_row.verdict\n","            ) != 0:\n","                latest_failure_order[\n","                    test_key\n","                ] = int(\n","                    execution_row.build_order\n","                )\n","\n","            duration = float(\n","                execution_row.duration\n","            )\n","\n","            if np.isfinite(duration):\n","                duration_sum[\n","                    test_key\n","                ] = (\n","                    duration_sum.get(\n","                        test_key,\n","                        0.0,\n","                    )\n","                    + duration\n","                )\n","\n","                duration_count[\n","                    test_key\n","                ] = (\n","                    duration_count.get(\n","                        test_key,\n","                        0,\n","                    )\n","                    + 1\n","                )\n","\n","\n","    return (\n","        pd.concat(\n","            latest_fail_rankings,\n","            ignore_index=True,\n","        ),\n","        pd.concat(\n","            qtf_rankings,\n","            ignore_index=True,\n","        ),\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. CALCULATE BUILD-LEVEL METRICS\n","# ---------------------------------------------------------\n","\n","def calculate_build_metrics(\n","    all_rankings,\n","    noise_percent,\n","    repetition_seed,\n","):\n","    metric_records = []\n","\n","    grouped_rankings = (\n","        all_rankings\n","        .groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ],\n","            sort=False,\n","        )\n","    )\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in grouped_rankings:\n","\n","        ranked_build = (\n","            ranked_build\n","            .sort_values(\"Rank\")\n","        )\n","\n","        actual_failures = (\n","            ranked_build[\n","                \"ActualFailure\"\n","            ]\n","            .to_numpy()\n","        )\n","\n","        durations = (\n","            ranked_build[\n","                \"Duration\"\n","            ]\n","            .to_numpy()\n","        )\n","\n","        number_of_tests = len(\n","            ranked_build\n","        )\n","\n","        number_of_failures = int(\n","            actual_failures.sum()\n","        )\n","\n","        apfd = calculate_apfd(\n","            actual_failures\n","        )\n","\n","        apfdc = calculate_apfdc(\n","            actual_failures,\n","            durations,\n","        )\n","\n","        metric_records.append({\n","            \"Project\": PROJECT_NAME,\n","            \"NoisePercent\":\n","                float(noise_percent),\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","            \"Technique\":\n","                technique,\n","            \"Build\":\n","                int(build_id),\n","            \"BuildOrder\":\n","                int(\n","                    ranked_build[\n","                        \"build_order\"\n","                    ].iloc[0]\n","                ),\n","            \"NumberOfTests\":\n","                number_of_tests,\n","            \"NumberOfFailures\":\n","                number_of_failures,\n","            \"APFD\":\n","                apfd,\n","            \"APFDc\":\n","                apfdc,\n","        })\n","\n","    return pd.DataFrame(\n","        metric_records\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. VALIDATE ONE CONDITION\n","# ---------------------------------------------------------\n","\n","def validate_condition_outputs(\n","    rankings,\n","    build_metrics,\n","):\n","    expected_techniques = set(\n","        ML_TECHNIQUES\n","        + BASELINE_TECHNIQUES\n","    )\n","\n","    actual_techniques = set(\n","        rankings[\"Technique\"].unique()\n","    )\n","\n","    if actual_techniques != expected_techniques:\n","        raise AssertionError(\n","            \"Technique mismatch. Expected \"\n","            f\"{expected_techniques}, got \"\n","            f\"{actual_techniques}.\"\n","        )\n","\n","    expected_builds = set(\n","        clean_evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","    metric_builds = set(\n","        build_metrics[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","    if metric_builds != expected_builds:\n","        raise AssertionError(\n","            \"Not all clean evaluation builds \"\n","            \"received metrics.\"\n","        )\n","\n","    expected_metric_rows = (\n","        len(expected_builds)\n","        * len(expected_techniques)\n","    )\n","\n","    if len(build_metrics) != (\n","        expected_metric_rows\n","    ):\n","        raise AssertionError(\n","            \"Unexpected number of build-metric rows.\"\n","        )\n","\n","    if build_metrics[\n","        [\"APFD\", \"APFDc\"]\n","    ].isna().any().any():\n","        raise AssertionError(\n","            \"APFD or APFDc contains missing values.\"\n","        )\n","\n","    for metric_column in [\n","        \"APFD\",\n","        \"APFDc\",\n","    ]:\n","        if not build_metrics[\n","            metric_column\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","            raise AssertionError(\n","                f\"{metric_column} contains values \"\n","                \"outside [0, 1].\"\n","            )\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in (\n","        rankings\n","        .groupby(\n","            [\"Technique\", \"Build\"]\n","        )\n","    ):\n","        expected_ranks = np.arange(\n","            1,\n","            len(ranked_build) + 1,\n","        )\n","\n","        actual_ranks = np.sort(\n","            ranked_build[\n","                \"Rank\"\n","            ].to_numpy()\n","        )\n","\n","        if not np.array_equal(\n","            actual_ranks,\n","            expected_ranks,\n","        ):\n","            raise AssertionError(\n","                \"Invalid ranking sequence for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","        if ranked_build[\n","            \"Test\"\n","        ].duplicated().any():\n","            raise AssertionError(\n","                \"Duplicate tests in ranking for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","    return True\n","\n","\n","# ---------------------------------------------------------\n","# 12. RUN ONE COMPLETE CONDITION\n","# ---------------------------------------------------------\n","\n","def run_unified_condition(\n","    noise_percent,\n","    repetition_seed,\n","    save_rankings=True,\n","    overwrite=False,\n","):\n","    \"\"\"\n","    Run one project × noise × seed condition.\n","\n","    One corrupted training history is generated and shared\n","    by all four ML models and LatestFail.\n","    \"\"\"\n","\n","    condition_start_time = time.time()\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{int(repetition_seed):02d}\"\n","    )\n","\n","    condition_directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","    completion_marker = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","    if completion_marker.exists() and not overwrite:\n","        raise FileExistsError(\n","            \"This condition already has a success marker:\\n\"\n","            f\"{completion_marker}\\n\"\n","            \"Use overwrite=True only when intentionally \"\n","            \"rerunning it.\"\n","        )\n","\n","\n","    evaluation_hash_before = int(\n","        pd.util.hash_pandas_object(\n","            clean_evaluation_data[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    \"Verdict\",\n","                    \"Duration\",\n","                    *REC_FEATURE_COLUMNS,\n","                ]\n","            ],\n","            index=True,\n","        ).sum()\n","    )\n","\n","\n","    # One shared corruption.\n","    (\n","        noisy_training_history,\n","        noise_manifest,\n","        noise_summary,\n","    ) = inject_training_verdict_noise(\n","        clean_training_history,\n","        noise_percent=noise_percent,\n","        repetition_seed=repetition_seed,\n","    )\n","\n","\n","    # One shared reconstructed training dataset.\n","    noisy_training_data = (\n","        create_noisy_model_training_data(\n","            clean_training_data,\n","            noisy_training_history,\n","        )\n","    )\n","\n","\n","    (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    ) = prepare_ml_matrices(\n","        noisy_training_data,\n","        clean_evaluation_data,\n","    )\n","\n","\n","    all_ranking_frames = []\n","    fit_records = []\n","\n","    models = create_ml_models(\n","        repetition_seed\n","    )\n","\n","\n","    # Four ML techniques.\n","    for technique, model in models.items():\n","\n","        model_start_time = time.time()\n","\n","        with warnings.catch_warnings():\n","            warnings.simplefilter(\n","                \"ignore\"\n","            )\n","\n","            model.fit(\n","                X_train,\n","                y_train,\n","            )\n","\n","        failure_probabilities = (\n","            get_failure_probability(\n","                model,\n","                X_evaluation,\n","            )\n","        )\n","\n","        model_rankings = (\n","            create_ml_rankings(\n","                evaluation_data=(\n","                    clean_evaluation_data\n","                ),\n","                technique=technique,\n","                failure_probabilities=(\n","                    failure_probabilities\n","                ),\n","            )\n","        )\n","\n","        all_ranking_frames.append(\n","            model_rankings\n","        )\n","\n","        fit_records.append({\n","            \"Project\": PROJECT_NAME,\n","            \"NoisePercent\":\n","                float(noise_percent),\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","            \"Technique\":\n","                technique,\n","            \"FitSeconds\":\n","                time.time()\n","                - model_start_time,\n","            \"TrainingRows\":\n","                len(X_train),\n","            \"TrainingFailures\":\n","                int(y_train.sum()),\n","            \"TrainingPasses\":\n","                int(\n","                    len(y_train)\n","                    - y_train.sum()\n","                ),\n","            \"ActiveFeatures\":\n","                len(\n","                    ACTIVE_FEATURE_COLUMNS\n","                ),\n","        })\n","\n","\n","    # Random baseline.\n","    random_rankings = (\n","        create_random_rankings(\n","            clean_evaluation_data,\n","            repetition_seed,\n","        )\n","    )\n","\n","    all_ranking_frames.append(\n","        random_rankings\n","    )\n","\n","\n","    # LatestFail and QTF-Avg.\n","    (\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ) = create_history_baseline_rankings(\n","        noisy_training_history\n","    )\n","\n","    all_ranking_frames.extend([\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ])\n","\n","\n","    all_rankings = pd.concat(\n","        all_ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","    all_rankings.insert(\n","        0,\n","        \"Project\",\n","        PROJECT_NAME,\n","    )\n","\n","    all_rankings.insert(\n","        1,\n","        \"NoisePercent\",\n","        float(noise_percent),\n","    )\n","\n","    all_rankings.insert(\n","        2,\n","        \"RepetitionSeed\",\n","        int(repetition_seed),\n","    )\n","\n","\n","    build_metrics = (\n","        calculate_build_metrics(\n","            all_rankings,\n","            noise_percent,\n","            repetition_seed,\n","        )\n","    )\n","\n","    validate_condition_outputs(\n","        all_rankings,\n","        build_metrics,\n","    )\n","\n","\n","    project_run_metrics = (\n","        build_metrics\n","        .groupby(\n","            [\n","                \"Project\",\n","                \"NoisePercent\",\n","                \"RepetitionSeed\",\n","                \"Technique\",\n","            ],\n","            as_index=False,\n","        )\n","        .agg(\n","            MeanAPFD=(\n","                \"APFD\",\n","                \"mean\",\n","            ),\n","            MeanAPFDc=(\n","                \"APFDc\",\n","                \"mean\",\n","            ),\n","            SD_APFD=(\n","                \"APFD\",\n","                \"std\",\n","            ),\n","            SD_APFDc=(\n","                \"APFDc\",\n","                \"std\",\n","            ),\n","            EvaluatedBuilds=(\n","                \"Build\",\n","                \"nunique\",\n","            ),\n","            TotalRankedTests=(\n","                \"NumberOfTests\",\n","                \"sum\",\n","            ),\n","            TotalFailures=(\n","                \"NumberOfFailures\",\n","                \"sum\",\n","            ),\n","        )\n","    )\n","\n","\n","    evaluation_hash_after = int(\n","        pd.util.hash_pandas_object(\n","            clean_evaluation_data[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    \"Verdict\",\n","                    \"Duration\",\n","                    *REC_FEATURE_COLUMNS,\n","                ]\n","            ],\n","            index=True,\n","        ).sum()\n","    )\n","\n","    if (\n","        evaluation_hash_before\n","        != evaluation_hash_after\n","    ):\n","        raise AssertionError(\n","            \"The clean evaluation data changed \"\n","            \"during the condition.\"\n","        )\n","\n","\n","    fit_times = pd.DataFrame(\n","        fit_records\n","    )\n","\n","    noise_summary_dataframe = (\n","        pd.DataFrame([\n","            noise_summary\n","        ])\n","    )\n","\n","\n","    # Save only after validation succeeds.\n","    noise_manifest.to_parquet(\n","        condition_directory\n","        / \"noise_manifest.parquet\",\n","        index=False,\n","    )\n","\n","    noise_summary_dataframe.to_csv(\n","        condition_directory\n","        / \"noise_summary.csv\",\n","        index=False,\n","    )\n","\n","    build_metrics.to_parquet(\n","        condition_directory\n","        / \"build_metrics.parquet\",\n","        index=False,\n","    )\n","\n","    project_run_metrics.to_csv(\n","        condition_directory\n","        / \"project_run_metrics.csv\",\n","        index=False,\n","    )\n","\n","    fit_times.to_csv(\n","        condition_directory\n","        / \"fit_times.csv\",\n","        index=False,\n","    )\n","\n","    if save_rankings:\n","        all_rankings.to_parquet(\n","            condition_directory\n","            / \"rankings.parquet\",\n","            index=False,\n","        )\n","\n","\n","    condition_metadata = {\n","        \"Project\": PROJECT_NAME,\n","        \"NoisePercent\":\n","            float(noise_percent),\n","        \"RepetitionSeed\":\n","            int(repetition_seed),\n","        \"TrainingExecutionRows\":\n","            len(clean_training_history),\n","        \"TrainingModelRows\":\n","            len(noisy_training_data),\n","        \"EvaluationModelRows\":\n","            len(clean_evaluation_data),\n","        \"EvaluatedBuilds\":\n","            int(\n","                clean_evaluation_data[\n","                    \"Build\"\n","                ].nunique()\n","            ),\n","        \"TechniqueCount\":\n","            int(\n","                project_run_metrics[\n","                    \"Technique\"\n","                ].nunique()\n","            ),\n","        \"RankingRows\":\n","            len(all_rankings),\n","        \"BuildMetricRows\":\n","            len(build_metrics),\n","        \"EvaluationHashUnchanged\":\n","            True,\n","        \"ElapsedSeconds\":\n","            time.time()\n","            - condition_start_time,\n","        \"CompletedSuccessfully\":\n","            True,\n","    }\n","\n","    with open(\n","        completion_marker,\n","        \"w\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","        json.dump(\n","            condition_metadata,\n","            marker_file,\n","            indent=2,\n","        )\n","\n","\n","    print(\n","        \"\\n=== CONDITION COMPLETED ===\"\n","    )\n","\n","    print(\n","        \"Project:\",\n","        PROJECT_NAME,\n","    )\n","\n","    print(\n","        \"Noise:\",\n","        f\"{noise_percent}%\",\n","    )\n","\n","    print(\n","        \"Seed:\",\n","        repetition_seed,\n","    )\n","\n","    print(\n","        \"Noise flips:\",\n","        noise_summary[\"NumberFlipped\"],\n","    )\n","\n","    print(\n","        \"Realised noise:\",\n","        round(\n","            noise_summary[\n","                \"RealisedNoisePercent\"\n","            ],\n","            6,\n","        ),\n","        \"%\",\n","    )\n","\n","    print(\n","        \"Ranking rows:\",\n","        len(all_rankings),\n","    )\n","\n","    print(\n","        \"Build-metric rows:\",\n","        len(build_metrics),\n","    )\n","\n","    print(\n","        \"Evaluation unchanged:\",\n","        True,\n","    )\n","\n","    print(\n","        \"Elapsed seconds:\",\n","        round(\n","            condition_metadata[\n","                \"ElapsedSeconds\"\n","            ],\n","            2,\n","        ),\n","    )\n","\n","    print(\n","        \"\\nSaved to:\"\n","    )\n","\n","    print(\n","        condition_directory\n","    )\n","\n","    print(\n","        \"\\nProject-run results:\"\n","    )\n","\n","    display(\n","        project_run_metrics[\n","            [\n","                \"Technique\",\n","                \"MeanAPFD\",\n","                \"MeanAPFDc\",\n","                \"SD_APFD\",\n","                \"SD_APFDc\",\n","                \"EvaluatedBuilds\",\n","            ]\n","        ]\n","        .sort_values(\n","            \"MeanAPFDc\",\n","            ascending=False,\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    return {\n","        \"noise_summary\":\n","            noise_summary_dataframe,\n","        \"fit_times\":\n","            fit_times,\n","        \"rankings\":\n","            all_rankings,\n","        \"build_metrics\":\n","            build_metrics,\n","        \"project_run_metrics\":\n","            project_run_metrics,\n","        \"condition_directory\":\n","            condition_directory,\n","    }\n",