6.5,12Z\"/\u003e\n","  \u003c/svg\u003e\n","    \u003c/button\u003e\n","    \u003cscript\u003e\n","      (() =\u003e {\n","      const buttonEl =\n","        document.querySelector('#id_31b363ef-d9d3-49b4-a9f4-2c8290dd59a2 button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () =\u003e {\n","        google.colab.notebook.generateWithVariable('rf_clean_project_summary');\n","      }\n","      })();\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","    \u003c/div\u003e\n","  \u003c/div\u003e\n"],"text/plain":["       count      mean       std       min       25%       50%       75%  \\\n","APFD    28.0  0.850415  0.081978  0.454286  0.860000  0.860000  0.860000   \n","APFDc   28.0  0.879340  0.116209  0.310472  0.872167  0.916915  0.917893   \n","\n","            max  \n","APFD   0.972973  \n","APFDc  0.989597  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Mean clean RF APFD: 0.8504149853397973\n","Mean clean RF APFDc: 0.8793402825379925\n","Median clean RF APFD: 0.86\n","Median clean RF APFDc: 0.9169151926015717\n"]}],"source":["# ---------------------------------------------------------\n","# CALCULATE APFD AND APFDC FOR CLEAN 0% RANDOM FOREST\n","# ---------------------------------------------------------\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","def calculate_tcp_metrics(build_ranking):\n","    \"\"\"\n","    Calculate APFD and APFDc for one failed CI build.\n","\n","    Assumptions:\n","    - Each non-passing test represents one distinct fault.\n","    - RF_Rank starts at 1.\n","    - Tests are ordered by RF_Rank.\n","    - Duration is the execution cost.\n","    \"\"\"\n","\n","    ordered = (\n","        build_ranking\n","        .sort_values([\"RF_Rank\", \"Test\"])\n","        .reset_index(drop=True)\n","        .copy()\n","    )\n","\n","    number_of_tests = len(ordered)\n","\n","    failure_flags = (\n","        ordered[\"BinaryFailure\"]\n","        .astype(int)\n","        .to_numpy()\n","    )\n","\n","    durations = (\n","        ordered[\"Duration\"]\n","        .astype(float)\n","        .to_numpy()\n","    )\n","\n","    failure_indices = np.flatnonzero(\n","        failure_flags == 1\n","    )\n","\n","    number_of_failures = len(failure_indices)\n","\n","    if number_of_tests == 0:\n","        raise ValueError(\n","            \"Cannot calculate metrics for an empty build.\"\n","        )\n","\n","    if number_of_failures == 0:\n","        raise ValueError(\n","            \"APFD and APFDc require at least one failure.\"\n","        )\n","\n","    if np.any(durations \u003c 0):\n","        raise ValueError(\n","            \"Execution durations cannot be negative.\"\n","        )\n","\n","    total_duration = durations.sum()\n","\n","    if total_duration \u003c= 0:\n","        raise ValueError(\n","            \"Total build duration must be greater than zero.\"\n","        )\n","\n","\n","    # -----------------------------------------------------\n","    # APFD\n","    # -----------------------------------------------------\n","    # Convert zero-based array positions into ranks\n","    # beginning from 1.\n","    failure_ranks = failure_indices + 1\n","\n","    apfd = (\n","        1\n","        - (\n","            failure_ranks.sum()\n","            /\n","            (\n","                number_of_tests\n","                * number_of_failures\n","            )\n","        )\n","        + (\n","            1\n","            /\n","            (2 * number_of_tests)\n","        )\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # APFDC\n","    # -----------------------------------------------------\n","    # Time spent before each test begins.\n","    cumulative_time_before_test = np.concatenate(\n","        [\n","            np.array([0.0]),\n","            np.cumsum(durations)[:-1],\n","        ]\n","    )\n","\n","    # A fault is treated as detected halfway through\n","    # the failing test's execution.\n","    fault_detection_midpoints = (\n","        cumulative_time_before_test[\n","            failure_indices\n","        ]\n","        +\n","        (\n","            durations[failure_indices]\n","            / 2\n","        )\n","    )\n","\n","    apfdc = (\n","        1\n","        -\n","        (\n","            fault_detection_midpoints.sum()\n","            /\n","            (\n","                number_of_failures\n","                * total_duration\n","            )\n","        )\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # EXTRA INTERPRETABLE VALUES\n","    # -----------------------------------------------------\n","\n","    first_failure_index = int(\n","        failure_indices[0]\n","    )\n","\n","    first_failure_rank = int(\n","        failure_ranks[0]\n","    )\n","\n","    time_before_first_failure = float(\n","        cumulative_time_before_test[\n","            first_failure_index\n","        ]\n","    )\n","\n","    time_until_first_failure_finishes = float(\n","        np.cumsum(durations)[\n","            first_failure_index\n","        ]\n","    )\n","\n","    return {\n","        \"NumberOfTests\":\n","            number_of_tests,\n","\n","        \"NumberOfFailures\":\n","            number_of_failures,\n","\n","        \"FailureRanks\":\n","            \",\".join(\n","                str(int(rank))\n","                for rank in failure_ranks\n","            ),\n","\n","        \"FirstFailureRank\":\n","            first_failure_rank,\n","\n","        \"TotalDuration\":\n","            float(total_duration),\n","\n","        \"TimeBeforeFirstFailure\":\n","            time_before_first_failure,\n","\n","        \"TimeUntilFirstFailureFinishes\":\n","            time_until_first_failure_finishes,\n","\n","        \"APFD\":\n","            float(apfd),\n","\n","        \"APFDc\":\n","            float(apfdc),\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# CALCULATE METRICS FOR ALL 28 EVALUATION BUILDS\n","# ---------------------------------------------------------\n","\n","rf_clean_metric_records = []\n","\n","for build_id, build_group in (\n","    rf_clean_ranking.groupby(\n","        \"Build\",\n","        sort=False\n","    )\n","):\n","\n","    build_metrics = calculate_tcp_metrics(\n","        build_group\n","    )\n","\n","    build_metrics[\"Build\"] = int(build_id)\n","\n","    build_metrics[\"build_order\"] = int(\n","        build_group[\"build_order\"].iloc[0]\n","    )\n","\n","    rf_clean_metric_records.append(\n","        build_metrics\n","    )\n","\n","\n","rf_clean_build_metrics = (\n","    pd.DataFrame(rf_clean_metric_records)\n","    .sort_values(\"build_order\")\n","    .reset_index(drop=True)\n",")\n","\n","\n","# Reorder columns for readability\n","rf_clean_build_metrics = (\n","    rf_clean_build_metrics[\n","        [\n","            \"Build\",\n","            \"build_order\",\n","            \"NumberOfTests\",\n","            \"NumberOfFailures\",\n","            \"FailureRanks\",\n","            \"FirstFailureRank\",\n","            \"TotalDuration\",\n","            \"TimeBeforeFirstFailure\",\n","            \"TimeUntilFirstFailureFinishes\",\n","            \"APFD\",\n","            \"APFDc\",\n","        ]\n","    ]\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION CHECKS\n","# ---------------------------------------------------------\n","\n","if len(rf_clean_build_metrics) != 28:\n","    raise ValueError(\n","        \"Expected metrics for 28 evaluation builds, \"\n","        f\"but obtained {len(rf_clean_build_metrics)}.\"\n","    )\n","\n","if rf_clean_build_metrics[\n","    [\"APFD\", \"APFDc\"]\n","].isna().any().any():\n","    raise ValueError(\n","        \"A metric contains a mi