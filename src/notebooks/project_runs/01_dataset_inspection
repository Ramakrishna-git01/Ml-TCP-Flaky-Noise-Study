 30                    21   \n","1       XGBoost                        1                     1   \n","2      LightGBM                        1                     1   \n","3    NaiveBayes                        1                     1   \n","4        Random                       30                    30   \n","5    LatestFail                        1                     1   \n","6       QTF-Avg                        1                     1   \n","\n","   UniqueMeanAPFDcValues  MinimumMeanAPFDc  MaximumMeanAPFDc  \n","0                     30          0.574090          0.687199  \n","1                      1          0.654301          0.654301  \n","2                      1          0.621060          0.621060  \n","3                      1          0.667729          0.667729  \n","4                     30          0.394054          0.562085  \n","5                      1          0.716184          0.716184  \n","6                      1          0.248094          0.248094  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Final directory:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_30_seed_final\n","Audit elapsed minutes: 1.02\n","\n","SUCCESS: Snow Owl completed the full 30-seed experiment and passed every final audit.\n"]}],"source":["# =========================================================\n","# PROJECT 3: SNOW OWL\n","# FINAL 30-SEED AUDIT AND AGGREGATION\n","# =========================================================\n","\n","from pathlib import Path\n","import hashlib\n","import json\n","import time\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","# ---------------------------------------------------------\n","# 1. Final locations and expected structure\n","# ---------------------------------------------------------\n","\n","FINAL_DIRECTORY = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n","    / \"snow_owl_30_seed_final\"\n",")\n","\n","FINAL_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","EXPECTED_CONDITIONS = 270\n","EXPECTED_SEEDS = 30\n","EXPECTED_NOISE_LEVELS = 9\n","EXPECTED_TECHNIQUES = 7\n","\n","EXPECTED_TRAINING_EXECUTION_ROWS = 9812\n","EXPECTED_EVALUATION_ROWS = 581\n","EXPECTED_EVALUATION_BUILDS = 15\n","\n","EXPECTED_PROJECT_RUN_ROWS = 1890\n","EXPECTED_BUILD_METRIC_ROWS = 28350\n","EXPECTED_RANKING_ROWS = 1098090\n","EXPECTED_FIT_TIME_ROWS = 1080\n","\n","EXPECTED_NESTED_COMPARISONS = 240\n","\n","\n","EXPECTED_TECHNIQUE_NAMES = (\n","    ML_TECHNIQUES\n","    + BASELINE_TECHNIQUES\n",")\n","\n","\n","REQUIRED_CONDITION_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"rankings.parquet\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","]\n","\n","\n","print(\n","    \"=== SNOW OWL FINAL 30-SEED AUDIT ===\"\n",")\n","\n","print(\n","    \"Expected conditions:\",\n","    EXPECTED_CONDITIONS,\n",")\n","\n","print(\n","    \"Expected ranking rows:\",\n","    EXPECTED_RANKING_ROWS,\n",")\n","\n","\n","audit_start_time = time.time()\n","\n","\n","# ---------------------------------------------------------\n","# 2. Independent metric formulas\n","# ---------------------------------------------------------\n","\n","def audit_apfd(\n","    actual_failures,\n","):\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    number_of_tests = len(\n","        failures\n","    )\n","\n","    number_of_failures = int(\n","        failures.sum()\n","    )\n","\n","    if (\n","        number_of_tests == 0\n","        or number_of_failures == 0\n","    ):\n","        return np.nan\n","\n","    failure_ranks = (\n","        np.flatnonzero(\n","            failures == 1\n","        )\n","        + 1\n","    )\n","\n","    return float(\n","        1.0\n","        - failure_ranks.sum()\n","        / (\n","            number_of_tests\n","            * number_of_failures\n","        )\n","        + 1.0\n","        / (\n","            2.0\n","            * number_of_tests\n","        )\n","    )\n","\n","\n","def audit_apfdc(\n","    actual_failures,\n","    durations,\n","):\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    costs = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","    if len(failures) != len(costs):\n","        raise ValueError(\n","            \"Failure and duration lengths differ.\"\n","        )\n","\n","    if (\n","        len(failures) == 0\n","        or failures.sum() == 0\n","    ):\n","        return np.nan\n","\n","    if not np.isfinite(costs).all():\n","        raise ValueError(\n","            \"Invalid duration encountered.\"\n","        )\n","\n","    if (costs \u003c 0).any():\n","        raise ValueError(\n","            \"Negative duration encountered.\"\n","        )\n","\n","    total_cost = float(\n","        costs.sum()\n","    )\n","\n","    if total_cost \u003c= 0:\n","        return np.nan\n","\n","    cumulative_before = np.concatenate([\n","        np.array([0.0]),\n","        np.cumsum(costs)[:-1],\n","    ])\n","\n","    failure_mask = (\n","        failures == 1\n","    )\n","\n","    midpoint_times = (\n","        cumulative_before[\n","            failure_mask\n","        ]\n","        + 0.5\n","        * costs[\n","            failure_mask\n","        ]\n","    )\n","\n","    return float(\n","        1.0\n","        - np.mean(\n","            midpoint_times\n","            / total_cost\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Stable dataframe signatures\n","# ---------------------------------------------------------\n","\n","def dataframe_signature(\n","    dataframe,\n","    columns,\n","    sort_columns,\n","):\n","    normalized = (\n","        dataframe[\n","            columns\n","        ]\n","        .sort_values(\n","            sort_columns,\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    hash_values = (\n","        pd.util.hash_pandas_object(\n","            normalized,\n","            index=False,\n","        )\n","        .to_numpy()\n","    )\n","\n","    return hashlib.sha256(\n","        hash_values.tobytes()\n","    ).hexdigest()\n","\n","\n","def technique_signature(\n","    rankings,\n","    technique,\n","):\n","    technique_rows = (\n","        rankings[\n","            rankings[\n","                \"Technique\"\n","            ] == technique\n","        ]\n","    )\n","\n","    return dataframe_signature(\n","        technique_rows,\n","        columns=[\n","            \"Build\",\n","            \"Test\",\n","            \"Rank\",\n","            \"Score\",\n","        ],\n","        sort_columns=[\n","            \"Build\",\n","            \"Rank\",\n","        ],\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Clean evaluation reference\n","# ---------------------------------------------------------\n","\n","evaluation_reference = (\n","    clean_evaluation_data[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"Verdict\",\n","            \"Duration\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .sort_values(\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(evaluation_reference) != (\n","    EXPECTED_EVALUATION_ROWS\n","):\n","    raise AssertionError(\n","        \"Unexpected clean evaluation row count.\"\n","    )\n","\n","\n","allowed_failure_subtypes = set(\n","    clean_training_history.loc[\n","        clean_training_history[\n","            \"verdict\"\n","        ] != 0,\n","        \"verdict\",\n","    ]\n","    .astype(int)\n","    .unique()\n",")\n","\n","allowed_noisy_verdicts = (\n","    {0}\n","    | allowed_failure_subtypes\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Audit containers\n","# ---------------------------------------------------------\n","\n","condition_audit_records = []\n","uniform_audit_records = []\n","nested_mask_records = []\n","baseline_invariance_records = []\n","\n","project_run_frames = []\n","build_metric_frames = []\n","ranking_frames = []\n","noise_summary_frames = []\n","fit_time_frames = []\n","\n","uniform_seed_signatures = {}\n","random_seed_signatures = {}\n","\n","global_identity_signatures = set()\n","\n","global_qtf_signature = None\n","\n","zero_noise_signatures = {\n","    technique: []\n","    for technique\n","    in EXPECTED_TECHNIQUE_NAMES\n","}\n","\n","\n","metric_recalculation_mismatches = 0\n","ranking_tie_violations = 0\n","evaluation_data_mismatches = 0\n","project_run_aggregation_mismatches = 0\n","\n","processed_conditions = 0\n","\n","\n","# ---------------------------------------------------------\n","# 6. Audit all seeds and noise levels\n","# ---------------------------------------------------------\n","\n","for repetition_seed in REPETITION_SEEDS:\n","\n","    reference_identity_frame = None\n","    reference_uniforms = None\n","\n","    random_reference_signature = None\n","    qtf_seed_reference_signature = None\n","\n","    previous_mask = None\n","    previous_noise = None\n","\n","\n","    for noise_percent in NOISE_LEVELS:\n","\n","        condition_directory = (\n","            PROJECT_RAW_RESULTS\n","            / f\"noise_{int(noise_percent):03d}\"\n","            / f\"seed_{int(repetition_seed):02d}\"\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # 6A. Files and completion marker\n","        # -------------------------------------------------\n","\n","        missing_files = [\n","            file_name\n","            for file_name\n","            in REQUIRED_CONDITION_FILES\n","            if not (\n","                condition_directory\n","                / file_name\n","            ).exists()\n","        ]\n","\n","        if missing_files:\n","            raise FileNotFoundError(\n","                \"Condition is missing files.\\n\"\n","                f\"Seed: {repetition_seed}\\n\"\n","                f\"Noise: {noise_percent}%\\n\"\n","                + \"\\n\".join(missing_files)\n","            )\n","\n","\n","        with open(\n","            condition_directory\n","            / \"_SUCCESS.json\",\n","            \"r\",\n","            encoding=\"utf-8\",\n","        ) as marker_file:\n","\n","            metadata = json.load(\n","                marker_file\n","            )\n","\n","\n","        if not metadata.get(\n","            \"CompletedSuccessfully\",\n","            False,\n","        ):\n","            raise AssertionError(\n","                \"Condition is not marked successful.\"\n","            )\n","\n","        if not metadata.get(\n","            \"EvaluationHashUnchanged\",\n","            False,\n","        ):\n","            raise AssertionError(\n","                \"Condition reports modified \"\n","                \"evaluation data.\"\n","            )\n","\n","        if int(\n","            metadata.get(\n","                \"RankingRows\",\n","                -1,\n","            )\n","        ) != 4067:\n","            raise AssertionError(\n","                \"Unexpected ranking count in marker.\"\n","            )\n","\n","        if int(\n","            metadata.get(\n","                \"BuildMetricRows\",\n","                -1,\n","            )\n","        ) != 105:\n","            raise AssertionError(\n","                \"Unexpected metric count in marker.\"\n","            )\n","\n","        if int(\n","            metadata.get(\n","                \"EvaluatedBuilds\",\n","                -1,\n","            )\n","        ) != EXPECTED_EVALUATION_BUILDS:\n","            raise AssertionError(\n","                \"Unexpected evaluated-build count.\"\n","            )\n","\n","        if int(\n","            metadata.get(\n","                \"TechniqueCount\",\n","                -1,\n","            )\n","        ) != EXPECTED_TECHNIQUES:\n","            raise AssertionError(\n","                \"Unexpected technique count.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6B. Load condition outputs\n","        # -------------------------------------------------\n","\n","        manifest = pd.read_parquet(\n","            condition_directory\n","            / \"noise_manifest.parquet\"\n","        )\n","\n","        noise_summary = pd.read_csv(\n","            condition_directory\n","            / \"noise_summary.csv\"\n","        )\n","\n","        rankings = pd.read_parquet(\n","            condition_directory\n","            / \"rankings.parquet\"\n","        )\n","\n","        build_metrics = pd.read_parquet(\n","            condition_directory\n","            / \"build_metrics.parquet\"\n","        )\n","\n","        project_run_metrics = pd.read_csv(\n","            condition_directory\n","            / \"project_run_metrics.csv\"\n","        )\n","\n","        fit_times = pd.read_csv(\n","            condition_directory\n","            / \"fit_times.csv\"\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # 6C. Basic condition structure\n","        # -------------------------------------------------\n","\n","        if len(manifest) != (\n","            EXPECTED_TRAINING_EXECUTION_ROWS\n","        ):\n","            raise AssertionError(\n","                \"Unexpected manifest row count.\"\n","            )\n","\n","        if len(noise_summary) != 1:\n","            raise AssertionError(\n","                \"Noise summary must contain one row.\"\n","            )\n","\n","        if len(rankings) != 4067:\n","            raise AssertionError(\n","                \"Unexpected condition ranking count.\"\n","            )\n","\n","        if len(build_metrics) != 105:\n","            raise AssertionError(\n","                \"Unexpected condition metric count.\"\n","            )\n","\n","        if len(project_run_metrics) != 7:\n","            raise AssertionError(\n","                \"Unexpected project-run count.\"\n","            )\n","\n","        if len(fit_times) != 4:\n","            raise AssertionError(\n","                \"Unexpected ML fit-time count.\"\n","            )\n","\n","\n","        for condition_frame in [\n","            rankings,\n","            build_metrics,\n","            project_run_metrics,\n","            fit_times,\n","        ]:\n","\n","            if not (\n","                condition_frame[\n","                    \"Project\"\n","                ] == PROJECT_NAME\n","            ).all():\n","                raise AssertionError(\n","                    \"Project identifier mismatch.\"\n","                )\n","\n","            if not np.isclose(\n","                pd.to_numeric(\n","                    condition_frame[\n","                        \"NoisePercent\"\n","                    ],\n","                    errors=\"raise\",\n","                ).to_numpy(dtype=float),\n","                float(noise_percent),\n","                rtol=0.0,\n","                atol=0.0,\n","            ).all():\n","                raise AssertionError(\n","                    \"Noise identifier mismatch.\"\n","                )\n","\n","            if not (\n","                pd.to_numeric(\n","                    condition_frame[\n","                        \"RepetitionSeed\"\n","                    ],\n","                    errors=\"raise\",\n","                ).astype(int)\n","                == int(repetition_seed)\n","            ).all():\n","                raise AssertionError(\n","                    \"Seed identifier mismatch.\"\n","                )\n","\n","\n","        actual_techniques = set(\n","            rankings[\n","                \"Technique\"\n","            ].unique()\n","        )\n","\n","        if actual_techniques != set(\n","            EXPECTED_TECHNIQUE_NAMES\n","        ):\n","            raise AssertionError(\n","                \"Condition technique set is incomplete.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6D. Noise-manifest audit\n","        # -------------------------------------------------\n","\n","        manifest = (\n","            manifest\n","            .sort_values(\n","                \"NoiseRowID\"\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        expected_noise_row_ids = np.arange(\n","            EXPECTED_TRAINING_EXECUTION_ROWS\n","        )\n","\n","        if not np.array_equal(\n","            manifest[\n","                \"NoiseRowID\"\n","            ].to_numpy(),\n","            expected_noise_row_ids,\n","        ):\n","            raise AssertionError(\n","                \"NoiseRowID sequence is invalid.\"\n","            )\n","\n","\n","        identity_columns = [\n","            \"NoiseRowID\",\n","            \"Build\",\n","            \"Test\",\n","            \"OriginalVerdict\",\n","        ]\n","\n","        if \"Job\" in manifest.columns:\n","            identity_columns.append(\n","                \"Job\"\n","            )\n","\n","\n","        identity_signature = (\n","            dataframe_signature(\n","                manifest,\n","                columns=identity_columns,\n","                sort_columns=[\n","                    \"NoiseRowID\"\n","                ],\n","            )\n","        )\n","\n","        global_identity_signatures.add(\n","            identity_signature\n","        )\n","\n","\n","        uniforms = (\n","            manifest[\n","                \"FlipUniform\"\n","            ]\n","            .to_numpy(dtype=float)\n","        )\n","\n","        flipped_mask = (\n","            manifest[\n","                \"Flipped\"\n","            ]\n","            .to_numpy(dtype=bool)\n","        )\n","\n","        original_verdicts = (\n","            manifest[\n","                \"OriginalVerdict\"\n","            ]\n","            .to_numpy(dtype=int)\n","        )\n","\n","        noisy_verdicts = (\n","            manifest[\n","                \"NoisyVerdict\"\n","            ]\n","            .to_numpy(dtype=int)\n","        )\n","\n","\n","        if not set(\n","            np.unique(\n","                noisy_verdicts\n","            ).tolist()\n","        ).issubset(\n","            allowed_noisy_verdicts\n","        ):\n","            raise AssertionError(\n","                \"Unexpected noisy verdict subtype.\"\n","            )\n","\n","\n","        expected_flip_mask = (\n","            uniforms\n","            \u003c float(noise_percent) / 100.0\n","        )\n","\n","        mask_matches_threshold = bool(\n","            np.array_equal(\n","                flipped_mask,\n","                expected_flip_mask,\n","            )\n","        )\n","\n","        if not mask_matches_threshold:\n","            raise AssertionError(\n","                \"Flip mask does not match \"\n","                \"the common-uniform threshold.\"\n","            )\n","\n","\n","        unchanged_mask = (\n","            ~flipped_mask\n","        )\n","\n","        pass_to_failure_mask = (\n","            flipped_mask\n","            \u0026 (original_verdicts == 0)\n","        )\n","\n","        failure_to_pass_mask = (\n","            flipped_mask\n","            \u0026 (original_verdicts != 0)\n","        )\n","\n","\n","        if not np.array_equal(\n","            noisy_verdicts[\n","                unchanged_mask\n","            ],\n","            original_verdicts[\n","                unchanged_mask\n","            ],\n","        ):\n","            raise AssertionError(\n","                \"An unflipped verdict changed.\"\n","            )\n","\n","        if (\n","            noisy_verdicts[\n","                pass_to_failure_mask\n","            ] == 0\n","        ).any():\n","            raise AssertionError(\n","                \"A flipped pass remained a pass.\"\n","            )\n","\n","        if (\n","            noisy_verdicts[\n","                failure_to_pass_mask\n","            ] != 0\n","        ).any():\n","            raise AssertionError(\n","                \"A flipped failure did not become a pass.\"\n","            )\n","\n","        if not np.array_equal(\n","            manifest[\n","                \"PassToFailure\"\n","            ].to_numpy(dtype=bool),\n","            pass_to_failure_mask,\n","        ):\n","            raise AssertionError(\n","                \"PassToFailure flags are invalid.\"\n","            )\n","\n","        if not np.array_equal(\n","            manifest[\n","                \"FailureToPass\"\n","            ].to_numpy(dtype=bool),\n","            failure_to_pass_mask,\n","        ):\n","            raise AssertionError(\n","                \"FailureToPass flags are invalid.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6E. Noise-summary consistency\n","        # -------------------------------------------------\n","\n","        summary_row = (\n","            noise_summary.iloc[0]\n","        )\n","\n","        number_flipped = int(\n","            flipped_mask.sum()\n","        )\n","\n","        pass_to_failure_count = int(\n","            pass_to_failure_mask.sum()\n","        )\n","\n","        failure_to_pass_count = int(\n","            failure_to_pass_mask.sum()\n","        )\n","\n","        realised_noise = float(\n","            100.0\n","            * number_flipped\n","            / EXPECTED_TRAINING_EXECUTION_ROWS\n","        )\n","\n","\n","        if int(\n","            summary_row[\n","                \"TrainingExecutionRows\"\n","            ]\n","        ) != EXPECTED_TRAINING_EXECUTION_ROWS:\n","            raise AssertionError(\n","                \"Noise-summary training-row mismatch.\"\n","            )\n","\n","        if int(\n","            summary_row[\n","                \"NumberFlipped\"\n","            ]\n","        ) != number_flipped:\n","            raise AssertionError(\n","                \"Noise-summary flip-count mismatch.\"\n","            )\n","\n","        if int(\n","            summary_row[\n","                \"PassToFailure\"\n","            ]\n","        ) != pass_to_failure_count:\n","            raise AssertionError(\n","                \"Pass-to-failure count mismatch.\"\n","            )\n","\n","        if int(\n","            summary_row[\n","                \"FailureToPass\"\n","            ]\n","        ) != failure_to_pass_count:\n","            raise AssertionError(\n","                \"Failure-to-pass count mismatch.\"\n","            )\n","\n","        if not np.isclose(\n","            float(\n","                summary_row[\n","                    \"RealisedNoisePercent\"\n","                ]\n","            ),\n","            realised_noise,\n","            rtol=1e-12,\n","            atol=1e-12,\n","        ):\n","            raise AssertionError(\n","                \"Realised noise percentage mismatch.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6F. Common uniforms and nested masks\n","        # -------------------------------------------------\n","\n","        if reference_identity_frame is None:\n","\n","            reference_identity_frame = (\n","                manifest[\n","                    identity_columns\n","                ]\n","                .copy()\n","            )\n","\n","            reference_uniforms = (\n","                uniforms.copy()\n","            )\n","\n","            uniform_seed_signatures[\n","                int(repetition_seed)\n","            ] = hashlib.sha256(\n","                reference_uniforms.tobytes()\n","            ).hexdigest()\n","\n","            same_identity_as_zero = True\n","            same_uniforms_as_zero = True\n","\n","        else:\n","\n","            same_identity_as_zero = bool(\n","                reference_identity_frame.equals(\n","                    manifest[\n","                        identity_columns\n","                    ]\n","                )\n","            )\n","\n","            same_uniforms_as_zero = bool(\n","                np.array_equal(\n","                    reference_uniforms,\n","                    uniforms,\n","                )\n","            )\n","\n","            if not same_identity_as_zero:\n","                raise AssertionError(\n","                    \"Training-row identity changed \"\n","                    \"across noise levels.\"\n","                )\n","\n","            if not same_uniforms_as_zero:\n","                raise AssertionError(\n","                    \"Uniform stream changed across \"\n","                    \"noise levels within a seed.\"\n","                )\n","\n","\n","        uniform_audit_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","            \"NoisePercent\":\n","                int(noise_percent),\n","            \"SameIdentityAsZeroPercent\":\n","                bool(\n","                    same_identity_as_zero\n","                ),\n","            \"SameUniformStreamAsZeroPercent\":\n","                bool(\n","                    same_uniforms_as_zero\n","                ),\n","            \"MaskMatchesThreshold\":\n","                bool(\n","                    mask_matches_threshold\n","                ),\n","            \"NumberFlipped\":\n","                int(number_flipped),\n","            \"RealisedNoisePercent\":\n","                float(realised_noise),\n","        })\n","\n","\n","        if previous_mask is not None:\n","\n","            lower_subset_of_upper = bool(\n","                np.all(\n","                    ~previous_mask\n","                    | flipped_mask\n","                )\n","            )\n","\n","            nested_mask_records.append({\n","                \"Project\":\n","                    PROJECT_NAME,\n","                \"RepetitionSeed\":\n","                    int(repetition_seed),\n","                \"LowerNoisePercent\":\n","                    int(previous_noise),\n","                \"UpperNoisePercent\":\n","                    int(noise_percent),\n","                \"LowerFlippedRows\":\n","                    int(previous_mask.sum()),\n","                \"UpperFlippedRows\":\n","                    int(flipped_mask.sum()),\n","                \"LowerMaskSubsetOfUpper\":\n","                    bool(\n","                        lower_subset_of_upper\n","                    ),\n","            })\n","\n","\n","        previous_mask = (\n","            flipped_mask.copy()\n","        )\n","\n","        previous_noise = int(\n","            noise_percent\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # 6G. Evaluation data must be identical\n","        # -------------------------------------------------\n","\n","        for technique in (\n","            EXPECTED_TECHNIQUE_NAMES\n","        ):\n","\n","            technique_rankings = (\n","                rankings[\n","                    rankings[\n","                        \"Technique\"\n","                    ] == technique\n","                ]\n","                .sort_values(\n","                    [\n","                        \"Build\",\n","                        \"Test\",\n","                    ]\n","                )\n","                .reset_index(drop=True)\n","            )\n","\n","\n","            if len(\n","                technique_rankings\n","            ) != EXPECTED_EVALUATION_ROWS:\n","                evaluation_data_mismatches += 1\n","\n","                raise AssertionError(\n","                    f\"{technique} did not contain all \"\n","                    \"evaluation rows.\"\n","                )\n","\n","\n","            for identifier_column in [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"build_order\",\n","            ]:\n","\n","                if not np.array_equal(\n","                    technique_rankings[\n","                        identifier_column\n","                    ].to_numpy(),\n","                    evaluation_reference[\n","                        identifier_column\n","                    ].to_numpy(),\n","                ):\n","                    evaluation_data_mismatches += 1\n","\n","                    raise AssertionError(\n","                        \"Evaluation identifier or verdict \"\n","                        f\"changed for {technique}.\"\n","                    )\n","\n","\n","            if not np.allclose(\n","                technique_rankings[\n","                    \"Duration\"\n","                ].to_numpy(dtype=float),\n","                evaluation_reference[\n","                    \"Duration\"\n","                ].to_numpy(dtype=float),\n","                rtol=0.0,\n","                atol=0.0,\n","                equal_nan=True,\n","            ):\n","                evaluation_data_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"Evaluation durations changed.\"\n","                )\n","\n","\n","            expected_actual_failure = (\n","                technique_rankings[\n","                    \"Verdict\"\n","                ].to_numpy(dtype=int)\n","                != 0\n","            ).astype(int)\n","\n","            if not np.array_equal(\n","                technique_rankings[\n","                    \"ActualFailure\"\n","                ].to_numpy(dtype=int),\n","                expected_actual_failure,\n","            ):\n","                evaluation_data_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"ActualFailure does not match Verdict.\"\n","                )\n","\n","\n","            if technique_rankings[\n","                \"Score\"\n","            ].isna().any():\n","                raise AssertionError(\n","                    \"Ranking scores contain missing values.\"\n","                )\n","\n","            if (\n","                technique != \"QTF-Avg\"\n","                and not np.isfinite(\n","                    technique_rankings[\n","                        \"Score\"\n","                    ].to_numpy(dtype=float)\n","                ).all()\n","            ):\n","                raise AssertionError(\n","                    f\"{technique} has invalid scores.\"\n","                )\n","\n","\n","        # -------------------------------------------------\n","        # 6H. Ranking order, tie rule and metrics\n","        # -------------------------------------------------\n","\n","        if rankings.duplicated(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ).any():\n","            raise AssertionError(\n","                \"Duplicate ranked tests found.\"\n","            )\n","\n","\n","        if build_metrics.duplicated(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ]\n","        ).any():\n","            raise AssertionError(\n","                \"Duplicate build metrics found.\"\n","            )\n","\n","\n","        metric_lookup = (\n","            build_metrics\n","            .set_index(\n","                [\n","                    \"Technique\",\n","                    \"Build\",\n","                ]\n","            )\n","        )\n","\n","\n","        for (\n","            technique,\n","            build_id,\n","        ), ranked_build in rankings.groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ],\n","            sort=False,\n","        ):\n","\n","            ranked_by_rank = (\n","                ranked_build\n","                .sort_values(\"Rank\")\n","                .reset_index(drop=True)\n","            )\n","\n","            expected_ranks = np.arange(\n","                1,\n","                len(ranked_by_rank) + 1,\n","            )\n","\n","            if not np.array_equal(\n","                ranked_by_rank[\n","                    \"Rank\"\n","                ].to_numpy(),\n","                expected_ranks,\n","            ):\n","                ranking_tie_violations += 1\n","\n","                raise AssertionError(\n","                    \"Invalid rank sequence.\"\n","                )\n","\n","\n","            score_ascending = (\n","                technique == \"QTF-Avg\"\n","            )\n","\n","            expected_order = (\n","                ranked_build\n","                .sort_values(\n","                    [\n","                        \"Score\",\n","                        \"Test\",\n","                    ],\n","                    ascending=[\n","                        score_ascending,\n","                        True,\n","                    ],\n","                    kind=\"mergesort\",\n","                )\n","                .reset_index(drop=True)\n","            )\n","\n","\n","            if not np.array_equal(\n","                ranked_by_rank[\n","                    \"Test\"\n","                ].to_numpy(),\n","                expected_order[\n","                    \"Test\"\n","                ].to_numpy(),\n","            ):\n","                ranking_tie_violations += 1\n","\n","                raise AssertionError(\n","                    \"Score/Test tie rule was violated.\"\n","                )\n","\n","\n","            actual_failures = (\n","                ranked_by_rank[\n","                    \"ActualFailure\"\n","                ]\n","                .to_numpy(dtype=int)\n","            )\n","\n","            durations = (\n","                ranked_by_rank[\n","                    \"Duration\"\n","                ]\n","                .to_numpy(dtype=float)\n","            )\n","\n","            recalculated_apfd = (\n","                audit_apfd(\n","                    actual_failures\n","                )\n","            )\n","\n","            recalculated_apfdc = (\n","                audit_apfdc(\n","                    actual_failures,\n","                    durations,\n","                )\n","            )\n","\n","\n","            saved_metric = metric_lookup.loc[\n","                (\n","                    technique,\n","                    int(build_id),\n","                )\n","            ]\n","\n","\n","            if int(\n","                saved_metric[\n","                    \"NumberOfTests\"\n","                ]\n","            ) != len(ranked_by_rank):\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"NumberOfTests mismatch.\"\n","                )\n","\n","            if int(\n","                saved_metric[\n","                    \"NumberOfFailures\"\n","                ]\n","            ) != int(\n","                actual_failures.sum()\n","            ):\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"NumberOfFailures mismatch.\"\n","                )\n","\n","            if int(\n","                saved_metric[\n","                    \"BuildOrder\"\n","                ]\n","            ) != int(\n","                ranked_by_rank[\n","                    \"build_order\"\n","                ].iloc[0]\n","            ):\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"BuildOrder mismatch.\"\n","                )\n","\n","            if not np.isclose(\n","                float(\n","                    saved_metric[\"APFD\"]\n","                ),\n","                recalculated_apfd,\n","                rtol=1e-12,\n","                atol=1e-12,\n","            ):\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"APFD recalculation mismatch.\"\n","                )\n","\n","            if not np.isclose(\n","                float(\n","                    saved_metric[\"APFDc\"]\n","                ),\n","                recalculated_apfdc,\n","                rtol=1e-12,\n","                atol=1e-12,\n","            ):\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"APFDc recalculation mismatch.\"\n","                )\n","\n","\n","        if not build_metrics[\n","            \"APFD\"\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","            raise AssertionError(\n","                \"APFD outside [0, 1].\"\n","            )\n","\n","        if not build_metrics[\n","            \"APFDc\"\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","            raise AssertionError(\n","                \"APFDc outside [0, 1].\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6I. Recalculate project-run summaries\n","        # -------------------------------------------------\n","\n","        recalculated_project_run = (\n","            build_metrics\n","            .groupby(\n","                [\n","                    \"Project\",\n","                    \"NoisePercent\",\n","                    \"RepetitionSeed\",\n","                    \"Technique\",\n","                ],\n","                as_index=False,\n","            )\n","            .agg(\n","                MeanAPFD=(\n","                    \"APFD\",\n","                    \"mean\",\n","                ),\n","                MeanAPFDc=(\n","                    \"APFDc\",\n","                    \"mean\",\n","                ),\n","                SD_APFD=(\n","                    \"APFD\",\n","                    \"std\",\n","                ),\n","                SD_APFDc=(\n","                    \"APFDc\",\n","                    \"std\",\n","                ),\n","                EvaluatedBuilds=(\n","                    \"Build\",\n","                    \"nunique\",\n","                ),\n","                TotalRankedTests=(\n","                    \"NumberOfTests\",\n","                    \"sum\",\n","                ),\n","                TotalFailures=(\n","                    \"NumberOfFailures\",\n","                    \"sum\",\n","                ),\n","            )\n","        )\n","\n","\n","        saved_project_run = (\n","            project_run_metrics\n","            .set_index(\"Technique\")\n","            .sort_index()\n","        )\n","\n","        recalculated_project_run = (\n","            recalculated_project_run\n","            .set_index(\"Technique\")\n","            .sort_index()\n","        )\n","\n","\n","        if not saved_project_run.index.equals(\n","            recalculated_project_run.index\n","        ):\n","            project_run_aggregation_mismatches += 1\n","\n","            raise AssertionError(\n","                \"Project-run technique mismatch.\"\n","            )\n","\n","\n","        for metric_column in [\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","            \"SD_APFD\",\n","            \"SD_APFDc\",\n","        ]:\n","\n","            if not np.allclose(\n","                saved_project_run[\n","                    metric_column\n","                ].to_numpy(dtype=float),\n","                recalculated_project_run[\n","                    metric_column\n","                ].to_numpy(dtype=float),\n","                rtol=1e-12,\n","                atol=1e-12,\n","                equal_nan=True,\n","            ):\n","                project_run_aggregation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"Project-run metric mismatch: \"\n","                    f\"{metric_column}\"\n","                )\n","\n","\n","        for count_column in [\n","            \"EvaluatedBuilds\",\n","            \"TotalRankedTests\",\n","            \"TotalFailures\",\n","        ]:\n","\n","            if not np.array_equal(\n","                saved_project_run[\n","                    count_column\n","                ].to_numpy(dtype=int),\n","                recalculated_project_run[\n","                    count_column\n","                ].to_numpy(dtype=int),\n","            ):\n","                project_run_aggregation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"Project-run count mismatch: \"\n","                    f\"{count_column}\"\n","                )\n","\n","\n","        if not (\n","            project_run_metrics[\n","                \"EvaluatedBuilds\"\n","            ] == 15\n","        ).all():\n","            raise AssertionError(\n","                \"Project-run evaluated-build mismatch.\"\n","            )\n","\n","        if not (\n","            project_run_metrics[\n","                \"TotalRankedTests\"\n","            ] == 581\n","        ).all():\n","            raise AssertionError(\n","                \"Project-run ranked-test mismatch.\"\n","            )\n","\n","        if not (\n","            project_run_metrics[\n","                \"TotalFailures\"\n","            ] == 15\n","        ).all():\n","            raise AssertionError(\n","                \"Project-run failure-count mismatch.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6J. Baseline invariance\n","        # -------------------------------------------------\n","\n","        random_signature = (\n","            technique_signature(\n","                rankings,\n","                \"Random\",\n","            )\n","        )\n","\n","        qtf_signature = (\n","            technique_signature(\n","                rankings,\n","                \"QTF-Avg\",\n","            )\n","        )\n","\n","\n","        if random_reference_signature is None:\n","            random_reference_signature = (\n","                random_signature\n","            )\n","\n","            random_seed_signatures[\n","                int(repetition_seed)\n","            ] = random_signature\n","\n","        if qtf_seed_reference_signature is None:\n","            qtf_seed_reference_signature = (\n","                qtf_signature\n","            )\n","\n","\n","        random_matches_seed_zero = bool(\n","            random_signature\n","            == random_reference_signature\n","        )\n","\n","        qtf_matches_seed_zero = bool(\n","            qtf_signature\n","            == qtf_seed_reference_signature\n","        )\n","\n","\n","        if global_qtf_signature is None:\n","            global_qtf_signature = (\n","                qtf_signature\n","            )\n","\n","        qtf_matches_all_conditions = bool(\n","            qtf_signature\n","            == global_qtf_signature\n","        )\n","\n","\n","        baseline_invariance_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","            \"NoisePercent\":\n","                int(noise_percent),\n","            \"RandomMatchesZeroPercentWithinSeed\":\n","                random_matches_seed_zero,\n","            \"QTFAvgMatchesZeroPercentWithinSeed\":\n","                qtf_matches_seed_zero,\n","            \"QTFAvgMatchesAllConditions\":\n","                qtf_matches_all_conditions,\n","        })\n","\n","\n","        if not random_matches_seed_zero:\n","            raise AssertionError(\n","                \"Random changed across noise levels \"\n","                \"within the same seed.\"\n","            )\n","\n","        if not qtf_matches_seed_zero:\n","            raise AssertionError(\n","                \"QTF-Avg changed across noise levels.\"\n","            )\n","\n","        if not qtf_matches_all_conditions:\n","            raise AssertionError(\n","                \"QTF-Avg changed across seeds.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6K. Store 0% signatures\n","        # -------------------------------------------------\n","\n","        if int(noise_percent) == 0:\n","\n","            if number_flipped != 0:\n","                raise AssertionError(\n","                    \"0% noise flipped verdicts.\"\n","                )\n","\n","            for technique in (\n","                EXPECTED_TECHNIQUE_NAMES\n","            ):\n","\n","                zero_noise_signatures[\n","                    technique\n","                ].append(\n","                    technique_signature(\n","                        rankings,\n","                        technique,\n","                    )\n","                )\n","\n","\n","        # -------------------------------------------------\n","        # 6L. Collect final aggregated data\n","        # -------------------------------------------------\n","\n","        condition_audit_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","            \"NoisePercent\":\n","                int(noise_percent),\n","            \"ManifestRows\":\n","                int(len(manifest)),\n","            \"RankingRows\":\n","                int(len(rankings)),\n","            \"BuildMetricRows\":\n","                int(len(build_metrics)),\n","            \"ProjectRunRows\":\n","                int(len(project_run_metrics)),\n","            \"FitTimeRows\":\n","                int(len(fit_times)),\n","            \"EvaluatedBuilds\":\n","                int(\n","                    build_metrics[\n","                        \"Build\"\n","                    ].nunique()\n","                ),\n","            \"TechniqueCount\":\n","                int(\n","                    rankings[\n","                        \"Technique\"\n","                    ].nunique()\n","                ),\n","            \"NumberFlipped\":\n","                int(number_flipped),\n","            \"RealisedNoisePercent\":\n","                float(realised_noise),\n","            \"EvaluationUnchanged\":\n","                True,\n","            \"MetricsRecalculated\":\n","                True,\n","            \"TieRuleValidated\":\n","                True,\n","            \"ConditionComplete\":\n","                True,\n","            \"ConditionDirectory\":\n","                str(condition_directory),\n","        })\n","\n","\n","        project_run_frames.append(\n","            project_run_metrics\n","        )\n","\n","        build_metric_frames.append(\n","            build_metrics\n","        )\n","\n","        ranking_frames.append(\n","            rankings\n","        )\n","\n","        noise_summary_frames.append(\n","            noise_summary\n","        )\n","\n","        fit_time_frames.append(\n","            fit_times\n","        )\n","\n","\n","        processed_conditions += 1\n","\n","        if (\n","            processed_conditions % 30\n","            == 0\n","        ):\n","            print(\n","                \"Audited conditions:\",\n","                processed_conditions,\n","                \"/\",\n","                EXPECTED_CONDITIONS,\n","            )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Create audit dataframes\n","# ---------------------------------------------------------\n","\n","condition_audit = pd.DataFrame(\n","    condition_audit_records\n",")\n","\n","uniform_stream_audit = pd.DataFrame(\n","    uniform_audit_records\n",")\n","\n","nested_mask_audit = pd.DataFrame(\n","    nested_mask_records\n",")\n","\n","baseline_invariance_audit = pd.DataFrame(\n","    baseline_invariance_records\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Global audit assertions\n","# ---------------------------------------------------------\n","\n","if len(condition_audit) != (\n","    EXPECTED_CONDITIONS\n","):\n","    raise AssertionError(\n","        \"Condition audit count is not 270.\"\n","    )\n","\n","if len(uniform_stream_audit) != (\n","    EXPECTED_CONDITIONS\n","):\n","    raise AssertionError(\n","        \"Uniform audit count is not 270.\"\n","    )\n","\n","if len(nested_mask_audit) != (\n","    EXPECTED_NESTED_COMPARISONS\n","):\n","    raise AssertionError(\n","        \"Nested comparison count is not 240.\"\n","    )\n","\n","if not nested_mask_audit[\n","    \"LowerMaskSubsetOfUpper\"\n","].all():\n","    raise AssertionError(\n","        \"At least one nested-mask violation exists.\"\n","    )\n","\n","if not uniform_stream_audit[\n","    [\n","        \"SameIdentityAsZeroPercent\",\n","        \"SameUniformStreamAsZeroPercent\",\n","        \"MaskMatchesThreshold\",\n","    ]\n","].all().all():\n","    raise AssertionError(\n","        \"Uniform-stream audit failed.\"\n","    )\n","\n","if not baseline_invariance_audit[\n","    [\n","        \"RandomMatchesZeroPercentWithinSeed\",\n","        \"QTFAvgMatchesZeroPercentWithinSeed\",\n","        \"QTFAvgMatchesAllConditions\",\n","    ]\n","].all().all():\n","    raise AssertionError(\n","        \"Baseline invariance audit failed.\"\n","    )\n","\n","\n","# Every condition must use the same underlying\n","# clean training-row identity.\n","if len(global_identity_signatures) != 1:\n","    raise AssertionError(\n","        \"Training-row identities differ between \"\n","        \"conditions.\"\n","    )\n","\n","\n","# Every repetition should have a distinct random stream.\n","if len(\n","    set(\n","        uniform_seed_signatures.values()\n","    )\n",") != EXPECTED_SEEDS:\n","    raise AssertionError(\n","        \"The 30 repetition seeds did not produce \"\n","        \"30 distinct uniform streams.\"\n","    )\n","\n","\n","# Random must be constant across noise inside one seed,\n","# but distinct between the 30 seeds.\n","if len(\n","    set(\n","        random_seed_signatures.values()\n","    )\n",") != EXPECTED_SEEDS:\n","    raise AssertionError(\n","        \"Random did not produce 30 distinct \"\n","        \"seed-level ranking signatures.\"\n","    )\n","\n","\n","# LatestFail and QTF-Avg have no randomness at 0% noise.\n","for invariant_technique in [\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","]:\n","\n","    if len(\n","        set(\n","            zero_noise_signatures[\n","                invariant_technique\n","            ]\n","        )\n","    ) != 1:\n","        raise AssertionError(\n","            f\"{invariant_technique} changed across \"\n","            \"0% repetitions.\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Combine all raw result tables\n","# ---------------------------------------------------------\n","\n","combined_project_run_metrics = (\n","    pd.concat(\n","        project_run_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_build_metrics = (\n","    pd.concat(\n","        build_metric_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","            \"BuildOrder\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_rankings = (\n","    pd.concat(\n","        ranking_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","            \"build_order\",\n","            \"Rank\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_noise_summary = (\n","    pd.concat(\n","        noise_summary_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercentRequested\",\n","            \"RepetitionSeed\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_fit_times = (\n","    pd.concat(\n","        fit_time_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 10. Combined-table assertions\n","# ---------------------------------------------------------\n","\n","if len(\n","    combined_project_run_metrics\n",") != EXPECTED_PROJECT_RUN_ROWS:\n","    raise AssertionError(\n","        \"Combined project-run row count mismatch.\"\n","    )\n","\n","if len(\n","    combined_build_metrics\n",") != EXPECTED_BUILD_METRIC_ROWS:\n","    raise AssertionError(\n","        \"Combined build-metric row count mismatch.\"\n","    )\n","\n","if len(\n","    combined_rankings\n",") != EXPECTED_RANKING_ROWS:\n","    raise AssertionError(\n","        \"Combined ranking row count mismatch.\"\n","    )\n","\n","if len(\n","    combined_noise_summary\n",") != EXPECTED_CONDITIONS:\n","    raise AssertionError(\n","        \"Combined noise-summary count mismatch.\"\n","    )\n","\n","if len(\n","    combined_fit_times\n",") != EXPECTED_FIT_TIME_ROWS:\n","    raise AssertionError(\n","        \"Combined fit-time row count mismatch.\"\n","    )\n","\n","\n","if combined_project_run_metrics.duplicated(\n","    [\n","        \"Project\",\n","        \"NoisePercent\",\n","        \"RepetitionSeed\",\n","        \"Technique\",\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Duplicate project-run rows found.\"\n","    )\n","\n","if combined_build_metrics.duplicated(\n","    [\n","        \"Project\",\n","        \"NoisePercent\",\n","        \"RepetitionSeed\",\n","        \"Technique\",\n","        \"Build\",\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Duplicate build-metric rows found.\"\n","    )\n","\n","if combined_rankings.duplicated(\n","    [\n","        \"Project\",\n","        \"NoisePercent\",\n","        \"RepetitionSeed\",\n","        \"Technique\",\n","        \"Build\",\n","        \"Test\",\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Duplicate final ranking rows found.\"\n","    )\n","\n","\n","if combined_project_run_metrics[\n","    \"RepetitionSeed\"\n","].nunique() != EXPECTED_SEEDS:\n","    raise AssertionError(\n","        \"Combined results do not contain 30 seeds.\"\n","    )\n","\n","if combined_project_run_metrics[\n","    \"NoisePercent\"\n","].nunique() != EXPECTED_NOISE_LEVELS:\n","    raise AssertionError(\n","        \"Combined results do not contain nine \"\n","        \"noise levels.\"\n","    )\n","\n","if combined_project_run_metrics[\n","    \"Technique\"\n","].nunique() != EXPECTED_TECHNIQUES:\n","    raise AssertionError(\n","        \"Combined results do not contain seven \"\n","        \"techniques.\"\n","    )\n","\n","\n","seeds_per_project_result = (\n","    combined_project_run_metrics\n","    .groupby(\n","        [\n","            \"NoisePercent\",\n","            \"Technique\",\n","        ]\n","    )[\n","        \"RepetitionSeed\"\n","    ]\n","    .nunique()\n",")\n","\n","if not (\n","    seeds_per_project_result\n","    == EXPECTED_SEEDS\n",").all():\n","    raise AssertionError(\n","        \"At least one noise/technique combination \"\n","        \"does not contain 30 seeds.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. Aggregate seeds within Snow Owl\n","# ---------------------------------------------------------\n","\n","project_noise_technique_summary = (\n","    combined_project_run_metrics\n","    .groupby(\n","        [\n","            \"Project\",\n","            \"NoisePercent\",\n","            \"Technique\",\n","        ],\n","        as_index=False,\n","    )\n","    .agg(\n","        Seeds=(\n","            \"RepetitionSeed\",\n","            \"nunique\",\n","        ),\n","\n","        MeanAPFD=(\n","            \"MeanAPFD\",\n","            \"mean\",\n","        ),\n","\n","        SD_APFD_AcrossSeeds=(\n","            \"MeanAPFD\",\n","            \"std\",\n","        ),\n","\n","        MedianAPFD=(\n","            \"MeanAPFD\",\n","            \"median\",\n","        ),\n","\n","        MinAPFD=(\n","            \"MeanAPFD\",\n","            \"min\",\n","        ),\n","\n","        MaxAPFD=(\n","            \"MeanAPFD\",\n","            \"max\",\n","        ),\n","\n","        MeanAPFDc=(\n","            \"MeanAPFDc\",\n","            \"mean\",\n","        ),\n","\n","        SD_APFDc_AcrossSeeds=(\n","            \"MeanAPFDc\",\n","            \"std\",\n","        ),\n","\n","        MedianAPFDc=(\n","            \"MeanAPFDc\",\n","            \"median\",\n","        ),\n","\n","        MinAPFDc=(\n","            \"MeanAPFDc\",\n","            \"min\",\n","        ),\n","\n","        Max