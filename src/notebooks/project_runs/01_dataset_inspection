n","\n","Audit files saved:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/eclipse__paho.mqtt.java/paho_preflight/paho_clean_rec_comparison_summary.csv\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/eclipse__paho.mqtt.java/paho_preflight/paho_clean_rec_reconstructed.parquet\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/eclipse__paho.mqtt.java/paho_preflight/paho_clean_rec_mismatch_examples.csv\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/eclipse__paho.mqtt.java/paho_preflight/paho_clean_rec_audit_report.json\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/eclipse__paho.mqtt.java/paho_preflight/paho_unmatched_mapping_resolution.json\n","\n","SUCCESS: all 19 Paho MQTT REC_* features exactly match the clean TCP-CI dataset.\n","The three unmatched builds are accepted with empty changed-entity sets.\n"]}],"source":["# =========================================================\n","# PROJECT 4: PAHO MQTT\n","# CLEAN RECONSTRUCTION AND AUDIT OF ALL 19 REC FEATURES\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","PROJECT_NAME = \"eclipse@paho.mqtt.java\"\n","PROJECT_SLUG = \"eclipse__paho.mqtt.java\"\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","PAHO_PREFLIGHT_DIRECTORY = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n","    / PROJECT_SLUG\n","    / \"paho_preflight\"\n",")\n","\n","PAHO_PREFLIGHT_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","print(\n","    \"=== PAHO MQTT CLEAN REC RECONSTRUCTION ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 1. Record the resolution of the unmatched mappings\n","# ---------------------------------------------------------\n","\n","unmatched_build_ids_for_resolution = sorted(\n","    unmatched_commit_rows[\n","        \"id\"\n","    ].astype(int).unique().tolist()\n",")\n","\n","\n","affected_model_ready_rows = int(\n","    dataset_with_order[\n","        dataset_with_order[\n","            \"Build\"\n","        ].isin(\n","            unmatched_build_ids_for_resolution\n","        )\n","    ].shape[0]\n",")\n","\n","\n","if affected_model_ready_rows != 0:\n","    raise AssertionError(\n","        \"An unmatched build unexpectedly appears in \"\n","        \"the model-ready dataset.\"\n","    )\n","\n","\n","nonempty_unmatched_entity_sets = [\n","    int(build_id)\n","    for build_id in unmatched_build_ids_for_resolution\n","    if len(\n","        changed_entities_by_build.get(\n","            int(build_id),\n","            set(),\n","        )\n","    ) != 0\n","]\n","\n","\n","if nonempty_unmatched_entity_sets:\n","    raise AssertionError(\n","        \"An unmatched build unexpectedly has mapped \"\n","        \"changed entities.\"\n","    )\n","\n","\n","mapping_resolution = {\n","    \"Project\":\n","        PROJECT_NAME,\n","\n","    \"UnmatchedBuildCommitPairs\":\n","        int(len(unmatched_commit_rows)),\n","\n","    \"AffectedBuilds\":\n","        int(\n","            len(\n","                unmatched_build_ids_for_resolution\n","            )\n","        ),\n","\n","    \"UnmatchedBuildIds\":\n","        unmatched_build_ids_for_resolution,\n","\n","    \"AffectedModelReadyRows\":\n","        affected_model_ready_rows,\n","\n","    \"Resolution\":\n","        (\n","            \"Preserve the raw execution builds and assign \"\n","            \"empty changed-entity sets. Do not invent or \"\n","            \"repair commit mappings without evidence.\"\n","        ),\n","\n","    \"DefinitiveValidation\":\n","        (\n","            \"All 19 clean REC features must reproduce \"\n","            \"dataset.csv at 0% noise.\"\n","        ),\n","\n","    \"StatusBeforeRECAudit\":\n","        \"PROVISIONALLY_ACCEPTED\",\n","}\n","\n","\n","MAPPING_RESOLUTION_PATH = (\n","    PAHO_PREFLIGHT_DIRECTORY\n","    / \"paho_unmatched_mapping_resolution.json\"\n",")\n","\n","with open(\n","    MAPPING_RESOLUTION_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as resolution_file:\n","\n","    json.dump(\n","        mapping_resolution,\n","        resolution_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Exact REC feature protocol\n","# ---------------------------------------------------------\n","\n","RECENT_WINDOW = 6\n","\n","REC_FEATURE_COLUMNS = [\n","    \"REC_Age\",\n","    \"REC_LastFailureAge\",\n","    \"REC_LastTransitionAge\",\n","    \"REC_RecentAvgExeTime\",\n","    \"REC_RecentMaxExeTime\",\n","    \"REC_RecentFailRate\",\n","    \"REC_RecentAssertRate\",\n","    \"REC_RecentExcRate\",\n","    \"REC_RecentTransitionRate\",\n","    \"REC_TotalAvgExeTime\",\n","    \"REC_TotalMaxExeTime\",\n","    \"REC_TotalFailRate\",\n","    \"REC_TotalAssertRate\",\n","    \"REC_TotalExcRate\",\n","    \"REC_TotalTransitionRate\",\n","    \"REC_LastVerdict\",\n","    \"REC_LastExeTime\",\n","    \"REC_MaxTestFileFailRate\",\n","    \"REC_MaxTestFileTransitionRate\",\n","]\n","\n","\n","missing_rec_columns = [\n","    column\n","    for column in REC_FEATURE_COLUMNS\n","    if column not in dataset.columns\n","]\n","\n","if missing_rec_columns:\n","    raise RuntimeError(\n","        \"dataset.csv is missing REC columns:\\n\"\n","        + \"\\n\".join(missing_rec_columns)\n","    )\n","\n","\n","unexpected_dataset_rec_columns = [\n","    column\n","    for column in dataset.columns\n","    if column.startswith(\"REC_\")\n","    and column not in REC_FEATURE_COLUMNS\n","]\n","\n","if unexpected_dataset_rec_columns:\n","    raise RuntimeError(\n","        \"Unexpected REC columns were found:\\n\"\n","        + \"\\n\".join(\n","            unexpected_dataset_rec_columns\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Prepare chronological raw execution history\n","# ---------------------------------------------------------\n","\n","build_order_map = (\n","    builds_checked\n","    .set_index(\"id\")[\n","        \"build_order\"\n","    ]\n","    .to_dict()\n",")\n","\n","\n","exe_for_rec = (\n","    exe.copy()\n",")\n","\n","\n","for integer_column in [\n","    \"build\",\n","    \"test\",\n","    \"verdict\",\n","]:\n","\n","    exe_for_rec[\n","        integer_column\n","    ] = pd.to_numeric(\n","        exe_for_rec[\n","            integer_column\n","        ],\n","        errors=\"raise\",\n","    ).astype(int)\n","\n","\n","exe_for_rec[\n","    \"duration\"\n","] = pd.to_numeric(\n","    exe_for_rec[\n","        \"duration\"\n","    ],\n","    errors=\"raise\",\n",").astype(float)\n","\n","\n","exe_for_rec[\n","    \"build_order\"\n","] = (\n","    exe_for_rec[\n","        \"build\"\n","    ].map(\n","        build_order_map\n","    )\n",")\n","\n","\n","if exe_for_rec[\n","    \"build_order\"\n","].isna().any():\n","\n","    raise ValueError(\n","        \"Some raw execution builds could not be \"\n","        \"mapped to chronological build order.\"\n","    )\n","\n","\n","execution_sort_columns = [\n","    \"build_order\",\n","]\n","\n","if \"job\" in exe_for_rec.columns:\n","    execution_sort_columns.append(\n","        \"job\"\n","    )\n","\n","execution_sort_columns.append(\n","    \"test\"\n",")\n","\n","\n","exe_for_rec = (\n","    exe_for_rec\n","    .sort_values(\n","        execution_sort_columns,\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","ordered_execution_builds = (\n","    exe_for_rec[\n","        [\n","            \"build\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .drop_duplicates()\n","    .sort_values(\n","        \"build_order\",\n","        kind=\"mergesort\",\n","    )[\n","        \"build\"\n","    ]\n","    .astype(int)\n","    .tolist()\n",")\n","\n","\n","global_build_position = {\n","    int(build_id): position\n","    for position, build_id\n","    in enumerate(\n","        ordered_execution_builds\n","    )\n","}\n","\n","\n","if len(\n","    global_build_position\n",") != len(\n","    builds_checked\n","):\n","    raise AssertionError(\n","        \"Not every project build appears in the raw \"\n","        \"execution history.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Prepare entity ↔ build histories\n","# ---------------------------------------------------------\n","\n","entity_build_pairs = (\n","    build_entity_map\n","    .dropna(\n","        subset=[\n","            \"EntityId\",\n","        ]\n","    )[\n","        [\n","            \"id\",\n","            \"EntityId\",\n","        ]\n","    ]\n","    .drop_duplicates()\n","    .copy()\n",")\n","\n","\n","entity_build_pairs[\n","    \"id\"\n","] = pd.to_numeric(\n","    entity_build_pairs[\n","        \"id\"\n","    ],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","entity_build_pairs[\n","    \"EntityId\"\n","] = pd.to_numeric(\n","    entity_build_pairs[\n","        \"EntityId\"\n","    ],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","# For each entity, store every build where it changed.\n","entity_changed_builds = (\n","    entity_build_pairs\n","    .groupby(\n","        \"EntityId\"\n","    )[\n","        \"id\"\n","    ]\n","    .apply(\n","        lambda values: set(\n","            int(value)\n","            for value in values\n","        )\n","    )\n","    .to_dict()\n",")\n","\n","\n","# Every build receives a set. The three unmatched builds\n","# intentionally receive empty sets.\n","clean_changed_entities_by_build = {\n","    int(build_id): set(\n","        int(entity_id)\n","        for entity_id in (\n","            changed_entities_by_build.get(\n","                int(build_id),\n","                set(),\n","            )\n","        )\n","    )\n","    for build_id in (\n","        builds_checked[\n","            \"id\"\n","        ]\n","    )\n","}\n","\n","\n","if len(\n","    clean_changed_entities_by_build\n",") != len(\n","    builds_checked\n","):\n","    raise AssertionError(\n","        \"The changed-entity dictionary does not \"\n","        \"contain every build.\"\n","    )\n","\n","\n","for build_id in (\n","    unmatched_build_ids_for_resolution\n","):\n","\n","    if clean_changed_entities_by_build[\n","        int(build_id)\n","    ] != set():\n","\n","        raise AssertionError(\n","            \"An unmatched build did not retain an \"\n","            \"empty changed-entity set.\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 5. REC calculation helpers\n","# ---------------------------------------------------------\n","\n","def calculate_rates(\n","    history,\n","):\n","    \"\"\"\n","    Calculate failure, assertion, exception and\n","    transition rates for non-empty history.\n","    \"\"\"\n","\n","    history_length = len(\n","        history\n","    )\n","\n","    if history_length == 0:\n","        raise ValueError(\n","            \"Rate calculation requires non-empty history.\"\n","        )\n","\n","    verdicts = (\n","        history[\n","            \"verdict\"\n","        ]\n","    )\n","\n","    fail_rate = (\n","        (verdicts != 0).sum()\n","        / history_length\n","    )\n","\n","    assertion_rate = (\n","        (verdicts == 2).sum()\n","        / history_length\n","    )\n","\n","    exception_rate = (\n","        (verdicts == 1).sum()\n","        / history_length\n","    )\n","\n","    transition_rate = (\n","        (\n","            history[\n","                \"transition\"\n","            ] == 1\n","        ).sum()\n","        / history_length\n","    )\n","\n","    return (\n","        float(fail_rate),\n","        float(assertion_rate),\n","        float(exception_rate),\n","        float(transition_rate),\n","    )\n","\n","\n","def calculate_max_test_file_rate(\n","    history,\n","    target_column,\n","    current_changed_entities,\n","):\n","    \"\"\"\n","    Reproduce TCP-CI's maximum test-file historical\n","    failure or transition rate.\n","    \"\"\"\n","\n","    target_builds = (\n","        history.loc[\n","            history[\n","                target_column\n","            ] \u003e 0,\n","            \"build\",\n","        ]\n","        .drop_duplicates()\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","\n","    # No earlier failure or transition.\n","    if len(target_builds) == 0:\n","        return -1.0\n","\n","\n","    target_build_set = set(\n","        target_builds\n","    )\n","\n","    maximum_frequency = 0\n","\n","\n","    for entity_id in (\n","        current_changed_entities\n","    ):\n","\n","        entity_builds = (\n","            entity_changed_builds.get(\n","                int(entity_id),\n","                set(),\n","            )\n","        )\n","\n","        overlap_count = len(\n","            entity_builds.intersection(\n","                target_build_set\n","            )\n","        )\n","\n","        maximum_frequency = max(\n","            maximum_frequency,\n","            overlap_count,\n","        )\n","\n","\n","    # Target history exists, but no current changed\n","    # entity overlaps any target build.\n","    if maximum_frequency == 0:\n","        return 0.0\n","\n","\n","    return float(\n","        maximum_frequency\n","        / len(target_builds)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Reconstruct all 19 REC features\n","# ---------------------------------------------------------\n","\n","def reconstruct_rec_features(\n","    execution_history,\n","    requested_rows,\n","    recent_window=RECENT_WINDOW,\n","):\n","    \"\"\"\n","    Reconstruct REC features using only executions\n","    preceding each requested Build-Test execution.\n","    \"\"\"\n","\n","    requested_pairs = set(\n","        zip(\n","            requested_rows[\n","                \"Build\"\n","            ].astype(int),\n","            requested_rows[\n","                \"Test\"\n","            ].astype(int),\n","        )\n","    )\n","\n","    reconstructed_records = []\n","\n","\n","    for test_id, test_history in (\n","        execution_history.groupby(\n","            \"test\",\n","            sort=False,\n","        )\n","    ):\n","\n","        test_sort_columns = [\n","            \"build_order\",\n","        ]\n","\n","        if \"job\" in test_history.columns:\n","            test_sort_columns.append(\n","                \"job\"\n","            )\n","\n","        test_history = (\n","            test_history\n","            .sort_values(\n","                test_sort_columns,\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","            .copy()\n","        )\n","\n","\n","        # Transition relative to the immediately\n","        # preceding execution of the same test.\n","        test_history[\n","            \"transition\"\n","        ] = (\n","            test_history[\n","                \"verdict\"\n","            ]\n","            .diff()\n","            .fillna(0)\n","            .ne(0)\n","            .astype(int)\n","        )\n","\n","\n","        first_test_build = int(\n","            test_history\n","            .iloc[0][\n","                \"build\"\n","            ]\n","        )\n","\n","\n","        for current_position in range(\n","            len(test_history)\n","        ):\n","\n","            current_row = (\n","                test_history.iloc[\n","                    current_position\n","                ]\n","            )\n","\n","            current_build = int(\n","                current_row[\n","                    \"build\"\n","                ]\n","            )\n","\n","            pair = (\n","                current_build,\n","                int(test_id),\n","            )\n","\n","\n","            if pair not in requested_pairs:\n","                continue\n","\n","\n","            history = (\n","                test_history\n","                .iloc[\n","                    :current_position\n","                ]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","\n","            record = {\n","                \"Build\":\n","                    current_build,\n","                \"Test\":\n","                    int(test_id),\n","            }\n","\n","\n","            # No prior execution history.\n","            if history.empty:\n","\n","                for column in (\n","                    REC_FEATURE_COLUMNS\n","                ):\n","                    record[column] = -1.0\n","\n","                record[\n","                    \"REC_Age\"\n","                ] = 0\n","\n","                reconstructed_records.append(\n","                    record\n","                )\n","\n","                continue\n","\n","\n","            recent_history = (\n","                history\n","                .tail(\n","                    recent_window\n","                )\n","                .copy()\n","            )\n","\n","\n","            current_global_position = (\n","                global_build_position[\n","                    current_build\n","                ]\n","            )\n","\n","            first_global_position = (\n","                global_build_position[\n","                    first_test_build\n","                ]\n","            )\n","\n","            age = (\n","                current_global_position\n","                - first_global_position\n","            )\n","\n","\n","            failure_positions = (\n","                np.flatnonzero(\n","                    history[\n","                        \"verdict\"\n","                    ].to_numpy() \u003e 0\n","                )\n","            )\n","\n","            if len(\n","                failure_positions\n","            ) == 0:\n","\n","                last_failure_age = -1\n","\n","            else:\n","\n","                last_failure_age = (\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        failure_positions[\n","                            -1\n","                        ]\n","                    )\n","                )\n","\n","\n","            transition_positions = (\n","                np.flatnonzero(\n","                    history[\n","                        \"transition\"\n","                    ].to_numpy() \u003e 0\n","                )\n","            )\n","\n","            if len(\n","                transition_positions\n","            ) == 0:\n","\n","                last_transition_age = -1\n","\n","            else:\n","\n","                last_transition_age = (\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        transition_positions[\n","                            -1\n","                        ]\n","                    )\n","                )\n","\n","\n","            (\n","                recent_fail_rate,\n","                recent_assert_rate,\n","                recent_exc_rate,\n","                recent_transition_rate,\n","            ) = calculate_rates(\n","                recent_history\n","            )\n","\n","\n","            (\n","                total_fail_rate,\n","                total_assert_rate,\n","                total_exc_rate,\n","                total_transition_rate,\n","            ) = calculate_rates(\n","                history\n","            )\n","\n","\n","            current_changed_entities = (\n","                clean_changed_entities_by_build.get(\n","                    current_build,\n","                    set(),\n","                )\n","            )\n","\n","\n","            max_test_file_fail_rate = (\n","                calculate_max_test_file_rate(\n","                    history=history,\n","                    target_column=\"verdict\",\n","                    current_changed_entities=(\n","                        current_changed_entities\n","                    ),\n","                )\n","            )\n","\n","\n","            max_test_file_transition_rate = (\n","                calculate_max_test_file_rate(\n","                    history=history,\n","                    target_column=\"transition\",\n","                    current_changed_entities=(\n","                        current_changed_entities\n","                    ),\n","                )\n","            )\n","\n","\n","            record.update({\n","                \"REC_Age\":\n","                    age,\n","\n","                \"REC_LastFailureAge\":\n","                    last_failure_age,\n","\n","                \"REC_LastTransitionAge\":\n","                    last_transition_age,\n","\n","                \"REC_RecentAvgExeTime\":\n","                    float(\n","                        recent_history[\n","                            \"duration\"\n","                        ].mean()\n","                    ),\n","\n","                \"REC_RecentMaxExeTime\":\n","                    float(\n","                        recent_history[\n","                            \"duration\"\n","                        ].max()\n","                    ),\n","\n","                \"REC_RecentFailRate\":\n","                    recent_fail_rate,\n","\n","                \"REC_RecentAssertRate\":\n","                    recent_assert_rate,\n","\n","                \"REC_RecentExcRate\":\n","                    recent_exc_rate,\n","\n","                \"REC_RecentTransitionRate\":\n","                    recent_transition_rate,\n","\n","                \"REC_TotalAvgExeTime\":\n","                    float(\n","                        history[\n","                            \"duration\"\n","                        ].mean()\n","                    ),\n","\n","                \"REC_TotalMaxExeTime\":\n","                    float(\n","                        history[\n","                            \"duration\"\n","                        ].max()\n","                    ),\n","\n","                \"REC_TotalFailRate\":\n","                    total_fail_rate,\n","\n","                \"REC_TotalAssertRate\":\n","                    total_assert_rate,\n","\n","                \"REC_TotalExcRate\":\n","                    total_exc_rate,\n","\n","                \"REC_TotalTransitionRate\":\n","                    total_transition_rate,\n","\n","                \"REC_LastVerdict\":\n","                    int(\n","                        recent_history\n","                        .iloc[-1][\n","                            \"verdict\"\n","                        ]\n","                    ),\n","\n","                \"REC_LastExeTime\":\n","                    float(\n","                        recent_history\n","                        .iloc[-1][\n","                            \"duration\"\n","                        ]\n","                    ),\n","\n","                \"REC_MaxTestFileFailRate\":\n","                    max_test_file_fail_rate,\n","\n","                \"REC_MaxTestFileTransitionRate\":\n","                    max_test_file_transition_rate,\n","            })\n","\n","\n","            reconstructed_records.append(\n","                record\n","            )\n","\n","\n","    return pd.DataFrame(\n","        reconstructed_records\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Run clean reconstruction for all dataset rows\n","# ---------------------------------------------------------\n","\n","requested_dataset_rows = (\n","    dataset[\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","rec_clean_reconstructed = (\n","    reconstruct_rec_features(\n","        execution_history=(\n","            exe_for_rec\n","        ),\n","        requested_rows=(\n","            requested_dataset_rows\n","        ),\n","        recent_window=(\n","            RECENT_WINDOW\n","        ),\n","    )\n",")\n","\n","\n","duplicate_reconstructed_pairs = int(\n","    rec_clean_reconstructed\n","    .duplicated(\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    )\n","    .sum()\n",")\n","\n","\n","print(\n","    \"\\nExpected dataset rows:\",\n","    len(dataset),\n",")\n","\n","print(\n","    \"Reconstructed rows:\",\n","    len(rec_clean_reconstructed),\n",")\n","\n","print(\n","    \"Duplicate reconstructed Build-Test pairs:\",\n","    duplicate_reconstructed_pairs,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Compare with clean dataset.csv\n","# ---------------------------------------------------------\n","\n","comparison = (\n","    dataset[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            *REC_FEATURE_COLUMNS,\n","        ]\n","    ]\n","    .merge(\n","        rec_clean_reconstructed,\n","        on=[\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","        suffixes=(\n","            \"_original\",\n","            \"_reconstructed\",\n","        ),\n","        indicator=True,\n","    )\n",")\n","\n","\n","print(\n","    \"\\nMerge status:\"\n",")\n","\n","print(\n","    comparison[\n","        \"_merge\"\n","    ].value_counts()\n",")\n","\n","\n","all_requested_rows_merged = bool(\n","    comparison[\n","        \"_merge\"\n","    ].eq(\n","        \"both\"\n","    ).all()\n",")\n","\n","\n","comparison_results = []\n","mismatch_examples = []\n","\n","\n","for column in (\n","    REC_FEATURE_COLUMNS\n","):\n","\n","    original_column = (\n","        f\"{column}_original\"\n","    )\n","\n","    reconstructed_column = (\n","        f\"{column}_reconstructed\"\n","    )\n","\n","\n","    original_values = pd.to_numeric(\n","        comparison[\n","            original_column\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(\n","        dtype=float\n","    )\n","\n","    reconstructed_values = pd.to_numeric(\n","        comparison[\n","            reconstructed_column\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(\n","        dtype=float\n","    )\n","\n","\n","    matches = np.isclose(\n","        original_values,\n","        reconstructed_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","\n","    absolute_difference = np.abs(\n","        original_values\n","        - reconstructed_values\n","    )\n","\n","\n","    finite_differences = (\n","        absolute_difference[\n","            np.isfinite(\n","                absolute_difference\n","            )\n","        ]\n","    )\n","\n","\n","    maximum_absolute_difference = (\n","        float(\n","            finite_differences.max()\n","        )\n","        if len(\n","            finite_differences\n","        ) \u003e 0\n","        else np.nan\n","    )\n","\n","\n","    comparison_results.append({\n","        \"Feature\":\n","            column,\n","\n","        \"MatchingRows\":\n","            int(\n","                matches.sum()\n","            ),\n","\n","        \"MismatchingRows\":\n","            int(\n","                (\n","                    ~matches\n","                ).sum()\n","            ),\n","\n","        \"MaximumAbsoluteDifference\":\n","            maximum_absolute_difference,\n","    })\n","\n","\n","    differing_positions = np.flatnonzero(\n","        ~matches\n","    )[:10]\n","\n","\n","    for position in (\n","        differing_positions\n","    ):\n","\n","        mismatch_examples.append({\n","            \"Feature\":\n","                column,\n"