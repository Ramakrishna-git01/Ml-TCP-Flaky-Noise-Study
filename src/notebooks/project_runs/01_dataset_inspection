    -3.058412  \n","2       20.918947  \n","3       37.658055  \n","4        0.000000  \n","5        0.000000  \n","6       47.881995  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","SUCCESS: Angel 5% and 10% seed 1 passed the nested-mask audit.\n"]}],"source":["# =========================================================\n","# ANGEL — AUDIT 5% VS 10%, SEED 1\n","# =========================================================\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. LOAD THE TWO SAVED NOISE MANIFESTS\n","# ---------------------------------------------------------\n","\n","manifest_5 = pd.read_parquet(\n","    angel_5_seed1[\"condition_directory\"]\n","    / \"noise_manifest.parquet\"\n",")\n","\n","manifest_10 = pd.read_parquet(\n","    angel_10_seed1[\"condition_directory\"]\n","    / \"noise_manifest.parquet\"\n",")\n","\n","manifest_5 = (\n","    manifest_5\n","    .sort_values(\"NoiseRowID\")\n","    .reset_index(drop=True)\n",")\n","\n","manifest_10 = (\n","    manifest_10\n","    .sort_values(\"NoiseRowID\")\n","    .reset_index(drop=True)\n",")\n","\n","\n","assert len(manifest_5) == 7691\n","assert len(manifest_10) == 7691\n","\n","assert np.array_equal(\n","    manifest_5[\"NoiseRowID\"].to_numpy(),\n","    manifest_10[\"NoiseRowID\"].to_numpy(),\n",")\n","\n","assert np.array_equal(\n","    manifest_5[\"Build\"].to_numpy(),\n","    manifest_10[\"Build\"].to_numpy(),\n",")\n","\n","assert np.array_equal(\n","    manifest_5[\"Test\"].to_numpy(),\n","    manifest_10[\"Test\"].to_numpy(),\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. VERIFY COMMON RANDOM NUMBERS / NESTED MASKS\n","# ---------------------------------------------------------\n","\n","same_uniform_stream = np.array_equal(\n","    manifest_5[\"FlipUniform\"].to_numpy(),\n","    manifest_10[\"FlipUniform\"].to_numpy(),\n",")\n","\n","nested_mask_violations = int(\n","    (\n","        manifest_5[\"Flipped\"]\n","        \u0026 ~manifest_10[\"Flipped\"]\n","    ).sum()\n",")\n","\n","assert same_uniform_stream\n","assert nested_mask_violations == 0\n","\n","\n","flips_5 = int(\n","    manifest_5[\"Flipped\"].sum()\n",")\n","\n","flips_10 = int(\n","    manifest_10[\"Flipped\"].sum()\n",")\n","\n","new_flips_between_5_and_10 = int(\n","    (\n","        manifest_10[\"Flipped\"]\n","        \u0026 ~manifest_5[\"Flipped\"]\n","    ).sum()\n",")\n","\n","assert flips_10 \u003e= flips_5\n","\n","assert (\n","    flips_10\n","    == flips_5\n","    + new_flips_between_5_and_10\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. VERIFY TRAINING-ONLY CORRUPTION\n","# ---------------------------------------------------------\n","\n","evaluation_builds_in_10_manifest = len(\n","    set(\n","        manifest_10[\"Build\"].astype(int)\n","    ).intersection(\n","        evaluation_build_ids\n","    )\n",")\n","\n","assert evaluation_builds_in_10_manifest == 0\n","\n","\n","# ---------------------------------------------------------\n","# 4. BUILD 0%, 5%, 10% COMPARISON TABLE\n","# ---------------------------------------------------------\n","\n","def select_condition_results(\n","    condition_result,\n","    noise_label,\n","):\n","    return (\n","        condition_result[\n","            \"project_run_metrics\"\n","        ][\n","            [\n","                \"Technique\",\n","                \"MeanAPFD\",\n","                \"MeanAPFDc\",\n","            ]\n","        ]\n","        .rename(\n","            columns={\n","                \"MeanAPFD\":\n","                    f\"APFD_{noise_label}\",\n","                \"MeanAPFDc\":\n","                    f\"APFDc_{noise_label}\",\n","            }\n","        )\n","    )\n","\n","\n","results_0 = select_condition_results(\n","    angel_0_seed1,\n","    \"0\",\n",")\n","\n","results_5 = select_condition_results(\n","    angel_5_seed1,\n","    \"5\",\n",")\n","\n","results_10 = select_condition_results(\n","    angel_10_seed1,\n","    \"10\",\n",")\n","\n","\n","comparison_0_5_10 = (\n","    results_0\n","    .merge(\n","        results_5,\n","        on=\"Technique\",\n","        validate=\"one_to_one\",\n","    )\n","    .merge(\n","        results_10,\n","        on=\"Technique\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","\n","comparison_0_5_10[\n","    \"Change_0_to_10\"\n","] = (\n","    comparison_0_5_10[\"APFDc_10\"]\n","    - comparison_0_5_10[\"APFDc_0\"]\n",")\n","\n","comparison_0_5_10[\n","    \"Retention_10\"\n","] = (\n","    comparison_0_5_10[\"APFDc_10\"]\n","    / comparison_0_5_10[\"APFDc_0\"]\n",")\n","\n","comparison_0_5_10[\n","    \"LossPercent_10\"\n","] = (\n","    100.0\n","    * (\n","        comparison_0_5_10[\"APFDc_0\"]\n","        - comparison_0_5_10[\"APFDc_10\"]\n","    )\n","    / comparison_0_5_10[\"APFDc_0\"]\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. VERIFY NOISE-INDEPENDENT BASELINES\n","# ---------------------------------------------------------\n","\n","for technique in [\n","    \"Random\",\n","    \"QTF-Avg\",\n","]:\n","    row = comparison_0_5_10[\n","        comparison_0_5_10[\n","            \"Technique\"\n","        ] == technique\n","    ].iloc[0]\n","\n","    assert np.isclose(\n","        row[\"APFDc_0\"],\n","        row[\"APFDc_5\"],\n","        atol=1e-12,\n","        rtol=0,\n","    )\n","\n","    assert np.isclose(\n","        row[\"APFDc_0\"],\n","        row[\"APFDc_10\"],\n","        atol=1e-12,\n","        rtol=0,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. SAVE COMPARISON\n","# ---------------------------------------------------------\n","\n","comparison_output = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n","    / \"seed_01_noise_000_005_010.csv\"\n",")\n","\n","comparison_output.parent.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","comparison_0_5_10.to_csv(\n","    comparison_output,\n","    index=False,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 7. OUTPUT\n","# ---------------------------------------------------------\n","\n","print(\n","    \"=== ANGEL 5% VS 10% \"\n","    \"NESTED-MASK AUDIT ===\"\n",")\n","\n","print(\"\\nNoise masks:\")\n","print(\"5% flips:\", flips_5)\n","print(\"10% flips:\", flips_10)\n","\n","print(\n","    \"Additional flips from 5% to 10%:\",\n","    new_flips_between_5_and_10,\n",")\n","\n","print(\n","    \"Same uniform random stream:\",\n","    same_uniform_stream,\n",")\n","\n","print(\n","    \"Nested-mask violations:\",\n","    nested_mask_violations,\n",")\n","\n","print(\n","    \"Evaluation builds in 10% manifest:\",\n","    evaluation_builds_in_10_manifest,\n",")\n","\n","print(\"\\nSaved comparison:\")\n","print(comparison_output)\n","\n","\n","display(\n","    comparison_0_5_10[\n","        [\n","            \"Technique\",\n","            \"APFDc_0\",\n","            \"APFDc_5\",\n","            \"APFDc_10\",\n","            \"Change_0_to_10\",\n","            \"Retention_10\",\n","            \"LossPercent_10\",\n","        ]\n","    ]\n","    .sort_values(\n","        \"APFDc_10\",\n","        ascending=False,\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","print(\n","    \"\\nSUCCESS: Angel 5% and 10% \"\n","    \"seed 1 passed the nested-mask audit.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"elapsed":90711,"status":"ok","timestamp":1784814853808,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"9_WYAUtYP-4L","outputId":"b1c50b1b-ad9c-4712-f7a8-13dedfa468a6"},"outputs":[{"name":"stdout","output_type":"stream","text":["\