           \"build_order\"\n","                ].iloc[0]\n","            ):\n","\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"BuildOrder mismatch.\"\n","                )\n","\n","\n","            if not np.isclose(\n","                float(\n","                    saved_metric[\n","                        \"APFD\"\n","                    ]\n","                ),\n","                recalculated_apfd,\n","                rtol=1e-12,\n","                atol=1e-12,\n","            ):\n","\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"APFD recalculation mismatch.\"\n","                )\n","\n","\n","            if not np.isclose(\n","                float(\n","                    saved_metric[\n","                        \"APFDc\"\n","                    ]\n","                ),\n","                recalculated_apfdc,\n","                rtol=1e-12,\n","                atol=1e-12,\n","            ):\n","\n","                metric_recalculation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"APFDc recalculation mismatch.\"\n","                )\n","\n","\n","        if not build_metrics[\n","            \"APFD\"\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","            raise AssertionError(\n","                \"APFD outside [0, 1].\"\n","            )\n","\n","\n","        if not build_metrics[\n","            \"APFDc\"\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","            raise AssertionError(\n","                \"APFDc outside [0, 1].\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6I. Recalculate project-run summaries\n","        # -------------------------------------------------\n","\n","        recalculated_project_run = (\n","            build_metrics\n","            .groupby(\n","                [\n","                    \"Project\",\n","                    \"NoisePercent\",\n","                    \"RepetitionSeed\",\n","                    \"Technique\",\n","                ],\n","                as_index=False,\n","            )\n","            .agg(\n","                MeanAPFD=(\n","                    \"APFD\",\n","                    \"mean\",\n","                ),\n","\n","                MeanAPFDc=(\n","                    \"APFDc\",\n","                    \"mean\",\n","                ),\n","\n","                SD_APFD=(\n","                    \"APFD\",\n","                    \"std\",\n","                ),\n","\n","                SD_APFDc=(\n","                    \"APFDc\",\n","                    \"std\",\n","                ),\n","\n","                EvaluatedBuilds=(\n","                    \"Build\",\n","                    \"nunique\",\n","                ),\n","\n","                TotalRankedTests=(\n","                    \"NumberOfTests\",\n","                    \"sum\",\n","                ),\n","\n","                TotalFailures=(\n","                    \"NumberOfFailures\",\n","                    \"sum\",\n","                ),\n","            )\n","        )\n","\n","\n","        saved_project_run = (\n","            project_run_metrics\n","            .set_index(\n","                \"Technique\"\n","            )\n","            .sort_index()\n","        )\n","\n","\n","        recalculated_project_run = (\n","            recalculated_project_run\n","            .set_index(\n","                \"Technique\"\n","            )\n","            .sort_index()\n","        )\n","\n","\n","        if not saved_project_run.index.equals(\n","            recalculated_project_run.index\n","        ):\n","\n","            project_run_aggregation_mismatches += 1\n","\n","            raise AssertionError(\n","                \"Project-run technique mismatch.\"\n","            )\n","\n","\n","        for metric_column in [\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","            \"SD_APFD\",\n","            \"SD_APFDc\",\n","        ]:\n","\n","            if not np.allclose(\n","                saved_project_run[\n","                    metric_column\n","                ].to_numpy(\n","                    dtype=float\n","                ),\n","                recalculated_project_run[\n","                    metric_column\n","                ].to_numpy(\n","                    dtype=float\n","                ),\n","                rtol=1e-12,\n","                atol=1e-12,\n","                equal_nan=True,\n","            ):\n","\n","                project_run_aggregation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"Project-run metric mismatch: \"\n","                    f\"{metric_column}\"\n","                )\n","\n","\n","        for count_column in [\n","            \"EvaluatedBuilds\",\n","            \"TotalRankedTests\",\n","            \"TotalFailures\",\n","        ]:\n","\n","            if not np.array_equal(\n","                saved_project_run[\n","                    count_column\n","                ].to_numpy(\n","                    dtype=int\n","                ),\n","                recalculated_project_run[\n","                    count_column\n","                ].to_numpy(\n","                    dtype=int\n","                ),\n","            ):\n","\n","                project_run_aggregation_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"Project-run count mismatch: \"\n","                    f\"{count_column}\"\n","                )\n","\n","\n","        if not (\n","            project_run_metrics[\n","                \"EvaluatedBuilds\"\n","            ] == EXPECTED_EVALUATION_BUILDS\n","        ).all():\n","            raise AssertionError(\n","                \"Project-run evaluated-build mismatch.\"\n","            )\n","\n","\n","        if not (\n","            project_run_metrics[\n","                \"TotalRankedTests\"\n","            ] == EXPECTED_EVALUATION_ROWS\n","        ).all():\n","            raise AssertionError(\n","                \"Project-run ranked-test mismatch.\"\n","            )\n","\n","\n","        if not (\n","            project_run_metrics[\n","                \"TotalFailures\"\n","            ] == EXPECTED_EVALUATION_FAILURES\n","        ).all():\n","            raise AssertionError(\n","                \"Project-run failure-count mismatch.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6J. Baseline invariance\n","        # -------------------------------------------------\n","\n","        random_signature = (\n","            technique_signature(\n","                rankings,\n","                \"Random\",\n","            )\n","        )\n","\n","\n","        qtf_signature = (\n","            technique_signature(\n","                rankings,\n","                \"QTF-Avg\",\n","            )\n","        )\n","\n","\n","        if random_reference_signature is None:\n","\n","            random_reference_signature = (\n","                random_signature\n","            )\n","\n","            random_seed_signatures[\n","                int(\n","                    repetition_seed\n","                )\n","            ] = random_signature\n","\n","\n","        if qtf_seed_reference_signature is None:\n","\n","            qtf_seed_reference_signature = (\n","                qtf_signature\n","            )\n","\n","\n","        random_matches_zero = bool(\n","            random_signature\n","            == random_reference_signature\n","        )\n","\n","\n","        qtf_matches_seed_zero = bool(\n","            qtf_signature\n","            == qtf_seed_reference_signature\n","        )\n","\n","\n","        if global_qtf_signature is None:\n","\n","            global_qtf_signature = (\n","                qtf_signature\n","            )\n","\n","\n","        qtf_matches_all_conditions = bool(\n","            qtf_signature\n","            == global_qtf_signature\n","        )\n","\n","\n","        baseline_invariance_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"RepetitionSeed\":\n","                int(\n","                    repetition_seed\n","                ),\n","\n","            \"NoisePercent\":\n","                int(\n","                    noise_percent\n","                ),\n","\n","            \"RandomMatchesZeroPercentWithinSeed\":\n","                random_matches_zero,\n","\n","            \"QTFAvgMatchesZeroPercentWithinSeed\":\n","                qtf_matches_seed_zero,\n","\n","            \"QTFAvgMatchesAllConditions\":\n","                qtf_matches_all_conditions,\n","        })\n","\n","\n","        if not random_matches_zero:\n","            raise AssertionError(\n","                \"Random changed across noise levels \"\n","                \"within the same seed.\"\n","            )\n","\n","\n","        if not qtf_matches_seed_zero:\n","            raise AssertionError(\n","                \"QTF-Avg changed across noise levels.\"\n","            )\n","\n","\n","        if not qtf_matches_all_conditions:\n","            raise AssertionError(\n","                \"QTF-Avg changed across seeds.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6K. Store 0% ranking signatures\n","        # -------------------------------------------------\n","\n","        if int(\n","            noise_percent\n","        ) == 0:\n","\n","            if number_flipped != 0:\n","                raise AssertionError(\n","                    \"0% noise flipped verdicts.\"\n","                )\n","\n","\n",