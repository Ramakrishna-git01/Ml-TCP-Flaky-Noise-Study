nRows\":\n","        1890,\n","\n","    \"ModelFitRows\":\n","        1080,\n","\n","    \"NoiseSummaryRows\":\n","        270,\n","\n","    \"EvaluationBuilds\":\n","        10,\n","\n","    \"EvaluationRows\":\n","        363,\n","\n","    \"EvaluationFailures\":\n","        13,\n","}\n","\n","\n","# ---------------------------------------------------------\n","# 2. Permanent paths\n","# ---------------------------------------------------------\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","PROJECT_RAW_RESULTS = (\n","    RAW_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","FINAL_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_30_seed_final\"\n",")\n","\n","FULL_RUN_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_full_run\"\n",")\n","\n","FINAL_AUDIT_REPORT_PATH = (\n","    FINAL_DIRECTORY\n","    / \"titan_final_audit_report.json\"\n",")\n","\n","FINAL_AUDIT_TABLE_PATH = (\n","    FINAL_DIRECTORY\n","    / \"titan_final_audit_table.csv\"\n",")\n","\n","COUNT_AUDIT_PATH = (\n","    FINAL_DIRECTORY\n","    / \"titan_count_audit.csv\"\n",")\n","\n","COMPLETION_REGISTRY_PATH = (\n","    NOTES_DRIVE\n","    / \"completed_project_registry.csv\"\n",")\n","\n","SELECTION_CHECKPOINT_PATH = (\n","    NOTES_DRIVE\n","    / \"project_05_selection_checkpoint.json\"\n",")\n","\n","FULL_RUN_REPORT_PATH = (\n","    FULL_RUN_DIRECTORY\n","    / \"titan_full_run_execution_report.json\"\n",")\n","\n","FREEZE_RECORD_PATH = (\n","    FINAL_DIRECTORY\n","    / \"PROJECT_FROZEN.json\"\n",")\n","\n","CHECKSUM_MANIFEST_PATH = (\n","    FINAL_DIRECTORY\n","    / \"PROJECT_FROZEN_SHA256.csv\"\n",")\n","\n","DO_NOT_RERUN_PATH = (\n","    FINAL_DIRECTORY\n","    / \"DO_NOT_RERUN_PROJECT_05.md\"\n",")\n","\n","RAW_FREEZE_MARKER_PATH = (\n","    PROJECT_RAW_RESULTS\n","    / \"_PROJECT_FROZEN.json\"\n",")\n","\n","NOTES_FREEZE_RECORD_PATH = (\n","    NOTES_DRIVE\n","    / \"project_05_freeze_record.json\"\n",")\n","\n","\n","print(\n","    \"=== PROJECT 5 FINAL FREEZE SETUP ===\"\n",")\n","\n","print(\n","    \"Project:\",\n","    PROJECT_NAME,\n",")\n","\n","print(\n","    \"Final directory:\",\n","    FINAL_DIRECTORY,\n",")\n","\n","print(\n","    \"Raw results:\",\n","    PROJECT_RAW_RESULTS,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Required directories and audit files\n","# ---------------------------------------------------------\n","\n","required_directories = [\n","    THESIS_DRIVE,\n","    PROJECT_RAW_RESULTS,\n","    PROJECT_AGGREGATED_RESULTS,\n","    FINAL_DIRECTORY,\n","    FULL_RUN_DIRECTORY,\n","    NOTES_DRIVE,\n","]\n","\n","\n","missing_directories = [\n","    str(path)\n","    for path in required_directories\n","    if not path.exists()\n","]\n","\n","\n","if missing_directories:\n","    raise FileNotFoundError(\n","        \"Required Project 5 directories are missing:\\n\"\n","        + \"\\n\".join(missing_directories)\n","    )\n","\n","\n","required_audit_files = [\n","    FINAL_AUDIT_REPORT_PATH,\n","    FINAL_AUDIT_TABLE_PATH,\n","    COUNT_AUDIT_PATH,\n","]\n","\n","\n","missing_audit_files = [\n","    str(path)\n","    for path in required_audit_files\n","    if not path.exists()\n","]\n","\n","\n","if missing_audit_files:\n","    raise FileNotFoundError(\n","        \"Required Project 5 audit files are missing:\\n\"\n","        + \"\\n\".join(missing_audit_files)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Verify final audit JSON\n","# ---------------------------------------------------------\n","\n","with open(\n","    FINAL_AUDIT_REPORT_PATH,\n","    \"r\",\n","    encoding=\"utf-8\",\n",") as audit_file:\n","    final_audit_report = json.load(\n","        audit_file\n","    )\n","\n","\n","if final_audit_report.get(\n","    \"Project\"\n",") != PROJECT_NAME:\n","    raise AssertionError(\n","        \"Final audit report contains the wrong project.\"\n","    )\n","\n","\n","if final_audit_report.get(\n","    \"ProjectSlug\"\n",") != PROJECT_SLUG:\n","    raise AssertionError(\n","        \"Final audit report contains the wrong slug.\"\n","    )\n","\n","\n","if final_audit_report.get(\n","    \"Status\"\n",") != \"COMPLETE_AND_FROZEN\":\n","    raise AssertionError(\n","        \"Final audit report is not marked \"\n","        \"COMPLETE_AND_FROZEN.\"\n","    )\n","\n","\n","if int(\n","    final_audit_report.get(\n","        \"FinalAuditViolations\",\n","        -1,\n","    )\n",") != 0:\n","    raise AssertionError(\n","        \"Final audit report contains violations.\"\n","    )\n","\n","\n","audit_json_count_mapping = {\n","    \"Conditions\":\n","        \"Conditions\",\n","\n","    \"RankingRows\":\n","        \"RankingRows\",\n","\n","    \"BuildMetricRows\":\n","        \"BuildMetricRows\",\n","\n","    \"ProjectRunRows\":\n","        \"ProjectRunRows\",\n","\n","    \"ModelFitRows\":\n","        \"ModelFitRows\",\n","\n","    \"NoiseSummaryRows\":\n","        \"NoiseSummaryRows\",\n","\n","    \"EvaluationBuilds\":\n","        \"EvaluationBuilds\",\n","\n","    \"EvaluationRows\":\n","        \"EvaluationRows\",\n","\n","    \"EvaluationFailures\":\n","        \"EvaluationFailures\",\n","}\n","\n","\n","audit_json_count_records = []\n","\n","\n","for expected_name, json_name in (\n","    audit_json_count_mapping.items()\n","):\n","    expected_value = int(\n","        EXPECTED_COUNTS[\n","            expected_name\n","        ]\n","    )\n","\n","    observed_value = int(\n","        final_audit_report.get(\n","            json_name,\n","            -1,\n","        )\n","    )\n","\n","    audit_json_count_records.append({\n","        \"Measure\":\n","            expected_name,\n","\n","        \"Expected\":\n","            expected_value,\n","\n","        \"Observed\":\n","            observed_value,\n","\n","        \"Matches\":\n","            bool(\n","                expected_value\n","                == observed_value\n","            ),\n","    })\n","\n","\n","audit_json_count_validation = pd.DataFrame(\n","    audit_json_count_records\n",")\n","\n","\n","if not audit_json_count_validation[\n","    \"Matches\"\n","].all():\n","    display(\n","        audit_json_count_validation\n","    )\n","\n","    raise AssertionError(\n","        \"Final audit JSON counts do not match \"\n","        \"the frozen Project 5 protocol.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Verify final audit tables\n","# ---------------------------------------------------------\n","\n","final_audit_table = pd.read_csv(\n","    FINAL_AUDIT_TABLE_PATH\n",")\n","\n","count_audit = pd.read_csv(\n","    COUNT_AUDIT_PATH\n",")\n","\n","\n","required_final_audit_columns = [\n","    \"Audit\",\n","    \"Violations\",\n","    \"Passed\",\n","]\n","\n","\n","missing_final_audit_columns = [\n","    column\n","    for column in required_final_audit_columns\n","    if column not in final_audit_table.columns\n","]\n","\n","\n","if missing_final_audit_columns:\n","    raise KeyError(\n","        \"Final audit table is missing columns:\\n\"\n","        + \"\\n\".join(\n","            missing_final_audit_columns\n","        )\n","    )\n","\n","\n","final_audit_table[\n","    \"Violations\"\n","] = pd.to_numeric(\n","    final_audit_table[\n","        \"Violations\"\n","    ],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","passed_boolean = (\n","    final_audit_table[\n","        \"Passed\"\n","    ]\n","    .astype(str)\n","    .str.strip()\n","    .str.lower()\n","    .map({\n","        \"true\":\n","            True,\n","\n","        \"false\":\n","            False,\n","    })\n",")\n","\n","\n","if passed_boolean.isna().any():\n","    raise AssertionError(\n","        \"Final audit table contains an invalid \"\n","        \"Passed value.\"\n","    )\n","\n","\n","if (\n","    final_audit_table[\n","        \"Violations\"\n","    ] != 0\n",").any():\n","    raise AssertionError(\n","        \"Final audit table contains violations.\"\n","    )\n","\n","\n","if not passed_boolean.all():\n","    raise AssertionError(\n","        \"At least one final audit check did not pass.\"\n","    )\n","\n","\n","required_count_columns = [\n","    \"Output\",\n","    \"Expected\",\n","    \"Observed\",\n","    \"Matches\",\n","]\n","\n","\n","missing_count_columns = [\n","    column\n","    for column in required_count_columns\n","    if column not in count_audit.columns\n","]\n","\n","\n","if missing_count_columns:\n","    raise KeyError(\n","        \"Count audit is missing columns:\\n\"\n","        + \"\\n\".join(\n","            missing_count_columns\n","        )\n","    )\n","\n","\n","count_audit[\n","    \"Expected\"\n","] = pd.to_numeric(\n","    count_audit[\n","        \"Expected\"\n","    ],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","count_audit[\n","    \"Observed\"\n","] = pd.to_numeric(\n","    count_audit[\n","        \"Observed\"\n","    ],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","count_matches_boolean = (\n","    count_audit[\n","        \"Matches\"\n","    ]\n","    .astype(str)\n","    .str.strip()\n","    .str.lower()\n","    .map({\n","        \"true\":\n","            True,\n","\n","        \"false\":\n","            False,\n","    })\n",")\n","\n","\n","if count_matches_boolean.isna().any():\n","    raise AssertionError(\n","        \"Count audit contains an invalid Matches value.\"\n","    )\n","\n","\n","if not count_matches_boolean.all():\n","    raise AssertionError(\n","        \"At least one final output count does not match.\"\n","    )\n","\n","\n","if (\n","    count_audit[\n","        \"Expected\"\n","    ]\n","    != count_audit[\n","        \"Observed\"\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Final expected and observed counts differ.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Required final output files\n","# ---------------------------------------------------------\n","\n","REQUIRED_FINAL_OUTPUT_NAMES = [\n","    \"titan_all_rankings.parquet\",\n","    \"titan_all_build_metrics.parquet\",\n","    \"titan_all_project_run_metrics.parquet\",\n","    \"titan_all_project_run_metrics.csv\",\n","    \"titan_all_fit_times.parquet\",\n","    \"titan_all_fit_times.csv\",\n","    \"titan_all_noise_summaries.csv\",\n","    \"titan_condition_inventory.csv\",\n","    \"titan_count_audit.csv\",\n","    \"titan_final_audit_table.csv\",\n","    \"titan_recomputed_metric_audit.csv\",\n","    \"titan_project_run_recomputation_audit.csv\",\n","    \"titan_ranking_signatures.csv\",\n","    \"titan_random_noise_invariance_audit.csv\",\n","    \"titan_zero_percent_deterministic_audit.csv\",\n","    \"titan_noise_manifest_audit.csv\",\n","    \"titan_nested_mask_audit.csv\",\n","    \"titan_noise_level_summary.csv\",\n","    \"titan_seed_aggregated_summary.csv\",\n","    \"titan_paired_degradation_by_seed.csv\",\n","    \"titan_paired_degradation_summary.csv\",\n","    \"titan_model_fit_technique_counts.csv\",\n","    \"titan_success_marker_audit.csv\",\n","    \"titan_final_audit_report.json\",\n","]\n","\n","\n","required_final_paths = [\n","    FINAL_DIRECTORY\n","    / filename\n","    for filename in REQUIRED_FINAL_OUTPUT_NAMES\n","]\n","\n","\n","missing_final_outputs = [\n","    str(path)\n","    for path in required_final_paths\n","    if not path.exists()\n","]\n","\n","\n","if missing_final_outputs:\n","    raise FileNotFoundError(\n","        \"Final Project 5 outputs are missing:\\n\"\n","        + \"\\n\".join(\n","            missing_final_outputs\n","        )\n","    )\n","\n","\n","empty_final_outputs = [\n","    str(path)\n","    for path in required_final_paths\n","    if path.stat().st_size \u003c= 0\n","]\n","\n","\n","if empty_final_outputs:\n","    raise AssertionError(\n","        \"Final Project 5 outputs contain empty files:\\n\"\n","        + \"\\n\".join(\n","            empty_final_outputs\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Independently verify principal row counts\n","# ---------------------------------------------------------\n","\n","def parquet_row_count(\n","    path,\n","):\n","    return int(\n","        pq.ParquetFile(\n","            path\n","        ).metadata.num_rows\n","    )\n","\n","\n","principal_count_records = [\n","    {\n","        \"Output\":\n","            \"Ranking rows\",\n","\n","        \"Expected\":\n","            EXPECTED_COUNTS[\n","                \"RankingRows\"\n","            ],\n","\n","        \"Observed\":\n","            parquet_row_count(\n","                FINAL_DIRECTORY\n","                / \"titan_all_rankings.parquet\"\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Build-metric rows\",\n","\n","        \"Expected\":\n","            EXPECTED_COUNTS[\n","                \"BuildMetricRows\"\n","            ],\n","\n","        \"Observed\":\n","            parquet_row_count(\n","                FINAL_DIRECTORY\n","                / \"titan_all_build_metrics.parquet\"\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Project-run rows\",\n","\n","        \"Expected\":\n","            EXPECTED_COUNTS[\n","                \"ProjectRunRows\"\n","            ],\n","\n","        \"Observed\":\n","            parquet_row_count(\n","                FINAL_DIRECTORY\n","                / \"titan_all_project_run_metrics.parquet\"\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Model-fit rows\",\n","\n","        \"Expected\":\n","            EXPECTED_COUNTS[\n","                \"ModelFitRows\"\n","            ],\n","\n","        \"Observed\":\n","            parquet_row_count(\n","                FINAL_DIRECTORY\n","                / \"titan_all_fit_times.parquet\"\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Condition inventory rows\",\n","\n","        \"Expected\":\n","            EXPECTED_COUNTS[\n","                \"Conditions\"\n","            ],\n","\n","        \"Observed\":\n","            int(\n","                len(\n","                    pd.read_csv(\n","                        FINAL_DIRECTORY\n","                        / \"titan_condition_inventory.csv\"\n","                    )\n","                )\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Noise-summary rows\",\n","\n","        \"Expected\":\n","            EXPECTED_COUNTS[\n","                \"NoiseSummaryRows\"\n","            ],\n","\n","        \"Observed\":\n","            int(\n","                len(\n","                    pd.read_csv(\n","                        FINAL_DIRECTORY\n","                        / \"titan_all_noise_summaries.csv\"\n","                    )\n","                )\n","            ),\n","    },\n","]\n","\n","\n","principal_count_validation = pd.DataFrame(\n","    principal_count_records\n",")\n","\n","\n","principal_count_validation[\n","    \"Matches\"\n","] = (\n","    principal_count_validation[\n","        \"Expected\"\n","    ]\n","    == principal_count_validation[\n","        \"Observed\"\n","    ]\n",")\n","\n","\n","if not principal_count_validation[\n","    \"Matches\"\n","].all():\n","    display(\n","        principal_count_validation\n","    )\n","\n","    raise AssertionError(\n","        \"Independent final-file row-count \"\n","        \"validation failed.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Verify all 270 raw condition success markers\n","# ---------------------------------------------------------\n","\n","condition_marker_records = []\n","invalid_condition_markers = []\n","\n","\n","for seed in range(\n","    1,\n","    31,\n","):\n","    for noise in [\n","        0,\n","        5,\n","        10,\n","        15,\n","        20,\n","        25,\n","        30,\n","        40,\n","        50,\n","    ]:\n","        condition_directory = (\n","            PROJECT_RAW_RESULTS\n","            / f\"noise_{noise:03d}\"\n","            / f\"seed_{seed:02d}\"\n","        )\n","\n","        success_marker = (\n","            condition_directory\n","            / \"_SUCCESS.json\"\n","        )\n","\n","        if not success_marker.exists():\n","            invalid_condition_markers.append({\n","                \"NoisePercent\":\n","                    noise,\n","\n","                \"RepetitionSeed\":\n","                    seed,\n","\n","                \"Problem\":\n","                    \"MISSING_SUCCESS_MARKER\",\n","\n","                \"Path\":\n","                    str(\n","                        success_marker\n","                    ),\n","            })\n","\n","            continue\n","\n","        with open(\n","            success_marker,\n","            \"r\",\n","            encoding=\"utf-8\",\n","        ) as marker_file:\n","            marker = json.load(\n","                marker_file\n","            )\n","\n","        marker_valid = bool(\n","            marker.get(\n","                \"Project\"\n","            ) == PROJECT_NAME\n","            and float(\n","                marker.get(\n","                    \"NoisePercent\",\n","                    -1,\n","                )\n","            ) == float(noise)\n","            and int(\n","                marker.get(\n","                    \"RepetitionSeed\",\n","                    -1,\n","                )\n","            ) == int(seed)\n","            and bool(\n","                marker.get(\n","                    \"CompletedSuccessfully\",\n","                    False,\n","                )\n","            )\n","        )\n","\n","        if not marker_valid:\n","            invalid_condition_markers.append({\n","                \"NoisePercent\":\n","                    noise,\n","\n","                \"RepetitionSeed\":\n","                    seed,\n","\n","                \"Problem\":\n","                    \"INVALID_SUCCESS_MARKER\",\n","\n","                \"Path\":\n","                    str(\n","                        success_marker\n","                    ),\n","            })\n","\n","        condition_marker_records.append({\n","            \"NoisePercent\":\n","                int(noise),\n","\n","            \"RepetitionSeed\":\n","                int(seed),\n","\n","            \"Valid\":\n","                marker_valid,\n","\n","            \"SuccessMarker\":\n","                str(\n","                    success_marker\n","                ),\n","        })\n","\n","\n","condition_marker_audit = pd.DataFrame(\n","    condition_marker_records\n",")\n","\n","\n","if invalid_condition_markers:\n","    display(\n","        pd.DataFrame(\n","            invalid_condition_markers\n","        )\n","    )\n","\n","    raise AssertionError(\n","        \"At least one raw Project 5 condition is \"\n","        \"missing or invalid.\"\n","    )\n","\n","\n","if len(\n","    condition_marker_audit\n",") != 270:\n","    raise AssertionError(\n","        \"Expected exactly 270 raw condition markers.\\n\"\n","        f\"Observed: {len(condition_marker_audit)}\"\n","    )\n","\n","\n","if not condition_marker_audit[\n","    \"Valid\"\n","].all():\n","    raise AssertionError(\n","        \"At least one raw condition marker is invalid.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. SHA-256 helpers\n","# ---------------------------------------------------------\n","\n","def calculate_file_sha256(\n","    path,\n","    chunk_size=8 * 1024 * 1024,\n","):\n","    digest = hashlib.sha256()\n","\n","    with open(\n","        path,\n","        \"rb\",\n","    ) as binary_file:\n","        while True:\n","            chunk = binary_file.read(\n","                chunk_size\n","            )\n","\n","            if not chunk:\n","                break\n","\n","            digest.update(\n","                chunk\n","            )\n","\n","    return digest.hexdigest()\n","\n","\n","checksum_records = []\n","\n","\n","print(\n","    \"\\n=== CALCULATING FINAL OUTPUT CHECKSUMS ===\"\n",")\n","\n","\n","for file_number, path in enumerate(\n","    required_final_paths,\n","    start=1,\n","):\n","    checksum = calculate_file_sha256(\n","        path\n","    )\n","\n","    checksum_records.append({\n","        \"RelativePath\":\n","            str(\n","                path.relative_to(\n","                    FINAL_DIRECTORY\n","                )\n","            ),\n","\n","        \"SizeBytes\":\n","            int(\n","                path.stat().st_size\n","            ),\n","\n","        \"SHA256\":\n","            checksum,\n","    })\n","\n","    print(\n","        f\"Hashed {file_number:02d}/\"\n","        f\"{len(required_final_paths):02d}: \"\n","        f\"{path.name}\"\n","    )\n","\n","\n","checksum_manifest = (\n","    pd.DataFrame(\n","        checksum_records\n","    )\n","    .sort_values(\n","        \"RelativePath\",\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","if checksum_manifest[\n","    \"SHA256\"\n","].duplicated().all():\n","    raise AssertionError(\n","        \"Checksum calculation produced an \"\n","        \"unexpected result.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Detect post-freeze modification\n","# ---------------------------------------------------------\n","\n","existing_freeze_validated = False\n","existing_freeze_timestamp = None\n","\n","\n","if FREEZE_RECORD_PATH.exists():\n","    with open(\n","        FREEZE_RECORD_PATH,\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as freeze_file:\n","        existing_freeze_record = json.load(\n","            freeze_file\n","        )\n","\n","    if existing_freeze_record.get(\n","        \"Project\"\n","    ) != PROJECT_NAME:\n","        raise AssertionError(\n","            \"Existing freeze marker belongs to \"\n","            \"a different project.\"\n","        )\n","\n","    existing_manifest_records = (\n","        existing_freeze_record.get(\n","            \"FinalOutputChecksums\",\n","            [],\n","        )\n","    )\n","\n","    if not existing_manifest_records:\n","        raise AssertionError(\n","            \"Existing freeze record does not contain \"\n","            \"the original checksum manifest.\"\n","        )\n","\n","    existing_manifest = (\n","        pd.DataFrame(\n","            existing_manifest_records\n","        )\n","        .sort_values(\n","            \"RelativePath\",\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    comparison_columns = [\n","        \"RelativePath\",\n","        \"SizeBytes\",\n","        \"SHA256\",\n","    ]\n","\n","    if not existing_manifest[\n","        comparison_columns\n","    ].equals(\n","        checksum_manifest[\n","            comparison_columns\n","        ]\n","    ):\n","        checksum_difference = (\n","            existing_manifest[\n","                comparison_columns\n","            ]\n","            .merge(\n","                checksum_manifest[\n","                    comparison_columns\n","                ],\n","                on=\"RelativePath\",\n","                how=\"outer\",\n","                suffixes=(\n","                    \"_Frozen\",\n","                    \"_Current\",\n","                ),\n","                indicator=True,\n","            )\n","        )\n","\n","        checksum_difference[\n","            \"Changed\"\n","        ] = (\n","            (\n","                checksum_difference[\n","                    \"_merge\"\n","                ] != \"both\"\n","            )\n","            | (\n","                checksum_difference[\n","                    \"SizeBytes_Frozen\"\n","                ]\n","                != checksum_difference[\n","                    \"SizeBytes_Current\"\n","                ]\n","            )\n","            | (\n","                checksum_difference[\n","                    \"SHA256_Frozen\"\n","                ]\n","                != checksum_difference[\n","                    \"SHA256_Current\"\n","                ]\n","            )\n","        )\n","\n","        display(\n","            checksum_difference[\n","                checksum_difference[\n","                    \"Changed\"\n","                ]\n","            ]\n","        )\n","\n","        raise AssertionError(\n","            \"Project 5 was previously frozen, but one \"\n","            \"or more final outputs have changed.\"\n","        )\n","\n","    existing_freeze_validated = True\n","\n","    existing_freeze_timestamp = (\n","        existing_freeze_record.get(\n","            \"FrozenAtUTC\"\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. Atomic write helpers\n","# ---------------------------------------------------------\n","\n","def atomic_write_json(\n","    path,\n","    content,\n","):\n","    temporary_path = (\n","        path.parent\n","        / f\".{path.name}.tmp\"\n","    )\n","\n","    with open(\n","        temporary_path,\n","        \"w\",\n","        encoding=\"utf-8\",\n","    ) as output_file:\n","        json.dump(\n","            content,\n","            output_file,\n","            indent=2,\n","            default=str,\n