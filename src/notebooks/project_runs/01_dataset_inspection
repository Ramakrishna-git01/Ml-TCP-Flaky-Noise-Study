                           False  \n","29                            1                             False  \n","30                            1                             False  \n","31                            1                             False  \n","32                            1                             False  \n","33                            1                             False  \n","34                            1                             False  \n","35                            1                             False  \n","36                            1                             False  \n","37                            1                             False  \n","38                            1                             False  \n","39                            1                             False  \n","40                            1                             False  \n","41                            1                             False  \n","42                            1                             False  \n","43                            1                             False  \n","44                            1                             False  \n","45                            1                             False  \n","46                            1                             False  \n","47                            1                             False  \n","48                            1                             False  \n","49                            1                             False  "]},"metadata":{},"output_type":"display_data"},{"ename":"AssertionError","evalue":"The REC_TotalAvgExeTime discrepancy is not fully explained by durations from unmatched entity-history builds.","output_type":"error","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mAssertionError\u001b[0m                            Traceback (most recent call last)","\u001b[0;32m/tmp/ipykernel_4678/3691875362.py\u001b[0m in \u001b[0;36m\u003ccell line: 0\u003e\u001b[0;34m()\u001b[0m\n\u001b[1;32m   1660\u001b[0m     )\n\u001b[1;32m   1661\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-\u003e 1662\u001b[0;31m     raise AssertionError(\n\u001b[0m\u001b[1;32m   1663\u001b[0m         \u001b[0;34m\"The REC_TotalAvgExeTime discrepancy is not \"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1664\u001b[0m         \u001b[0;34m\"fully explained by durations from unmatched \"\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n","\u001b[0;31mAssertionError\u001b[0m: The REC_TotalAvgExeTime discrepancy is not fully explained by durations from unmatched entity-history builds."]}],"source":["# =========================================================\n","# PROJECT 5: THINKAURELIUS TITAN\n","# CANONICAL VERDICT-DEPENDENT REC VALIDATION\n","#\n","# Correct resolution:\n","#   - Reconstruct the 13 verdict-dependent REC features.\n","#   - Preserve the 6 noise-independent REC features from\n","#     dataset.csv.\n","#   - Document the isolated raw-duration discrepancy.\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Validate required runtime state\n","# ---------------------------------------------------------\n","\n","REQUIRED_VARIABLES = [\n","    \"PROJECT_NUMBER\",\n","    \"PROJECT_NAME\",\n","    \"PROJECT_SLUG\",\n","    \"PROJECT_AGGREGATED_RESULTS\",\n","    \"NOTES_DRIVE\",\n","    \"builds\",\n","    \"exe_for_rec\",\n","    \"dataset_with_order\",\n","    \"clean_training_data\",\n","    \"clean_evaluation_data\",\n","    \"build_entity_map\",\n","    \"changed_entities_by_build\",\n","]\n","\n","\n","missing_variables = [\n","    variable_name\n","    for variable_name in REQUIRED_VARIABLES\n","    if variable_name not in globals()\n","]\n","\n","\n","if missing_variables:\n","    raise RuntimeError(\n","        \"Required Titan variables are missing:\\n\"\n","        + \"\\n\".join(missing_variables)\n","    )\n","\n","\n","if PROJECT_NUMBER != 5:\n","    raise AssertionError(\n","        f\"Expected Project 5, found Project {PROJECT_NUMBER}.\"\n","    )\n","\n","\n","if PROJECT_NAME != \"thinkaurelius@titan\":\n","    raise AssertionError(\n","        \"This cell is only for thinkaurelius@titan.\"\n","    )\n","\n","\n","if len(dataset_with_order) != 2391:\n","    raise AssertionError(\n","        \"Unexpected Titan model-ready row count.\\n\"\n","        f\"Expected: 2391\\n\"\n","        f\"Observed: {len(dataset_with_order)}\"\n","    )\n","\n","\n","VALIDATION_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_preflight\"\n",")\n","\n","VALIDATION_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","print(\n","    \"=== TITAN CANONICAL VERDICT-DEPENDENT \"\n","    \"REC VALIDATION ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Freeze the REC feature classification\n","# ---------------------------------------------------------\n","\n","RECENT_WINDOW = 6\n","\n","\n","REC_FEATURE_COLUMNS = [\n","    \"REC_Age\",\n","    \"REC_LastFailureAge\",\n","    \"REC_LastTransitionAge\",\n","    \"REC_RecentAvgExeTime\",\n","    \"REC_RecentMaxExeTime\",\n","    \"REC_RecentFailRate\",\n","    \"REC_RecentAssertRate\",\n","    \"REC_RecentExcRate\",\n","    \"REC_RecentTransitionRate\",\n","    \"REC_TotalAvgExeTime\",\n","    \"REC_TotalMaxExeTime\",\n","    \"REC_TotalFailRate\",\n","    \"REC_TotalAssertRate\",\n","    \"REC_TotalExcRate\",\n","    \"REC_TotalTransitionRate\",\n","    \"REC_LastVerdict\",\n","    \"REC_LastExeTime\",\n","    \"REC_MaxTestFileFailRate\",\n","    \"REC_MaxTestFileTransitionRate\",\n","]\n","\n","\n","# These features