ld\"]\n","    .map(build_order_map)\n",")\n","\n","if exe_for_rec[\"build_order\"].isna().any():\n","    raise ValueError(\n","        \"Some exe.csv builds could not be mapped \"\n","        \"to a chronological build order.\"\n","    )\n","\n","exe_for_rec = (\n","    exe_for_rec\n","    .sort_values(\n","        [\"build_order\", \"job\", \"test\"]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# Global chronological list of builds appearing in exe.csv\n","ordered_execution_builds = (\n","    exe_for_rec[\n","        [\"build\", \"build_order\"]\n","    ]\n","    .drop_duplicates()\n","    .sort_values(\"build_order\")[\"build\"]\n","    .tolist()\n",")\n","\n","global_build_position = {\n","    int(build_id): position\n","    for position, build_id\n","    in enumerate(ordered_execution_builds)\n","}\n","\n","\n","# ---------------------------------------------------------\n","# PREPARE ENTITY ↔ BUILD HISTORY\n","# ---------------------------------------------------------\n","\n","entity_build_pairs = (\n","    build_entity_map\n","    .dropna(subset=[\"EntityId\"])\n","    [[\"id\", \"EntityId\"]]\n","    .drop_duplicates()\n","    .copy()\n",")\n","\n","entity_build_pairs[\"id\"] = (\n","    entity_build_pairs[\"id\"].astype(int)\n",")\n","\n","entity_build_pairs[\"EntityId\"] = (\n","    entity_build_pairs[\"EntityId\"].astype(int)\n",")\n","\n","\n","# For each source entity, store all CI builds where it changed\n","entity_changed_builds = (\n","    entity_build_pairs\n","    .groupby(\"EntityId\")[\"id\"]\n","    .apply(lambda values: set(values.tolist()))\n","    .to_dict()\n",")\n","\n","\n","# Ensure every build has a changed-entity set\n","clean_changed_entities_by_build = {\n","    int(build_id): set(\n","        int(entity_id)\n","        for entity_id in changed_entities_by_build.get(\n","            int(build_id),\n","            set()\n","        )\n","    )\n","    for build_id in builds_checked[\"id\"]\n","}\n","\n","\n","# ---------------------------------------------------------\n","# HELPER FUNCTIONS\n","# ---------------------------------------------------------\n","\n","def calculate_rates(history):\n","    \"\"\"\n","    Reproduce TCP-CI's failure, assertion, exception,\n","    and transition-rate calculations.\n","    \"\"\"\n","    history_length = len(history)\n","\n","    if history_length == 0:\n","        raise ValueError(\n","            \"Rate calculation requires non-empty history.\"\n","        )\n","\n","    verdicts = history[\"verdict\"]\n","\n","    fail_rate = (\n","        (verdicts != 0).sum()\n","        / history_length\n","    )\n","\n","    assertion_rate = (\n","        (verdicts == 2).sum()\n","        / history_length\n","    )\n","\n","    exception_rate = (\n","        (verdicts == 1).sum()\n","        / history_length\n","    )\n","\n","    transition_rate = (\n","        (history[\"transition\"] == 1).sum()\n","        / history_length\n","    )\n","\n","    return (\n","        float(fail_rate),\n","        float(assertion_rate),\n","        float(exception_rate),\n","        float(transition_rate),\n","    )\n","\n","\n","def calculate_max_test_file_rate(\n","    history,\n","    target_column,\n","    current_changed_entities,\n","):\n","    \"\"\"\n","    Reproduce TCP-CI's compute_max_test_file_rate logic.\n","    \"\"\"\n","\n","    target_builds = (\n","        history.loc[\n","            history[target_column] \u003e 0,\n","            \"build\"\n","        ]\n","        .drop_duplicates()\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","    # Official default when there is no earlier\n","    # failure or transition.\n","    if len(target_builds) == 0:\n","        return -1.0\n","\n","    target_build_set = set(target_builds)\n","\n","    maximum_frequency = 0\n","\n","    for entity_id in current_changed_entities:\n","        entity_builds = entity_changed_builds.get(\n","            int(entity_id),\n","            set()\n","        )\n","\n","        overlap_count = len(\n","            entity_builds.intersection(\n","                target_build_set\n","            )\n","        )\n","\n","        maximum_frequency = max(\n","            maximum_frequency,\n","            overlap_count\n","        )\n","\n","    # When target history exists but no entity overlaps,\n","    # the official implementation returns 0.0.\n","    if maximum_frequency == 0:\n","        return 0.0\n","\n","    return (\n","        maximum_frequency\n","        / len(target_builds)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# RECONSTRUCTION FUNCTION\n","# ---------------------------------------------------------\n","\n","def reconstruct_rec_features(\n","    execution_history,\n","    requested_rows,\n","    recent_window=6,\n","):\n","    \"\"\"\n","    Reconstruct REC_* features for requested Build-Test rows\n","    using only executions before each current execution.\n","    \"\"\"\n","\n","    requested_pairs = set(\n","        zip(\n","            requested_rows[\"Build\"].astype(int),\n","            requested_rows[\"Test\"].astype(int),\n","        )\n","    )\n","\n","    reconstructed_records = []\n","\n","    for test_id, test_history in execution_history.groupby(\n","        \"test\",\n","        sort=False,\n","    ):\n","        test_history = (\n","            test_history\n","            .sort_values(\"build_order\")\n","            .reset_index(drop=True)\n","            .copy()\n","        )\n","\n","        # Transition of each execution relative to the\n","        # immediately preceding execution of this test.\n","        test_history[\"transition\"] = (\n","            test_history[\"verdict\"]\n","            .diff()\n","            .fillna(0)\n","            .ne(0)\n","            .astype(int)\n","        )\n","\n","        first_test_build = int(\n","            test_history.iloc[0][\"build\"]\n","        )\n","\n","        for current_position in range(\n","            len(test_history)\n","        ):\n","            current_row = (\n","                test_history.iloc[current_position]\n","            )\n","\n","            current_build = int(\n","                current_row[\"build\"]\n","            )\n","\n","            pair = (\n","                current_build,\n","                int(test_id),\n","            )\n","\n","            if pair not in requested_pairs:\n","                continue\n","\n","            history = (\n","                test_history\n","                .iloc[:current_position]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","            record = {\n","                \"Build\": current_build,\n","                \"Test\": int(test_id),\n","            }\n","\n","            # No earlier execution history\n","            if history.empty:\n","                for column in REC_FEATURE_COLUMNS:\n","                    record[column] = -1.0\n","\n","                record[\"REC_Age\"] = 0\n","\n","                reconstructed_records.append(record)\n","                continue\n","\n","            recent_history = (\n","                history\n","                .tail(recent_window)\n","                .copy()\n","            )\n","\n","            current_global_position = (\n","                global_build_position[current_build]\n","            )\n","\n","            first_global_position = (\n","                global_build_position[first_test_build]\n","            )\n","\n","            age = (\n","                current_global_position\n","                - first_global_position\n","            )\n","\n","\n","            # Last failure age\n","            failure_positions = np.flatnonzero(\n","                history[\"verdict\"].to_numpy() \u003e 0\n","            )\n","\n","            if len(failure_positions) == 0:\n","                last_failure_age = -1\n","            else:\n","                last_failure_age = (\n","                    len(history)\n","                    - 1\n","                    - int(failure_positions[-1])\n","                )\n","\n","\n","            # Last transition age\n","            transition_positions = np.flatnonzero(\n","                history[\n","                    \"transition\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","            if len(transition_positions) == 0:\n","                last_transition_age = -1\n","            else:\n","                last_transition_age = (\n","                    len(history)\n","                    - 1\n","                    - int(transition_positions[-1])\n","                )\n","\n","\n","            # Recent rates\n","            (\n","                recent_fail_rate,\n","                recent_assert_rate,\n","                recent_exc_rate,\n","                recent_transition_rate,\n","            ) = calculate_rates(recent_history)\n","\n","\n","            # Total rates\n","            (\n","                total_fail_rate,\n","                total_assert_rate,\n","                total_exc_rate,\n","                total_transition_rate,\n","            ) = calculate_rates(history)\n","\n","\n","            current_changed_entities = (\n","                clean_changed_entities_by_build.get(\n","                    current_build,\n","                    set()\n","                )\n","            )\n","\n","            max_test_file_fail_rate = (\n","                calculate_max_test_file_rate(\n","                    history=history,\n","                    target_column=\"verdict\",\n","                    current_changed_entities=(\n","                        current_changed_entities\n","                    ),\n","                )\n","            )\n","\n","            max_test_file_transition_rate = (\n","                calculate_max_test_file_rate(\n","                    history=history,\n","                    target_column=\"transition\",\n","                    current_changed_entities=(\n","                        current_changed_entities\n","                    ),\n","                )\n","            )\n","\n","\n","            record.update({\n","                \"REC_Age\": age,\n","                \"REC_LastFailureAge\":\n","                    last_failure_age,\n","                \"REC_LastTransitionAge\":\n","                    last_transition_age,\n","\n","                \"REC_RecentAvgExeTime\":\n","                    float(\n","                        recent_history[\n","                            \"duration\"\n","                        ].mean()\n","                    ),\n","                \"REC_RecentMaxExeTime\":\n","                    float(\n","                        recent_history[\n","                            \"duration\"\n","                        ].max()\n","                    ),\n","                \"REC_RecentFailRate\":\n","                    recent_fail_rate,\n","                \"REC_RecentAssertRate\":\n","                    recent_assert_rate,\n","                \"REC_RecentExcRate\":\n","                    recent_exc_rate,\n","                \"REC_RecentTransitionRate\":\n","                    recent_transition_rate,\n","\n","                \"REC_TotalAvgExeTime\":\n","                    float(\n","                        history[\n","                            \"duration\"\n","                        ].mean()\n","                    ),\n","                \"REC_TotalMaxExeTime\":\n","                    float(\n","                        history[\n","                            \"duration\"\n","                        ].max()\n","                    ),\n","                \"REC_TotalFailRate\":\n","                    total_fail_rate,\n","                \"REC_TotalAssertRate\":\n","                    total_assert_rate,\n","                \"REC_TotalExcRate\":\n","                    total_exc_rate,\n","                \"REC_TotalTransitionRate\":\n","                    total_transition_rate,\n","\n","                \"REC_LastVerdict\":\n","                    int(\n","                        recent_history\n","                        .iloc[-1][\"verdict\"]\n","                    ),\n","                \"REC_LastExeTime\":\n","                    float(\n","                        recent_history\n","                        .iloc[-1][\"duration\"]\n","                    ),\n","\n","                \"REC_MaxTestFileFailRate\":\n","                    max_test_file_fail_rate,\n","                \"REC_MaxTestFileTransitionRate\":\n","                    max_test_file_transition_rate,\n","            })\n","\n","            reconstructed_records.append(record)\n","\n","    reconstructed = pd.DataFrame(\n","        reconstructed_records\n","    )\n","\n","    return reconstructed\n","\n","\n","# ---------------------------------------------------------\n","# RUN CLEAN 0% RECONSTRUCTION\n","# ---------------------------------------------------------\n","\n","rec_clean_reconstructed = (\n","    reconstruct_rec_features(\n","        execution_history=exe_for_rec,\n","        requested_rows=dataset[\n","            [\"Build\", \"Test\"]\n","        ],\n","        recent_window=RECENT_WINDOW,\n","    )\n",")\n","\n","print(\"=== CLEAN REC RECONSTRUCTION ===\")\n","\n","print(\n","    \"Expected dataset rows:\",\n","    len(dataset)\n",")\n","\n","print(\n","    \"Reconstructed rows:\",\n","    len(rec_clean_reconstructed)\n",")\n","\n","print(\n","    \"Duplicate reconstructed Build-Test pairs:\",\n","    rec_clean_reconstructed\n","    .duplicated(\n","        subset=[\"Build\", \"Test\"]\n","    )\n","    .sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# COMPARE AGAINST ORIGINAL dataset.csv\n","# ---------------------------------------------------------\n","\n","comparison = (\n","    dataset[\n","        [\"Build\", \"Test\"]\n","        + REC_FEATURE_COLUMNS\n","    ]\n","    .merge(\n","        rec_clean_reconstructed,\n","        on=[\"Build\", \"Test\"],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","        suffixes=(\n","            \"_original\",\n","            \"_reconstructed\",\n","        ),\n","        indicator=True,\n","    )\n",")\n","\n","print(\"\\nMerge status:\")\n","print(comparison[\"_merge\"].value_counts())\n","\n","\n","comparison_results = []\n","\n","for column in REC_FEATURE_COLUMNS:\n","    original_column = (\n","        f\"{column}_original\"\n","    )\n","\n","    reconstructed_column = (\n","        f\"{column}_reconstructed\"\n","    )\n","\n","    original_values = (\n","        comparison[\n","            original_column\n","        ].astype(float)\n","    )\n","\n","    reconstructed_values = (\n","        comparison[\n","            reconstructed_column\n","        ].astype(float)\n","    )\n","\n","    matches = np.isclose(\n","        original_values,\n","        reconstructed_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","    absolute_difference = (\n","        original_values\n","        - reconstructed_values\n","    ).abs()\n","\n","    comparison_results.append({\n","        \"Feature\": column,\n","        \"MatchingRows\": int(matches.sum()),\n","        \"MismatchingRows\": int(\n","            (~matches).sum()\n","        ),\n","        \"MaximumAbsoluteDifference\": (\n","            float(\n","                absolute_difference.max()\n","            )\n","        ),\n","    })\n","\n","\n","comparison_summary = pd.DataFrame(\n","    comparison_results\n",")\n","\n","print(\"\\n=== FEATURE COMPARISON SUMMARY ===\")\n","display(comparison_summary)\n","\n","\n","total_mismatches = int(\n","    comparison_summary[\n","        \"MismatchingRows\"\n","    ].sum()\n",")\n","\n","print(\n","    \"\\nTotal mismatching feature values:\",\n","    total_mismatches\n",")\n","\n","\n","# ---------------------------------------------------------\n","# SHOW EXAMPLE MISMATCHES, IF ANY\n","# ---------------------------------------------------------\n","\n","if total_mismatches == 0:\n","    print(\n","        \"\\nSUCCESS: all 19 REC_* features match \"\n","        \"the original clean dataset.\"\n","    )\n","\n","else:\n","    mismatch_examples = []\n","\n","    for column in REC_FEATURE_COLUMNS:\n","        original_column = (\n","            f\"{column}_original\"\n","        )\n","\n","        reconstructed_column = (\n","            f\"{column}_reconstructed\"\n","        )\n","\n","        matches = np.isclose(\n","            comparison[\n","                original_column\n","            ].astype(float),\n","            comparison[\n","                reconstructed_column\n","            ].astype(float),\n","            rtol=1e-9,\n","            atol=1e-9,\n","            equal_nan=True,\n","        )\n","\n","        differing_rows = comparison.loc[\n","            ~matches,\n","            [\n","                \"Build\",\n","                \"Test\",\n","                original_column,\n","                reconstructed_column,\n","            ]\n","        ].head(5)\n","\n","        for _, differing_row in (\n","            differing_rows.iterrows()\n","        ):\n","            mismatch_examples.append({\n","                \"Feature\": column,\n","                \"Build\":\n","                    differing_row[\"Build\"],\n","                \"Test\":\n","                    differing_row[\"Test\"],\n","                \"Original\":\n","                    differing_row[\n","                        original_column\n","                    ],\n","                \"Reconstructed\":\n","                    differing_row[\n","                        reconstructed_column\n","                    ],\n","            })\n","\n","    print(\"\\nExample mismatches:\")\n","    display(\n","        pd.DataFrame(\n","            mismatch_examples\n","        ).head(30)\n","    )"]},{"ce