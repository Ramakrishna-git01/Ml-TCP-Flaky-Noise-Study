.000000\n","1                   5.0      0.963207  0.842297  0.967042    1.231894\n","2                  10.0      0.882248  0.731341  0.940185    1.231894\n","3                  15.0      0.699425  0.283374  0.976617    1.406679\n","4                  20.0      0.563100  0.444347  0.515853    1.425976\n","5                  25.0      0.334253  0.281823  0.434852    1.393000\n","6                  30.0      0.353279  0.307740  0.527022    1.420898\n","7                  40.0      0.296987  0.497587  0.699440    1.417390\n","8                  50.0      0.370366  0.599712  0.457446    0.456563"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Saved audit outputs:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/apache__airavata\n","\n","SUCCESS: Airavata seed 1 passed the complete nine-level audit.\n"]}],"source":["# =========================================================\n","# AIRAVATA — COMPLETE SEED 1 NESTED-LADDER AUDIT\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","import pyarrow.parquet as pq\n","from IPython.display import display\n","\n","\n","print(\"=== AIRAVATA SEED 1 COMPLETE AUDIT ===\")\n","\n","\n","# ---------------------------------------------------------\n","# 1. EXPECTED STRUCTURE\n","# ---------------------------------------------------------\n","\n","AUDIT_NOISE_LEVELS = [\n","    0, 5, 10, 15, 20, 25, 30, 40, 50\n","]\n","\n","AUDIT_SEED = 1\n","\n","EXPECTED_TECHNIQUES = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","}\n","\n","EXPECTED_ML_TECHNIQUES = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","}\n","\n","EXPECTED_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","    \"rankings.parquet\",\n","]\n","\n","\n","EXPECTED_MANIFEST_ROWS = len(\n","    clean_training_history\n",")\n","\n","EXPECTED_EVALUATION_ROWS = len(\n","    clean_evaluation_data\n",")\n","\n","EXPECTED_EVALUATION_BUILDS = int(\n","    clean_evaluation_data[\"Build\"].nunique()\n",")\n","\n","EXPECTED_RANKING_ROWS = (\n","    EXPECTED_EVALUATION_ROWS\n","    * len(EXPECTED_TECHNIQUES)\n",")\n","\n","EXPECTED_BUILD_METRIC_ROWS = (\n","    EXPECTED_EVALUATION_BUILDS\n","    * len(EXPECTED_TECHNIQUES)\n",")\n","\n","\n","SEED1_OUTPUT_DIRECTORY = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","SEED1_OUTPUT_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. LOAD AND VALIDATE ALL NINE CONDITIONS\n","# ---------------------------------------------------------\n","\n","condition_records = []\n","project_run_frames = []\n","manifests = {}\n","\n","\n","for noise_percent in AUDIT_NOISE_LEVELS:\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{noise_percent:03d}\"\n","        / f\"seed_{AUDIT_SEED:02d}\"\n","    )\n","\n","    missing_files = [\n","        file_name\n","        for file_name in EXPECTED_FILES\n","        if not (\n","            condition_directory / file_name\n","        ).exists()\n","    ]\n","\n","    if missing_files:\n","        raise FileNotFoundError(\n","            f\"Noise {noise_percent}% is missing files:\\n\"\n","            + \"\\n\".join(missing_files)\n","        )\n","\n","\n","    # -----------------------------------------------------\n","    # Success metadata\n","    # -----------------------------------------------------\n","\n","    with open(\n","        condition_directory / \"_SUCCESS.json\",\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","        success_metadata = json.load(\n","            marker_file\n","        )\n","\n","\n","    assert success_metadata[\n","        \"CompletedSuccessfully\"\n","    ] is True\n","\n","    assert success_metadata[\n","        \"EvaluationHashUnchanged\"\n","    ] is True\n","\n","    assert int(\n","        success_metadata[\"TechniqueCount\"]\n","    ) == 7\n","\n","    assert int(\n","        success_metadata[\"EvaluatedBuilds\"]\n","    ) == EXPECTED_EVALUATION_BUILDS\n","\n","    assert int(\n","        success_metadata[\"RankingRows\"]\n","    ) == EXPECTED_RANKING_ROWS\n","\n","    assert int(\n","        success_metadata[\"BuildMetricRows\"]\n","    ) == EXPECTED_BUILD_METRIC_ROWS\n","\n","\n","    # -----------------------------------------------------\n","    # Fast Parquet row-count checks\n","    # -----------------------------------------------------\n","\n","    manifest_rows = int(\n","        pq.ParquetFile(\n","            condition_directory\n","            / \"noise_manifest.parquet\"\n","        ).metadata.num_rows\n","    )\n","\n","    ranking_rows = int(\n","        pq.ParquetFile(\n","            condition_directory\n","            / \"rankings.parquet\"\n","        ).metadata.num_rows\n","    )\n","\n","    build_metric_rows = int(\n","        pq.ParquetFile(\n","            condition_directory\n","            / \"build_metrics.parquet\"\n","        ).metadata.num_rows\n","    )\n","\n","\n","    assert manifest_rows == EXPECTED_MANIFEST_ROWS\n","    assert ranking_rows == EXPECTED_RANKING_ROWS\n","    assert build_metric_rows == EXPECTED_BUILD_METRIC_ROWS\n","\n","\n","    # -----------------------------------------------------\n","    # Load small result files\n","    # -----------------------------------------------------\n","\n","    noise_summary = pd.read_csv(\n","        condition_directory\n","        / \"noise_summary.csv\"\n","    )\n","\n","    project_run_metrics = pd.read_csv(\n","        condition_directory\n","        / \"project_run_metrics.csv\"\n","    )\n","\n","    fit_times = pd.read_csv(\n","        condition_directory\n","        / \"fit_times.csv\"\n","    )\n","\n","\n","    assert len(noise_summary) == 1\n","    assert len(project_run_metrics) == 7\n","    assert len(fit_times) == 4\n","\n","    assert set(\n","        project_run_metrics[\"Technique\"]\n","    ) == EXPECTED_TECHNIQUES\n","\n","    assert set(\n","        fit_times[\"Technique\"]\n","    ) == EXPECTED_ML_TECHNIQUES\n","\n","    assert (\n","        project_run_metrics[\"EvaluatedBuilds\"]\n","        == EXPECTED_EVALUATION_BUILDS\n","    ).all()\n","\n","    assert (\n","        project_run_metrics[\n","            [\"MeanAPFD\", \"MeanAPFDc\"]\n","        ]\n","        .notna()\n","        .all()\n","        .all()\n","    )\n","\n","    assert (\n","        project_run_metrics[\"MeanAPFD\"]\n","        .between(0, 1, inclusive=\"both\")\n","        .all()\n","    )\n","\n","    assert (\n","        project_run_metrics[\"MeanAPFDc\"]\n","        .between(0, 1, inclusive=\"both\")\n","        .all()\n","    )\n","\n","\n","    project_run_frames.append(\n","        project_run_metrics\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # Load and validate noise manifest\n","    # -----------------------------------------------------\n","\n","    manifest = pd.read_parquet(\n","        condition_directory\n","        / \"noise_manifest.parquet\",\n","        columns=[\n","            \"NoiseRowID\",\n","            \"Build\",\n","            \"Test\",\n","            \"OriginalVerdict\",\n","            \"NoisyVerdict\",\n","            \"FlipUniform\",\n","            \"Flipped\",\n","            \"PassToFailure\",\n","            \"FailureToPass\",\n","        ],\n","    )\n","\n","    manifest = (\n","        manifest\n","        .sort_values(\"NoiseRowID\")\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    actual_changes = (\n","        manifest[\"OriginalVerdict\"]\n","        != manifest[\"NoisyVerdict\"]\n","    )\n","\n","    assert np.array_equal(\n","        actual_changes.to_numpy(),\n","        manifest[\"Flipped\"].to_numpy(),\n","    )\n","\n","\n","    flipped_count = int(\n","        manifest[\"Flipped\"].sum()\n","    )\n","\n","    pass_to_failure = int(\n","        manifest[\"PassToFailure\"].sum()\n","    )\n","\n","    failure_to_pass = int(\n","        manifest[\"FailureToPass\"].sum()\n","    )\n","\n","\n","    assert (\n","        pass_to_failure\n","        + failure_to_pass\n","    ) == flipped_count\n","\n","    assert flipped_count == int(\n","        noise_summary[\n","            \"NumberFlipped\"\n","        ].iloc[0]\n","    )\n","\n","\n","    realised_noise = float(\n","        noise_summary[\n","            \"RealisedNoisePercent\"\n","        ].iloc[0]\n","    )\n","\n","    calculated_realised_noise = (\n","        100.0\n","        * flipped_count\n","        / EXPECTED_MANIFEST_ROWS\n","    )\n","\n","    assert np.isclose(\n","        realised_noise,\n","        calculated_realised_noise,\n","        atol=1e-12,\n","        rtol=0,\n","    )\n","\n","\n","    if noise_percent == 0:\n","        assert flipped_count == 0\n","\n","    manifests[noise_percent] = manifest\n","\n","\n","    condition_records.append({\n","        \"Project\": PROJECT_NAME,\n","        \"RepetitionSeed\": AUDIT_SEED,\n","        \"NoisePercent\": noise_percent,\n","        \"RealisedNoisePercent\":\n","            realised_noise,\n","        \"NumberFlipped\":\n","            flipped_count,\n","        \"PassToFailure\":\n","            pass_to_failure,\n","        \"FailureToPass\":\n","            failure_to_pass,\n","        \"ManifestRows\":\n","            manifest_rows,\n","        \"RankingRows\":\n","            ranking_rows,\n","        \"BuildMetricRows\":\n","            build_metric_rows,\n","        \"ProjectRunRows\":\n","            len(project_run_metrics),\n","        \"MLFitRows\":\n","            len(fit_times),\n","        \"EvaluatedBuilds\":\n","            EXPECTED_EVALUATION_BUILDS,\n","        \"EvaluationUnchanged\":\n","            True,\n","        \"Status\":\n","            \"SUCCESS\",\n","    })\n","\n","\n","condition_audit = pd.DataFrame(\n","    condition_records\n",")\n","\n","all_project_runs = pd.concat(\n","    project_run_frames,\n","    ignore_index=True,\n",")\n","\n","\n","assert len(condition_audit) == 9\n","assert len(all_project_runs) == 63\n","\n","\n","# ---------------------------------------------------------\n","# 3. VERIFY SAME UNDERLYING RANDOM STREAM\n","# ---------------------------------------------------------\n","\n","reference_manifest = manifests[0]\n","\n","same_uniform_streams = True\n","\n","\n","for noise_percent in AUDIT_NOISE_LEVELS:\n","\n","    current_manifest = manifests[\n","        noise_percent\n","    ]\n","\n","    assert np.array_equal(\n","        reference_manifest[\n","            \"NoiseRowID\"\n","        ].to_numpy(),\n","        current_manifest[\n","            \"NoiseRowID\"\n","        ].to_numpy(),\n","    )\n","\n","    assert np.array_equal(\n","        reference_manifest[\n","            \"Build\"\n","        ].to_numpy(),\n","        current_manifest[\n","            \"Build\"\n","        ].to_numpy(),\n","    )\n","\n","    assert np.array_equal(\n","        reference_manifest[\n","            \"Test\"\n","        ].to_numpy(),\n","        current_manifest[\n","            \"Test\"\n","        ].to_numpy(),\n","    )\n","\n","    assert np.array_equal(\n","        reference_manifest[\n","            \"OriginalVerdict\"\n","        ].to_numpy(),\n","        current_manifest[\n","            \"OriginalVerdict\"\n","        ].to_numpy(),\n","    )\n","\n","\n","    current_uniform_match = np.array_equal(\n","        reference_manifest[\n","            \"FlipUniform\"\n","        ].to_numpy(),\n","        current_manifest[\n","            \"FlipUniform\"\n","        ].to_numpy(),\n","    )\n","\n","    if not current_uniform_match:\n","        same_uniform_streams = False\n","\n","    assert current_uniform_match\n","\n","\n","# ---------------------------------------------------------\n","# 4. VERIFY NESTED MASKS\n","# ---------------------------------------------------------\n","\n","nested_records = []\n","\n","\n","for lower_noise, higher_noise in zip(\n","    AUDIT_NOISE_LEVELS[:-1],\n","    AUDIT_NOISE_LEVELS[1:],\n","):\n","\n","    lower_manifest = manifests[\n","        lower_noise\n","    ]\n","\n","    higher_manifest = manifests[\n","        higher_noise\n","    ]\n","\n","\n","    lower_mask = (\n","        lower_manifest[\"Flipped\"]\n","        .astype(bool)\n","        .to_numpy()\n","    )\n","\n","    higher_mask = (\n","        higher_manifest[\"Flipped\"]\n","        .astype(bool)\n","        .to_numpy()\n","    )\n","\n","\n","    nested_violations = int(\n","        (\n","            lower_mask\n","            \u0026 ~higher_mask\n","        ).sum()\n","    )\n","\n","    additional_flips = int(\n","        (\n","            higher_mask\n","            \u0026 ~lower_mask\n","        ).sum()\n","    )\n","\n","    lower_flips = int(\n","        lower_mask.sum()\n","    )\n","\n","    higher_flips = int(\n","        higher_mask.sum()\n","    )\n","\n","\n","    assert nested_violations == 0\n","\n","    assert higher_flips == (\n","        lower_flips\n","        + additional_flips\n","    )\n","\n","\n","    nested_records.append({\n","        \"Project\": PROJECT_NAME,\n","        \"RepetitionSeed\": AUDIT_SEED,\n","        \"LowerNoise\":\n","            lower_noise,\n","        \"HigherNoise\":\n","            higher_noise,\n","        \"LowerFlips\":\n","            lower_flips,\n","        \"HigherFlips\":\n","            higher_flips,\n","        \"AdditionalFlips\":\n","            additional_flips,\n","        \"NestedViolations\":\n","            nested_violations,\n","    })\n","\n","\n","nested_mask_audit = pd.DataFrame(\n","    nested_records\n",")\n","\n","\n","assert len(nested_mask_audit) == 8\n","\n","assert int(\n","    nested_mask_audit[\n","        \"NestedViolations\"\n","    ].sum()\n",") == 0\n","\n","\n","# ---------------------------------------------------------\n","# 5. VERIFY NOISE-INDEPENDENT BASELINES\n","# ---------------------------------------------------------\n","\n","for technique in [\n","    \"Random\",\n","    \"QTF-Avg\",\n","]:\n","\n","    technique_rows = (\n","        all_project_runs[\n","            all_project_runs[\n","                \"Technique\"\n","            ] == technique\n","        ]\n","        .sort_values(\"NoisePercent\")\n","    )\n","\n","\n","    assert len(technique_rows) == 9\n","\n","    assert np.allclose(\n","        technique_rows[\n","            \"MeanAPFD\"\n","        ].to_numpy(),\n","        technique_rows[\n","            \"MeanAPFD\"\n","        ].iloc[0],\n","        atol=1e-12,\n","        rtol=0,\n","    )\n","\n","    assert np.allclose(\n","        technique_rows[\n","            \"MeanAPFDc\"\n","        ].to_numpy(),\n","        technique_rows[\n","            \"MeanAPFDc\"\n","        ].iloc[0],\n","        atol=1e-12,\n","        rtol=0,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. CREATE SEED-1 DEGRADATION VALUES\n","# ---------------------------------------------------------\n","\n","clean_reference = (\n","    all_project_runs[\n","        all_project_runs[\n","            \"NoisePercent\"\n","        ] == 0\n","    ][\n","        [\n","            \"Technique\",\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","        ]\n","    ]\n","    .rename(columns={\n","        \"MeanAPFD\":\n","            \"CleanMeanAPFD\",\n","        \"MeanAPFDc\":\n","            \"CleanMeanAPFDc\",\n","    })\n",")\n","\n","\n","degradation_long = (\n","    all_project_runs\n","    .merge(\n","        clean_reference,\n","        on=\"Technique\",\n","        how=\"left\",\n","        validate=\"many_to_one\",\n","    )\n",")\n","\n","\n","degradation_long[\n","    \"APFDChangeFromClean\"\n","] = (\n","    degradation_long[\"MeanAPFD\"]\n","    - degradation_long[\"CleanMeanAPFD\"]\n",")\n","\n","degradation_long[\n","    \"APFDcChangeFromClean\"\n","] = (\n","    degradation_long[\"MeanAPFDc\"]\n","    - degradation_long[\"CleanMeanAPFDc\"]\n",")\n","\n","degradation_long[\n","    \"APFDcRetention\"\n","] = (\n","    degradation_long[\"MeanAPFDc\"]\n","    / degradation_long[\"CleanMeanAPFDc\"]\n",")\n","\n","degradation_long[\n","    \"APFDcLossPercent\"\n","] = (\n","    100.0\n","    * (\n","        degradation_long[\"CleanMeanAPFDc\"]\n","        - degradation_long[\"MeanAPFDc\"]\n","    )\n","    / degradation_long[\"CleanMeanAPFDc\"]\n",")\n","\n","\n","apfdc_wide = (\n","    all_project_runs\n","    .pivot(\n","        index=\"NoisePercent\",\n","        columns=\"Technique\",\n","        values=\"MeanAPFDc\",\n","    )\n","    .reset_index()\n","    .sort_values(\"NoisePercent\")\n",")\n","\n","\n","retention_wide = (\n","    degradation_long\n","    .pivot(\n","        index=\"NoisePercent\",\n","        columns=\"Technique\",\n","        values=\"APFDcRetention\",\n","    )\n","    .reset_index()\n","    .sort_values(\"NoisePercent\")\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 7. SAVE SEED-1 AUDIT OUTPUTS\n","# ---------------------------------------------------------\n","\n","condition_audit_path = (\n","    SEED1_OUTPUT_DIRECTORY\n","    / \"seed_01_condition_audit.csv\"\n",")\n","\n","nested_audit_path = (\n","    SEED1_OUTPUT_DIRECTORY\n","    / \"seed_01_nested_mask_audit.csv\"\n",")\n","\n","degradation_path = (\n","    SEED1_OUTPUT_DIRECTORY\n","    / \"seed_01_degradation_long.csv\"\n",")\n","\n","apfdc_wide_path = (\n","    SEED1_OUTPUT_DIRECTORY\n","    / \"seed_01_apfdc_wide.csv\"\n",")\n","\n","retentio