Thesis_Experiment/Resul...         \n","249  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","250  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","251  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","252  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","253  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","254  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","255  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","256  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","257  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","258  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","259  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","260  /content/drive/MyDrive/Thesis_Experiment/Resul...         \n","\n","                           RecordedAt  \n","241  2026-07-23T15:26:50.362991+00:00  \n","242  2026-07-23T15:27:05.622379+00:00  \n","243  2026-07-23T15:27:20.032034+00:00  \n","244  2026-07-23T15:27:35.195466+00:00  \n","245  2026-07-23T15:27:50.487300+00:00  \n","246  2026-07-23T15:28:05.746376+00:00  \n","247  2026-07-23T15:28:21.193483+00:00  \n","248  2026-07-23T15:28:36.500981+00:00  \n","249  2026-07-23T15:28:51.780802+00:00  \n","250  2026-07-23T15:29:07.098987+00:00  \n","251  2026-07-23T15:29:22.493535+00:00  \n","252  2026-07-23T15:29:36.807802+00:00  \n","253  2026-07-23T15:29:51.904988+00:00  \n","254  2026-07-23T15:30:07.040118+00:00  \n","255  2026-07-23T15:30:22.324370+00:00  \n","256  2026-07-23T15:30:37.745210+00:00  \n","257  2026-07-23T15:30:52.991776+00:00  \n","258  2026-07-23T15:31:08.541567+00:00  \n","259  2026-07-23T15:31:23.998772+00:00  \n","260  2026-07-23T15:31:39.266158+00:00  "]},"metadata":{},"output_type":"display_data"}],"source":["# =========================================================\n","# ANGEL — RESTART-SAFE FULL BATCH FOR SEEDS 2–30\n","# =========================================================\n","\n","from contextlib import redirect_stdout, redirect_stderr\n","from pathlib import Path\n","import gc\n","import io\n","import json\n","import time\n","\n","import pandas as pd\n","from IPython.display import display as ipython_display\n","\n","\n","BATCH_SEEDS = list(range(2, 31))\n","\n","BATCH_NOISE_LEVELS = [\n","    0,\n","    5,\n","    10,\n","    15,\n","    20,\n","    25,\n","    30,\n","    40,\n","    50,\n","]\n","\n","EXPECTED_CONDITION_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","    \"rankings.parquet\",\n","]\n","\n","PROGRESS_PATH = (\n","    PROJECT_LOGS\n","    / \"seeds_02_30_progress.csv\"\n",")\n","\n","FAILURE_LOG_DIRECTORY = (\n","    PROJECT_LOGS\n","    / \"batch_failure_logs\"\n",")\n","\n","FAILURE_LOG_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 1. LOAD EXISTING PROGRESS, WHEN RESUMING\n","# ---------------------------------------------------------\n","\n","if PROGRESS_PATH.exists():\n","    existing_progress = pd.read_csv(\n","        PROGRESS_PATH\n","    )\n","\n","    progress_records = (\n","        existing_progress\n","        .to_dict(\"records\")\n","    )\n","\n","    print(\n","        \"Existing progress log loaded:\",\n","        len(existing_progress),\n","        \"records\",\n","    )\n","else:\n","    progress_records = []\n","\n","    print(\n","        \"Starting a new seeds 2–30 batch.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. CONDITION COMPLETENESS CHECK\n","# ---------------------------------------------------------\n","\n","def inspect_saved_condition(\n","    repetition_seed,\n","    noise_percent,\n","):\n","    \"\"\"\n","    Return:\n","        (complete, condition_directory)\n","\n","    A success marker is trusted only when all expected\n","    condition files exist and the marker reports successful\n","    completion.\n","    \"\"\"\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{int(repetition_seed):02d}\"\n","    )\n","\n","    success_marker = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","    if not success_marker.exists():\n","        return False, condition_directory\n","\n","    missing_files = [\n","        file_name\n","        for file_name\n","        in EXPECTED_CONDITION_FILES\n","        if not (\n","            condition_directory\n","            / file_name\n","        ).exists()\n","    ]\n","\n","    if missing_files:\n","        raise RuntimeError(\n","            \"A success marker exists, but condition \"\n","            \"files are missing for \"\n","            f\"seed {repetition_seed}, \"\n","            f\"noise {noise_percent}%:\\n\"\n","            + \", \".join(missing_files)\n","        )\n","\n","    with open(\n","        success_marker,\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","        metadata = json.load(\n","            marker_file\n","        )\n","\n","    if metadata.get(\n","        \"CompletedSuccessfully\"\n","    ) is not True:\n","        raise RuntimeError(\n","            \"The success marker does not report \"\n","            \"successful completion for \"\n","            f\"seed {repetition_seed}, \"\n","            f\"noise {noise_percent}%.\"\n","        )\n","\n","    if metadata.get(\n","        \"EvaluationHashUnchanged\"\n","    ) is not True:\n","        raise RuntimeError(\n","            \"The saved condition reports that the \"\n","            \"evaluation data changed.\"\n","        )\n","\n","    if int(\n","        metadata.get(\n","            \"RankingRows\",\n","            -1,\n","        )\n","    ) != 4914:\n","        raise RuntimeError(\n","            \"Unexpected saved ranking-row count for \"\n","            f\"seed {repetition_seed}, \"\n","            f\"noise {noise_percent}%.\"\n","        )\n","\n","    if int(\n","        metadata.get(\n","            \"BuildMetricRows\",\n","            -1,\n","        )\n","    ) != 196:\n","        raise RuntimeError(\n","            \"Unexpected saved metric-row count for \"\n","            f\"seed {repetition_seed}, \"\n","            f\"noise {noise_percent}%.\"\n","        )\n","\n","    return True, condition_directory\n","\n","\n","# ---------------------------------------------------------\n","# 3. ATOMIC PROGRESS-LOG SAVING\n","# ---------------------------------------------------------\n","\n","def save_batch_progress():\n","    progress_dataframe = pd.DataFrame(\n","        progress_records\n","    )\n","\n","    if len(progress_dataframe) \u003e 0:\n","        progress_dataframe = (\n","            progress_dataframe\n","            .sort_values(\n","                [\n","                    \"RepetitionSeed\",\n","                    \"NoisePercent\",\n","                    \"RecordedAt\",\n","                ]\n","            )\n","            .drop_duplicates(\n","                [\n","                    \"RepetitionSeed\",\n","                    \"NoisePercent\",\n","                ],\n","                keep=\"last\",\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","    temporary_path = (\n","        PROGRESS_PATH.parent\n","        / (\n","            PROGRESS_PATH.name\n","            + \".temporary\"\n","        )\n","    )\n","\n","    progress_dataframe.to_csv(\n","        temporary_path,\n","        index=False,\n","    )\n","\n","    temporary_path.replace(\n","        PROGRESS_PATH\n","    )\n","\n","    return progress_dataframe\n","\n","\n","# ---------------------------------------------------------\n","# 4. RUN THE COMPLETE BATCH\n","# ---------------------------------------------------------\n","\n","total_conditions = (\n","    len(BATCH_SEEDS)\n","    * len(BATCH_NOISE_LEVELS)\n",")\n","\n","condition_counter = 0\n","batch_start_time = time.time()\n","batch_failed = False\n","\n","\n","print(\"\\n=== ANGEL SEEDS 2–30 BATCH ===\")\n","print(\"Conditions scheduled:\", total_conditions)\n","print(\"Progress file:\", PROGRESS_PATH)\n","print()\n","\n","\n","for repetition_seed in BATCH_SEEDS:\n","\n","    for noise_percent in BATCH_NOISE_LEVELS:\n","\n","        condition_counter += 1\n","\n","        condition_label = (\n","            f\"[{condition_counter:03d}/\"\n","            f\"{total_conditions}] \"\n","            f\"seed {repetition_seed:02d}, \"\n","            f\"noise {noise_percent:02d}%\"\n","        )\n","\n","        condition_start_time = time.time()\n","\n","        try:\n","            (\n","                already_complete,\n","                condition_directory,\n","            ) = inspect_saved_condition(\n","                repetition_seed,\n","                noise_percent,\n","            )\n","\n","            if already_complete:\n","\n","                elapsed_seconds = (\n","                    time.time()\n","                    - condition_start_time\n","                )\n","\n","                progress_records.append({\n","                    \"Project\":\n","                        PROJECT_NAME,\n","                    \"RepetitionSeed\":\n","                        repetition_seed,\n","                    \"NoisePercent\":\n","                        noise_percent,\n","                    \"Status\":\n","                        \"SKIPPED_COMPLETE\",\n","                    \"ElapsedSeconds\":\n","                        elapsed_seconds,\n","                    \"ConditionDirectory\":\n","                        str(\n","                            condition_directory\n","                        ),\n","                    \"Error\":\n","                        \"\",\n","                    \"RecordedAt\":\n","                        pd.Timestamp.utcnow()\n","                        .isoformat(),\n","                })\n","\n","                save_batch_progress()\n","\n","                print(\n","                    condition_label,\n","                    \"— already complete, skipped\"\n","                )\n","\n","                continue\n","\n","\n","            # Suppress the large table printed by\n","            # run_unified_condition for every condition.\n","            captured_stdout = io.StringIO()\n","            captured_stderr = io.StringIO()\n","\n","            original_display = globals().get(\n","                \"display\"\n","            )\n","\n","            globals()[\"display\"] = (\n","                lambda *args, **kwargs: None\n","            )\n","\n","            try:\n","                with redirect_stdout(\n","                    captured_stdout\n","                ), redirect_stderr(\n","                    captured_stderr\n","                ):\n","\n","                    condition_result = (\n","                        run_unified_condition(\n","                            noise_percent=(\n","                                noise_percent\n","                            ),\n","                            repetition_seed=(\n","                                repetition_seed\n","                            ),\n","                            save_rankings=True,\n","                            overwrite=False,\n","                        )\n","                    )\n","\n","            finally:\n","                if original_display is not None:\n","                    globals()[\"display\"] = (\n","                        original_display\n","                    )\n","                else:\n","                    globals().pop(\n","                        \"display\",\n","                        None,\n","                    )\n","\n","\n","            # Confirm the newly saved condition.\n","            (\n","                now_complete,\n","                condition_directory,\n","            ) = inspect_saved_condition(\n","                repetition_seed,\n","                noise_percent,\n","            )\n","\n","            if not now_complete:\n","                raise RuntimeError(\n","                    \"The condition finished but did not \"\n","                    \"produce a valid success marker.\"\n","                )\n","\n","\n","            elapsed_seconds = (\n","                time.time()\n","                - condition_start_time\n","            )\n","\n","            progress_records.append({\n","                \"Project\":\n","                    PROJECT_NAME,\n","                \"RepetitionSeed\":\n","                    repetition_seed,\n","                \"NoisePercent\":\n","                    noise_percent,\n","                \"Status\":\n","                    \"SUCCESS\",\n","                \"ElapsedSeconds\":\n","                    elapsed_seconds,\n","                \"ConditionDirectory\":\n","                    str(\n","                        condition_directory\n","                    ),\n","                \"Error\":\n","                    \"\",\n","                \"RecordedAt\":\n","                    pd.Timestamp.utcnow()\n","                    .isoformat(),\n","            })\n","\n","            save_batch_progress()\n","\n","            print(\n","                condition_label,\n","                \"— SUCCESS —\",\n","                round(\n","                    elapsed_seconds,\n","                    2,\n","                ),\n","                \"seconds\",\n","            )\n","\n","\n","            # Avoid retaining rankings and models from\n","            # previous conditions in Colab memory.\n","            del condition_result\n","            gc.collect()\n","\n","\n","        except Exception as error:\n","\n","            elapsed_seconds = (\n","                time.time()\n","                - condition_start_time\n","            )\n","\n","            error_message = (\n","                f\"{type(error).__name__}: \"\n","                f\"{error}\"\n","            )\n","\n","            progress_records.append({\n","                \"Project\":\n","                    PROJECT_NAME,\n","                \"RepetitionSeed\":\n","                    repetition_seed,\n","                \"NoisePercent\":\n","                    noise_percent,\n","                \"Status\":\n","                    \"FAILED\",\n","                \"ElapsedSeconds\":\n","                    elapsed_seconds,\n","                \"ConditionDirectory\":\n","                    str(\n","                        PROJECT_RAW_RESULTS\n","                        / (\n","                            f\"noise_\"\n","                            f\"{noise_percent:03d}\"\n","                        )\n","                        / (\n","                            f\"seed_\"\n","                            f\"{repetition_seed:02d}\"\n","                        )\n","                    ),\n","                \"Error\":\n","                    error_message,\n","                \"RecordedAt\":\n","                    pd.Timestamp.utcnow()\n","                    .isoformat(),\n","            })\n","\n","            progress_dataframe = (\n","                save_batch_progress()\n","            )\n","\n","\n","            failure_log_path = (\n","                FAILURE_LOG_DIRECTORY\n","                / (\n","                    f\"seed_\"\n","                    f\"{repetition_seed:02d}\"\n","                    f\"_noise_\"\n","                    f\"{noise_percent:03d}\"\n","                    \".txt\"\n","                )\n","            )\n","\n","            with open(\n","                failure_log_path,\n","                \"w\",\n","                encoding=\"utf-8\",\n","            ) as failure_log:\n","\n","                failure_log.write(\n","                    e