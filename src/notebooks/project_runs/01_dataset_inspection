": 0.1951046991269026,\n        \"min\": 0.38888888888888884,\n        \"max\": 0.7777777777777778,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          0.5555555555555556\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"APFDcMatch\",\n      \"properties\": {\n        \"dtype\": \"boolean\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          true\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}","type":"dataframe"},"text/html":["\n","  \u003cdiv id=\"df-b1d6ceff-9124-4e0d-9f04-a2e641c4e3b0\" class=\"colab-df-container\"\u003e\n","    \u003cdiv\u003e\n","\u003cstyle scoped\u003e\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","\u003c/style\u003e\n","\u003ctable border=\"1\" class=\"dataframe\"\u003e\n","  \u003cthead\u003e\n","    \u003ctr style=\"text-align: right;\"\u003e\n","      \u003cth\u003e\u003c/th\u003e\n","      \u003cth\u003eExample\u003c/th\u003e\n","      \u003cth\u003eDirectProposalAPFD\u003c/th\u003e\n","      \u003cth\u003eExperimentHelperAPFD\u003c/th\u003e\n","      \u003cth\u003eAPFDMatch\u003c/th\u003e\n","      \u003cth\u003eDirectProposalAPFDc\u003c/th\u003e\n","      \u003cth\u003eExperimentHelperAPFDc\u003c/th\u003e\n","      \u003cth\u003eAPFDcMatch\u003c/th\u003e\n","    \u003c/tr\u003e\n","  \u003c/thead\u003e\n","  \u003ctbody\u003e\n","    \u003ctr\u003e\n","      \u003cth\u003e0\u003c/th\u003e\n","      \u003ctd\u003eTwo failures ranked first; long failure first\u003c/td\u003e\n","      \u003ctd\u003e0.8\u003c/td\u003e\n","      \u003ctd\u003e0.8\u003c/td\u003e\n","      \u003ctd\u003eTrue\u003c/td\u003e\n","      \u003ctd\u003e0.555556\u003c/td\u003e\n","      \u003ctd\u003e0.5