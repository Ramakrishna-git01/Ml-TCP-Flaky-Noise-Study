uild\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","original_complete_rec_matrix[\n","    \"Test\"\n","] = (\n","    original_complete_rec_matrix[\n","        \"Test\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","complete_protocol_comparison = (\n","    original_complete_rec_matrix\n","    .merge(\n","        canonical_rec_matrix,\n","        on=[\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        how=\"left\",\n","        validate=\"one-to-one\",\n","        suffixes=(\n","            \"_Original\",\n","            \"_Canonical\",\n","        ),\n","        indicator=True,\n","    )\n",")\n","\n","\n","if not (\n","    complete_protocol_comparison[\n","        \"_merge\"\n","    ] == \"both\"\n",").all():\n","    raise AssertionError(\n","        \"Canonical protocol matrix is missing rows.\"\n","    )\n","\n","\n","complete_protocol_mismatches = 0\n","\n","\n","for feature in REC_FEATURE_COLUMNS:\n","    original_values = pd.to_numeric(\n","        complete_protocol_comparison[\n","            f\"{feature}_Original\"\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","\n","    canonical_values = pd.to_numeric(\n","        complete_protocol_comparison[\n","            f\"{feature}_Canonical\"\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","\n","    complete_protocol_mismatches += int(\n","        (\n","            ~np.isclose(\n","                original_values,\n","                canonical_values,\n","                rtol=1e-9,\n","                atol=1e-9,\n","                equal_nan=True,\n","            )\n","        ).sum()\n","    )\n","\n","\n","complete_protocol_values_compared = int(\n","    len(dataset_with_order)\n","    * len(REC_FEATURE_COLUMNS)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 12. Final validation decision\n","# ----------------------------------------------