ifest[\"Flipped\"]\n","        ).sum()\n","    )\n","\n","    lower_flips = int(\n","        lower_manifest[\"Flipped\"].sum()\n","    )\n","\n","    higher_flips = int(\n","        higher_manifest[\"Flipped\"].sum()\n","    )\n","\n","    assert nested_violations == 0\n","\n","    assert higher_flips == (\n","        lower_flips\n","        + additional_flips\n","    )\n","\n","    nested_mask_records.append({\n","        \"LowerNoise\": lower_noise,\n","        \"HigherNoise\": higher_noise,\n","        \"LowerFlips\": lower_flips,\n","        \"HigherFlips\": higher_flips,\n","        \"AdditionalFlips\": additional_flips,\n","        \"NestedViolations\":\n","            nested_violations,\n","    })\n","\n","\n","nested_mask_audit = pd.DataFrame(\n","    nested_mask_records\n",")\n","\n","assert int(\n","    manifest_by_noise[0][\n","        \"Flipped\"\n","    ].sum()\n",") == 0\n","\n","\n","# ---------------------------------------------------------\n","# 5. CREATE COMPLETE SEED-1 RESULT TABLE\n","# ---------------------------------------------------------\n","\n","seed1_project_results = pd.concat(\n","    project_run_frames,\n","    ignore_index=True,\n",")\n","\n","seed1_project_results[\n","    \"NoisePercent\"\n","] = pd.to_numeric(\n","    seed1_project_results[\n","        \"NoisePercent\"\n","    ],\n","    errors=\"raise\",\n",")\n","\n","\n","# Clean 0% reference for every technique.\n","clean_reference = (\n","    seed1_project_results[\n","        seed1_project_results[\n","            \"NoisePercent\"\n","        ] == 0\n","    ][\n","        [\n","            \"Technique\",\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","        ]\n","    ]\n","    .rename(columns={\n","        \"MeanAPFD\":\n","            \"CleanMeanAPFD\",\n","        \"MeanAPFDc\":\n","            \"CleanMeanAPFDc\",\n","    })\n",")\n","\n","\n","seed1_degradation = (\n","    seed1_project_results\n","    .merge(\n","        clean_reference,\n","        on=\"Technique\",\n","        how=\"left\",\n","        validate=\"many_to_one\",\n","    )\n",")\n","\n","\n","seed1_degradation[\n","    \"APFDChangeFromClean\"\n","] = (\n","    seed1_degradation[\"MeanAPFD\"]\n","    - seed1_degradation[\"CleanMeanAPFD\"]\n",")\n","\n","seed1_degradation[\n","    \"APFDcChangeFromClean\"\n","] = (\n","    seed1_degradation[\"MeanAPFDc\"]\n","    - seed1_degradation[\"CleanMeanAPFDc\"]\n",")\n","\n","seed1_degradation[\n","    \"APFDcRetention\"\n","] = (\n","    seed1_degradation[\"MeanAPFDc\"]\n","    / seed1_degradation[\"CleanMeanAPFDc\"]\n",")\n","\n","seed1_degradation[\n","    \"APFDcLossPercent\"\n","] = (\n","    100.0\n","    * (\n","        seed1_degradation[\n","            \"CleanMeanAPFDc\"\n","        ]\n","        - seed1_degradation[\n","            \"MeanAPFDc\"\n","        ]\n","    )\n","    / seed1_degradation[\n","        \"CleanMeanAPFDc\"\n","    ]\n",")\n","\n","\n","seed1_degradation = (\n","    seed1_degradation\n","    .sort_values(\n","        [\"Technique\", \"NoisePercent\"]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. VERIFY NOISE-INDEPENDENT BASELINES\n","# ---------------------------------------------------------\n","\n","for technique in [\n","    \"Random\",\n","    \"QTF-Avg\",\n","]:\n","\n","    technique_rows = (\n","        seed1_degradation[\n","            seed1_degradation[\n","                \"Technique\"\n","            ] == technique\n","        ]\n","        .sort_values(\n","            \"NoisePercent\"\n","        )\n","    )\n","\n","    assert np.allclose(\n","        technique_rows[\n","            \"MeanAPFD\"\n","        ].to_numpy(),\n","        technique_rows[\n","            \"MeanAPFD\"\n","        ].iloc[0],\n","        atol=1e-12,\n","        rtol=0,\n","    )\n","\n","    assert np.allclose(\n","        technique_rows[\n","            \"MeanAPFDc\"\n","        ].to_numpy(),\n","       