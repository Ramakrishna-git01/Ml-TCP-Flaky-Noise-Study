SULTS\",\n","    \"builds\",\n","    \"exe_for_rec\",\n","    \"dataset_with_order\",\n","    \"build_commit_map\",\n","    \"entity_commit_pairs\",\n","    \"unmatched_build_commit_pairs\",\n","    \"changed_entities_by_build\",\n","]\n","\n","\n","missing_variables = [\n","    variable_name\n","    for variable_name in REQUIRED_VARIABLES\n","    if variable_name not in globals()\n","]\n","\n","\n","if missing_variables:\n","    raise RuntimeError(\n","        \"Required Titan variables are missing:\\n\"\n","        + \"\\n\".join(\n","            missing_variables\n","        )\n","    )\n","\n","\n","if PROJECT_NUMBER != 5:\n","    raise AssertionError(\n","        f\"Expected Project 5, found Project {PROJECT_NUMBER}.\"\n","    )\n","\n","\n","if PROJECT_NAME != \"thinkaurelius@titan\":\n","    raise AssertionError(\n","        \"This cell is only for thinkaurelius@titan.\"\n","    )\n","\n","\n","DIAGNOSTIC_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_preflight\"\n",")\n","\n","DIAGNOSTIC_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","print(\n","    \"=== TITAN UNMATCHED-COMMIT DIAGNOSTIC ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Verify the observed unmatched state\n","# ---------------------------------------------------------\n","\n","unmatched_pairs = (\n","    unmatched_build_commit_pairs\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(unmatched_pairs) != 2:\n","    raise AssertionError(\n","        \"Expected exactly two unmatched Titan \"\n","        f\"build/commit pairs, observed {len(unmatched_pairs)}.\"\n","    )\n","\n","\n","if (\n","    unmatched_pairs[\n","        \"MatchStatus\"\n","    ] != \"UNMATCHED\"\n",").any():\n","    raise AssertionError(\n","        \"An unmatched pair has an unexpected status.\"\n","    )\n","\n","\n","if (\n","    unmatched_pairs[\n","        \"CandidateCount\"\n","    ] != 0\n",").any():\n","    raise AssertionError(\n","        \"An unmatched commit unexpectedly has \"\n","        \"prefix candidates.\"\n","    )\n","\n","\n","unmatched_build_ids = sorted(\n","    unmatched_pairs[\n","        \"Build\"\n","    ]\n","    .astype(int)\n","    .unique()\n","    .tolist()\n",")\n","\n","\n","if len(unmatched_build_ids) != 2:\n","    raise AssertionError(\n","        \"The two unmatched pairs do not correspond \"\n","        \"to two distinct builds.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Resolve entity-history commit column\n","# ---------------------------------------------------------\n","\n","if \"HistoryCommit\" in entity_commit_pairs.columns:\n","\n","    ENTITY_COMMIT_COLUMN = \"HistoryCommit\"\n","\n","elif \"NormalizedCommit\" in entity_commit_pairs.columns:\n","\n","    ENTITY_COMMIT_COLUMN = \"NormalizedCommit\"\n","\n","else:\n","\n","    raise KeyError(\n","        \"Could not identify the canonical commit \"\n","        \"column in entity_commit_pairs.\\n\"\n","        f\"Columns: {entity_commit_pairs.columns.tolist()}\"\n","    )\n","\n","\n","history_commits = sorted(\n","    entity_commit_pairs[\n","        ENTITY_COMMIT_COLUMN\n","    ]\n","    .dropna()\n","    .astype(str)\n","    .str.lower()\n","    .unique()\n","    .tolist()\n",")\n","\n","\n","history_commit_set = set(\n","    history_commits\n",")\n","\n","\n","if len(history_commits) == 0:\n","    raise AssertionError(\n","        \"The entity-history commit set is empty.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Commit-candidate diagnostic\n","# ---------------------------------------------------------\n","\n","HEX_40_PATTERN = re.compile(\n","    r\"^[0-9a-f]{40}$\"\n",")\n","\n","\n","def common_prefix_length(\n","    left,\n","    right,\n","):\n","    length = 0\n","\n","    for left_character, right_character in zip(\n","        left,\n","        right,\n","    ):\n","\n","        if left_character != right_character:\n","            break\n","\n","        length += 1\n","\n","    return length\n","\n","\n","def common_suffix_length(\n","    left,\n","    right,\n","):\n","    return common_prefix_length(\n","        left[::-1],\n","        right[::-1],\n","    )\n","\n","\n","candidate_records = []\n","\n","\n","for _, unmatched_row in (\n","    unmatched_pairs.iterrows()\n","):\n","\n","    raw_commit = str(\n","        unmatched_row[\n","            \"RawCommit\"\n","        ]\n","    ).strip().lower()\n","\n","\n","    exact_candidates = [\n","        candidate\n","        for candidate in history_commits\n","        if candidate == raw_commit\n","    ]\n","\n","\n","    history_startswith_build = [\n","        candidate\n","        for candidate in history_commits\n","        if candidate.startswith(\n","            raw_commit\n","        )\n","    ]\n","\n","\n","    build_startswith_history = [\n","        candidate\n","        for candidate in history_commits\n","        if raw_commit.startswith(\n","            candidate\n","        )\n","    ]\n","\n","\n","    prefix_candidates = sorted(\n","        set(\n","            history_startswith_build\n","            + build_startswith_history\n","        )\n","    )\n","\n","\n","    suffix_12 = raw_commit[-12:]\n","\n","\n","    suffix_candidates = [\n","        candidate\n","        for candidate in history_commits\n","        if candidate.endswith(\n","            suffix_12\n","        )\n","    ]\n","\n","\n","    best_prefix_length = -1\n","    best_prefix_candidates = []\n","\n","    best_suffix_length = -1\n","    best_suffix_candidates = []\n","\n","\n","    for candidate in history_commits:\n","\n","        prefix_length = common_prefix_length(\n","            raw_commit,\n","            candidate,\n","        )\n","\n","        suffix_length = common_suffix_length(\n","            raw_commit,\n","            candidate,\n","        )\n","\n","\n","        if prefix_length \u003e best_prefix_length:\n","\n","            best_prefix_length = (\n","                prefix_length\n","            )\n","\n","            best_prefix_candidates = [\n","                candidate\n","            ]\n","\n","\n","        elif prefix_length == best_prefix_length:\n","\n","            best_prefix_candidates.append(\n","                candidate\n","            )\n","\n","\n","        if suffix_length \u003e best_suffix_length:\n","\n","            best_suffix_length = (\n","                suffix_length\n","            )\n","\n","            best_suffix_candidates = [\n","                candidate\n","            ]\n","\n","\n","        elif suffix_length == best_suffix_length:\n","\n","            best_suffix_candidates.append(\n","                candidate\n","            )\n","\n","\n","    candidate_records.append({\n","        \"Build\":\n","            int(\n","                unmatched_row[\n","                    \"Build\"\n","                ]\n","            ),\n","\n","        \"BuildOrder\":\n","            int(\n","                unmatched_row[\n","                    \"BuildOrder\"\n","                ]\n","            ),\n","\n","        \"Partition\":\n","            str(\n","                unmatched_row[\n","                    \"Partition\"\n","                ]\n","            ),\n","\n","        \"RawCommit\":\n","            raw_commit,\n","\n","        \"CommitLength\":\n","            len(\n","                raw_commit\n","            ),\n","\n","        \"IsFull40CharacterHex\":\n","            bool(\n","                HEX_40_PATTERN.fullmatch(\n","                    raw_commit\n","                )\n","            ),\n","\n","        \"ExactCandidateCount\":\n","            len(\n","                exact_candidates\n","            ),\n","\n","        \"PrefixCandidateCount\":\n","            len(\n","                prefix_candidates\n","            ),\n","\n","        \"Suffix12CandidateCount\":\n","            len(\n","                suffix_candidates\n","            ),\n","\n","        \"BestCommonPrefixLength\":\n","            int(\n","                best_prefix_length\n","            ),\n","\n","        \"BestCommonPrefixCandidates\":\n","            \"|\".join(\n","                best_prefix_candidates[:10]\n","            ),\n","\n","        \"BestCommonSuffixLength\":\n","            int(\n","                best_suffix_length\n","            ),\n","\n","        \"BestCommonSuffixCandidates\":\n","            \"|\".join(\n","                best_suffix_candidates[:10]\n","            ),\n","\n","        \"MappingDecision\":\n","            \"NO_MATCH_ASSIGNED\",\n","    })\n","\n","\n","unmatched_commit_candidate_audit = (\n","    pd.DataFrame(\n","        candidate_records\n","    )\n",")\n","\n","\n","if not unmatched_commit_candidate_audit[\n","    \"IsFull40CharacterHex\"\n","].all():\n","\n","    raise AssertionError(\n","        \"At least one unmatched commit is not a \"\n","        \"complete 40-character hexadecimal hash.\"\n","    )\n","\n","\n","if (\n","    unmatched_commit_candidate_audit[\n","        \"ExactCandidateCount\"\n","    ] != 0\n",").any():\n","\n","    raise AssertionError(\n","        \"An exact entity-history candidate was found.\"\n","    )\n","\n","\n","if (\n","    unmatched_commit_candidate_audit[\n","        \"PrefixCandidateCount\"\n","    ] != 0\n",").any():\n","\n","    raise AssertionError(\n","        \"A prefix candidate was found unexpectedly.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Raw execution and model-ready diagnostics\n","# ---------------------------------------------------------\n","\n","raw_execution_summary = (\n","    exe_for_rec[\n","        exe_for_rec[\n","            \"build\"\n","        ].isin(\n","            unmatched_build_ids\n","        )\n","    ]\n","    .groupby(\n","        \"build\",\n","        as_index=False,\n","    )\n","    .agg(\n","        RawExecutionRows=(\n","            \"test\",\n","            \"size\",\n","        ),\n","\n","        UniqueTests=(\n","            \"test\",\n","            \"nunique\",\n","        ),\n","\n","        RawPassExecutions=(\n","            \"verdict\",\n","            lambda values:\n","                int(\n","                    (\n","                        values == 0\n","                    ).sum()\n","                ),\n","        ),\n","\n","        RawFailureExecutions=(\n","            \"verdict\",\n","            lambda values:\n","                int(\n","                    (\n","                        values != 0\n","                    ).sum()\n","                ),\n","        ),\n","\n","        MinimumDuration=(\n","            \"duration\",\n","            \"min\",\n","        ),\n","\n","        MaximumDuration=(\n","            \"duration\",\n","            \"max\",\n","        ),\n","    )\n","    .rename(\n","        columns={\n","            \"build\":\n","                \"Build\",\n","        }\n","    )\n",")\n","\n","\n","model_ready_summary = (\n","    dataset_with_order[\n","        dataset_with_order[\n","            \"Build\"\n","        ].isin(\n","            unmatched_build_ids\n","        )\n","    ]\n","    .groupby(\n","        \"Build\",\n","        as_index=False,\n","    )\n","    .agg(\n","        ModelReadyRows=(\n","            \"Test\",\n","            \"size\",\n","        ),\n","\n","        ModelReadyPasses=(\n","            \"Verdict\",\n","            lambda values:\n","                int(\n","                    (\n","                        values == 0\n","                    ).sum()\n","                ),\n","        ),\n","\n","        ModelReadyFailures=(\n","            \"Verdict\",\n","            lambda values:\n","                int(\n","                    (\n","                        values != 0\n","                    ).sum()\n","                ),\n","        ),\n","    )\n",")\n","\n","\n","build_details = (\n","    builds[\n","        builds[\n","            \"build\"\n","        ].isin(\n","            unmatched_build_ids\n","        )\n","    ][\n","        [\n","            \"build\",\n","            \"build_order\",\n","            \"started_at\",\n","            \"partition\",\n","        ]\n","    ]\n","    .rename(\n","        columns={\n","            \"build\":\n","                \"Build\",\n","\n","            \"build_order\":\n","                \"BuildOrder\",\n","\n","            \"started_at\":\n","                \"StartedAt\",\n","\n","            \"partition\":\n","                \"Partition\",\n","        }\n","    )\n",")\n","\n","\n","unmatched_build_diagnostic = (\n","    unmatched_pairs[\n","        [\n","            \"Build\",\n","            \"BuildOrder\",\n","            \"Partition\",\n","            \"RawCommit\",\n","            \"MatchStatus\",\n","            \"CandidateCount\",\n","        ]\n","    ]\n","    .merge(\n","        build_details[\n","            [\n","                \"Build\",\n","                \"StartedAt\",\n","            ]\n","        ],\n","        on=\"Build\",\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","    .merge(\n","        raw_execution_summary,\n","        on=\"Build\",\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","    .merge(\n","        model_ready_summary,\n","        on=\"Build\",\n","        how=\"left\",\n","    )\n",")\n","\n","\n","for column in [\n","    \"RawExecutionRows\",\n","    \"UniqueTests\",\n","    \"RawPassExecutions\",\n","    \"RawFailureExecutions\",\n","    \"ModelReadyRows\",\n","    \"ModelReadyPasses\",\n","    \"ModelReadyFailures\",\n","]:\n","\n","    unmatched_build_diagnostic[\n","        column\n","    ] = (\n","        unmatched_build_diagnostic[\n","            column\n","        ]\n","        .fillna(0)\n","        .astype(int)\n","    )\n","\n","\n","if (\n","    unmatched_build_diagnostic[\n","        \"RawFailureExecutions\"\n","    ] != 0\n",").any():\n","\n","    raise AssertionError(\n","        \"At least one unmatched build contains \"\n","        \"a raw failure execution.\"\n","    )\n","\n","\n","if (\n","    unmatched_build_diagnostic[\n","        \"ModelReadyRows\"\n","    ] != 0\n",").any():\n","\n","    raise AssertionError(\n","        \"At least one unmatched build contributes \"\n","        \"model-ready rows.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Inspect verdict transitions on unmatched builds\n","# ---------------------------------------------------------\n","\n","history_for_transition_audit = (\n","    exe_for_rec.copy()\n",")\n","\n","\n","history_for_transition_audit[\n","    \"PreviousVerdict\"\n","] = (\n","    history_for_transition_audit\n","    .groupby(\n","        \"test\",\n","        sort=False,\n","    )[\n","        \"verdict\"\n","    ]\n","    .shift(1)\n",")\n","\n","\n","history_for_transition_audit[\n","    \"VerdictTransition\"\n","] = (\n","    history_for_transition_audit[\n","        \"PreviousVerdict\"\n","    ].notna()\n","    \u0026 (\n","        history_for_transition_audit[\n","            \"PreviousVerdict\"\n","        ]\n","        != history_for_transition_audit[\n","            \"verdict\"\n","        ]\n","    )\n",")\n","\n","\n","unmatched_transition_rows = (\n","    history_for_transition_audit[\n","        history_for_transition_audit[\n","            \"build\"\n","        ].isin(\n","            unmatched_build_ids\n","        )\n","    ][\n","        [\n","            \"build\",\n","            \"build_order\",\n","            \"partition\",\n","            \"test\",\n","            \"PreviousVerdict\",\n","            \"verdict\",\n","            \"VerdictTransition\",\n","        ]\n","    ]\n","    .rename(\n","        columns={\n","            \"build\":\n","                \"Build\",\n","\n","            \"build_order\":\n","                \"BuildOrder\",\n","\n","            \"partition\":\n","                \"Partition\",\n","\n","            \"test\":\n","                \"Test\",\n","\n","            \"verdict\":\n","                \"Verdict\",\n","        }\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","transition_summary = (\n","    unmatched_transition_rows\n","    .groupby(\n","        \"Build\",\n","        as_index=False,\n","    )\n","    .agg(\n","        ExecutionRows=(\n","            \"Test\",\n","            \"size\",\n","        ),\n","\n","        RowsWithPreviousVerdict=(\n","            \"PreviousVerdict\",\n","            lambda values:\n","                int(\n","                    values.notna().sum()\n","                ),\n","        ),\n","\n","        VerdictTransitionRows=(\n","            \"VerdictTransition\",\n","            \"sum\",\n","        ),\n","    )\n",")\n","\n","\n","unmatched_build_diagnostic = (\n","    unmatched_build_diagnostic\n","    .merge(\n","        transition_summary,\n","        on=\"Build\",\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","\n","for column in [\n","    \"ExecutionRows\",\n","    \"RowsWithPreviousVerdict\",\n","    \"VerdictTransitionRows\",\n","]:\n","\n","    unmatched_build_diagnostic[\n","        column\n","    ] = (\n","        unmatched_build_diagnostic[\n","            column\n","        ]\n","        .fillna(0)\n","        .astype(int)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Neighbouring-build diagnostic\n","# ---------------------------------------------------------\n","\n","neighbour_records = []\n","\n","\n","for unmatched_build_id in (\n","    unmatched_build_ids\n","):\n","\n","    unmatched_order = int(\n","        builds.loc[\n","            builds[\n","                \"build\"\n","            ] == unmatched_build_id,\n","            \"build_order\",\n","        ].iloc[0]\n","    )\n","\n","\n","    neighbouring_builds = (\n","        builds[\n","            builds[\n","                \"build_order\"\n","            ].between(\n","                unmatched_order - 2,\n","                unmatched_order + 2,\n","            )\n","        ][\n","            [\n","                \"build\",\n","                \"build_order\",\n","                \"started_at\",\n","                \"partition\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","\n","    for _, neighbour_row in (\n","        neighbouring_builds.iterrows()\n","    ):\n","\n","        neighbour_build_id = int(\n","            neighbour_row[\n","                \"build\"\n","            ]\n","        )\n","\n","\n","        neighbour_commit_rows = (\n","            build_commit_map[\n","                build_commit_map[\n","                    \"Build\"\n","                ] == neighbour_build_id\n","            ]\n","        )\n","\n","\n","        neighbour_records.append({\n","            \"UnmatchedBuild\":\n","                unmatched_build_id,\n","\n","            \"UnmatchedBuildOrder\":\n","                unmatched_order,\n","\n","            \"NeighbourBuild\":\n","                neighbour_build_id,\n","\n","            \"NeighbourBuildOrder\":\n","                int(\n","                    neighbour_row[\n","                        \"build_order\"\n","                    ]\n","                ),\n","\n","            \"OrderDifference\":\n","                int(\n","                    neighbour_row[\n","                        \"build_order\"\n","                    ]\n","                    - unmatched_order\n","                ),\n","\n","            \"NeighbourPartition\":\n","                str(\n","                    neighbour_row[\n","                        \"partition\"\n","                    ]\n","                ),\n","\n","            \"NeighbourStartedAt\":\n","                str(\n","                    neighbour_row[\n","                        \"started_at\"\n","                    ]\n","                ),\n","\n","            \"NeighbourParsedCommits\":\n","                int(\n","                    len(\n","                        neighbour_commit_rows\n","                    )\n","                ),\n","\n","            \"NeighbourMatchedCommits\":\n","                int(\n","                    neighbour_commit_rows[\n","                        \"MatchedCommit\"\n","                    ]\n","                    .notna()\n","                    .sum()\n","                ),\n","\n","            \"NeighbourCommitStatuses\":\n","                \"|\".join(\n","                    neighbour_commit_rows[\n","                        \"MatchStatus\"\n","                    ]\n","                    .astype(str)\n","                    .tolist()\n","                ),\n","\n","            \"NeighbourRawCommits\":\n","                \"|\".join(\n","                    neighbour_commit_rows[\n","                        \"RawCommit\"\n","                    ]\n","                    .astype(str)\n","                    .tolist()\n","                ),\n","        })\n","\n","\n","unmatched_neighbour_audit = pd.DataFrame(\n","    neighbour_records\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Confirm there are no stored model-ready REC rows\n","# ---------------------------------------------------------\n","\n","unmatched_stored_rec_rows = (\n","    dataset_with_order[\n","        dataset_with_order[\n","            \"Build\"\n","        ].isin(\n","            unmatched_build_ids\n","        )\n","    ][\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"Verdict\",\n","            \"Duration\",\n","            \"build_order\",\n","            \"partition\",\n","        ]\n","        + REC_FEATURE_COLUMNS\n","    ]\n","    .copy()\n",")\n","\n","\n","if len(\n","    unmatched_stored_rec_rows\n",") != 0:\n","\n","    raise 