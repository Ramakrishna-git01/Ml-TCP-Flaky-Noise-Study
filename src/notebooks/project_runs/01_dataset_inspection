pute historical REC_* features for the same\n","    # fixed model-ready Build-Test training rows.\n","    reconstructed_rec = reconstruct_rec_features(\n","        execution_history=noisy_execution_history,\n","        requested_rows=clean_model_training_data[\n","            [\"Build\", \"Test\"]\n","        ],\n","        recent_window=RECENT_WINDOW,\n","    )\n","\n","    if len(reconstructed_rec) != len(\n","        clean_model_training_data\n","    ):\n","        raise ValueError(\n","            f\"Seed {seed}: reconstructed row count \"\n","            \"does not match the training dataset.\"\n","        )\n","\n","    # Extract noisy current verdicts for model-ready rows.\n","    noisy_label_lookup = (\n","        noisy_execution_history[\n","            noisy_execution_history[\"build\"].isin(\n","                training_ids\n","            )\n","        ][\n","            [\"build\", \"test\", \"verdict\"]\n","        ]\n","        .rename(\n","            columns={\n","                \"build\": \"Build\",\n","                \"test\": \"Test\",\n","                \"verdict\": \"NoisyVerdict\",\n","            }\n","        )\n","    )\n","\n","    if noisy_label_lookup.duplicated(\n","        subset=[\"Build\", \"Test\"]\n","    ).any():\n","        raise ValueError(\n","            f\"Seed {seed}: duplicate noisy \"\n","            \"Build-Test labels.\"\n","        )\n","\n","    noisy_training_data = (\n","        clean_model_training_data\n","        .copy()\n","        .merge(\n","            noisy_label_lookup,\n","            on=[\"Build\", \"Test\"],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","    )\n","\n","    if noisy_training_data[\n","        \"NoisyVerdict\"\n","    ].isna().any():\n","        raise ValueError(\n","            f\"Seed {seed}: some training rows \"\n","            \"lack noisy verdicts.\"\n","        )\n","\n","    noisy_training_data[\"Verdict\"] = (\n","        noisy_training_data[\n","            \"NoisyVerdict\"\n","        ].astype(int)\n","    )\n","\n","    noisy_training_data = (\n","        noisy_training_data\n","        .drop(\n","            columns=[\n","                \"NoisyVerdict\",\n","                *REC_FEATURE_COLUMNS,\n","            ]\n","        )\n","        .merge(\n","            reconstructed_rec,\n","            on=[\"Build\", \"Test\"],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","    )\n","\n","    # Restore the expected order.\n","    noisy_training_data = (\n","        noisy_training_data[\n","            list(dataset.columns)\n","            + [\"build_order\"]\n","        ]\n","        .sort_values(\n","            [\"build_order\", \"Test\"]\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    # -----------------------------------------------------\n","    # CREATE A SEED-LEVEL NOISE AUDIT\n","    # -----------------------------------------------------\n","\n","    flipped_rows = noise_audit[\n","        noise_audit[\"WasFlipped\"]\n","    ]\n","\n","    pass_to_failure = int(\n","        (\n","            flipped_rows[\"FlipDirection\"]\n","            == \"PassToFailure\"\n","        ).sum()\n","    )\n","\n","    failure_to_pass = int(\n","        (\n","            flipped_rows[\"FlipDirection\"]\n","            == \"FailureToPass\"\n","        ).sum()\n","    )\n","\n","    model_label_changes = int(\n","        (\n","            clean_model_training_data[\n","                \"Verdict\"\n","            ].reset_index(drop=True)\n","            !=\n","            noisy_training_data[\n","                \"Verdict\"\n","            ].reset_index(drop=True)\n","        ).sum()\n","    )\n","\n","    noise_summary = {\n","        \"NoiseSeed\": seed,\n","        \"NoiseLevel\": (\n","            noise_probability * 100\n","        ),\n","        \"EligibleExecutionRows\": len(\n","            noise_audit\n","        ),\n","        \"ActualFlips\": int(\n","            noise_audit[\"WasFlipped\"].sum()\n","        ),\n","        \"RealisedNoisePercentage\": float(\n","            noise_audit[\"WasFlipped\"].mean()\n","            * 100\n","        ),\n","        \"PassToFailureFlips\":\n","            pass_to_failure,\n","        \"FailureToPassFlips\":\n","            failure_to_pass,\n","        \"ModelRowLabelChanges\":\n","            model_label_changes,\n","        \"NoisyModelPasses\": int(\n","            (\n","                noisy_training_data[\n","                    \"Verdict\"\n","                ] == 0\n","            ).sum()\n","        ),\n","        \"NoisyModelFailures\": int(\n","            (\n","                noisy_training_data[\n","                    \"Verdict\"\n","                ] != 0\n","            ).sum()\n","        ),\n","    }\n","\n","    return (\n","        noisy_training_data,\n","        noisy_execution_history,\n","        noise_audit,\n","        noise_summary,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# RUN 30 SEEDS\n","# ---------------------------------------------------------\n","\n","rf_5pct_project_records = []\n","rf_5pct_build_frames = []\n","rf_5pct_ranking_frames = []\n","rf_5pct_noise_summary_records = []\n","rf_5pct_noise_audit_frames = []\n","\n","rf_5pct_start = time.perf_counter()\n","\n","print(\n","    \"Starting 30 formal Random Forest \"\n","    \"repetitions at 5% noise...\\n\"\n",")\n","\n","for repetition_seed in RF_5PCT_SEEDS:\n","\n","    # ---------------------------------------------\n","    # Generate this seed's corrupted training data\n","    # ---------------------------------------------\n","\n","    (\n","        noisy_training_data,\n","        noisy_execution_history,\n","        noise_audit,\n","        noise_summary,\n","    ) = create_noisy_model_training_data(\n","        clean_execution_history=exe_for_rec,\n","        clean_model_training_data=(\n","            clean_training_data\n","        ),\n","        training_ids=training_build_ids,\n","        noise_probability=(\n","            RF_5PCT_NOISE_PROBABILITY\n","        ),\n","        seed=repetition_seed,\n","    )\n","\n","    # ---------------------------------------------\n","    # Train and evaluate the Random Forest\n","    # ---------------------------------------------\n","\n","    (\n","        project_result,\n","        build_results,\n","        ranking_results,\n","    ) = run_random_forest_repetition(\n","        training_data=noisy_training_data,\n","        repetition_seed=repetition_seed,\n","        noise_level=RF_5PCT_NOISE_LEVEL,\n","    )\n","\n","    # Add noise-audit fields to the project result.\n","    project_result.update(\n","        {\n","            \"ActualFlips\":\n","                noise_summary[\"ActualFlips\"],\n","\n","            \"RealisedNoisePercentage\":\n","                noise_summary[\n","                    \"RealisedNoisePercentage\"\n","                ],\n","\n","            \"PassToFailureFlips\":\n","                noise_summary[\n","                    \"PassToFailureFlips\"\n","                ],\n","\n","            \"FailureToPassFlips\":\n","                noise_summary[\n","                    \"FailureToPassFlips\"\n","                ],\n","\n","            \"ModelRowLabelChanges\":\n","                noise_summary[\n","                    \"ModelRowLabelChanges\"\n","                ],\n","        }\n","    )\n","\n","    noise_audit = noise_audit.copy()\n","\n","    noise_audit.insert(\n","        0,\n","        \"Project\",\n","        PROJECT_NAME,\n","    )\n","\n","    noise_audit.insert(\n","        1,\n","        \"Model\",\n","        MODEL_NAME,\n","    )\n","\n","    noise_audit.insert(\n","        2,\n","        \"NoiseLevel\",\n","        RF_5PCT_NOISE_LEVEL,\n","    )\n","\n","    noise_audit.insert(\n","        3,\n","        \"RepetitionSeed\",\n","        repetition_seed,\n","    )\n","\n","    rf_5pct_project_records.append(\n","        project_result\n","    )\n","\n","    rf_5pct_build_frames.append(\n","        build_results\n","    )\n","\n","    rf_5pct_ranking_frames.append(\n","        ranking_results\n","    )\n","\n","    rf_5pct_noise_summary_records.append(\n","        noise_summary\n","    )\n","\n","    rf_5pct_noise_audit_frames.append(\n","        noise_audit\n","    )\n","\n","    print(\n","        f\"Seed {repetition_seed:02d}/30 complete | \"\n","        f\"Flips: \"\n","        f\"{noise_summary['ActualFlips']} \"\n","        f\"(\"\n","        f\"{noise_summary['RealisedNoisePercentage']:.3f}%\"\n","        f\") | \"\n","        f\"Mean APFD: \"\n","        f\"{project_result['MeanAPFD']:.6f} | \"\n","        f\"Mean APFDc: \"\n","        f\"{project_result['MeanAPFDc']:.6f} | \"\n","        f\"Time: \"\n","        f\"{project_result['RuntimeSeconds']:.2f}s\"\n","    )\n","\n","    del noisy_training_data\n","    del noisy_execution_history\n","    gc.collect()\n","\n","\n","rf_5pct_total_runtime = (\n","    time.perf_counter()\n","    - rf_5pct_start\n",")\n","\n","\n","# ---------------------------------------------------------\n","# COMBINE RESULTS\n","# ---------------------------------------------------------\n","\n","rf_5pct_project_results = (\n","    pd.DataFrame(\n","        rf_5pct_project_records\n","    )\n","    .sort_values(\"RepetitionSeed\")\n","    .reset_index(drop=True)\n",")\n","\n","rf_5pct_build_results = (\n","    pd.concat(\n","        rf_5pct_build_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"RepetitionSeed\",\n","            \"build_order\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","rf_5pct_ranking_results = (\n","    pd.concat(\n","        rf_5pct_ranking_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"RepetitionSeed\",\n","            \"build_order\",\n","            \"RF_Rank\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","rf_5pct_noise_summary = (\n","    pd.DataFrame(\n","        rf_5pct_noise_summary_records\n","    )\n","    .sort_values(\"NoiseSeed\")\n","    .reset_index(drop=True)\n",")\n","\n","rf_5pct_noise_audit = (\n","    pd.concat(\n","        rf_5pct_noise_audit_frames,\n","        ignore_index=True,\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# COMPLETE-RUN VALIDATION\n","# ---------------------------------------------------------\n","\n","if len(rf_5pct_project_results) != 30:\n","    raise ValueError(\n","        \"Expected 30 project-level rows.\"\n","    )\n","\n","if len(rf_5pct_build_results) != 30 * 28:\n","    raise ValueError(\n","        \"Expected 840 build-level rows.\"\n","    )\n","\n","if len(rf_5pct_ranking_results) != 30 * 702:\n","    raise ValueError(\n","        \"Expected 21,060 ranking rows.\"\n","    )\n","\n","if len(rf_5pct_noise_summary) != 30:\n","    raise ValueError(\n","        \"Expected 30 noise-audit summaries.\"\n","    )\n","\n","if (\n","    rf_5pct_project_results[\n","        \"RepetitionSeed\"\n","    ].nunique()\n","    != 30\n","):\n","    raise ValueError(\n","        \"Repetition seeds are incomplete.\"\n","    )\n","\n","if not rf_5pct_project_results[\n","    [\"MeanAPFD\", \"MeanAPFDc\"]\n","].apply(\n","    lambda column: column.between(0, 1)\n",").all().all():\n","    raise ValueError(\n","        \"A project-level metric is outside [0, 1].\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# PAIRED 0% VS 5% RESULTS\n","# ---------------------------------------------------------\n","\n","rf_clean_paired = (\n","    rf_0pct_project_results[\n","        [\n","            \"RepetitionSeed\",\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","        ]\n","    ]\n","    .rename(\n","        columns={\n","            \"MeanAPFD\": \"MeanAPFD_0pct\",\n","            \"MeanAPFDc\": \"MeanAPFDc_0pct\",\n","        }\n","    )\n",")\n","\n","rf_5pct_paired = (\n","    rf_5pct_project_results[\n","        [\n","            \"RepetitionSeed\",\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","        ]\n","    ]\n","    .rename(\n","        columns={\n","            \"MeanAPFD\": \"MeanAPFD_5pct\",\n","            \"MeanAPFDc\": \"MeanAPFDc_5pct\",\n","        }\n","    )\n",")\n","\n","rf_0_vs_5_paired = (\n","    rf_clean_paired\n","    .merge(\n","        rf_5pct_paired,\n","        on=\"RepetitionSeed\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","rf_0_vs_5_paired[\n","    \"APFD_Difference_5minus0\"\n","] = (\n","    rf_0_vs_5_paired[\n","        \"MeanAPFD_5pct\"\n","    ]\n","    -\n","    rf_0_vs_5_paired[\n","        \"MeanAPFD_0pct\"\n","    ]\n",")\n","\n","rf_0_vs_5_paired[\n","    \"APFDc_Difference_5minus0\"\n","] = (\n","    rf_0_vs_5_paired[\n","        \"MeanAPFDc_5pct\"\n","    ]\n","    -\n","    rf_0_vs_5_paired[\n","        \"MeanAPFDc_0pct\"\n","    ]\n",")\n","\n","rf_0_vs_5_paired[\n","    \"APFD_Retention\"\n","] = (\n","    rf_0_vs_5_paired[\n","        \"MeanAPFD_5pct\"\n","    ]\n","    /\n","    rf_0_vs_5_paired[\n","        \"MeanAPFD_0pct\"\n","    ]\n",")\n","\n","rf_0_vs_5_paired[\n","    \"APFDc_Retention\"\n","] = (\n","    rf_0_vs_5_paired[\n","        \"MeanAPFDc_5pct\"\n","    ]\n","    /\n","    rf_0_vs_5_paired[\n","        \"MeanAPFDc_0pct\"\n","    ]\n",")\n","\n","\n","# ---------------------------------------------------------\n","# SAVE RESULTS\n","# ---------------------------------------------------------\n","\n","results_directory = Path(\n","    \"/content/formal_results\"\n",")\n","\n","results_directory.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","rf_5pct_project_path = (\n","    results_directory\n","    / \"angel_rf_5pct_project_level.csv\"\n",")\n","\n","rf_5pct_build_path = (\n","    results_directory\n","    / \"angel_rf_5pct_build_level.csv\"\n",")\n","\n","rf_5pct_ranking_path = (\n","    results_directory\n","    / \"angel_rf_5pct_rankings.csv.gz\"\n",")\n","\n","rf_5pct_noise_summary_path = (\n","    results_directory\n","    / \"angel_rf_5pct_noise_summary.csv\"\n",")\n","\n","rf_5pct_noise_audit_path = (\n","    results_directory\n","    / \"angel_rf_5pct_noise_audit.csv.gz\"\n",")\n","\n","rf_0_vs_5_path = (\n","    results_directory\n","    / \"angel_rf_0pct_vs_5pct_paired.csv\"\n",")\n","\n","\n","rf_5pct_project_results.to_csv(\n","    rf_5pct_project_path,\n","    index=False,\n",")\n","\n","rf_5pct_build_results.to_csv(\n","    rf_5pct_build_path,\n","    index=False,\n",")\n","\n","rf_5pct_ranking_results.to_csv(\n","    rf_5pct_ranking_path,\n","    index=False,\n","    compression=\"gzip\",\n",")\n","\n","rf_5pct_noise_summary.to_csv(\n","    rf_5pct_noise_summary_path,\n","    index=False,\n",")\n","\n","rf_5pct_noise_audit.to_csv(\n","    rf_5pct_noise_audit_path,\n","    index=False,\n","    compression=\"gzip\",\n",")\n","\n","rf_0_vs_5_paired.to_csv(\n","    rf_0_vs_5_path,\n","    index=False,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# DISPLAY FINAL 5% RESULTS\n","# ---------------------------------------------------------\n","\n","print(\"\\n=== 5% FORMAL-RUN VALIDATION ===\")\n","\n","print(\n","    \"Project-level rows:\",\n","    len(rf_5pct_project_results)\n",")\n","\n","print(\n","    \"Build-level rows:\",\n","    len(rf_5pct_build_results)\n",")\n","\n","print(\n","    \"Ranking rows:\",\n","    len(rf_5pct_ranking_results)\n",")\n","\n","print(\n","    \"Noise-summary rows:\",\n","    len(rf_5pct_noise_summary)\n",")\n","\n","print(\n","    \"Unique seeds:\",\n","    rf_5pct_project_results[\n","        \"RepetitionSeed\"\n","    ].nunique()\n",")\n","\n","print(\n","    \"Total runtime:\",\n","    round(rf_5pct_total_runtime, 2),\n","    \"seconds\"\n",")\n","\n","\n","print(\"\\n=== 5% PERFORMAN