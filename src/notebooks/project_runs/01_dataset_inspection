=========================================\n","\n","from pathlib import Path\n","import hashlib\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","import pyarrow.parquet as pq\n","from IPython.display import display\n","\n","\n","print(\"=== AIRAVATA COMPLETE 30-SEED AUDIT ===\")\n","\n","\n","# ---------------------------------------------------------\n","# 1. SAFETY AND EXPECTED STRUCTURE\n","# ---------------------------------------------------------\n","\n","if PROJECT_NAME != \"apache@airavata\":\n","    raise RuntimeError(\n","        \"The current project is not apache@airavata. \"\n","        f\"Current project: {PROJECT_NAME}\"\n","    )\n","\n","\n","EXPECTED_SEEDS = list(range(1, 31))\n","\n","EXPECTED_NOISE_LEVELS = [\n","    0, 5, 10, 15, 20, 25, 30, 40, 50\n","]\n","\n","EXPECTED_TECHNIQUES = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","    \"LatestFail\",\n","    \"Random\",\n","    \"QTF-Avg\",\n","}\n","\n","EXPECTED_ML_TECHNIQUES = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","}\n","\n","ML_TECHNIQUES_FINAL = [\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","]\n","\n","EXPECTED_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","    \"rankings.parquet\",\n","]\n","\n","\n","EXPECTED_CONDITIONS = (\n","    len(EXPECTED_SEEDS)\n","    * len(EXPECTED_NOISE_LEVELS)\n",")\n","\n","EXPECTED_PROJECT_RUN_ROWS = (\n","    EXPECTED_CONDITIONS\n","    * len(EXPECTED_TECHNIQUES)\n",")\n","\n","EXPECTED_MANIFEST_ROWS = len(\n","    clean_training_history\n",")\n","\n","EXPECTED_EVALUATION_ROWS = len(\n","    clean_evaluation_data\n",")\n","\n","EXPECTED_EVALUATION_BUILDS = int(\n","    clean_evaluation_data[\n","        \"Build\"\n","    ].nunique()\n",")\n","\n","EXPECTED_RANKING_ROWS = (\n","    EXPECTED_EVALUATION_ROWS\n","    * len(EXPECTED_TECHNIQUES)\n",")\n","\n","EXPECTED_BUILD_METRIC_ROWS = (\n","    EXPECTED_EVALUATION_BUILDS\n","    * len(EXPECTED_TECHNIQUES)\n",")\n","\n","EXPECTED_PROJECT_METRIC_ROWS = 7\n","EXPECTED_FIT_ROWS = 4\n","EXPECTED_NESTED_COMPARISONS = 30 * 8\n","\n","\n","FINAL_OUTPUT_DIRECTORY = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n","    / \"airavata_30_seed_final\"\n",")\n","\n","FINAL_OUTPUT_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. HELPER FUNCTIONS\n","# ---------------------------------------------------------\n","\n","def parquet_row_count(path):\n","    return int(\n","        pq.ParquetFile(path)\n","        .metadata\n","        .num_rows\n","    )\n","\n","\n","def deterministic_integer_seed(*parts):\n","    text = \"|\".join(\n","        str(part)\n","        for part in parts\n","    )\n","\n","    digest = hashlib.sha256(\n","        text.encode(\"utf-8\")\n","    ).digest()\n","\n","    return int.from_bytes(\n","        digest[:8],\n","        byteorder=\"little\",\n","        signed=False,\n","    ) % (2 ** 32)\n","\n","\n","def bootstrap_mean_ci(\n","    values,\n","    random_seed,\n","    repetitions=10000,\n","):\n","    \"\"\"\n","    Percentile-bootstrap 95% CI for the mean\n","    across the 30 repetitions.\n","    \"\"\"\n","\n","    values = np.asarray(\n","        values,\n","        dtype=float,\n","    )\n","\n","    values = values[\n","        np.isfinite(values)\n","    ]\n","\n","    if len(values) == 0:\n","        return np.nan, np.nan\n","\n","    if len(values) == 1:\n","        return (\n","            float(values[0]),\n","            float(values[0]),\n","        )\n","\n","    rng = np.random.default_rng(\n","        random_seed\n","    )\n","\n","    sampled_indices = rng.integers(\n","        low=0,\n","        high=len(values),\n","        size=(\n","            repetitions,\n","            len(values),\n","        ),\n","    )\n","\n","    bootstrap_means = (\n","        values[sampled_indices]\n","        .mean(axis=1)\n","    )\n","\n","    lower, upper = np.percentile(\n","        bootstrap_means,\n","        [2.5, 97.5],\n","    )\n","\n","    return (\n","        float(lower),\n","        float(upper),\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. AUDIT ALL 270 CONDITIONS\n","# ---------------------------------------------------------\n","\n","condition_records = []\n","nested_mask_records = []\n","project_run_frames = []\n","\n","all_uniform_streams_match = True\n","\n","\n","for repetition_seed in EXPECTED_SEEDS:\n","\n","    manifests_for_seed = {}\n","\n","    for noise_percent in EXPECTED_NOISE_LEVELS:\n","\n","        condition_directory = (\n","            PROJECT_RAW_RESULTS\n","            / f\"noise_{noise_percent:03d}\"\n","            / f\"seed_{repetition_seed:02d}\"\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # Required files\n","        # -------------------------------------------------\n","\n","        missing_files = [\n","            file_name\n","            for file_name in EXPECTED_FILES\n","            if not (\n","                condition_directory\n","                / file_name\n","            ).exists()\n","        ]\n","\n","        if missing_files:\n","            raise FileNotFoundError(\n","                f\"Seed {repetition_seed}, \"\n","                f\"noise {noise_percent}% is missing:\\n\"\n","                + \"\\n\".join(missing_files)\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # Completion metadata\n","        # -------------------------------------------------\n","\n","        with open(\n","            condition_directory\n","            / \"_SUCCESS.json\",\n","            \"r\",\n","            encoding=\"utf-8\",\n","        ) as marker_file:\n","\n","            success_metadata = json.load(\n","                marker_file\n","            )\n","\n","\n","        assert success_metadata[\n","            \"CompletedSuccessfully\"\n","        ] is True\n","\n","        assert success_metadata[\n","            \"EvaluationHashUnchanged\"\n","        ] is True\n","\n","        assert int(\n","            success_metadata[\n","                \"TechniqueCount\"\n","            ]\n","        ) == 7\n","\n","        assert int(\n","            success_metadata[\n","                \"EvaluatedBuilds\"\n","            ]\n","        ) == EXPECTED_EVALUATION_BUILDS\n","\n","        assert int(\n","            success_metadata[\n","                \"RankingRows\"\n","            ]\n","        ) == EXPECTED_RANKING_ROWS\n","\n","        assert int(\n","            success_metadata[\n","                \"BuildMetricRows\"\n","            ]\n","        ) == EXPECTED_BUILD_METRIC_ROWS\n","\n","\n","        # -------------------------------------------------\n","        # Parquet row counts\n","        # -------------------------------------------------\n","\n","        manifest_rows = parquet_row_count(\n","            condition_directory\n","            / \"noise_manifest.parquet\"\n","        )\n","\n","        ranking_rows = parquet_row_count(\n","            condition_directory\n","            / \"rankings.parquet\"\n","        )\n","\n","        build_metric_rows = parquet_row_count(\n","            condition_directory\n","            / \"build_metrics.parquet\"\n","        )\n","\n","\n","        assert (\n","            manifest_rows\n","            == EXPECTED_MANIFEST_ROWS\n","        )\n","\n","        assert (\n","            ranking_rows\n","            == EXPECTED_RANKING_ROWS\n","        )\n","\n","        assert (\n","            build_metric_rows\n","            == EXPECTED_BUILD_METRIC_ROWS\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # Small output files\n","        # -------------------------------------------------\n","\n","        project_run_metrics = pd.read_csv(\n","            condition_directory\n","            / \"project_run_metrics.csv\"\n","        )\n","\n","        fit_times = pd.read_csv(\n","            condition_directory\n","            / \"fit_times.csv\"\n","        )\n","\n","        noise_summary = pd.read_csv(\n","            condition_directory\n","            / \"noise_summary.csv\"\n","        )\n","\n","\n","        assert (\n","            len(project_run_metrics)\n","            == EXPECTED_PROJECT_METRIC_ROWS\n","        )\n","\n","        assert (\n","            len(fit_times)\n","            == EXPECTED_FIT_ROWS\n","        )\n","\n","        assert len(noise_summary) == 1\n","\n","        assert set(\n","            project_run_metrics[\n","                \"Technique\"\n","            ]\n","        ) == EXPECTED_TECHNIQUES\n","\n","        assert set(\n","            fit_times[\"Technique\"]\n","        ) == EXPECTED_ML_TECHNIQUES\n","\n","        assert (\n","            project_run_metrics[\n","                \"EvaluatedBuilds\"\n","            ] == EXPECTED_EVALUATION_BUILDS\n","        ).all()\n","\n","        assert (\n","            project_run_metrics[\n","                [\n","                    \"MeanAPFD\",\n","                    \"MeanAPFDc\",\n","                ]\n","            ]\n","            .notna()\n","            .all()\n","            .all()\n","        )\n","\n","        assert (\n","            project_run_metrics[\n","                \"MeanAPFD\"\n","            ]\n","            .between(\n","                0,\n","                1,\n","                inclusive=\"both\",\n","            )\n","            .all()\n","        )\n","\n","        assert (\n","            project_run_metrics[\n","                \"MeanAPFDc\"\n","            ]\n","            .between(\n","                0,\n","                1,\n","                inclusive=\"both\",\n","            )\n","            .all()\n","        )\n","\n","\n","        project_run_metrics[\n","            \"NoisePercent\"\n","        ] = float(noise_percent)\n","\n","        project_run_metrics[\n","            \"RepetitionSeed\"\n","        ] = int(repetition_seed)\n","\n","        project_run_metrics[\n","            \"Project\"\n","        ] = PROJECT_NAME\n","\n","\n","        project_run_frames.append(\n","            project_run_metrics\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # Noise manifest\n","        # -------------------------------------------------\n","\n","        manifest = pd.read_parquet(\n","            condition_directory\n","            / \"noise_manifest.parquet\",\n","            columns=[\n","                \"NoiseRowID\",\n","                \"Build\",\n","                \"Test\",\n","                \"OriginalVerdict\",\n","                \"NoisyVerdict\",\n","                \"FlipUniform\",\n","                \"Flipped\",\n","                \"PassToFailure\",\n","                \"FailureToPass\",\n","            ],\n","        )\n","\n","        manifest = (\n","            manifest\n","            .sort_values(\"NoiseRowID\")\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        actual_changes = (\n","            manifest[\"OriginalVerdict\"]\n","            != manifest[\"NoisyVerdict\"]\n","        )\n","\n","        assert np.array_equal(\n","            actual_changes.to_numpy(),\n","            manifest[\n","                \"Flipped\"\n","            ].to_numpy(),\n","        )\n","\n","\n","        flipped_count = int(\n","            manifest[\n","                \"Flipped\"\n","            ].sum()\n","        )\n","\n","        pass_to_failure = int(\n","            manifest[\n","                \"PassToFailure\"\n","            ].sum()\n","        )\n","\n","        failure_to_pass = int(\n","            manifest[\n","                \"FailureToPass\"\n","            ].sum()\n","        )\n","\n","\n","        assert (\n","            pass_to_failure\n","            + failure_to_pass\n","        ) == flipped_count\n","\n","        assert flipped_count == int(\n","            noise_summary[\n","                \"NumberFlipped\"\n","            ].iloc[0]\n","        )\n","\n","\n","        realised_noise = float(\n","            noise_summary[\n","                \"RealisedNoisePercent\"\n","            ].iloc[0]\n","        )\n","\n","        calculated_realised_noise = (\n","            100.0\n","            * flipped_count\n","            / EXPECTED_MANIFEST_ROWS\n","        )\n","\n","        assert np.isclose(\n","            realised_noise,\n","            calculated_realised_noise,\n","            atol=1e-12,\n","            rtol=0,\n","        )\n","\n","\n","        if noise_percent == 0:\n","            assert flipped_count == 0\n","\n","\n","        evaluation_builds_in_manifest = len(\n","            set(\n","                manifest[\n","                    \"Build\"\n","                ].astype(int)\n","            ).intersection(\n","                evaluation_build_ids\n","            )\n","        )\n","\n","        assert (\n","            evaluation_builds_in_manifest\n","            == 0\n","        )\n","\n","\n","        manifests_for_seed[\n","            noise_percent\n","        ] = manifest\n","\n","\n","        condition_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"RepetitionSeed\":\n","                repetition_seed,\n","\n","            \"NoisePercent\":\n","                noise_percent,\n","\n","            \"RealisedNoisePercent\":\n","                realised_noise,\n","\n","            \"NumberFlipped\":\n","                flipped_count,\n","\n","            \"PassToFailure\":\n","                pass_to_failure,\n","\n","            \"FailureToPass\":\n","                failure_to_pass,\n","\n","            \"ManifestRows\":\n","                manifest_rows,\n","\n","            \"RankingRows\":\n","                ranking_rows,\n","\n","            \"BuildMetricRows\":\n","                build_metric_rows,\n","\n","            \"ProjectRunRows\":\n","                len(project_run_metrics),\n","\n","            \"MLFitRows\":\n","                len(fit_times),\n","\n","            \"EvaluatedBuilds\":\n","                EXPECTED_EVALUATION_BUILDS,\n","\n","            \"EvaluationBuildsInManifest\":\n","                evaluation_builds_in_manifest,\n","\n","            \"Status\":\n","                \"SUCCESS\",\n","        })\n","\n","\n","    # -----------------------------------------------------\n","    # Verify the nine-level ladder for this seed\n","    # -----------------------------------------------------\n","\n","    reference_manifest = (\n","        manifests_for_seed[0]\n","    )\n","\n","    assert int(\n","        reference_manifest[\n","            \"Flipped\"\n","        ].sum()\n","    ) == 0\n","\n","\n","    for noise_percent in EXPECTED_NOISE_LEVELS:\n","\n","        current_manifest = (\n","            manifests_for_seed[\n","                noise_percent\n","            ]\n","        )\n","\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"NoiseRowID\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"NoiseRowID\"\n","            ].to_numpy(),\n","        )\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"Build\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"Build\"\n","            ].to_numpy(),\n","        )\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"Test\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"Test\"\n","            ].to_numpy(),\n","        )\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"OriginalVerdict\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"OriginalVerdict\"\n","            ].to_numpy(),\n","        )\n","\n","\n","        uniform_stream_matches = (\n","            np.array_equal(\n","                reference_manifest[\n","                    \"FlipUniform\"\n","                ].to_numpy(),\n","                current_manifest[\n","                    \"FlipUniform\"\n","                ].to_numpy(),\n","            )\n","        )\n","\n","\n","        if not uniform_stream_matches:\n","            all_uniform_streams_match = False\n","\n","        assert uniform_stream_matches\n","\n","\n","    # -----------------------------------------------------\n","    # Adjacent nested-mask checks\n","    # -----------------------------------------------------\n","\n","    for lower_noise, higher_noise in zip(\n","        EXPECTED_NOISE_LEVELS[:-1],\n","        EXPECTED_NOISE_LEVELS[1:],\n","    ):\n","\n","        lower_manifest = (\n","            manifests_for_seed[\n","                lower_noise\n","            ]\n","        )\n","\n","        higher_manifest = (\n","            manifests_for_seed[\n","                higher_noise\n","            ]\n","        )\n","\n","\n","        lower_mask = (\n","            lower_manifest[\n","                \"Flipped\"\n","            ]\n","            .astype(bool)\n","            .to_numpy()\n","        )\n","\n","        higher_mask = (\n","            higher_manifest[\n","                \"Flipped\"\n","            ]\n","            .astype(bool)\n","            .to_numpy()\n","        )\n","\n","\n","        nested_violations = int(\n","            (\n","                lower_mask\n","                \u0026 ~higher_mask\n","            ).sum()\n","        )\n","\n","        additional_flips = int(\n","            (\n","                higher_mask\n","                \u0026 ~lower_mask\n","            ).sum()\n","        )\n","\n","        lower_flips = int(\n","            lower_mask.sum()\n","        )\n","\n","        higher_flips = int(\n","            higher_mask.sum()\n","        )\n","\n","\n","        assert nested_violations == 0\n","\n","        assert higher_flips == (\n","            lower_flips\n","            + additional_flips\n","        )\n","\n","\n","        nested_mask_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"RepetitionSeed\":\n","                repetition_seed,\n","\n","            \"LowerNoise\":\n","                lower_noise,\n","\n","            \"HigherNoise\":\n","                higher_noise,\n","\n","            \"LowerFlips\":\n","                lower_flips,\n","\n","            \"HigherFlips\":\n","                higher_flips,\n","\n","            \"AdditionalFlips\":\n","                additional_flips,\n","\n","            \"NestedViolations\":\n","                nested_violations,\n","        })\n","\n","\n","# ---------------------------------------------------------\n","# 4. COMBINE AND CHECK GLOBAL COMPLETENESS\n","# ---------------------------------------------------------\n","\n","condition_audit = pd.DataFrame(\n","    condition_records\n",")\n","\n","nested_mask_audit = pd.DataFrame(\n","    nested_mask_records\n",")\n","\n","all_project_runs = pd.concat(\n","    project_run_frames,\n","    ignore_index=True,\n",")\n","\n","\n","assert (\n","    len(condition_audit)\n","    == EXPECTED_CONDITIONS\n",")\n","\n","assert (\n","    len(all_project_runs)\n","    == EXPECTED_PROJECT_RUN_ROWS\n",")\n","\n","assert (\n","    len(nested_mask_audit)\n","    == EXPECTED_NESTED_COMPARISONS\n",")\n","\n","\n","assert condition_audit[\n","    [\n","        \"RepetitionSeed\",\n","        \"NoisePercent\",\n","    ]\n","].duplicated().sum() == 0\n","\n","\n","assert all_project_runs[\n","    [\n","        \"RepetitionSeed\",\n","        \"NoisePercent\",\n","        \"Technique\",\n","    ]\n","].duplicated().sum() == 0\n","\n","\n","assert int(\n","    nested_mask_audit[\n","        \"NestedViolations\"\n","    ].sum()\n",") == 0\n","\n","\n","assert condition_audit[\n","    \"Status\"\n","].eq(\"SUCCESS\").all()\n","\n","\n","# ---------------------------------------------------------\n","# 5. VERIFY NOISE-INDEPENDENT BASELINES\n","# ---------------------------------------------------------\n","\n","for repetition_seed in EXPECTED_SEEDS:\n","\n","    for technique in [\n","        \"Random\",\n","        \"QTF-Avg\",\n","    ]:\n","\n","        rows = (\n","            all_project_runs[\n","                (\n","                    all_project_runs[\n","                        \"RepetitionSeed\"\n","                    ] == repetition_seed\n","                )\n","                \u0026\n","                (\n","                    all_project_runs[\n","                        \"Technique\"\n","                    ] == technique\n","                )\n","            ]\n","            .sort_values(\n","                \"NoisePercent\"\n","            )\n","        )\n","\n","\n","        assert len(rows) == 9\n","\n","\n","        assert np.allclose(\n","            rows[\n","                \"MeanAPFD\"\n","            ].to_numpy(),\n","            rows[\n","                \"MeanAPFD\"\n","            ].iloc[0],\n","            atol=1e-12,\n","            rtol=0,\n","        )\n","\n","        assert np.allclose(\n","            rows[\n","                \"MeanAPFDc\"\n","            ].to_numpy(),\n","            rows[\n","                \"MeanAPFDc\"\n","            ].iloc[0],\n","            atol=1e-12,\n","            rtol=0,\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 6. PAIRED CLEAN REFERENCE FOR EACH SEED\n","# --------------------------------