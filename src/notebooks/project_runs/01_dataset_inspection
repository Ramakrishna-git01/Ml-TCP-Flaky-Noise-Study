lay_data"}],"source":["# =========================================================\n","# PROJECT 3 — CORRECTED PROJECT SELECTION\n","# =========================================================\n","\n","import pandas as pd\n","\n","\n","PROJECT_COLUMN = \"Project\"\n","ELIGIBILITY_COLUMN = \"EligibleForPilot\"\n","\n","\n","if PROJECT_COLUMN not in screening.columns:\n","    raise RuntimeError(\n","        f\"Missing column: {PROJECT_COLUMN}\"\n","    )\n","\n","if ELIGIBILITY_COLUMN not in screening.columns:\n","    raise RuntimeError(\n","        f\"Missing column: {ELIGIBILITY_COLUMN}\"\n","    )\n","\n","\n","# Handle Boolean, numeric, or text eligibility values.\n","eligibility_values = screening[\n","    ELIGIBILITY_COLUMN\n","]\n","\n","if pd.api.types.is_bool_dtype(\n","    eligibility_values\n","):\n","    eligible_mask = (\n","        eligibility_values\n","        .fillna(False)\n","    )\n","\n","elif pd.api.types.is_numeric_dtype(\n","    eligibility_values\n","):\n","    eligible_mask = (\n","        eligibility_values\n","        .fillna(0)\n","        .astype(int)\n","        .eq(1)\n","    )\n","\n","else:\n","    eligible_mask = (\n","        eligibility_values\n","        .astype(str)\n","        .str.strip()\n","        .str.lower()\n","        .isin([\n","            \"true\",\n","            \"1\",\n","            \"yes\",\n","            \"eligible\",\n","        ])\n","    )\n","\n","\n","# Preserve the order used in the screening file.\n","eligible_projects = (\n","    screening.loc[\n","        eligible_mask,\n","        PROJECT_COLUMN,\n","    ]\n","    .astype(str)\n","    .tolist()\n",")\n","\n","\n","completed_projects = {\n","    \"Angel-ML@angel\",\n","    \"apache@airavata\",\n","}\n","\n","explicitly_excluded_projects = {\n","    \"Graylog2@graylog2-server\",\n","}\n","\n","\n","remaining_projects = [\n","    project\n","    for project in eligible_projects\n","    if project not in completed_projects\n","    and project not in explicitly_excluded_projects\n","]\n","\n","\n","print(\"=== PROJECT 3 SELECTION ===\")\n","\n","print(\n","    \"Eligible projects:\",\n","    len(eligible_projects),\n",")\n","\n","print(\n","    \"Completed projects:\",\n","    len(completed_projects),\n",")\n","\n","print(\n","    \"Remaining eligible projects:\",\n","    len(remaining_projects),\n",")\n","\n","\n","print(\"\\nRemaining projects in screening order:\")\n","\n","for position, project in enumerate(\n","    remaining_projects,\n","    start=1,\n","):\n","    print(\n","        f\"{position:02d}. {project}\"\n","    )\n","\n","\n","if not remaining_projects:\n","    raise RuntimeError(\n","        \"No remaining eligible projects were found.\"\n","    )\n","\n","\n","PROJECT_3_CANDIDATE = (\n","    remaining_projects[0]\n",")\n","\n","print(\"\\nSelected Project 3:\")\n","print(PROJECT_3_CANDIDATE)\n","\n","\n","# Show its screening characteristics.\n","project_3_screening = (\n","    screening[\n","        screening[PROJECT_COLUMN]\n","        == PROJECT_3_CANDIDATE\n","    ]\n","    .copy()\n",")\n","\n","print(\"\\nProject 3 screening row:\")\n","\n","display(\n","    project_3_screening\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":24913,"status":"ok","timestamp":1784896115440,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"kHYnpLZvGNBu","outputId":"148a1c85-21c0-407f-d595-dc3c61408748"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== EXTRACTING TCP-CI DATASET ===\n","Archive: /content/drive/MyDrive/Thesis_Experiment/Data/Raw/TCP-CI-main-dataset.tar.gz\n","Destination: /content/working_data/tcp_ci_full\n","\n","=== EXTRACTION VERIFICATION ===\n","Projects extracted: 25\n","Snow Owl folders found: 1\n","\n","Selected Project 3:\n","b2ihealthcare@snow-owl\n","\n","Project path:\n","/content/working_data/tcp_ci_full/datasets/b2ihealthcare@snow-owl\n","\n","Required project files:\n"," - builds.csv OK\n"," - exe.csv OK\n"," - dataset.csv OK\n"," - entity_change_history.csv OK\n"," - id_map.csv OK\n"," - contributors.csv OK\n","\n","SUCCESS: TCP-CI was extracted and Project 3 Snow Owl is ready.\n"]}],"source":["# =========================================================\n","# PROJECT 3 — EXTRACT TCP-CI AND VERIFY SNOW OWL\n","# =========================================================\n","\n","from pathlib import Path\n","import shutil\n","import subprocess\n","\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","DRIVE_ARCHIVE = (\n","    THESIS_DRIVE\n","    / \"Data/Raw/TCP-CI-main-dataset.tar.gz\"\n",")\n","\n","EXTRACT_ROOT = Path(\n","    \"/content/working_data/tcp_ci_full\"\n",")\n","\n","PROJECT_NAME = \"b2ihealthcare@snow-owl\"\n","\n","\n","# ---------------------------------------------------------\n","# 1. Validate archive\n","# ---------------------------------------------------------\n","\n","if not DRIVE_ARCHIVE.exists():\n","    raise FileNotFoundError(\n","        f\"TCP-CI archive was not found:\\n{DRIVE_ARCHIVE}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Remove any incomplete temporary extraction\n","# ---------------------------------------------------------\n","\n","if EXTRACT_ROOT.exists():\n","    shutil.rmtree(EXTRACT_ROOT)\n","\n","EXTRACT_ROOT.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Extract archive\n","# ---------------------------------------------------------\n","\n","print(\"=== EXTRACTING TCP-CI DATASET ===\")\n","print(\"Archive:\", DRIVE_ARCHIVE)\n","print(\"Destination:\", EXTRACT_ROOT)\n","\n","subprocess.run(\n","    [\n","        \"tar\",\n","        \"-xzf\",\n","        str(DRIVE_ARCHIVE),\n","        \"-C\",\n","        str(EXTRACT_ROOT),\n","    ],\n","    check=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Verify all project folders\n","# ---------------------------------------------------------\n","\n","project_folders = sorted({\n","    dataset_file.parent\n","    for dataset_file\n","    in EXTRACT_ROOT.rglob(\"dataset.csv\")\n","})\n","\n","project_matches = [\n","    folder\n","    for folder in project_folders\n","    if folder.name == PROJECT_NAME\n","]\n","\n","\n","print(\"\\n=== EXTRACTION VERIFICATION ===\")\n","\n","print(\n","    \"Projects extracted:\",\n","    len(project_folders),\n",")\n","\n","print(\n","    \"Snow Owl folders found:\",\n","    len(project_matches),\n",")\n","\n","\n","if len(project_folders) != 25:\n","    raise RuntimeError(\n","        \"Expected 25 extracted TCP-CI projects, \"\n","        f\"but found {len(project_folders)}.\"\n","    )\n","\n","if len(project_matches) != 1:\n","    raise RuntimeError(\n","        f\"Expected one {PROJECT_NAME} folder, \"\n","        f\"but found {len(project_matches)}.\"\n","    )\n","\n","\n","PROJECT_PATH = project_matches[0]\n","\n","print(\"\\nSelected Project 3:\")\n","print(PROJECT_NAME)\n","\n","print(\"\\nProject path:\")\n","print(PROJECT_PATH)\n","\n","\n","required_files = [\n","    \"builds.csv\",\n","    \"exe.csv\",\n","    \"dataset.csv\",\n","    \"entity_change_history.csv\",\n","    \"id_map.csv\",\n","    \"contributors.csv\",\n","]\n","\n","missing_files = [\n","    file_name\n","    for file_name in required_files\n","    if not (\n","        PROJECT_PATH / file_name\n","    ).exists()\n","]\n","\n","if missing_files:\n","    raise FileNotFoundError(\n","        \"Snow Owl is missing required files:\\n\"\n","        + \"\\n\".join(missing_files)\n","    )\n","\n","\n","print(\"\\nRequired project files:\")\n","for file_name in required_files:\n","    print(\n","        \" -\",\n","        file_name,\n","        \"OK\"\n","    )\n","\n","\n","print(\n","    \"\\nSUCCESS: TCP-CI was extracted and \"\n","    \"Project 3 Snow Owl is ready.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":863,"status":"ok","timestamp":1784896296038,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"HbX7L0fgG-xP","outputId":"f0c91a75-4c8d-4c78-b0a5-1e554f7a7a8f"},"outputs":[{"name":"stdout","output_type":"stream","text":["Project: b2ihealthcare@snow-owl\n","Path: /content/working_data/tcp_ci_full/datasets/b2ihealthcare@snow-owl\n","\n","=== SNOW OWL INITIALISATION COMPLETE ===\n","\n","Raw file shapes:\n","builds.csv: (277, 4)\n","exe.csv: (13056, 5)\n","dataset.csv: (2430, 154)\n","entity_change_history.csv: (211426, 8)\n","id_map.csv: (34357, 2)\n","contributors.csv: (36, 4)\n","\n","Chronological split:\n","Training-period builds: 207\n","Evaluation-period builds: 70\n","\n","Raw execution partitions:\n","Training execution rows: 9812\n","Evaluation execution rows: 3244\n","\n","Model-ready partitions:\n","Training rows: 1849\n","Training model-ready builds: 43\n","Evaluation rows: 581\n","Scored evaluation builds: 15\n","\n","Binary outcomes:\n","Training passes: 1749\n","Training failures: 100\n","Evaluation passes: 566\n","Evaluation failures: 15\n","\n","Features:\n","Predictor columns: 150\n","REC feature columns: 19\n","\n","Split boundary:\n","Last training build: 680888373 order: 207\n","First evaluation build: 680888379 order: 208\n","\n","SUCCESS: Snow Owl is loaded and chronologically split.\n"]}],"source":["# =========================================================\n","# PROJECT 3: SNOW OWL — LOAD AND INITIALISE\n","# =========================================================\n","\n","from pathlib import Path\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","PROJECT_NAME = \"b2ihealthcare@snow-owl\"\n","\n","EXTRACT_ROOT = Path(\n","    \"/content/working_data/tcp_ci_full\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 1. Locate the project\n","# ---------------------------------------------------------\n","\n","project_matches = [\n","    path\n","    for path in EXTRACT_ROOT.rglob(PROJECT_NAME)\n","    if path.is_dir()\n","]\n","\n","if len(project_matches) != 1:\n","    raise RuntimeError(\n","        f\"Expected exactly one {PROJECT_NAME} folder, \"\n","        f\"but found {len(project_matches)}.\"\n","    )\n","\n","PROJECT_PATH = project_matches[0]\n","\n","print(\"Project:\", PROJECT_NAME)\n","print(\"Path:\", PROJECT_PATH)\n","\n","\n","# ---------------------------------------------------------\n","# 2. Load the six TCP-CI project files\n","# ---------------------------------------------------------\n","\n","builds = pd.read_csv(\n","    PROJECT_PATH / \"builds.csv\"\n",")\n","\n","exe = pd.read_csv(\n","    PROJECT_PATH / \"exe.csv\"\n",")\n","\n","dataset = pd.read_csv(\n","    PROJECT_PATH / \"dataset.csv\"\n",")\n","\n","entity_change_history = pd.read_csv(\n","    PROJECT_PATH / \"entity_change_history.csv\"\n",")\n","\n","id_map = pd.read_csv(\n","    PROJECT_PATH / \"id_map.csv\"\n",")\n","\n","contributors = pd.read_csv(\n","    PROJECT_PATH / \"contributors.csv\"\n",")\n","\n","\n","# Compatibility variables used by later reconstruction code.\n","builds_checked = builds.copy()\n","entity_change = entity_change_history.copy()\n","\n","\n","# ---------------------------------------------------------\n","# 3. Create chronological build order\n","# ---------------------------------------------------------\n","\n","builds_checked[\"id\"] = pd.to_numeric(\n","    builds_checked[\"id\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","builds_checked[\"started_at\"] = pd.to_datetime(\n","    builds_checked[\"started_at\"],\n","    errors=\"raise\",\n","    utc=True,\n",")\n","\n","builds_checked = (\n","    builds_checked\n","    .sort_values(\n","        [\"started_at\", \"id\"]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","builds_checked[\"build_order\"] = np.arange(\n","    1,\n","    len(builds_checked) + 1,\n",")\n","\n","builds = builds_checked.copy()\n","\n","\n","# ---------------------------------------------------------\n","# 4. Fixed chronological 75/25 split\n","# ---------------------------------------------------------\n","\n","split_index = int(\n","    np.floor(\n","        len(builds_checked) * 0.75\n","    )\n",")\n","\n","training_build_table = (\n","    builds_checked\n","    .iloc[:split_index]\n","    .copy()\n",")\n","\n","evaluation_build_table = (\n","    builds_checked\n","    .iloc[split_index:]\n","    .copy()\n",")\n","\n","training_build_ids = set(\n","    training_build_table[\"id\"].astype(int)\n",")\n","\n","evaluation_build_ids = set(\n","    evaluation_build_table[\"id\"].astype(int)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Add build order to raw execution history\n","# ---------------------------------------------------------\n","\n","build_order_map = (\n","    builds_checked\n","    .set_index(\"id\")[\"build_order\"]\n","    .to_dict()\n",")\n","\n","exe[\"build\"] = pd.to_numeric(\n","    exe[\"build\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","exe_for_rec = exe.copy()\n","\n","exe_for_rec[\"build_order\"] = (\n","    exe_for_rec[\"build\"]\n","    .map(build_order_map)\n",")\n","\n","if exe_for_rec[\"build_order\"].isna().any():\n","    missing_count = int(\n","        exe_for_rec[\"build_order\"].isna().sum()\n","    )\n","\n","    raise ValueError(\n","        f\"{missing_count} execution rows could not \"\n","        \"be mapped to build order.\"\n","    )\n","\n","sort_columns = [\n","    column\n","    for column in [\n","        \"build_order\",\n","        \"job\",\n","        \"test\",\n","    ]\n","    if column in exe_for_rec.columns\n","]\n","\n","exe_for_rec = (\n","    exe_for_rec\n","    .sort_values(sort_columns)\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Add build order to model-ready dataset\n","# ---------------------------------------------------------\n","\n","dataset[\"Build\"] = pd.to_numeric(\n","    dataset[\"Build\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","dataset_with_order = dataset.copy()\n","\n","dataset_with_order[\"build_order\"] = (\n","    dataset_with_order[\"Build\"]\n","    .map(build_order_map)\n",")\n","\n","if dataset_with_order[\"build_order\"].isna().any():\n","    missing_count = int(\n","        dataset_with_order[\n","            \"build_order\"\n","        ].isna().sum()\n","    )\n","\n","    raise ValueError(\n","        f\"{missing_count} model-ready rows could not \"\n","        \"be mapped to build order.\"\n","    )\n","\n","dataset_with_order = (\n","    dataset_with_order\n","    .sort_values(\n","        [\"build_order\", \"Test\"]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 7. Create clean training and evaluation partitions\n","# ---------------------------------------------------------\n","\n","clean_training_data = (\n","    dataset_with_order[\n","        dataset_with_order[\"Build\"].isin(\n","            training_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","clean_evaluation_data = (\n","    dataset_with_order[\n","        dataset_with_order[\"Build\"].isin(\n","            evaluation_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Identify model and REC feature columns\n","# ---------------------------------------------------------\n","\n","REC_FEATURE_COLUMNS = [\n","    column\n","    for column in dataset.columns\n","    if column.startswith(\"REC_\")\n","]\n","\n","MODEL_FEATURE_COLUMNS = [\n","    column\n","    fo