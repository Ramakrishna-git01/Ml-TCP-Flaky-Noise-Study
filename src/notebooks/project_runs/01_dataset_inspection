.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","\n","    \u003c/div\u003e\n","  \u003c/div\u003e\n"],"text/plain":["                                          Example  DirectProposalAPFD  \\\n","0   Two failures ranked first; long failure first                 0.8   \n","1  Two failures ranked first; quick failure first                 0.8   \n","2               Failures ranked second and fourth                 0.5   \n","\n","   ExperimentHelperAPFD  APFDMatch  DirectProposalAPFDc  \\\n","0                   0.8       True             0.555556   \n","1                   0.8       True             0.777778   \n","2                   0.5       True             0.388889   \n","\n","   ExperimentHelperAPFDc  APFDcMatch  \n","0               0.555556        True  \n","1               0.777778        True  \n","2               0.388889        True  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Saved files:\n","/content/drive/MyDrive/Thesis_Experiment/Notes/methodology_checkpoint_fixed_holdout_v1.json\n","/content/drive/MyDrive/Thesis_Experiment/Notes/methodology_checkpoint_fixed_holdout_v1.md\n","/content/drive/MyDrive/Thesis_Experiment/Notes/apfd_apfdc_formula_audit_v1.csv\n","/content/drive/MyDrive/Thesis_Experiment/Notes/apfd_apfdc_formula_audit_v1.json\n","\n","SUCCESS: methodology decisions are frozen and the APFD/APFDc implementations match the independent proposal-formula calculations.\n"]}],"source":["# =========================================================\n","# THESIS — FREEZE METHODOLOGY AND AUDIT APFD/APFDC FORMULAS\n","# =========================================================\n","\n","from datetime import datetime, timezone\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","print(\"=== METHODOLOGY FREEZE AND METRIC AUDIT ===\")\n","\n","\n","# ---------------------------------------------------------\n","# 1. CHECK REQUIRED ENVIRONMENT\n","# ---------------------------------------------------------\n","\n","if not callable(globals().get(\"calculate_apfd\")):\n","    raise RuntimeError(\n","        \"calculate_apfd is not available in the runtime.\"\n","    )\n","\n","if not callable(globals().get(\"calculate_apfdc\")):\n","    raise RuntimeError(\n","        \"calculate_apfdc is not available in the runtime.\"\n","    )\n","\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE / \"Notes\"\n",")\n","\n","NOTES_DRIVE.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","FREEZE_TIMESTAMP = datetime.now(\n","    timezone.utc\n",").isoformat()\n","\n","\n","# ---------------------------------------------------------\n","# 2. FREEZE THE METHODOLOGICAL DECISIONS\n","# ---------------------------------------------------------\n","\n","methodology_checkpoint = {\n","    \"CheckpointName\":\n","        \"ML-TCP methodology freeze v1\",\n","\n","    \"FrozenAtUTC\":\n","        FREEZE_TIMESTAMP,\n","\n","    \"Dataset\":\n","        \"TCP-CI\",\n","\n","    \"BuildOrdering\":\n","        \"Chronological using build timestamp and build ID\",\n","\n","    \"SplitProtocol\": {\n","        \"Type\":\n","            \"Fixed chronological holdout\",\n","\n","        \"TrainingPartition\":\n","            \"First 75% of chronological builds\",\n","\n","        \"EvaluationPartition\":\n","            \"Final 25% of chronological builds\",\n","\n","        \"ModelTrainingRule\":\n","            (\n","                \"For every project × noise level × \"\n","                \"repetition seed, each supervised ML model \"\n","                \"is fitted once using the corresponding \"\n","                \"training partition.\"\n","            ),\n","\n","        \"ModelEvaluationRule\":\n","            (\n","                \"The fitted model ranks all eligible \"\n","                \"model-ready tests in the clean evaluation \"\n","                \"partition without retraining before each \"\n","                \"evaluation build.\"\n","            ),\n","\n","        \"RollingRetrainingUsed\":\n","            False,\n","\n","        \"ReasonForFreezing\":\n","            (\n","                \"The approved proposal specifies a \"\n","                \"chronological 75/25 split but does not \"\n","                \"explicitly require per-build rolling \"\n","                \"retraining. The experiment therefore uses \"\n","                \"a reproducible fixed-holdout interpretation.\"\n","            ),\n","    },\n","\n","    \"EvaluationProtocol\": {\n","        \"TrainingVerdicts\":\n","            (\n","                \"Training verdicts are corrupted according \"\n","                \"to the selected synthetic noise level.\"\n","            ),\n","\n","        \"EvaluationVerdicts\":\n","            \"Always remain clean and unchanged\",\n","\n","        \"RankingUnit\":\n","            \"One individual clean evaluation build\",\n","\n","        \"MLRankingRule\":\n","            (\n","                \"Tests are ranked by descending predicted \"\n","                \"failure probability.\"\n","            ),\n","\n","        \"TieRule\":\n","            \"Test identifier ascending\",\n","\n","        \"MetricsCalculatedAfterRanking\":\n","            [\n","                \"APFDc\",\n","                \"APFD\",\n","            ],\n","    },\n","\n","    \"FailureMappingAssumption\": {\n","        \"Problem\":\n","            (\n","                \"TCP-CI provides test execution verdicts but \"\n","                \"does not provide mappings from failing tests \"\n","                \"to distinct underlying software fault IDs.\"\n","            ),\n","\n","        \"OperationalDefinition\":\n","            (\n","                \"Each failing test execution in an eligible \"\n","                \"evaluation build is treated as one distinct \"\n","                \"fault-detection event for APFD and APFDc.\"\n","            ),\n","\n","        \"NumberOfFaultEvents_m\":\n","            (\n","                \"The number of failing tests in the \"\n","                \"evaluation build.\"\n","            ),\n","\n","        \"DetectionPosition_TFi\":\n","            (\n","                \"The one-based rank of failing test i in the \"\n","                \"prioritised test order.\"\n","            ),\n","\n","        \"InterpretationWarning\":\n","            (\n","                \"Reported APFD and APFDc are test-failure-\"\n","                \"event effectiveness measures rather than \"\n","                \"strict underlying-fault-level measures.\"\n","            ),\n","    },\n","\n","    \"PrimaryMetric\":\n","        \"APFDc\",\n","\n","    \"SecondaryMetric\":\n","        \"APFD\",\n","\n","    \"ProtocolChangeRule\":\n","        (\n","            \"A later change to fixed holdout, failure \"\n","            \"mapping, ranking rules, or metric formulas \"\n","            \"requires documenting a new protocol version \"\n","            \"and rerunning all affected projects.\"\n","        ),\n","\n","    \"Status\":\n","        \"FROZEN_FOR_REMAINING_PROJECTS\",\n","}\n","\n","\n","# ---------------------------------------------------------\n","# 3. INDEPENDENT PROPOSAL-FORMULA IMPLEMENTATIONS\n","# ---------------------------------------------------------\n","\n","def proposal_apfd_formula(\n","    actual_failures,\n","):\n","    \"\"\"\n","    APFD = 1 - sum(TF_i)/(n*m) + 1/(2*n)\n","\n","    In this experiment, every failing test is treated as one\n","    fault-detection event.\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    n = len(failures)\n","    m = int(failures.sum())\n","\n","    if n == 0 or m == 0:\n","        return np.nan\n","\n","    failure_ranks = (\n","        np.flatnonzero(failures == 1)\n","        + 1\n","    )\n","\n","    return float(\n","        1.0\n","        - failure_ranks.sum() / (n * m)\n","        + 1.0 / (2.0 * n)\n","    )\n","\n","\n","def proposal_apfdc_formula(\n","    actual_failures,\n","    durations,\n","):\n","    \"\"\"\n","    APFDc =\n","        sum_i(\n","            sum_{j=TF_i}^{n} t_j\n","            - 0.5 * t_{TF_i}\n","        )\n","        /\n","        (\n","            m * sum_j(t_j)\n","        )\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    durations = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","    if len(failures) != len(durations):\n","        raise ValueError(\n","            \"Failure and duration arrays differ in length.\"\n","        )\n","\n","    n = len(failures)\n","    m = int(failures.sum())\n","\n","    if n == 0 or m == 0:\n","        return np.nan\n","\n","    if not np.isfinite(durations).all():\n","        raise ValueError(\n","            \"Durations contain missing or infinite values.\"\n","        )\n","\n","    if (durations \u003c 0).any():\n","        raise ValueError(\n","            \"Durations cannot be negative.\"\n","        )\n","\n","    total_duration = float(\n","        durations.sum()\n","    )\n","\n","    if total_duration \u003c= 0:\n","        return np.nan\n","\n","    failure_ranks_zero_based = (\n","        np.flatnonzero(failures == 1)\n","    )\n","\n","    numerator = 0.0\n","\n","    for failure_position in failure_ranks_zero_based:\n","\n","        remaining_duration = float(\n","            durations[\n","                failure_position:\n","            ].sum()\n","        )\n","\n","        failing_test_duration = float(\n","            durations[\n","                failure_position\n","            ]\n","        )\n","\n","        numerator += (\n","            remaining_duration\n","            - 0.5 * failing_test_duration\n","        )\n","\n","    denominator = (\n","        m * total_duration\n","    )\n","\n","    return float(\n","        numerator / denominator\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. MANUAL AUDIT EXAMPLES\n","# ---------------------------------------------------------\n","\n","audit_examples = [\n","    {\n","        \"Example\":\n","            \"Two failures ranked first; long failure first\",\n","\n","        \"ActualFailures\":\n","            [1, 1, 0, 0, 0],\n","\n","        \"Durations\":\n","            [5, 1, 1, 1, 1],\n","\n","        \"ExpectedAPFD\":\n","            0.80,\n","\n","        \"ExpectedAPFDc\":\n","            5.0 / 9.0,\n","    },\n","\n","    {\n","        \"Example\":\n","            \"Two failures ranked first; quick failure first\",\n","\n","        \"ActualFailures\":\n","            [1, 1, 0, 0, 0],\n","\n","        \"Durations\":\n","            [1, 5, 1, 1, 1],\n","\n","        \"ExpectedAPFD\":\n","            0.80,\n","\n","        \"ExpectedAPFDc\":\n","            7.0 / 9.0,\n","    },\n","\n","    {\n","        \"Example\":\n","            \"Failures ranked second and fourth\",\n","\n","        \"ActualFailures\":\n","            [0, 1, 0, 1, 0],\n","\n","        \"Durations\":\n","            [1, 5, 1, 1, 1],\n","\n","        \"ExpectedAPFD\":\n","            0.50,\n","\n","        \"ExpectedAPFDc\":\n","            None,\n","    },\n","]\n","\n","\n","audit_records = []\n","\n","\n","for example in audit_examples:\n","\n","    failures = example[\n","        \"ActualFailures\"\n","    ]\n","\n","    durations = example[\n","        \"Durations\"\n","    ]\n","\n","\n","    direct_apfd = proposal_apfd_formula(\n","        failures\n","    )\n","\n","    helper_apfd = calculate_apfd(\n","        failures\n","    )\n","\n","\n","    direct_apfdc = proposal_apfdc_formula(\n","        failures,\n","        durations,\n","    )\n","\n","    helper_apfdc = calculate_apfdc(\n","        failures,\n","        durations,\n","    )\n","\n","\n","    apfd_match = bool(\n","        np.isclose(\n","            direct_apfd,\n","            helper_apfd,\n","            rtol=0,\n","            atol=1e-12,\n","        )\n","    )\n","\n","    apfdc_match = bool(\n","        np.isclose(\n","            direct_apfdc,\n","            helper_apfdc,\n","            rtol=0,\n","            atol=1e-12,\n","        )\n","    )\n","\n","\n","    if not apfd_match:\n","        raise AssertionError(\n","            f\"APFD mismatch for: {example['Example']}\"\n","        )\n","\n","    if not apfdc_match:\n","        raise AssertionError(\n","            f\"APFDc mismatch for: {example['Example']}\"\n","        )\n","\n","\n","    expected_apfd = example[\n","        \"ExpectedAPFD\"\n","    ]\n","\n","    if expected_apfd is not None:\n","\n","        if not np.isclose(\n","            helper_apfd,\n","            expected_apfd,\n","            rtol=0,\n","            atol=1e-12,\n","        ):\n","            raise AssertionError(\n","                \"APFD did not match the expected \"\n","                f\"value for: {example['Example']}\"\n","            )\n","\n","\n","    expected_apfdc = example[\n","        \"ExpectedAPFDc\"\n","    ]\n","\n","    if expected_apfdc is not None:\n","\n","        if not np.isclose(\n","            helper_apfdc,\n","            expected_apfdc,\n","            rtol=0,\n","            atol=1e-12,\n","        ):\n","            raise AssertionError(\n","                \"APFDc did not match the expected \"\n","                f\"value for: {example['Example']}\"\n","            )\n","\n","\n","    audit_records.append({\n","        \"Example\":\n","            example[\"Example\"],\n","\n","        \"ActualFailures\":\n","            str(failures),\n","\n","        \"Durations\":\n","            str(durations),\n","\n","        \"NumberOfTests_n\":\n","            len(failures),\n","\n","        \"NumberOfFailureEvents_m\":\n","            int(np.sum(failures)),\n","\n","        \"DirectProposalAPFD\":\n","            direct_apfd,\n","\n","        \"ExperimentHelperAPFD\":\n","            helper_apfd,\n","\n","        \"APFDMatch\":\n","            apfd_match,\n","\n","        \"DirectProposalAPFDc\":\n","            direct_apfdc,\n","\n","        \"ExperimentHelperAPFDc\":\n","            helper_apfdc,\n","\n","        \"APFDcMatch\":\n","            apfdc_match,\n","    })\n","\n","\n","metric_audit = pd.DataFrame(\n","    audit_records\n",")\n","\n","\n","assert metric_audit[\n","    \"APFDMatch\"\n","].all()\n","\n","assert metric_audit[\n","    \"APFDcMatch\"\n","].all()\n","\n","\n","# ---------------------------------------------------------\n","# 5. SAVE PERMANENT CHECKPOINT FILES\n","# ---------------------------------------------------------\n","\n","checkpoint_json_path = (\n","    NOTES_DRIVE\n","    / \"methodology_checkpoint_fixed_holdout_v1.json\"\n",")\n","\n","checkpoint_markdown_path = (\n","    NOTES_DRIVE\n","    / \"methodology_checkpoint_fixed_holdout_v1.md\"\n",")\n","\n","metric_audit_csv_path = (\n","    NOTES_DRIVE\n","    / \"apfd_apfdc_formula_audit_v1.csv\"\n",")\n","\n","metric_audit_json_path = (\n","    NOTES_DRIVE\n","    / \"apfd_apfdc_formula_audit_v1.json\"\n",")\n","\n","\n","with open(\n","    checkpoint_json_path,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as checkpoint_file:\n","\n","    json.dump(\n","        methodology_checkpoint,\n","        checkpoint_file,\n","        indent=2,\n","    )\n","\n","\n","checkpoint_markdown = f\"\"\"\n","# ML-TCP Methodology Checkpoint — Fixed Holdout v1\n","\n","Frozen at: `{FREEZE_TIMESTAMP}`\n","\n","## Dataset\n","\n","TCP-CI.\n","\n","## Chronological split\n","\n","Builds are ordered chronologically. The first 75% of builds\n","form the training period and the final 25% form the clean\n","evaluation period.\n","\n","For every project × noise level × seed, each supervised ML\n","model is trained once and is then used to rank all eligible\n","tests in the final 25% evaluation partition. The ML model is\n","not retrained before each evaluation build.\n","\n","## Test case prioritisation\n","\n","For each clean evaluation build, the ML models rank tests in\n","descending predicted probability of failure. Ties are resolved\n","using the test identifier in ascending order.\n","\n","The clean current-build verdict is not used to generate the\n","ranking. It is revealed only after ranking for metric\n","calculation.\n","\n","## APFD/APFDc failure-event assumption\n","\n","TCP-CI contains test verdicts but does not provide mappings\n","between failing tests and distinct underlying software faults.\n","\n","Therefore, each failing test execution in an eligible\n","evaluation build is treated as one distinct fault-detection\n","event:\n","\n","- `m` is the number of failing tests in the build.\n","- `TF_i` is the one-based rank of failing test `i`.\n","\n","The resulting APFD and APFDc values must be described as\n","test-failure-event effectiveness measures rather than strict\n","underlying-fault-level effectiveness measures.\n","\n","## Metrics\n","\n","APFDc is the primary metric. APFD is secondary.\n","\n","Both metrics are calculated after the test ranking has been\n","created and are evaluated against clean evaluation verdicts.\n","\n","## Change control\n","\n","Changing the fixed-holdout design, failure-event mapping,\n","ranking rule, or metric formula requires a new protocol version\n","and a rerun of every affected project.\n","\"\"\".strip()\n","\n","\n","with open(\n","    checkpoint_markdown_path,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as markdown_file:\n","\n","    markdown_file.write(\n","        checkpoint_markdown\n","    )\n","\n","\n","metric_audit.to_csv(\n","    metric_audit_csv_path,\n","    index=False,\n",")\n","\n","\n","with open(\n","    metric_audit_json_path,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as audit_file:\n","\n","    json.dump(\n","        {\n","            \"AuditName\":\n","                \"APFD and APFDc formula audit v1\",\n","\n","            \"CompletedAtUTC\":\n","                FREEZE_TIMESTAMP,\n","\n","            \"FailureMapping\":\n","                (\n","                    \"Each failing test is treated as one \"\n","                    \"fault-detection event.\"\n","                ),\n","\n","            \"AllAPFDComparisonsPassed\":\n","                bool(\n","                    metric_audit[\n","                        \"APFDMatch\"\n","                    ].all()\n","                ),\n","\n","            \"AllAPFDcComparisonsPassed\":\n","                bool(\n","                    metric_audit[\n","                        \"APFDcMatch\"\n","                    ].all()\n","                ),\n","\n","            \"Examples\":\n","                audit_records,\n","        },\n","        audit_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. FINAL VERIFICATION\n","# ---------------------------------------------------------\n","\n","saved_files = [\n","    checkpoint_json_path,\n","    checkpoint_markdown_path,\n","    metric_audit_csv_path,\n","    metric_audit_json_path,\n","]\n","\n","\n","for saved_file in saved_files:\n","\n","    if not saved_file.exists():\n","        raise FileNotFoundError(\n","            f\"Expected file was not saved: {saved_file}\"\n","        )\n","\n","\n","print(\"\\n=== FROZEN METHODOLOGY ===\")\n","\n","print(\n","    \"Dataset:\",\n","    methodology_checkpoint[\"Dataset\"],\n",")\n","\n","print(\n","    \"Split:\",\n","    methodology_checkpoint[\n","        \"SplitProtocol\"\n","    ][\"Type\"],\n",")\n","\n","print(\n","    \"Rolling retraining:\",\n","    methodology_checkpoint[\n","        \"SplitProtocol\"\n","    ][\"RollingRetrainingUsed\"],\n",")\n","\n","print(\n","    \"Failure mapping:\",\n","    methodology_checkpoint[\n","        \"FailureMappingAssumption\"\n","    ][\"OperationalDefinition\"],\n",")\n","\n","print(\n","    \"Status:\",\n","    methodology_checkpoint[\"Status\"],\n",")\n","\n","\n","print(\"\\n=== FORMULA AUDIT ===\")\n","\n","display(\n","    metric_audit[\n","        [\n","            \"Example\",\n","            \"DirectProposalAPFD\",\n","            \"ExperimentHelperAPFD\",\n","            \"APFDMatch\",\n","            \"DirectProposalAPFDc\",\n","            \"ExperimentHelperAPFDc\",\n","            \"APFDcMatch\",\n","        ]\n","    ]\n",")\n","\n","\n","print(\"\\nSaved files:\")\n","\n","for saved_file in saved_files:\n","    print(saved_file)\n","\n","\n","print(\n","    \"\\nSUCCESS: methodology decisions are frozen \"\n","    \"and the APFD/APFDc implementations match the \"\n","    \"independent proposal-formula calculations.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":720},"executionInfo":{"elapsed":96,"status":"ok","timestamp":1784895855209,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"pQhrcdGBFUQ7","outputId":"733c3ceb-1dd2-4da2-de42-04562b0a68b3"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== PROJECT 3 SELECTION ===\n","Eligible projects: 24\n","Completed projects: 2\n","Remaining eligible projects: 22\n","\n","Remaining projects in screening order:\n","01. b2ihealthcare@snow-owl\n","02. eclipse@paho.mqtt.java\n","03. thinkaurelius@titan\n","04. eclipse@jetty.project\n","05. CompEvol@beast2\n","06. optimatika@ojAlgo\n","07. spring-cloud@spring-cloud-dataflow\n","08. eclipse@steady\n","09. yamcs@Yamcs\n","10. EMResearch@EvoMaster\n","11. apache@curator\n","12. cantaloupe-project@cantaloupe\n","13. zolyfarkas@spf4j\n","14. apache@rocketmq\n","15. jcabi@jcabi-github\n","16. apache@logging-log4j2\n","17. apache@sling\n","18. camunda@camunda-bpm-platform\n","19. facebook@buc