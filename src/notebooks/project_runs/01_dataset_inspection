 columns]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","SUCCESS: Project 3 is frozen and Project 4 is selected.\n"]}],"source":["# =========================================================\n","# FREEZE PROJECT 3 AND SELECT PROJECT 4\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import pandas as pd\n","\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE / \"Notes\"\n",")\n","\n","FINAL_SNOW_OWL_DIRECTORY = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n","    / \"b2ihealthcare__snow-owl\"\n","    / \"snow_owl_30_seed_final\"\n",")\n","\n","FINAL_REPORT_PATH = (\n","    FINAL_SNOW_OWL_DIRECTORY\n","    / \"snow_owl_final_audit_report.json\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 1. Verify Project 3 final report\n","# ---------------------------------------------------------\n","\n","if not FINAL_REPORT_PATH.exists():\n","    raise FileNotFoundError(\n","        \"Snow Owl final audit report was not found:\\n\"\n","        f\"{FINAL_REPORT_PATH}\"\n","    )\n","\n","with open(\n","    FINAL_REPORT_PATH,\n","    \"r\",\n","    encoding=\"utf-8\",\n",") as report_file:\n","    snow_owl_final_report = json.load(\n","        report_file\n","    )\n","\n","\n","if snow_owl_final_report.get(\n","    \"Status\"\n",") != \"PASS\":\n","    raise AssertionError(\n","        \"Snow Owl final report is not marked PASS.\"\n","    )\n","\n","if int(\n","    snow_owl_final_report.get(\n","        \"ConditionsAudited\",\n","        -1,\n","    )\n",") != 270:\n","    raise AssertionError(\n","        \"Snow Owl does not contain 270 audited conditions.\"\n","    )\n","\n","if int(\n","    snow_owl_final_report.get(\n","        \"NestedMaskViolations\",\n","        -1,\n","    )\n",") != 0:\n","    raise 