ach build's # separated commit list\n","# ---------------------------------------------------------\n","\n","build_commit_map = (\n","    builds_checked[\n","        [\n","            \"id\",\n","            \"commits\",\n","            \"started_at\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","build_commit_map[\"Commit\"] = (\n","    build_commit_map[\"commits\"]\n","    .fillna(\"\")\n","    .astype(str)\n","    .str.split(\"#\")\n",")\n","\n","\n","build_commit_map = (\n","    build_commit_map\n","    .explode(\n","        \"Commit\",\n","        ignore_index=True,\n","    )\n",")\n","\n","\n","build_commit_map[\"Commit\"] = (\n","    build_commit_map[\"Commit\"]\n","    .astype(str)\n","    .str.strip()\n","    .str.lower()\n",")\n","\n","\n","build_commit_map = (\n","    build_commit_map[\n","        ~build_commit_map[\"Commit\"].isin(\n","            [\n","                \"\",\n","                \"nan\",\n","                \"none\",\n","                \"null\",\n","            ]\n","        )\n","    ]\n","    .drop_duplicates(\n","        [\n","            \"id\",\n","            \"Commit\",\n","        ]\n","    )\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"Commit\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","duplicate_build_commit_pairs = int(\n","    build_commit_map\n","    .duplicated(\n","        [\n","            \"id\",\n","            \"Commit\",\n","        ]\n","    )\n","    .sum()\n",")\n","\n","\n","if duplicate_build_commit_pairs != 0:\n","    raise AssertionError(\n","        \"Duplicate build/commit pairs remain.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Determine whether build commits occur in the\n","#    entity-change history\n","# ---------------------------------------------------------\n","\n","known_entity_commits = set(\n","    entity_commit_pairs[\n","        \"Commit\"\n","    ]\n",")\n","\n","\n","build_commit_map[\n","    \"CommitMatched\"\n","] = (\n","    build_commit_map[\n","        \"Commit\"\n","    ].isin(\n","        known_entity_commits\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Join builds to changed entities\n","# ---------------------------------------------------------\n","\n","build_entity_map = (\n","    build_commit_map\n","    .merge(\n","        entity_commit_pairs,\n","        on=\"Commit\",\n","        how=\"left\",\n","        validate=\"many_to_many\",\n","    )\n",")\n","\n","\n","build_entity_map[\n","    \"EntityMatched\"\n","] = (\n","    build_entity_map[\n","        \"EntityId\"\n","    ].notna()\n",")\n","\n","\n","build_entity_map = (\n","    build_entity_map\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"Commit\",\n","            \"EntityId\",\n","        ],\n","        kind=\"mergesort\",\n","        na_position=\"last\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Validate entity IDs against id_map.csv\n","# ---------------------------------------------------------\n","\n","known_entity_ids = set(\n","    pd.to_numeric(\n","        id_map[\"value\"],\n","        errors=\"raise\",\n","    ).astype(int)\n",")\n","\n","\n","mapped_entity_ids = set(\n","    build_entity_map.loc[\n","        build_entity_map[\n","            \"EntityId\"\n","        ].notna(),\n","        \"EntityId\",\n","    ]\n","    .astype(int)\n",")\n","\n","\n","unknown_mapped_entity_ids = (\n","    mapped_entity_ids\n","    - known_entity_ids\n",")\n","\n","\n","if unknown_mapped_entity_ids:\n","    raise AssertionError(\n","        \"Mapped EntityId values absent from id_map.csv: \"\n","        f\"{len(unknown_mapped_entity_ids)}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Create changed-entity sets for every build\n","# ---------------------------------------------------------\n","\n","changed_entities_by_build = {\n","    int(build_id): set()\n","    for build_id\n","    in builds_checked[\"id\"]\n","}\n","\n","\n","mapped_rows = (\n","    build_entity_map[\n","        build_entity_map[\n","            \"EntityId\"\n","        ].notna()\n","    ][\n","        [\n","            \"id\",\n","            \"EntityId\",\n","        ]\n","    ]\n","    .drop_duplicates()\n",")\n","\n","\n","for build_id, group in mapped_rows.groupby(\n","    \"id\",\n","    sort=False,\n","):\n","\n","    changed_entities_by_build[\n","        int(build_id)\n","    ] = set(\n","        group[\n","            \"EntityId\"\n","        ]\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","\n","if len(\n","    changed_entities_by_build\n",") != len(builds_checked):\n","    raise AssertionError(\n","        \"changed_entities_by_build does not contain \"\n","        \"every project build.\"\n","    )\n","\n","\n","if set(\n","    changed_entities_by_build\n",") != set(\n","    builds_checked[\"id\"].astype(int)\n","):\n","    raise AssertionError(\n","        \"Changed-entity build IDs do not match \"\n","        \"builds.csv.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Create one summary row per build\n","# ---------------------------------------------------------\n","\n","commit_counts = (\n","    build_commit_map\n","    .groupby(\n","        \"id\"\n","    )\n","    .agg(\n","        BuildCommitCount=(\n","            \"Commit\",\n","            \"nunique\",\n","        ),\n","        MatchedCommitCount=(\n","            \"CommitMatched\",\n","            \"sum\",\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","\n","entity_counts = (\n","    mapped_rows\n","    .groupby(\n","        \"id\"\n","    )\n","    .agg(\n","        ChangedEntityCount=(\n","            \"EntityId\",\n","            \"nunique\",\n","        )\n","    )\n","    .reset_index()\n",")\n","\n","\n","build_mapping_summary = (\n","    builds_checked[\n","        [\n","            \"id\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .merge(\n","        commit_counts,\n","        on=\"id\",\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","    .merge(\n","        entity_counts,\n","        on=\"id\",\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","    .sort_values(\n","        \"build_order\"\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","for count_column in [\n","    \"BuildCommitCount\",\n","    \"MatchedCommitCount\",\n","    \"ChangedEntityCount\",\n","]:\n","\n","    build_mapping_summary[\n","        count_column\n","    ] = (\n","        build_mapping_summary[\n","            count_column\n","        ]\n","        .fillna(0)\n","        .astype(int)\n","    )\n","\n","\n","build_mapping_summary[\n","    \"HasMatchedCommit\"\n","] = (\n","    build_mapping_summary[\n","        \"MatchedCommitCount\"\n","    ] \u003e 0\n",")\n","\n","\n","build_mapping_summary[\n","    \"HasChangedEntity\"\n","] = (\n","    build_mapping_summary[\n","        \"ChangedEntityCount\"\n","    ] \u003e 0\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 9. Coverage counts\n","# ---------------------------------------------------------\n","\n","builds_without_parsed_commits = int(\n","    (\n","        build_mapping_summary[\n","            \"BuildCommitCount\"\n","        ] == 0\n","    ).sum()\n",")\n","\n","\n","builds_without_matched_commits = int(\n","    (\n","        ~build_mapping_summary[\n","            \"HasMatchedCommit\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","builds_without_changed_entities = int(\n","    (\n","        ~build_mapping_summary[\n","            \"HasChangedEntity\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","unmatched_build_commit_pairs = int(\n","    (\n","        ~build_commit_map[\n","            \"CommitMatched\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 10. Final integrity checks\n","# ---------------------------------------------------------\n","\n","if len(\n","    build_mapping_summary\n",") != len(builds_checked):\n","    raise AssertionError(\n","        \"Expected one mapping-summary row per build.\"\n","    )\n","\n","\n","if duplicate_build_commit_pairs != 0:\n","    raise AssertionError(\n","        \"Duplicate build/commit pairs remain.\"\n","    )\n","\n","\n","if len(\n","    unknown_mapped_entity_ids\n",") != 0:\n","    raise AssertionError(\n","        \"Unknown entity IDs remain.\"\n","    )\n","\n","\n","# No strict exclusion is applied here merely because a\n","# project build has no mapped entity. Any such count must\n","# instead be reported and investigated.\n","mapping_status = (\n","    \"COMPLETE_COVERAGE\"\n","    if (\n","        builds_without_parsed_commits == 0\n","        and builds_without_matched_commits == 0\n","        and builds_without_changed_entities == 0\n","        and unmatched_build_commit_pairs == 0\n","    )\n","    else \"REQUIRES_REVIEW\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 11. Output\n","# ---------------------------------------------------------\n","\n","print(\"\\nMapping shapes:\")\n","\n","print(\n","    \"build_commit_map:\",\n","    build_commit_map.shape,\n",")\n","\n","print(\n","    \"build_entity_map:\",\n","    build_entity_map.shape,\n",")\n","\n","print(\n","    \"build_mapping_summary:\",\n","    build_mapping_summary.shape,\n",")\n","\n","print(\n","    \"changed_entities_by_build:\",\n","    len(changed_entities_by_build),\n",")\n","\n","\n","print(\"\\nCommit mapping:\")\n","\n","print(\n","    \"Unique build/commit pairs:\",\n","    len(build_commit_map),\n",")\n","\n","print(\n","    \"Unique commits in builds:\",\n","    build_commit_map[\n","        \"Commit\"\n","    ].nunique(),\n",")\n","\n","print(\n","    \"Matched build/commit pairs:\",\n","    int(\n","        build_commit_map[\n","            \"CommitMatched\"\n","        ].sum()\n","    ),\n",")\n","\n","print(\n","    \"Unmatched build/commit pairs:\",\n","    unmatched_build_commit_pairs,\n",")\n","\n","\n","print(\"\\nEntity mapping:\")\n","\n","print(\n","    \"Unique mapped entities:\",\n","    len(mapped_entity_ids),\n",")\n","\n","print(\n","    \"Mapped build/entity pairs:\",\n","    len(mapped_rows),\n",")\n","\n","print(\n","    \"Unknown mapped entity IDs:\",\n","    len(unknown_mapped_entity_ids),\n",")\n","\n","\n","print(\"\\nBuild coverage:\")\n","\n","print(\n","    \"Builds with no parsed commits:\",\n","    builds_without_parsed_commits,\n",")\n","\n","print(\n","    \"Builds with no matched commits:\",\n","    builds_without_matched_commits,\n",")\n","\n","print(\n","    \"Builds with no changed entities:\",\n","    builds_without_changed_entities,\n",")\n","\n","print(\n","    \"Mapping status:\",\n","    mapping_status,\n",")\n","\n","\n","print(\"\\nFirst ten mapping-summary rows:\")\n","\n","display(\n","    build_mapping_summary.head(10)\n",")\n","\n","\n","print(\n","    \"\\nSUCCESS: Paho MQTT build–commit–entity \"\n","    \"mapping was created and audited.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":929},"executionInfo":{"elapsed":438,"status":"ok","timestamp":1784906439073,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"NgrsJ01GtrWB","outputId":"63e2d7bd-83dd-4523-98ee-c19ded58e33d"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== PAHO MQTT UNMATCHED-MAPPING DIAGNOSTIC ===\n","Unmatched build/commit pairs: 3\n","Affected builds: 3\n","Distinct unmatched commits: 2\n","\n","Affected build details