000  338.000000  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","=== PAIRED 0% VS 10% SUMMARY ===\n","Mean clean APFD: 0.8537279105098654\n","Mean 10% APFD: 0.56268607490412\n","Mean paired APFD difference: -0.2910418356057453\n","Mean APFD retention: 0.6590938962272479\n","\n","Mean clean APFDc: 0.8648870556210881\n","Mean 10% APFDc: 0.5778403687710356\n","Mean paired APFDc difference: -0.28704668685005236\n","Mean APFDc retention: 0.6688727744833758\n","\n","Seeds where 10% APFDc exceeded clean: 0\n","Seeds where 10% APFDc was below clean: 30\n","\n","=== PAIRED 5% VS 10% SUMMARY ===\n","Mean 5% APFDc: 0.6511873069373771\n","Mean 10% APFDc: 0.5778403687710356\n","Mean APFDc difference, 10% minus 5%: -0.07334693816634118\n","Seeds where 10% APFDc exceeded 5%: 9\n","Seeds where 10% APFDc was below 5%: 21\n","\n","=== SAVED FILES ===\n","/content/formal_results/angel_rf_10pct_project_level.csv\n","/content/formal_results/angel_rf_10pct_build_level.csv\n","/content/formal_results/angel_rf_10pct_rankings.csv.gz\n","/content/formal_results/angel_rf_10pct_noise_summary.csv\n","/content/formal_results/angel_rf_10pct_noise_audit.csv.gz\n","/content/formal_results/angel_rf_0pct_vs_10pct_paired.csv\n","/content/formal_results/angel_rf_5pct_vs_10pct_paired.csv\n","/content/formal_results/angel_rf_10pct_configuration.json\n"]}],"source":["# ---------------------------------------------------------\n","# FORMAL RANDOM FOREST EXPERIMENT:\n","# 30 REPETITIONS AT 10% TRAINING NOISE\n","# ---------------------------------------------------------\n","\n","from pathlib import Path\n","import gc\n","import json\n","import time\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","RF_10PCT_NOISE_PROBABILITY = 0.10\n","RF_10PCT_NOISE_LEVEL = 10\n","RF_10PCT_SEEDS = list(range(1, 31))\n","\n","\n","# ---------------------------------------------------------\n","# RESULT CONTAINERS\n","# ---------------------------------------------------------\n","\n","rf_10pct_project_records = []\n","rf_10pct_build_frames = []\n","rf_10pct_ranking_frames = []\n","rf_10pct_noise_summary_records = []\n","rf_10pct_noise_audit_frames = []\n","\n","\n","experiment_start = time.perf_counter()\n","\n","print(\n","    \"Starting 30 formal Random Forest \"\n","    \"repetitions at 10% noise...\\n\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# RUN SEEDS 1–30\n","# ---------------------------------------------------------\n","\n","for repetition_seed in RF_10PCT_SEEDS:\n","\n","    seed_total_start = time.perf_counter()\n","\n","    # -----------------------------------------------------\n","    # CREATE THIS SEED'S CORRUPTED TRAINING DATA\n","    # -----------------------------------------------------\n","\n","    (\n","        noisy_training_data,\n","        noisy_execution_history,\n","        noise_audit,\n","        noise_summary,\n","    ) = create_noisy_model_training_data(\n","        clean_execution_history=exe_for_rec,\n","        clean_model_training_data=clean_training_data,\n","        training_ids=training_build_ids,\n","        noise_probability=RF_10PCT_NOISE_PROBABILITY,\n","        seed=repetition_seed,\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # TRAIN AND EVALUATE THE RANDOM FOREST\n","    # -----------------------------------------------------\n","\n","    (\n","        project_result,\n","        build_results,\n","        ranking_results,\n","    ) = run_random_forest_repetition(\n","        training_data=noisy_training_data,\n","        repetition_seed=repetition_seed,\n","        noise_level=RF_10PCT_NOISE_LEVEL,\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # ADD NOISE-AUDIT INFORMATION\n","    # -----------------------------------------------------\n","\n","    project_result.update({\n","        \"ActualFlips\":\n","            int(noise_summary[\"ActualFlips\"]),\n","\n","        \"RealisedNoisePercentage\":\n","            float(\n","                noise_summary[\n","                    \"RealisedNoisePercentage\"\n","                ]\n","            ),\n","\n","        \"PassToFailureFlips\":\n","            int(\n","                noise_summary[\n","                    \"PassToFailureFlips\"\n","                ]\n","            ),\n","\n","        \"FailureToPassFlips\":\n","            int(\n","                noise_summary[\n","                    \"FailureToPassFlips\"\n","                ]\n","            ),\n","\n","        \"ModelRowLabelChanges\":\n","            int(\n","                noise_summary[\n","                    \"ModelRowLabelChanges\"\n","                ]\n","            ),\n","\n","        \"TotalSeedRuntimeSeconds\":\n","            float(\n","                time.perf_counter()\n","                - seed_total_start\n","            ),\n","    })\n","\n","\n","    # Add experiment identifiers to each raw noise row.\n","    noise_audit = noise_audit.copy()\n","\n","    noise_audit.insert(\n","        0,\n","        \"Project\",\n","        PROJECT_NAME,\n","    )\n","\n","    noise_audit.insert(\n","        1,\n","        \"Model\",\n","        MODEL_NAME,\n","    )\n","\n","    noise_audit.insert(\n","        2,\n","        \"NoiseLevel\",\n","        RF_10PCT_NOISE_LEVEL,\n","    )\n","\n","    noise_audit.insert(\n","        3,\n","        \"RepetitionSeed\",\n","        repetition_seed,\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # STORE THIS SEED'S RESULTS\n","    # -----------------------------------------------------\n","\n","    rf_10pct_project_records.append(\n","        project_result\n","    )\n","\n","    rf_10pct_build_frames.append(\n","        build_results\n","    )\n","\n","    rf_10pct_ranking_frames.append(\n","        ranking_results\n","    )\n","\n","    rf_10pct_noise_summary_records.append(\n","        noise_summary\n","    )\n","\n","    rf_10pct_noise_audit_frames.append(\n","        noise_audit\n","    )\n","\n","\n","    print(\n","        f\"Seed {repetition_seed:02d}/30 complete | \"\n","        f\"Flips: {noise_summary['ActualFlips']} \"\n","        f\"(\"\n","        f\"{noise_summary['RealisedNoisePercentage']:.3f}%\"\n","        f\") | \"\n","        f\"Model labels changed: \"\n","        f\"{noise_summary['ModelRowLabelChanges']} | \"\n","        f\"Mean APFD: \"\n","        f\"{project_result['MeanAPFD']:.6f} | \"\n","        f\"Mean APFDc: \"\n","        f\"{project_result['MeanAPFDc']:.6f} | \"\n","        f\"Total time: \"\n","        f\"{project_result['TotalSeedRuntimeSeconds']:.2f}s\"\n","    )\n","\n","\n","    del noisy_training_data\n","    del noisy_execution_history\n","\n","    gc.collect()\n","\n","\n","rf_10pct_total_runtime = (\n","    time.perf_counter()\n","    - experiment_start\n",")\n","\n","\n","# ---------------------------------------------------------\n","# COMBINE ALL 30 SEEDS\n","# ---------------------------------------------------------\n","\n","rf_10pct_project_results = (\n","    pd.DataFrame(\n","        rf_10pct_project_records\n","    )\n","    .sort_values(\"RepetitionSeed\")\n","    .reset_index(drop=True)\n",")\n","\n","rf_10pct_build_results = (\n","    pd.concat(\n","        rf_10pct_build_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"RepetitionSeed\",\n","            \"build_order\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","rf_10pct_ranking_results = (\n","    pd.concat(\n","        rf_10pct_ranking_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"RepetitionSeed\",\n","            \"build_order\",\n","            \"RF_Rank\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","rf_10pct_noise_summary = (\n","    pd.DataFrame(\n","        rf_10pct_noise_summary_records\n","    )\n","    .sort_values(\"NoiseSeed\")\n","    .reset_index(drop=True)\n",")\n","\n","rf_10pct_noise_audit = (\n","    pd.concat(\n","        rf_10pct_noise_audit_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"RepetitionSeed\",\n","            \"build_order\",\n","            \"job\",\n","            \"test\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# COMPLETE-RUN VALIDATION\n","# ---------------------------------------------------------\n","\n","expected_project_rows = 30\n","expected_build_rows = 30 * 28\n","expected_ranking_rows = 30 * 702\n","expected_audit_rows = 30 * 7691\n","\n","\n","if len(rf_10pct_project_results) != expected_project_rows:\n","    raise ValueError(\n","        \"Expected 30 project-level rows, \"\n","        f\"but obtained {len(rf_10pct_project_results)}.\"\n","    )\n","\n","if len(rf_10pct_build_results) != expected_build_rows:\n","    raise ValueError(\n","        \"Expected 840 build-level rows, \"\n","        f\"but obtained {len(rf_10pct_build_results)}.\"\n","    )\n","\n","if len(rf_10pct_ranking_results) != expected_ranking_rows:\n","    raise ValueError(\n","        \"Expected 21,060 ranking rows, \"\n","        f\"but obtained {len(rf_10pct_ranking_results)}.\"\n","    )\n","\n","if len(rf_10pct_noise_summary) != 30:\n","    raise ValueError(\n","        \"Expected 30 noise-summary rows.\"\n","    )\n","\n","if len(rf_10pct_noise_audit) != expected_audit_rows:\n","    raise ValueError(\n","        f\"Expected {expected_audit_rows} audit rows, \"\n","        f\"but obtained {len(rf_10pct_noise_audit)}.\"\n","    )\n","\n","if (\n","    rf_10pct_project_results[\n","        \"RepetitionSeed\"\n","    ].nunique()\n","    != 30\n","):\n","    raise ValueError(\n","        \"The repetition-seed count is not 30.\"\n","    )\n","\n","if set(\n","    rf_10pct_project_results[\"RepetitionSeed\"]\n",") != set(RF_10PCT_SEEDS):\n","    raise ValueError(\n","        \"The expected seeds 1–30 are not all present.\"\n","    )\n","\n","\n","builds_per_seed = (\n","    rf_10pct_build_results\n","    .groupby(\"RepetitionSeed\")[\"Build\"]\n","    .nunique()\n",")\n","\n","if not (builds_per_seed == 28).all():\n","    raise ValueError(\n","        \"At least one seed does not contain \"\n","        \"all 28 evaluation builds.\"\n","    )\n","\n","\n","rankings_per_seed = (\n","    rf_10pct_ranking_results\n","    .groupby(\"RepetitionSeed\")\n","    .size()\n",")\n","\n","if not (rankings_per_seed == 702).all():\n","    raise ValueError(\n","        \"At least one seed does not contain \"\n","        \"all 702 ranking rows.\"\n","    )\n","\n","\n","audit_rows_per_seed = (\n","    rf_10pct_noise_audit\n","    .groupby(\"RepetitionSeed\")\n","    .size()\n",")\n","\n","if not (audit_rows_per_seed == 7691).all():\n","    raise ValueError(\n","        \"At least one seed does not contain \"\n","        \"all 7,691 noise-audit rows.\"\n","    )\n","\n","\n","if rf_10pct_project_results[\n","    [\n","        \"MeanAPFD\",\n","        \"MeanAPFDc\",\n","    ]\n","].isna().any().any():\n","    raise ValueError(\n","        \"Project-level metrics contain missing values.\"\n","    )\n","\n","\n","if not rf_10pct_project_results[\n","    [\n","        \"MeanAPFD\",\n","        \"MeanAPFDc\",\n","    ]\n","].apply(\n","    lambda column: column.between(0, 1)\n",").all().all():\n","    raise ValueError(\n","        \"A project-level metric is outside [0, 1].\"\n","    )\n","\n","\n","if not rf_10pct_build_results[\n","    [\n","        \"APFD\",\n","        \"APFDc\",\n","    ]\n","].apply(\n","    lambda column: column.between(0, 1)\n",").all().all():\n","    raise ValueError(\n","        \"A build-level metric is outside [0, 1].\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# PAIRED 0% VS 10% COMPARI