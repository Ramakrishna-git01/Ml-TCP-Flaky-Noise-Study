     120  \n","7        76230             2100             210           120  \n","8        76230             2100             210           120  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Total elapsed minutes for this invocation: 49.6\n","\n","Condition registry:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/thinkaurelius__titan/titan_full_run/titan_condition_completion_registry.csv\n","\n","Full-run execution report:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/thinkaurelius__titan/titan_full_run/titan_full_run_execution_report.json\n","\n","Raw condition results:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Raw/thinkaurelius__titan\n","\n","SUCCESS: All 270 Titan conditions are complete and individually validated.\n","SUCCESS: All 1,080 ML model fits are present.\n","SUCCESS: All 1,890 project-run rows are present.\n","SUCCESS: All 18,900 build-metric rows are present.\n","SUCCESS: All 686,070 ranking rows are present.\n","SUCCESS: Titan is ready for the final cross-condition audit and aggregation.\n"]}],"source":["# =========================================================\n","# PROJECT 5: THINKAURELIUS TITAN\n","# FULL 270-CONDITION RESUME-SAFE EXPERIMENT RUNNER\n","#\n","# Conditions:\n","#   9 noise levels × 30 seeds = 270\n","#\n","# Expected final raw outputs:\n","#   Conditions:              270\n","#   ML model fits:         1,080\n","#   Project-run rows:      1,890\n","#   Build-metric rows:    18,900\n","#   Ranking rows:        686,070\n","#\n","# The existing noise_000/seed_01 smoke condition is reused.\n","# =========================================================\n","\n","from pathlib import Path\n","import hashlib\n","import json\n","import shutil\n","import time\n","import traceback\n","import warnings\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Validate required project state\n","# ---------------------------------------------------------\n","\n","EXPECTED_PROJECT_NUMBER = 5\n","EXPECTED_PROJECT_NAME = \"thinkaurelius@titan\"\n","EXPECTED_PROJECT_SLUG = \"thinkaurelius__titan\"\n","\n","\n","REQUIRED_VARIABLES = [\n","    \"PROJECT_NUMBER\",\n","    \"PROJECT_NAME\",\n","    \"PROJECT_SLUG\",\n","    \"MODEL_FEATURE_COLUMNS\",\n","    \"REC_FEATURE_COLUMNS\",\n","    \"VERDICT_DEPENDENT_REC_COLUMNS\",\n","    \"NOISE_INDEPENDENT_REC_COLUMNS\",\n","    \"ACTIVE_FEATURE_COLUMNS\",\n","    \"ZERO_VARIANCE_FEATURES\",\n","    \"MODEL_CONFIG\",\n","    \"clean_training_history\",\n","    \"clean_evaluation_history\",\n","    \"clean_model_training_data\",\n","    \"clean_model_evaluation_data\",\n","]\n","\n","\n","REQUIRED_FUNCTIONS = [\n","    \"stable_project_seed\",\n","    \"inject_training_verdict_noise\",\n","    \"create_noisy_model_training_data\",\n","    \"prepare_ml_matrices\",\n","    \"create_ml_models\",\n","    \"get_failure_probability\",\n","    \"create_ml_rankings\",\n","    \"create_random_rankings\",\n","    \"create_history_baseline_rankings\",\n","    \"calculate_build_metrics\",\n","    \"validate_condition_outputs\",\n","]\n","\n","\n","missing_variables = [\n","    name\n","    for name in REQUIRED_VARIABLES\n","    if name not in globals()\n","]\n","\n","\n","missing_functions = [\n","    name\n","    for name in REQUIRED_FUNCTIONS\n","    if (\n","        name not in globals()\n","        or not callable(globals()[name])\n","    )\n","]\n","\n","\n","if missing_variables:\n","    raise RuntimeError(\n","        \"Required Titan variables are missing:\\n\"\n","        + \"\\n\".join(missing_variables)\n","        + \"\\n\\nRerun the successful helper-validation and \"\n","        \"seven-technique smoke-test cells.\"\n","    )\n","\n","\n","if missing_functions:\n","    raise RuntimeError(\n","        \"Required Titan functions are missing:\\n\"\n","        + \"\\n\".join(missing_functions)\n","        + \"\\n\\nRerun the successful helper-validation and \"\n","        \"seven-technique smoke-test cells.\"\n","    )\n","\n","\n","if PROJECT_NUMBER != EXPECTED_PROJECT_NUMBER:\n","    raise AssertionError(\n","        f\"Expected Project 5, found Project {PROJECT_NUMBER}.\"\n","    )\n","\n","\n","if PROJECT_NAME != EXPECTED_PROJECT_NAME:\n","    raise AssertionError(\n","        f\"Expected {EXPECTED_PROJECT_NAME}, \"\n","        f\"found {PROJECT_NAME}.\"\n","    )\n","\n","\n","if PROJECT_SLUG != EXPECTED_PROJECT_SLUG:\n","    raise AssertionError(\n","        f\"Expected {EXPECTED_PROJECT_SLUG}, \"\n","        f\"found {PROJECT_SLUG}.\"\n","    )\n","\n","\n","if len(MODEL_FEATURE_COLUMNS) != 150:\n","    raise AssertionError(\n","        \"Expected 150 original predictors.\"\n","    )\n","\n","\n","if len(ACTIVE_FEATURE_COLUMNS) != 149:\n","    raise AssertionError(\n","        \"Expected 149 active Titan predictors.\"\n","    )\n","\n","\n","if ZERO_VARIANCE_FEATURES != [\n","    \"TES_COM_CountDeclMethodDefault\"\n","]:\n","    raise AssertionError(\n","        \"Unexpected frozen zero-variance feature list.\\n\"\n","        f\"Observed: {ZERO_VARIANCE_FEATURES}\"\n","    )\n","\n","\n","if len(clean_training_history) != 12785:\n","    raise AssertionError(\n","        \"Unexpected raw training execution count.\"\n","    )\n","\n","\n","if len(clean_evaluation_history) != 4546:\n","    raise AssertionError(\n","        \"Unexpected raw evaluation execution count.\"\n","    )\n","\n","\n","if len(clean_model_training_data) != 2028:\n","    raise AssertionError(\n","        \"Unexpected model-ready training row count.\"\n","    )\n","\n","\n","if len(clean_model_evaluation_data) != 363:\n","    raise AssertionError(\n","        \"Unexpected model-ready evaluation row count.\"\n","    )\n","\n","\n","print(\n","    \"=== TITAN FULL 270-CONDITION EXPERIMENT SETUP ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Frozen experiment configuration\n","# ---------------------------------------------------------\n","\n","NOISE_LEVELS = [\n","    0,\n","    5,\n","    10,\n","    15,\n","    20,\n","    25,\n","    30,\n","    40,\n","    50,\n","]\n","\n","\n","REPETITION_SEEDS = list(\n","    range(1, 31)\n",")\n","\n","\n","ML_TECHNIQUES = [\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","]\n","\n","\n","BASELINE_TECHNIQUES = [\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","]\n","\n","\n","ALL_TECHNIQUES = (\n","    ML_TECHNIQUES\n","    + BASELINE_TECHNIQUES\n",")\n","\n","\n","EXPECTED_CONDITIONS = (\n","    len(NOISE_LEVELS)\n","    * len(REPETITION_SEEDS)\n",")\n","\n","\n","EXPECTED_RANKING_ROWS_PER_CONDITION = (\n","    len(clean_model_evaluation_data)\n","    * len(ALL_TECHNIQUES)\n",")\n","\n","\n","EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION = (\n","    clean_model_evaluation_data[\n","        \"Build\"\n","    ].nunique()\n","    * len(ALL_TECHNIQUES)\n",")\n","\n","\n","EXPECTED_PROJECT_RUN_ROWS_PER_CONDITION = (\n","    len(ALL_TECHNIQUES)\n",")\n","\n","\n","EXPECTED_MODEL_FITS_PER_CONDITION = (\n","    len(ML_TECHNIQUES)\n",")\n","\n","\n","if EXPECTED_CONDITIONS != 270:\n","    raise AssertionError(\n","        \"Expected exactly 270 conditions.\"\n","    )\n","\n","\n","if EXPECTED_RANKING_ROWS_PER_CONDITION != 2541:\n","    raise AssertionError(\n","        \"Expected 2,541 ranking rows per condition.\"\n","    )\n","\n","\n","if EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION != 70:\n","    raise AssertionError(\n","        \"Expected 70 build-metric rows per condition.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Permanent paths\n","# ---------------------------------------------------------\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n",")\n","\n","LOGS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Logs\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","\n","PROJECT_RAW_RESULTS = (\n","    RAW_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_LOGS = (\n","    LOGS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","FULL_RUN_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_full_run\"\n",")\n","\n","\n","for directory in [\n","    RAW_RESULTS_DRIVE,\n","    AGGREGATED_RESULTS_DRIVE,\n","    LOGS_DRIVE,\n","    NOTES_DRIVE,\n","    PROJECT_RAW_RESULTS,\n","    PROJECT_AGGREGATED_RESULTS,\n","    PROJECT_LOGS,\n","    FULL_RUN_DIRECTORY,\n","]:\n","    directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","CONDITION_REGISTRY_PATH = (\n","    FULL_RUN_DIRECTORY\n","    / \"titan_condition_completion_registry.csv\"\n",")\n","\n","FULL_RUN_REPORT_PATH = (\n","    FULL_RUN_DIRECTORY\n","    / \"titan_full_run_execution_report.json\"\n",")\n","\n","RUN_PROGRESS_LOG_PATH = (\n","    PROJECT_LOGS\n","    / \"titan_full_run_progress.csv\"\n",")\n","\n","RUN_FAILURE_LOG_PATH = (\n","    PROJECT_LOGS\n","    / \"titan_full_run_last_failure.json\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Stable hash helper\n","# ---------------------------------------------------------\n","\n","def full_run_dataframe_sha256(\n","    dataframe,\n","):\n","    hashed_values = (\n","        pd.util.hash_pandas_object(\n","            dataframe,\n","            index=True,\n","        )\n","        .to_numpy(dtype=np.uint64)\n","    )\n","\n","\n","    return hashlib.sha256(\n","        hashed_values.tobytes()\n","    ).hexdigest()\n","\n","\n","EVALUATION_AUDIT_COLUMNS = [\n","    \"Build\",\n","    \"Test\",\n","    \"Verdict\",\n","    \"Duration\",\n","    *REC_FEATURE_COLUMNS,\n","]\n","\n","\n","CLEAN_EVALUATION_HASH = (\n","    full_run_dataframe_sha256(\n","        clean_model_evaluation_data[\n","            EVALUATION_AUDIT_COLUMNS\n","        ]\n","    )\n",")\n","\n","\n","CLEAN_RAW_EVALUATION_HASH = (\n","    full_run_dataframe_sha256(\n","        clean_evaluation_history\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Condition path helpers\n","# ---------------------------------------------------------\n","\n","def get_condition_directory(\n","    noise_percent,\n","    repetition_seed,\n","):\n","    return (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{int(repetition_seed):02d}\"\n","    )\n","\n","\n","def get_condition_paths(\n","    noise_percent,\n","    repetition_seed,\n","):\n","    condition_directory = (\n","        get_condition_directory(\n","            noise_percent,\n","            repetition_seed,\n","        )\n","    )\n","\n","\n","    return {\n","        \"directory\":\n","            condition_directory,\n","\n","        \"success\":\n","            condition_directory\n","            / \"_SUCCESS.json\",\n","\n","        \"noise_manifest\":\n","            condition_directory\n","            / \"noise_manifest.parquet\",\n","\n","        \"noise_summary\":\n","            condition_directory\n","            / \"noise_summary.csv\",\n","\n","        \"training_medians\":\n","            condition_directory\n","            / \"training_medians.csv\",\n","\n","        \"fit_times\":\n","            condition_directory\n","            / \"fit_times.csv\",\n","\n","        \"rankings\":\n","            condition_directory\n","            / \"rankings.parquet\",\n","\n","        \"build_metrics\":\n","            condition_directory\n","            / \"build_metrics.parquet\",\n","\n","        \"project_run_metrics\":\n","            condition_directory\n","            / \"project_run_metrics.csv\",\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# 6. Validate one saved condition\n","# ---------------------------------------------------------\n","\n","def validate_saved_condition(\n","    noise_percent,\n","    repetition_seed,\n","):\n","    paths = get_condition_paths(\n","        noise_percent,\n","        repetition_seed,\n","    )\n","\n","\n","    if not paths[\n","        \"success\"\n","    ].exists():\n","        raise FileNotFoundError(\n","            \"Condition has no success marker:\\n\"\n","            f\"{paths['success']}\"\n","        )\n","\n","\n","    required_files = [\n","        \"noise_manifest\",\n","        \"noise_summary\",\n","        \"fit_times\",\n","        \"rankings\",\n","        \"build_metrics\",\n","        \"project_run_metrics\",\n","    ]\n","\n","\n","    missing_files = [\n","        str(paths[name])\n","        for name in required_files\n","        if not paths[name].exists()\n","    ]\n","\n","\n","    if missing_files:\n","        raise FileNotFoundError(\n","            \"Completed condition is missing outputs:\\n\"\n","            + \"\\n\".join(missing_files)\n","        )\n","\n","\n","    rankings = pd.read_parquet(\n","        paths[\n","            \"rankings\"\n","        ]\n","    )\n","\n","\n","    build_metrics = pd.read_parquet(\n","        paths[\n","            \"build_metrics\"\n","        ]\n","    )\n","\n","\n","    project_run_metrics = pd.read_csv(\n","        paths[\n","            \"project_run_metrics\"\n","        ]\n","    )\n","\n","\n","    fit_times = pd.read_csv(\n","        paths[\n","            \"fit_times\"\n","        ]\n","    )\n","\n","\n","    noise_summary = pd.read_csv(\n","        paths[\n","            \"noise_summary\"\n","        ]\n","    )\n","\n","\n","    validate_condition_outputs(\n","        rankings=rankings,\n","        build_metrics=build_metrics,\n","    )\n","\n","\n","    if len(rankings) != (\n","        EXPECTED_RANKING_ROWS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            \"Saved ranking count mismatch.\"\n","        )\n","\n","\n","    if len(build_metrics) != (\n","        EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            \"Saved build-metric count mismatch.\"\n","        )\n","\n","\n","    if len(project_run_metrics) != (\n","        EXPECTED_PROJECT_RUN_ROWS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            \"Saved project-run count mismatch.\"\n","        )\n","\n","\n","    if len(fit_times) != (\n","        EXPECTED_MODEL_FITS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            \"Saved model-fit count mismatch.\"\n","        )\n","\n","\n","    if len(noise_summary) != 1:\n","        raise AssertionError(\n","            \"Noise summary must contain one row.\"\n","        )\n","\n","\n","    for dataframe_name, dataframe in [\n","        (\n","            \"rankings\",\n","            rankings,\n","        ),\n","        (\n","            \"build metrics\",\n","            build_metrics,\n","        ),\n","        (\n","            \"project-run metrics\",\n","            project_run_metrics,\n","        ),\n","        (\n","            \"fit times\",\n","            fit_times,\n","        ),\n","    ]:\n","        observed_noise = set(\n","            pd.to_numeric(\n","                dataframe[\n","                    \"NoisePercent\"\n","                ],\n","                errors=\"raise\",\n","            ).astype(float)\n","        )\n","\n","\n","        if observed_noise != {\n","            float(noise_percent)\n","        }:\n","            raise AssertionError(\n","                f\"Incorrect noise value in {dataframe_name}.\"\n","            )\n","\n","\n","        observed_seeds = set(\n","            pd.to_numeric(\n","                dataframe[\n","                    \"RepetitionSeed\"\n","                ],\n","                errors=\"raise\",\n","            ).astype(int)\n","        )\n","\n","\n","        if observed_seeds != {\n","            int(repetition_seed)\n","        }:\n","            raise AssertionError(\n","                f\"Incorrect seed in {dataframe_name}.\"\n","            )\n","\n","\n","    observed_techniques = set(\n","        project_run_metrics[\n","            \"Technique\"\n","        ].astype(str)\n","    )\n","\n","\n","    if observed_techniques != set(\n","        ALL_TECHNIQUES\n","    ):\n","        raise AssertionError(\n","            \"Saved project-run techniques are incomplete.\"\n","        )\n","\n","\n","    with open(\n","        paths[\n","            \"success\"\n","        ],\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","        metadata = json.load(\n","            marker_file\n","        )\n","\n","\n","    if float(\n","        metadata[\n","            \"NoisePercent\"\n","        ]\n","    ) != float(\n","        noise_percent\n","    ):\n","        raise AssertionError(\n","            \"Success marker has incorrect noise value.\"\n","        )\n","\n","\n","    if int(\n","        metadata[\n","            \"RepetitionSeed\"\n","        ]\n","    ) != int(\n","        repetition_seed\n","    ):\n","        raise AssertionError(\n","            \"Success marker has incorrect seed.\"\n","        )\n","\n","\n","    if not bool(\n","        metadata.get(\n","            \"CompletedSuccessfully\",\n","            False,\n","        )\n","    ):\n","        raise AssertionError(\n","            \"Success marker is not marked complete.\"\n","        )\n","\n","\n","    return {\n","        \"Project\":\n","            PROJECT_NAME,\n","\n","        \"NoisePercent\":\n","            int(noise_percent),\n","\n","        \"RepetitionSeed\":\n","            int(repetition_seed),\n","\n","        \"Status\":\n","            \"COMPLETE_AND_VALIDATED\",\n","\n","        \"ConditionDirectory\":\n","            str(\n","                paths[\n","                    \"directory\"\n","                ]\n","            ),\n","\n","        \"NoiseFlips\":\n","            int(\n","                noise_summary[\n","                    \"NumberFlipped\"\n","                ].iloc[0]\n","            ),\n","\n","        \"RealisedNoisePercent\":\n","            float(\n","                noise_summary[\n","                    \"RealisedNoisePercent\"\n","                ].iloc[0]\n","            ),\n","\n","        \"RankingRows\":\n","            int(\n","                len(rankings)\n","            ),\n","\n","        \"BuildMetricRows\":\n","            int(\n","                len(build_metrics)\n","            ),\n","\n","        \"ProjectRunRows\":\n","            int(\n","                len(project_run_metrics)\n","            ),\n","\n","        \"ModelFitRows\":\n","            int(\n","                len(fit_times)\n","            ),\n","\n","        \"EvaluationRows\":\n","            int(\n","                rankings[\n","                    [\n","                        \"Build\",\n","                        \"Test\",\n","                    ]\n","                ]\n","                .drop_duplicates()\n","                .shape[0]\n","            ),\n","\n","        \"ElapsedSeconds\":\n","            float(\n","                metadata.get(\n","                    \"ElapsedSeconds\",\n","                    np.nan,\n","                )\n","            ),\n","\n","        \"SuccessMarker\":\n","            str(\n","                paths[\n","                    \"success\"\n","                ]\n","            ),\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# 7. Generic full-condition runner\n","# ---------------------------------------------------------\n","\n","def run_titan_condition(\n","    noise_percent,\n","    repetition_seed,\n","    overwrite=False,\n","):\n","    condition_start_time = time.time()\n","\n","\n","    paths = get_condition_paths(\n","        noise_percent,\n","        repetition_seed,\n","    )\n","\n","\n","    if (\n","        paths[\n","            \"success\"\n","        ].exists()\n","        and not overwrite\n","    ):\n","        return {\n","            **validate_saved_condition(\n","                noise_percent,\n","                repetition_seed,\n","            ),\n","\n","            \"ExecutionAction\":\n","                \"REUSED_EXISTING\",\n","        }\n","\n","\n","    # Remove an incomplete or intentionally overwritten\n","    # condition before recreating it.\n","    if paths[\n","        \"directory\"\n","    ].exists():\n","        shutil.rmtree(\n","            paths[\n","                \"directory\"\n","            ]\n","        )\n","\n","\n","    paths[\n","        \"directory\"\n","    ].mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","    evaluation_hash_before = (\n","        full_run_dataframe_sha256(\n","            clean_model_evaluation_data[\n","                EVALUATION_AUDIT_COLUMNS\n","            ]\n","        )\n","    )\n","\n","\n","    raw_evaluation_hash_before = (\n","        full_run_dataframe_sha256(\n","            clean_evaluation_history\n","        )\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # One corruption shared by all affected techniques\n","    # -----------------------------------------------------\n","\n","    (\n","        noisy_training_history,\n","        noise_manifest,\n","        noise_summary,\n","    ) = inject_training_verdict_noise(\n","        execution_history=(\n","            clean_training_history\n","        ),\n","\n","        noise_percent=(\n","            noise_percent\n","        ),\n","\n","        repetition_seed=(\n","            repetition_seed\n","        ),\n","    )\n","\n","\n","    noisy_training_data = (\n","        create_noisy_model_training_data(\n","            clean_model_training_data=(\n","                clean_model_training_data\n","            ),\n","\n","            noisy_execution_history=(\n","                noisy_training_history\n","            ),\n","        )\n","    )\n","\n","\n","    if len(\n","        noisy_training_data\n","    ) != 2028:\n","        raise AssertionError(\n","            \"Fixed training cohort changed.\"\n","        )\n","\n","\n","    # -----------------------------------------------------\n","    # Shared ML matrices\n","    # -----------------------------------------------------\n","\n","    (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    ) = prepare_ml_matrices(\n","        noisy_training_data=(\n","            noisy_training_data\n","        ),\n","\n","        evaluation_data=(\n","            clean_model_evaluation_data\n","        ),\n","    )\n","\n","\n","    if y_train.nunique() != 2:\n","        raise AssertionError(\n","            \"Condition does not contain both classes.\"\n","        )\n","\n","\n","    # -----------------------------------------------------\n","    # Four ML techniques\n","    # -----------------------------------------------------\n","\n","    model_result = create_ml_models(\n","        repetition_seed\n","    )\n","\n","\n","    if (\n","        isinstance(\n","            model_result,\n","            tuple,\n","        )\n","        and len(model_result) == 2\n","    ):\n","        models, model_seeds = model_result\n","\n","    else:\n","        models = model_result\n","\n","        model_seeds = {\n","            \"RandomForest\":\n","                int(\n","                    stable_project_seed(\n","                        PROJECT_NAME,\n","                        repetition_seed,\n","                        \"RandomForest_model\",\n","                    )\n","                ),\n","\n","            \"XGBoost\":\n","                int(\n","                    stable_project_seed(\n","                        PROJECT_NAME,\n","                        repetition_seed,\n","                        \"XGBoost_model\",\n","                    )\n","                ),\n","\n","            \"LightGBM\":\n","                int(\n","                    stable_project_seed(\n","                        PROJECT_NAME,\n","                        repetition_seed,\n","                        \"LightGBM_model\",\n","                    )\n","                ),\n","\n","            \"NaiveBayes\":\n","                None,\n","        }\n","\n","\n","    if set(models.keys()) != set(\n","        ML_TECHNIQUES\n","    ):\n","        raise AssertionError(\n","            \"Incorrect ML technique set.\"\n","        )\n","\n","\n","    ranking_frames = []\n","    fit_records = []\n","\n","\n","    for technique, model in models.items():\n","        technique_start_time = time.time()\n","\n","\n","        with warnings.catch_warnings():\n","            warnings.simplefilter(\n","                \"ignore\"\n","            )\n","\n","\n","            model.fit(\n","                X_train,\n","                y_train,\n","            )\n","\n","\n","        failure_probabilities = (\n","            get_failure_probability(\n","                fitted_model=model,\n","                feature_matrix=X_evaluation,\n","            )\n","        )\n","\n","\n","        model_rankings = (\n","            create_ml_rankings(\n","                evaluation_data=(\n","                    clean_model_evaluation_data\n","                ),\n","\n","                technique=technique,\n","\n","                failure_probabilities=(\n","                    failure_probabilities\n","                ),\n","            )\n","        )\n","\n","\n","        ranking_frames.append(\n","            model_rankings\n","        )\n","\n","\n","        fit_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"NoisePercent\":\n","                float(noise_percent),\n","\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","\n","            \"Technique\":\n","                technique,\n","\n","            \"ModelSeed\":\n","                model_seeds.get(\n","                    technique\n","                ),\n","\n","            \"FitSeconds\":\n","                float(\n","                    time.time()\n","                    - technique_start_time\n","                ),\n","\n","            \"TrainingRows\":\n","                int(\n","                    len(X_train)\n","                ),\n","\n","            \"TrainingPasses\":\n","                int(\n","                    len(y_train)\n","                    - y_train.sum()\n","                ),\n","\n","            \"TrainingFailures\":\n","                int(\n","                    y_train.sum()\n","                ),\n","\n","            \"EvaluationRows\":\n","                int(\n","                    len(X_evaluation)\n","                ),\n","\n","            \"ActiveFeatures\":\n","                int(\n","                    len(\n","                        ACTIVE_FEATURE_COLUMNS\n","                    )\n","                ),\n","        })\n","\n","\n","    # -----------------------------------------------------\n","    # Random baseline\n","    # -----------------------------------------------------\n","\n","    ranking_frames.append(\n","        create_random_rankings(\n","            evaluation_data=(\n","                clean_model_evaluation_data\n","            ),\n","\n","            repetition_seed=(\n","                repetition_seed\n","            ),\n","        )\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # LatestFail and QTF-Avg\n","    # -----------------------------------------------------\n","\n","    (\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ) = create_history_baseline_rankings(\n","        noisy_training_history=(\n","            noisy_training_history\n","        )\n","    )\n","\n","\n","    ranking_frames.extend([\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ])\n","\n","\n","    # -----------------------------------------------------\n","    # Combine rankings and calculate metrics\n","    # -----------------------------------------------------\n","\n","    rankings = pd.concat(\n","        ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","\n","    rankings.insert(\n","        0,\n","        \"Project\",\n","        PROJECT_NAME,\n","    )\n","\n","\n","    rankings.insert(\n","        1,\n","        \"NoisePercent\",\n","        float(noise_percent),\n","    )\n","\n","\n","    rankings.insert(\n","        2,\n","        \"RepetitionSeed\",\n","        int(repetition_seed),\n","    )\n","\n","\n","    build_metrics = (\n","        calculate_build_metrics(\n","            all_rankings=rankings,\n","            noise_percent=noise_percent,\n","            repetition_seed=repetition_seed,\n","        )\n","    )\n","\n","\n","    validate_condition_outputs(\n","        rankings=rankings,\n","        build_metrics=build_metrics,\n","    )\n","\n","\n","    project_run_metrics = (\n","        build_metrics\n","        .groupby(\n","            [\n","                \"Project\",\n","                \"NoisePercent\",\n","                \"RepetitionSeed\",\n","                \"Technique\",\n","            ],\n","            as_index=False,\n","        )\n","        .agg(\n","            MeanAPFD=(\n","                \"APFD\",\n","                \"mean\",\n","            ),\n","\n","            MeanAPFDc=(\n","                \"APFDc\",\n","                \"mean\",\n","            ),\n","\n","            SD_APFD=(\n","                \"APFD\",\n","                \"std\",\n","            ),\n","\n","            SD_APFDc=(\n","                \"APFDc\",\n","                \"std\",\n","            ),\n","\n","            EvaluatedBuilds=(\n","                \"Build\",\n","                \"nunique\",\n","            ),\n","\n","            TotalRankedTests=(\n","                \"NumberOfTests\",\n","                \"sum\",\n","            ),\n","\n","            TotalFailures=(\n","                \"NumberOfFailures\",\n","                \"sum\",\n","            ),\n","        )\n","    )\n","\n","\n","    fit_times = pd.DataFrame(\n","        fit_records\n","    )\n","\n","\n","    noise_summary_frame = pd.DataFrame([\n","        noise_summary\n","    ])\n","\n","\n","    training_medians_frame = pd.DataFrame({\n","        \"Feature\":\n","            training_medians.index,\n","\n","        \"TrainingMedian\":\n","            training_medians.to_numpy(\n","                dtype=float\n","            ),\n","    })\n","\n","\n","    # -----------------------------------------------------\n","    # Condition-level final checks\n","    # -----------------------------------------------------\n","\n","    if len(rankings) != 2541:\n","        raise AssertionError(\n","            \"Condition ranking count is not 2,541.\"\n","        )\n","\n","\n","    if len(build_metrics) != 70:\n","        raise AssertionError(\n","            \"Condition build-metric count is not 70.\"\n","        )\n","\n","\n","    if len(project_run_metrics) != 7:\n","        raise AssertionError(\n","            \"Condition project-run count is not 7.\"\n","        )\n","\n","\n","    if len(fit_times) != 4:\n","        raise AssertionError(\n","            \"Condition model-fit count is not 4.\"\n","        )\n","\n","\n","    if not (\n","        project_run_metrics[\n","            \"EvaluatedBuilds\"\n","        ] == 10\n","    ).all():\n","        raise AssertionError(\n","            \"A technique did not evaluate all 10 builds.\"\n","        )\n","\n","\n","    if not (\n","        project_run_metrics[\n","            \"TotalRankedTests\"\n","        ] == 363\n","    ).all():\n","        raise AssertionError(\n","            \"A technique did not rank all 363 rows.\"\n","        )\n","\n","\n","    if not (\n","        project_run_metrics[\n","            \"TotalFailures\"\n","        ] == 13\n","    ).all():\n","        raise AssertionError(\n","            \"A technique did not observe all \"\n","            \"13 evaluation failures.\"\n","        )\n","\n","\n","    evaluation_hash_after = (\n","        full_run_dataframe_sha256(\n","            clean_model_evaluation_data[\n","                EVALUATION_AUDIT_COLUMNS\n","            ]\n","        )\n","    )\n","\n","\n","    raw_evaluation_hash_after = (\n","        full_run_dataframe_sha256(\n","            clean_evaluation_history\n","        )\n","    )\n","\n","\n","    if evaluation_hash_before != (\n","        evaluation_hash_after\n","    ):\n","        raise AssertionError(\n","            \"Model-ready evaluation data changed.\"\n","        )\n","\n","\n","    if raw_evaluation_hash_before != (\n","        raw_evaluation_hash_after\n","    ):\n","        raise AssertionError(\n","            \"Raw evaluation history changed.\"\n","        )\n","\n","\n","    # -----------------------------------------------------\n","    # Save outputs after validation\n","    # -----------------------------------------------------\n","\n","    noise_manifest.to_parquet(\n","        paths[\n","            \"noise_manifest\"\n","        ],\n","        index=False,\n","    )\n","\n","\n","    noise_summary_frame.to_csv(\n","        paths[\n","            \"noise_summary\"\n","        ],\n","        index=False,\n","    )\n","\n","\n","    training_medians_frame.to_csv(\n","        paths[\n","            \"training_medians\"\n","        ],\n","        index=False,\n","    )\n","\n","\n","    fit_times.to_csv(\n","        paths[\n","            \"fit_times\"\n","        ],\n","        index=False,\n","    )\n","\n","\n","    rankings.to_parquet(\n","        paths[\n","            \"rankings\"\n","        ],\n","        index=False,\n","    )\n","\n","\n","    build_metrics.to_parquet(\n","        paths[\n","            \"build_metrics\"\n","        ],\n","        index=False,\n","    )\n","\n","\n","    project_run_metrics.to_csv(\n","        paths[\n","            \"project_run_metrics\"\n","        ],\n","        index=False,\n","    )\n","\n","\n","    elapsed_seconds = float(\n","        time.time()\n","        - condition_start_time\n","    )\n","\n","\n","    condition_metadata = {\n","        \"ProjectNumber\":\n","            PROJECT_NUMBER,\n","\n","        \"Project\":\n","            PROJECT_NAME,\n","\n","        \"ProjectSlug\":\n","            PROJECT_SLUG,\n","\n","        \"NoisePercent\":\n","            float(noise_percent),\n","\n","        \"RepetitionSeed\":\n","            int(repetition_seed),\n","\n","        \"NoiseFlips\":\n","            int(\n","                noise_summary[\n","                    \"NumberFlipped\"\n","                ]\n","            ),\n","\n","        \"RealisedNoisePercent\":\n","            float(\n","                noise_summary[\n","                    \"RealisedNoisePercent\"\n","                ]\n","            ),\n","\n","        \"TrainingExecutionRows\":\n","            int(\n","                len(\n","                    clean_training_history\n","                )\n","            ),\n","\n","        \"TrainingModelRows\":\n","            int(\n","                len(\n","                    noisy_training_data\n","                )\n","            ),\n","\n","        \"TrainingPasses\":\n","            int(\n","                (\n","                    noisy_training_data[\n","                        \"Verdict\"\n","                    ] == 0\n","                ).sum()\n","            ),\n","\n","        \"TrainingFailures\":\n","            int(\n","                (\n","                    noisy_training_data[\n","                        \"Verdict\"\n","                    ] != 0\n","                ).sum()\n","            ),\n","\n","        \"EvaluationExecutionRows\":\n","            int(\n","                len(\n","                    clean_evaluation_history\n","                )\n","            ),\n","\n","        \"EvaluationModelRows\":\n","            int(\n","                len(\n","                    clean_model_evaluation_data\n","                )\n","            ),\n","\n","        \"EvaluationFailures\":\n","            13,\n","\n","        \"EvaluatedBuilds\":\n","            10,\n","\n","        \"TechniqueCount\":\n","            7,\n","\n","        \"ModelFitCount\":\n","            4,\n","\n","        \"OriginalPredictorCount\":\n","            150,\n","\n","        \"ActivePredictorCount\":\n","            149,\n","\n","        \"ZeroVariancePredictorCount\":\n","            1,\n","\n","        \"RankingRows\":\n","            int(\n","                len(rankings)\n","            ),\n","\n","        \"BuildMetricRows\":\n","            int(\n","                len(build_metrics)\n","            ),\n","\n","        \"ProjectRunRows\":\n","            int(\n","                len(\n","                    project_run_metrics\n","                )\n","            ),\n","\n","        \"RankingsSHA256\":\n","            full_run_dataframe_sha256(\n","                rankings\n","            ),\n","\n","        \"BuildMetricsSHA256\":\n","            full_run_dataframe_sha256(\n","                build_metrics\n","            ),\n","\n","        \"ProjectRunMetricsSHA256\":\n","            full_run_dataframe_sha256(\n","                project_run_metrics\n","            ),\n","\n","        \"NoiseManifestSHA256\":\n","            full_run_dataframe_sha256(\n","                noise_manifest\n","            ),\n","\n","        \"EvaluationModelHashUnchanged\":\n","            True,\n","\n","        \"EvaluationRawHashUnchanged\":\n","            True,\n","\n","        \"ElapsedSeconds\":\n","            elapsed_seconds,\n","\n","        \"CompletedSuccessfully\":\n","            True,\n","\n","        \"CompletedAtUTC\":\n","            pd.Timestamp.utcnow().isoformat(),\n","    }\n","\n","\n","    # Success marker is always written last.\n","    with open(\n","        paths[\n","            \"success\"\n","        ],\n","        \"w\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","        json.dump(\n","            condition_metadata,\n","            marker_file,\n","            indent=2,\n","        )\n","\n","\n","    return {\n","        **validate_saved_condition(\n","            noise_percent,\n","            repetition_seed,\n","        ),\n","\n","        \"ExecutionAction\":\n","            \"EXECUTED_NOW\",\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# 8. Execute or resume all 270 conditions\n","# ---------------------------------------------------------\n","\n","full_run_start_time = time.time()\n","\n","progress_records = []\n","\n","completed_before_run = 0\n","executed_now = 0\n","\n","\n","for repetition_seed in REPETITION_SEEDS:\n","    for noise_percent in NOISE_LEVELS:\n","        condition_number = (\n","            (\n","                repetition_seed - 1\n","            )\n","            * len(NOISE_LEVELS)\n","            + NOISE_LEVELS.index(\n","                noise_percent\n","            )\n","            + 1\n","        )\n","\n","\n","        condition_paths = (\n","            get_condition_paths(\n","                noise_percent,\n","                repetition_seed,\n","            )\n","        )\n","\n","\n","        if condition_paths[\n","            \"success\"\n","        ].exists():\n","            action_label = \"REUSE\"\n","\n","        else:\n","            action_label = \"RUN\"\n","\n","\n","        print(\n","            \"\\n\"\