\n","SUCCESS: Paho MQTT 10% noise, seed 1 passed the complete pilot audit.\n"]}],"source":["# =========================================================\n","# PROJECT 4: PAHO MQTT\n","# PILOT CONDITION — 10% NOISE, SEED 1\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","PILOT_NOISE = 10\n","PILOT_SEED = 1\n","\n","EXPECTED_RANKING_ROWS = 6860\n","EXPECTED_BUILD_METRIC_ROWS = 140\n","EXPECTED_PROJECT_RUN_ROWS = 7\n","EXPECTED_FIT_TIME_ROWS = 4\n","EXPECTED_MANIFEST_ROWS = 9422\n","\n","EXPECTED_EVALUATION_ROWS_PER_TECHNIQUE = 980\n","EXPECTED_EVALUATION_BUILDS_PER_TECHNIQUE = 20\n","EXPECTED_FAILURES_PER_TECHNIQUE = 22\n","\n","\n","PILOT_CONDITION_DIRECTORY = (\n","    PROJECT_RAW_RESULTS\n","    / f\"noise_{PILOT_NOISE:03d}\"\n","    / f\"seed_{PILOT_SEED:02d}\"\n",")\n","\n","PILOT_AUDIT_PATH = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"paho_preflight\"\n","    / \"paho_10_percent_seed_01_pilot_audit.json\"\n",")\n","\n","PILOT_AUDIT_PATH.parent.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","required_files = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"rankings.parquet\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","]\n","\n","\n","print(\n","    \"=== PAHO MQTT PILOT: 10% NOISE, SEED 1 ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 1. Run the pilot or safely load an existing result\n","# ---------------------------------------------------------\n","\n","completion_marker = (\n","    PILOT_CONDITION_DIRECTORY\n","    / \"_SUCCESS.json\"\n",")\n","\n","\n","if completion_marker.exists():\n","\n","    print(\n","        \"A success marker already exists. \"\n","        \"Loading the saved pilot instead of rerunning it.\"\n","    )\n","\n","    missing_existing_files = [\n","        file_name\n","        for file_name in required_files\n","        if not (\n","            PILOT_CONDITION_DIRECTORY\n","            / file_name\n","        ).exists()\n","    ]\n","\n","    if missing_existing_files:\n","        raise RuntimeError(\n","            \"The existing pilot has a success marker \"\n","            \"but is missing files:\\n\"\n","            + \"\\n\".join(\n","                missing_existing_files\n","            )\n","        )\n","\n","\n","    rankings = pd.read_parquet(\n","        PILOT_CONDITION_DIRECTORY\n","        / \"rankings.parquet\"\n","    )\n","\n","    build_metrics = pd.read_parquet(\n","        PILOT_CONDITION_DIRECTORY\n","        / \"build_metrics.parquet\"\n","    )\n","\n","    project_run_metrics = pd.read_csv(\n","        PILOT_CONDITION_DIRECTORY\n","        / \"project_run_metrics.csv\"\n","    )\n","\n","    fit_times = pd.read_csv(\n","        PILOT_CONDITION_DIRECTORY\n","        / \"fit_times.csv\"\n","    )\n","\n","    noise_summary = pd.read_csv(\n","        PILOT_CONDITION_DIRECTORY\n","        / \"noise_summary.csv\"\n","    )\n","\n","    noise_manifest = pd.read_parquet(\n","        PILOT_CONDITION_DIRECTORY\n","        / \"noise_manifest.parquet\"\n","    )\n","\n","\n","else:\n","\n","    pilot_result = run_unified_condition(\n","        noise_percent=PILOT_NOISE,\n","        repetition_seed=PILOT_SEED,\n","        save_rankings=True,\n","        overwrite=False,\n","    )\n","\n","\n","    rankings = pilot_result[\n","        \"rankings\"\n","    ].copy()\n","\n","    build_metrics = pilot_result[\n","        \"build_metrics\"\n","    ].copy()\n","\n","    project_run_metrics = pilot_result[\n","        \"project_run_metrics\"\n","    ].copy()\n","\n","    fit_times = pilot_result[\n","        \"fit_times\"\n","    ].copy()\n","\n","    noise_summary = pilot_result[\n","        \"noise_summary\"\n","    ].copy()\n","\n","    noise_manifest = pd.read_parquet(\n","        PILOT_CONDITION_DIRECTORY\n","        / \"noise_manifest.parquet\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Verify every required output file\n","# ---------------------------------------------------------\n","\n","missing_files = [\n","    file_name\n","    for file_name in required_files\n","    if not (\n","        PILOT_CONDITION_DIRECTORY\n","        / file_name\n","    ).exists()\n","]\n","\n","\n","if missing_files:\n","    raise FileNotFoundError(\n","        \"The pilot condition is missing files:\\n\"\n","        + \"\\n\".join(\n","            missing_files\n","        )\n","    )\n","\n","\n","with open(\n","    completion_marker,\n","    \"r\",\n","    encoding=\"utf-8\",\n",") as marker_file:\n","\n","    completion_metadata = json.load(\n","        marker_file\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Structural row-count checks\n","# ---------------------------------------------------------\n","\n","if len(rankings) != EXPECTED_RANKING_ROWS:\n","    raise AssertionError(\n","        \"Unexpected ranking-row count: \"\n","        f\"{len(rankings)} instead of \"\n","        f\"{EXPECTED_RANKING_ROWS}.\"\n","    )\n","\n","\n","if len(build_metrics) != EXPECTED_BUILD_METRIC_ROWS:\n","    raise AssertionError(\n","        \"Unexpected build-metric row count: \"\n","        f\"{len(build_metrics)} instead of \"\n","        f\"{EXPECTED_BUILD_METRIC_ROWS}.\"\n","    )\n","\n","\n","if len(project_run_metrics) != EXPECTED_PROJECT_RUN_ROWS:\n","    raise AssertionError(\n","        \"Unexpected project-run row count: \"\n","        f\"{len(project_run_metrics)} instead of \"\n","        f\"{EXPECTED_PROJECT_RUN_ROWS}.\"\n","    )\n","\n","\n","if len(fit_times) != EXPECTED_FIT_TIME_ROWS:\n","    raise AssertionError(\n","        \"Expected four ML fit-time rows.\"\n","    )\n","\n","\n","if len(noise_summary) != 1:\n","    raise AssertionError(\n","        \"Expected one noise-summary row.\"\n","    )\n","\n","\n","if len(noise_manifest) != EXPECTED_MANIFEST_ROWS:\n","    raise AssertionError(\n","        \"Unexpected noise-manifest row count: \"\n","        f\"{len(noise_manifest)} instead of \"\n","        f\"{EXPECTED_MANIFEST_ROWS}.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Project, seed and noise identifiers\n","# ---------------------------------------------------------\n","\n","for condition_frame in [\n","    rankings,\n","    build_metrics,\n","    project_run_metrics,\n","    fit_times,\n","]:\n","\n","    if not (\n","        condition_frame[\n","            \"Project\"\n","        ] == PROJECT_NAME\n","    ).all():\n","\n","        raise AssertionError(\n","            \"A saved result contains the wrong project.\"\n","        )\n","\n","\n","    if not np.isclose(\n","        pd.to_numeric(\n","            condition_frame[\n","                \"NoisePercent\"\n","            ],\n","            errors=\"raise\",\n","        ).to_numpy(\n","            dtype=float\n","        ),\n","        float(\n","            PILOT_NOISE\n","        ),\n","        rtol=0.0,\n","        atol=0.0,\n","    ).all():\n","\n","        raise AssertionError(\n","            \"A saved result contains the wrong \"\n","            \"noise percentage.\"\n","        )\n","\n","\n","    if not (\n","        pd.to_numeric(\n","            condition_frame[\n","                \"RepetitionSeed\"\n","            ],\n","            errors=\"raise\",\n","        ).astype(int)\n","        == PILOT_SEED\n","    ).all():\n","\n","        raise AssertionError(\n","            \"A saved result contains the wrong seed.\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Technique-level coverage\n","# ---------------------------------------------------------\n","\n","expected_techniques = set(\n","    ML_TECHNIQUES\n","    + BASELINE_TECHNIQUES\n",")\n","\n","\n","actual_ranking_techniques = set(\n","    rankings[\n","        \"Technique\"\n","    ].unique()\n",")\n","\n","actual_metric_techniques = set(\n","    build_metrics[\n","        \"Technique\"\n","    ].unique()\n",")\n","\n","actual_project_run_techniques = set(\n","    project_run_metrics[\n","        \"Technique\"\n","    ].unique()\n",")\n","\n","\n","if actual_ranking_techniques != expected_techniques:\n","    raise AssertionError(\n","        \"Ranking technique set is incomplete.\"\n","    )\n","\n","\n","if actual_metric_techniques != expected_techniques:\n","    raise AssertionError(\n","        \"Build-metric technique set is incomplete.\"\n","    )\n","\n","\n","if actual_project_run_techniques != expected_techniques:\n","    raise AssertionError(\n","        \"Project-run technique set is incomplete.\"\n","    )\n","\n","\n","ranking_rows_per_technique = (\n","    rankings\n","    .groupby(\n","        \"Technique\"\n","    )\n","    .size()\n",")\n","\n","\n","if not (\n","    ranking_rows_per_technique\n","    == EXPECTED_EVALUATION_ROWS_PER_TECHNIQUE\n",").all():\n","\n","    raise AssertionError(\n","        \"At least one technique did not rank all \"\n","        \"980 evaluation rows.\"\n","    )\n","\n","\n","metric_builds_per_technique = (\n","    build_metrics\n","    .groupby(\n","        \"Technique\"\n","    )[\n","        \"Build\"\n","    ]\n","    .nunique()\n",")\n","\n","\n","if not (\n","    metric_builds_per_technique\n","    == EXPECTED_EVALUATION_BUILDS_PER_TECHNIQUE\n",").all():\n","\n","    raise AssertionError(\n","        \"At least one technique did not evaluate \"\n","        \"all 20 builds.\"\n","    )\n","\n","\n","if not (\n","    project_run_metrics[\n","        \"EvaluatedBuilds\"\n","    ] == EXPECTED_EVALUATION_BUILDS_PER_TECHNIQUE\n",").all():\n","\n","    raise AssertionError(\n","        \"Project-run metrics report an incorrect \"\n","        \"evaluated-build count.\"\n","    )\n","\n","\n","if not (\n","    project_run_metrics[\n","        \"TotalRankedTests\"\n","    ] == EXPECTED_EVALUATION_ROWS_PER_TECHNIQUE\n",").all():\n","\n","    raise AssertionError(\n","        \"Project-run metrics report an incorrect \"\n","        \"ranked-test count.\"\n","    )\n","\n","\n","if not (\n","    project_run_metrics[\n","        \"TotalFailures\"\n","    ] == EXPECTED_FAILURES_PER_TECHNIQUE\n",").all():\n","\n","    raise AssertionError(\n","        \"Project-run metrics report an incorrect \"\n","        \"failure count.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Ranking and metric integrity\n","# ---------------------------------------------------------\n","\n","if rankings.duplicated(\n","    [\n","        \"Technique\",\n","        \"Build\",\n","        \"Test\",\n","    ]\n",").any():\n","\n","    raise AssertionError(\n","        \"Duplicate ranked tests were found.\"\n","    )\n","\n","\n","if build_metrics.duplicated(\n","    [\n","        \"Technique\",\n","        \"Build\",\n","    ]\n",").any():\n","\n","    raise AssertionError(\n","        \"Duplicate build metrics were found.\"\n","    )\n","\n","\n","if rankings[\n","    \"Score\"\n","].isna().any():\n","\n","    raise AssertionError(\n","        \"Ranking scores contain missing values.\"\n","    )\n","\n","\n","if build_metrics[\n","    [\n","        \"APFD\",\n","        \"APFDc\",\n","    ]\n","].isna().any().any():\n","\n","    raise AssertionError(\n","        \"APFD or APFDc contains missing values.\"\n","    )\n","\n","\n","for metric_column in [\n","    \"APFD\",\n","    \"APFDc\",\n","]:\n","\n","    if not build_metrics[\n","        metric_column\n","    ].between(\n","        0.0,\n","        1.0,\n","        inclusive=\"both\",\n","    ).all():\n","\n","        raise AssertionError(\n","            f\"{metric_column} contains values \"\n","            \"outside [0, 1].\"\n","        )\n","\n","\n","for (\n","    technique,\n","    build_id,\n","), ranked_build in rankings.groupby(\n","    [\n","        \"Technique\",\n","        \"Build\",\n","    ]\n","):\n","\n","    ranked_build = (\n","        ranked_build\n","        .sort_values(\n","            \"Rank\",\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    expected_ranks = np.arange(\n","        1,\n","        len(ranked_build) + 1,\n","    )\n","\n","\n","    if not np.array_equal(\n","        ranked_build[\n","            \"Rank\"\n","        ].to_numpy(),\n","        expected_ranks,\n","    ):\n","\n","        raise AssertionError(\n","            \"Invalid ranking sequence for \"\n","            f\"{technique}, build {build_id}.\"\n","        )\n","\n","\n","    score_ascending = (\n","        technique == \"QTF-Avg\"\n","    )\n","\n","\n","    expected_order = (\n","        ranked_build\n","        .sort_values(\n","            [\n","                \"Score\",\n","                \"Test\",\n","            ],\n","            ascending=[\n","                score_ascending,\n","                True,\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    if not np.array_equal(\n","        ranked_build[\n","            \"Test\"\n","        ].to_numpy(),\n","        expected_order[\n","            \"Test\"\n","        ].to_numpy(),\n","    ):\n","\n","        raise AssertionError(\n","            \"Score/Test ordering rule failed for \"\n","            f\"{technique}, build {build_id}.\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Noise-manifest integrity\n","# ---------------------------------------------------------\n","\n","noise_manifest = (\n","    noise_manifest\n","    .sort_values(\n","        \"NoiseRowID\"\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","if not np.array_equal(\n","    noise_manifest[\n","        \"NoiseRowID\"\n","    ].to_numpy(),\n","    np.arange(\n","        EXPECTED_MANIFEST_ROWS\n","    ),\n","):\n","\n","    raise AssertionError(\n","        \"NoiseRowID sequence is invalid.\"\n","    )\n","\n","\n","expected_flip_mask = (\n","    noise_manifest[\n","        \"FlipUniform\"\n","    ].to_numpy(\n","        dtype=float\n","    )\n","    \u003c PILOT_NOISE / 100.0\n",")\n","\n","\n","actual_flip_mask = (\n","    noise_manifest[\n","        \"Flipped\"\n","    ].to_numpy(\n","        dtype=bool\n","    )\n",")\n","\n","\n","if not np.array_equal(\n","    expected_flip_mask,\n","    actual_flip_mask,\n","):\n","\n","    raise AssertionError(\n","        \"The saved flip mask does not match the \"\n","        \"10% common-uniform threshold.\"\n","    )\n","\n","\n","number_flipped = int(\n","    actual_flip_mask.sum()\n",")\n","\n","\n","summary_number_flipped = int(\n","    noise_summary.iloc[0][\n","        \"NumberFlipped\"\n","    ]\n",")\n","\n","\n","if number_flipped != summary_number_flipped:\n","    raise AssertionError(\n","        \"Noise manifest and noise summary disagree \"\n","        \"on the number of flips.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Completion-marker integrity\n","# ---------------------------------------------------------\n","\n","expected_marker_values = {\n","    \"CompletedSuccessfully\":\n","        True,\n","\n","    \"TrainingExecutionRows\":\n","        9422,\n","\n","    \"TrainingModelRows\":\n","        2320,\n","\n","    \"EvaluationModelRows\":\n","        980,\n","\n","    \"EvaluatedBuilds\":\n","        20,\n","\n","    \"TechniqueCount\":\n","        7,\n","\n","    \"RankingRows\":\n","        6860,\n","\n","    \"BuildMetricRows\":\n","        140,\n","\n","    \"EvaluationHashUnchanged\":\n","        True,\n","}\n","\n","\n","for marker_key, expected_value in (\n","    expected_marker_values.items()\n","):\n","\n","    actual_value = (\n","        completion_metadata.get(\n","            marker_key\n","        )\n","    )\n","\n","    if actual_value != expected_value:\n","        raise AssertionError(\n","            \"Completion-marker mismatch for \"\n","            f\"{marker_key}: expected \"\n","            f\"{expected_value}, found {actual_value}.\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Save pilot audit\n","# ---------------------------------------------------------\n","\n","pilot_audit_report = {\n","    \"Project\":\n","        PROJECT_NAME,\n","\n","    \"NoisePercent\":\n","        PILOT_NOISE,\n","\n","    \"RepetitionSeed\":\n","        PILOT_SEED,\n","\n","    \"Status\":\n","        \"PASS\",\n","\n","    \"ManifestRows\":\n","        int(\n","            len(\n","                noise_manifest\n","            )\n","        ),\n","\n","    \"NumberFlipped\":\n","        number_flipped,\n","\n","    \"RealisedNoisePercent\":\n","        float(\n","            noise_summary.iloc[0][\n","                \"RealisedNoisePercent\"\n","            ]\n","        ),\n","\n","    \"RankingRows\":\n","        int(\n","            len(\n","                rankings\n","            )\n","        ),\n","\n","    \"BuildMetricRows\":\n","        int(\n","            len(\n","                build_metrics\n","            )\n","        ),\n","\n","    \"ProjectRunRows\":\n","        int(\n","            len(\n","                project_run_metrics\n","            )\n","        ),\n","\n","    \"FitTimeRows\":\n","        int(\n","            len(\n","                fit_times\n","            )\n","        ),\n","\n","    \"TechniqueCount\":\n","        int(\n","            rankings[\n","                \"Technique\"\n","            ].nunique()\n","        ),\n","\n","    \"EvaluationBuildsPerTechnique\":\n","        EXPECTED_EVALUATION_BUILDS_PER_TECHNIQUE,\n","\n","    \"EvaluationRowsPerTechnique\":\n","        EXPECTED_EVALUATION_ROWS_PER_TECHNIQUE,\n","\n","    \"EvaluationFailuresPerTechnique\":\n","        EXPECTED_FAILURES_PER_TECHNIQUE,\n","\n","    \"EvaluationUnchanged\":\n","        bool(\n","            completion_metadata[\n","                \"EvaluationHashUnchanged\"\n","            ]\n","        ),\n","\n","    \"ConditionDirectory\":\n","        str(\n","            PILOT_CONDITION_DIRECTORY\n","        ),\n","}\n","\n","\n","with open(\n","    PILOT_AUDIT_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as audit_file:\n","\n","    json.dump(\n","        pilot_audit_report,\n","        audit_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Final pilot output\n","# ---------------------------------------------------------\n","\n","print(\n","    \"\\n=== PAHO MQTT PILOT AUDIT ===\"\n",")\n","\n","print(\n","    \"Manifest rows:\",\n","    len(noise_manifest),\n","    \"/\",\n","    EXPECTED_MANIFEST_ROWS,\n",")\n","\n","print(\n","    \"Noise flips:\",\n","    number_flipped,\n",")\n","\n","print(\n","    \"Realised noise:\",\n","    round(\n","        float(\n","            noise_summary.iloc[0][\n","                \"RealisedNoisePercent\"\n","            ]\n","        ),\n","        6,\n","    ),\n","    \"%\",\n",")\n","\n","print(\n","    \"Ranking rows:\",\n","    len(rankings),\n","    \"/\",\n","    EXPECTED_RANKING_ROWS,\n",")\n","\n","print(\n","    \"Build-metric rows:\",\n","    len(build_metrics),\n","    \"/\",\n","    EXPECTED_BUILD_METRIC_ROWS,\n",")\n","\n","print(\n","    \"Project-run rows:\",\n","    len(project_run_metrics),\n","    \"/\",\n","    EXPECTED_PROJECT_RUN_ROWS,\n",")\n","\n","print(\n","    \"Techniques:\",\n","    rankings[\n","        \"Technique\"\n","    ].nunique(),\n","    \"/ 7\",\n",")\n","\n","print(\n","    \"Evaluation rows per technique:\",\n","    ranking_rows_per_technique\n","    .unique()\n","    .tolist(),\n",")\n","\n","print(\n","    \"Evaluation builds per technique:\",\n","    metric_builds_per_technique\n","    .unique()\n","    .tolist(),\n",")\n","\n","print(\n","    \"Evaluation unchanged:\",\n","    completion_metadata[\n","        \"EvaluationHashUnchanged\"\n","    ],\n",")\n","\n","\n","print(\n","    \"\\nML fit times:\"\n",")\n","\n","display(\n","    fit_times[\n","        [\n","            \"Technique\",\n","            \"FitSeconds\",\n","            \"TrainingRows\",\n","            \"TrainingFailures\",\n","            \"TrainingPasses\",\n","            \"ActiveFeatures\",\n","        ]\n","    ]\n","    .sort_values(\n","        \"Technique\"\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","print(\n","    \"\\nPilot project-run results:\"\n",")\n","\n","display(\n","    project_run_metrics[\n","        [\n","            \"Technique\",\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","            \"SD_APFD\",\n","            \"SD_APFDc\",\n","            \"EvaluatedBuilds\",\n","            \"TotalRankedTests\",\n","            \"TotalFailures\",\n","        ]\n","    ]\n","    .sort_values(\n","        \"MeanAPFDc\",\n","        ascending=False,\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","print(\n","    \"\\nPilot audit saved:\"\n",")\n","\n","print(\n","    PILOT_AUDIT_PATH\n",")\n","\n","\n","print(\n","    \"\\nSUCCESS: Paho MQTT 10% noise, seed 1 \"\n","    \"passed the complete pilot audit.\"\n",")"]},{"cell_type":"code","execution_count":24,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":50,"status":"ok","timestamp":1784910199324,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"k3SKfsL78CdI","outputId":"372c0bf0-bcef-4250-c615-af86e7293adc"},"outputs":[{"name":"stdout","output_type":"stream","text":["Runner available: True\n"]}],"source":["print(\n","    \"Runner available:\",\n","    \"run_unified_condition\" in globals()\n",")"]},{"cell_type":"code","execution_count":25,"metada