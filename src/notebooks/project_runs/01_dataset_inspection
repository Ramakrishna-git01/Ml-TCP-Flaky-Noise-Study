\n\"\n","        f\"Observed: {len(clean_model_evaluation_data)}\"\n","    )\n","\n","\n","print(\n","    \"=== TITAN SEVEN-TECHNIQUE SMOKE TEST SETUP ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Permanent output paths\n","# ---------------------------------------------------------\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n",")\n","\n","LOGS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Logs\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","\n","PROJECT_RAW_RESULTS = (\n","    RAW_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_LOGS = (\n","    LOGS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","\n","for directory in [\n","    RAW_RESULTS_DRIVE,\n","    AGGREGATED_RESULTS_DRIVE,\n","    LOGS_DRIVE,\n","    NOTES_DRIVE,\n","    PROJECT_RAW_RESULTS,\n","    PROJECT_AGGREGATED_RESULTS,\n","    PROJECT_LOGS,\n","]:\n","    directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","SMOKE_NOISE_PERCENT = 0\n","SMOKE_REPETITION_SEED = 1\n","\n","\n","CONDITION_DIRECTORY = (\n","    PROJECT_RAW_RESULTS\n","    / \"noise_000\"\n","    / \"seed_01\"\n",")\n","\n","CONDITION_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","COMPLETION_MARKER = (\n","    CONDITION_DIRECTORY\n","    / \"_SUCCESS.json\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Technique configuration\n","# ---------------------------------------------------------\n","\n","ML_TECHNIQUES = [\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","]\n","\n","\n","BASELINE_TECHNIQUES = [\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","]\n","\n","\n","ALL_TECHNIQUES = (\n","    ML_TECHNIQUES\n","    + BASELINE_TECHNIQUES\n",")\n","\n","\n","MODEL_CONFIG = {\n","    \"RandomForest\": {\n","        \"n_estimators\":\n","            100,\n","\n","        \"criterion\":\n","            \"gini\",\n","\n","        \"max_depth\":\n","            None,\n","\n","        \"min_samples_split\":\n","            2,\n","\n","        \"min_samples_leaf\":\n","            1,\n","\n","        \"max_features\":\n","            \"sqrt\",\n","\n","        \"bootstrap\":\n","            True,\n","\n","        \"class_weight\":\n","            None,\n","    },\n","\n","    \"XGBoost\": {\n","        \"n_estimators\":\n","            100,\n","\n","        \"max_depth\":\n","            6,\n","\n","        \"learning_rate\":\n","            0.1,\n","\n","        \"subsample\":\n","            1.0,\n","\n","        \"colsample_bytree\":\n","            1.0,\n","\n","        \"objective\":\n","            \"binary:logistic\",\n","\n","        \"eval_metric\":\n","            \"logloss\",\n","\n","        \"tree_method\":\n","            \"hist\",\n","    },\n","\n","    \"LightGBM\": {\n","        \"n_estimators\":\n","            100,\n","\n","        \"learning_rate\":\n","            0.1,\n","\n","        \"num_leaves\":\n","            31,\n","\n","        \"objective\":\n","            \"binary\",\n","    },\n","\n","    \"NaiveBayes\": {\n","        \"variant\":\n","            \"GaussianNB\",\n","\n","        \"var_smoothing\":\n","            1e-9,\n","    },\n","}\n","\n","\n","PACKAGE_VERSIONS = {\n","    \"Python\":\n","        platform.python_version(),\n","\n","    \"NumPy\":\n","        np.__version__,\n","\n","    \"pandas\":\n","        pd.__version__,\n","\n","    \"scikit-learn\":\n","        sklearn.__version__,\n","\n","    \"XGBoost\":\n","        xgboost.__version__,\n","\n","    \"LightGBM\":\n","        lightgbm.__version__,\n","}\n","\n","\n","# ---------------------------------------------------------\n","# 5. Stable DataFrame hash\n","# ---------------------------------------------------------\n","\n","def smoke_dataframe_sha256(\n","    dataframe,\n","):\n","    hashed_values = (\n","        pd.util.hash_pandas_object(\n","            dataframe,\n","            index=True,\n","        )\n","        .to_numpy(\n","            dtype=np.uint64\n","        )\n","    )\n","\n","\n","    return hashlib.sha256(\n","        hashed_values.tobytes()\n","    ).hexdigest()\n","\n","\n","evaluation_audit_columns = [\n","    \"Build\",\n","    \"Test\",\n","    \"Verdict\",\n","    \"Duration\",\n","    *REC_FEATURE_COLUMNS,\n","]\n","\n","\n","EVALUATION_HASH_BEFORE = (\n","    smoke_dataframe_sha256(\n","        clean_model_evaluation_data[\n","            evaluation_audit_columns\n","        ]\n","    )\n",")\n","\n","\n","RAW_EVALUATION_HASH_BEFORE = (\n","    smoke_dataframe_sha256(\n","        clean_evaluation_history\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Freeze active predictor columns\n","# ---------------------------------------------------------\n","\n","missing_model_features = [\n","    feature\n","    for feature in MODEL_FEATURE_COLUMNS\n","    if feature\n","    not in clean_model_training_data.columns\n","]\n","\n","\n","if missing_model_features:\n","    raise KeyError(\n","        \"Model-training data is missing predictors:\\n\"\n","        + \"\\n\".join(\n","            missing_model_features\n","        )\n","    )\n","\n","\n","missing_evaluation_features = [\n","    feature\n","    for feature in MODEL_FEATURE_COLUMNS\n","    if feature\n","    not in clean_model_evaluation_data.columns\n","]\n","\n","\n","if missing_evaluation_features:\n","    raise KeyError(\n","        \"Model-evaluation data is missing predictors:\\n\"\n","        + \"\\n\".join(\n","            missing_evaluation_features\n","        )\n","    )\n","\n","\n","clean_feature_frame = (\n","    clean_model_training_data[\n","        MODEL_FEATURE_COLUMNS\n","    ]\n","    .apply(\n","        pd.to_numeric,\n","        errors=\"coerce\",\n","    )\n","    .replace(\n","        [\n","            np.inf,\n","            -np.inf,\n","        ],\n","        np.nan,\n","    )\n",")\n","\n","\n","feature_variation = (\n","    clean_feature_frame\n","    .nunique(\n","        dropna=False\n","    )\n",")\n","\n","\n","ZERO_VARIANCE_FEATURES = (\n","    feature_variation[\n","        feature_variation \u003c= 1\n","    ]\n","    .index\n","    .tolist()\n",")\n","\n","\n","ACTIVE_FEATURE_COLUMNS = [\n","    feature\n","    for feature in MODEL_FEATURE_COLUMNS\n","    if feature\n","    not in ZERO_VARIANCE_FEATURES\n","]\n","\n","\n","if len(ACTIVE_FEATURE_COLUMNS) == 0:\n","    raise AssertionError(\n","        \"No active predictor columns remain.\"\n","    )\n","\n","\n","print(\n","    \"\\n=== TITAN FEATURE PROTOCOL ===\"\n",")\n","\n","print(\n","    \"Original predictor columns:\",\n","    len(MODEL_FEATURE_COLUMNS),\n",")\n","\n","print(\n","    \"Frozen zero-variance columns:\",\n","    len(ZERO_VARIANCE_FEATURES),\n",")\n","\n","print(\n","    \"Active predictor columns:\",\n","    len(ACTIVE_FEATURE_COLUMNS),\n",")\n","\n","\n","if ZERO_VARIANCE_FEATURES:\n","    print(\n","        \"\\nZero-variance predictors:\"\n","    )\n","\n","    for feature in ZERO_VARIANCE_FEATURES:\n","        print(\n","            \" -\",\n","            feature,\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Save frozen model configuration\n","# ---------------------------------------------------------\n","\n","MODEL_CONFIGURATION_PATH = (\n","    NOTES_DRIVE\n","    / (\n","        \"thinkaurelius__titan_\"\n","        \"model_configuration_fixed_v1.json\"\n","    )\n",")\n","\n","\n","model_configuration_report = {\n","    \"ProjectNumber\":\n","        PROJECT_NUMBER,\n","\n","    \"Project\":\n","        PROJECT_NAME,\n","\n","    \"ProjectSlug\":\n","        PROJECT_SLUG,\n","\n","    \"OriginalPredictorCount\":\n","        len(\n","            MODEL_FEATURE_COLUMNS\n","        ),\n","\n","    \"ZeroVariancePredictorCount\":\n","        len(\n","            ZERO_VARIANCE_FEATURES\n","        ),\n","\n","    \"ZeroVariancePredictors\":\n","        ZERO_VARIANCE_FEATURES,\n","\n","    \"ActivePredictorCount\":\n","        len(\n","            ACTIVE_FEATURE_COLUMNS\n","        ),\n","\n","    \"ActivePredictors\":\n","        ACTIVE_FEATURE_COLUMNS,\n","\n","    \"MissingValueRule\":\n","        (\n","            \"Learn median from the current noisy \"\n","            \"training condition and apply it to both \"\n","            \"training and clean evaluation matrices.\"\n","        ),\n","\n","    \"InfiniteValueRule\":\n","        (\n","            \"Replace positive and negative infinity \"\n","            \"with missing before median imputation.\"\n","        ),\n","\n","    \"TieRule\":\n","        \"Score first, then Test ascending.\",\n","\n","    \"Models\":\n","        MODEL_CONFIG,\n","\n","    \"PackageVersions\":\n","        PACKAGE_VERSIONS,\n","\n","    \"SavedAtUTC\":\n","        pd.Timestamp.utcnow().isoformat(),\n","}\n","\n","\n","with open(\n","    MODEL_CONFIGURATION_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as configuration_file:\n","    json.dump(\n","        model_configuration_report,\n","        configuration_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Prepare shared ML matrices\n","# ---------------------------------------------------------\n","\n","def prepare_ml_matrices(\n","    noisy_training_data,\n","    evaluation_data,\n","):\n","    X_train = (\n","        noisy_training_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [\n","                np.inf,\n","                -np.inf,\n","            ],\n","            np.nan,\n","        )\n","    )\n","\n","\n","    X_evaluation = (\n","        evaluation_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [\n","                np.inf,\n","                -np.inf,\n","            ],\n","            np.nan,\n","        )\n","    )\n","\n","\n","    training_medians = (\n","        X_train\n","        .median(axis=0)\n","        .fillna(0.0)\n","    )\n","\n","\n","    X_train = (\n","        X_train\n","        .fillna(\n","            training_medians\n","        )\n","        .astype(float)\n","    )\n","\n","\n","    X_evaluation = (\n","        X_evaluation\n","        .fillna(\n","            training_medians\n","        )\n","        .astype(float)\n","    )\n","\n","\n","    y_train = (\n","        noisy_training_data[\n","            \"Verdict\"\n","        ] != 0\n","    ).astype(int)\n","\n","\n","    if y_train.nunique() != 2:\n","        raise AssertionError(\n","            \"The training labels do not contain \"\n","            \"both binary classes.\"\n","        )\n","\n","\n","    if X_train.shape != (\n","        len(noisy_training_data),\n","        len(ACTIVE_FEATURE_COLUMNS),\n","    ):\n","        raise AssertionError(\n","            \"Unexpected training-matrix shape.\"\n","        )\n","\n","\n","    if X_evaluation.shape != (\n","        len(evaluation_data),\n","        len(ACTIVE_FEATURE_COLUMNS),\n","    ):\n","        raise AssertionError(\n","            \"Unexpected evaluation-matrix shape.\"\n","        )\n","\n","\n","    if X_train.isna().any().any():\n","        raise AssertionError(\n","            \"Training features still contain \"\n","            \"missing values.\"\n","        )\n","\n","\n","    if X_evaluation.isna().any().any():\n","        raise AssertionError(\n","            \"Evaluation features still contain \"\n","            \"missing values.\"\n","        )\n","\n","\n","    if not np.isfinite(\n","        X_train.to_numpy(dtype=float)\n","    ).all():\n","        raise AssertionError(\n","            \"Training features contain non-finite values.\"\n","        )\n","\n","\n","    if not np.isfinite(\n","        X_evaluation.to_numpy(dtype=float)\n","    ).all():\n","        raise AssertionError(\n","            \"Evaluation features contain \"\n","            \"non-finite values.\"\n","        )\n","\n","\n","    return (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Create four frozen ML models\n","# ---------------------------------------------------------\n","\n","def create_ml_models(\n","    repetition_seed,\n","):\n","    rf_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"RandomForest_model\",\n","    )\n","\n","\n","    xgb_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"XGBoost_model\",\n","    )\n","\n","\n","    lgbm_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"LightGBM_model\",\n","    )\n","\n","\n","    models = {\n","        \"RandomForest\":\n","            RandomForestClassifier(\n","                **MODEL_CONFIG[\n","                    \"RandomForest\"\n","                ],\n","                random_state=rf_seed,\n","                n_jobs=-1,\n","            ),\n","\n","        \"XGBoost\":\n","            XGBClassifier(\n","                **MODEL_CONFIG[\n","                    \"XGBoost\"\n","                ],\n","                random_state=xgb_seed,\n","                n_jobs=-1,\n","                verbosity=0,\n","            ),\n","\n","        \"LightGBM\":\n","            LGBMClassifier(\n","                **MODEL_CONFIG[\n","                    \"LightGBM\"\n","                ],\n","                random_state=lgbm_seed,\n","                n_jobs=-1,\n","                verbosity=-1,\n","                deterministic=True,\n","                force_col_wise=True,\n","            ),\n","\n","        \"NaiveBayes\":\n","            GaussianNB(\n","                var_smoothing=(\n","                    MODEL_CONFIG[\n","                        \"NaiveBayes\"\n","                    ][\n","                        \"var_smoothing\"\n","                    ]\n","                )\n","            ),\n","    }\n","\n","\n","    model_seeds = {\n","        \"RandomForest\":\n","            int(rf_seed),\n","\n","        \"XGBoost\":\n","            int(xgb_seed),\n","\n","        \"LightGBM\":\n","            int(lgbm_seed),\n","\n","        \"NaiveBayes\":\n","            None,\n","    }\n","\n","\n","    return (\n","        models,\n","        model_seeds,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Obtain positive-class probabilities\n","# ---------------------------------------------------------\n","\n","def get_failure_probability(\n","    fitted_model,\n","    feature_matrix,\n","):\n","    probabilities = (\n","        fitted_model\n","        .predict_proba(\n","            feature_matrix\n","        )\n","    )\n","\n","\n","    classes = np.asarray(\n","        fitted_model.classes_\n","    )\n","\n","\n","    positive_positions = np.where(\n","        classes == 1\n","    )[0]\n","\n","\n","    if len(positive_positions) != 1:\n","        raise AssertionError(\n","            \"Could not identify binary failure class 1.\"\n","        )\n","\n","\n","    failure_probabilities = (\n","        probabilities[\n","            :,\n","            positive_positions[0],\n","        ]\n","    )\n","\n","\n","    if len(failure_probabilities) != len(\n","        feature_matrix\n","    ):\n","        raise AssertionError(\n","            \"Probability-row count mismatch.\"\n","        )\n","\n","\n","    if not np.isfinite(\n","        failure_probabilities\n","    ).all():\n","        raise AssertionError(\n","            \"A model produced a non-finite \"\n","            \"failure probability.\"\n","        )\n","\n","\n","    if not (\n","        (\n","            failure_probabilities \u003e= 0.0\n","        )\n","        \u0026 (\n","            failure_probabilities \u003c= 1.0\n","        )\n","    ).all():\n","        raise AssertionError(\n","            \"A model probability lies outside [0, 1].\"\n","        )\n","\n","\n","    return failure_probabilities\n","\n","\n","# ---------------------------------------------------------\n","# 11. Rank one evaluation build\n","# ---------------------------------------------------------\n","\n","def rank_build_rows(\n","    build_rows,\n","    scores,\n","    technique,\n","    score_direction=\"descending\",\n","):\n","    ranked = (\n","        build_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"Duration\",\n","                \"build_order\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    ranked[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        ranked[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    ranked[\n","        \"Test\"\n","    ] = (\n","        ranked[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    ranked[\n","        \"Verdict\"\n","    ] = pd.to_numeric(\n","        ranked[\n","            \"Verdict\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int8\")\n","\n","\n","    ranked[\n","        \"Duration\"\n","    ] = pd.to_numeric(\n","        ranked[\n","            \"Duration\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(float)\n","\n","\n","    score_array = np.asarray(\n","        scores,\n","        dtype=float,\n","    )\n","\n","\n","    if len(ranked) != len(\n","        score_array\n","    ):\n","        raise AssertionError(\n","            \"Score count does not match test count.\"\n","        )\n","\n","\n","    if np.isnan(\n","        score_array\n","    ).any():\n","        raise AssertionError(\n","            f\"{technique} produced a missing score.\"\n","        )\n","\n","\n","    if (\n","        technique != \"QTF-Avg\"\n","        and not np.isfinite(\n","            score_array\n","        ).all()\n","    ):\n","        raise AssertionError(\n","            f\"{technique} produced a non-finite score.\"\n","        )\n","\n","\n","    ranked[\n","        \"Technique\"\n","    ] = technique\n","\n","\n","    ranked[\n","        \"Score\"\n","    ] = score_array\n","\n","\n","    ranked[\n","        \"ActualFailure\"\n","    ] = (\n","        ranked[\n","            \"Verdict\"\n","        ] != 0\n","    ).astype(int)\n","\n","\n","    if score_direction == \"descending\":\n","        ascending = [\n","            False,\n","            True,\n","        ]\n","\n","    elif score_direction == \"ascending\":\n","        ascending = [\n","            True,\n","            True,\n","        ]\n","\n","    else:\n","        raise ValueError(\n","            \"score_direction must be ascending \"\n","            \"or descending.\"\n","        )\n","\n","\n","    ranked = (\n","        ranked\n","        .sort_values(\n","            [\n","                \"Score\",\n","                \"Test\",\n","            ],\n","            ascending=ascending,\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    ranked[\n","        \"Rank\"\n","    ] = np.arange(\n","        1,\n","        len(ranked) + 1,\n","        dtype=np.int64,\n","    )\n","\n","\n","    return ranked\n","\n","\n","# ---------------------------------------------------------\n","# 12. Create ML rankings\n","# ---------------------------------------------------------\n","\n","def create_ml_rankings(\n","    evaluation_data,\n","    technique,\n","    failure_probabilities,\n","):\n","    scored_data = (\n","        evaluation_data.copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    scored_data[\n","        \"_FailureProbability\"\n","    ] = np.asarray(\n","        failure_probabilities,\n","        dtype=float,\n","    )\n","\n","\n","    ranking_frames = []\n","\n","\n","    for _, build_rows in (\n","        scored_data.groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","        ranking_frames.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","\n","                scores=(\n","                    build_rows[\n","                        \"_FailureProbability\"\n","                    ].to_numpy(dtype=float)\n","                ),\n","\n","                technique=technique,\n","\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","\n","    return pd.concat(\n","        ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. Random baseline\n","# ---------------------------------------------------------\n","\n","def create_random_rankings(\n","    evaluation_data,\n","    repetition_seed,\n","):\n","    ranking_frames = []\n","\n","\n","    for build_id, build_rows in (\n","        evaluation_data.groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","        random_rng = np.random.default_rng(\n","            stable_project_seed(\n","                PROJECT_NAME,\n","                repetition_seed,\n","                (\n","                    \"Random_baseline_build_\"\n","                    f\"{int(build_id)}\"\n","                ),\n","            )\n","        )\n","\n","\n","        random_scores = (\n","            random_rng.random(\n","                len(build_rows)\n","            )\n","        )\n","\n","\n","        ranking_frames.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","\n","                scores=random_scores,\n","\n","                technique=\"Random\",\n","\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","\n","    return pd.concat(\n","        ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 14. Deterministic execution-history sorting\n","# ---------------------------------------------------------\n","\n","def sort_raw_execution_history(\n","    history,\n","):\n","    sorted_history = (\n","        history.copy()\n","    )\n","\n","\n","    sorted_history[\n","        \"build_order\"\n","    ] = pd.to_numeric(\n","        sorted_history[\n","            \"build_order\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    sorted_history[\n","        \"test\"\n","    ] = (\n","        sorted_history[\n","            \"test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    if \"_JobSort\" not in sorted_history.columns:\n","        if \"job\" in sorted_history.columns:\n","            sorted_history[\n","                \"_JobSort\"\n","            ] = (\n","                sorted_history[\n","                    \"job\"\n","                ].astype(str)\n","            )\n","\n","        else:\n","            sorted_history[\n","                \"_JobSort\"\n","            ] = \"\"\n","\n","\n","    if \"_OriginalExecutionOrder\" not in (\n","        sorted_history.columns\n","    ):\n","        sorted_history[\n","            \"_OriginalExecutionOrder\"\n","        ] = np.arange(\n","            len(sorted_history),\n","            dtype=np.int64,\n","        )\n","\n","\n","    return (\n","        sorted_history\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"_JobSort\",\n","                \"test\",\n","                \"_OriginalExecutionOrder\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 15. Initialise LatestFail and QTF-Avg\n","# ---------------------------------------------------------\n","\n","def initialise_history_baselines(\n","    noisy_training_history,\n","):\n","    latest_failure_order = {}\n","\n","\n","    noisy_history_sorted = (\n","        sort_raw_execution_history(\n","            noisy_training_history\n","        )\n","    )\n","\n","\n","    for row in (\n","        noisy_history_sorted.itertuples(\n","            index=False\n","        )\n","    ):\n","        test_key = str(\n","            row.test\n","        )\n","\n","\n","        if int(\n","            row.verdict\n","        ) != 0:\n","            latest_failure_order[\n","                test_key\n","            ] = int(\n","                row.build_order\n","            )\n","\n","\n","    duration_sum = {}\n","    duration_count = {}\n","\n","\n","    clean_duration_history = (\n","        sort_raw_execution_history(\n","            clean_training_history\n","        )\n","    )\n","\n","\n","    for row in (\n","        clean_duration_history.itertuples(\n","            index=False\n","        )\n","    ):\n","        test_key = str(\n","            row.test\n","        )\n","\n","\n","        duration = float(\n","            row.duration\n","        )\n","\n","\n","        if not np.isfinite(\n","            duration\n","        ):\n","            continue\n","\n","\n","        duration_sum[\n","            test_key\n","        ] = (\n","            duration_sum.get(\n","                test_key,\n","                0.0,\n","            )\n","            + duration\n","        )\n","\n","\n","        duration_count[\n","            test_key\n","        ] = (\n","            duration_count.get(\n","                test_key,\n","                0,\n","            )\n","            + 1\n","        )\n","\n","\n","    return (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 16. LatestFail and QTF-Avg rankings\n","# ---------------------------------------------------------\n","\n","def create_history_baseline_rankings(\n","    noisy_training_history,\n","):\n","    (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    ) = initialise_history_baselines(\n","        noisy_training_history\n","    )\n","\n","\n","    evaluation_data = (\n","        clean_model_evaluation_data.copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    evaluation_data[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        evaluation_data[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    evaluation_data[\n","        \"Test\"\n","    ] = (\n","        evaluation_data[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    target_build_ids = set(\n","        evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","\n","    raw_evaluation_by_build = {\n","        int(build_id):\n","            sort_raw_execution_history(\n","                build_rows\n","            )\n","\n","        for build_id, build_rows\n","        in clean_evaluation_history.groupby(\n","            \"build\",\n","            sort=False,\n","        )\n","    }\n","\n","\n","    model_evaluation_by_build = {\n","        int(build_id):\n","            build_rows.copy()\n","\n","        for build_id, build_rows\n","        in evaluation_data.groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    }\n","\n","\n","    ordered_evaluation_builds = (\n","        builds[\n","            builds[\n","                \"partition\"\n","            ] == \"evaluation\"\n","        ][\n","            [\n","                \"build\",\n","                \"build_order\",\n","            ]\n","        ]\n","        .drop_duplicates(\n","            subset=[\n","                \"build\",\n","            ]\n","        )\n","        .sort_values(\n","            \"build_order\",\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    if len(\n","        ordered_evaluation_builds\n","    ) != 96:\n","        raise AssertionError(\n","            \"Expected 96 evaluation-period builds.\\n\"\n","            f\"Observed: {len(ordered_evaluation_builds)}\"\n","        )\n","\n","\n","    latest_fail_frames = []\n","    qtf_frames = []\n","\n","\n","    for build_row in (\n","        ordered_evaluation_builds.itertuples(\n","            index=False\n","        )\n","    ):\n","        build_id = int(\n","            build_row.build\n","        )\n","\n","\n","        # Rank before seeing current-build outcomes.\n","        if build_id in target_build_ids:\n","            build_tests = (\n","                model_evaluation_by_build[\n","                    build_id\n","                ]\n","                .copy()\n","            )\n","\n","\n","            latest_scores = []\n","            qtf_average_scores = []\n","\n","\n","            for test_value in (\n","                build_tests[\n","                    \"Test\"\n","                ]\n","            ):\n","                test_key = str(\n","                    test_value\n","                )\n","\n","\n","                latest_scores.append(\n","                    float(\n","                        latest_failure_order.get(\n","                            test_key,\n","                            -1,\n","                        )\n","                    )\n","                )\n","\n","\n","                count = duration_count.get(\n","                    test_key,\n","                    0,\n","                )\n","\n","\n","                if count \u003e 0:\n","                    average_duration = (\n","                        duration_sum[\n","                            test_key\n","                        ]\n","                        / count\n","                    )\n","\n","                else:\n","                    average_duration = np.inf\n","\n","\n","                qtf_average_scores.append(\n","                    float(\n","                        average_duration\n","                    )\n","                )\n","\n","\n","            latest_fail_frames.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","\n","                    scores=latest_scores,\n","\n","                    technique=\"LatestFail\",\n","\n","                    score_direction=\"descending\",\n","                )\n","            )\n","\n","\n","            qtf_frames.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","\n","                    scores=qtf_average_scores,\n","\n","                    technique=\"QTF-Avg\",\n","\n","                    score_direction=\"ascending\",\n","                )\n","            )\n","\n","\n","        # Update only after the ranking is produced.\n","        current_raw_rows = (\n","            raw_evaluation_by_build.get(\n","                build_id\n","            )\n","        )\n","\n","\n","        if current_raw_rows is None:\n","            continue\n","\n","\n","        for execution_row in (\n","            current_raw_rows.itertuples(\n","                index=False\n","            )\n","        ):\n","            test_key = str(\n","                execution_row.test\n","            )\n","\n","\n","            if int(\n","                execution_row.verdict\n","            ) != 0:\n","                latest_failure_order[\n","                    test_key\n","                ] = int(\n","                    execution_row.build_order\n","                )\n","\n","\n","            duration = float(\n","                execution_row.duration\n","            )\n","\n","\n","            if np.isfinite(\n","                duration\n","            ):\n","                duration_sum[\n","                    test_key\n","                ] = (\n","                    duration_sum.get(\n","                        test_key,\n","                        0.0,\n","                    )\n","                    + duration\n","                )\n","\n","\n","                duration_count[\n","                    test_key\n","                ] = (\n","                    duration_count.get(\n","                        test_key,\n","                        0,\n","                    )\n","                    + 1\n","                )\n","\n","\n","    if len(\n","        latest_fail_frames\n","    ) != 10:\n","        raise AssertionError(\n","            \"LatestFail did not rank all 10 scored \"\n","            \"evaluation builds.\"\n","        )\n","\n","\n","    if len(\n","        qtf_frames\n","    ) != 10:\n","        raise AssertionError(\n","            \"QTF-Avg did not rank all 10 scored \"\n","            \"evaluation builds.\"\n","        )\n","\n","\n","    return (\n","        pd.concat(\n","            latest_fail_frames,\n","            ignore_index=True,\n","        ),\n","\n","        pd.concat(\n","            qtf_frames,\n","            ignore_index=True,\n","        ),\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 17. Calculate build-level APFD and APFDc\n","# ---------------------------------------------------------\n","\n","def calculate_build_metrics(\n","    all_rankings,\n","    noise_percent,\n","    repetition_seed,\n","):\n","    metric_records = []\n","\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in (\n","        all_rankings.groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ],\n","            sort=False,\n","        )\n","    ):\n","        ranked_build = (\n","            ranked_build\n","            .sort_values(\n","                \"Rank\",\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        actual_failures = (\n","            ranked_build[\n","                \"ActualFailure\"\n","            ]\n","            .to_numpy(dtype=int)\n","        )\n","\n","\n","        durations = (\n","            ranked_build[\n","                \"Duration\"\n","            ]\n","            .to_numpy(dtype=float)\n","        )\n","\n","\n","        number_of_tests = int(\n","            len(ranked_build)\n","        )\n","\n","\n","        number_of_failures = int(\n","            actual_failures.sum()\n","        )\n","\n","\n","        apfd = calculate_apfd(\n","            actual_failures\n","        )\n","\n","\n","        apfdc = calculate_apfdc(\n","            actual_failures,\n","            durations,\n","        )\n","\n","\n","        metric_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"NoisePercent\":\n","                float(noise_percent),\n","\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","\n","            \"Technique\":\n","                str(technique),\n","\n","            \"Build\":\n","                int(build_id),\n","\n","            \"BuildOrder\":\n","                int(\n","                    ranked_build[\n","                        \"build_order\"\n","                    ].iloc[0]\n","                ),\n","\n","            \"NumberOfTests\":\n","                number_of_tests,\n","\n","            \"NumberOfFailures\":\n","                number_of_failures,\n","\n","            \"APFD\":\n","                float(apfd),\n","\n","            \"APFDc\":\n","                float(apfdc),\n","        })\n","\n","\n","    return pd.DataFrame(\n","        metric_records\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 18. Validate condition rankings and metrics\n","# ---------------------------------------------------------\n","\n","def validate_condition_outputs(\n","    rankings,\n","    build_metrics,\n","):\n","    expected_techniques = set(\n","        ALL_TECHNIQUES\n","    )\n","\n","\n","    actual_techniques = set(\n","        rankings[\n","            \"Technique\"\n","        ].astype(str).unique()\n","    )\n","\n","\n","    if actual_techniques != expected_techniques:\n","        raise AssertionError(\n","            \"Technique mismatch.\\n\"\n","            f\"Expected: {sorted(expected_techniques)}\\n\"\n","            f\"Observed: {sorted(actual_techniques)}\"\n","        )\n","\n","\n","    expected_build_ids = set(\n","        clean_model_evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","\n","    if len(\n","        expected_build_ids\n","    ) != 10:\n","        raise AssertionError(\n","            \"Expected 10 scored evaluation builds.\"\n","        )\n","\n","\n","    metric_build_ids = set(\n","        build_metrics[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","\n","    if metric_build_ids != expected_build_ids:\n","        raise AssertionError(\n","            \"Not all scored evaluation builds \"\n","            \"received metrics.\"\n","        )\n","\n","\n","    expected_ranking_rows = (\n","        len(\n","            clean_model_evaluation_data\n","        )\n","        * len(\n","            ALL_TECHNIQUES\n","        )\n","    )\n","\n","\n","    expected_metric_rows = (\n","        len(\n","            expected_build_ids\n","        )\n","        * len(\n","            ALL_TECHNIQUES\n","        )\n","    )\n","\n","\n","    if len(rankings) != expected_ranking_rows:\n","        raise AssertionError(\n","            \"Unexpected ranking-row count.\\n\"\n","            f\"Expected: {expected_ranking_rows}\\n\"\n","            f\"Observed: {len(rankings)}\"\n","        )\n","\n","\n","    if len(build_metrics) != expected_metric_rows:\n","        raise AssertionError(\n","            \"Unexpected build-metric row count.\\n\"\n","            f\"Expected: {expected_metric_rows}\\n\"\n","            f\"Observed: {len(build_metrics)}\"\n","        )\n","\n","\n","    if build_metrics.duplicated(\n","        subset=[\n","            \"Technique\",\n","            \"Build\",\n","        ]\n","    ).any():\n","        raise AssertionError(\n","            \"Duplicate Technique-Build metric rows exist.\"\n","        )\n","\n","\n","    if build_metrics[\n","        [\n","            \"APFD\",\n","            \"APFDc\",\n","        ]\n","    ].isna().any().any():\n","        raise AssertionError(\n","            \"APFD or APFDc contains missing values.\"\n","        )\n","\n","\n","    for metric in [\n","        \"APFD\",\n","        \"APFDc\",\n","    ]:\n","        if not build_metrics[\n","            metric\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","            raise AssertionError(\n","                f\"{metric} contains values \"\n","                \"outside [0, 1].\"\n","            )\n","\n","\n","    if (\n","        build_metrics[\n","            \"NumberOfFailures\"\n","        ] \u003c= 0\n","    ).any():\n","        raise AssertionError(\n","            \"A scored evaluation build has no failures.\"\n","        )\n","\n","\n","    expected_tests_by_build = {\n","        int(build_id):\n","            set(\n","                rows[\n","                    \"Test\"\n","                ].astype(str)\n","            )\n","\n","        for build_id, rows\n","        in clean_model_evaluation_data.groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    }\n","\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in (\n","        rankings.groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ],\n","            sort=False,\n","        )\n","    ):\n","        ranked_build = (\n","            ranked_build\n","            .sort_values(\n","                \"Rank\",\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        expected_ranks = np.arange(\n","            1,\n","            len(ranked_build) + 1,\n","            dtype=np.int64,\n","        )\n","\n","\n","        actual_ranks = (\n","            ranked_build[\n","                \"Rank\"\n","            ].to_numpy(dtype=np.int64)\n","        )\n","\n","\n","        if not np.array_equal(\n","            actual_ranks,\n","            expected_ranks,\n","        ):\n","            raise AssertionError(\n","                \"Invalid ranking sequence for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","\n","        if ranked_build[\n","            \"Test\"\n","        ].duplicated().any():\n","            raise AssertionError(\n","                \"Duplicate tests in ranking for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","\n","        actual_test_set = set(\n","            ranked_build[\n","                \"Test\"\n","            ].astype(str)\n","        )\n","\n","\n","        if actual_test_set != (\n","            expected_tests_by_build[\n","                int(build_id)\n","            ]\n","        ):\n","            raise AssertionError(\n","                \"Ranking test cohort mismatch for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","\n","        expected_failure_values = (\n","            ranked_build[\n","                \"Verdict\"\n","            ].astype(int).ne(0)\n","            .astype(int)\n","            .to_numpy()\n","        )\n","\n","\n","        if not np.array_equal(\n","            ranked_build[\n","                \"ActualFailure\"\n","            ].astype(int).to_numpy(),\n","\n","            expected_failure_values,\n","        ):\n","            raise AssertionError(\n","                \"ActualFailure does not match Verdict.\"\n","            )\n","\n","\n","        # Verify Test-ascending ordering inside exact ties.\n","        for _, tied_rows in (\n","            ranked_build.groupby(\n","                \"Score\",\n","                sort=False,\n","                dropna=False,\n","            )\n","        ):\n","            if len(\n","                tied_rows\n","            ) \u003c= 1:\n","                continue\n","\n","\n","            observed_tie_order = (\n","                tied_rows[\n","                    \"Test\"\n","                ]\n","                .astype(str)\n","                .tolist()\n","            )\n","\n","\n","            expected_tie_order = sorted(\n","                observed_tie_order\n","            )\n","\n","\n","            if observed_tie_order != expected_tie_order:\n","                raise AssertionError(\n","                    \"Tie-breaking violation for \"\n","                    f\"{technique}, build {build_id}.\"\n","                )\n","\n","\n","    per_technique_rows = (\n","        rankings.groupby(\n","            \"Technique\"\n","        )\n","        .size()\n","    )\n","\n","\n","    if not (\n","        per_technique_rows == 363\n","    ).all():\n","        raise AssertionError(\n","            \"A technique did not rank all \"\n","            \"363 evaluation rows.\"\n","        )\n","\n","\n","    per_technique_builds = (\n","        rankings.groupby(\n","            \"Technique\"\n","        )[\n","            \"Build\"\n","        ]\n","        .nunique()\n","    )\n","\n","\n","    if not (\n","        per_technique_builds == 10\n","    ).all():\n","        raise AssertionError(\n","            \"A technique did not rank all \"\n","            \"10 evaluation builds.\"\n","        )\n","\n","\n","    build_failure_consistency = (\n","        build_metrics.groupby(\n","            \"Build\"\n","        )[\n","            \"NumberOfFailures\"\n","        ]\n","        .nunique()\n","    )\n","\n","\n","    if not (\n","        build_failure_consistency == 1\n","    ).all():\n","        raise AssertionError(\n","            \"Techniques observed different clean \"\n","            \"failure counts for the same build.\"\n","        )\n","\n","\n","    build_test_count_consistency = (\n","        build_metrics.groupby(\n","            \"Build\"\n","        )[\n","            \"NumberOfTests\"\n","        ]\n","        .nunique()\n","    )\n","\n","\n","    if not (\n","        build_test_count_consistency == 1\n","    ).all():\n","        raise AssertionError(\n","            \"Techniques ranked different numbers \"\n","            \"of tests for the same build.\"\n","        )\n","\n","\n","    return True\n","\n","\n","# ---------------------------------------------------------\n","# 19. Load an existing completed smoke test\n","# ---------------------------------------------------------\n","\n","def load_existing_smoke_test():\n","    required_output_paths = {\n","        \"rankings\":\n","            CONDITION_DIRECTORY\n","            / \"rankings.parquet\",\n","\n","        \"build_metrics\":\n","            CONDITION_DIRECTORY\n","            / \"build_metrics.parquet\",\n","\n","        \"project_run_metrics\":\n","            CONDITION_DIRECTORY\n","            / \"project_run_metrics.csv\",\n","\n","        \"fit_times\":\n","            CONDITION_DIRECTORY\n","            / \"fit_times.csv\",\n","\n","        \"noise_summary\":\n","            CONDITION_DIRECTORY\n","            / \"noise_summary.csv\",\n","    }\n","\n","\n","    missing_paths = [\n","        str(path)\n","        for path\n","        in required_output_paths.values()\n","        if not path.exists()\n","    ]\n","\n","\n","    if missing_paths:\n","        raise FileNotFoundError(\n","            \"A success marker exists, but outputs \"\n","            \"are missing:\\n\"\n","            + \"\\n\".join(\n","                missing_paths\n","            )\n","        )\n","\n","\n","    loaded = {\n","        \"rankings\":\n","            pd.read_parquet(\n","                required_output_paths[\n","                    \"rankings\"\n","                ]\n","            ),\n","\n","        \"build_metrics\":\n","            pd.read_parquet(\n","                required_output_paths[\n","                    \"build_metrics\"\n","                ]\n","            ),\n","\n","        \"project_run_metrics\":\n","            pd.read_csv(\n","                required_output_paths[\n","                    \"project_run_metrics\"\n","                ]\n","            ),\n","\n","        \"fit_times\":\n","            pd.read_csv(\n","                required_output_paths[\n","                    \"fit_times\"\n","                ]\n","            ),\n","\n","        \"noise_summary\":\n","            pd.read_csv(\n","                required_output_paths[\n","                    \"noise_summary\"\n","                ]\n","            ),\n","\n","        \"condition_directory\":\n","            CONDITION_DIRECTORY,\n","    }\n","\n","\n","    validate_condition_outputs(\n","        loaded[\n","            \"rankings\"\n","        ],\n","        loaded[\n","            \"build_metrics\"\n","        ],\n","    )\n","\n","\n","    if len(\n","        loaded[\n","            \"project_run_metrics\"\n","        ]\n","    ) != 7:\n","        raise AssertionError(\n","            \"Existing project-run output does not \"\n","            \"contain seven techniques.\"\n","        )\n","\n","\n","    if len(\n","        loaded[\n","            \"fit_times\"\n","        ]\n","    ) != 4:\n","        raise AssertionError(\n","            \"Existing fit-time output does not \"\n","            \"contain four ML models.\"\n","        )\n","\n","\n","    return loaded\n","\n","\n","# ---------------------------------------------------------\n","# 20. Run the real 0%-noise, seed-1 condition\n","# ---------------------------------------------------------\n","\n","def run_titan_smoke_condition(\n","    overwrite=False,\n","):\n","    condition_start_time = time.time()\n","\n","\n","    if (\n","        COMPLETION_MARKER.exists()\n","        and not overwrite\n","    ):\n","        print(\n","            \"\\nA completed Titan 0%-noise, seed-1 \"\n","            \"condition already exists.\"\n","        )\n","\n","        print(\n","            \"Validating and reusing:\"\n","        )\n","\n","        print(\n","            CONDITION_DIRECTORY\n","        )\n","\n","\n","        loaded = (\n","            load_existing_smoke_test()\n","        )\n","\n","\n","        print(\n","            \"\\n=== EXISTING TITAN SMOKE TEST VALIDATED ===\"\n","        )\n","\n","\n","        display(\n","            loaded[\n","                \"project_run_metrics\"\n","            ][\n","                [\n","                    \"Technique\",\n","                    \"MeanAPFD\",\n","                    \"MeanAPFDc\",\n","                    \"SD_APFD\",\n","                    \"SD_APFDc\",\n","                    \"EvaluatedBuilds\",\n","                ]\n","            ]\n","            .sort_values(\n","                \"MeanAPFDc\",\n","                ascendin