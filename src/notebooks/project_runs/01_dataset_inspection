               15\n","59          50.0        Random   0.502786  0.508001               15\n","60          50.0      LightGBM   0.482456  0.455545               15\n","61          50.0  RandomForest   0.388856  0.337981               15\n","62          50.0       QTF-Avg   0.248094  0.015221               15\n","\n","[63 rows x 5 columns]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Audit directory:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_seed_01_pilot\n","\n","SUCCESS: Snow Owl seed 1 completed all nine noise levels and passed the full pilot audit.\n"]}],"source":["# =========================================================\n","# PROJECT 3: SNOW OWL\n","# COMPLETE AND AUDIT SEED 1 ACROSS ALL NOISE LEVELS\n","# =========================================================\n","\n","from pathlib import Path\n","import gc\n","import json\n","import time\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","PILOT_SEED = 1\n","\n","SEED_1_AUDIT_DIRECTORY = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n","    / \"snow_owl_seed_01_pilot\"\n",")\n","\n","SEED_1_AUDIT_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","required_condition_files = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"rankings.parquet\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","]\n","\n","\n","# ---------------------------------------------------------\n","# 1. Run or resume all seed-1 conditions\n","# ---------------------------------------------------------\n","\n","print(\n","    \"=== SNOW OWL SEED 1: ALL NOISE LEVELS ===\"\n",")\n","\n","seed_start_time = time.time()\n","\n","for noise_percent in NOISE_LEVELS:\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{PILOT_SEED:02d}\"\n","    )\n","\n","    completion_marker = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","    existing_missing_files = [\n","        file_name\n","        for file_name in required_condition_files\n","        if not (\n","            condition_directory\n","            / file_name\n","        ).exists()\n","    ]\n","\n","    if completion_marker.exists():\n","\n","        if existing_missing_files:\n","            raise RuntimeError(\n","                \"A condition has a success marker but \"\n","                \"is missing files:\\n\"\n","                f\"Noise: {noise_percent}%\\n\"\n","                + \"\\n\".join(existing_missing_files)\n","            )\n","\n","        print(\n","            f\"\\nSKIP: noise {noise_percent:\u003e2}% / \"\n","            f\"seed {PILOT_SEED} already complete.\"\n","        )\n","\n","        continue\n","\n","\n","    print(\n","        f\"\\nRUN: noise {noise_percent:\u003e2}% / \"\n","        f\"seed {PILOT_SEED}\"\n","    )\n","\n","    run_unified_condition(\n","        noise_percent=noise_percent,\n","        repetition_seed=PILOT_SEED,\n","        save_rankings=True,\n","        overwrite=False,\n","    )\n","\n","    gc.collect()\n","\n","\n","print(\n","    \"\\nAll seed-1 execution attempts finished.\"\n",")\n","\n","print(\n","    \"Elapsed minutes:\",\n","    round(\n","        (\n","            time.time()\n","            - seed_start_time\n","        )\n","        / 60.0,\n","        3,\n","    ),\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Verify all nine condition folders\n","# ---------------------------------------------------------\n","\n","condition_records = []\n","\n","for noise_percent in NOISE_LEVELS:\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{PILOT_SEED:02d}\"\n","    )\n","\n","    missing_files = [\n","        file_name\n","        for file_name in required_condition_files\n","        if not (\n","            condition_directory\n","            / file_name\n","        ).exists()\n","    ]\n","\n","    if missing_files:\n","        raise FileNotFoundError(\n","            f\"Noise {noise_percent}% is incomplete:\\n\"\n","            + \"\\n\".join(missing_files)\n","        )\n","\n","    with open(\n","        condition_directory\n","        / \"_SUCCESS.json\",\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","        metadata = json.load(\n","            marker_file\n","        )\n","\n","    condition_records.append({\n","        \"NoisePercent\":\n","            float(noise_percent),\n","        \"ConditionDirectory\":\n","            str(condition_directory),\n","        \"CompletedSuccessfully\":\n","            bool(\n","                metadata.get(\n","                    \"CompletedSuccessfully\",\n","                    False,\n","                )\n","            ),\n","        \"EvaluationHashUnchanged\":\n","            bool(\n","                metadata.get(\n","                    \"EvaluationHashUnchanged\",\n","                    False,\n","                )\n","            ),\n","        \"RankingRows\":\n","            int(\n","                metadata.get(\n","                    \"RankingRows\",\n","                    -1,\n","                )\n","            ),\n","        \"BuildMetricRows\":\n","            int(\n","                metadata.get(\n","                    \"BuildMetricRows\",\n","                    -1,\n","                )\n","            ),\n","        \"EvaluatedBuilds\":\n","            int(\n","                metadata.get(\n","                    \"EvaluatedBuilds\",\n","                    -1,\n","                )\n","            ),\n","        \"TechniqueCount\":\n","            int(\n","                metadata.get(\n","                    \"TechniqueCount\",\n","                    -1,\n","                )\n","            ),\n","        \"ElapsedSeconds\":\n","            float(\n","                metadata.get(\n","                    \"ElapsedSeconds\",\n","                    np.nan,\n","                )\n","            ),\n","    })\n","\n","\n","condition_status = pd.DataFrame(\n","    condition_records\n",").sort_values(\n","    \"NoisePercent\"\n",").reset_index(drop=True)\n","\n","\n","# ---------------------------------------------------------\n","# 3. Load combined seed-1 results\n","# ---------------------------------------------------------\n","\n","noise_summary_frames = []\n","project_run_frames = []\n","build_metric_frames = []\n","ranking_frames = []\n","fit_time_frames = []\n","\n","noise_manifests = {}\n","rankings_by_noise = {}\n","\n","\n","for noise_percent in NOISE_LEVELS:\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{PILOT_SEED:02d}\"\n","    )\n","\n","    noise_summary = pd.read_csv(\n","        condition_directory\n","        / \"noise_summary.csv\"\n","    )\n","\n","    project_run_metrics = pd.read_csv(\n","        condition_directory\n","        / \"project_run_metrics.csv\"\n","    )\n","\n","    build_metrics = pd.read_parquet(\n","        condition_directory\n","        / \"build_metrics.parquet\"\n","    )\n","\n","    rankings = pd.read_parquet(\n","        condition_directory\n","        / \"rankings.parquet\"\n","    )\n","\n","    fit_times = pd.read_csv(\n","        condition_directory\n","        / \"fit_times.csv\"\n","    )\n","\n","    noise_manifest = pd.read_parquet(\n","        condition_directory\n","        / \"noise_manifest.parquet\"\n","    )\n","\n","\n","    noise_summary_frames.append(\n","        noise_summary\n","    )\n","\n","    project_run_frames.append(\n","        project_run_metrics\n","    )\n","\n","    build_metric_frames.append(\n","        build_metrics\n","    )\n","\n","    ranking_frames.append(\n","        rankings\n","    )\n","\n","    fit_time_frames.append(\n","        fit_times\n","    )\n","\n","    noise_manifests[\n","        int(noise_percent)\n","    ] = noise_manifest\n","\n","    rankings_by_noise[\n","        int(noise_percent)\n","    ] = rankings\n","\n","\n","combined_noise_summary = (\n","    pd.concat(\n","        noise_summary_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        \"NoisePercentRequested\"\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_project_run_metrics = (\n","    pd.concat(\n","        project_run_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"Technique\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_build_metrics = (\n","    pd.concat(\n","        build_metric_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"Technique\",\n","            \"BuildOrder\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_rankings = (\n","    pd.concat(\n","        ranking_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"Technique\",\n","            \"build_order\",\n","            \"Rank\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","combined_fit_times = (\n","    pd.concat(\n","        fit_time_frames,\n","        ignore_index=True,\n","    )\n","    .sort_values(\n","        [\n","            \"NoisePercent\",\n","            \"Technique\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Structural audit\n","# ---------------------------------------------------------\n","\n","EXPECTED_CONDITIONS = 9\n","EXPECTED_TECHNIQUES = 7\n","EXPECTED_PROJECT_RUN_ROWS = 63\n","EXPECTED_BUILD_METRIC_ROWS = 945\n","EXPECTED_RANKING_ROWS = 36603\n","\n","\n","if len(condition_status) != EXPECTED_CONDITIONS:\n","    raise AssertionError(\n","        \"Expected nine condition-status rows.\"\n","    )\n","\n","if not condition_status[\n","    \"CompletedSuccessfully\"\n","].all():\n","    raise AssertionError(\n","        \"At least one condition is not marked successful.\"\n","    )\n","\n","if not condition_status[\n","    \"EvaluationHashUnchanged\"\n","].all():\n","    raise AssertionError(\n","        \"At least one condition reports changed \"\n","        \"evaluation data.\"\n","    )\n","\n","if not (\n","    condition_status[\n","        \"RankingRows\"\n","    ] == 4067\n",").all():\n","    raise AssertionError(\n","        \"At least one condition has an unexpected \"\n","        \"ranking-row count.\"\n","    )\n","\n","if not (\n","    condition_status[\n","        \"BuildMetricRows\"\n","    ] == 105\n",").all():\n","    raise AssertionError(\n","        \"At least one condition has an unexpected \"\n","        \"build-metric count.\"\n","    )\n","\n","if not (\n","    condition_status[\n","        \"EvaluatedBuilds\"\n","    ] == 15\n",").all():\n","    raise AssertionError(\n","        \"At least one condition did not evaluate \"\n","        \"all 15 builds.\"\n","    )\n","\n","if not (\n","    condition_status[\n","        \"TechniqueCount\"\n","    ] == EXPECTED_TECHNIQUES\n",").all():\n","    raise AssertionError(\n","        \"At least one condition is missing techniques.\"\n","    )\n","\n","\n","if len(\n","    combined_project_run_metrics\n",") != EXPECTED_PROJECT_RUN_ROWS:\n","    raise AssertionError(\n","        \"Unexpected combined project-run row count.\"\n","    )\n","\n","if len(\n","    combined_build_metrics\n",") != EXPECTED_BUILD_METRIC_ROWS:\n","    raise AssertionError(\n","        \"Unexpected combined build-metric row co