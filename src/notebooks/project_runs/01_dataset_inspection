           0.000000e+00  \n","5                5.551115e-17  \n","6                5.551115e-17  \n","7                5.551115e-17  \n","8                5.551115e-17  \n","9                1.455192e-11  \n","10               0.000000e+00  \n","11               9.714451e-17  \n","12               9.714451e-17  \n","13               9.714451e-17  \n","14               9.714451e-17  \n","15               0.000000e+00  \n","16               0.000000e+00  \n","17               8.326673e-17  \n","18               6.938894e-17  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","All requested rows merged: True\n","Total mismatching feature values: 0\n","\n","Audit files saved:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_preflight/snow_owl_clean_rec_comparison_summary.csv\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_preflight/snow_owl_clean_rec_reconstructed.parquet\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_preflight/snow_owl_clean_rec_mismatch_examples.csv\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_preflight/snow_owl_clean_rec_audit_report.json\n","\n","SUCCESS: all 19 Snow Owl REC_* features exactly match the clean TCP-CI dataset.\n"]}],"source":["# =========================================================\n","# PROJECT 3: SNOW OWL\n","# CLEAN 0% REC FEATURE RECONSTRUCTION AND AUDIT\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","PROJECT_NAME = \"b2ihealthcare@snow-owl\"\n","PROJECT_SLUG = \"b2ihealthcare__snow-owl\"\n","RECENT_WINDOW = 6\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","AUDIT_DIRECTORY = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n","    / PROJECT_SLUG\n","    / \"snow_owl_preflight\"\n",")\n","\n","AUDIT_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 1. Exact REC feature list\n","# ---------------------------------------------------------\n","\n","REC_FEATURE_COLUMNS = [\n","    \"REC_Age\",\n","    \"REC_LastFailureAge\",\n","    \"REC_LastTransitionAge\",\n","    \"REC_RecentAvgExeTime\",\n","    \"REC_RecentMaxExeTime\",\n","    \"REC_RecentFailRate\",\n","    \"REC_RecentAssertRate\",\n","    \"REC_RecentExcRate\",\n","    \"REC_RecentTransitionRate\",\n","    \"REC_TotalAvgExeTime\",\n","    \"REC_TotalMaxExeTime\",\n","    \"REC_TotalFailRate\",\n","    \"REC_TotalAssertRate\",\n","    \"REC_TotalExcRate\",\n","    \"REC_TotalTransitionRate\",\n","    \"REC_LastVerdict\",\n","    \"REC_LastExeTime\",\n","    \"REC_MaxTestFileFailRate\",\n","    \"REC_MaxTestFileTransitionRate\",\n","]\n","\n","\n","missing_rec_columns = [\n","    column\n","    for column in REC_FEATURE_COLUMNS\n","    if column not in dataset.columns\n","]\n","\n","if missing_rec_columns:\n","    raise RuntimeError(\n","        \"dataset.csv is missing REC columns:\\n\"\n","        + \"\\n\".join(missing_rec_columns)\n","    )\n","\n","if len(REC_FEATURE_COLUMNS) != 19:\n","    raise AssertionError(\n","        \"Expected exactly 19 REC features.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Prepare clean chronological execution history\n","# ---------------------------------------------------------\n","\n","build_order_map = (\n","    builds_checked\n","    .set_index(\"id\")[\"build_order\"]\n","    .to_dict()\n",")\n","\n","exe_for_rec = exe.copy()\n","\n","for column in [\n","    \"build\",\n","    \"test\",\n","    \"verdict\",\n","]:\n","    exe_for_rec[column] = pd.to_numeric(\n","        exe_for_rec[column],\n","        errors=\"raise\",\n","    ).astype(int)\n","\n","exe_for_rec[\"duration\"] = pd.to_numeric(\n","    exe_for_rec[\"duration\"],\n","    errors=\"raise\",\n",").astype(float)\n","\n","exe_for_rec[\"build_order\"] = (\n","    exe_for_rec[\"build\"]\n","    .map(build_order_map)\n",")\n","\n","if exe_for_rec[\"build_order\"].isna().any():\n","    missing_rows = int(\n","        exe_for_rec[\"build_order\"]\n","        .isna()\n","        .sum()\n","    )\n","\n","    raise ValueError(\n","        f\"{missing_rows} execution rows could not \"\n","        \"be mapped to chronological build order.\"\n","    )\n","\n","\n","sort_columns = [\n","    \"build_order\",\n","]\n","\n","if \"job\" in exe_for_rec.columns:\n","    sort_columns.append(\"job\")\n","\n","sort_columns.append(\"test\")\n","\n","exe_for_rec = (\n","    exe_for_rec\n","    .sort_values(sort_columns)\n","    .reset_index(drop=True)\n",")\n","\n","\n","# Global chronological positions of builds appearing in\n","# the execution history.\n","ordered_execution_builds = (\n","    exe_for_rec[\n","        [\n","            \"build\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .drop_duplicates()\n","    .sort_values(\"build_order\")[\"build\"]\n","    .astype(int)\n","    .tolist()\n",")\n","\n","global_build_position = {\n","    int(build_id): position\n","    for position, build_id\n","    in enumerate(ordered_execution_builds)\n","}\n","\n","\n","# ---------------------------------------------------------\n","# 3. Prepare entity ↔ build history\n","# ---------------------------------------------------------\n","\n","entity_build_pairs = (\n","    build_entity_map\n","    .dropna(\n","        subset=[\"EntityId\"]\n","    )[\n","        [\n","            \"id\",\n","            \"EntityId\",\n","        ]\n","    ]\n","    .drop_duplicates()\n","    .copy()\n",")\n","\n","entity_build_pairs[\"id\"] = pd.to_numeric(\n","    entity_build_pairs[\"id\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","entity_build_pairs[\"EntityId\"] = pd.to_numeric(\n","    entity_build_pairs[\"EntityId\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","# For each entity, identify all builds in which it changed.\n","entity_changed_builds = (\n","    entity_build_pairs\n","    .groupby(\"EntityId\")[\"id\"]\n","    .apply(\n","        lambda values: set(\n","            values.astype(int).tolist()\n","        )\n","    )\n","    .to_dict()\n",")\n","\n","\n","# Ensure every project build has a changed-entity set.\n","clean_changed_entities_by_build = {\n","    int(build_id): set(\n","        int(entity_id)\n","        for entity_id in (\n","            changed_entities_by_build.get(\n","                int(build_id),\n","                set(),\n","            )\n","        )\n","    )\n","    for build_id in builds_checked[\"id\"]\n","}\n","\n","if len(\n","    clean_changed_entities_by_build\n",") != len(builds_checked):\n","    raise AssertionError(\n","        \"Changed-entity mapping does not cover \"\n","        \"every project build.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. REC helper functions\n","# ---------------------------------------------------------\n","\n","def calculate_rates(history):\n","    \"\"\"\n","    Calculate failure, assertion, exception and\n","    transition rates from earlier executions.\n","    \"\"\"\n","\n","    history_length = len(history)\n","\n","    if history_length == 0:\n","        raise ValueError(\n","            \"Rate calculation requires \"\n","            \"non-empty history.\"\n","        )\n","\n","    verdicts = history[\"verdict\"]\n","\n","    fail_rate = float(\n","        (verdicts != 0).sum()\n","        / history_length\n","    )\n","\n","    assertion_rate = float(\n","        (verdicts == 2).sum()\n","        / history_length\n","    )\n","\n","    exception_rate = float(\n","        (verdicts == 1).sum()\n","        / history_length\n","    )\n","\n","    transition_rate = float(\n","        (\n","            history[\"transition\"] == 1\n","        ).sum()\n","        / history_length\n","    )\n","\n","    return (\n","        fail_rate,\n","        assertion_rate,\n","        exception_rate,\n","        transition_rate,\n","    )\n","\n","\n","def calculate_max_test_file_rate(\n","    history,\n","    target_column,\n","    current_changed_entities,\n","):\n","    \"\"\"\n","    Reproduce TCP-CI's maximum changed-file failure\n","    or transition frequency.\n","    \"\"\"\n","\n","    target_builds = (\n","        history.loc[\n","            history[target_column] \u003e 0,\n","            \"build\",\n","        ]\n","        .drop_duplicates()\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","    # Official default when the test has no earlier\n","    # failure or transition.\n","    if len(target_builds) == 0:\n","        return -1.0\n","\n","    target_build_set = set(\n","        target_builds\n","    )\n","\n","    maximum_frequency = 0\n","\n","    for entity_id in current_changed_entities:\n","\n","        entity_builds = (\n","            entity_changed_builds.get(\n","                int(entity_id),\n","                set(),\n","            )\n","        )\n","\n","        overlap_count = len(\n","            entity_builds.intersection(\n","                target_build_set\n","            )\n","        )\n","\n","        maximum_frequency = max(\n","            maximum_frequency,\n","            overlap_count,\n","        )\n","\n","    # Earlier target events exist, but no changed\n","    # entity overlaps them.\n","    if maximum_frequency == 0:\n","        return 0.0\n","\n","    return float(\n","        maximum_frequency\n","        / len(target_builds)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Reconstruction function\n","# ---------------------------------------------------------\n","\n","def reconstruct_rec_features(\n","    execution_history,\n","    requested_rows,\n","    recent_window=6,\n","):\n","    \"\"\"\n","    Reconstruct all REC features for requested Build-Test\n","    rows using only executions before the current row.\n","    \"\"\"\n","\n","    requested_pairs = set(\n","        zip(\n","            requested_rows[\n","                \"Build\"\n","            ].astype(int),\n","            requested_rows[\n","                \"Test\"\n","            ].astype(int),\n","        )\n","    )\n","\n","    reconstructed_records = []\n","\n","    for test_id, test_history in (\n","        execution_history.groupby(\n","            \"test\",\n","            sort=False,\n","        )\n","    ):\n","\n","        test_history = (\n","            test_history\n","            .sort_values(\n","                [\n","                    column\n","                    for column in [\n","                        \"build_order\",\n","                        \"job\",\n","                    ]\n","                    if column\n","                    in test_history.columns\n","                ]\n","            )\n","            .reset_index(drop=True)\n","            .copy()\n","        )\n","\n","        # Whether each execution changed verdict compared\n","        # with the immediately preceding execution.\n","        test_history[\"transition\"] = (\n","            test_history[\"verdict\"]\n","            .diff()\n","            .fillna(0)\n","            .ne(0)\n","            .astype(int)\n","        )\n","\n","        first_test_build = int(\n","            test_history.iloc[0][\"build\"]\n","        )\n","\n","        for current_position in range(\n","            len(test_history)\n","        ):\n","\n","            current_row = (\n","                test_history.iloc[\n","                    current_position\n","                ]\n","            )\n","\n","            current_build = int(\n","                current_row[\"build\"]\n","            )\n","\n","            current_pair = (\n","                current_build,\n","                int(test_id),\n","            )\n","\n","            if current_pair not in requested_pairs:\n","                continue\n","\n","            # Only earlier executions may be used.\n","            history = (\n","                test_history\n","                .iloc[:current_position]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","            record = {\n","                \"Build\": current_build,\n","                \"Test\": int(test_id),\n","            }\n","\n","            # No prior execution history.\n","            if history.empty:\n","\n","                for column in REC_FEATURE_COLUMNS:\n","                    record[column] = -1.0\n","\n","                record[\"REC_Age\"] = 0.0\n","\n","                reconstructed_records.append(\n","                    record\n","                )\n","\n","                continue\n","\n","            recent_history = (\n","                history\n","                .tail(recent_window)\n","                .copy()\n","            )\n","\n","\n","            # -------------------------------------------------\n","            # Age\n","            # -------------------------------------------------\n","\n","            current_global_position = (\n","                global_build_position[\n","                    current_build\n","                ]\n","            )\n","\n","            first_global_position = (\n","                global_build_position[\n","                    first_test_build\n","                ]\n","            )\n","\n","            age = (\n","                current_global_position\n","                - first_global_position\n","            )\n","\n","\n","            # -------------------------------------------------\n","            # Last failure age\n","            # -------------------------------------------------\n","\n","            failure_positions = np.flatnonzero(\n","                history[\n","                    \"verdict\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","            if len(failure_positions) == 0:\n","                last_failure_age = -1\n","            else:\n","                last_failure_age = (\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        failure_positions[-1]\n","                    )\n","                )\n","\n","\n","            # -------------------------------------------------\n","            # Last transition age\n","            # -------------------------------------------------\n","\n","            transition_positions = np.flatnonzero(\n","                history[\n","                    \"transition\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","            if len(transition_positions) == 0:\n","                last_transition_age = -1\n","            else:\n","                last_transition_age = (\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        transition_positions[-1]\n","                    )\n","                )\n","\n","\n","            # -------------------------------------------------\n","            # Recent and total rates\n","            # -------------------------------------------------\n","\n","            (\n","                recent_fail_rate,\n","                recent_assert_rate,\n","                recent_exc_rate,\n","                recent_transition_rate,\n","            ) = calculate_rates(\n","                recent_history\n","            )\n","\n","            (\n","                total_fail_rate,\n","                total_assert_rate,\n","                total_exc_rate,\n","                total_transition_rate,\n","            ) = calculate_rates(\n","                history\n","            )\n","\n","\n","            # -------------------------------------------------\n","            # Changed-file features\n","            # -------------------------------------------------\n","\n","            current_changed_entities = (\n","                clean_changed_entities_by_build.get(\n","                    current_build,\n","                    set(),\n","                )\n","            )\n","\n","            max_test_file_fail_rate = (\n","                calculate_max_test_file_rate(\n","                    history=history,\n","                    target_column=\"verdict\",\n","                    current_changed_entities=(\n","                        current_changed_entities\n","                    ),\n","                )\n","            )\n","\n","            max_test_file_transition_rate = (\n","                calculate_max_test_file_rate(\n","                    history=history,\n","                    target_column=\"transition\",\n","                    current_changed_entities=(\n","                        current_changed_entities\n","                    ),\n","                )\n","            )\n","\n","\n","            # -------------------------------------------------\n","            # Complete reconstructed record\n","            # -------------------------------------------------\n","\n","            record.update({\n","                \"REC_Age\":\n","                    float(age),\n","\n","                \"REC_LastFailureAge\":\n","                    float(last_failure_age),\n","\n","                \"REC_LastTransitionAge\":\n","                    float(last_transition_age),\n","\n","                \"REC_RecentAvgExeTime\":\n","                    float(\n","                        recent_history[\n","                            \"duration\"\n","                        ].mean()\n","                    ),\n","\n","                \"REC_RecentMaxExeTime\":\n","                    float(\n","                        recent_history[\n","                            \"duration\"\n","                        ].max()\n","                    ),\n","\n","                \"REC_RecentFailRate\":\n","                    recent_fail_rate,\n","\n","                \"REC_RecentAssertRate\":\n","                    recent_assert_rate,\n","\n","                \"REC_RecentExcRate\":\n","                    recent_exc_rate,\n","\n","                \"REC_RecentTransitionRate\":\n","                    recent_transition_rate,\n","\n","                \"REC_TotalAvgExeTime\":\n","                    float(\n","                        history[\n","                            \"duration\"\n","                        ].mean()\n","                    ),\n","\n","                \"REC_TotalMaxExeTime\":\n","                    float(\n","                        history[\n","                            \"duration\"\n","                        ].max()\n","                    ),\n","\n","                \"REC_TotalFailRate\":\n","                    total_fail_rate,\n","\n","                \"REC_TotalAssertRate\":\n","                    total_assert_rate,\n","\n","                \"REC_TotalExcRate\":\n","                    total_exc_rate,\n","\n","                \"REC_TotalTransitionRate\":\n","                    total_transition_rate,\n","\n","                \"REC_LastVerdict\":\n","                    float(\n","                        recent_history\n","                        .iloc[-1][\"verdict\"]\n","                    ),\n","\n","                \"REC_LastExeTime\":\n","                    float(\n","                        recent_history\n","                        .iloc[-1][\"duration\"]\n","                    ),\n","\n","                \"REC_MaxTestFileFailRate\":\n","                    max_test_file_fail_rate,\n","\n","                \"REC_MaxTestFileTransitionRate\":\n","                    max_test_file_transition_rate,\n","            })\n","\n","            reconstructed_records.append(\n","                record\n","            )\n","\n","    return pd.DataFrame(\n","        reconstructed_records\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Run clean 0% reconstruction\n","# ---------------------------------------------------------\n","\n","print(\n","    \"=== SNOW OWL CLEAN REC RECONSTRUCTION ===\"\n",")\n","\n","rec_clean_reconstructed = (\n","    reconstruct_rec_features(\n","        execution_history=exe_for_rec,\n","        requested_rows=dataset[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ],\n","        recent_window=RECENT_WINDOW,\n","    )\n",")\n","\n","\n","expected_rows = len(dataset)\n","\n","reconstructed_rows = len(\n","    rec_clean_reconstructed\n",")\n","\n","duplicate_reconstructed_pairs = int(\n","    rec_clean_reconstructed\n","    .duplicated(\n","        subset=[\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    )\n","    .sum()\n",")\n","\n","\n","print(\n","    \"\\nExpected dataset rows:\",\n","    expected_rows,\n",")\n","\n","print(\n","    \"Reconstructed rows:\",\n","    reconstructed_rows,\n",")\n","\n","print(\n","    \"Duplicate reconstructed Build-Test pairs:\",\n","    duplicate_reconstructed_pairs,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 7. Compare with TCP-CI's stored REC values\n","# ---------------------------------------------------------\n","\n","comparison = (\n","    dataset[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            *REC_FEATURE_COLUMNS,\n","        ]\n","    ]\n","    .merge(\n","        rec_clean_reconstructed,\n","        on=[\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","        suffixes=(\n","            \"_original\",\n","            \"_reconstructed\",\n","        ),\n","        indicator=True,\n","    )\n",")\n","\n","\n","print(\"\\nMerge status:\")\n","print(\n","    comparison[\"_merge\"]\n","    .value_counts(dropna=False)\n",")\n","\n","\n","comparison_results = []\n","\n","for feature in REC_FEATURE_COLUMNS:\n","\n","    original_column = (\n","        f\"{feature}_original\"\n","    )\n","\n","    reconstructed_column = (\n","        f\"{feature}_reconstructed\"\n","    )\n","\n","    original_values = pd.to_numeric(\n","        comparison[original_column],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    reconstructed_values = pd.to_numeric(\n","        comparison[reconstructed_column],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    matches = np.isclose(\n","        original_values,\n","        reconstructed_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","    absolute_difference = np.abs(\n","        original_values\n","        - reconstructed_values\n","    )\n","\n","    finite_differences = (\n","        absolute_difference[\n","            np.isfinite(\n","                absolute_difference\n","            )\n","        ]\n","    )\n","\n","    maximum_difference = (\n","        float(\n","            finite_differences.max()\n","        )\n","        if len(finite_differences) \u003e 0\n","        else 0.0\n","    )\n","\n","    comparison_results.append({\n","        \"Feature\": feature,\n","        \"MatchingRows\": int(\n","            matches.sum()\n","        ),\n","        \"MismatchingRows\": int(\n","            (~matches).sum()\n","        ),\n","        \"MaximumAbsoluteDifference\":\n","            maximum_difference,\n","    })\n","\n","\n","comparison_summary = pd.DataFrame(\n","    comparison_results\n",")\n","\n","\n","print(\n","    \"\\n=== FEATURE COMPARISON SUMMARY ===\"\n",")\n","\n","display(\n","    comparison_summary\n",")\n","\n","\n","total_mismatches = int(\n","    comparison_summary[\n","        \"MismatchingRows\"\n","    ].sum()\n",")\n","\n","all_rows_merged = bool(\n","    (\n","        comparison[\"_merge\"]\n","        == \"both\"\n","    ).all()\n",")\n","\n","\n","print(\n","    \"\\nAll requested rows merged:\",\n","    all_rows_merged,\n",")\n","\n","print(\n","    \"Total mismatching feature values:\",\n","    total_mismatches,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Collect mismatch examples\n","# ---------------------------------------------------------\n","\n","mismatch_examples = []\n","\n","if total_mismatches \u003e 0:\n","\n","    for feature in REC_FEATURE_COLUMNS:\n","\n","        original_column = (\n","            f\"{feature}_original\"\n","        )\n","\n","        reconstructed_column = (\n","            f\"{feature}_reconstructed\"\n","        )\n","\n","        original_values = pd.to_numeric(\n","            comparison[original_column],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","        reconstructed_values = pd.to_numeric(\n","            comparison[\n","                reconstructed_column\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","        matches = np.isclose(\n","            original_values,\n","            reconstructed_values,\n","            rtol=1e-9,\n","            atol=1e-9,\n","            equal_nan=True,\n","        )\n","\n","        differing_rows = comparison.loc[\n","            ~matches,\n","            [\n","                \"Build\",\n","                \"Test\",\n","                original_column,\n","                reconstructed_column,\n","            ],\n","        ].head(10)\n","\n","        for _, row in (\n","            differing_rows.iterrows()\n","        ):\n","\n","            mismatch_examples.append({\n","                \"Feature\": feature,\n","                \"Build\": int(\n","                    row[\"Build\"]\n","                ),\n","                \"Test\": int(\n","                    row[\"Test\"]\n","                ),\n","                \"Original\": row[\n","                    original_column\n","                ],\n","                \"Reconstructed\": row[\n","                    reconstructed_column\n","                ],\n","            })\n","\n","\n","mismatch_examples_df = pd.DataFrame(\n","    mismatch_examples\n",")\n","\n","if total_mismatches \u003e 0:\n","    print(\"\\nExample mismatches:\")\n","    display(\n","        mismatch_examples_df.head(50)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Save the audit permanently to Drive\n","# ---------------------------------------------------------\n","\n","summary_path = (\n","    AUDIT_DIRECTORY\n","    / \"snow_owl_clean_rec_comparison_summary.csv\"\n",")\n","\n","reconstructed_path = (\n","    AUDIT_DIRECTORY\n","    / \"snow_owl_clean_rec_reconstructed.parquet\"\n",")\n","\n","mismatch_path = (\n","    AUDIT_DIRECTORY\n","    / \"snow_owl_clean_rec_mismatch_examples.csv\"\n",")\n","\n","report_path = (\n","    AUDIT_DIRECTORY\n","    / \"snow_owl_clean_rec_audit_report.json\"\n",")\n","\n","\n","comparison_summary.to_csv(\n","    summary_path,\n","    index=False,\n",")\n","\n","rec_clean_reconstructed.to_parquet(\n","    reconstructed_path,\n","    index=False,\n",")\n","\n","mismatch_examples_df.to_csv(\n","    mismatch_path,\n","    index=False,\n",")\n","\n","\n","audit_report = {\n","    \"Project\": PROJECT_NAME,\n","    \"RecentWindow\": RECENT_WINDOW,\n","    \"ExpectedDatasetRows\":\n","        int(expected_rows),\n","    \"ReconstructedRows\":\n","        int(reconstructed_rows),\n","    \"DuplicateReconstructedPairs\":\n","        int(duplicate_reconstructed_pairs),\n","    \"AllRowsMerged\":\n","        bool(all_rows_merged),\n","    \"NumberOfRECFeatures\":\n","        int(len(REC_FEATURE_COLUMNS)),\n","    \"TotalMismatchingFeatureValues\":\n","        int(total_mismatches),\n","    \"Status\": (\n","        \"PASS\"\n","        if (\n","            reconstructed_rows\n","            == expected_rows\n","            and duplicate_reconstructed_pairs\n","            == 0\n","            and all_rows_merged\n","            and total_mismatches\n","            == 0\n","        )\n","        else \"FAIL\"\n","    ),\n","}\n","\n","with open(\n","    report_path,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as report_file:\n","\n","    json.dump(\n","        audit_report,\n","        report_file,\n","        indent=2,\n","    )\n","\n","\n","print(\"\\nAudit files saved:\")\n","\n","print(summary_path)\n","print(reconstructed_path)\n","print(mismatch_path)\n","print(report_path)\n","\n","\n","# ---------------------------------------------------------\n","# 10. Final strict validation\n","# ---------------------------------------------------------\n","\n","if reconstructed_rows != expected_rows:\n","    raise AssertionError(\n","        \"Reconstructed row count does not match \"\n","        \"dataset.csv.\"\n","    )\n","\n","if duplicate_reconstructed_pairs != 0:\n","    raise AssertionError(\n","        \"Duplicate reconstructed Build-Test pairs found.\"\n","    )\n","\n","if not all_rows_merged:\n","    raise AssertionError(\n","        \"Some dataset rows did not receive \"\n","        \"reconstructed REC features.\"\n","    )\n","\n","if total_mismatches != 0:\n","    raise AssertionError(\n","        f\"REC reconstruction found \"\n","        f\"{total_mismatches} mismatching values.\"\n","    )\n","\n","\n","print(\n","    \"\\nSUCCESS: all 19 Snow Owl REC_* features \"\n","    \"exactly match the clean TCP-CI dataset.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":12830,"status":"ok","timestamp":1784897836707,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"MqC5X93OMzi6","outputId":"6d57f2ee-a0a5-485b-ff44-8ee1d37c01cc"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== SNOW OWL CANONICAL HELPER VALIDATION ===\n","\n","Protocol saved:\n","/content/drive/MyDrive/Thesis_Experiment/Notes/b2ihealthcare__snow-owl_experiment_protocol_v1.json\n","\n","Raw histories:\n","Training execution rows: 9812\n","Evaluation execution rows: 3244\n","\n","Clean failure subtype distribution:\n","verdict\n","1    87\n","2    14\n","Name: count, dtype: int64\n","\n","0% validation:\n","Flipped verdicts: 0\n","Training-label mismatches: 0\n","REC-value mismatches: 0\n","\n","5% seed 1 validation:\n","Flipped raw verdicts: 477\n","Realised noise percentage: 4.861394\n","Pass to failure: 470\n","Failure to pass: 7\n","Model-ready label changes: 87\n","REC-value changes: 12389\n","Same-seed reproducible: True\n","\n","Nested-mask validation:\n","Same 5%/10% uniform stream: True\n","5% mask subset of 10% mask: True\n","\n","Evaluation protection:\n","Evaluation unchanged: True\n","\n","Metric validation:\n","APFD: 0.8\n","APFDc long failure first: 0.555556\n","APFDc quick failure first: 0.777778\n","\n","Validation files saved:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_preflight/snow_owl_canonical_helper_validation.json\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/b2ihealthcare__snow-owl/snow_owl_preflight/snow_owl_noise_selftest_summary.csv\n","\n","SUCCESS: Snow Owl canonical noise helpers are ready.\n"]}],"source":["# =========================================================\n","# PROJECT 3: SNOW OWL\n","# CANONICAL NOISE HELPERS AND SELF-VALIDATION\n","# =========================================================\n","\n","from pathlib import Path\n","import hashlib\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","# ---------------------------------------------------------\n","# 1. Project and permanent output paths\n","# ---------------------------------------------------------\n","\n","PROJECT_NAME = \"b2ihealthcare@snow-owl\"\n","PROJECT_SLUG = \"b2ihealthcare__snow-owl\"\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE / \"Results\" / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE / \"Results\" / \"Aggregated\"\n",")\n","\n","LOGS_DRIVE = (\n","    THESIS_DRIVE / \"Results\" / \"Logs\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE / \"Notes\"\n",")\n","\n","PROJECT_RAW_RESULTS = (\n","    RAW_RESULTS_DRIVE / PROJECT_SLUG\n",")\n","\n","PROJECT_LOGS = (\n","    LOGS_DRIVE / PROJECT_SLUG\n",")\n","\n","PREFLIGHT_DIRECTORY = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n","    / \"snow_owl_preflight\"\n",")\n","\n","for directory in [\n","    RAW_RESULTS_DRIVE,\n","    AGGREGATED_RESULTS_DRIVE,\n","    LOGS_DRIVE,\n","    NOTES_DRIVE,\n","    PROJECT_RAW_RESULTS,\n","    PROJECT_LOGS,\n","    PREFLIGHT_DIRECTORY,\n","]:\n","    directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Frozen experiment configuration\n","# ---------------------------------------------------------\n","\n","NOISE_LEVELS = [\n","    0,\n","    5,\n","    10,\n","    15,\n","    20,\n","    25,\n","    30,\n","    40,\n","    50,\n","]\n","\n","REPETITION_SEEDS = list(\n","    range(1, 31)\n",")\n","\n","ML_TECHNIQUES = [\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","]\n","\n","BASELINE_TECHNIQUES = [\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","]\n","\n","\n","EXPERIMENT_PROTOCOL = {\n","    \"project\": PROJECT_NAME,\n","    \"project_number\": 3,\n","    \"stage\": \"full_multi_project_experiment\",\n","    \"dataset\": \"TCP-CI\",\n","    \"split\": {\n","        \"type\": \"chronological_fixed_holdout\",\n","        \"training_fraction\": 0.75,\n","        \"evaluation_fraction\": 0.25,\n","        \"training_period_builds\":\n","            int(len(training_build_ids)),\n","        \"evaluation_period_builds\":\n","            int(len(evaluation_build_ids)),\n","        \"model_training_builds\":\n","            int(\n","                clean_training_data[\n","                    \"Build\"\n","                ].nunique()\n","            ),\n","        \"scored_evaluation_builds\":\n","            int(\n","                clean_evaluation_data[\n","                    \"Build\"\n","                ].nunique()\n","            ),\n","        \"rolling_retraining\": False,\n","    },\n","    \"noise_levels_percent\": NOISE_LEVELS,\n","    \"repetition_seeds\": REPETITION_SEEDS,\n","    \"recent_window\": int(RECENT_WINDOW),\n","    \"noise_partition\": \"training only\",\n","    \"evaluation_partition\": \"clean\",\n","    \"noise_unit\": (\n","        \"individual raw training execution verdict\"\n","    ),\n","    \"flip_rule\": {\n","        \"pass_to_failure\": (\n","            \"replace verdict 0 with a failure subtype \"\n","            \"sampled from the clean project-specific \"\n","            \"failure subtype distribution\"\n","        ),\n","        \"failure_to_pass\": (\n","            \"replace every non-zero verdict with 0\"\n","        ),\n","    },\n","    \"randomisation\": (\n","        \"project-specific deterministic random streams; \"\n","        \"same seed uses common uniforms and nested masks \"\n","        \"across increasing noise levels\"\n","    ),\n","    \"feature_handling\": (\n","        \"recompute all 19 verdict-dependent REC features\"\n","    ),\n","    \"training_instance_cohort\": (\n","        \"preserve fixed TCP-CI model-ready training rows\"\n","    ),\n","    \"ranking_tie_break\": \"Test ascending\",\n","    \"primary_metric\": \"APFDc\",\n","    \"secondary_metric\": \"APFD\",\n","    \"ml_techniques\": ML_TECHNIQUES,\n","    \"baselines\": BASELINE_TECHNIQUES,\n","    \"status\": \"FROZEN_FOR_REMAINING_PROJECTS\",\n","}\n","\n","\n","PROTOCOL_PATH = (\n","    NOTES_DRIVE\n","    / \"b2ihealthcare__snow-owl_experiment_protocol_v1.json\"\n",")\n","\n","with open(\n","    PROTOCOL_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as protocol_file:\n","    json.dump(\n","        EXPERIMENT_PROTOCOL,\n","        protocol_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Clean raw training and evaluation histories\n","# ---------------------------------------------------------\n","\n","clean_training_history = (\n","    exe_for_rec[\n","        exe_for_rec[\"build\"].isin(\n","            training_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","clean_evaluation_history = (\n","    exe_for_rec[\n","        exe_for_rec[\"build\"].isin(\n","            evaluation_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(clean_training_history) != 9812:\n","    raise AssertionError(\n","        \"Unexpected raw training-history row count.\"\n","    )\n","\n","if len(clean_evaluation_history) != 3244:\n","    raise AssertionError(\n","        \"Unexpected raw evaluation-history row count.\"\n","    )\n","\n","\n","for history in [\n","    clean_training_history,\n","    clean_evaluation_history,\n","]:\n","    history[\"build\"] = pd.to_numeric(\n","        history[\"build\"],\n","        errors=\"raise\",\n","    ).astype(int)\n","\n","    history[\"test\"] = pd.to_numeric(\n","        history[\"test\"],\n","        errors=\"raise\",\n","    ).astype(int)\n","\n","    history[\"verdict\"] = pd.to_numeric(\n","        history[\"verdict\"],\n","        errors=\"raise\",\n","    ).astype(int)\n","\n","    history[\"duration\"] = pd.to_numeric(\n","        history[\"duration\"],\n","        errors=\"raise\",\n","    ).astype(float)\n","\n","\n","clean_failure_subtype_counts = (\n","    clean_training_history.loc[\n","        clean_training_history[\n","            \"verdict\"\n","        ] != 0,\n","        \"verdict\",\n","    ]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","if clean_failure_subtype_counts.empty:\n","    raise RuntimeError(\n","        \"Snow Owl has no failure subtype in the \"\n","        \"clean raw training history.\"\n","    )\n","\n","\n","# Hash the clean evaluation partition before any\n","# noise-related operation.\n","evaluation_hash_before = int(\n","    pd.util.hash_pandas_object(\n","        clean_evaluation_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"Duration\",\n","                *REC_FEATURE_COLUMNS,\n","            ]\n","        ],\n","        index=True,\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Deterministic project-specific random seed\n","# ---------------------------------------------------------\n","\n","def stable_project_seed(\n","    project_name,\n","    repetition_seed,\n","    random_stream,\n","):\n","    \"\"\"\n","    Create a reproducible project-specific 32-bit seed.\n","    \"\"\"\n","\n","    seed_text = (\n","        f\"{project_name}|\"\n","        f\"{int(repetition_seed)}|\"\n","        f\"{random_stream}\"\n","    )\n","\n","    digest = hashlib.sha256(\n","        seed_text.encode(\"utf-8\")\n","    ).digest()\n","\n","    return int.from_bytes(\n","        digest[:8],\n","        byteorder=\"little\",\n","        signed=False,\n","    ) % (2 ** 32)\n","\n","\n","# ---------------------------------------------------------\n","# 5. Training-verdict noise injection\n","# ---------------------------------------------------------\n","\n","def inject_training_verdict_noise(\n","    execution_history,\n","    noise_percent,\n","    repetition_seed,\n","    project_name=PROJECT_NAME,\n","):\n","    \"\"\"\n","    Independently flip raw training verdicts with\n","    probability noise_percent / 100.\n","\n","    The same project and repetition seed use the same\n","    per-row common uniforms at every noise level, making\n","    the masks nested.\n","    \"\"\"\n","\n","    noise_percent = float(\n","        noise_percent\n","    )\n","\n","    if not 0 \u003c= noise_percent \u003c= 100:\n","        raise ValueError(\n","            \"noise_percent must be between 0 and 100.\"\n","        )\n","\n","    noisy_history = (\n","        execution_history\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    original_verdict = pd.to_numeric(\n","        noisy_history[\"verdict\"],\n","        errors=\"raise\",\n","    ).astype(int).to_numpy()\n","\n","    number_of_rows = len(\n","        noisy_history\n","    )\n","\n","    if number_of_rows == 0:\n","        raise ValueError(\n","            \"execution_history is empty.\"\n","        )\n","\n","    clean_failure_verdicts = (\n","        pd.Series(\n","            original_verdict[\n","                original_verdict != 0\n","            ]\n","        )\n","        .value_counts()\n","        .sort_index()\n","    )\n","\n","    if clean_failure_verdicts.empty:\n","        raise ValueError(\n","            \"No failure subtype exists in the clean \"\n","            \"training execution history.\"\n","        )\n","\n","    failure_subtypes = (\n","        clean_failure_verdicts\n","        .index\n","        .to_numpy(dtype=int)\n","    )\n","\n","    failure_subtype_probabilities = (\n","        clean_failure_verdicts\n","        .to_numpy(dtype=float)\n","    )\n","\n","    failure_subtype_probabilities /= (\n","        failure_subtype_probabilities.sum()\n","    )\n","\n","\n","    flip_rng = np.random.default_rng(\n","        stable_project_seed(\n","            project_name,\n","            repetition_seed,\n","            \"flip_mask\",\n","        )\n","    )\n","\n","    subtype_rng = np.random.default_rng(\n","        stable_project_seed(\n","            project_name,\n","            repetition_seed,\n","            \"failure_subtype\",\n","        )\n","    )\n","\n","\n","    # These common uniforms are identical across noise\n","    # levels for the same project and seed.\n","    row_uniforms = flip_rng.random(\n","        number_of_rows\n","    )\n","\n","    flip_mask = (\n","        row_uniforms\n","        \u003c noise_percent / 100.0\n","    )\n","\n","    sampled_failure_subtypes = (\n","        subtype_rng.choice(\n","            failure_subtypes,\n","            size=number_of_rows,\n","            replace=True,\n","            p=failure_subtype_probabilities,\n","        )\n","    )\n","\n","\n","    noisy_verdict = (\n","        original_verdict.copy()\n","    )\n","\n","    pass_to_failure_mask = (\n","        flip_mask\n","        \u0026 (original_verdict == 0)\n","    )\n","\n","    failure_to_pass_mask = (\n","        flip_mask\n","        \u0026 (original_verdict != 0)\n","    )\n","\n","    noisy_verdict[\n","        pass_to_failure_mask\n","    ] = sampled_failure_subtypes[\n","        pass_to_failure_mask\n","    ]\n","\n","    noisy_verdict[\n","        failure_to_pass_mask\n","    ] = 0\n","\n","    noisy_history[\"verdict\"] = (\n","        noisy_verdict\n","    )\n","\n","\n","    manifest = pd.DataFrame({\n","        \"NoiseRowID\":\n","            np.arange(number_of_rows),\n","        \"Build\":\n","            noisy_history[\n","                \"build\"\n","            ].to_numpy(),\n","        \"Test\":\n","            noisy_history[\n","                \"test\"\n","            ].to_numpy(),\n","        \"OriginalVerdict\":\n","            original_verdict,\n","        \"NoisyVerdict\":\n","            noisy_verdict,\n","        \"FlipUniform\":\n","            row_uniforms,\n","        \"Flipped\":\n","            flip_mask,\n","        \"PassToFailure\":\n","            pass_to_failure_mask,\n","        \"FailureToPass\":\n","            failure_to_pass_mask,\n","    })\n","\n","    if \"job\" in noisy_history.columns:\n","        manifest[\"Job\"] = (\n","            noisy_history[\n","                \"job\"\n","            ].to_numpy()\n","        )\n","\n","\n","    number_flipped = int(\n","        flip_mask.sum()\n","    )\n","\n","    summary = {\n","        \"Project\": project_name,\n","        \"NoisePercentRequested\":\n","            float(noise_percent),\n","        \"RepetitionSeed\":\n","            int(repetition_seed),\n","        \"TrainingExecutionRows\":\n","            int(number_of_rows),\n","        \"NumberFlipped\":\n","            number_flipped,\n","        \"RealisedNoisePercent\":\n","            float(\n","                100.0\n","                * number_flipped\n","                / number_of_rows\n","            ),\n","        \"PassToFailure\":\n","            int(\n","                pass_to_failure_mask.sum()\n","            ),\n","        \"FailureToPass\":\n","            int(\n","                failure_to_pass_mask.sum()\n","            ),\n","    }\n","\n","    return (\n","        noisy_history,\n","        manifest,\n","        summary,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Align reconstructed REC features\n","# ---------------------------------------------------------\n","\n","def align_reconstructed_rec_features(\n","    reconstructed,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Return reconstructed REC columns in the exact order\n","    of the fixed model-ready rows.\n","    \"\"\"\n","\n","    requested_with_order = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    requested_with_order[\n","        \"_requested_row_order\"\n","    ] = np.arange(\n","        len(requested_with_order)\n","    )\n","\n","    required_columns = [\n","        \"Build\",\n","        \"Test\",\n","        *REC_FEATURE_COLUMNS,\n","    ]\n","\n","    missing_columns = [\n","        column\n","        for column in required_columns\n","        if column not in reconstructed.columns\n","    ]\n","\n","    if missing_columns:\n","        raise ValueError(\n","            \"Reconstructed data is missing columns: \"\n","            + \", \".join(missing_columns)\n","        )\n","\n","    reconstructed_subset = (\n","        reconstructed[\n","            required_columns\n","        ]\n","        .copy()\n","    )\n","\n","    if reconstructed_subset.duplicated(\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ).any():\n","        raise ValueError(\n","            \"Reconstructed REC data contains duplicate \"\n","            \"Build-Test rows.\"\n","        )\n","\n","    aligned = (\n","        requested_with_order\n","        .merge(\n","            reconstructed_subset,\n","            on=[\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","        .sort_values(\n","            \"_requested_row_order\"\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    if aligned[\n","        REC_FEATURE_COLUMNS\n","    ].isna().any().any():\n","        raise ValueError(\n","            \"At least one requested model-ready row \"\n","            \"contains a missing reconstructed REC value.\"\n","        )\n","\n","    return aligned[\n","        REC_FEATURE_COLUMNS\n","    ].copy()\n","\n","\n","# ---------------------------------------------------------\n","# 7. Map raw noisy verdicts to model-ready rows\n","# ---------------------------------------------------------\n","\n","def extract_model_ready_verdicts(\n","    noisy_execution_history,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Obtain the noisy verdict for each fixed model-ready\n","    Build-Test training row.\n","    \"\"\"\n","\n","    verdict_rows = (\n","        noisy_execution_history[\n","            [\n","                \"build\",\n","                \"test\",\n","                \"verdict\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","    duplicate_verdict_counts = (\n","        verdict_rows\n","        .groupby(\n","            [\n","                \"build\",\n","                \"test\",\n","            ],\n","            sort=False,\n","        )[\"verdict\"]\n","        .nunique()\n","    )\n","\n","    conflicting_duplicates = (\n","        duplicate_verdict_counts[\n","            duplicate_verdict_counts \u003e 1\n","        ]\n","    )\n","\n","    if len(conflicting_duplicates) \u003e 0:\n","        raise ValueError(\n","            \"Raw noisy history contains conflicting \"\n","            \"verdicts for duplicate Build-Test pairs.\"\n","        )\n","\n","    verdict_rows = (\n","        verdict_rows\n","        .drop_duplicates(\n","            [\n","                \"build\",\n","                \"test\",\n","            ],\n","            keep=\"last\",\n","        )\n","        .rename(\n","            columns={\n","                \"build\": \"Build\",\n","                \"test\": \"Test\",\n","                \"verdict\": \"NoisyVerdict\",\n","            }\n","        )\n","    )\n","\n","    requested_with_order = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    requested_with_order[\n","        \"_requested_row_order\"\n","    ] = np.arange(\n","        len(requested_with_order)\n","    )\n","\n","    aligned = (\n","        requested_with_order\n","        .merge(\n","            verdict_rows,\n","            on=[\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","        .sort_values(\n","            \"_requested_row_order\"\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    if aligned[\n","        \"NoisyVerdict\"\n","    ].isna().any():\n","        missing_count = int(\n","            aligned[\n","                \"NoisyVerdict\"\n","            ].isna().sum()\n","        )\n","\n","        raise ValueError(\n","            f\"{missing_count} model-ready training \"\n","            \"rows could not be linked to noisy verdicts.\"\n","        )\n","\n","    return (\n","        aligned[\n","            \"NoisyVerdict\"\n","        ]\n","        .astype(int)\n","        .reset_index(drop=True)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Create fixed-instance noisy model-ready data\n","# ---------------------------------------------------------\n","\n","def create_noisy_model_training_data(\n","    clean_model_training_data,\n","    noisy_execution_history,\n","):\n","    \"\"\"\n","    Preserve the original model-ready training cohort and\n","    non-REC predictors, replacing only:\n","\n","    1. all 19 reconstructed REC features;\n","    2. the corresponding noisy training verdict.\n","    \"\"\"\n","\n","    noisy_model_data = (\n","        clean_model_training_data\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    requested_rows = (\n","        noisy_model_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","    reconstructed = (\n","        reconstruct_rec_features(\n","            execution_history=(\n","                noisy_execution_history\n","            ),\n","            requested_rows=requested_rows,\n","            recent_window=RECENT_WINDOW,\n","        )\n","    )\n","\n","    aligned_rec = (\n","        align_reconstructed_rec_features(\n","            reconstructed,\n","            requested_rows,\n","        )\n","    )\n","\n","    noisy_model_data.loc[\n","        :,\n","        REC_FEATURE_COLUMNS,\n","    ] = aligned_rec.to_numpy()\n","\n","    noisy_model_data[\n","        \"Verdict\"\n","    ] = (\n","        extract_model_ready_verdicts(\n","            noisy_execution_history,\n","            requested_rows,\n","        )\n","        .to_numpy()\n","    )\n","\n","    return noisy_model_data\n","\n","\n","# ---------------------------------------------------------\n","# 9. APFD and APFDc helpers\n","# ---------------------------------------------------------\n","\n","def calculate_apfd(\n","    actual_failures,\n","):\n","    \"\"\"\n","    APFD for one already-ranked evaluation build.\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    number_of_tests = len(\n","        failures\n","    )\n","\n","    number_of_failures = int(\n","        failures.sum()\n","    )\n","\n","    if (\n","        number_of_tests == 0\n","        or number_of_failures == 0\n","    ):\n","        return np.nan\n","\n","    failure_ranks = (\n","        np.flatnonzero(\n","            failures == 1\n","        )\n","        + 1\n","    )\n","\n","    apfd = (\n","        1.0\n","        - failure_ranks.sum()\n","        / (\n","            number_of_tests\n","            * number_of_failures\n","        )\n","        + 1.0\n","        / (\n","            2.0\n","            * number_of_tests\n","        )\n","    )\n","\n","    return float(\n","        apfd\n","    )\n","\n","\n","def calculate_apfdc(\n","    actual_failures,\n","    durations,\n","):\n","    \"\"\"\n","    Cost-aware APFD using midpoint detection times.\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    durations = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","    if len(failures) != len(durations):\n","        raise ValueError(\n","            \"actual_failures and durations must have \"\n","            \"the same length.\"\n","        )\n","\n","    if (\n","        len(failures) == 0\n","        or failures.sum() == 0\n","    ):\n","        return np.nan\n","\n","    if not np.isfinite(\n","        durations\n","    ).all():\n","        raise ValueError(\n","            \"Durations contain missing or infinite values.\"\n","        )\n","\n","    if (\n","        durations \u003c 0\n","    ).any():\n","        raise ValueError(\n","            \"Durations cannot be negative.\"\n","        )\n","\n","    total_duration = float(\n","        durations.sum()\n","    )\n","\n","    if total_duration \u003c= 0:\n","        return np.nan\n","\n","    cumulative_before = np.concatenate([\n","        np.array([0.0]),\n","        np.cumsum(\n","            durations\n","        )[:-1],\n","    ])\n","\n","    failure_mask = (\n","        failures == 1\n","    )\n","\n","    midpoint_detection_times = (\n","        cumulative_before[\n","            failure_mask\n","        ]\n","        + 0.5\n","        * durations[\n","            failure_mask\n","        ]\n","    )\n","\n","    apfdc = (\n","        1.0\n","        - np.mean(\n","            midpoint_detection_times\n","            / total_duration\n","        )\n","    )\n","\n","    return float(\n","        apfdc\n","    )\n","\n","\n","compute_apfd = calculate_apfd\n","compute_apfdc = calculate_apfdc\n","\n","\n","# ---------------------------------------------------------\n","# 10. Self-test: 0% must reproduce clean data\n","# ---------------------------------------------------------\n","\n","(\n","    zero_noise_history,\n","    zero_noise_manifest,\n","    zero_noise_summary,\n",") = inject_training_verdict_noise(\n","    clean_training_history,\n","    noise_percent=0,\n","    repetition_seed=1,\n",")\n","\n","zero_noise_model_data = (\n","    create_noisy_model_training_data(\n","        clean_training_data,\n","        zero_noise_history,\n","    )\n",")\n","\n","\n","zero_label_mismatches = int(\n","    (\n","        zero_noise_model_data[\n","            \"Verdict\"\n","        ].to_numpy()\n","        != clean_training_data[\n","            \"Verdict\"\n","        ].to_numpy()\n","    ).sum()\n",")\n","\n","\n","zero_rec_mismatches = 0\n","\n","for feature in REC_FEATURE_COLUMNS:\n","\n","    reconstructed_values = pd.to_numeric(\n","        zero_noise_model_data[\n","            feature\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    original_values = pd.to_numeric(\n","        clean_training_data[\n","            feature\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    matches = np.isclose(\n","        reconstructed_values,\n","        original_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","    zero_rec_mismatches += int(\n","        (~matches).sum()\n","    )\n","\n","\n","if zero_noise_summary[\n","    \"NumberFlipped\"\n","] != 0:\n","    raise AssertionError(\n","        \"0% noise unexpectedly flipped verdicts.\"\n","    )\n","\n","if zero_label_mismatches != 0:\n","    raise AssertionError(\n","        \"0% reconstruction changed training labels.\"\n","    )\n","\n","if zero_rec_mismatches != 0:\n","    raise AssertionError(\n","        \"0% reconstruction changed REC features.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. Self-test: 5% same-seed reproducibility\n","# ---------------------------------------------------------\n","\n","(\n","    five_history_a,\n","    five_manifest_a,\n","    five_summary_a,\n",") = inject_training_verdict_noise(\n","    clean_training_history,\n","    noise_percent=5,\n","    repetition_seed=1,\n",")\n","\n","(\n","    five_history_b,\n","    five_manifest_b,\n","    five_summary_b,\n",") = inject_training_verdict_noise(\n","    clean_training_history,\n","    noise_percent=5,\n","    repetition_seed=1,\n",")\n","\n","\n","same_seed_verdicts = np.array_equal(\n","    five_history_a[\n","        \"verdict\"\n","    ].to_numpy(),\n","    five_history_b[\n","        \"verdict\"\n","    ].to_numpy(),\n",")\n","\n","same_seed_uniforms = np.array_equal(\n","    five_manifest_a[\n","        \"FlipUniform\"\n","    ].to_numpy(),\n","    five_manifest_b[\n","        \"FlipUniform\"\n","    ].to_numpy(),\n",")\n","\n","same_seed_masks = np.array_equal(\n","    five_manifest_a[\n","        \"Flipped\"\n","    ].to_numpy(),\n","    five_manifest_b[\n","        \"Flipped\"\n","    ].to_numpy(),\n",")\n","\n","same_seed_reproducible = bool(\n","    same_seed_verdicts\n","    and same_seed_uniforms\n","    and same_seed_masks\n",")\n","\n","if not same_seed_reproducible:\n","    raise AssertionError(\n","        \"The same project, noise and seed did not \"\n","        \"reproduce the same corruption.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. Self-test: nested 5% and 10% masks\n","# ---------------------------------------------------------\n","\n","(\n","    ten_history,\n","    ten_manifest,\n","    ten_summary,\n",") = inject_training_verdict_noise(\n","    clean_training_history,\n","    noise_percent=10,\n","    repetition_seed=1,\n",")\n","\n","\n","same_uniform_stream = np.array_equal(\n","    five_manifest_a[\n","        \"FlipUniform\"\n","    ].to_numpy(),\n","    ten_manifest[\n","        \"FlipUniform\"\n","    ].to_numpy(),\n",")\n","\n","five_mask = (\n","    five_manifest_a[\n","        \"Flipped\"\n","    ].to_numpy(dtype=bool)\n",")\n","\n","ten_mask = (\n","    ten_manifest[\n","        \"Flipped\"\n","    ].to_numpy(dtype=bool)\n",")\n","\n","five_is_subset_of_ten = bool(\n","    np.all(\n","        ~five_mask\n","        | ten_mask\n","    )\n",")\n","\n","if not same_uniform_stream:\n","    raise AssertionError(\n","        \"5% and 10% did not use the same common \"\n","        \"uniform stream.\"\n","    )\n","\n","if not five_is_subset_of_ten:\n","    raise AssertionError(\n","        \"The 5% mask is not nested inside the 10% mask.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. Self-test: noise propagates into model-ready data\n","# ---------------------------------------------------------\n","\n","five_noise_model_data = (\n","    create_noisy_model_training_data(\n","        clean_training_data,\n","        five_history_a,\n","    )\n",")\n","\n","\n","five_model_label_changes = int(\n","    (\n","        five_noise_model_data[\n","            \"Verdict\"\n","        ].to_numpy()\n","        != clean_training_data[\n","            \"Verdict\"\n","        ].to_numpy()\n","    ).sum()\n",")\n","\n","\n","five_rec_value_changes = 0\n","\n","for feature in REC_FEATURE_COLUMNS:\n","\n","    noisy_values = pd.to_numeric(\n","        five_noise_model_data[\n","            feature\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    clean_values = pd.to_numeric(\n","        clean_training_data[\n","            feature\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","    equal_values = np.isclose(\n","        noisy_values,\n","        clean_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","    five_rec_value_changes += int(\n","        (~equal_values).sum()\n","    )\n","\n","\n","if five_model_label_changes == 0:\n","    raise AssertionError(\n","        \"5% raw noise caused no model-ready label changes.\"\n","    )\n","\n","if five_rec_value_changes == 0:\n","    raise AssertionError(\n","        \"5% raw noise caused no REC feature changes.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 14. Self-test: evaluation data remained untouched\n","# ---------------------------------------------------------\n","\n","evaluation_hash_after = int(\n","    pd.util.hash_pandas_object(\n","        clean_evaluation_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"Duration\",\n","                *REC_FEATURE_COLUMNS,\n","            ]\n","        ],\n","        index=True,\n","    ).sum()\n",")\n","\n","evaluation_unchanged = bool(\n","    evaluation_hash_before\n","    == evaluation_hash_after\n",")\n","\n","if not evaluation_unchanged:\n","    raise AssertionError(\n","        \"The clean evaluation partition was modified.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 15. Self-test: APFD and APFDc\n","# ---------------------------------------------------------\n","\n","manual_failures = [\n","    1,\n","    1,\n","    0,\n","    0,\n","    0,\n","]\n","\n","manual_apfd = calculate_apfd(\n","    manual_failures\n",")\n","\n","manual_apfdc_long_first = (\n","    calculate_apfdc(\n","        manual_failures,\n","        [\n","            5,\n","            1,\n","            1,\n","            1,\n","            1,\n","        ],\n","    )\n",")\n","\n","manual_apfdc_quick_first = (\n","    calculate_apfdc(\n","        manual_failures,\n","        [\n","            1,\n","            5,\n","            1,\n","            1,\n","            1,\n","        ],\n","    )\n",")\n","\n","\n","if not np.isclose(\n","    manual_apfd,\n","    0.8,\n","):\n","    raise AssertionError(\n","        \"Manual APFD validation failed.\"\n","    )\n","\n","if not np.isclose(\n","    manual_apfdc_long_first,\n","    5.0 / 9.0,\n","):\n","    raise AssertionError(\n","        \"Long-failure-first APFDc validation failed.\"\n","    )\n","\n","if not np.isclose(\n","    manual_apfdc_quick_first,\n","    7.0 / 9.0,\n","):\n","    raise AssertionError(\n","        \"Quick-failure-first APFDc validation failed.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 16. Save validation evidence\n","# ---------------------------------------------------------\n","\n","validation_report = {\n","    \"Project\": PROJECT_NAME,\n","    \"Status\": \"PASS\",\n","    \"RawTrainingExecutionRows\":\n","        int(len(clean_training_history)),\n","    \"RawEvaluationExecutionRows\":\n","        int(len(clean_evaluation_history)),\n","    \"FailureSubtypeCounts\": {\n","        str(int(key)): int(value)\n","        for key, value\n","        in clean_failure_subtype_counts.items()\n","    },\n","    \"ZeroPercent\": {\n","        \"NumberFlipped\":\n","            int(\n","                zero_noise_summary[\n","                    \"NumberFlipped\"\n","                ]\n","            ),\n","        \"TrainingLabelMismatches\":\n","            int(zero_label_mismatches),\n","        \"RECValueMismatches\":\n","            int(zero_rec_mismatches),\n","    },\n","    \"FivePercentSeed1\": {\n","        **five_summary_a,\n","        \"SameSeedReproducible\":\n","            bool(same_seed_reproducible),\n","        \"ModelReadyLabelChanges\":\n","            int(five_model_label_changes),\n","        \"RECValueChanges\":\n","            int(five_rec_value_changes),\n","    },\n","    \"NestedMaskValidation\": {\n","        \"SameUniformStream5And10\":\n","            bool(same_uniform_stream),\n","        \"FivePercentSubsetOfTenPercent\":\n","            bool(five_is_subset_of_ten),\n","    },\n","    \"EvaluationUnchanged\":\n","        bool(evaluation_unchanged),\n","    \"MetricValidation\": {\n","        \"APFD\":\n","            float(manual_apfd),\n","        \"APFDcLongFailureFirst\":\n","            float(\n","                manual_apfdc_long_first\n","            ),\n","        \"APFDcQuickFailureFirst\":\n","            float(\n","                manual_apfdc_quick_first\n","            ),\n","    },\n","}\n","\n","\n","VALIDATION_REPORT_PATH = (\n","    PREFLIGHT_DIRECTORY\n","    / \"snow_owl_canonical_helper_validation.json\"\n",")\n","\n","NOISE_SELFTEST_PATH = (\n","    PREFLIGHT_DIRECTORY\n","    / \"snow_owl_noise_selftest_summary.csv\"\n",")\n","\n","with open(\n","    VALIDATION_REPORT_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as validation_file:\n","    json.dump(\n","        validation_report,\n","        validation_file,\n","        indent=2,\n","    )\n","\n","\n","noise_selftest_summary = pd.DataFrame([\n","    zero_noise_summary,\n","    five_summary_a,\n","    ten_summary,\n","])\n","\n","noise_selftest_summary.to_csv(\n","    NOISE_SELFTEST_PATH,\n","    index=False,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 17. Final output\n","# ---------------------------------------------------------\n","\n","print(\n","    \"=== SNOW OWL CANONICAL HELPER VALIDATION ===\"\n",")\n","\n","print(\"\\nProtocol saved:\")\n","print(PROTOCOL_PATH)\n","\n","print(\"\\nRaw histories:\")\n","print(\n","    \"Training execution rows:\",\n","    len(clean_training_history),\n",")\n","print(\n","    \"Evaluation execution rows:\",\n","    len(clean_evaluation_history),\n",")\n","\n","print(\"\\nClean failure subtype distribution:\")\n","print(clean_failure_subtype_counts)\n","\n","print(\"\\n0% validation:\")\n","print(\n","    \"Flipped verdicts:\",\n","    zero_noise_summary[\n","        \"NumberFlipped\"\n","    ],\n",")\n","print(\n","    \"Training-label mismatches:\",\n","    zero_label_mismatches,\n",")\n","print(\n","    \"REC-value mismatches:\",\n","    zero_rec_mismatches,\n",")\n","\n","print(\"\\n5% seed 1 validation:\")\n","print(\n","    \"Flipped raw verdicts:\",\n","    five_summary_a[\n","        \"NumberFlipped\"\n","    ],\n",")\n","print(\n","    \"Realised noise percentage:\",\n","    round(\n","        five_summary_a[\n","            \"RealisedNoisePercent\"\n","        ],\n","        6,\n","    ),\n",")\n","print(\n","    \"Pass to failure:\",\n","    five_summary_a[\n","        \"PassToFailure\"\n","    ],\n",")\n","print(\n","    \"Failure to pass:\",\n","    five_summary_a[\n","        \"FailureToPass\"\n","    ],\n",")\n","print(\n","    \"Model-ready label changes:\",\n","    five_model_label_changes,\n",")\n","print(\n","    \"REC-value changes:\",\n","    five_rec_value_changes,\n",")\n","print(\n","    \"Same-seed reproducible:\",\n","    same_seed_reproducible,\n",")\n","\n","print(\"\\nNested-mask validation:\")\n","print(\n","    \"Same 5%/10% uniform stream:\",\n","    same_uniform_stream,\n",")\n","print(\n","    \"5% mask subset of 10% mask:\",\n","    five_is_subset_of_ten,\n",")\n","\n","print(\"\\nEvaluation protection:\")\n","print(\n","    \"Evaluation unchanged:\",\n","    evaluation_unchanged,\n",")\n","\n","print(\"\\nMetric validation:\")\n","print(\n","    \"APFD:\",\n","    round(\n","        manual_apfd,\n","        6,\n","    ),\n",")\n","print(\n","    \"APFDc long failure first:\",\n","    round(\n","        manual_apfdc_long_first,\n","        6,\n","    ),\n",")\n","print(\n","    \"APFDc quick failure first:\",\n","    round(\n","        manual_apfdc_quick_first,\n","        6,\n","    ),\n",")\n","\n","print(\"\\nValidation files saved:\")\n","print(VALIDATION_REPORT_PATH)\n","print(NOISE_SELFTEST_PATH)\n","\n","print(\n","    \"\\nSUCCESS: Snow Owl canonical noise helpers \"\n","    \"are ready.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":6614,"status":"ok","timestamp":1784898244102,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"WGIIoD3ZOZen","outputId":"b17d094f-b356-4140-b3e1-1164e97793de"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== SNOW OWL FEATURE PROTOCOL ===\n","Original predictor columns: 150\n","Frozen zero-variance columns: 5\n","Active predictor columns: 145\n","\n","Zero-variance columns:\n"," - TES_COM_CountDeclClassMethod\n"," - TES_COM_CountDeclMethodDefault\n"," - TES_CHN_DMMSize\n"," - TES_CHN_DMMComplexity\n"," - TES_CHN_DMMInterfacing\n","\n","SUCCESS: Snow Owl unified condition runner is defined.\n","Model configuration saved:\n","/content/drive/MyDrive/Thesis_Experiment/Notes/b2ihealthcare__snow-owl_model_configuration_v1.json\n"]}],"source":["# =========================================================\n","# PROJECT 3: SNOW OWL\n","# UNIFIED EXPERIMENT CONDITION RUNNER\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","import time\n","import warnings\n","\n","import numpy as np\n","import pandas as pd\n","\n","from sklearn.ensemble import RandomForestClassifier\n","from sklearn.naive_bayes import GaussianNB\n","\n","from xgboost import XGBClassifier\n","from lightgbm import LGBMClassifier\n","\n","\n","# ---------------------------------------------------------\n","# 1. Freeze feature preprocessing\n","# ---------------------------------------------------------\n","\n","clean_feature_frame = (\n","    clean_training_data[\n","        MODEL_FEATURE_COLUMNS\n","    ]\n","    .apply(\n","        pd.to_numeric,\n","        errors=\"coerce\",\n","    )\n","    .replace(\n","        [np.inf, -np.inf],\n","        np.nan,\n","    )\n",")\n","\n","\n","# Identify zero-variance predictors using only the clean\n","# training partition. This set remains fixed at every\n","# noise level and seed.\n","feature_variation = (\n","    clean_feature_frame\n","    .nunique(dropna=False)\n",")\n","\n","ZERO_VARIANCE_FEATURES = (\n","    feature_variation[\n","        feature_variation \u003c= 1\n","    ]\n","    .index\n","    .tolist()\n",")\n","\n","ACTIVE_FEATURE_COLUMNS = [\n","    column\n","    for column in MODEL_FEATURE_COLUMNS\n","    if column not in ZERO_VARIANCE_FEATURES\n","]\n","\n","\n","if len(ACTIVE_FEATURE_COLUMNS) == 0:\n","    raise RuntimeError(\n","        \"No active predictor columns remain.\"\n","    )\n","\n","\n","print(\"=== SNOW OWL FEATURE PROTOCOL ===\")\n","\n","print(\n","    \"Original predictor columns:\",\n","    len(MODEL_FEATURE_COLUMNS),\n",")\n","\n","print(\n","    \"Frozen zero-variance columns:\",\n","    len(ZERO_VARIANCE_FEATURES),\n",")\n","\n","print(\n","    \"Active predictor columns:\",\n","    len(ACTIVE_FEATURE_COLUMNS),\n",")\n","\n","print(\"\\nZero-variance columns:\")\n","\n","if ZERO_VARIANCE_FEATURES:\n","    for column in ZERO_VARIANCE_FEATURES:\n","        print(\" -\", column)\n","else:\n","    print(\" None\")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Frozen model configurations\n","# ---------------------------------------------------------\n","\n","MODEL_CONFIG = {\n","    \"RandomForest\": {\n","        \"n_estimators\": 100,\n","        \"criterion\": \"gini\",\n","        \"max_depth\": None,\n","        \"min_samples_split\": 2,\n","        \"min_samples_leaf\": 1,\n","        \"max_features\": \"sqrt\",\n","        \"bootstrap\": True,\n","        \"class_weight\": None,\n","    },\n","\n","    \"XGBoost\": {\n","        \"n_estimators\": 100,\n","        \"max_depth\": 6,\n","        \"learning_rate\": 0.1,\n","        \"subsample\": 1.0,\n","        \"colsample_bytree\": 1.0,\n","        \"objective\": \"binary:logistic\",\n","        \"eval_metric\": \"logloss\",\n","        \"tree_method\": \"hist\",\n","    },\n","\n","    \"LightGBM\": {\n","        \"n_estimators\": 100,\n","        \"learning_rate\": 0.1,\n","        \"num_leaves\": 31,\n","        \"objective\": \"binary\",\n","    },\n","\n","    \"NaiveBayes\": {\n","        \"variant\": \"GaussianNB\",\n","        \"var_smoothing\": 1e-9,\n","    },\n","}\n","\n","\n","MODEL_CONFIGURATION_PATH = (\n","    NOTES_DRIVE\n","    / \"b2ihealthcare__snow-owl_model_configuration_v1.json\"\n",")\n","\n","with open(\n","    MODEL_CONFIGURATION_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as configuration_file:\n","\n","    json.dump(\n","        {\n","            \"project\": PROJECT_NAME,\n","            \"status\": \"FROZEN_FOR_REMAINING_PROJECTS\",\n","            \"original_feature_count\":\n","                len(MODEL_FEATURE_COLUMNS),\n","            \"active_feature_count\":\n","                len(ACTIVE_FEATURE_COLUMNS),\n","            \"zero_variance_features\":\n","                ZERO_VARIANCE_FEATURES,\n","            \"missing_value_rule\":\n","                \"current training-condition median\",\n","            \"infinite_value_rule\":\n","                \"replace with missing, then training median\",\n","            \"ranking_tie_rule\":\n","                \"score first, Test ascending\",\n","            \"models\":\n","                MODEL_CONFIG,\n","        },\n","        configuration_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Prepare shared ML matrices\n","# ---------------------------------------------------------\n","\n","def prepare_ml_matrices(\n","    noisy_training_data,\n","    clean_evaluation_data,\n","):\n","    \"\"\"\n","    Prepare common train and evaluation matrices for all\n","    four supervised models.\n","\n","    Medians are learned only from the noisy training\n","    condition and applied to both partitions.\n","    \"\"\"\n","\n","    X_train = (\n","        noisy_training_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [np.inf, -np.inf],\n","            np.nan,\n","        )\n","    )\n","\n","    X_evaluation = (\n","        clean_evaluation_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [np.inf, -np.inf],\n","            np.nan,\n","        )\n","    )\n","\n","    training_medians = (\n","        X_train\n","        .median(axis=0)\n","        .fillna(0.0)\n","    )\n","\n","    X_train = (\n","        X_train\n","        .fillna(training_medians)\n","        .astype(float)\n","    )\n","\n","    X_evaluation = (\n","        X_evaluation\n","        .fillna(training_medians)\n","        .astype(float)\n","    )\n","\n","    y_train = (\n","        noisy_training_data[\n","            \"Verdict\"\n","        ] != 0\n","    ).astype(int)\n","\n","    if y_train.nunique() != 2:\n","        raise ValueError(\n","            \"Noisy training labels do not contain \"\n","            \"both pass and failure classes.\"\n","        )\n","\n","    if X_train.isna().any().any():\n","        raise ValueError(\n","            \"Training features still contain \"\n","            \"missing values.\"\n","        )\n","\n","    if X_evaluation.isna().any().any():\n","        raise ValueError(\n","            \"Evaluation features still contain \"\n","            \"missing values.\"\n","        )\n","\n","    if list(X_train.columns) != list(\n","        X_evaluation.columns\n","    ):\n","        raise AssertionError(\n","            \"Training and evaluation feature columns differ.\"\n","        )\n","\n","    return (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Create four ML models\n","# ---------------------------------------------------------\n","\n","def create_ml_models(\n","    repetition_seed,\n","):\n","    \"\"\"\n","    Construct the four models with deterministic,\n","    project-specific seeds.\n","    \"\"\"\n","\n","    rf_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"RandomForest_model\",\n","    )\n","\n","    xgb_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"XGBoost_model\",\n","    )\n","\n","    lgbm_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"LightGBM_model\",\n","    )\n","\n","    return {\n","        \"RandomForest\":\n","            RandomForestClassifier(\n","                **MODEL_CONFIG[\n","                    \"RandomForest\"\n","                ],\n","                random_state=rf_seed,\n","                n_jobs=-1,\n","            ),\n","\n","        \"XGBoost\":\n","            XGBClassifier(\n","                **MODEL_CONFIG[\n","                    \"XGBoost\"\n","                ],\n","                random_state=xgb_seed,\n","                n_jobs=-1,\n","                verbosity=0,\n","            ),\n","\n","        \"LightGBM\":\n","            LGBMClassifier(\n","                **MODEL_CONFIG[\n","                    \"LightGBM\"\n","                ],\n","                random_state=lgbm_seed,\n","                n_jobs=-1,\n","                verbosity=-1,\n","                deterministic=True,\n","                force_col_wise=True,\n","            ),\n","\n","        \"NaiveBayes\":\n","            GaussianNB(\n","                var_smoothing=(\n","                    MODEL_CONFIG[\n","                        \"NaiveBayes\"\n","                    ][\n","                        \"var_smoothing\"\n","                    ]\n","                )\n","            ),\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# 5. Extract predicted failure probability\n","# ---------------------------------------------------------\n","\n","def get_failure_probability(\n","    fitted_model,\n","    feature_matrix,\n","):\n","    probabilities = (\n","        fitted_model\n","        .predict_proba(\n","            feature_matrix\n","        )\n","    )\n","\n","    classes = np.asarray(\n","        fitted_model.classes_\n","    )\n","\n","    positive_positions = np.where(\n","        classes == 1\n","    )[0]\n","\n","    if len(positive_positions) != 1:\n","        raise ValueError(\n","            \"Could not identify failure class 1.\"\n","        )\n","\n","    failure_probabilities = (\n","        probabilities[\n","            :,\n","            positive_positions[0],\n","        ]\n","    )\n","\n","    if not np.isfinite(\n","        failure_probabilities\n","    ).all():\n","        raise ValueError(\n","            \"Predicted probabilities contain \"\n","            \"missing or infinite values.\"\n","        )\n","\n","    return failure_probabilities\n","\n","\n","# ---------------------------------------------------------\n","# 6. Rank one evaluation build\n","# ---------------------------------------------------------\n","\n","def rank_build_rows(\n","    build_rows,\n","    scores,\n","    technique,\n","    score_direction=\"descending\",\n","):\n","    \"\"\"\n","    Rank one build using score followed by Test ascending.\n","\n","    ML, Random and LatestFail:\n","        higher score first.\n","\n","    QTF-Avg:\n","        lower historical average duration first.\n","    \"\"\"\n","\n","    ranked = (\n","        build_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"Duration\",\n","                \"build_order\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    if len(ranked) != len(scores):\n","        raise ValueError(\n","            \"Number of scores does not match \"\n","            \"number of tests.\"\n","        )\n","\n","    ranked[\"Technique\"] = technique\n","\n","    ranked[\"Score\"] = np.asarray(\n","        scores,\n","        dtype=float,\n","    )\n","\n","    ranked[\"ActualFailure\"] = (\n","        ranked[\"Verdict\"] != 0\n","    ).astype(int)\n","\n","    ranked[\"Duration\"] = pd.to_numeric(\n","        ranked[\"Duration\"],\n","        errors=\"raise\",\n","    ).astype(float)\n","\n","    if score_direction == \"descending\":\n","        ascending = [\n","            False,\n","            True,\n","        ]\n","\n","    elif score_direction == \"ascending\":\n","        ascending = [\n","            True,\n","            True,\n","        ]\n","\n","    else:\n","        raise ValueError(\n","            \"score_direction must be either \"\n","            \"'ascending' or 'descending'.\"\n","        )\n","\n","    ranked = (\n","        ranked\n","        .sort_values(\n","            [\n","                \"Score\",\n","                \"Test\",\n","            ],\n","            ascending=ascending,\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    ranked[\"Rank\"] = np.arange(\n","        1,\n","        len(ranked) + 1,\n","    )\n","\n","    return ranked\n","\n","\n","# ---------------------------------------------------------\n","# 7. Create ML rankings\n","# ---------------------------------------------------------\n","\n","def create_ml_rankings(\n","    evaluation_data,\n","    technique,\n","    failure_probabilities,\n","):\n","    scored_data = (\n","        evaluation_data\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","    if len(scored_data) != len(\n","        failure_probabilities\n","    ):\n","        raise ValueError(\n","            \"Prediction count does not match \"\n","            \"evaluation row count.\"\n","        )\n","\n","    scored_data[\n","        \"_FailureProbability\"\n","    ] = failure_probabilities\n","\n","    rankings = []\n","\n","    for build_id, build_rows in (\n","        scored_data.groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","        rankings.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","                scores=(\n","                    build_rows[\n","                        \"_FailureProbability\"\n","                    ].to_numpy()\n","                ),\n","                technique=technique,\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","    return pd.concat(\n","        rankings,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Random baseline\n","# ---------------------------------------------------------\n","\n","def create_random_rankings(\n","    evaluation_data,\n","    repetition_seed,\n","):\n","    \"\"\"\n","    Deterministic per project, seed and build.\n","\n","    Because the noise level is not part of the random\n","    stream name, Random remains constant across noise\n","    levels within the same seed.\n","    \"\"\"\n","\n","    rankings = []\n","\n","    for build_id, build_rows in (\n","        evaluation_data.groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","\n","        random_rng = np.random.default_rng(\n","            stable_project_seed(\n","                PROJECT_NAME,\n","                repetition_seed,\n","                (\n","                    \"Random_baseline_build_\"\n","                    f\"{build_id}\"\n","                ),\n","            )\n","        )\n","\n","        random_scores = (\n","            random_rng.random(\n","                len(build_rows)\n","            )\n","        )\n","\n","        rankings.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","                scores=random_scores,\n","                technique=\"Random\",\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","    return pd.concat(\n","        rankings,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Initialise historical baselines\n","# ---------------------------------------------------------\n","\n","def initialise_history_baselines(\n","    noisy_training_history,\n","):\n","    \"\"\"\n","    LatestFail uses the noisy training verdict history.\n","\n","    QTF-Avg uses clean historical durations and is\n","    therefore initialized from clean training history.\n","    \"\"\"\n","\n","    latest_failure_order = {}\n","\n","    noisy_history_sorted = (\n","        noisy_training_history\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"job\",\n","                \"test\",\n","            ]\n","        )\n","    )\n","\n","    for row in (\n","        noisy_history_sorted\n","        .itertuples(index=False)\n","    ):\n","        test_key = str(\n","            row.test\n","        )\n","\n","        if int(row.verdict) != 0:\n","            latest_failure_order[\n","                test_key\n","            ] = int(\n","                row.build_order\n","            )\n","\n","\n","    duration_sum = {}\n","    duration_count = {}\n","\n","    clean_duration_history = (\n","        clean_training_history\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"job\",\n","                \"test\",\n","            ]\n","        )\n","    )\n","\n","    for row in (\n","        clean_duration_history\n","        .itertuples(index=False)\n","    ):\n","        test_key = str(\n","            row.test\n","        )\n","\n","        duration = float(\n","            row.duration\n","        )\n","\n","        if not np.isfinite(duration):\n","            continue\n","\n","        duration_sum[test_key] = (\n","            duration_sum.get(\n","                test_key,\n","                0.0,\n","            )\n","            + duration\n","        )\n","\n","        duration_count[test_key] = (\n","            duration_count.get(\n","                test_key,\n","                0,\n","            )\n","            + 1\n","        )\n","\n","    return (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. LatestFail and QTF-Avg rankings\n","# ---------------------------------------------------------\n","\n","def create_history_baseline_rankings(\n","    noisy_training_history,\n","):\n","    \"\"\"\n","    Process all evaluation-period builds chronologically.\n","\n","    Rank before observing the current build. Afterward,\n","    append its clean executions to the historical state.\n","    \"\"\"\n","\n","    (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    ) = initialise_history_baselines(\n","        noisy_training_history\n","    )\n","\n","    target_build_ids = set(\n","        clean_evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","    raw_eval_by_build = {\n","        int(build_id): rows.copy()\n","        for build_id, rows in (\n","            clean_evaluation_history\n","            .groupby(\n","                \"build\",\n","                sort=False,\n","            )\n","        )\n","    }\n","\n","    model_eval_by_build = {\n","        int(build_id): rows.copy()\n","        for build_id, rows in (\n","            clean_evaluation_data\n","            .groupby(\n","                \"Build\",\n","                sort=False,\n","            )\n","        )\n","    }\n","\n","    latest_fail_rankings = []\n","    qtf_rankings = []\n","\n","    ordered_evaluation_builds = (\n","        evaluation_build_table\n","        .sort_values(\n","            \"build_order\"\n","        )\n","    )\n","\n","    for build_row in (\n","        ordered_evaluation_builds\n","        .itertuples(index=False)\n","    ):\n","\n","        build_id = int(\n","            build_row.id\n","        )\n","\n","        # Rank before seeing current build outcomes.\n","        if build_id in target_build_ids:\n","\n","            build_tests = (\n","                model_eval_by_build[\n","                    build_id\n","                ]\n","                .copy()\n","            )\n","\n","            latest_scores = []\n","            qtf_average_scores = []\n","\n","            for test_value in (\n","                build_tests[\"Test\"]\n","            ):\n","\n","                test_key = str(\n","                    test_value\n","                )\n","\n","                latest_scores.append(\n","                    float(\n","                        latest_failure_order.get(\n","                            test_key,\n","                            -1,\n","                        )\n","                    )\n","                )\n","\n","                count = (\n","                    duration_count.get(\n","                        test_key,\n","                        0,\n","                    )\n","                )\n","\n","                if count \u003e 0:\n","                    average_duration = (\n","                        duration_sum[\n","                            test_key\n","                        ]\n","                        / count\n","                    )\n","                else:\n","                    average_duration = (\n","                        np.inf\n","                    )\n","\n","                qtf_average_scores.append(\n","                    float(\n","                        average_duration\n","                    )\n","                )\n","\n","            latest_fail_rankings.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","                    scores=latest_scores,\n","                    technique=\"LatestFail\",\n","                    score_direction=\"descending\",\n","                )\n","            )\n","\n","            qtf_rankings.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","                    scores=qtf_average_scores,\n","                    technique=\"QTF-Avg\",\n","                    score_direction=\"ascending\",\n","                )\n","            )\n","\n","\n","        # Update histories only after ranking current build.\n","        current_raw_rows = (\n","            raw_eval_by_build.get(\n","                build_id\n","            )\n","        )\n","\n","        if current_raw_rows is None:\n","            continue\n","\n","        current_raw_rows = (\n","            current_raw_rows\n","            .sort_values(\n","                [\n","                    \"job\",\n","                    \"test\",\n","                ]\n","            )\n","        )\n","\n","        for execution_row in (\n","            current_raw_rows\n","            .itertuples(index=False)\n","        ):\n","\n","            test_key = str(\n","                execution_row.test\n","            )\n","\n","            if int(\n","                execution_row.verdict\n","            ) != 0:\n","\n","                latest_failure_order[\n","                    test_key\n","                ] = int(\n","                    execution_row.build_order\n","                )\n","\n","            duration = float(\n","                execution_row.duration\n","            )\n","\n","            if np.isfinite(duration):\n","\n","                duration_sum[test_key] = (\n","                    duration_sum.get(\n","                        test_key,\n","                        0.0,\n","                    )\n","                    + duration\n","                )\n","\n","                duration_count[test_key] = (\n","                    duration_count.get(\n","                        test_key,\n","                        0,\n","                    )\n","                    + 1\n","                )\n","\n","    if len(latest_fail_rankings) == 0:\n","        raise RuntimeError(\n","            \"No LatestFail rankings were created.\"\n","        )\n","\n","    if len(qtf_rankings) == 0:\n","        raise RuntimeError(\n","            \"No QTF-Avg rankings were created.\"\n","        )\n","\n","    return (\n","        pd.concat(\n","            latest_fail_rankings,\n","            ignore_index=True,\n","        ),\n","        pd.concat(\n","            qtf_rankings,\n","            ignore_index=True,\n","        ),\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. Calculate build-level metrics\n","# ---------------------------------------------------------\n","\n","def calculate_build_metrics(\n","    all_rankings,\n","    noise_percent,\n","    repetition_seed,\n","):\n","    metric_records = []\n","\n","    grouped_rankings = (\n","        all_rankings\n","        .groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ],\n","            sort=False,\n","        )\n","    )\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in grouped_rankings:\n","\n","        ranked_build = (\n","            ranked_build\n","            .sort_values(\n","                \"Rank\"\n","            )\n","        )\n","\n","        actual_failures = (\n","            ranked_build[\n","                \"ActualFailure\"\n","            ]\n","            .to_numpy()\n","        )\n","\n","        durations = (\n","            ranked_build[\n","                \"Duration\"\n","            ]\n","            .to_numpy()\n","        )\n","\n","        number_of_tests = len(\n","            ranked_build\n","        )\n","\n","        number_of_failures = int(\n","            actual_failures.sum()\n","        )\n","\n","        apfd = calculate_apfd(\n","            actual_failures\n","        )\n","\n","        apfdc = calculate_apfdc(\n","            actual_failures,\n","            durations,\n","        )\n","\n","        metric_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","            \"NoisePercent\":\n","                float(noise_percent),\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","            \"Technique\":\n","                technique,\n","            \"Build\":\n","                int(build_id),\n","            \"BuildOrder\":\n","                int(\n","                    ranked_build[\n","                        \"build_order\"\n","                    ].iloc[0]\n","                ),\n","            \"NumberOfTests\":\n","                int(number_of_tests),\n","            \"NumberOfFailures\":\n","                int(number_of_failures),\n","            \"APFD\":\n","                float(apfd),\n","            \"APFDc\":\n","                float(apfdc),\n","        })\n","\n","    return pd.DataFrame(\n","        metric_records\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. Validate one complete condition\n","# ---------------------------------------------------------\n","\n","def validate_condition_outputs(\n","    rankings,\n","    build_metrics,\n","):\n","    expected_techniques = set(\n","        ML_TECHNIQUES\n","        + BASELINE_TECHNIQUES\n","    )\n","\n","    actual_techniques = set(\n","        rankings[\n","            \"Technique\"\n","        ].unique()\n","    )\n","\n","    if actual_techniques != expected_techniques:\n","        raise AssertionError(\n","            \"Technique mismatch. Expected \"\n","            f\"{expected_techniques}, got \"\n","            f\"{actual_techniques}.\"\n","        )\n","\n","    expected_builds = set(\n","        clean_evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","    metric_builds = set(\n","        build_metrics[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","    if metric_builds != expected_builds:\n","        raise AssertionError(\n","            \"Not all clean evaluation builds \"\n","            \"received metrics.\"\n","        )\n","\n","    expected_metric_rows = (\n","        len(expected_builds)\n","        * len(expected_techniques)\n","    )\n","\n","    if len(build_metrics) != (\n","        expected_metric_rows\n","    ):\n","        raise AssertionError(\n","            \"Unexpected number of build-metric rows.\"\n","        )\n","\n","    if build_metrics[\n","        [\n","            \"APFD\",\n","            \"APFDc\",\n","        ]\n","    ].isna().any().any():\n","        raise AssertionError(\n","            \"APFD or APFDc contains missing values.\"\n","        )\n","\n","    for metric_column in [\n","        \"APFD\",\n","        \"APFDc\",\n","    ]:\n","\n","        if not build_metrics[\n","            metric_column\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","\n","            raise AssertionError(\n","                f\"{metric_column} contains values \"\n","                \"outside [0, 1].\"\n","            )\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in (\n","        rankings.groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ]\n","        )\n","    ):\n","\n","        expected_ranks = np.arange(\n","            1,\n","            len(ranked_build) + 1,\n","        )\n","\n","        actual_ranks = np.sort(\n","            ranked_build[\n","                \"Rank\"\n","            ].to_numpy()\n","        )\n","\n","        if not np.array_equal(\n","            actual_ranks,\n","            expected_ranks,\n","        ):\n","            raise AssertionError(\n","                \"Invalid rank sequence for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","        if ranked_build[\n","            \"Test\"\n","        ].duplicated().any():\n","            raise AssertionError(\n","                \"Duplicate tests in ranking for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","    return True\n","\n","\n","# ---------------------------------------------------------\n","# 13. Run one project × noise × seed condition\n","# ---------------------------------------------------------\n","\n","def run_unified_condition(\n","    noise_percent,\n","    repetition_seed,\n","    save_rankings=True,\n","    overwrite=False,\n","):\n","    \"\"\"\n","    Run one Snow Owl condition.\n","\n","    One noisy training history is shared by all four\n","    ML models and LatestFail.\n","    \"\"\"\n","\n","    condition_start_time = (\n","        time.time()\n","    )\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{int(repetition_seed):02d}\"\n","    )\n","\n","    condition_directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","    completion_marker = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","    if (\n","        completion_marker.exists()\n","        and not overwrite\n","    ):\n","        raise FileExistsError(\n","            \"Condition already has a success marker:\\n\"\n","            f\"{completion_marker}\\n\"\n","            \"Use overwrite=True only for an intentional \"\n","            \"rerun.\"\n","        )\n","\n","\n","    evaluation_hash_before_condition = int(\n","        pd.util.hash_pandas_object(\n","            clean_evaluation_data[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    \"Verdict\",\n","                    \"Duration\",\n","                    *REC_FEATURE_COLUMNS,\n","                ]\n","            ],\n","            index=True,\n","        ).sum()\n","    )\n","\n","\n","    # One shared corruption.\n","    (\n","        noisy_training_history,\n","        noise_manifest,\n","        noise_summary,\n","    ) = inject_training_verdict_noise(\n","        clean_training_history,\n","        noise_percent=noise_percent,\n","        repetition_seed=repetition_seed,\n","    )\n","\n","\n","    # One shared fixed-instance reconstructed dataset.\n","    noisy_training_data = (\n","        create_noisy_model_training_data(\n","            clean_training_data,\n","            noisy_training_history,\n","        )\n","    )\n","\n","\n","    (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    ) = prepare_ml_matrices(\n","        noisy_training_data,\n","        clean_evaluation_data,\n","    )\n","\n","\n","    all_ranking_frames = []\n","    fit_records = []\n","\n","    models = create_ml_models(\n","        repetition_seed\n","    )\n","\n","\n","    # Four ML models.\n","    for technique, model in (\n","        models.items()\n","    ):\n","\n","        model_start_time = (\n","            time.time()\n","        )\n","\n","        with warnings.catch_warnings():\n","            warnings.simplefilter(\n","                \"ignore\"\n","            )\n","\n","            model.fit(\n","                X_train,\n","                y_train,\n","            )\n","\n","        failure_probabilities = (\n","            get_failure_probability(\n","                model,\n","                X_evaluation,\n","            )\n","        )\n","\n","        model_rankings = (\n","            create_ml_rankings(\n","                evaluation_data=(\n","                    clean_evaluation_data\n","                ),\n","                technique=technique,\n","                failure_probabilities=(\n","                    failure_probabilities\n","                ),\n","            )\n","        )\n","\n","        all_ranking_frames.append(\n","            model_rankings\n","        )\n","\n","        fit_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","            \"NoisePercent\":\n","                float(noise_percent),\n","            \"RepetitionSeed\":\n","                int(repetition_seed),\n","            \"Technique\":\n","                technique,\n","            \"FitSeconds\":\n","                float(\n","                    time.time()\n","                    - model_start_time\n","                ),\n","            \"TrainingRows\":\n","                int(len(X_train)),\n","            \"TrainingFailures\":\n","                int(y_train.sum()),\n","            \"TrainingPasses\":\n","                int(\n","                    len(y_train)\n","                    - y_train.sum()\n","                ),\n","            \"ActiveFeatures\":\n","                int(\n","                    len(\n","                        ACTIVE_FEATURE_COLUMNS\n","                    )\n","                ),\n","        })\n","\n","\n","    # Random baseline.\n","    random_rankings = (\n","        create_random_rankings(\n","            clean_evaluation_data,\n","            repetition_seed,\n","        )\n","    )\n","\n","    all_ranking_frames.append(\n","        random_rankings\n","    )\n","\n","\n","    # LatestFail and QTF-Avg.\n","    (\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ) = create_history_baseline_rankings(\n","        noisy_training_history\n","    )\n","\n","    all_ranking_frames.extend([\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ])\n","\n","\n","    all_rankings = pd.concat(\n","        all_ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","    all_rankings.insert(\n","        0,\n","        \"Project\",\n","        PROJECT_NAME,\n","    )\n","\n","    all_rankings.insert(\n","        1,\n","        \"NoisePercent\",\n","        float(noise_percent),\n","    )\n","\n","    all_rankings.insert(\n","        2,\n","        \"RepetitionSeed\",\n","        int(repetition_seed),\n","    )\n","\n","\n","    build_metrics = (\n","        calculate_build_metrics(\n","            all_rankings,\n","            noise_percent,\n","            repetition_seed,\n","        )\n","    )\n","\n","    validate_condition_outputs(\n","        all_rankings,\n","        build_metrics,\n","    )\n","\n","\n","    project_run_metrics = (\n","        build_metrics\n","        .groupby(\n","            [\n","                \"Project\",\n","                \"NoisePercent\",\n","                \"RepetitionSeed\",\n","                \"Technique\",\n","            ],\n","            as_index=False,\n","        )\n","        .agg(\n","            MeanAPFD=(\n","                \"APFD\",\n","                \"mean\",\n","            ),\n","            MeanAPFDc=(\n","                \"APFDc\",\n","                \"mean\",\n","            ),\n","            SD_APFD=(\n","                \"APFD\",\n","                \"std\",\n","            ),\n","            SD_APFDc=(\n","                \"APFDc\",\n","                \"std\",\n","            ),\n","            EvaluatedBuilds=(\n","                \"Build\",\n","                \"nunique\",\n","            ),\n","            TotalRankedTests=(\n","                \"NumberOfTests\",\n","                \"sum\",\n","            ),\n","            TotalFailures=(\n","                \"NumberOfFailures\",\n","                \"sum\",\n","            ),\n","        )\n","    )\n","\n","\n","    evaluation_hash_after_condition = int(\n","        pd.util.hash_pandas_object(\n","            clean_evaluation_data[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    \"Verdict\",\n","                    \"Duration\",\n","                    *REC_FEATURE_COLUMNS,\n","                ]\n","            ],\n","            index=True,\n","        ).sum()\n","    )\n","\n","    if (\n","        evaluation_hash_before_condition\n","        != evaluation_hash_after_condition\n","    ):\n","        raise AssertionError(\n","            \"Clean evaluation data changed during \"\n","   