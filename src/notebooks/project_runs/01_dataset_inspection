"        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{SEED_TO_RUN:02d}\"\n","    )\n","\n","\n","def inspect_condition(\n","    noise_percent,\n","):\n","    condition_directory = (\n","        get_condition_directory(\n","            noise_percent\n","        )\n","    )\n","\n","    marker_path = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","    missing_files = [\n","        file_name\n","        for file_name in REQUIRED_FILES\n","        if not (\n","            condition_directory\n","            / file_name\n","        ).exists()\n","    ]\n","\n","    metadata = {}\n","    marker_readable = False\n","    marker_successful = False\n","\n","    if marker_path.exists():\n","\n","        try:\n","            with open(\n","                marker_path,\n","                \"r\",\n","                encoding=\"utf-8\",\n","            ) as marker_file:\n","\n","                metadata = json.load(\n","                    marker_file\n","                )\n","\n","            marker_readable = True\n","\n","            marker_successful = bool(\n","                metadata.get(\n","                    \"CompletedSuccessfully\",\n","                    False,\n","                )\n","            )\n","\n","        except Exception:\n","            marker_readable = False\n","            marker_successful = False\n","\n","\n","    complete = bool(\n","        marker_readable\n","        and marker_successful\n","        and len(missing_files) == 0\n","    )\n","\n","\n","    if complete:\n","        status = \"COMPLETE\"\n","\n","    elif marker_path.exists():\n","        status = \"BROKEN_SUCCESS_MARKER\"\n","\n","    elif condition_directory.exists():\n","        status = \"PARTIAL_NO_MARKER\"\n","\n","    else:\n","        status = \"NOT_STARTED\"\n","\n","\n","    return {\n","        \"NoisePercent\":\n","            int(noise_percent),\n","\n","        \"Status\":\n","            status,\n","\n","        \"Complete\":\n","            complete,\n","\n","        \"MarkerExists\":\n","            marker_path.exists(),\n","\n","        \"MissingFiles\":\n","            missing_files,\n","\n","        \"Metadata\":\n","            metadata,\n","\n","        \"Directory\":\n","            condition_directory,\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# 3. Show saved status before running\n","# ---------------------------------------------------------\n","\n","status_before_records = []\n","\n","for noise_percent in NOISE_LEVELS:\n","\n","    condition_state = (\n","        inspect_condition(\n","            noise_percent\n","        )\n","    )\n","\n","    status_before_records.append({\n","        \"NoisePercent\":\n","            noise_percent,\n","\n","        \"Status\":\n","            condition_state[\n","                \"Status\"\n","            ],\n","\n","        \"Complete\":\n","            condition_state[\n","                \"Complete\"\n","            ],\n","\n","        \"MissingFileCount\":\n","            len(\n","                condition_state[\n","                    \"MissingFiles\"\n","                ]\n","            ),\n","\n","        \"Directory\":\n","            str(\n","                condition_state[\n","                    \"Directory\"\n","                ]\n","            ),\n","    })\n","\n","\n","status_before = pd.DataFrame(\n","    status_before_records\n",")\n","\n","\n","display(\n","    status_before[\n","        [\n","            \"NoisePercent\",\n","            \"Status\",\n","            \"Complete\",\n","            \"MissingFileCount\",\n","        ]\n","    ]\n",")\n","\n","\n","broken_conditions = (\n","    status_before[\n","        status_before[\n","            \"Status\"\n","        ] == \"BROKEN_SUCCESS_MARKER\"\n","    ]\n",")\n","\n","\n","if len(\n","    broken_conditions\n",") \u003e 0:\n","\n","    raise RuntimeError(\n","        \"At least one condition has a success marker \"\n","        \"but is missing required output files. Do not \"\n","        \"rerun or delete it until inspected.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Run only missing conditions\n","# ---------------------------------------------------------\n","\n","missing_noise_levels = (\n","    status_before.loc[\n","        ~status_before[\n","            \"Complete\"\n","        ],\n","        \"NoisePercent\",\n","    ]\n","    .astype(int)\n","    .tolist()\n",")\n","\n","\n","print(\n","    \"\\nAlready complete:\",\n","    int(\n","        status_before[\n","            \"Complete\"\n","        ].sum()\n","    ),\n","    \"/ 9\",\n",")\n","\n","print(\n","    \"Noise levels to run:\",\n","    missing_noise_levels,\n",")\n","\n","\n","execution_start = time.time()\n","\n","\n","for position, noise_percent in enumerate(\n","    missing_noise_levels,\n","    start=1,\n","):\n","\n","    condition_start = time.time()\n","\n","    print(\n","        f\"[{position}/{len(missing_noise_levels)}] \"\n","        f\"Running noise {noise_percent:\u003e2}%...\",\n","        end=\" \",\n","        flush=True,\n","    )\n","\n","\n","    try:\n","\n","        # Suppress the large tables and repeated print output\n","        # generated inside run_unified_condition.\n","        with capture_output(\n","            stdout=True,\n","            stderr=True,\n","            display=True,\n","        ):\n","\n","            condition_result = (\n","                run_unified_condition(\n","                    noise_percent=(\n","                        int(\n","                            noise_percent\n","                        )\n","                    ),\n","\n","                    repetition_seed=(\n","                        SEED_TO_RUN\n","                    ),\n","\n","                    save_rankings=True,\n","                    overwrite=False,\n","                )\n","            )\n","\n","\n","        del condition_result\n","        gc.collect()\n","\n","\n","        completed_state = (\n","            inspect_condition(\n","                noise_percent\n","            )\n","        )\n","\n","\n","        if not completed_state[\n","            \"Complete\"\n","        ]:\n","\n","            raise RuntimeError(\n","                \"The condition finished but did not \"\n","                \"produce all required saved files.\"\n","            )\n","\n","\n","        print(\n","            \"COMPLETE \"\n","            f\"({time.time() - condition_start:.2f}s)\"\n","        )\n","\n","\n","    except Exception as error:\n","\n","        print(\"FAILED\")\n","\n","        print(\n","            \"Noise level:\",\n","            noise_percent,\n","        )\n","\n","        print(\n","            \"Error type:\",\n","            type(error).__name__,\n","        )\n","\n","        print(\n","            \"Error:\",\n","            str(error),\n","        )\n","\n","        raise\n","\n","\n","print(\n","    \"\\nCondition execution elapsed minutes:\",\n","    round(\n","        (\n","            time.time()\n","            - execution_start\n","        ) / 60.0,\n","        3,\n","    ),\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Confirm all nine conditions are complete\n","# ---------------------------------------------------------\n","\n","status_after_records = []\n","\n","for noise_percent in NOISE_LEVELS:\n","\n","    state = inspect_condition(\n","        noise_percent\n","    )\n","\n","    status_after_records.append({\n","        \"NoisePercent\":\n","            noise_percent,\n","\n","        \"Status\":\n","            state[\n","                \"Status\"\n","            ],\n","\n","        \"Complete\":\n","            state[\n","                \"Complete\"\n","            ],\n","    })\n","\n","\n","status_after = pd.DataFrame(\n","    status_after_records\n",")\n","\n","\n","print(\n","    \"\\n=== SAVED CONDITION STATUS ===\"\n",")\n","\n","display(\n","    status_after\n",")\n","\n","\n","if not status_after[\n","    \"Complete\"\n","].all():\n","\n","    raise AssertionError(\n","        \"Not all nine seed-1 conditions are complete.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Stable ranking signature\n","# ---------------------------------------------------------\n","\n","def ranking_signature(\n","    rankings,\n","    technique,\n","):\n","    technique_rows = (\n","        rankings[\n","            rankings[\n","                \"Technique\"\n","            ] == technique\n","        ][\n","            [\n","                \"Build\",\n","                \"Test\",\n","                \"Rank\",\n","                \"Score\",\n","            ]\n","        ]\n","        .sort_values(\n","            [\n","                \"Build\",\n","                \"Rank\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    hash_values = (\n","        pd.util.hash_pandas_object(\n","            technique_rows,\n","            index=False,\n","        )\n","        .to_numpy()\n","    )\n","\n","\n","    return hashlib.sha256(\n","        hash_values.tobytes()\n","    ).hexdigest()\n","\n","\n","# ---------------------------------------------------------\n","# 7. Audit all nine saved conditions\n","# ---------------------------------------------------------\n","\n","condition_records = []\n","nested_mask_records = []\n","baseline_records = []\n","\n","project_run_frames = []\n","build_metric_frames = []\n","ranking_frames = []\n","noise_summary_frames = []\n","fit_time_frames = []\n","\n","\n","reference_identity = None\n","reference_uniforms = None\n","\n","previous_mask = None\n","previous_noise = None\n","\n","random_reference_signature = None\n","qtf_reference_signature = None\n","\n","\n","expected_techniques = set(\n","    ML_TECHNIQUES\n","    + BASELINE_TECHNIQUES\n",")\n","\n","\n","for noise_percent in NOISE_LEVELS:\n","\n","    condition_directory = (\n","        get_condition_directory(\n","            noise_percent\n","        )\n","    )\n","\n","\n","    with open(\n","        condition_directory\n","        / \"_SUCCESS.json\",\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","\n","        metadata = json.load(\n","            marker_file\n","        )\n","\n","\n","    manifest = pd.read_parquet(\n","        condition_directory\n","        / \"noise_manifest.parquet\"\n","    )\n","\n","    noise_summary = pd.read_csv(\n","        condition_directory\n","        / \"noise_summary.csv\"\n","    )\n","\n","    rankings = pd.read_parquet(\n","        condition_directory\n","        / \"rankings.parquet\"\n","    )\n","\n","    build_metrics = pd.read_parquet(\n","        condition_directory\n","        / \"build_metrics.parquet\"\n","    )\n","\n","    project_run_metrics = pd.read_csv(\n","        condition_directory\n","        / \"project_run_metrics.csv\"\n","    )\n","\n","    fit_times = pd.read_csv(\n","        condition_directory\n","        / \"fit_times.csv\"\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # 7A. Completion metadata\n","    # -----------------------------------------------------\n","\n","    expected_metadata = {\n","        \"CompletedSuccessfully\":\n","            True,\n","\n","        \"TrainingExecutionRows\":\n","            EXPECTED_MANIFEST_ROWS,\n","\n","        \"TrainingModelRows\":\n","            2320,\n","\n","        \"EvaluationModelRows\":\n","            EXPECTED_EVALUATION_ROWS,\n","\n","        \"EvaluatedBuilds\":\n","            EXPECTED_EVALUATION_BUILDS,\n","\n","        \"TechniqueCount\":\n","            7,\n","\n","        \"RankingRows\":\n","            EXPECTED_RANKING_ROWS_PER_CONDITION,\n","\n","        \"BuildMetricRows\":\n","            EXPECTED_BUILD_METRICS_PER_CONDITION,\n","\n","        \"EvaluationHashUnchanged\":\n","            True,\n","    }\n","\n","\n","    for metadata_key, expected_value in (\n","        expected_metadata.items()\n","    ):\n","\n","        actual_value = metadata.get(\n","            metadata_key\n","        )\n","\n","        if actual_value != expected_value:\n","\n","            raise AssertionError(\n","                \"Completion metadata mismatch.\\n\"\n","                f\"Noise: {noise_percent}%\\n\"\n","                f\"Field: {metadata_key}\\n\"\n","                f\"Expected: {expected_value}\\n\"\n","                f\"Observed: {actual_value}\"\n","            )\n","\n","\n","    # -----------------------------------------------------\n","    # 7B. Table sizes\n","    # -----------------------------------------------------\n","\n","    if len(manifest) != EXPECTED_MANIFEST_ROWS:\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% has an invalid \"\n","            \"manifest row count.\"\n","        )\n","\n","    if len(noise_summary) != 1:\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% has an invalid \"\n","            \"noise-summary row count.\"\n","        )\n","\n","    if len(rankings) != (\n","        EXPECTED_RANKING_ROWS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% has an invalid \"\n","            \"ranking row count.\"\n","        )\n","\n","    if len(build_metrics) != (\n","        EXPECTED_BUILD_METRICS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% has an invalid \"\n","            \"build-metric row count.\"\n","        )\n","\n","    if len(project_run_metrics) != (\n","        EXPECTED_PROJECT_RUN_ROWS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% has an invalid \"\n","            \"project-run row count.\"\n","        )\n","\n","    if len(fit_times) != (\n","        EXPECTED_FIT_ROWS_PER_CONDITION\n","    ):\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% has an invalid \"\n","            \"fit-time row count.\"\n","        )\n","\n","\n","    # Reuse the runner's structural and tie-order audit.\n","    validate_condition_outputs(\n","        rankings=rankings,\n","        build_metrics=build_metrics,\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # 7C. Technique coverage\n","    # -----------------------------------------------------\n","\n","    if set(\n","        rankings[\n","            \"Technique\"\n","        ].unique()\n","    ) != expected_techniques:\n","\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% has an invalid \"\n","            \"technique set.\"\n","        )\n","\n","\n","    rows_per_technique = (\n","        rankings\n","        .groupby(\n","            \"Technique\"\n","        )\n","        .size()\n","    )\n","\n","\n","    if not (\n","        rows_per_technique\n","        == EXPECTED_EVALUATION_ROWS\n","    ).all():\n","\n","        raise AssertionError(\n","            \"At least one technique did not rank \"\n","            \"all evaluation rows.\"\n","        )\n","\n","\n","    builds_per_technique = (\n","        build_metrics\n","        .groupby(\n","            \"Technique\"\n","        )[\n","            \"Build\"\n","        ]\n","        .nunique()\n","    )\n","\n","\n","    if not (\n","        builds_per_technique\n","        == EXPECTED_EVALUATION_BUILDS\n","    ).all():\n","\n","        raise AssertionError(\n","            \"At least one technique did not evaluate \"\n","            \"all 20 builds.\"\n","        )\n","\n","\n","    if not (\n","        project_run_metrics[\n","            \"TotalRankedTests\"\n","        ] == EXPECTED_EVALUATION_ROWS\n","    ).all():\n","\n","        raise AssertionError(\n","            \"Project-run ranked-test count mismatch.\"\n","        )\n","\n","\n","    if not (\n","        project_run_metrics[\n","            \"TotalFailures\"\n","        ] == EXPECTED_EVALUATION_FAILURES\n","    ).all():\n","\n","        raise AssertionError(\n","            \"Project-run failure count mismatch.\"\n","        )\n","\n","\n","    # -----------------------------------------------------\n","    # 7D. Noise manifest and nested masks\n","    # -----------------------------------------------------\n","\n","    manifest = (\n","        manifest\n","        .sort_values(\n","            \"NoiseRowID\"\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    expected_noise_row_ids = np.arange(\n","        EXPECTED_MANIFEST_ROWS\n","    )\n","\n","\n","    if not np.array_equal(\n","        manifest[\n","            \"NoiseRowID\"\n","        ].to_numpy(),\n","        expected_noise_row_ids,\n","    ):\n","\n","        raise AssertionError(\n","            \"NoiseRowID sequence is invalid.\"\n","        )\n","\n","\n","    identity_columns = [\n","        \"NoiseRowID\",\n","        \"Build\",\n","        \"Test\",\n","        \"OriginalVerdict\",\n","    ]\n","\n","\n","    if \"Job\" in manifest.columns:\n","        identity_columns.append(\n","            \"Job\"\n","        )\n","\n","\n","    current_identity = (\n","        manifest[\n","            identity_columns\n","        ]\n","        .copy()\n","    )\n","\n","\n","    current_uniforms = (\n","        manifest[\n","            \"FlipUniform\"\n","        ]\n","        .to_numpy(\n","            dtype=float\n","        )\n","    )\n","\n","\n","    current_mask = (\n","        manifest[\n","            \"Flipped\"\n","        ]\n","        .to_numpy(\n","            dtype=bool\n","        )\n","    )\n","\n","\n","    expected_mask = (\n","        current_uniforms\n","        \u003c float(\n","            noise_percent\n","        ) / 100.0\n","    )\n","\n","\n","    if not np.array_equal(\n","        current_mask,\n","        expected_mask,\n","    ):\n","\n","        raise AssertionError(\n","            f\"Noise {noise_percent}% mask does not \"\n","            \"match the uniform threshold.\"\n","        )\n","\n","\n","    if reference_identity is None:\n","\n","        reference_identity = (\n","            current_identity.copy()\n","        )\n","\n","        reference_uniforms = (\n","            current_uniforms.copy()\n","        )\n","\n","        same_identity = True\n","        same_uniforms = True\n","\n","    else:\n","\n","        same_identity = bool(\n","            reference_identity.equals(\n","                current_identity\n","            )\n","        )\n","\n","        same_uniforms = bool(\n","            np.array_equal(\n","                reference_uniforms,\n","                current_uniforms,\n","            )\n","        )\n","\n","\n","        if not same_identity:\n","            raise AssertionError(\n","                \"Training row identity changed across \"\n","                \"noise levels.\"\n","            )\n","\n","        if not same_uniforms:\n","            raise AssertionError(\n","                \"Uniform stream changed across \"\n","                \"noise levels.\"\n","            )\n","\n","\n","    if previous_mask is not None:\n","\n","        lower_subset_of_upper = bool(\n","            np.all(\n","                ~previous_mask\n","                | current_mask\n","            )\n","        )\n","\n","\n","        nested_mask_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"RepetitionSeed\":\n","                SEED_TO_RUN,\n","\n","            \"LowerNoisePercent\":\n","                int(\n","                    previous_noise\n","                ),\n","\n","            \"UpperNoisePercent\":\n","                int(\n","                    noise_percent\n","                ),\n","\n","            \"LowerFlippedRows\":\n","                int(\n","                    previous_mask.sum()\n","                ),\n","\n","            \"UpperFlippedRows\":\n","                int(\n","                    current_mask.sum()\n","                ),\n","\n","            \"LowerMaskSubsetOfUpper\":\n","                lower_subset_of_upper,\n","        })\n","\n","\n","        if not lower_subset_of_upper:\n","\n","            raise AssertionError(\n","                \"Nested-mask violation between \"\n","                f\"{previous_noise}% and \"\n","                f\"{noise_percent}%.\"\n","            )\n","\n","\n","    previous_mask = (\n","        current_mask.copy()\n","    )\n","\n","    previous_noise = int(\n","        noise_percent\n","    )\n","\n","\n","    # -----------------------------------------------------\n","    # 7E. Random and QTF-Avg invariance\n","    # -----------------------------------------------------\n","\n","    random_signature = (\n","        ranking_signature(\n","            rankings,\n","            \"Random\",\n","        )\n","    )\n","\n","    qtf_signature = (\n","        ranking_signature(\n","            rankings,\n","            \"QTF-Avg\",\n","        )\n","    )\n","\n","\n","    if random_reference_signature is None:\n","        random_reference_signature = (\n","            random_signature\n","        )\n","\n","    if qtf_reference_signature is None:\n","        qtf_reference_signature = (\n","            qtf_signature\n","        )\n","\n","\n","    random_invariant = bool(\n","        random_signature\n","        == random_reference_signature\n","    )\n","\n","    qtf_invariant = bool(\n","        qtf_signature\n","        == qtf_reference_signature\n","    )\n","\n","\n","    if not random_invariant:\n","        raise AssertionError(\n","            \"Random changed across noise levels \"\n","            \"within seed 1.\"\n","        )\n","\n","    if not qtf_invariant:\n","        raise AssertionError(\n","            \"QTF-Avg changed across noise levels.\"\n