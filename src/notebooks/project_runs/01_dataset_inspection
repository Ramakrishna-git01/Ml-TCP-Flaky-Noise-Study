ed(required_build_columns)}\"\n","    )\n","\n","if not required_entity_columns.issubset(\n","    entity_change_history.columns\n","):\n","    raise RuntimeError(\n","        \"entity_change_history is missing required columns: \"\n","        f\"{sorted(required_entity_columns)}\"\n","    )\n","\n","if not required_id_map_columns.issubset(\n","    id_map.columns\n","):\n","    raise RuntimeError(\n","        \"id_map is missing required columns: \"\n","        f\"{sorted(required_id_map_columns)}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Normalise commit hashes in entity history\n","# ---------------------------------------------------------\n","\n","entity_commit_pairs = (\n","    entity_change_history[\n","        [\n","            \"Commit\",\n","            \"EntityId\",\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","entity_commit_pairs[\"Commit\"] = (\n","    entity_commit_pairs[\"Commit\"]\n","    .astype(str)\n","    .str.strip()\n","    .str.lower()\n",")\n","\n","\n","entity_commit_pairs[\"EntityId\"] = pd.to_numeric(\n","    entity_commit_pairs[\"EntityId\"],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","# Remove invalid textual values and duplicate commit/entity\n","# combinations.\n","entity_commit_pairs = (\n","    entity_commit_pairs[\n","        ~entity_commit_pairs[\"Commit\"].isin(\n","            [\n","                \"\",\n","                \"nan\",\n","                \"none\",\n","                \"null\",\n","            ]\n","        )\n","    ]\n","    .drop_duplicates(\n","        [\n","            \"Commit\",\n","            \"EntityId\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Expand each build's # separated commit list\n","# ---------------------------------------------------------\n","\n","build_commit_map = (\n","    builds_checked[\n","        [\n","            \"id\",\n","            \"commits\",\n","            \"started_at\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","build_commit_map[\"Commit\"] = (\n","    build_commit_map[\"commits\"]\n","    .fillna(\"\")\n","    .astype(str)\n","    .str.split(\"#\")\n",")\n","\n","\n","build_commit_map = (\n","    build_commit_map\n","    .explode(\n","        \"Commit\",\n","        ignore_index=True,\n","    )\n",")\n","\n","\n","build_commit_map[\"Commit\"] = (\n","    build_commit_map[\"Commit\"]\n","    .astype(str)\n","    .str.strip()\n","    .str.lower()\n",")\n","\n","\n","build_commit_map = (\n","    build_commit_map[\n","        ~build_commit_map[\"Commit\"].isin(\n","            [\n","                \"\",\n","                \"nan\",\n","                \"none\",\n","                \"null\",\n","            ]\n","        )\n","    ]\n","    .drop_duplicates(\n","        [\n","            \"id\",\n","            \"Commit\",\n","        ]\n","    )\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"Commit\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# A build should not contain the same commit more than once.\n","duplicate_build_commit_pairs = int(\n","    build_commit_map[\n","        [\n","            \"id\",\n","            \"Commit\",\n","        ]\n","    ].duplicated().sum()\n",")\n","\n","if duplicate_build_commit_pairs != 0:\n","    raise AssertionError(\n","        \"Duplicate build/commit pairs remain.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Mark whether each build commit exists in the\n","#    entity-change history\n","# ---------------------------------------------------------\n","\n","known_entity_commits = set(\n","    entity_commit_pairs[\"Commit\"]\n",")\n","\n","\n","build_commit_map[\"CommitMatched\"] = (\n","    build_commit_map[\"Commit\"]\n","    .isin(known_entity_commits)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Join builds to changed entities\n","# ---------------------------------------------------------\n","\n","build_entity_map = (\n","    build_commit_map\n","    .merge(\n","        entity_commit_pairs,\n","        on=\"Commit\",\n","        how=\"left\",\n","        validate=\"many_to_many\",\n","    )\n",")\n","\n","\n","build_entity_map[\"EntityMatched\"] = (\n","    build_entity_map[\"EntityId\"]\n","    .notna()\n",")\n","\n","\n","build_entity_map = (\n","    build_entity_map\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"Commit\",\n","            \"EntityId\",\n","        ],\n","        na_position=\"last\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Validate mapped entity IDs against id_map.csv\n","# ---------------------------------------------------------\n","\n","known_entity_ids = set(\n","    pd.to_numeric(\n","        id_map[\"value\"],\n","        errors=\"raise\",\n","    ).astype(int)\n",")\n","\n","\n","mapped_entity_ids = set(\n","    build_entity_map.loc[\n","        build_entity_map[\n","            \"EntityId\"\n","        ].notna(),\n","        \"EntityId\",\n","    ].astype(int)\n",")\n","\n","\n","unknown_mapped_entity_ids = (\n","    mapped_entity_ids\n","    - known_entity_ids\n",")\n","\n","\n","if unknown_mapped_entity_ids:\n","    raise AssertionError(\n","        \"Some mapped EntityId values are absent from \"\n","        f\"id_map.csv: {len(unknown_mapped_entity_ids)}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Create changed-entity sets for every build\n","# ---------------------------------------------------------\n","\n","changed_entities_by_build = {\n","    int(build_id): set()\n","    for build_id in builds_checked[\"id\"]\n","}\n","\n","\n","mapped_rows = (\n","    build_entity_map[\n","        build_entity_map[\n","            \"EntityId\"\n","        ].notna()\n","    ][\n","        [\n","            \"id\",\n","            \"EntityId\",\n","        ]\n","    ]\n","    .drop_duplicates()\n",")\n","\n","\n","for build_id, group in mapped_rows.groupby(\n","    \"id\",\n","    sort=False,\n","):\n","\n","    changed_entities_by_build[\n","        int(build_id)\n","    ] = set(\n","        group[\"EntityId\"]\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","\n","if len(changed_entities_by_build) != len(\n","    builds_checked\n","):\n","    raise AssertionError(\n","        \"changed_entities_by_build does not contain \"\n","        \"every project build.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Produce one summary row per build\n","# ---------------------------------------------------------\n","\n","commit_counts = (\n","    build_commit_map\n","    .groupby(\"id\")\n","    .agg(\n","        BuildCommitCount=(\n","            \"Commit\",\n","            \"nunique\",\n","        ),\n","        MatchedCommitCount=(\n","            \"CommitMatched\",\n","            \"sum\",\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","\n","entity_counts = (\n","    mapped_rows\n","    .groupby(\"id\")\n","    .agg(\n","        ChangedEntityCount=(\n","            \"EntityId\",\n","            \"nunique\",\n","        )\n","    )\n","    .reset_index()\n",")\n","\n","\n","build_mapping_summary = (\n","    builds_checked[\n","        [\n","            \"id\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .merge(\n","        commit_counts,\n","        on=\"id\",\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","    .merge(\n","        entity_counts,\n","        on=\"id\",\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n","    .sort_values(\"build_order\")\n","    .reset_index(drop=True)\n",")\n","\n","\n","for count_column in [\n","    \"BuildCommitCount\",\n","    \"MatchedCommitCount\",\n","    \"ChangedEntityCount\",\n","]:\n","\n","    build_mapping_summary[\n","        count_column\n","    ] = (\n","        build_mapping_summary[\n","            count_column\n","        ]\n","        .fillna(0)\n","        .astype(int)\n","    )\n","\n","\n","build_mapping_summary[\n","    \"HasMatchedCommit\"\n","] = (\n","    build_mapping_summary[\n","        \"MatchedCommitCount\"\n","    ] \u003e 0\n",")\n","\n","\n","build_mapping_summary[\n","    \"HasChangedEntity\"\n","] = (\n","    build_mapping_summary[\n","        \"ChangedEntityCount\"\n","    ] \u003e 0\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 9. Final integrity checks\n","# ---------------------------------------------------------\n","\n","if len(build_mapping_summary) != len(\n","    builds_checked\n","):\n","    raise AssertionError(\n","        \"Expected exactly one mapping-summary row \"\n","        \"per build.\"\n","    )\n","\n","\n","if set(\n","    changed_entities_by_build\n",") != set(\n","    builds_checked[\"id\"].astype(int)\n","):\n","    raise AssertionError(\n","        \"Build IDs in changed_entities_by_build do not \"\n","        \"match builds.csv.\"\n","    )\n","\n","\n","builds_without_commit_rows = int(\n","    (\n","        build_mapping_summary[\n","            \"BuildCommitCount\"\n","        ] == 0\n","    ).sum()\n",")\n","\n","\n","builds_without_matched_commits = int(\n","    ~build_mapping_summary[\n","        \"HasMatchedCommit\"\n","    ]\n",").sum()\n","\n","\n","builds_without_changed_entities = int(\n","    ~build_mapping_summary[\n","        \"HasChangedEntity\"\n","    ]\n",").sum()\n","\n","\n","# ---------------------------------------------------------\n","# 10. Output\n","# ---------------------------------------------------------\n","\n","print(\"\\nMapping shapes:\")\n","\n","print(\n","    \"build_commit_map:\",\n","    build_commit_map.shape,\n",")\n","\n","print(\n","    \"build_entity_map:\",\n","    build_entity_map.shape,\n",")\n","\n","print(\n","    \"build_mapping_summary:\",\n","    build_mapping_summary.shape,\n",")\n","\n","print(\n","    \"changed_entities_by_build:\",\n","    len(changed_entities_by_build),\n",")\n","\n","\n","print(\"\\nCommit mapping:\")\n","\n","print(\n","    \"Unique build/commit pairs:\",\n","    len(build_commit_map),\n",")\n","\n","print(\n","    \"Unique commits in builds:\",\n","    build_commit_map[\n","        \"Commit\"\n","    ].nunique(),\n",")\n","\n","print(\n","    \"Matched build/commit pairs:\",\n","    int(\n","        build_commit_map[\n","            \"CommitMatched\"\n","        ].sum()\n","    ),\n",")\n","\n","print(\n","    \"Unmatched build/commit pairs:\",\n","    int(\n","        (\n","            ~build_commit_map[\n","                \"CommitMatched\"\n","            ]\n","        ).sum()\n","    ),\n",")\n","\n","\n","print(\"\\nEntity mapping:\")\n","\n","print(\n","    \"Unique mapped entities:\",\n","    len(mapped_entity_ids),\n",")\n","\n","print(\n","    \"Mapped build/entity pairs:\",\n","    len(mapped_rows),\n",")\n","\n","print(\n","    \"Unknown mapped entity IDs:\",\n","    len(unknown_mapped_entity_ids),\n",")\n","\n","\n","print(\"\\nBuild coverage:\")\n","\n","print(\n","    \"Builds with no parsed commits:\",\n","    builds_without_commit_rows,\n",")\n","\n","print(\n","    \"Builds with no matched commits:\",\n","    builds_without_matched_commits,\n",")\n","\n","print(\n","    \"Builds with no changed entities:\",\n","    builds_without_changed_entities,\n",")\n","\n","\n","print(\"\\nFirst ten mapping-summary rows:\")\n","\n","display(\n","    build_mapping_summary.head(10)\n",")\n","\n","\n","print(\n","    \"\\nSUCCESS: Snow Owl build–commit–entity \"\n","    \"mapping is ready.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost: