"\n","with open(\n","    clean_directory / \"_SUCCESS.json\",\n","    \"r\",\n","    encoding=\"utf-8\",\n",") as file:\n","    clean_success = json.load(file)\n","\n","with open(\n","    five_directory / \"_SUCCESS.json\",\n","    \"r\",\n","    encoding=\"utf-8\",\n",") as file:\n","    five_success = json.load(file)\n","\n","\n","assert clean_success[\"CompletedSuccessfully\"] is True\n","assert five_success[\"CompletedSuccessfully\"] is True\n","\n","assert clean_success[\"EvaluationHashUnchanged\"] is True\n","assert five_success[\"EvaluationHashUnchanged\"] is True\n","\n","\n","# ---------------------------------------------------------\n","# READ NOISE OUTPUTS\n","# ---------------------------------------------------------\n","\n","clean_summary = pd.read_csv(\n","    clean_directory / \"noise_summary.csv\"\n",")\n","\n","five_summary = pd.read_csv(\n","    five_directory / \"noise_summary.csv\"\n",")\n","\n","clean_manifest = (\n","    pd.read_parquet(\n","        clean_directory\n","        / \"noise_manifest.parquet\"\n","    )\n","    .sort_values(\"NoiseRowID\")\n","    .reset_index(drop=True)\n",")\n","\n","five_manifest = (\n","    pd.read_parquet(\n","        five_directory\n","        / \"noise_manifest.parquet\"\n","    )\n","    .sort_values(\"NoiseRowID\")\n","    .reset_index(drop=True)\n",")\n","\n","\n","assert len(clean_manifest) == 8265\n","assert len(five_manifest) == 8265\n","\n","assert int(\n","    clean_summary[\"NumberFlipped\"].iloc[0]\n",") == 0\n","\n","assert int(\n","    five_summary[\"NumberFlipped\"].iloc[0]\n",") == 405\n","\n","\n","# ---------------------------------------------------------\n","# VERIFY IDENTICAL UNDERLYING ROWS AND RANDOM STREAM\n","# ---------------------------------------------------------\n","\n","assert np.array_equal(\n","    clean_manifest[\"NoiseRowID\"].to_numpy(),\n","    five_manifest[\"NoiseRowID\"].to_numpy(),\n",")\n","\n","assert np.array_equal(\n","    clean_manifest[\"Build\"].to_numpy(),\n","    five_manifest[\"Build\"].to_numpy(),\n",")\n","\n","assert np.array_equal(\n","    clean_manifest[\"Test\"].to_numpy(),\n","    five_manifest[\"Test\"].to_numpy(),\n",")\n","\n","assert np.array_equal(\n","    clean_manifest[\"OriginalVerdict\"].to_numpy(),\n","    five_manifest[\"OriginalVerdict\"].to_numpy(),\n",")\n","\n","same_uniform_stream = np.array_equal(\n","    clean_manifest[\"FlipUniform\"].to_numpy(),\n","    five_manifest[\"FlipUniform\"].to_numpy(),\n",")\n","\n","assert same_uniform_stream\n","\n","\n","# ---------------------------------------------------------\n","# VERIFY FLIP MANIFEST\n","# ---------------------------------------------------------\n","\n","clean_actual_changes = (\n","    clean_manifest[\"OriginalVerdict\"]\n","    != clean_manifest[\"NoisyVerdict\"]\n",")\n","\n","five_actual_changes = (\n","    five_manifest[\"OriginalVerdict\"]\n","    != five_manifest[\"NoisyVerdict\"]\n",")\n","\n","assert np.array_equal(\n","    clean_actual_changes.to_numpy(),\n","    clean_manifest[\"Flipped\"].to_numpy(),\n",")\n","\n","assert np.array_equal(\n","    five_actual_changes.to_numpy(),\n","    five_manifest[\"Flipped\"].to_numpy(),\n",")\n","\n","clean_flips = int(\n","    clean_manifest[\"Flipped\"].sum()\n",")\n","\n","five_flips = int(\n","    five_manifest[\"Flipped\"].sum()\n",")\n","\n","pass_to_failure = int(\n","    five_manifest[\"PassToFailure\"].sum()\n",")\n","\n","failure_to_pass = int(\n","    five_manifest[\"FailureToPass\"].sum()\n",")\n","\n","assert clean_flips == 0\n","assert five_flips == 405\n","assert pass_to_failure == 356\n","assert failure_to_pass == 49\n","\n","assert (\n","    pass_to_failure\n","    + failure_to_pass\n",") == five_flips\n","\n","\n","# ---------------------------------------------------------\n","# VERIFY RESULT STRUCTURE\n","# ---------------------------------------------------------\n","\n","expected_techniques = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","}\n","\n","five_project_results = pd.read_csv(\n","    five_directory\n","    / \"project_run_metrics.csv\"\n",")\n","\n","five_fit_times = pd.read_csv(\n","    five_directory\n","    / \"fit_times.csv\"\n",")\n","\n","ranking_rows = int(\n","    pq.ParquetFile(\n","        five_directory\n","        / \"rankings.parquet\"\n","    ).metadata.num_rows\n",")\n","\n","build_metric_rows = int(\n","    pq.ParquetFile(\n","        five_directory\n","        / \"build_metrics.parquet\"\n","    ).metadata.num_rows\n",")\n","\n","\n","assert ranking_rows == 1743\n","assert build_metric_rows == 35\n","assert len(five_project_results) == 7\n","assert len(five_fit_times) == 4\n","\n","assert set(\n","    five_project_results[\"Technique\"]\n",") == expected_techniques\n","\n","assert (\n","    five_project_results[\"EvaluatedBuilds\"]\n","    == 5\n",").all()\n","\n","\n","# ---------------------------------------------------------\n","# FINAL OUTPUT\n","# ---------------------------------------------------------\n","\n","print(\"=== AIRAVATA 5% PILOT AUDIT ===\")\n","\n","print(\n","    \"Completed successfully:\",\n","    five_success[\"CompletedSuccessfully\"],\n",")\n","\n","print(\n","    \"Evaluation unchanged:\",\n","    five_success[\"EvaluationHashUnchanged\"],\n",")\n","\n","print(\n","    \"Training execution rows:\",\n","    len(five_manifest),\n",")\n","\n","print(\n","    \"Requested noise:\",\n","    five_summary[\n","        \"NoisePercentRequested\"\n","    ].iloc[0],\n","    \"%\",\n",")\n","\n","print(\n","    \"Realised noise:\",\n","    round(\n","        float(\n","            five_summary[\n","                \"RealisedNoisePercent\"\n","            ].iloc[0]\n","        ),\n","        6,\n","    ),\n","    \"%\",\n",")\n","\n","print(\n","    \"Flipped verdicts:\",\n","    five_flips,\n",")\n","\n","print(\n","    \"Pass to failure:\",\n","    pass_to_failure,\n",")\n","\n","print(\n","    \"Failure to pass:\",\n","    failure_to_pass,\n",")\n","\n","print(\n","    \"Same uniform stream as 0%:\",\n","    same_uniform_stream,\n",")\n","\n","print(\n","    \"Ranking rows:\",\n","    ranking_rows,\n","    \"/ 1743\",\n",")\n","\n","print(\n","    \"Build-metric rows:\",\n","    build_metric_rows,\n","    \"/ 35\",\n",")\n","\n","print(\n","    \"Project-run technique rows:\",\n","    len(five_project_results),\n","    \"/ 7\",\n",")\n","\n","print(\n","    \"ML fit rows:\",\n","    len(five_fit_times),\n","    \"/ 4\",\n",")\n","\n","\n","print(\"\\n5% project-run results:\")\n","\n","display(\n","    five_project_results[\n","        [\n","            \"Technique\",\n","            \"MeanAPFD\",\n","            \"MeanAPFDc\",\n","            \"SD_APFD\",\n","            \"SD_APFDc\",\n","            \"EvaluatedBuilds\",\n","        ]\n","    ]\n","    .sort_values(\n","        \"MeanAPFDc\",\n","        ascending=False,\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","print(\n","    \"\\nSUCCESS: Airavata 5% pilot \"\n","    \"passed all checks.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":96202,"status":"ok","timestamp":1784852295033,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"aK7qNNfjex1y","outputId":"52e1ea89-9c8a-4213-dbac-8fa1f7aba58d"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== AIRAVATA SEED 1 — REMAINING CONDITIONS ===\n","Noise levels: [10, 15, 20, 25, 30, 40, 50]\n","[1/7] Noise 10% — SUCCESS — 20.66 seconds\n","[2/7] Noise 15% — SUCCESS — 13.57 seconds\n","[3/7] Noise 20% — SUCCESS — 11.55 seconds\n","[4/7] Noise 25% — SUCCESS — 11.93 seconds\n","[5/7] Noise 30% — SUCCESS — 12.26 seconds\n","[6/7] Noise 40% — SUCCESS — 12.47 seconds\n","[7/7] Noise 50% — SUCCESS — 13.63 seconds\n","\n","=== SEED 1 SUMMARY ===\n","Completed or previously completed: 7 / 7\n","\n","SUCCESS: Airavata seed 1 is complete across all nine noise levels.\n"]}],"source":["# =========================================================\n","# AIRAVATA — COMPLETE SEED 1 REMAINING NOISE LEVELS\n","# =========================================================\n","\n","from contextlib import redirect_stdout, redirect_stderr\n","from io import StringIO\n","import json\n","import time\n","\n","\n","REMAINING_NOISE_LEVELS = [\n","    10, 15, 20, 25, 30, 40, 50\n","]\n","\n","EXPECTED_CONDITION_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","    \"rankings.parquet\",\n","]\n","\n","\n","print(\"=== AIRAVATA SEED 1 — REMAINING CONDITIONS ===\")\n","print(\n","    \"Noise levels:\",\n","    REMAINING_NOISE_LEVELS,\n",")\n","\n","\n","completed_count = 0\n","\n","\n","for position, noise_percent in enumerate(\n","    REMAINING_NOISE_LEVELS,\n","    start=1,\n","):\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{noise_percent:03d}\"\n","        / \"seed_01\"\n","    )\n","\n","    success_marker = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","    missing_files = [\n","        file_name\n","        for file_name in EXPECTED_CONDITION_FILES\n","        if not (\n","            condition_directory / file_name\n","        ).exists()\n","    ]\n","\n","\n","    # Skip a condition only when its marker and every\n","    # expected output file are already present.\n","    if success_marker.exists():\n","\n","        if missing_files:\n","            raise RuntimeError(\n","                f\"Noise {noise_percent}% has a success \"\n","                f\"marker but is missing files:\\n\"\n","                + \"\\n\".join(missing_files)\n","            )\n","\n","        with open(\n","            success_marker,\n","