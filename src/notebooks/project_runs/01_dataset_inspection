 pd\n","\n","\n","# ---------------------------------------------------------\n","# 1. Permanent paths\n","# ---------------------------------------------------------\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","REGISTRY_PATH = (\n","    NOTES_DRIVE\n","    / \"completed_project_registry.csv\"\n",")\n","\n","PAHO_FINAL_DIRECTORY = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n","    / \"eclipse__paho.mqtt.java\"\n","    / \"paho_30_seed_final\"\n",")\n","\n","PAHO_FINAL_REPORT_PATH = (\n","    PAHO_FINAL_DIRECTORY\n","    / \"paho_final_audit_report.json\"\n",")\n","\n","PAHO_PROJECT_SUMMARY_PATH = (\n","    PAHO_FINAL_DIRECTORY\n","    / \"project_noise_technique_summary.csv\"\n",")\n","\n","PAHO_PROJECT_RUN_PATH = (\n","    PAHO_FINAL_DIRECTORY\n","    / \"project_run_metrics_30_seeds.csv\"\n",")\n","\n","PAHO_BUILD_METRICS_PATH = (\n","    PAHO_FINAL_DIRECTORY\n","    / \"build_metrics_30_seeds.parquet\"\n",")\n","\n","PAHO_RANKINGS_PATH = (\n","    PAHO_FINAL_DIRECTORY\n","    / \"rankings_30_seeds.parquet\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Confirm definitive Paho outputs exist\n","# ---------------------------------------------------------\n","\n","required_final_files = [\n","    PAHO_FINAL_REPORT_PATH,\n","    PAHO_PROJECT_SUMMARY_PATH,\n","    PAHO_PROJECT_RUN_PATH,\n","    PAHO_BUILD_METRICS_PATH,\n","    PAHO_RANKINGS_PATH,\n","]\n","\n","\n","missing_final_files = [\n","    str(path)\n","    for path in required_final_files\n","    if not path.exists()\n","]\n","\n","\n","if missing_final_files:\n","    raise FileNotFoundError(\n","        \"Paho cannot be frozen because final files \"\n","        \"are missing:\\n\"\n","        + \"\\n\".join(\n","            missing_final_files\n","        )\n","    )\n","\n","\n","with open(\n","    PAHO_FINAL_REPORT_PATH,\n","    \"r\",\n","    encoding=\"utf-8\",\n",") as report_file:\n","\n","    final_report = json.load(\n","        report_file\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Strict final-report checks\n","# ---------------------------------------------------------\n","\n","expected_report_values = {\n","    \"Project\":\n","        \"eclipse@paho.mqtt.java\",\n","\n","    \"ProjectSlug\":\n","        \"eclipse__paho.mqtt.java\",\n","\n","    \"Status\":\n","        \"PASS\",\n","\n","    \"ConditionsExpected\":\n","        270,\n","\n","    \"ConditionsAudited\":\n","        270,\n","\n","    \"Seeds\":\n","        30,\n","\n","    \"NoiseLevels\":\n","        9,\n","\n","    \"Techniques\":\n","        7,\n","\n","    \"ScoredEvaluationBuildsPerTechnique\":\n","        20,\n","\n","    \"EvaluationRowsPerTechnique\":\n","        980,\n","\n","    \"EvaluationFailuresPerTechnique\":\n","        22,\n","\n","    \"ProjectRunRows\":\n","        1890,\n","\n","    \"BuildMetricRows\":\n","        37800,\n","\n","    \"RankingRows\":\n","        1852200,\n","\n","    \"FitTimeRows\":\n","        1080,\n","\n","    \"NestedMaskComparisons\":\n","        240,\n","\n","    \"NestedMaskViolations\":\n","        0,\n","\n","    \"UniformAuditViolations\":\n","        0,\n","\n","    \"BaselineInvarianceViolations\":\n","        0,\n","\n","    \"MetricRecalculationMismatches\":\n","        0,\n","\n","    \"RankingTieViolations\":\n","        0,\n","\n","    \"EvaluationDataMismatches\":\n","        0,\n","\n","    \"ProjectRunAggregationMismatches\":\n","        0,\n","\n","    \"DistinctUniformStreams\":\n","        30,\n","\n","    \"DistinctRandomSeedRankings\":\n","        30,\n","\n","    \"QTFAvgInvariantAcrossAllConditions\":\n","        True,\n","\n","    \"RandomInvariantAcrossNoiseWithinSeed\":\n","        True,\n","\n","    \"EvaluationUnchangedAllConditions\":\n","        True,\n","}\n","\n","\n","for field, 