pd\n","\n","# One row per CI-build/commit relationship\n","build_commit_map = (\n","    builds_checked[\n","        [\"id\", \"build_order\", \"started_at\", \"commits\"]\n","    ]\n","    .assign(\n","        Commit=lambda frame:\n","        frame[\"commits\"].astype(str).str.split(\"#\")\n","    )\n","    .explode(\"Commit\", ignore_index=True)\n",")\n","\n","build_commit_map[\"Commit\"] = (\n","    build_commit_map[\"Commit\"]\n","    .astype(str)\n","    .str.strip()\n",")\n","\n","# Check whether each parsed value is a valid 40-character Git hash\n","build_commit_map[\"valid_hash_format\"] = (\n","    build_commit_map[\"Commit\"]\n","    .str.fullmatch(r\"[0-9a-fA-F]{40}\")\n",")\n","\n","# Check whether the commit exists in entity_change_history.csv\n","history_commit_set = set(\n","    entity_change[\"Commit\"].astype(str).str.strip()\n",")\n","\n","build_commit_map[\"found_in_change_history\"] = (\n","    build_commit_map[\"Commit\"].isin(history_commit_set)\n",")\n","\n","\n","print(\"=== PARSED BUILD-COMMIT RELATIONSHIPS ===\")\n","\n","print(\"CI builds:\", builds_checked[\"id\"].nunique())\n","print(\"Total commit references:\", len(build_commit_map))\n","print(\"Unique referenced commits:\",\n","      build_commit_map[\"Commit\"].nunique())\n","\n","print(\n","    \"Invalid hash formats:\",\n","    int((~build_commit_map[\"valid_hash_format\"]).sum())\n",")\n","\n","print(\n","    \"Commit references found in change history:\",\n","    int(build_commit_map[\"found_in_change_history\"].sum())\n",")\n","\n","print(\n","    \"Commit references absent from change history:\",\n","    int((~build_commit_map[\"found_in_change_history\"]).sum())\n",")\n","\n","\n","# Number of commits associated with each build\n","commits_per_build = (\n","    build_commit_map\n","    .groupby(\"id\")\n","    .size()\n",")\n","\n","print(\"\\n=== COMMITS PER BUILD ===\")\n","print(commits_per_build.value_counts().sort_index())\n","\n","\n","# Show the unmatched individual hashes\n","unmatched_commits = (\n","    build_commit_map[\n","        ~build_commit_map[\"found_in_change_history\"]\n","    ][\n","        [\n","            \"id\",\n","            \"build_order\",\n","            \"started_at\",\n","            \"Commit\",\n","            \"valid_hash_format\",\n","        ]\n","    ]\n","    .sort_values([\"build_order\", \"Commit\"])\n","    .reset_index(drop=True)\n",")\n","\n","print(\"\\n=== UNMATCHED INDIVIDUAL COMMITS ===\")\n","display(unmatched_commits)\n","\n","\n","# ---------------------------------------------------------\n","# CREATE BUILD → CHANGED ENTITY RELATIONSHIPS\n","# ---------------------------------------------------------\n","\n","commit_entity_pairs = (\n","    entity_change[\n","        [\"Commit\", \"EntityId\"]\n","    ]\n","    .drop_duplicates()\n",")\n","\n","build_entity_map = (\n","    build_commit_map.merge(\n","        commit_entity_pairs,\n","        on=\"Commit\",\n","        how=\"left\"\n","    )\n",")\n","\n","# Store a set of changed entity IDs for every CI build\n","changed_entities_by_build = {}\n","\n","for build_id, rows in build_entity_map.groupby(\"id\"):\n","    changed_entities_by_build[int(build_id)] = set(\n","        rows[\"EntityId\"]\n","        .dropna()\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","# Ensure that even builds with no matched entities have an empty set\n","for build_id in builds_checked[\"id\"]:\n","    changed_entities_by_build.setdefault(\n","        int(build_id),\n","        set()\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# BUILD-LEVEL SUMMARY\n","# ---------------------------------------------------------\n","\n","commit_match_summary = (\n","    build_commit_map\n","    .groupby([\"id\", \"build_order\"])\n","    .agg(\n","        commit_references=(\"Commit\", \"size\"),\n","        matched_commit_references=(\n","            \"found_in_change_history\",\n","            \"sum\"\n","        ),\n","    )\n","    .reset_index()\n",")\n","\n","entity_count_summary = (\n","    build_entity_map\n","    .groupby(\"id\")[\"EntityId\"]\n","    .nunique()\n","    .rename(\"unique_changed_entities\")\n","    .reset_index()\n",")\n","\n","build_mapping_summary = (\n","    builds_checked[\n","        [\"id\", \"build_order\", \"started_at\"]\n","    ]\n","    .merge(\n","        commit_match_summary,\n","        on=[\"id\", \"build_order\"],\n","        how=\"left\"\n","    )\n","    .merge(\n","        entity_count_summary,\n","        on=\"id\",\n","        how=\"left\"\n","    )\n",")\n","\n","build_mapping_summary[\n","    \"unique_changed_entities\"\n","] = (\n","    build_mapping_summary[\n","        \"unique_changed_entities\"\n","    ]\n","    .fillna(0)\n","    .astype(int)\n",")\n","\n","print(\"\\n=== BUILD-LEVEL MAPPING SUMMARY ===\")\n","\n","print(\n","    \"Builds with every commit matched:\",\n","    int(\n","        (\n","            build_mapping_summary[\n","                \"commit_references\"\n","            ]\n","            ==\n","            build_mapping_summary[\n","                \"matched_commit_references\"\n","            ]\n","        ).sum()\n","    )\n",")\n","\n","print(\n","    \"Builds with at least one unmatched commit:\",\n","    int(\n","        (\n","            build_mapping_summary[\n","                \"commit_references\"\n","            ]\n","            !=\n","            build_mapping_summary[\n","                \"matched_commit_references\"\n","            ]\n","        ).sum()\n","    )\n",")\n","\n","print(\n","    \"Builds with zero changed entities:\",\n","    int(\n","        (\n","            build_mapping_summary[\n","                \"unique_changed_entities\"\n","            ] == 0\n","        ).sum()\n","    )\n",")\n","\n","print(\"\\nUnique changed entities per build:\")\n","print(\n","    build_mapping_summary[\n","        \"unique_changed_entities\"\n","    ].describe()\n",")\n","\n","print(\"\\nFirst 