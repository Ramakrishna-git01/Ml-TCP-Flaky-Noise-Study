e_with_time[\"test\"] == test_id\n","        ]\n","        .sort_values(\"build_order\")\n","        .reset_index(drop=True)\n","    )\n","\n","    verdict2_positions = history.index[\n","        history[\"verdict\"] == 2\n","    ].tolist()\n","\n","    for position in verdict2_positions:\n","\n","        if position + 1 \u003e= len(history):\n","            continue\n","\n","        next_execution = history.iloc[position + 1]\n","\n","        matching_dataset_row = dataset_with_time[\n","            (dataset_with_time[\"Test\"] == test_id)\n","            \u0026 (dataset_with_time[\"Build\"] == next_execution[\"build\"])\n","        ]\n","\n","        if not matching_dataset_row.empty:\n","            chosen_case = {\n","                \"test_id\": int(test_id),\n","                \"history\": history,\n","                \"position\": position,\n","                \"next_dataset_row\": matching_dataset_row,\n","            }\n","            break\n","\n","    if chosen_case is not None:\n","        break\n","\n","\n","if chosen_case is None:\n","    print(\n","        \"\\nNo verdict-2 execution was immediately followed \"\n","        \"by an execution represented in dataset.csv.\"\n","    )\n","\n","else:\n","    test_id = chosen_case[\"test_id\"]\n","    history = chosen_case[\"history\"]\n","    position = chosen_case[\"position\"]\n","    next_dataset_row = chosen_case[\"next_dataset_row\"]\n","\n","    print(\"\\nSelected test:\", test_id)\n","\n","    start = max(0, position - 2)\n","    end = min(len(history), position + 3)\n","\n","    print(\"\\nRaw executions around verdict 2:\")\n","    display(\n","        history.iloc[start:end][\n","            [\n","                \"build\",\n","                \"build_order\",\n","                \"started_at\",\n","                \"test\",\n","                \"verdict\",\n","                \"duration\",\n","            ]\n","        ]\n","    )\n","\n","    print(\"\\nHistorical features at the next executio