9  2026-07-24T01:23:31.770970+00:00  \n","250  2026-07-24T01:23:45.928295+00:00  \n","251  2026-07-24T01:23:58.157647+00:00  \n","252  2026-07-24T01:24:09.122971+00:00  \n","253  2026-07-24T01:24:21.231864+00:00  \n","254  2026-07-24T01:24:33.917785+00:00  \n","255  2026-07-24T01:24:48.285219+00:00  \n","256  2026-07-24T01:25:03.059026+00:00  \n","257  2026-07-24T01:25:17.395404+00:00  \n","258  2026-07-24T01:25:29.707460+00:00  \n","259  2026-07-24T01:25:41.577772+00:00  \n","260  2026-07-24T01:25:54.167753+00:00  "]},"metadata":{},"output_type":"display_data"}],"source":["# =========================================================\n","# AIRAVATA — RESTART-SAFE FULL BATCH FOR SEEDS 2–30\n","# =========================================================\n","\n","from contextlib import redirect_stdout, redirect_stderr\n","from datetime import datetime, timezone\n","from io import StringIO\n","from pathlib import Path\n","\n","import gc\n","import json\n","import time\n","import traceback\n","\n","import pandas as pd\n","from IPython.display import display as ipython_display\n","\n","\n","# ---------------------------------------------------------\n","# 1. SAFETY CHECKS\n","# ---------------------------------------------------------\n","\n","if PROJECT_NAME != \"apache@airavata\":\n","    raise RuntimeError(\n","        \"The current project is not apache@airavata. \"\n","        f\"Current PROJECT_NAME: {PROJECT_NAME}\"\n","    )\n","\n","if not callable(\n","    globals().get(\"run_unified_condition\")\n","):\n","    raise RuntimeError(\n","        \"run_unified_condition is not available.\"\n","    )\n","\n","\n","BATCH_SEEDS = list(range(2, 31))\n","\n","BATCH_NOISE_LEVELS = [\n","    0, 5, 10, 15, 20, 25, 30, 40, 50\n","]\n","\n","TOTAL_CONDITIONS = (\n","    len(BATCH_SEEDS)\n","    * len(BATCH_NOISE_LEVELS)\n",")\n","\n","\n","EXPECTED_TECHNIQUES = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","}\n","\n","EXPECTED_ML_TECHNIQUES = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","}\n","\n","EXPECTED_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","    \"rankings.parquet\",\n","]\n","\n","\n","EXPECTED_EVALUATION_ROWS = len(\n","    clean_evaluation_data\n",")\n","\n","EXPECTED_EVALUATION_BUILDS = int(\n","    clean_evaluation_data[\n","        \"Build\"\n","    ].nunique()\n",")\n","\n","EXPECTED_RANKING_ROWS = (\n","    EXPECTED_EVALUATION_ROWS\n","    * len(EXPECTED_TECHNIQUES)\n",")\n","\n","EXPECTED_BUILD_METRIC_ROWS = (\n","    EXPECTED_EVALUATION_BUILDS\n","    * len(EXPECTED_TECHNIQUES)\n",")\n","\n","\n","PROGRESS_DIRECTORY = (\n","    LOGS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROGRESS_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","PROGRESS_PATH = (\n","    PROGRESS_DIRECTORY\n","    / \"seeds_02_30_progress.csv\"\n",")\n","\n","FAILURE_LOG_DIRECTORY = (\n","    PROGRESS_DIRECTORY\n","    / \"batch_failure_logs\"\n",")\n","\n","FAILURE_LOG_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. PROGRESS-FILE HELPERS\n","# ---------------------------------------------------------\n","\n","PROGRESS_COLUMNS = [\n","    \"Project\",\n","    \"RepetitionSeed\",\n","    \"NoisePercent\",\n","    \"Status\",\n","    \"ElapsedSeconds\",\n","    \"ConditionDirectory\",\n","    \"Error\",\n","    \"RecordedAt\",\n","]\n","\n","\n","def load_progress():\n","    if not PROGRESS_PATH.exists():\n","        return pd.DataFrame(\n","            columns=PROGRESS_COLUMNS\n","        )\n","\n","    progress = pd.read_csv(\n","        PROGRESS_PATH\n","    )\n","\n","    for column in PROGRESS_COLUMNS:\n","        if column not in progress.columns:\n","            progress[column] = \"\"\n","\n","    return progress[\n","        PROGRESS_COLUMNS\n","    ].copy()\n","\n","\n","def save_progress_atomically(\n","    progress_dataframe,\n","):\n","    progress_dataframe = (\n","        progress_dataframe\n","        .sort_values(\n","            [\n","                \"RepetitionSeed\",\n","                \"NoisePercent\",\n","                \"RecordedAt\",\n","            ]\n","        )\n","        .drop_duplicates(\n","            [\n","                \"RepetitionSeed\",\n","                \"NoisePercent\",\n","            ],\n","            keep=\"last\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    temporary_path = (\n","        PROGRESS_PATH.parent\n","        / (\n","            PROGRESS_PATH.name\n","            + \".temporary\"\n","        )\n","    )\n","\n","    progress_dataframe.to_csv(\n","        temporary_path,\n","        index=False,\n","    )\n","\n","    temporary_path.replace(\n","        PROGRESS_PATH\n","    )\n","\n","\n","def add_progress_record(\n","    progress_dataframe,\n","    repetition_seed,\n","    noise_percent,\n","    status,\n","    elapsed_seconds,\n","    condition_directory,\n","    error=\"\",\n","):\n","    record = pd.DataFrame([{\n","        \"Project\":\n","            PROJECT_NAME,\n","        \"RepetitionSeed\":\n","            int(repetition_seed),\n","        \"NoisePercent\":\n","            int(noise_percent),\n","        \"Status\":\n","            str(status),\n","        \"ElapsedSeconds\":\n","            float(elapsed_seconds),\n","        \"ConditionDirectory\":\n","            str(condition_directory),\n","        \"Error\":\n","            str(error),\n","        \"RecordedAt\":\n","            datetime.now(\n","                timezone.utc\n","            ).isoformat(),\n","    }])\n","\n","    updated = pd.concat(\n","        [\n","            progress_dataframe,\n","            record,\n","        ],\n","        ignore_index=True,\n","    )\n","\n","    save_progress_atomically(\n","        updated\n","    )\n","\n","    return load_progress()\n","\n","\n","# ---------------------------------------------------------\n","# 3. CONDITION INSPECTION\n","# ---------------------------------------------------------\n","\n","def inspect_completed_condition(\n","    condition_directory,\n","):\n","    missing_files = [\n","        file_name\n","        for file_name in EXPECTED_FILES\n","        if not (\n","            condition_directory\n","            / file_name\n","        ).exists()\n","    ]\n","\n","    if missing_files:\n","        raise RuntimeError(\n","            \"Missing condition files:\\n\"\n","            + \"\\n\".join(missing_files)\n","        )\n","\n","\n","    marker_path = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","    with open(\n","        marker_path,\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as marker_file:\n","        metadata = json.load(\n","            marker_file\n","        )\n","\n","\n","    if metadata.get(\n","        \"CompletedSuccessfully\"\n","    ) is not True:\n","        raise RuntimeError(\n","            \"CompletedSuccessfully is not True.\"\n","        )\n","\n","    if metadata.get(\n","        \"EvaluationHashUnchanged\"\n","    ) is not True:\n","        raise RuntimeError(\n","            \"EvaluationHashUnchanged is not True.\"\n","        )\n","\n","    if int(\n","        metadata.get(\n","            \"TechniqueCount\",\n","            -1,\n","        )\n","    ) != 7:\n","        raise RuntimeError(\n","            \"Unexpected technique count.\"\n","        )\n","\n","    if int(\n","        metadata.get(\n","            \"EvaluatedBuilds\",\n","            -1,\n","        )\n","    ) != EXPECTED_EVALUATION_BUILDS:\n","        raise RuntimeError(\n","            \"Unexpected evaluated-build count.\"\n","        )\n","\n","    if int(\n","        metadata.get(\n","            \"RankingRows\",\n","            -1,\n","        )\n","    ) != EXPECTED_RANKING_ROWS:\n","        raise RuntimeError(\n","            \"Unexpected ranking-row count.\"\n","        )\n","\n","    if int(\n","        metadata.get(\n","            \"BuildMetricRows\",\n","            -1,\n","        )\n","    ) != EXPECTED_BUILD_METRIC_ROWS:\n","        raise RuntimeError(\n","            \"Unexpected build-metric row count.\"\n","        )\n","\n","\n","    project_results = pd.read_csv(\n","        condition_directory\n","        / \"project_run_metrics.csv\"\n","    )\n","\n","    fit_times = pd.read_csv(\n","        condition_directory\n","        / \"fit_times.csv\"\n","    )\n","\n","\n","    if len(project_results) != 7:\n","        raise RuntimeError(\n","            \"project_run_metrics.csv does not \"\n","            \"contain seven rows.\"\n","        )\n","\n","    if len(fit_times) != 4:\n","        raise RuntimeError(\n","            \"fit_times.csv does not contain \"\n","            \"four rows.\"\n","        )\n","\n","    if set(\n","        project_results[\"Technique\"]\n","    ) != EXPECTED_TECHNIQUES:\n","        raise RuntimeError(\n","            \"Unexpected techniques in \"\n","            \"project_run_metrics.csv.\"\n","        )\n","\n","    if set(\n","        fit_times[\"Technique\"]\n","    ) != EXPECTED_ML_TECHNIQUES:\n","        raise RuntimeError(\n","            \"Unexpected techniques in \"\n","            \"fit_times.csv.\"\n","        )\n","\n","    if not (\n","        project_results[\n","            \"EvaluatedBuilds\"\n","        ] == EXPECTED_EVALUATION_BUILDS\n","    ).all():\n","        raise RuntimeError(\n","            \"Unexpected evaluated-build value \"\n","            \"in project results.\"\n","        )\n","\n","    return metadata\n","\n","\n","# ---------------------------------------------------------\n","# 4. RUN SEEDS 2–30\n","# ---------------------------------------------------------\n","\n","progress = load_progress()\n","\n","print(\n","    \"Starting or resuming seeds 2–30 batch.\"\n",")\n","\n","print(\"\\n=== AIRAVATA SEEDS 2–30 BATCH ===\")\n","\n","print(\n","    \"Conditions scheduled:\",\n","    TOTAL_CONDITIONS,\n",")\n","\n","print(\n","    \"Progress file:\",\n","    PROGRESS_PATH,\n",")\n","\n","\n","batch_start_time = time.time()\n","\n","condition_number = 0\n","successful_or_existing = 0\n","\n","\n","for repetition_seed in BATCH_SEEDS:\n","\n","    for noise_percent in BATCH_NOISE_LEVELS:\n","\n","        condition_number += 1\n","\n","        condition_directory = (\n","            PROJECT_RAW_RESULTS\n","            / f\"noise_{noise_percent:03d}\"\n","            / f\"seed_{repetition_seed:02d}\"\n","        )\n","\n","        success_marker = (\n","            condition_directory\n","            / \"_SUCCESS.json\"\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # Skip only fully valid completed conditions\n","        # -------------------------------------------------\n","\n","        if success_marker.exists():\n","\n","            try:\n","                inspect_completed_condition(\n","                    condition_directory\n","                )\n","\n","            except Exception as inspection_error:\n","                print(\n","                    f\"\\n[{condition_number:03d}/\"\n","                    f\"{TOTAL_CONDITIONS}] \"\n","                    f\"seed {repetition_seed:02d}, \"\n","                    f\"noise {noise_percent:02d}% \"\n","                    \"— INVALID EXISTING CONDITION\"\n","                )\n","\n","                raise RuntimeError(\n","                    f\"Existing condition failed inspection: \"\n","                    f\"{condition_directory}\"\n","                ) from inspection_error\n","\n","\n","            progress = add_progress_record(\n","                progress_dataframe=progress,\n","                repetition_seed=repetition_seed,\n","                noise_percent=noise_percent,\n","                status=\"SUCCESS\",\n","                elapsed_seconds=0.0,\n","                condition_directory=(\n","                    condition_directory\n","                ),\n","                error=\"\",\n","            )\n","\n","            successful_or_existing += 1\n","\n","            print(\n","                f\"[{condition_number:03d}/\"\n","                f\"{TOTAL_CONDITIONS}] \"\n","                f\"seed {repetition_seed:02d}, \"\n","                f\"noise {noise_percent:02d}% \"\n","                \"— ALREADY COMPLETE\"\n","            )\n","\n","            continue\n","\n","\n","        # -------------------------------------------------\n","        # Execute one condition\n","        # -------------------------------------------------\n","\n","        condition_start_time = time.time()\n","\n","        captured_stdout = StringIO()\n","        captured_stderr = StringIO()\n","\n","        original_display = globals().get(\n","            \"display\"\n","        )\n","\n","\n","        try:\n","            globals()[\"display\"] = (\n","                lambda *args, **kwargs: None\n","            )\n","\n","            with redirect_stdout(\n","                captured_stdout\n","            ), redirect_stderr(\n","                captured_stderr\n","            ):\n","\n","                run_unified_condition(\n","                    noise_percent=noise_percent,\n","                    repetition_seed=(\n","                        repetition_seed\n","                    ),\n","                    save_rankings=True,\n","                    overwrite=False,\n","                )\n","\n","\n","            inspect_completed_condition(\n","                condition_directory\n","            )\n","\n","\n","            elapsed_seconds = (\n","                time.time()\n","                - condition_start_time\n","            )\n","\n","\n","            progress = add_progress_record(\n","                progress_dataframe=progress,\n","                repetition_seed=repetition_seed,\n","                noise_percent=noise_percent,\n","                status=\"SUCCESS\",\n","                elapsed_seconds=(\n","                    elapsed_seconds\n","                ),\n","                condition_directory=(\n","                    condition_directory\n","                ),\n","                error=\"\",\n","            )\n","\n","\n","            successful_or_existing += 1\n","\n","\n","            print(\n","                f\"[{condition_number:03d}/\"\n","                f\"{TOTAL_CONDITIONS}] \"\n","                f\"seed {repetition_seed:02d}, \"\n","                f\"noise {noise_percent:02d}% \"\n","                f\"— SUCCESS — \"\n","                f\"{elapsed_seconds:.2f} seconds\"\n","            )\n","\n","\n","        except Exception as condition_error:\n","\n","            elapsed_seconds = (\n","                time.time()\n","                - condition_start_time\n","            )\n","\n","            error_text = (\n","                f\"{type(condition_error).__name__}: \"\n","                f\"{condition_error}\"\n","            )\n","\n","\n","            progress = add_progress_record(\n","                progress_dataframe=progress,\n","                repetition_seed=repetition_seed,\n","                noise_percent=noise_percent,\n","                status=\"FAILED\",\n","                elapsed_seconds=(\n","                    elapsed_seconds\n","                ),\n","                condition_directory=(\n","                    condition_directory\n","                ),\n","                error=error_text,\n","            )\n","\n","\n","            failure_log_path = (\n","                FAILURE_LOG_DIRECTORY\n","                / (\n","                    f\"seed_{repetition_seed:02d}_\"\n","                    f\"noise_{noise_percent:03d}.txt\"\n","                )\n","            )\n","\n","\n","            with open(\n","                failure_log_path,\n","                \"w\",\n","                encoding=\"utf-8\",\n","            ) as failure_file:\n","\n","                failure_file.write(\n","                    \"=== CONDITION FAILURE ===\\n\"\n","                )\n","\n","                failure_file.write(\n","                    f\"Project: {PROJECT_NAME}\\n\"\n","                )\n","\n","                failure_file.write(\n","                    f\"Seed: {repetition_seed}\\n\"\n","                )\n","\n","                failure_file.write(\n","                    f\"Noise: {noise_percent}%\\n\"\n","                )\n","\n","                failure_file.write(\n","                    f\"Error: {error_text}\\n\\n\"\n","                )\n","\n","                failure_file.write(\n","                    \"=== CAPTURED STDOUT ===\\n\"\n","                )\n","\n","                failure_file.write(\n","                    captured_stdout.getvalue()\n","                )\n","\n","                failure_file.write(\n","                    \"\\n\\n=== CAPTURED STDERR ===\\n\"\n","                )\n","\n","                failure_file.write(\n","                    captured_stderr.getvalue()\n","                )\n","\n","                failure_file.write(\n","                    \"\\n\\n=== TRACEBACK ===\\n\"\n","                )\n","\n","                failure_file.write(\n","                    traceback.format_exc()\n","                )\n","\n","\n","            print(\n","                f\"\\nFAILED at seed \"\n","                f\"{repetition_seed:02d}, \"\n","                f\"noise {noise_percent:02d}%.\"\n","            )\n","\n","            print(\n","                \"Failure log saved:\"\n","            )\n","\n","            print(\n","                failure_log_path\n","            )\n","\n","            raise\n","\n","\n","        finally:\n","