ws', 'ModelEvaluationBuilds', 'ModelTrainingPasses', 'ModelTrainingFailures', 'ModelEvaluationPasses', 'ModelEvaluationFailures', 'MissingBuildTimestamps', 'UnmatchedExecutionBuilds', 'UnmatchedDatasetBuilds', 'DuplicateDatasetBuildTestPairs', 'MissingExecutionDurations']\""]}],"source":["# =========================================================\n","# PROJECT 6\n","# FRESH-RUNTIME RESTORATION, SELECTION AND DATASET RECOVERY\n","#\n","# This cell:\n","#   - mounts Google Drive\n","#   - confirms Projects 1–5 remain frozen\n","#   - restores the TCP-CI archive into runtime storage\n","#   - derives the next eligible unfinished project\n","#   - verifies that Project 6 is eclipse@jetty.project\n","#   - verifies the six required project files\n","#   - creates a Project 6 selection checkpoint\n","#\n","# This cell does NOT:\n","#   - modify Projects 1–5\n","#   - run Project 6 preprocessing\n","#   - train any model\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","import shutil\n","import tarfile\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","from google.colab import drive\n","\n","\n","# ---------------------------------------------------------\n","# 1. Mount Google Drive\n","# ---------------------------------------------------------\n","\n","drive.mount(\n","    \"/content/drive\",\n","    force_remount=False,\n",")\n","\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n",")\n","\n","LOGS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Logs\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","PROCESSED_DATA_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Data\"\n","    / \"processed\"\n",")\n","\n","RAW_DATA_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Data\"\n","    / \"Raw\"\n",")\n","\n","\n","for required_directory in [\n","    THESIS_DRIVE,\n","    RAW_RESULTS_DRIVE,\n","    AGGREGATED_RESULTS_DRIVE,\n","    LOGS_DRIVE,\n","    NOTES_DRIVE,\n","    PROCESSED_DATA_DRIVE,\n","    RAW_DATA_DRIVE,\n","]:\n","    if not required_directory.exists():\n","        raise FileNotFoundError(\n","            \"Required thesis directory is missing:\\n\"\n","            f\"{required_directory}\"\n","        )\n","\n","\n","print(\n","    \"=== PROJECT 6 FRESH-RUNTIME RESTORATION ===\"\n",")\n","\n","print(\n","    \"Google Drive mounted:\",\n","    THESIS_DRIVE.exists(),\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Permanent source files\n","# ---------------------------------------------------------\n","\n","ARCHIVE_PATH = (\n","    RAW_DATA_DRIVE\n","    / \"TCP-CI-main-dataset.tar.gz\"\n",")\n","\n","SCREENING_PATH = (\n","    PROCESSED_DATA_DRIVE\n","    / \"tcp_ci_project_screening.csv\"\n",")\n","\n","COMPLETION_REGISTRY_PATH = (\n","    NOTES_DRIVE\n","    / \"completed_project_registry.csv\"\n",")\n","\n","\n","for required_file in [\n","    ARCHIVE_PATH,\n","    SCREENING_PATH,\n","    COMPLETION_REGISTRY_PATH,\n","]:\n","    if not required_file.exists():\n","        raise FileNotFoundError(\n","            \"Required permanent file is missing:\\n\"\n","            f\"{required_file}\"\n","        )\n","\n","\n","if ARCHIVE_PATH.stat().st_size \u003c= 0:\n","    raise AssertionError(\n","        \"The TCP-CI archive is empty.\"\n","    )\n","\n","\n","print(\n","    \"Dataset archive found:\",\n","    ARCHIVE_PATH,\n",")\n","\n","print(\n","    \"Screening file found:\",\n","    SCREENING_PATH,\n",")\n","\n","print(\n","    \"Completion registry found:\",\n","    COMPLETION_REGISTRY_PATH,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Load screening and completion registry\n","# ---------------------------------------------------------\n","\n","screening = pd.read_csv(\n","    SCREENING_PATH\n",")\n","\n","completion_registry = pd.read_csv(\n","    COMPLETION_REGISTRY_PATH\n",")\n","\n","\n","if len(screening) != 25:\n","    raise AssertionError(\n","        \"Unexpected screening-project count.\\n\"\n","        f\"Expected: 25\\n\"\n","        f\"Observed: {len(screening)}\"\n","    )\n","\n","\n","if completion_registry.empty:\n","    raise AssertionError(\n","        \"The completion registry is empty.\"\n","    )\n","\n","\n","def normalise_column_name(\n","    column_name,\n","):\n","    return \"\".join(\n","        character.lower()\n","        for character in str(column_name)\n","        if character.isalnum()\n","    )\n","\n","\n","def locate_column(\n","    dataframe,\n","    aliases,\n","    required=True,\n","):\n","    normalised_columns = {\n","        normalise_column_name(column):\n","            column\n","        for column in dataframe.columns\n","    }\n","\n","    for alias in aliases:\n","        normalised_alias = normalise_column_name(\n","            alias\n","        )\n","\n","        if normalised_alias in normalised_columns:\n","            return normalised_columns[\n","                normalised_alias\n","            ]\n","\n","    if required:\n","        raise KeyError(\n","            \"Could not locate a required column.\\n\"\n","            f\"Accepted aliases: {aliases}\\n\"\n","            f\"Available columns: \"\n","            f\"{list(dataframe.columns)}\"\n","        )\n","\n","    return None\n","\n","\n","screening_project_column = locate_column(\n","    screening,\n","    [\n","        \"Project\",\n","        \"ProjectName\",\n","        \"Repository\",\n","        \"DatasetProject\",\n","        \"Name\",\n","    ],\n",")\n","\n","\n","screening_eligibility_column = locate_column(\n","    screening,\n","    [\n","        \"Eligible\",\n","        \"IsEligible\",\n","        \"Eligibility\",\n","        \"Include\",\n","        \"Included\",\n","        \"Status\",\n","    ],\n",")\n","\n","\n","screening_order_column = locate_column(\n","    screening,\n","    [\n","        \"ProjectNumber\",\n","        \"ProjectOrder\",\n","        \"ScreeningOrder\",\n","        \"Order\",\n","        \"Index\",\n","    ],\n","    required=False,\n",")\n","\n","\n","registry_project_column = locate_column(\n","    completion_registry,\n","    [\n","        \"Project\",\n","        \"ProjectName\",\n","        \"Repository\",\n","        \"DatasetProject\",\n","        \"Name\",\n","    ],\n",")\n","\n","\n","registry_status_column = locate_column(\n","    completion_registry,\n","    [\n","        \"Status\",\n","        \"ProjectStatus\",\n","    ],\n",")\n","\n","\n","registry_project_number_column = locate_column(\n","    completion_registry,\n","    [\n","        \"ProjectNumber\",\n","        \"ProjectOrder\",\n","        \"Order\",\n","    ],\n","    required=False,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Interpret the screening eligibility column\n","# ---------------------------------------------------------\n","\n","def interpret_eligibility(\n","    value,\n","):\n","    if pd.isna(value):\n","        return False\n","\n","    if isinstance(\n","        value,\n","        (bool, np.bool_),\n","    ):\n","        return bool(value)\n","\n","    if isinstance(\n","        value,\n","        (\n","            int,\n","            float,\n","            np.integer,\n","            np.floating,\n","        ),\n","    ):\n","        return bool(\n","            int(value)\n","        )\n","\n","    normalised_value = (\n","        str(value)\n","        .strip()\n","        .lower()\n","        .replace(\"_\", \"\")\n","        .replace(\"-\", \"\")\n","        .replace(\" \", \"\")\n","    )\n","\n","    positive_values = {\n","        \"true\",\n","        \"1\",\n","        \"yes\",\n","        \"y\",\n","        \"eligible\",\n","        \"included\",\n","        \"include\",\n","        \"pass\",\n","        \"passed\",\n","    }\n","\n","    negative_values = {\n","        \"false\",\n","        \"0\",\n","        \"no\",\n","        \"n\",\n","        \"ineligible\",\n","        \"excluded\",\n","        \"exclude\",\n","        \"fail\",\n","        \"failed\",\n","    }\n","\n","    if normalised_value in positive_values:\n","        return True\n","\n","    if normalised_value in negative_values:\n","        return False\n","\n","    raise ValueError(\n","        \"Could not interpret screening eligibility \"\n","        f\"value: {value!r}\"\n","    )\n","\n","\n","screening = screening.copy()\n","\n","\n","screening[\n","    \"_EligibleBoolean\"\n","] = screening[\n","    screening_eligibility_column\n","].map(\n","    interpret_eligibility\n",")\n","\n","\n","eligible_screening = (\n","    screening[\n","        screening[\n","            \"_EligibleBoolean\"\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","if len(\n","    eligible_screening\n",") != 24:\n","    print(\n","        \"\\nScreening eligibility values:\"\n","    )\n","\n","    display(\n","        screening[\n","            screening_eligibility_column\n","        ]\n","        .value_counts(\n","            dropna=False\n","        )\n","        .rename_axis(\n","            \"EligibilityValue\"\n","        )\n","        .reset_index(\n","            name=\"Rows\"\n","        )\n","    )\n","\n","    raise AssertionError(\n","        \"Unexpected eligible-project count.\\n\"\n","        f\"Expected: 24\\n\"\n","        f\"Observed: {len(eligible_screening)}\"\n","    )\n","\n","\n","if screening_order_column is not None:\n","    eligible_screening = (\n","        eligible_screening\n","        .sort_values(\n","            screening_order_column,\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","else:\n","    # Preserve the approved screening-file order.\n","    eligible_screening = (\n","        eligible_screening\n","        .reset_index(drop=True)\n","    )\n","\n","\n","eligible_screening[\n","    \"_EligibleSequence\"\n","] = np.arange(\n","    1,\n","    len(eligible_screening) + 1,\n","    dtype=np.int64,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Verify the five frozen completed projects\n","# ---------------------------------------------------------\n","\n","frozen_registry = (\n","    completion_registry[\n","        completion_registry[\n","            registry_status_column\n","        ]\n","        .astype(str)\n","        .str.strip()\n","        .str.upper()\n","        == \"COMPLETE_AND_FROZEN\"\n","    ]\n","    .copy()\n",")\n","\n","\n","if registry_project_number_column is not None:\n","    frozen_registry[\n","        registry_project_number_column\n","    ] = pd.to_numeric(\n","        frozen_registry[\n","            registry_project_number_column\n","        ],\n","        errors=\"coerce\",\n","    )\n","\n","    frozen_registry = (\n","        frozen_registry\n","        .sort_values(\n","            registry_project_number_column,\n","            kind=\"mergesort\",\n","            na_position=\"last\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","frozen_projects = set(\n","    frozen_registry[\n","        registry_project_column\n","    ]\n","    .astype(str)\n","    .tolist()\n",")\n","\n","\n","expected_frozen_projects = {\n","    \"Angel-ML@angel\",\n","    \"apache@airavata\",\n","    \"b2ihealthcare@snow-owl\",\n","    \"eclipse@paho.mqtt.java\",\n","    \"thinkaurelius@titan\",\n","}\n","\n","\n","missing_expected_frozen_projects = (\n","    expected_frozen_projects\n","    - frozen_projects\n",")\n","\n","\n","if missing_expected_frozen_projects:\n","    raise AssertionError(\n","        \"One or more completed projects are not frozen:\\n\"\n","        + \"\\n\".join(\n","            sorted(\n","                missing_expected_frozen_projects\n","            )\n","        )\n","    )\n","\n","\n","if len(\n","    frozen_projects\n",") \u003c 5:\n","    raise AssertionError(\n","        \"Fewer than five projects are marked frozen.\"\n","    )\n","\n","\n","# Verify Titan's permanent freeze markers.\n","TITAN_FINAL_FREEZE_RECORD = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / \"thinkaurelius__titan\"\n","    / \"titan_30_seed_final\"\n","    / \"PROJECT_FROZEN.json\"\n",")\n","\n","TITAN_RAW_FREEZE_MARKER = (\n","    RAW_RESULTS_DRIVE\n","    / \"thinkaurelius__titan\"\n","    / \"_PROJECT_FROZEN.json\"\n",")\n","\n","TITAN_NOTES_FREEZE_RECORD = (\n","    NOTES_DRIVE\n","    / \"project_05_freeze_record.json\"\n",")\n","\n","\n","for titan_freeze_path in [\n","    TITAN_FINAL_FREEZE_RECORD,\n","    TITAN_RAW_FREEZE_MARKER,\n","    TITAN_NOTES_FREEZE_RECORD,\n","]:\n","    if not titan_freeze_path.exists():\n","        raise FileNotFoundError(\n","            \"Project 5 freeze marker is missing:\\n\"\n","            f\"{titan_freeze_path}\"\n","        )\n","\n","\n","with open(\n","    TITAN_FINAL_FREEZE_RECORD,\n","    \"r\",\n","    encoding=\"utf-8\",\n",") as titan_freeze_file:\n","    titan_freeze_record = json.load(\n","        titan_freeze_file\n","    )\n","\n","\n","if titan_freeze_record.get(\n","    \"Status\"\n",") != \"COMPLETE_AND_FROZEN\":\n","    raise AssertionError(\n","        \"Project 5 freeze record has an invalid status.\"\n","    )\n","\n","\n","if not bool(\n","    titan_freeze_record.get(\n","        \"DoNotRerun\",\n","        False,\n","    )\n","):\n","    raise AssertionError(\n","        \"Project 5 freeze record does not contain \"\n","        \"DoNotRerun=True.\"\n","    )\n","\n","\n","print(\n","    \"\\nFrozen completed projects:\",\n","    len(frozen_projects),\n",")\n","\n","\n","display_columns = [\n","    column\n","    for column in [\n","        registry_project_number_column,\n","        registry_project_column,\n","        registry_status_column,\n","    ]\n","    if column is not None\n","]\n","\n","\n","display(\n","    frozen_registry[\n","        display_columns\n","    ].head(10)\n",")\n","\n","\n","print(\n","    \"Project 5 freeze markers validated:\",\n","    True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Derive the next eligible unfinished project\n","# ---------------------------------------------------------\n","\n","eligible_screening[\n","    \"_AlreadyCompleted\"\n","] = (\n","    eligible_screening[\n","        screening_project_column\n","    ]\n","    .astype(str)\n","    .isin(\n","        frozen_projects\n","    )\n",")\n","\n","\n","unfinished_eligible_projects = (\n","    eligible_screening[\n","        ~eligible_screening[\n","            \"_AlreadyCompleted\"\n","        ]\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","if unfinished_eligible_projects.empty:\n","    raise AssertionError(\n","        \"No unfinished eligible projects remain.\"\n","    )\n","\n","\n","selected_screening_row = (\n","    unfinished_eligible_projects.iloc[0]\n",")\n","\n","\n","PROJECT_NUMBER = 6\n","\n","PROJECT_NAME = str(\n","    selected_screening_row[\n","        screening_project_column\n","    ]\n",")\n","\n","PROJECT_SLUG = (\n","    PROJECT_NAME\n","    .replace(\n","        \"@\",\n","        \"__\",\n","    )\n","    .replace(\n","        \"/\",\n","        \"__\",\n","    )\n",")\n","\n","\n","EXPECTED_PROJECT_NAME = (\n","    \"eclipse@jetty.project\"\n",")\n","\n","EXPECTED_PROJECT_SLUG = (\n","    \"eclipse__jetty.project\"\n",")\n","\n","\n","if PROJECT_NAME != EXPECTED_PROJECT_NAME:\n","    print(\n","        \"\\nFirst unfinished eligible projects:\"\n","    )\n","\n","    display(\n","        unfinished_eligible_projects[\n","            [\n","                screening_project_column,\n","                screening_eligibility_column,\n","                \"_EligibleSequence\",\n","            ]\n","        ].head(10)\n","    )\n","\n","    raise AssertionError(\n","        \"The derived Project 6 does not match the \"\n","        \"approved project sequence.\\n\"\n","        f\"Expected: {EXPECTED_PROJECT_NAME}\\n\"\n","        f\"Observed: {PROJECT_NAME}\"\n","    )\n","\n","\n","if PROJECT_SLUG != EXPECTED_PROJECT_SLUG:\n","    raise AssertionError(\n","        \"Project 6 slug generation failed.\\n\"\n","        f\"Expected: {EXPECTED_PROJECT_SLUG}\\n\"\n","        f\"Observed: {PROJECT_SLUG}\"\n","    )\n","\n","\n","if PROJECT_NAME in frozen_projects:\n","    raise AssertionError(\n","        \"Project 6 is already present in the \"\n","        \"completion registry.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Restore the dataset into fresh runtime storage\n","# ---------------------------------------------------------\n","\n","RUNTIME_ROOT = Path(\n","    \"/content/working_data/tcp_ci_full\"\n",")\n","\n","\n","def locate_datasets_root(\n","    extraction_root,\n","):\n","    direct_candidate = (\n","        extraction_root\n","        / \"datasets\"\n","    )\n","\n","    if direct_candidate.exists():\n","        return direct_candidate\n","\n","    candidates = []\n","\n","    for candidate in extraction_root.rglob(\n","        \"datasets\"\n","    ):\n","        if not candidate.is_dir():\n","            continue\n","\n","        project_directories = [\n","            child\n","            for child in candidate.iterdir()\n","            if child.is_dir()\n","        ]\n","\n","        if len(project_directories) \u003e= 20:\n","            candidates.append(\n","                candidate\n","            )\n","\n","    if len(candidates) == 1:\n","        return candidates[0]\n","\n","    if len(candidates) \u003e 1:\n","        candidates = sorted(\n","            candidates,\n","            key=lambda path:\n","                len(\n","                    list(\n","                        path.iterdir()\n","                    )\n","                ),\n","            reverse=True,\n","        )\n","\n","        return candidates[0]\n","\n","    return None\n","\n","\n","DATASETS_ROOT = locate_datasets_root(\n","    RUNTIME_ROOT\n",")\n","\n","\n","if DATASETS_ROOT is None:\n","    if RUNTIME_ROOT.exists():\n","        print(\n","            \"\\nRemoving incomplete runtime extraction:\"\n","        )\n","\n","        print(\n","            RUNTIME_ROOT\n","        )\n","\n","        shutil.rmtree(\n","            RUNTIME_ROOT\n","        )\n","\n","    RUNTIME_ROOT.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","    print(\n","        \"\\nExtracting TCP-CI archive into fresh runtime...\"\n","    )\n","\n","    print(\n","        \"Source:\",\n","        ARCHIVE_PATH,\n","    )\n","\n","    print(\n","        \"Destination:\",\n","        RUNTIME_ROOT,\n","    )\n","\n","    with tarfile.open(\n","        ARCHIVE_PATH,\n","        mode=\"r:gz\",\n","    ) as archive:\n","        try:\n","            archive.extractall(\n","                RUNTIME_ROOT,\n","                filter=\"data\",\n","            )\n","\n","        except TypeError:\n","            # Compatibility with older Python tarfile APIs.\n","            archive.extractall(\n","                RUNTIME_ROOT\n","            )\n","\n","    DATASETS_ROOT = locate_datasets_root(\n","        RUNTIME_ROOT\n","    )\n","\n","\n","if DATASETS_ROOT is None:\n","    raise FileNotFoundError(\n","        \"The archive was extracted, but the datasets \"\n","        \"directory could not be located.\"\n","    )\n","\n","\n","project_directories = sorted([\n","    child.name\n","    for child in DATASETS_ROOT.iterdir()\n","    if child.is_dir()\n","])\n","\n","\n","if len(project_directories) != 25:\n","    raise AssertionError(\n","        \"Unexpected number of dataset project folders.\\n\"\n","        f\"Ex