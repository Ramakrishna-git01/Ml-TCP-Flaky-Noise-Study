0.630882  0.580615    0.993818\n","5                  25.0      0.589055  0.606817  0.561838    0.983941\n","6                  30.0      0.542846  0.574800  0.519542    0.967571\n","7                  40.0      0.542133  0.550769  0.526627    0.852658\n","8                  50.0      0.456175  0.480018  0.491895    0.599616"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Saved final Angel outputs:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/Angel-ML__angel/angel_30_seed_final\n","\n","SUCCESS: Angel is fully audited and aggregated across all 30 seeds, nine noise levels, four ML models and three baselines.\n"]}],"source":["# =========================================================\n","# ANGEL — COMPLETE 30-SEED AUDIT AND AGGREGATION\n","# =========================================================\n","\n","from pathlib import Path\n","import hashlib\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","import pyarrow.parquet as pq\n","from IPython.display import display\n","\n","\n","print(\"=== ANGEL COMPLETE 30-SEED AUDIT ===\")\n","\n","\n","# ---------------------------------------------------------\n","# 1. EXPECTED EXPERIMENT STRUCTURE\n","# ---------------------------------------------------------\n","\n","EXPECTED_SEEDS = list(range(1, 31))\n","\n","EXPECTED_NOISE_LEVELS = [\n","    0, 5, 10, 15, 20, 25, 30, 40, 50\n","]\n","\n","EXPECTED_TECHNIQUES = {\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","    \"LatestFail\",\n","    \"Random\",\n","    \"QTF-Avg\",\n","}\n","\n","ML_TECHNIQUES_FINAL = [\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","]\n","\n","EXPECTED_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","    \"rankings.parquet\",\n","]\n","\n","EXPECTED_CONDITIONS = 30 * 9\n","EXPECTED_PROJECT_RUN_ROWS = 30 * 9 * 7\n","\n","EXPECTED_MANIFEST_ROWS = 7691\n","EXPECTED_RANKING_ROWS = 4914\n","EXPECTED_BUILD_METRIC_ROWS = 196\n","EXPECTED_PROJECT_METRIC_ROWS = 7\n","EXPECTED_FIT_ROWS = 4\n","\n","\n","FINAL_OUTPUT_DIRECTORY = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n","    / \"angel_30_seed_final\"\n",")\n","\n","FINAL_OUTPUT_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. SMALL HELPERS\n","# ---------------------------------------------------------\n","\n","def parquet_row_count(path):\n","    return int(\n","        pq.ParquetFile(path)\n","        .metadata\n","        .num_rows\n","    )\n","\n","\n","def deterministic_integer_seed(*parts):\n","    text = \"|\".join(\n","        str(part)\n","        for part in parts\n","    )\n","\n","    digest = hashlib.sha256(\n","        text.encode(\"utf-8\")\n","    ).digest()\n","\n","    return int.from_bytes(\n","        digest[:8],\n","        byteorder=\"little\",\n","        signed=False,\n","    ) % (2 ** 32)\n","\n","\n","def bootstrap_mean_ci(\n","    values,\n","    random_seed,\n","    repetitions=10000,\n","):\n","    \"\"\"\n","    Percentile bootstrap 95% confidence interval\n","    for the mean across 30 repetitions.\n","    \"\"\"\n","\n","    values = np.asarray(\n","        values,\n","        dtype=float,\n","    )\n","\n","    values = values[\n","        np.isfinite(values)\n","    ]\n","\n","    if len(values) == 0:\n","        return np.nan, np.nan\n","\n","    if len(values) == 1:\n","        return float(values[0]), float(values[0])\n","\n","    rng = np.random.default_rng(\n","        random_seed\n","    )\n","\n","    sampled_indices = rng.integers(\n","        low=0,\n","        high=len(values),\n","        size=(\n","            repetitions,\n","            len(values),\n","        ),\n","    )\n","\n","    bootstrap_means = (\n","        values[sampled_indices]\n","        .mean(axis=1)\n","    )\n","\n","    lower, upper = np.percentile(\n","        bootstrap_means,\n","        [2.5, 97.5],\n","    )\n","\n","    return float(lower), float(upper)\n","\n","\n","# ---------------------------------------------------------\n","# 3. AUDIT ALL 270 CONDITIONS\n","# ---------------------------------------------------------\n","\n","condition_records = []\n","nested_mask_records = []\n","project_run_frames = []\n","\n","all_uniform_streams_match = True\n","\n","\n","for repetition_seed in EXPECTED_SEEDS:\n","\n","    manifests_for_seed = {}\n","\n","    for noise_percent in EXPECTED_NOISE_LEVELS:\n","\n","        condition_directory = (\n","            PROJECT_RAW_RESULTS\n","            / f\"noise_{noise_percent:03d}\"\n","            / f\"seed_{repetition_seed:02d}\"\n","        )\n","\n","        missing_files = [\n","            file_name\n","            for file_name in EXPECTED_FILES\n","            if not (\n","                condition_directory / file_name\n","            ).exists()\n","        ]\n","\n","        if missing_files:\n","            raise FileNotFoundError(\n","                f\"Seed {repetition_seed}, \"\n","                f\"noise {noise_percent}% is missing:\\n\"\n","                + \"\\n\".join(missing_files)\n","            )\n","\n","\n","        # ---------------------------------------------\n","        # Read completion marker\n","        # ---------------------------------------------\n","\n","        with open(\n","            condition_directory / \"_SUCCESS.json\",\n","            \"r\",\n","            encoding=\"utf-8\",\n","        ) as marker_file:\n","            success_metadata = json.load(\n","                marker_file\n","            )\n","\n","        assert success_metadata[\n","            \"CompletedSuccessfully\"\n","        ] is True\n","\n","        assert success_metadata[\n","            \"EvaluationHashUnchanged\"\n","        ] is True\n","\n","\n","        # ---------------------------------------------\n","        # Fast Parquet row-count checks\n","        # ---------------------------------------------\n","\n","        manifest_rows = parquet_row_count(\n","            condition_directory\n","            / \"noise_manifest.parquet\"\n","        )\n","\n","        ranking_rows = parquet_row_count(\n","            condition_directory\n","            / \"rankings.parquet\"\n","        )\n","\n","        build_metric_rows = parquet_row_count(\n","            condition_directory\n","            / \"build_metrics.parquet\"\n","        )\n","\n","        assert manifest_rows == EXPECTED_MANIFEST_ROWS\n","        assert ranking_rows == EXPECTED_RANKING_ROWS\n","        assert build_metric_rows == EXPECTED_BUILD_METRIC_ROWS\n","\n","\n","        # ---------------------------------------------\n","        # Load small CSV outputs\n","        # ---------------------------------------------\n","\n","        project_run_metrics = pd.read_csv(\n","            condition_directory\n","            / \"project_run_metrics.csv\"\n","        )\n","\n","        fit_times = pd.read_csv(\n","            condition_directory\n","            / \"fit_times.csv\"\n","        )\n","\n","        noise_summary = pd.read_csv(\n","            condition_directory\n","            / \"noise_summary.csv\"\n","        )\n","\n","\n","        assert (\n","            len(project_run_metrics)\n","            == EXPECTED_PROJECT_METRIC_ROWS\n","        )\n","\n","        assert len(fit_times) == EXPECTED_FIT_ROWS\n","\n","        assert set(\n","            project_run_metrics[\n","                \"Technique\"\n","            ]\n","        ) == EXPECTED_TECHNIQUES\n","\n","        assert set(\n","            fit_times[\"Technique\"]\n","        ) == set(ML_TECHNIQUES_FINAL)\n","\n","        assert (\n","            project_run_metrics[\n","                \"EvaluatedBuilds\"\n","            ] == 28\n","        ).all()\n","\n","\n","        # Normalize metadata in case CSV inferred types.\n","        project_run_metrics[\n","            \"NoisePercent\"\n","        ] = float(noise_percent)\n","\n","        project_run_metrics[\n","            \"RepetitionSeed\"\n","        ] = int(repetition_seed)\n","\n","        project_run_metrics[\n","            \"Project\"\n","        ] = PROJECT_NAME\n","\n","        project_run_frames.append(\n","            project_run_metrics\n","        )\n","\n","\n","        # ---------------------------------------------\n","        # Load and verify corruption manifest\n","        # ---------------------------------------------\n","\n","        manifest = pd.read_parquet(\n","            condition_directory\n","            / \"noise_manifest.parquet\",\n","            columns=[\n","                \"NoiseRowID\",\n","                \"Build\",\n","                \"Test\",\n","                \"OriginalVerdict\",\n","                \"NoisyVerdict\",\n","                \"FlipUniform\",\n","                \"Flipped\",\n","                \"PassToFailure\",\n","                \"FailureToPass\",\n","            ],\n","        )\n","\n","        manifest = (\n","            manifest\n","            .sort_values(\"NoiseRowID\")\n","            .reset_index(drop=True)\n","        )\n","\n","        actual_changes = (\n","            manifest[\"OriginalVerdict\"]\n","            != manifest[\"NoisyVerdict\"]\n","        )\n","\n","        assert np.array_equal(\n","            actual_changes.to_numpy(),\n","            manifest[\"Flipped\"].to_numpy(),\n","        )\n","\n","        flipped_count = int(\n","            manifest[\"Flipped\"].sum()\n","        )\n","\n","        pass_to_failure = int(\n","            manifest[\"PassToFailure\"].sum()\n","        )\n","\n","        failure_to_pass = int(\n","            manifest[\"FailureToPass\"].sum()\n","        )\n","\n","        assert (\n","            pass_to_failure\n","            + failure_to_pass\n","            == flipped_count\n","        )\n","\n","        assert flipped_count == int(\n","            noise_summary[\n","                \"NumberFlipped\"\n","            ].iloc[0]\n","        )\n","\n","        evaluation_builds_in_manifest = len(\n","            set(\n","                manifest[\"Build\"].astype(int)\n","            ).intersection(\n","                evaluation_build_ids\n","            )\n","        )\n","\n","        assert evaluation_builds_in_manifest == 0\n","\n","\n","        manifests_for_seed[\n","            noise_percent\n","        ] = manifest\n","\n","\n","        condition_records.append({\n","            \"Project\": PROJECT_NAME,\n","            \"RepetitionSeed\":\n","                repetition_seed,\n","            \"NoisePercent\":\n","                noise_percent,\n","            \"RealisedNoisePercent\":\n","                float(\n","                    noise_summary[\n","                        \"RealisedNoisePercent\"\n","                    ].iloc[0]\n","                ),\n","            \"NumberFlipped\":\n","                flipped_count,\n","            \"PassToFailure\":\n","                pass_to_failure,\n","            \"FailureToPass\":\n","                failure_to_pass,\n","            \"ManifestRows\":\n","                manifest_rows,\n","            \"RankingRows\":\n","                ranking_rows,\n","            \"BuildMetricRows\":\n","                build_metric_rows,\n","            \"ProjectRunRows\":\n","                len(project_run_metrics),\n","            \"MLFitRows\":\n","                len(fit_times),\n","            \"EvaluatedBuilds\":\n","                int(\n","                    project_run_metrics[\n","                        \"EvaluatedBuilds\"\n","                    ].iloc[0]\n","                ),\n","            \"EvaluationBuildsInManifest\":\n","                evaluation_builds_in_manifest,\n","            \"Status\":\n","                \"SUCCESS\",\n","        })\n","\n","\n","    # -----------------------------------------------------\n","    # 4. VERIFY THE NINE-LEVEL MASK LADDER FOR THIS SEED\n","    # -----------------------------------------------------\n","\n","    reference_manifest = (\n","        manifests_for_seed[0]\n","    )\n","\n","    assert int(\n","        reference_manifest[\n","            \"Flipped\"\n","        ].sum()\n","    ) == 0\n","\n","\n","    for noise_percent in EXPECTED_NOISE_LEVELS:\n","\n","        current_manifest = (\n","            manifests_for_seed[\n","                noise_percent\n","            ]\n","        )\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"NoiseRowID\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"NoiseRowID\"\n","            ].to_numpy(),\n","        )\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"Build\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"Build\"\n","            ].to_numpy(),\n","        )\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"Test\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"Test\"\n","            ].to_numpy(),\n","        )\n","\n","        assert np.array_equal(\n","            reference_manifest[\n","                \"OriginalVerdict\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"OriginalVerdict\"\n","            ].to_numpy(),\n","        )\n","\n","        uniform_stream_matches = np.array_equal(\n","            reference_manifest[\n","                \"FlipUniform\"\n","            ].to_numpy(),\n","            current_manifest[\n","                \"FlipUniform\"\n","            ].to_numpy(),\n","        )\n","\n","        if not uniform_stream_matches:\n","            all_uniform_strea