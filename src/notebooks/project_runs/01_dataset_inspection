        10               610               1243   \n","2                 10                  15              1243               1831   \n","3                 15                  20              1831               2459   \n","4                 20                  25              2459               3150   \n","5                 25                  30              3150               3840   \n","6                 30                  40              3840               5107   \n","7                 40                  50              5107               6349   \n","\n","   NestedMaskViolations  Nested  \n","0                     0    True  \n","1                     0    True  \n","2                     0    True  \n","3                     0    True  \n","4                     0    True  \n","5                     0    True  \n","6                     0    True  \n","7                     0    True  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","0% clean reproduction:\n","Raw verdict mismatches: 0\n","Model label mismatches: 0\n","Verdict-dependent REC mismatches: 0\n","Noise-independent REC mismatches: 0\n","All REC mismatches: 0\n","\n","Randomisation validation:\n","Same-seed history reproducible: True\n","Same-seed manifest reproducible: True\n","Different-seed uniforms differ: True\n","Different-seed masks differ: True\n","Nested-mask violations: 0\n","\n","Evaluation immutability:\n","Raw evaluation history unchanged: True\n","Model-ready evaluation data unchanged: True\n","\n","Metric validation:\n","Manual APFD: 0.8\n","APFDc with long failure first: 0.555556\n","APFDc with quick failure first: 0.777778\n","\n","Saved protocol:\n","/content/drive/MyDrive/Thesis_Experiment/Notes/thinkaurelius__titan_experiment_protocol_fixed_holdout_v1.json\n","\n","Validation report:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/thinkaurelius__titan/titan_helper_validation/titan_noise_helper_validation_report.json\n","\n","SUCCESS: Titan training-only verdict noise injection passed.\n","SUCCESS: Seed-specific masks are deterministic and nested across all nine noise levels.\n","SUCCESS: Pass-to-failure subtypes follow Titan's clean failure-subtype distribution.\n","SUCCESS: All fixed model-ready training instances and preserved predictors remain unchanged.\n","SUCCESS: 0% noise exactly reproduces all clean training labels and all 19 REC features.\n","SUCCESS: Clean evaluation data remains unchanged.\n","SUCCESS: Titan is ready for the 0%-noise, seed-1 seven-technique smoke test.\n"]}],"source":["# =========================================================\n","# PROJECT 5: THINKAURELIUS TITAN\n","# CANONICAL VERDICT-NOISE INJECTION + HELPER VALIDATION\n","#\n","# This cell DOES NOT train the ML models yet.\n","#\n","# It validates:\n","#   - training-only verdict corruption\n","#   - project-specific deterministic seeds\n","#   - nested masks across noise levels\n","#   - clean-project failure subtype sampling\n","#   - fixed model-ready training instances\n","#   - recomputation of 13 verdict-dependent REC features\n","#   - preservation of 6 noise-independent REC features\n","#   - clean evaluation immutability\n","#   - APFD and APFDc helper formulas\n","# =========================================================\n","\n","from pathlib import Path\n","import hashlib\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Project and output paths\n","# ---------------------------------------------------------\n","\n","EXPECTED_PROJECT_NUMBER = 5\n","EXPECTED_PROJECT_NAME = \"thinkaurelius@titan\"\n","EXPECTED_PROJECT_SLUG = \"thinkaurelius__titan\"\n","\n","\n","if \"PROJECT_NUMBER\" not in globals():\n","    raise RuntimeError(\n","        \"PROJECT_NUMBER is missing. Rerun the successful \"\n","        \"Titan project-selection and preflight cells.\"\n","    )\n","\n","\n","if PROJECT_NUMBER != EXPECTED_PROJECT_NUMBER:\n","    raise AssertionError(\n","        f\"Expected Project 5, found Project {PROJECT_NUMBER}.\"\n","    )\n","\n","\n","if PROJECT_NAME != EXPECTED_PROJECT_NAME:\n","    raise AssertionError(\n","        f\"Expected {EXPECTED_PROJECT_NAME}, \"\n","        f\"found {PROJECT_NAME}.\"\n","    )\n","\n","\n","if PROJECT_SLUG != EXPECTED_PROJECT_SLUG:\n","    raise AssertionError(\n","        f\"Expected {EXPECTED_PROJECT_SLUG}, \"\n","        f\"found {PROJECT_SLUG}.\"\n","    )\n","\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n",")\n","\n","LOGS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Logs\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","\n","PROJECT_RAW_RESULTS = (\n","    RAW_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_LOGS = (\n","    LOGS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","HELPER_VALIDATION_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_helper_validation\"\n",")\n","\n","\n","for directory in [\n","    RAW_RESULTS_DRIVE,\n","    AGGREGATED_RESULTS_DRIVE,\n","    LOGS_DRIVE,\n","    NOTES_DRIVE,\n","    PROJECT_RAW_RESULTS,\n","    PROJECT_AGGREGATED_RESULTS,\n","    PROJECT_LOGS,\n","    HELPER_VALIDATION_DIRECTORY,\n","]:\n","    directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","print(\n","    \"=== TITAN CANONICAL NOISE-HELPER SETUP ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Confirm required successful-stage variables\n","# ---------------------------------------------------------\n","\n","REQUIRED_VARIABLES = [\n","    \"builds\",\n","    \"exe_for_rec\",\n","    \"dataset_with_order\",\n","    \"clean_training_data\",\n","    \"clean_evaluation_data\",\n","    \"build_entity_map\",\n","    \"changed_entities_by_build\",\n","]\n","\n","\n","missing_variables = [\n","    variable_name\n","    for variable_name in REQUIRED_VARIABLES\n","    if variable_name not in globals()\n","]\n","\n","\n","if missing_variables:\n","    raise RuntimeError(\n","        \"Required Titan variables are missing:\\n\"\n","        + \"\\n\".join(missing_variables)\n","        + \"\\n\\nRerun the successful Titan preflight, \"\n","        \"mapping and final REC validation cells.\"\n","    )\n","\n","\n","# Titan's validated project sizes.\n","if len(exe_for_rec) != 17331:\n","    raise AssertionError(\n","        \"Unexpected Titan raw execution row count.\\n\"\n","        f\"Expected: 17331\\n\"\n","        f\"Observed: {len(exe_for_rec)}\"\n","    )\n","\n","\n","if len(dataset_with_order) != 2391:\n","    raise AssertionError(\n","        \"Unexpected Titan model-ready row count.\\n\"\n","        f\"Expected: 2391\\n\"\n","        f\"Observed: {len(dataset_with_order)}\"\n","    )\n","\n","\n","if len(clean_training_data) != 2028:\n","    raise AssertionError(\n","        \"Unexpected model-ready training row count.\\n\"\n","        f\"Expected: 2028\\n\"\n","        f\"Observed: {len(clean_training_data)}\"\n","    )\n","\n","\n","if len(clean_evaluation_data) != 363:\n","    raise AssertionError(\n","        \"Unexpected model-ready evaluation row count.\\n\"\n","        f\"Expected: 363\\n\"\n","        f\"Observed: {len(clean_evaluation_data)}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Frozen experiment configuration\n","# ---------------------------------------------------------\n","\n","NOISE_LEVELS = [\n","    0,\n","    5,\n","    10,\n","    15,\n","    20,\n","    25,\n","    30,\n","    40,\n","    50,\n","]\n","\n","\n","REPETITION_SEEDS = list(\n","    range(1, 31)\n",")\n","\n","\n","ML_TECHNIQUES = [\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","]\n","\n","\n","BASELINE_TECHNIQUES = [\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","]\n","\n","\n","RECENT_WINDOW = 6\n","\n","\n","REC_FEATURE_COLUMNS = [\n","    \"REC_Age\",\n","    \"REC_LastFailureAge\",\n","    \"REC_LastTransitionAge\",\n","    \"REC_RecentAvgExeTime\",\n","    \"REC_RecentMaxExeTime\",\n","    \"REC_RecentFailRate\",\n","    \"REC_RecentAssertRate\",\n","    \"REC_RecentExcRate\",\n","    \"REC_RecentTransitionRate\",\n","    \"REC_TotalAvgExeTime\",\n","    \"REC_TotalMaxExeTime\",\n","    \"REC_TotalFailRate\",\n","    \"REC_TotalAssertRate\",\n","    \"REC_TotalExcRate\",\n","    \"REC_TotalTransitionRate\",\n","    \"REC_LastVerdict\",\n","    \"REC_LastExeTime\",\n","    \"REC_MaxTestFileFailRate\",\n","    \"REC_MaxTestFileTransitionRate\",\n","]\n","\n","\n","VERDICT_DEPENDENT_REC_COLUMNS = [\n","    \"REC_LastFailureAge\",\n","    \"REC_LastTransitionAge\",\n","    \"REC_RecentFailRate\",\n","    \"REC_RecentAssertRate\",\n","    \"REC_RecentExcRate\",\n","    \"REC_RecentTransitionRate\",\n","    \"REC_TotalFailRate\",\n","    \"REC_TotalAssertRate\",\n","    \"REC_TotalExcRate\",\n","    \"REC_TotalTransitionRate\",\n","    \"REC_LastVerdict\",\n","    \"REC_MaxTestFileFailRate\",\n","    \"REC_MaxTestFileTransitionRate\",\n","]\n","\n","\n","NOISE_INDEPENDENT_REC_COLUMNS = [\n","    \"REC_Age\",\n","    \"REC_RecentAvgExeTime\",\n","    \"REC_RecentMaxExeTime\",\n","    \"REC_TotalAvgExeTime\",\n","    \"REC_TotalMaxExeTime\",\n","    \"REC_LastExeTime\",\n","]\n","\n","\n","if len(REC_FEATURE_COLUMNS) != 19:\n","    raise AssertionError(\n","        \"Expected exactly 19 REC features.\"\n","    )\n","\n","\n","if len(VERDICT_DEPENDENT_REC_COLUMNS) != 13:\n","    raise AssertionError(\n","        \"Expected exactly 13 verdict-dependent \"\n","        \"REC features.\"\n","    )\n","\n","\n","if len(NOISE_INDEPENDENT_REC_COLUMNS) != 6:\n","    raise AssertionError(\n","        \"Expected exactly six noise-independent \"\n","        \"REC features.\"\n","    )\n","\n","\n","if (\n","    set(VERDICT_DEPENDENT_REC_COLUMNS)\n","    \u0026 set(NOISE_INDEPENDENT_REC_COLUMNS)\n","):\n","    raise AssertionError(\n","        \"The two REC feature groups overlap.\"\n","    )\n","\n","\n","if (\n","    set(VERDICT_DEPENDENT_REC_COLUMNS)\n","    | set(NOISE_INDEPENDENT_REC_COLUMNS)\n",") != set(REC_FEATURE_COLUMNS):\n","    raise AssertionError(\n","        \"The REC feature groups do not cover all \"\n","        \"19 REC features.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Prepare deterministic clean raw histories\n","# ---------------------------------------------------------\n","\n","required_execution_columns = [\n","    \"build\",\n","    \"test\",\n","    \"verdict\",\n","    \"duration\",\n","    \"build_order\",\n","    \"partition\",\n","]\n","\n","\n","missing_execution_columns = [\n","    column\n","    for column in required_execution_columns\n","    if column not in exe_for_rec.columns\n","]\n","\n","\n","if missing_execution_columns:\n","    raise KeyError(\n","        \"exe_for_rec is missing columns:\\n\"\n","        + \"\\n\".join(missing_execution_columns)\n","    )\n","\n","\n","canonical_execution_history = (\n","    exe_for_rec.copy()\n",")\n","\n","\n","canonical_execution_history[\n","    \"build\"\n","] = pd.to_numeric(\n","    canonical_execution_history[\n","        \"build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","canonical_execution_history[\n","    \"build_order\"\n","] = pd.to_numeric(\n","    canonical_execution_history[\n","        \"build_order\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","canonical_execution_history[\n","    \"test\"\n","] = (\n","    canonical_execution_history[\n","        \"test\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","canonical_execution_history[\n","    \"verdict\"\n","] = pd.to_numeric(\n","    canonical_execution_history[\n","        \"verdict\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int8\")\n","\n","\n","canonical_execution_history[\n","    \"duration\"\n","] = pd.to_numeric(\n","    canonical_execution_history[\n","        \"duration\"\n","    ],\n","    errors=\"raise\",\n",").astype(float)\n","\n","\n","if not np.isfinite(\n","    canonical_execution_history[\n","        \"duration\"\n","    ].to_numpy(dtype=float)\n",").all():\n","    raise AssertionError(\n","        \"Raw execution durations contain non-finite values.\"\n","    )\n","\n","\n","if (\n","    canonical_execution_history[\n","        \"duration\"\n","    ] \u003c 0\n",").any():\n","    raise AssertionError(\n","        \"Raw execution durations contain negative values.\"\n","    )\n","\n","\n","allowed_verdicts = {\n","    0,\n","    1,\n","    2,\n","    3,\n","}\n","\n","\n","observed_verdicts = set(\n","    canonical_execution_history[\n","        \"verdict\"\n","    ]\n","    .astype(int)\n","    .unique()\n","    .tolist()\n",")\n","\n","\n","if not observed_verdicts.issubset(\n","    allowed_verdicts\n","):\n","    raise AssertionError(\n","        \"Unexpected raw verdict values: \"\n","        f\"{sorted(observed_verdicts)}\"\n","    )\n","\n","\n","canonical_execution_history[\n","    \"_OriginalExecutionOrder\"\n","] = np.arange(\n","    len(canonical_execution_history),\n","    dtype=np.int64,\n",")\n","\n","\n","if \"job\" in canonical_execution_history.columns:\n","    canonical_execution_history[\n","        \"_JobSort\"\n","    ] = (\n","        canonical_execution_history[\n","            \"job\"\n","        ].astype(str)\n","    )\n","\n","else:\n","    canonical_execution_history[\n","        \"_JobSort\"\n","    ] = \"\"\n","\n","\n","canonical_execution_history = (\n","    canonical_execution_history\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"_JobSort\",\n","            \"test\",\n","            \"_OriginalExecutionOrder\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","clean_training_history = (\n","    canonical_execution_history[\n","        canonical_execution_history[\n","            \"partition\"\n","        ] == \"training\"\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","clean_evaluation_history = (\n","    canonical_execution_history[\n","        canonical_execution_history[\n","            \"partition\"\n","        ] == \"evaluation\"\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(clean_training_history) != 12785:\n","    raise AssertionError(\n","        \"Unexpected raw training history size.\\n\"\n","        f\"Expected: 12785\\n\"\n","        f\"Observed: {len(clean_training_history)}\"\n","    )\n","\n","\n","if len(clean_evaluation_history) != 4546:\n","    raise AssertionError(\n","        \"Unexpected raw evaluation history size.\\n\"\n","        f\"Expected: 4546\\n\"\n","        f\"Observed: {len(clean_evaluation_history)}\"\n","    )\n","\n","\n","if (\n","    clean_training_history[\n","        \"partition\"\n","    ] != \"training\"\n",").any():\n","    raise AssertionError(\n","        \"Evaluation rows entered the training history.\"\n","    )\n","\n","\n","if (\n","    clean_evaluation_history[\n","        \"partition\"\n","    ] != \"evaluation\"\n",").any():\n","    raise AssertionError(\n","        \"Training rows entered the evaluation history.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Prepare clean fixed model-ready datasets\n","# ---------------------------------------------------------\n","\n","clean_model_training_data = (\n","    clean_training_data.copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","clean_model_evaluation_data = (\n","    clean_evaluation_data.copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","for dataframe in [\n","    clean_model_training_data,\n","    clean_model_evaluation_data,\n","]:\n","    dataframe[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        dataframe[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","    dataframe[\n","        \"Test\"\n","    ] = (\n","        dataframe[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","    dataframe[\n","        \"Verdict\"\n","    ] = pd.to_numeric(\n","        dataframe[\n","            \"Verdict\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int8\")\n","\n","\n","if clean_model_training_data.duplicated(\n","    subset=[\n","        \"Build\",\n","        \"Test\",\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Model-ready training data contains duplicate \"\n","        \"Build-Test pairs.\"\n","    )\n","\n","\n","if clean_model_evaluation_data.duplicated(\n","    subset=[\n","        \"Build\",\n","        \"Test\",\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Model-ready evaluation data contains duplicate \"\n","        \"Build-Test pairs.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Prepare source-entity history\n","# ---------------------------------------------------------\n","\n","required_entity_columns = [\n","    \"Build\",\n","    \"EntityID\",\n","]\n","\n","\n","missing_entity_columns = [\n","    column\n","    for column in required_entity_columns\n","    if column not in build_entity_map.columns\n","]\n","\n","\n","if missing_entity_columns:\n","    raise KeyError(\n","        \"build_entity_map is missing columns:\\n\"\n","        + \"\\n\".join(missing_entity_columns)\n","    )\n","\n","\n","entity_build_pairs = (\n","    build_entity_map[\n","        [\n","            \"Build\",\n","            \"EntityID\",\n","        ]\n","    ]\n","    .dropna(\n","        subset=[\n","            \"Build\",\n","            \"EntityID\",\n","        ]\n","    )\n","    .drop_duplicates()\n","    .copy()\n",")\n","\n","\n","entity_build_pairs[\n","    \"Build\"\n","] = pd.to_numeric(\n","    entity_build_pairs[\n","        \"Build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","entity_build_pairs[\n","    \"EntityID\"\n","] = (\n","    entity_build_pairs[\n","        \"EntityID\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","entity_changed_builds = (\n","    entity_build_pairs\n","    .groupby(\n","        \"EntityID\",\n","        sort=False,\n","    )[\n","        \"Build\"\n","    ]\n","    .apply(\n","        lambda values:\n","            set(\n","                values.astype(int).tolist()\n","            )\n","    )\n","    .to_dict()\n",")\n","\n","\n","clean_changed_entities_by_build = {\n","    int(build_id):\n","        {\n","            str(entity_id)\n","            for entity_id\n","            in changed_entities_by_build.get(\n","                int(build_id),\n","                set(),\n","            )\n","        }\n","\n","    for build_id\n","    in builds[\n","        \"build\"\n","    ].astype(int)\n","}\n","\n","\n","if set(\n","    clean_changed_entities_by_build.keys()\n",") != set(\n","    builds[\n","        \"build\"\n","    ].astype(int)\n","):\n","    raise AssertionError(\n","        \"The changed-entity dictionary does not contain \"\n","        \"all Titan builds.\"\n","    )\n","\n","\n","DOCUMENTED_UNMATCHED_BUILDS = [\n","    1724328,\n","    5889934,\n","]\n","\n","\n","for unmatched_build in DOCUMENTED_UNMATCHED_BUILDS:\n","    if clean_changed_entities_by_build[\n","        unmatched_build\n","    ] != set():\n","        raise AssertionError(\n","            \"A documented unmatched build unexpectedly \"\n","            \"has changed entities.\\n\"\n","            f\"Build: {unmatched_build}\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Stable hashing helpers\n","# ---------------------------------------------------------\n","\n","def stable_project_seed(\n","    project_name,\n","    repetition_seed,\n","    random_stream,\n","):\n","    \"\"\"\n","    Return a deterministic project-specific 32-bit seed.\n","    \"\"\"\n","\n","    seed_text = (\n","        f\"{project_name}|\"\n","        f\"{int(repetition_seed)}|\"\n","        f\"{str(random_stream)}\"\n","    )\n","\n","\n","    digest = hashlib.sha256(\n","        seed_text.encode(\"utf-8\")\n","    ).digest()\n","\n","\n","    return int.from_bytes(\n","        digest[:8],\n","        byteorder=\"little\",\n","        signed=False,\n","    ) % (2 ** 32)\n","\n","\n","def dataframe_sha256(\n","    dataframe,\n","):\n","    \"\"\"\n","    Stable SHA-256 hash for a pandas DataFrame.\n","    \"\"\"\n","\n","    hashed_values = (\n","        pd.util.hash_pandas_object(\n","            dataframe,\n","            index=True,\n","        )\n","        .to_numpy(\n","            dtype=np.uint64\n","        )\n","    )\n","\n","\n","    return hashlib.sha256(\n","        hashed_values.tobytes()\n","    ).hexdigest()\n","\n","\n","# Hash clean evaluation before any noise generation.\n","EVALUATION_HASH_BEFORE = dataframe_sha256(\n","    clean_model_evaluation_data\n",")\n","\n","\n","RAW_EVALUATION_HASH_BEFORE = dataframe_sha256(\n","    clean_evaluation_history\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Clean failure-subtype distribution\n","# ---------------------------------------------------------\n","\n","clean_failure_subtype_counts = (\n","    clean_training_history.loc[\n","        clean_training_history[\n","            \"verdict\"\n","        ] != 0,\n","        \"verdict\",\n","    ]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","\n","if clean_failure_subtype_counts.empty:\n","    raise AssertionError(\n","        \"Titan has no failure subtype in the clean \"\n","        \"training execution history.\"\n","    )\n","\n","\n","CLEAN_FAILURE_SUBTYPES = (\n","    clean_failure_subtype_counts\n","    .index\n","    .to_numpy(dtype=int)\n",")\n","\n","\n","CLEAN_FAILURE_SUBTYPE_PROBABILITIES = (\n","    clean_failure_subtype_counts\n","    .to_numpy(dtype=float)\n",")\n","\n","\n","CLEAN_FAILURE_SUBTYPE_PROBABILITIES /= (\n","    CLEAN_FAILURE_SUBTYPE_PROBABILITIES.sum()\n",")\n","\n","\n","failure_subtype_distribution = pd.DataFrame({\n","    \"FailureSubtype\":\n","        CLEAN_FAILURE_SUBTYPES,\n","\n","    \"CleanCount\":\n","        clean_failure_subtype_counts\n","        .to_numpy(dtype=int),\n","\n","    \"CleanProbability\":\n","        CLEAN_FAILURE_SUBTYPE_PROBABILITIES,\n","})\n","\n","\n","# ---------------------------------------------------------\n","# 9. Canonical verdict-noise injection\n","# ---------------------------------------------------------\n","\n","def inject_training_verdict_noise(\n","    execution_history,\n","    noise_percent,\n","    repetition_seed,\n","    project_name=PROJECT_NAME,\n","):\n","    \"\"\"\n","    Independently flip raw TRAINING verdicts.\n","\n","    A common uniform value is generated for every row\n","    and seed. The same values are reused at every noise\n","    level, producing nested masks.\n","\n","    Pass:\n","        verdict 0 becomes a project-specific sampled\n","        clean failure subtype.\n","\n","    Failure:\n","        every non-zero verdict becomes 0.\n","    \"\"\"\n","\n","    noise_percent = float(\n","        noise_percent\n","    )\n","\n","\n","    if not 0 \u003c= noise_percent \u003c= 100:\n","        raise ValueError(\n","            \"noise_percent must be between 0 and 100.\"\n","        )\n","\n","\n","    if int(repetition_seed) not in REPETITION_SEEDS:\n","        raise ValueError(\n","            \"repetition_seed must be one of 1 through 30.\"\n","        )\n","\n","\n","    noisy_history = (\n","        execution_history.copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    if len(noisy_history) == 0:\n","        raise ValueError(\n","            \"execution_history is empty.\"\n","        )\n","\n","\n","    required_columns = [\n","        \"build\",\n","        \"test\",\n","        \"verdict\",\n","    ]\n","\n","\n","    missing_columns = [\n","        column\n","        for column in required_columns\n","        if column not in noisy_history.columns\n","    ]\n","\n","\n","    if missing_columns:\n","        raise KeyError(\n","            \"Noise input is missing columns:\\n\"\n","            + \"\\n\".join(missing_columns)\n","        )\n","\n","\n","    if (\n","        \"partition\" in noisy_history.columns\n","        and (\n","            noisy_history[\n","                \"partition\"\n","            ] != \"training\"\n","        ).any()\n","    ):\n","        raise AssertionError(\n","            \"Noise injection received rows outside \"\n","            \"the training partition.\"\n","        )\n","\n","\n","    original_verdict = pd.to_numeric(\n","        noisy_history[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(int).to_numpy()\n","\n","\n","    if not set(\n","        np.unique(\n","            original_verdict\n","        ).tolist()\n","    ).issubset(\n","        allowed_verdicts\n","    ):\n","        raise AssertionError(\n","            \"Noise input contains an invalid verdict.\"\n","        )\n","\n","\n","    number_of_rows = len(\n","        noisy_history\n","    )\n","\n","\n","    flip_seed = stable_project_seed(\n","        project_name,\n","        repetition_seed,\n","        \"flip_mask\",\n","    )\n","\n","\n","    subtype_seed = stable_project_seed(\n","        project_name,\n","        repetition_seed,\n","        \"failure_subtype\",\n","    )\n","\n","\n","    flip_rng = np.random.default_rng(\n","        flip_seed\n","    )\n","\n","\n","    subtype_rng = np.random.default_rng(\n","        subtype_seed\n","    )\n","\n","\n","    row_uniforms = flip_rng.random(\n","        number_of_rows\n","    )\n","\n","\n","    flip_mask = (\n","        row_uniforms\n","        \u003c noise_percent / 100.0\n","    )\n","\n","\n","    sampled_failure_subtypes = (\n","        subtype_rng.choice(\n","            CLEAN_FAILURE_SUBTYPES,\n","            size=number_of_rows,\n","            replace=True,\n","            p=(\n","                CLEAN_FAILURE_SUBTYPE_PROBABILITIES\n","            ),\n","        )\n","    )\n","\n","\n","    noisy_verdict = (\n","        original_verdict.copy()\n","    )\n","\n","\n","    pass_to_failure_mask = (\n","        flip_mask\n","        \u0026 (\n","            original_verdict == 0\n","        )\n","    )\n","\n","\n","    failure_to_pass_mask = (\n","        flip_mask\n","        \u0026 (\n","            original_verdict != 0\n","        )\n","    )\n","\n","\n","    noisy_verdict[\n","        pass_to_failure_mask\n","    ] = sampled_failure_subtypes[\n","        pass_to_failure_mask\n","    ]\n","\n","\n","    noisy_verdict[\n","        failure_to_pass_mask\n","    ] = 0\n","\n","\n","    noisy_history[\n","        \"verdict\"\n","    ] = noisy_verdict.astype(\n","        \"int8\"\n","    )\n","\n","\n","    manifest = pd.DataFrame({\n","        \"NoiseRowID\":\n","            np.arange(\n","                number_of_rows,\n","                dtype=np.int64,\n","            ),\n","\n","        \"Build\":\n","            noisy_history[\n","                \"build\"\n","            ].to_numpy(),\n","\n","        \"Test\":\n","            noisy_history[\n","                \"test\"\n","            ].astype(str).to_numpy(),\n","\n","        \"OriginalVerdict\":\n","            original_verdict,\n","\n","        \"NoisyVerdict\":\n","            noisy_verdict,\n","\n","        \"FlipUniform\":\n","            row_uniforms,\n","\n","        \"SampledFailureSubtype\":\n","            sampled_failure_subtypes,\n","\n","        \"Flipped\":\n","            flip_mask,\n","\n","        \"PassToFailure\":\n","            pass_to_failure_mask,\n","\n","        \"FailureToPass\":\n","            failure_to_pass_mask,\n","    })\n","\n","\n","    if \"job\" in noisy_history.columns:\n","        manifest[\n","            \"Job\"\n","        ] = noisy_history[\n","            \"job\"\n","        ].to_numpy()\n","\n","\n","    # Internal direction checks.\n","    if not np.array_equal(\n","        noisy_verdict[\n","            failure_to_pass_mask\n","        ],\n","        np.zeros(\n","            failure_to_pass_mask.sum(),\n","            dtype=int,\n","        ),\n","    ):\n","        raise AssertionError(\n","            \"A failure-to-pass flip did not become 0.\"\n","        )\n","\n","\n","    pass_to_failure_values = noisy_verdict[\n","        pass_to_failure_mask\n","    ]\n","\n","\n","    if not set(\n","        np.unique(\n","            pass_to_failure_values\n","        ).tolist()\n","    ).issubset(\n","        set(\n","            CLEAN_FAILURE_SUBTYPES.tolist()\n","        )\n","    ):\n","        raise AssertionError(\n","            \"A pass-to-failure flip used an invalid \"\n","            \"failure subtype.\"\n","        )\n","\n","\n","    if not np.array_equal(\n","        noisy_verdict[\n","            ~flip_mask\n","        ],\n","        original_verdict[\n","            ~flip_mask\n","        ],\n","    ):\n","        raise AssertionError(\n","            \"An unselected training verdict changed.\"\n","        )\n","\n","\n","    number_flipped = int(\n","        flip_mask.sum()\n","    )\n","\n","\n","    summary = {\n","        \"Project\":\n","            project_name,\n","\n","        \"NoisePercentRequested\":\n","            noise_percent,\n","\n","        \"RepetitionSeed\":\n","            int(repetition_seed),\n","\n","        \"TrainingExecutionRows\":\n","            int(number_of_rows),\n","\n","        \"NumberFlipped\":\n","            number_flipped,\n","\n","        \"RealisedNoisePercent\":\n","            float(\n","                100.0\n","                * number_flipped\n","                / number_of_rows\n","            ),\n","\n","        \"PassToFailure\":\n","            int(\n","                pass_to_failure_mask.sum()\n","            ),\n","\n","        \"FailureToPass\":\n","            int(\n","                failure_to_pass_mask.sum()\n","            ),\n","\n","        \"FlipMaskSeed\":\n","            int(flip_seed),\n","\n","        \"FailureSubtypeSeed\":\n","            int(subtype_seed),\n","    }\n","\n","\n","    return (\n","        noisy_history,\n","        manifest,\n","        summary,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Verdict-dependent REC helpers\n","# ---------------------------------------------------------\n","\n","def calculate_rec_rates(\n","    history,\n","):\n","    \"\"\"\n","    Calculate historical verdict rates.\n","    \"\"\"\n","\n","    history_length = len(\n","        history\n","    )\n","\n","\n","    if history_length == 0:\n","        raise ValueError(\n","            \"Rate calculation requires non-empty history.\"\n","        )\n","\n","\n","    verdicts = pd.to_numeric(\n","        history[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    )\n","\n","\n","    return (\n","        float(\n","            (\n","                verdicts != 0\n","            ).sum()\n","            / history_length\n","        ),\n","\n","        float(\n","            (\n","                verdicts == 2\n","            ).sum()\n","            / history_length\n","        ),\n","\n","        float(\n","            (\n","                verdicts == 1\n","            ).sum()\n","            / history_length\n","        ),\n","\n","        float(\n","            (\n","                history[\n","                    \"transition\"\n","                ] == 1\n","            ).sum()\n","            / history_length\n","        ),\n","    )\n","\n","\n","def calculate_max_test_file_rate(\n","    history,\n","    target_column,\n","    current_changed_entities,\n","):\n","    \"\"\"\n","    Calculate the maximum changed-entity overlap rate\n","    for historical failures or transitions.\n","    \"\"\"\n","\n","    if target_column not in {\n","        \"verdict\",\n","        \"transition\",\n","    }:\n","        raise ValueError(\n","            \"target_column must be verdict or transition.\"\n","        )\n","\n","\n","    target_builds = (\n","        history.loc[\n","            history[\n","                target_column\n","            ] \u003e 0,\n","            \"build\",\n","        ]\n","        .drop_duplicates()\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","\n","    if len(target_builds) == 0:\n","        return -1.0\n","\n","\n","    target_build_set = set(\n","        target_builds\n","    )\n","\n","\n","    maximum_overlap = 0\n","\n","\n","    for entity_id in current_changed_entities:\n","        changed_builds = (\n","            entity_changed_builds.get(\n","                str(entity_id),\n","                set(),\n","            )\n","        )\n","\n","\n","        overlap = len(\n","            changed_builds.intersection(\n","                target_build_set\n","            )\n","        )\n","\n","\n","        maximum_overlap = max(\n","            maximum_overlap,\n","            overlap,\n","        )\n","\n","\n","    if maximum_overlap == 0:\n","        return 0.0\n","\n","\n","    return float(\n","        maximum_overlap\n","        / len(target_builds)\n","    )\n","\n","\n","def reconstruct_verdict_dependent_rec_features(\n","    execution_history,\n","    requested_rows,\n","    recent_window=6,\n","):\n","    \"\"\"\n","    Reconstruct the 13 REC features affected by\n","    historical verdict corruption.\n","    \"\"\"\n","\n","    if recent_window \u003c= 0:\n","        raise ValueError(\n","            \"recent_window must be positive.\"\n","        )\n","\n","\n","    history_input = (\n","        execution_history.copy()\n","    )\n","\n","\n","    history_input[\n","        \"build\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    history_input[\n","        \"build_order\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"build_order\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    history_input[\n","        \"test\"\n","    ] = (\n","        history_input[\n","            \"test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    history_input[\n","        \"verdict\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int8\")\n","\n","\n","    if \"_OriginalExecutionOrder\" not in (\n","        history_input.columns\n","    ):\n","        history_input[\n","            \"_OriginalExecutionOrder\"\n","        ] = np.arange(\n","            len(history_input),\n","            dtype=np.int64,\n","        )\n","\n","\n","    if \"_JobSort\" not in history_input.columns:\n","        if \"job\" in history_input.columns:\n","            history_input[\n","                \"_JobSort\"\n","            ] = (\n","                history_input[\n","                    \"job\"\n","                ].astype(str)\n","            )\n","\n","        else:\n","            history_input[\n","                \"_JobSort\"\n","            ] = \"\"\n","\n","\n","    history_input = (\n","        history_input\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"_JobSort\",\n","                \"test\",\n","                \"_OriginalExecutionOrder\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        requested[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    requested[\n","        \"Test\"\n","    ] = (\n","        requested[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    if requested.duplicated(\n","        subset=[\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ).any():\n","        raise AssertionError(\n","            \"Requested rows contain duplicate \"\n","            \"Build-Test pairs.\"\n","        )\n","\n","\n","    requested_pairs = set(\n","        zip(\n","            requested[\n","                \"Build\"\n","            ].astype(int),\n","\n","            requested[\n","                \"Test\"\n","            ].astype(str),\n","        )\n","    )\n","\n","\n","    reconstructed_records = []\n","    reconstructed_pairs = set()\n","\n","\n","    for test_id, test_history in (\n","        history_input.groupby(\n","            \"test\",\n","            sort=False,\n","        )\n","    ):\n","        test_id = str(\n","            test_id\n","        )\n","\n","\n","        test_history = (\n","            test_history\n","            .sort_values(\n","                [\n","                    \"build_order\",\n","                    \"_JobSort\",\n","                    \"_OriginalExecutionOrder\",\n","                ],\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","            .copy()\n","        )\n","\n","\n","        test_history[\n","            \"transition\"\n","        ] = (\n","            test_history[\n","                \"verdict\"\n","            ]\n","            .diff()\n","            .fillna(0)\n","            .ne(0)\n","            .astype(int)\n","        )\n","\n","\n","        for current_position in range(\n","            len(test_history)\n","        ):\n","            current_row = (\n","                test_history.iloc[\n","                    current_position\n","                ]\n","            )\n","\n","\n","            current_build = int(\n","                current_row[\n","                    \"build\"\n","                ]\n","            )\n","\n","\n","            pair = (\n","                current_build,\n","                test_id,\n","            )\n","\n","\n","            if pair not in requested_pairs:\n","                continue\n","\n","\n","            if pair in reconstructed_pairs:\n","                raise AssertionError(\n","                    \"Multiple raw execution rows matched \"\n","                    \"one requested Build-Test pair.\\n\"\n","                    f\"Pair: {pair}\"\n","                )\n","\n","\n","            reconstructed_pairs.add(\n","                pair\n","            )\n","\n","\n","            history = (\n","                test_history\n","                .iloc[\n","                    :current_position\n","                ]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","\n","            record = {\n","                \"Build\":\n","                    current_build,\n","\n","                \"Test\":\n","                    test_id,\n","            }\n","\n","\n","            if history.empty:\n","                for feature in (\n","                    VERDICT_DEPENDENT_REC_COLUMNS\n","                ):\n","                    record[\n","                        feature\n","                    ] = -1.0\n","\n","\n","                reconstructed_records.append(\n","                    record\n","                )\n","\n","                continue\n","\n","\n","            recent_history = (\n","                history\n","                .tail(\n","                    recent_window\n","                )\n","                .copy()\n","            )\n","\n","\n","            failure_positions = np.flatnonzero(\n","                history[\n","                    \"verdict\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","\n","            if len(failure_positions) == 0:\n","                last_failure_age = -1\n","\n","            else:\n","                last_failure_age = int(\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        failure_positions[-1]\n","                    )\n","                )\n","\n","\n","            transition_positions = np.flatnonzero(\n","                history[\n","                    \"transition\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","\n","            if len(transition_positions) == 0:\n","                last_transition_age = -1\n","\n","            else:\n","                last_transition_age = int(\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        transition_positions[-1]\n","                    )\n","                )\n","\n","\n","            (\n","                recent_fail_rate,\n","                recent_assert_rate,\n","                recent_exception_rate,\n","                recent_transition_rate,\n","            ) = calculate_rec_rates(\n","                recent_history\n","            )\n","\n","\n","            (\n","                total_fail_rate,\n","                total_assert_rate,\n","                total_exception_rate,\n","                total_transition_rate,\n","            ) = calculate_rec_rates(\n","                history\n","            )\n","\n","\n","            current_changed_entities = (\n","                clean_changed_entities_by_build.get(\n","                    current_build,\n","                    set(),\n","                )\n","            )\n","\n","\n","            record.update({\n","                \"REC_LastFailureAge\":\n","                    float(\n","                        last_failure_age\n","                    ),\n","\n","                \"REC_LastTransitionAge\":\n","                    float(\n","                        last_transition_age\n","                    ),\n","\n","                \"REC_RecentFailRate\":\n","                    recent_fail_rate,\n","\n","                \"REC_RecentAssertRate\":\n","                    recent_assert_rate,\n","\n","                \"REC_RecentExcRate\":\n","                    recent_exception_rate,\n","\n","                \"REC_RecentTransitionRate\":\n","                    recent_transition_rate,\n","\n","                \"REC_TotalFailRate\":\n","                    total_fail_rate,\n","\n","                \"REC_TotalAssertRate\":\n","                    total_assert_rate,\n","\n","                \"REC_TotalExcRate\":\n","                    total_exception_rate,\n","\n","                \"REC_TotalTransitionRate\":\n","                    total_transition_rate,\n","\n","                \"REC_LastVerdict\":\n","                    float(\n","                        recent_history.iloc[-1][\n","                            \"verdict\"\n","                        ]\n","                    ),\n","\n","                \"REC_MaxTestFileFailRate\":\n","                    calculate_max_test_file_rate(\n","                        history=history,\n","                        target_column=\"verdict\",\n","                        current_changed_entities=(\n","                            current_changed_entities\n","                        ),\n","                    ),\n","\n","                \"REC_MaxTestFileTransitionRate\":\n","                    calculate_max_test_file_rate(\n","                        history=history,\n","                        target_column=\"transition\",\n","                        current_changed_entities=(\n","                            current_changed_entities\n","                        ),\n","                    ),\n","            })\n","\n","\n","            reconstructed_records.append(\n","                record\n","            )\n","\n","\n","    reconstructed = pd.DataFrame(\n","        reconstructed_records\n","    )\n","\n","\n","    expected_columns = (\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","        + VERDICT_DEPENDENT_REC_COLUMNS\n","    )\n","\n","\n","    if reconstructed.empty:\n","        reconstructed = pd.DataFrame(\n","            columns=expected_columns\n","        )\n","\n","\n","    missing_columns = [\n","        column\n","        for column in expected_columns\n","        if column not in reconstructed.columns\n","    ]\n","\n","\n","    if missing_columns:\n","        raise AssertionError(\n","            \"Reconstruction is missing columns:\\n\"\n","            + \"\\n\".join(missing_columns)\n","        )\n","\n","\n","    reconstructed = (\n","        reconstructed[\n","            expected_columns\n","        ]\n","        .sort_values(\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    output_pairs = set(\n","        zip(\n","            reconstructed[\n","                \"Build\"\n","            ].astype(int),\n","\n","            reconstructed[\n","                \"Test\"\n","            ].astype(str),\n","        )\n","    )\n","\n","\n","    missing_pairs = sorted(\n","        requested_pairs\n","        - output_pairs\n","    )\n","\n","\n","    extra_pairs = sorted(\n","        output_pairs\n","        - requested_pairs\n","    )\n","\n","\n","    if missing_pairs:\n","        raise AssertionError(\n","            \"Requested model-ready pairs were not \"\n","            \"reconstructed.\\n\"\n","            f\"Examples: {missing_pairs[:10]}\"\n","        )\n","\n","\n","    if extra_pairs:\n","        raise AssertionError(\n","            \"Unexpected model-ready pairs were \"\n","            \"reconstructed.\\n\"\n","            f\"Examples: {extra_pairs[:10]}\"\n","        )\n","\n","\n","    return reconstructed\n","\n","\n","# ---------------------------------------------------------\n","# 11. Align reconstructed features to fixed rows\n","# ---------------------------------------------------------\n","\n","def align_reconstructed_verdict_features(\n","    reconstructed,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Align reconstructed verdict-dependent REC features\n","    to the exact original model-ready row order.\n","    \"\"\"\n","\n","    reconstructed_checked = (\n","        reconstructed.copy()\n","    )\n","\n","\n","    requested_checked = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    for dataframe in [\n","        reconstructed_checked,\n","        requested_checked,\n","    ]:\n","        dataframe[\n","            \"Build\"\n","        ] = pd.to_numeric(\n","            dataframe[\n","                \"Build\"\n","            ],\n","            errors=\"raise\",\n","        ).astype(\"int64\")\n","\n","        dataframe[\n","            \"Test\"\n","        ] = (\n","            dataframe[\n","                \"Test\"\n","            ]\n","            .astype(str)\n","        )\n","\n","\n","    if reconstructed_checked.duplicated(\n","        subset=[\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ).any():\n","        raise AssertionError(\n","            \"Reconstructed REC data contains duplicate \"\n","            \"Build-Test pairs.\"\n","        )\n","\n","\n","    requested_checked[\n","        \"_RequestedRowOrder\"\n","    ] = np.arange(\n","        len(requested_checked),\n","        dtype=np.int64,\n","    )\n","\n","\n","    aligned = (\n","        requested_checked\n","        .merge(\n","            reconstructed_checked[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    *VERDICT_DEPENDENT_REC_COLUMNS,\n","                ]\n","            ],\n","            on=[\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","            indicator=True,\n","        )\n","        .sort_values(\n","            \"_RequestedRowOrder\",\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    if not (\n","        aligned[\n","            \"_merge\"\n","        ] == \"both\"\n","    ).all():\n","        raise AssertionError(\n","            \"At least one fixed model-ready row did not \"\n","            \"receive reconstructed REC features.\"\n","        )\n","\n","\n","    return aligned[\n","        VERDICT_DEPENDENT_REC_COLUMNS\n","    ].copy()\n","\n","\n","# ---------------------------------------------------------\n","# 12. Map noisy raw verdicts to fixed model rows\n","# ---------------------------------------------------------\n","\n","def extract_model_ready_verdicts(\n","    noisy_execution_history,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Return one noisy raw verdict for every fixed\n","    model-ready Build-Test training row.\n","    \"\"\"\n","\n","    raw_verdict_rows = (\n","        noisy_execution_history[\n","            [\n","                \"build\",\n","                \"test\",\n","                \"verdict\",\n","            ]\n","        ]\n","        .copy()\n","        .rename(\n","            columns={\n","                \"build\":\n","                    \"Build\",\n","\n","                \"test\":\n","                    \"Test\",\n","\n","                \"verdict\":\n","                    \"NoisyVerdict\",\n","            }\n","        )\n","    )\n","\n","\n","    raw_verdict_rows[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        raw_verdict_rows[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    raw_verdict_rows[\n","        \"Test\"\n","    ] = (\n","        raw_verdict_rows[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    requested_checked = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested_checked[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        requested_checked[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    requested_checked[\n","        \"Test\"\n","    ] = (\n","        requested_checked[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    requested_checked[\n","        \"_RequestedRowOrder\"\n","    ] = np.arange(\n","        len(requested_checked),\n","        dtype=np.int64,\n","    )\n","\n","\n","    requested_keys = (\n","        requested_checked[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .drop_duplicates()\n","    )\n","\n","\n","    relevant_raw_rows = (\n","        raw_verdict_rows\n","        .merge(\n","            requested_keys,\n","            on=[\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            how=\"inner\",\n","            validate=\"many_to_one\",\n","        )\n","    )\n","\n","\n","    raw_pair_counts = (\n","        relevant_raw_rows\n","        .groupby(\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            sort=False,\n","        )\n","        .size()\n","        .rename(\n","            \"RawRows\"\n","        )\n","        .reset_index()\n","    )\n","\n","\n","    requested_with_counts = (\n","        requested_keys\n","        .merge(\n","            raw_pair_counts,\n","            on=[\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","    )\n","\n","\n","    requested_with_counts[\n","        \"RawRows\"\n","    ] = (\n","        requested_with_counts[\n","            \"RawRows\"\n","        ]\n","        .fillna(0)\n","        .astype(int)\n","    )\n","\n","\n","    invalid_multiplicity = (\n","        requested_with_counts[\n","            requested_with_counts[\n","                \"RawRows\"\n","            ] != 1\n","        ]\n","    )\n","\n","\n","    if len(invalid_multiplicity) \u003e 0:\n","        display(\n","            invalid_multiplicity.head(20)\n","        )\n","\n","        raise AssertionError(\n","            \"Each fixed model-ready training row must \"\n","            \"map to exactly one raw execution row.\"\n","        )\n","\n","\n","    aligned = (\n","        requested_checked\n","        .merge(\n","            relevant_raw_rows,\n","            on=[\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","            indicator=True,\n","        )\n","        .sort_values(\n","            \"_RequestedRowOrder\",\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    if not (\n","        aligned[\n","            \"_merge\"\n","        ] == \"both\"\n","    ).all():\n","        raise AssertionError(\n","            \"A fixed model-ready training row could not \"\n","            \"be linked to a noisy raw verdict.\"\n","        )\n","\n","\n","    return (\n","        aligned[\n","            \"NoisyVerdict\"\n","        ]\n","        .astype(\"int8\")\n","        .reset_index(drop=True)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. Build one noisy fixed-instance training dataset\n","# ---------------------------------------------------------\n","\n","def create_noisy_model_training_data(\n","    clean_model_training_data,\n","    noisy_execution_history,\n","):\n","    \"\"\"\n","    Fixed-instance training design.\n","\n","    Preserve:\n","        - Build-Test row cohort\n","        - all non-REC predictors\n","        - six age/duration REC features\n","\n","    Replace:\n","        - 13 verdict-dependent REC features\n","        - training verdict\n","    \"\"\"\n","\n","    noisy_model_data = (\n","        clean_model_training_data.copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested_rows = (\n","        noisy_model_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","\n","    reconstructed = (\n","        reconstruct_verdict_dependent_rec_features(\n","            execution_history=(\n","                noisy_execution_history\n","            ),\n","\n","            requested_rows=(\n","                requested_rows\n","            ),\n","\n","            recent_window=(\n","                RECENT_WINDOW\n","            ),\n","        )\n","    )\n","\n","\n","    aligned_features = (\n","        align_reconstructed_verdict_features(\n","            reconstructed=(\n","                reconstructed\n","            ),\n","\n","            requested_rows=(\n","                requested_rows\n","            ),\n","        )\n","    )\n","\n","\n","    noisy_model_data.loc[\n","        :,\n","        VERDICT_DEPENDENT_REC_COLUMNS,\n","    ] = aligned_features.to_numpy()\n","\n","\n","    noisy_model_data[\n","        \"Verdict\"\n","    ] = (\n","        extract_model_ready_verdicts(\n","            noisy_execution_history=(\n","                noisy_execution_history\n","            ),\n","\n","            requested_rows=(\n","                requested_rows\n","            ),\n","        )\n","        .to_numpy()\n","    )\n","\n","\n","    # Fixed row cohort must remain unchanged.\n","    if not np.array_equal(\n","        noisy_model_data[\n","            \"Build\"\n","        ].astype(int).to_numpy(),\n","\n","        clean_model_training_data[\n","            \"Build\"\n","        ].astype(int).to_numpy(),\n","    ):\n","        raise AssertionError(\n","            \"The fixed training Build cohort changed.\"\n","        )\n","\n","\n","    if not np.array_equal(\n","        noisy_model_data[\n","            \"Test\"\n","        ].astype(str).to_numpy(),\n","\n","        clean_model_training_data[\n","            \"Test\"\n","        ].astype(str).to_numpy(),\n","    ):\n","        raise AssertionError(\n","            \"The fixed training Test cohort changed.\"\n","        )\n","\n","\n","    # Six noise-independent REC features must remain exact.\n","    for feature in (\n","        NOISE_INDEPENDENT_REC_COLUMNS\n","    ):\n","        original_values = pd.to_numeric(\n","            clean_model_training_data[\n","                feature\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        noisy_values = pd.to_numeric(\n","            noisy_model_data[\n","                feature\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        if not np.all(\n","            np.isclose(\n","                original_values,\n","                noisy_values,\n","                rtol=0.0,\n","                atol=0.0,\n","                equal_nan=True,\n","            )\n","        ):\n","            raise AssertionError(\n","                \"A noise-independent REC feature changed: \"\n","                f\"{feature}\"\n","            )\n","\n","\n","    return noisy_model_data\n","\n","\n","# ---------------------------------------------------------\n","# 14. APFD and APFDc helpers\n","# ---------------------------------------------------------\n","\n","def calculate_apfd(\n","    actual_failures,\n","):\n","    \"\"\"\n","    APFD for an already-ranked build.\n","\n","    actual_failures:\n","        1 = failing execution\n","        0 = passing execution\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","\n","    number_of_tests = len(\n","        failures\n","    )\n","\n","\n","    number_of_failures = int(\n","        failures.sum()\n","    )\n","\n","\n","    if number_of_tests == 0:\n","        return np.nan\n","\n","\n","    if number_of_failures == 0:\n","        return np.nan\n","\n","\n","    failure_ranks = (\n","        np.flatnonzero(\n","            failures == 1\n","        )\n","        + 1\n","    )\n","\n","\n","    apfd = (\n","        1.0\n","        - failure_ranks.sum()\n","        / (\n","            number_of_tests\n","            * number_of_failures\n","        )\n","        + 1.0\n","        / (\n","            2.0\n","            * number_of_tests\n","        )\n","    )\n","\n","\n","    return float(\n","        apfd\n","    )\n","\n","\n","def calculate_apfdc(\n","    actual_failures,\n","    durations,\n","):\n","    \"\"\"\n","    Cost-aware APFD using midpoint failure detection.\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","\n","    durations = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","\n","    if len(failures) != len(durations):\n","        raise ValueError(\n","            \"actual_failures and durations must have \"\n","            \"the same length.\"\n","        )\n","\n","\n","    if len(failures) == 0:\n","        return np.nan\n","\n","\n","    if failures.sum() == 0:\n","        return np.nan\n","\n","\n","    if not np.isfinite(\n","        durations\n","    ).all():\n","        raise ValueError(\n","            \"Durations contain missing or infinite values.\"\n","        )\n","\n","\n","    if (\n","        durations \u003c 0\n","    ).any():\n","        raise ValueError(\n","            \"Durations cannot be negative.\"\n","        )\n","\n","\n","    total_duration = float(\n","        durations.sum()\n","    )\n","\n","\n","    if total_duration \u003c= 0:\n","        return np.nan\n","\n","\n","    cumulative_before = np.concatenate([\n","        np.array(\n","            [0.0]\n","        ),\n","        np.cumsum(\n","            durations\n","        )[:-1],\n","    ])\n","\n","\n","    failure_mask = (\n","        failures == 1\n","    )\n","\n","\n","    midpoint_detection_times = (\n","        cumulative_before[\n","            failure_mask\n","        ]\n","        + 0.5\n","        * durations[\n","            failure_mask\n","        ]\n","    )\n","\n","\n","    apfdc = (\n","        1.0\n","        - np.mean(\n","            midpoint_detection_times\n","            / total_duration\n","        )\n","    )\n","\n","\n","    return float(\n","        apfdc\n","    )\n","\n","\n","# Compatibility aliases for the runner.\n","compute_apfd = calculate_apfd\n","compute_apfdc = calculate_apfdc\n","\n","\n","# ---------------------------------------------------------\n","# 15. Columns that must never change under noise\n","# ---------------------------------------------------------\n","\n","PRESERVED_MODEL_COLUMNS = [\n","    column\n","    for column in clean_model_training_data.columns\n","    if column not in (\n","        [\n","            \"Verdict\",\n","        ]\n","        + VERDICT_DEPENDENT_REC_COLUMNS\n","    )\n","]\n","\n","\n","clean_preserved_columns_hash = (\n","    dataframe_sha256(\n","        clean_model_training_data[\n","            PRESERVED_MODEL_COLUMNS\n","        ]\n","    )\n",")\n","\n","\n","clean_model_pair_hash = (\n","    dataframe_sha256(\n","        clean_model_training_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","    )\n",")\n","\n","\n","raw_identity_columns = [\n","    \"build\",\n","    \"test\",\n","    \"build_order\",\n","    \"partition\",\n","]\n","\n","\n","if \"job\" in clean_training_history.columns:\n","    raw_identity_columns.append(\n","        \"job\"\n","    )\n","\n","\n","clean_raw_identity_hash = (\n","    dataframe_sha256(\n","        clean_training_history[\n","            raw_identity_columns\n","        ]\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 16. Generate and validate seed-1 nested conditions\n","# ---------------------------------------------------------\n","\n","seed_one_outputs = {}\n","condition_summary_records = []\n","\n","\n","for noise_level in NOISE_LEVELS:\n","    (\n","        noisy_history,\n","        manifest,\n","        noise_summary,\n","    ) = inject_training_verdict_noise(\n","        execution_history=(\n","            clean_training_history\n","        ),\n","\n","        noise_percent=(\n","            noise_level\n","        ),\n","\n","        repetition_seed=1,\n","    )\n","\n","\n","    if len(noisy_history) != len(\n","        clean_training_history\n","    ):\n","        raise AssertionError(\n","            \"Noise injection changed raw training \"\n","            \"row count.\"\n","        )\n","\n","\n","    if len(manifest) != len(\n","        clean_training_history\n","    ):\n","        raise AssertionError(\n","            \"Noise manifest row count mismatch.\"\n","        )\n","\n","\n","    if dataframe_sha256(\n","        noisy_history[\n","            raw_identity_columns\n","        ]\n","    ) != clean_raw_identity_hash:\n","        raise AssertionError(\n","            \"Noise injection changed raw row identities.\"\n","        )\n","\n","\n","    expected_flip_mask = (\n","        manifest[\n","            \"FlipUniform\"\n","        ].to_numpy(dtype=float)\n","        \u003c float(noise_level) / 100.0\n","    )\n","\n","\n","    if not np.array_equal(\n","        expected_flip_mask,\n","        manifest[\n","            \"Flipped\"\n","        ].to_numpy(dtype=bool),\n","    ):\n","        raise AssertionError(\n","            \"The stored flip mask does not match \"\n","            \"the common-uniform threshold.\"\n","        )\n","\n","\n","    noisy_model_data = (\n","        create_noisy_model_training_data(\n","            clean_model_training_data=(\n","                clean_model_training_data\n","            ),\n","\n","            noisy_execution_history=(\n","                noisy_history\n","            ),\n","        )\n","    )\n","\n","\n","    if len(noisy_model_data) != 2028:\n","        raise AssertionError(\n","            \"Noise changed the fixed model-ready \"\n","            \"training row count.\"\n","        )\n","\n","\n","    if dataframe_sha256(\n","        noisy_model_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","    ) != clean_model_pair_hash:\n","        raise AssertionError(\n","            \"Noise changed the fixed model-ready \"\n","            \"Build-Test cohort.\"\n","        )\n","\n","\n","    if dataframe_sha256(\n","        noisy_model_data[\n","            PRESERVED_MODEL_COLUMNS\n","        ]\n","    ) != clean_preserved_columns_hash:\n","        raise AssertionError(\n","            \"Noise changed a preserved model column.\"\n","        )\n","\n","\n","    expected_noisy_labels = (\n","        extract_model_ready_verdicts(\n","            noisy_execution_history=(\n","                noisy_history\n","            ),\n","\n","            requested_rows=(\n","                clean_model_training_data[\n","                    [\n","                        \"Build\",\n","                        \"Test\",\n","                    ]\n","                ]\n","            ),\n","        )\n","    )\n","\n","\n","    label_alignment_mismatches = int(\n","        (\n","            noisy_model_data[\n","                \"Verdict\"\n","            ].astype(int).to_numpy()\n","            != expected_noisy_labels\n","            .astype(int).to_numpy()\n","        ).sum()\n","    )\n","\n","\n","    if label_alignment_mismatches != 0:\n","        raise AssertionError(\n","            \"A model-ready training label does not match \"\n","            \"its corrupted raw execution verdict.\"\n","        )\n","\n","\n","    verdict_feature_changes = 0\n","\n","\n","    for feature in (\n","        VERDICT_DEPENDENT_REC_COLUMNS\n","    ):\n","        clean_values = pd.to_numeric(\n","            clean_model_training_data[\n","                feature\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        noisy_values = pd.to_numeric(\n","            noisy_model_data[\n","                feature\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        verdict_feature_changes += int(\n","            (\n","                ~np.isclose(\n","                    clean_values,\n","                    noisy_values,\n","                    rtol=1e-10,\n","                    atol=1e-12,\n","                    equal_nan=True,\n","                )\n","            ).sum()\n","        )\n","\n","\n","    condition_summary_records.append({\n","        **noise_summary,\n","\n","        \"ModelTrainingRows\":\n","            int(\n","                len(\n","                    noisy_model_data\n","                )\n","            ),\n","\n","        \"ModelTrainingPasses\":\n","            int(\n","                (\n","                    noisy_model_data[\n","                        \"Verdict\"\n","                    ] == 0\n","                ).sum()\n","            ),\n","\n","        \"ModelTrainingFailures\":\n","            int(\n","                (\n","                    noisy_model_data[\n","                        \"Verdict\"\n","                    ] != 0\n","                ).sum()\n","            ),\n","\n","        \"LabelAlignmentMismatches\":\n","            label_alignment_mismatches,\n","\n","        \"VerdictDependentRECValuesChanged\":\n","            int(\n","                verdict_feature_changes\n","            ),\n","\n","        \"PreservedColumnsUnchanged\":\n","            True,\n","\n","        \"FixedInstanceCohortUnchanged\":\n","            True,\n","    })\n","\n","\n","    seed_one_outputs[\n","        int(noise_level)\n","    ] = {\n","        \"history\":\n","            noisy_history,\n","\n","        \"manifest\":\n","            manifest,\n","\n","        \"summary\":\n","            noise_summary,\n","\n","        \"model_data\":\n","            noisy_model_data,\n","    }\n","\n","\n","condition_summary = pd.DataFrame(\n","    condition_summary_records\n",")\n","\n","\n","# Non-zero noise should affect at least some\n","# verdict-dependent feature values.\n","if int(\n","    condition_summary.loc[\n","        condition_summary[\n","            \"NoisePercentRequested\"\n","        ] == 5,\n","        \"VerdictDependentRECValuesChanged\",\n","    ].iloc[0]\n",") == 0:\n","    raise AssertionError(\n","        \"The 5% condition did not change any \"\n","        \"verdict-dependent REC values.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 17. Validate nested masks and common random streams\n","# ---------------------------------------------------------\n","\n","nested_mask_records = []\n","\n","\n","reference_manifest = (\n","    seed_one_outputs[\n","        NOISE_LEVELS[0]\n","    ][\n","        \"manifest\"\n","    ]\n",")\n","\n","\n","for noise_level in NOISE_LEVELS:\n","    current_manifest = (\n","        seed_one_outputs[\n","            noise_level\n","        ][\n","            \"manifest\"\n","        ]\n","    )\n","\n","\n","    if not np.array_equal(\n","        reference_manifest[\n","            \"NoiseRowID\"\n","        ].to_numpy(),\n","\n","        current_manifest[\n","            \"NoiseRowID\"\n","        ].to_numpy(),\n","    ):\n","        raise AssertionError(\n","            \"Noise row identity changed between levels.\"\n","        )\n","\n","\n","    if not np.array_equal(\n","        reference_manifest[\n","            \"FlipUniform\"\n","        ].to_numpy(dtype=float),\n","\n","        current_manifest[\n","            \"FlipUniform\"\n","        ].to_numpy(dtype=float),\n","    ):\n","        raise AssertionError(\n","            \"Common flip uniforms changed between \"\n","            \"noise levels.\"\n","        )\n","\n","\n","    if not np.array_equal(\n","        reference_manifest[\n","            \"SampledFailureSubtype\"\n","        ].to_numpy(dtype=int),\n","\n","        current_manifest[\n","            \"SampledFailureSubtype\"\n","        ].to_numpy(dtype=int),\n","    ):\n","        raise AssertionError(\n","            \"Failure subtype samples changed between \"\n","            \"noise levels for the same seed.\"\n","        )\n","\n","\n","for lower_level, higher_level in zip(\n","    NOISE_LEVELS[:-1],\n","    NOISE_LEVELS[1:],\n","):\n","    lower_mask = (\n","        seed_one_outputs[\n","            lower_level\n","        ][\n","            \"manifest\"\n","        ][\n","            \"Flipped\"\n","        ]\n","        .to_numpy(dtype=bool)\n","    )\n","\n","\n","    higher_mask = (\n","        seed_one_outputs[\n","            higher_level\n","        ][\n","            \"manifest\"\n","        ][\n","            \"Flipped\"\n","        ]\n","        .to_numpy(dtype=bool)\n","    )\n","\n","\n","    nested_violations = int(\n","        (\n","            lower_mask\n","            \u0026 ~higher_mask\n","        ).sum()\n","    )\n","\n","\n","    nested_mask_records.append({\n","        \"LowerNoisePercent\":\n","            int(lower_level),\n","\n","        \"HigherNoisePercent\":\n","            int(higher_level),\n","\n","        \"LowerFlippedRows\":\n","            int(\n","                lower_mask.sum()\n","            ),\n","\n","        \"HigherFlippedRows\":\n","            int(\n","                higher_mask.sum()\n","            ),\n","\n","        \"NestedMaskViolations\":\n","            nested_violations,\n","\n","        \"Nested\":\n","            bool(\n","                nested_violations == 0\n","            ),\n","    })\n","\n","\n","nested_mask_audit = pd.DataFrame(\n","    nested_mask_records\n",")\n","\n","\n","if int(\n","    nested_mask_audit[\n","        \"NestedMaskViolations\"\n","    ].sum()\n",") != 0:\n","    raise AssertionError(\n","        \"Noise masks are not nested.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 18. Validate same-seed reproducibility\n","# ---------------------------------------------------------\n","\n","(\n","    five_history_repeat,\n","    five_manifest_repeat,\n","    five_summary_repeat,\n",") = inject_training_verdict_noise(\n","    execution_history=(\n","        clean_training_history\n","    ),\n","\n","    noise_percent=5,\n","\n","    repetition_seed=1,\n",")\n","\n","\n","five_history_original = (\n","    seed_one_outputs[\n","        5\n","    ][\n","        \"history\"\n","    ]\n",")\n","\n","\n","five_manifest_original = (\n","    seed_one_outputs[\n","        5\n","    ][\n","        \"manifest\"\n","    ]\n",")\n","\n","\n","same_seed_history_reproducible = (\n","    dataframe_sha256(\n","        five_history_original\n","    )\n","    == dataframe_sha256(\n","        five_history_repeat\n","    )\n",")\n","\n","\n","same_seed_manifest_reproducible = (\n","    dataframe_sha256(\n","        five_manifest_original\n","    )\n","    == dataframe_sha256(\n","        five_manifest_repeat\n","    )\n",")\n","\n","\n","if not same_seed_history_reproducible:\n","    raise AssertionError(\n","        \"The same seed did not reproduce the same \"\n","        \"corrupted history.\"\n","    )\n","\n","\n","if not same_seed_manifest_reproducible:\n","    raise AssertionError(\n","        \"The same seed did not reproduce the same \"\n","        \"noise manifest.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 19. Validate different-seed independence\n","# ---------------------------------------------------------\n","\n","(\n","    five_history_seed_two,\n","    five_manifest_seed_two,\n","    five_summary_seed_two,\n",") = inject_training_verdict_noise(\n","    execution_history=(\n","        clean_training_history\n","    ),\n","\n","    noise_percent=5,\n","\n","    repetition_seed=2,\n",")\n","\n","\n","different_seed_uniforms_differ = not np.array_equal(\n","    five_manifest_original[\n","        \"FlipUniform\"\n","    ].to_numpy(dtype=float),\n","\n","    five_manifest_seed_two[\n","        \"FlipUniform\"\n","    ].to_numpy(dtype=float),\n",")\n","\n","\n","different_seed_masks_differ = not np.array_equal(\n","    five_manifest_original[\n","        \"Flipped\"\n","    ].to_numpy(dtype=bool),\n","\n","    five_manifest_seed_two[\n","        \"Flipped\"\n","    ].to_numpy(dtype=bool),\n",")\n","\n","\n","if not different_seed_uniforms_differ:\n","    raise AssertionError(\n","        \"Different seeds produced identical uniforms.\"\n","    )\n","\n","\n","if not different_seed_masks_differ:\n","    raise AssertionError(\n","        \"Different seeds produced identical flip masks.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 20. Validate 0% exact clean reproduction\n","# ---------------------------------------------------------\n","\n","zero_noise_history = (\n","    seed_one_outputs[\n","        0\n","    ][\n","        \"history\"\n","    ]\n",")\n","\n","\n","zero_noise_manifest = (\n","    seed_one_outputs[\n","        0\n","    ][\n","        \"manifest\"\n","    ]\n",")\n","\n","\n","zero_noise_model_data = (\n","    seed_one_outputs[\n","        0\n","    ][\n","        \"model_data\"\n","    ]\n",")\n","\n","\n","if int(\n","    zero_noise_manifest[\n","        \"Flipped\"\n","    ].sum()\n",") != 0:\n","    raise AssertionError(\n","        \"The 0% condition flipped verdicts.\"\n","    )\n","\n","\n","zero_raw_verdict_mismatches = int(\n","    (\n","        zero_noise_history[\n","            \"verdict\"\n","        ].astype(int).to_numpy()\n","        != clean_training_history[\n","            \"verdict\"\n","        ].astype(int).to_numpy()\n","    ).sum()\n",")\n","\n","\n","zero_label_mismatches = int(\n","    (\n","        zero_noise_model_data[\n","            \"Verdict\"\n","        ].astype(int).to_numpy()\n","        != clean_model_training_data[\n","            \"Verdict\"\n","        ].astype(int).to_numpy()\n","    ).sum()\n",")\n","\n","\n","zero_verdict_rec_mismatches = 0\n","\n","\n","for feature in (\n","    VERDICT_DEPENDENT_REC_COLUMNS\n","):\n","    zero_verdict_rec_mismatches += int(\n","        (\n","            ~np.isclose(\n","                pd.to_numeric(\n","                    zero_noise_model_data[\n","                        feature\n","                    ],\n","                    errors=\"coerce\",\n","                ).to_numpy(dtype=float),\n","\n","                pd.to_numeric(\n","                    clean_model_training_data[\n","                        feature\n","                