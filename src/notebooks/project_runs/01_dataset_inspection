oInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '\u003ca target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb\u003edata table notebook\u003c/a\u003e'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","\n","    \u003c/div\u003e\n","  \u003c/div\u003e\n"],"text/plain":["     Build  BuildOrder Partition                                 RawCommit  \\\n","0  1724328          12  training  0497786af900a66b266506d924288ef49d749962   \n","1  5889934         143  training  50dd1ea95770e755ddb1d326d571a0a4b1edbb9e   \n","\n","  MatchStatus  CandidateCount  RawExecutionRows  RawFailureExecutions  \\\n","0   UNMATCHED               0                24                     0   \n","1   UNMATCHED               0                52                     0   \n","\n","   ModelReadyRows  ModelReadyFailures  \n","0               0                   0  \n","1               0                   0  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Mapping report:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/thinkaurelius__titan/titan_preflight/titan_entity_mapping_report.json\n","\n","REVIEW REQUIRED: Titan mapping completed, but unmatched commits must be examined before REC reconstruction.\n"]}],"source":["# =========================================================\n","# PROJECT 5: THINKAURELIUS TITAN\n","# FINAL CORRECTED BUILD → COMMIT → ENTITY MAPPING\n","#\n","# Titan id_map.csv schema:\n","#   key   = entity/file name\n","#   value = EntityId\n","# =========================================================\n","\n","from pathlib import Path\n","import ast\n","import json\n","import re\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Confirm required runtime variables\n","# ---------------------------------------------------------\n","\n","REQUIRED_VARIABLES = [\n","    \"PROJECT_NUMBER\",\n","    \"PROJECT_NAME\",\n","    \"PROJECT_SLUG\",\n","    \"PROJECT_PATH\",\n","    \"PROJECT_AGGREGATED_RESULTS\",\n","    \"builds_raw\",\n","    \"builds\",\n","    \"exe_for_rec\",\n","    \"dataset_with_order\",\n","    \"entity_change_history\",\n","    \"id_map\",\n","]\n","\n","\n","missing_variables = [\n","    variable_name\n","    for variable_name in REQUIRED_VARIABLES\n","    if variable_name not in globals()\n","]\n","\n","\n","if missing_variables:\n","    raise RuntimeError(\n","        \"Required Titan variables are missing:\\n\"\n","        + \"\\n\".join(missing_variables)\n","    )\n","\n","\n","if PROJECT_NUMBER != 5:\n","    raise AssertionError(\n","        f\"Expected Project 5, found Project {PROJECT_NUMBER}.\"\n","    )\n","\n","\n","if PROJECT_NAME != \"thinkaurelius@titan\":\n","    raise AssertionError(\n","        \"This mapping cell is only for thinkaurelius@titan.\"\n","    )\n","\n","\n","MAPPING_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_preflight\"\n",")\n","\n","MAPPING_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","print(\n","    \"=== TITAN FINAL BUILD-COMMIT-ENTITY MAPPING ===\"\n",")\n","\n","print(\n","    \"builds.csv columns:\",\n","    builds_raw.columns.tolist(),\n",")\n","\n","print(\n","    \"entity_change_history.csv columns:\",\n","    entity_change_history.columns.tolist(),\n",")\n","\n","print(\n","    \"id_map.csv columns:\",\n","    id_map.columns.tolist(),\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Use Titan's verified raw schema\n","# ---------------------------------------------------------\n","\n","required_build_columns = {\n","    \"id\",\n","    \"commits\",\n","    \"started_at\",\n","}\n","\n","required_entity_history_columns = {\n","    \"EntityId\",\n","    \"Commit\",\n","}\n","\n","required_id_map_columns = {\n","    \"key\",\n","    \"value\",\n","}\n","\n","\n","if not required_build_columns.issubset(\n","    set(builds_raw.columns)\n","):\n","    raise KeyError(\n","        \"Titan builds.csv schema changed.\\n\"\n","        f\"Observed: {builds_raw.columns.tolist()}\"\n","    )\n","\n","\n","if not required_entity_history_columns.issubset(\n","    set(entity_change_history.columns)\n","):\n","    raise KeyError(\n","        \"Titan entity_change_history.csv schema changed.\\n\"\n","        f\"Observed: {entity_change_history.columns.tolist()}\"\n","    )\n","\n","\n","if not required_id_map_columns.issubset(\n","    set(id_map.columns)\n","):\n","    raise KeyError(\n","        \"Titan id_map.csv schema changed.\\n\"\n","        f\"Observed: {id_map.columns.tolist()}\"\n","    )\n","\n","\n","BUILDS_RAW_ID_COLUMN = \"id\"\n","BUILDS_COMMITS_COLUMN = \"commits\"\n","\n","ENTITY_HISTORY_COMMIT_COLUMN = \"Commit\"\n","ENTITY_HISTORY_ENTITY_COLUMN = \"EntityId\"\n","\n","# Correct Titan orientation:\n","ID_MAP_NAME_COLUMN = \"key\"\n","ID_MAP_ID_COLUMN = \"value\"\n","\n","\n","print(\n","    \"\\nVerified schema:\"\n",")\n","\n","print(\n","    \"Build ID column:\",\n","    BUILDS_RAW_ID_COLUMN,\n",")\n","\n","print(\n","    \"Build commits column:\",\n","    BUILDS_COMMITS_COLUMN,\n",")\n","\n","print(\n","    \"Entity-history commit column:\",\n","    ENTITY_HISTORY_COMMIT_COLUMN,\n",")\n","\n","print(\n","    \"Entity-history entity-ID column:\",\n","    ENTITY_HISTORY_ENTITY_COLUMN,\n",")\n","\n","print(\n","    \"ID-map entity-name column:\",\n","    ID_MAP_NAME_COLUMN,\n",")\n","\n","print(\n","    \"ID-map entity-ID column:\",\n","    ID_MAP_ID_COLUMN,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Canonical conversion helpers\n","# ---------------------------------------------------------\n","\n","COMMIT_PATTERN = re.compile(\n","    r\"(?\u003c![0-9a-fA-F])\"\n","    r\"([0-9a-fA-F]{7,40})\"\n","    r\"(?![0-9a-fA-F])\"\n",")\n","\n","\n","def is_missing_scalar(value):\n","    if value is None:\n","        return True\n","\n","    if isinstance(\n","        value,\n","        (\n","            float,\n","            np.floating,\n","        ),\n","    ):\n","        return bool(\n","            np.isnan(value)\n","        )\n","\n","    return False\n","\n","\n","def canonical_entity_id(value):\n","    \"\"\"\n","    Convert EntityId values to stable strings.\n","\n","    Examples:\n","    25, 25.0 and \"25\" become \"25\".\n","    \"\"\"\n","\n","    if is_missing_scalar(value):\n","        return None\n","\n","\n","    if isinstance(\n","        value,\n","        (\n","            int,\n","            np.integer,\n","        ),\n","    ):\n","        return str(int(value))\n","\n","\n","    if isinstance(\n","        value,\n","        (\n","            float,\n","            np.floating,\n","        ),\n","    ):\n","        if not np.isfinite(value):\n","            return None\n","\n","        if float(value).is_integer():\n","            return str(int(value))\n","\n","\n","    text = str(value).strip()\n","\n","\n","    if not text:\n","        return None\n","\n","\n","    try:\n","        numeric_value = float(text)\n","\n","        if (\n","            np.isfinite(numeric_value)\n","            and numeric_value.is_integer()\n","        ):\n","            return str(\n","                int(numeric_value)\n","            )\n","\n","    except Exception:\n","        pass\n","\n","\n","    return text\n","\n","\n","def canonical_commit(value):\n","    \"\"\"\n","    Extract one canonical lowercase Git hash.\n","    \"\"\"\n","\n","    if is_missing_scalar(value):\n","        return None\n","\n","\n","    text = str(value).strip()\n","\n","\n","    if not text:\n","        return None\n","\n","\n","    matches = COMMIT_PATTERN.findall(\n","        text\n","    )\n","\n","\n","    if not matches:\n","        return None\n","\n","\n","    return max(\n","        matches,\n","        key=len,\n","    ).lower()\n","\n","\n","def extract_commit_hashes(value):\n","    \"\"\"\n","    Extract all Git hashes from one builds.csv commits\n","    value while preserving order.\n","    \"\"\"\n","\n","    if is_missing_scalar(value):\n","        return []\n","\n","\n","    if isinstance(value, dict):\n","        collected = []\n","\n","        preferred_keys = [\n","            \"sha\",\n","            \"hash\",\n","            \"commit\",\n","            \"commit_id\",\n","            \"id\",\n","        ]\n","\n","        for key in preferred_keys:\n","            if key in value:\n","                collected.extend(\n","                    extract_commit_hashes(\n","                        value[key]\n","                    )\n","                )\n","\n","        if not collected:\n","            for nested_value in value.values():\n","                collected.extend(\n","                    extract_commit_hashes(\n","                        nested_value\n","                    )\n","                )\n","\n","        return list(\n","            dict.fromkeys(collected)\n","        )\n","\n","\n","    if isinstance(\n","        value,\n","        (\n","            list,\n","            tuple,\n","            set,\n","            np.ndarray,\n","        ),\n","    ):\n","        collected = []\n","\n","        for item in value:\n","            collected.extend(\n","                extract_commit_hashes(item)\n","            )\n","\n","        return list(\n","            dict.fromkeys(collected)\n","        )\n","\n","\n","    text = str(value).strip()\n","\n","\n","    if not text:\n","        return []\n","\n","\n","    if text[0] in \"[{(\":\n","        try:\n","            parsed_value = ast.literal_eval(\n","                text\n","            )\n","\n","            parsed_hashes = (\n","                extract_commit_hashes(\n","                    parsed_value\n","                )\n","            )\n","\n","            if parsed_hashes:\n","                return parsed_hashes\n","\n","        except Exception:\n","            pass\n","\n","\n","    hashes = [\n","        match.lower()\n","        for match in COMMIT_PATTERN.findall(\n","            text\n","        )\n","    ]\n","\n","\n","    return list(\n","        dict.fromkeys(hashes)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Validate the corrected id_map orientation\n","# ---------------------------------------------------------\n","\n","entity_history_id_series = (\n","    entity_change_history[\n","        ENTITY_HISTORY_ENTITY_COLUMN\n","    ]\n","    .apply(canonical_entity_id)\n",")\n","\n","\n","entity_history_id_set = set(\n","    entity_history_id_series\n","    .dropna()\n","    .unique()\n",")\n","\n","\n","id_map_id_series = (\n","    id_map[\n","        ID_MAP_ID_COLUMN\n","    ]\n","    .apply(canonical_entity_id)\n",")\n","\n","\n","id_map_name_as_id_series = (\n","    id_map[\n","        ID_MAP_NAME_COLUMN\n","    ]\n","    .apply(canonical_entity_id)\n",")\n","\n","\n","id_map_id_set = set(\n","    id_map_id_series\n","    .dropna()\n","    .unique()\n",")\n","\n","\n","id_map_name_as_id_set = set(\n","    id_map_name_as_id_series\n","    .dropna()\n","    .unique()\n",")\n","\n","\n","correct_orientation_overlap = len(\n","    entity_history_id_set\n","    \u0026 id_map_id_set\n",")\n","\n","\n","reverse_orientation_overlap = len(\n","    entity_history_id_set\n","    \u0026 id_map_name_as_id_set\n",")\n","\n","\n","orientation_audit = pd.DataFrame([\n","    {\n","        \"CandidateIDColumn\":\n","            ID_MAP_ID_COLUMN,\n","\n","        \"CandidateNameColumn\":\n","            ID_MAP_NAME_COLUMN,\n","\n","        \"UniqueCandidateIDs\":\n","            len(id_map_id_set),\n","\n","        \"OverlapWithEntityHistory\":\n","            correct_orientation_overlap,\n","\n","        \"CoveragePercent\":\n","            (\n","                100.0\n","                * correct_orientation_overlap\n","                / len(entity_history_id_set)\n","            ),\n","    },\n","    {\n","        \"CandidateIDColumn\":\n","            ID_MAP_NAME_COLUMN,\n","\n","        \"CandidateNameColumn\":\n","            ID_MAP_ID_COLUMN,\n","\n","        \"UniqueCandidateIDs\":\n","            len(id_map_name_as_id_set),\n","\n","        \"OverlapWithEntityHistory\":\n","            reverse_orientation_overlap,\n","\n","        \"CoveragePercent\":\n","            (\n","                100.0\n","                * reverse_orientation_overlap\n","                / len(entity_history_id_set)\n","            ),\n","    },\n","])\n","\n","\n","print(\n","    \"\\nID-map orientation validation:\"\n",")\n","\n","display(\n","    orientation_audit\n",")\n","\n","\n","if correct_orientation_overlap == 0:\n","    raise AssertionError(\n","        \"id_map.value does not overlap with \"\n","        \"entity_change_history.EntityId.\"\n","    )\n","\n","\n","if correct_orientation_overlap \u003c= (\n","    reverse_orientation_overlap\n","):\n","    raise AssertionError(\n","        \"The corrected Titan id_map orientation \"\n","        \"could not be verified.\"\n","    )\n","\n","\n","if correct_orientation_overlap != len(\n","    entity_history_id_set\n","):\n","    raise AssertionError(\n","        \"Not all entity-history EntityIds exist in \"\n","        \"id_map.value.\\n\"\n","        f\"Entity-history IDs: {len(entity_history_id_set)}\\n\"\n","        f\"Matched IDs: {correct_orientation_overlap}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Canonicalise the complete ID map\n","# ---------------------------------------------------------\n","\n","id_map_canonical = pd.DataFrame({\n","    \"EntityName\":\n","        id_map[\n","            ID_MAP_NAME_COLUMN\n","        ].astype(str),\n","\n","    \"EntityID\":\n","        id_map[\n","            ID_MAP_ID_COLUMN\n","        ].apply(canonical_entity_id),\n","})\n","\n","\n","id_map_canonical = (\n","    id_map_canonical\n","    .dropna(\n","        subset=[\n","            \"EntityID\",\n","        ]\n","    )\n","    .drop_duplicates(\n","        subset=[\n","            \"EntityName\",\n","            \"EntityID\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","known_entity_ids = set(\n","    id_map_canonical[\n","        \"EntityID\"\n","    ].unique()\n",")\n","\n","\n","duplicate_entity_ids_in_id_map = int(\n","    id_map_canonical[\n","        \"EntityID\"\n","    ].duplicated().sum()\n",")\n","\n","\n","duplicate_entity_names_in_id_map = int(\n","    id_map_canonical[\n","        \"EntityName\"\n","    ].duplicated().sum()\n",")\n","\n","\n","entity_names_by_id = (\n","    id_map_canonical\n","    .groupby(\n","        \"EntityID\"\n","    )[\n","        \"EntityName\"\n","    ]\n","    .apply(\n","        lambda values:\n","            sorted(\n","                set(\n","                    values.astype(str)\n","                )\n","            )\n","    )\n","    .to_dict()\n",")\n","\n","\n","entity_ids_by_name = (\n","    id_map_canonical\n","    .groupby(\n","        \"EntityName\"\n","    )[\n","        \"EntityID\"\n","    ]\n","    .apply(\n","        lambda values:\n","            sorted(\n","                set(\n","                    values.astype(str)\n","                )\n","            )\n","    )\n","    .to_dict()\n",")\n","\n","\n","if len(known_entity_ids) == 0:\n","    raise AssertionError(\n","        \"No valid EntityIds were found in id_map.value.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Canonicalise entity-change history\n","# ---------------------------------------------------------\n","\n","entity_commit_pairs = pd.DataFrame({\n","    \"HistoryCommit\":\n","        entity_change_history[\n","            ENTITY_HISTORY_COMMIT_COLUMN\n","        ].apply(canonical_commit),\n","\n","    \"EntityID\":\n","        entity_change_history[\n","            ENTITY_HISTORY_ENTITY_COLUMN\n","        ].apply(canonical_entity_id),\n","})\n","\n","\n","entity_history_rows_missing_commit = int(\n","    entity_commit_pairs[\n","        \"HistoryCommit\"\n","    ].isna().sum()\n",")\n","\n","\n","entity_history_rows_missing_entity = int(\n","    entity_commit_pairs[\n","        \"EntityID\"\n","    ].isna().sum()\n",")\n","\n","\n","entity_commit_pairs = (\n","    entity_commit_pairs\n","    .dropna(\n","        subset=[\n","            \"HistoryCommit\",\n","            \"EntityID\",\n","        ]\n","    )\n","    .drop_duplicates(\n","        subset=[\n","            \"HistoryCommit\",\n","            \"EntityID\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","entity_history_commits = set(\n","    entity_commit_pairs[\n","        \"HistoryCommit\"\n","    ].unique()\n",")\n","\n","\n","entity_history_entity_ids = set(\n","    entity_commit_pairs[\n","        \"EntityID\"\n","    ].unique()\n",")\n","\n","\n","unknown_entity_history_ids = sorted(\n","    entity_history_entity_ids\n","    - known_entity_ids\n",")\n","\n","\n","if unknown_entity_history_ids:\n","    raise AssertionError(\n","        \"Some entity-history IDs are absent from \"\n","        \"id_map.value.\\n\"\n","        \"Examples:\\n\"\n","        + \"\\n\".join(\n","            unknown_entity_history_ids[:20]\n","        )\n","    )\n","\n","\n","if len(entity_history_commits) == 0:\n","    raise AssertionError(\n","        \"No valid commits were parsed from \"\n","        \"entity_change_history.csv.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Parse all build/commit pairs\n","# ---------------------------------------------------------\n","\n","canonical_build_metadata = (\n","    builds[\n","        [\n","            \"build\",\n","            \"build_order\",\n","            \"partition\",\n","        ]\n","    ]\n","    .drop_duplicates(\n","        subset=[\n","            \"build\",\n","        ]\n","    )\n","    .set_index(\"build\")\n",")\n","\n","\n","build_commit_records = []\n","\n","\n","for raw_row_number, build_row in (\n","    builds_raw\n","    .reset_index(drop=True)\n","    .iterrows()\n","):\n","\n","    build_id = int(\n","        pd.to_numeric(\n","            build_row[\n","                BUILDS_RAW_ID_COLUMN\n","            ],\n","            errors=\"raise\",\n","        )\n","    )\n","\n","\n","    if build_id not in (\n","        canonical_build_metadata.index\n","    ):\n","        raise AssertionError(\n","            \"A raw build is absent from the canonical \"\n","            f\"build table: {build_id}\"\n","        )\n","\n","\n","    raw_commits_value = build_row[\n","        BUILDS_COMMITS_COLUMN\n","    ]\n","\n","\n","    extracted_commits = (\n","        extract_commit_hashes(\n","            raw_commits_value\n","        )\n","    )\n","\n","\n","    for commit_position, commit_hash in enumerate(\n","        extracted_commits,\n","        start=1,\n","    ):\n","        build_commit_records.append({\n","            \"Build\":\n","                build_id,\n","\n","            \"BuildOrder\":\n","                int(\n","                    canonical_build_metadata.loc[\n","                        build_id,\n","                        \"build_order\",\n","                    ]\n","                ),\n","\n","            \"Partition\":\n","                str(\n","                    canonical_build_metadata.loc[\n","                        build_id,\n","                        \"partition\",\n","                    ]\n","                ),\n","\n","            \"RawBuildRow\":\n","                int(raw_row_number),\n","\n","            \"CommitPosition\":\n","                int(commit_position),\n","\n","            \"RawCommit\":\n","                commit_hash,\n","\n","            \"NormalizedCommit\":\n","                commit_hash.lower(),\n","        })\n","\n","\n","parsed_build_commits = pd.DataFrame(\n","    build_commit_records\n",")\n","\n","\n","if parsed_build_commits.empty:\n","    raise AssertionError(\n","        \"No commit hashes were parsed from builds.csv.\"\n","    )\n","\n","\n","parsed_build_commits = (\n","    parsed_build_commits\n","    .drop_duplicates(\n","        subset=[\n","            \"Build\",\n","            \"NormalizedCommit\",\n","        ],\n","        keep=\"first\",\n","    )\n","    .sort_values(\n","        [\n","            \"BuildOrder\",\n","            \"CommitPosition\",\n","            \"NormalizedCommit\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Match build commits to entity-history commits\n","# ---------------------------------------------------------\n","\n","entity_history_commit_list = sorted(\n","    entity_history_commits\n",")\n","\n","\n","def match_build_commit(build_commit):\n","    if build_commit in entity_history_commits:\n","        return {\n","            \"MatchedCommit\":\n","                build_commit,\n","\n","            \"MatchStatus\":\n","                \"EXACT\",\n","\n","            \"CandidateCount\":\n","                1,\n","\n","            \"CandidateCommits\":\n","                build_commit,\n","        }\n","\n","\n","    prefix_candidates = sorted({\n","        history_commit\n","        for history_commit\n","        in entity_history_commit_list\n","        if (\n","            history_commit.startswith(\n","                build_commit\n","            )\n","            or build_commit.startswith(\n","                history_commit\n","            )\n","        )\n","    })\n","\n","\n","    if len(prefix_candidates) == 1:\n","        return {\n","            \"MatchedCommit\":\n","                prefix_candidates[0],\n","\n","            \"MatchStatus\":\n","                \"UNIQUE_PREFIX\",\n","\n","            \"CandidateCount\":\n","                1,\n","\n","            \"CandidateCommits\":\n","                prefix_candidates[0],\n","        }\n","\n","\n","    if len(prefix_candidates) \u003e 1:\n","        return {\n","            \"MatchedCommit\":\n","                None,\n","\n","            \"MatchStatus\":\n","                \"AMBIGUOUS_PREFIX\",\n","\n","            \"CandidateCount\":\n","                len(prefix_candidates),\n","\n","            \"CandidateCommits\":\n","                \"|\".join(\n","                    prefix_candidates\n","                ),\n","        }\n","\n","\n","    return {\n","        \"MatchedCommit\":\n","            None,\n","\n","        \"MatchStatus\":\n","            \"UNMATCHED\",\n","\n","        \"CandidateCount\":\n","            0,\n","\n","        \"CandidateCommits\":\n","            \"\",\n","    }\n","\n","\n","commit_match_records = [\n","    match_build_commit(commit_hash)\n","    for commit_hash\n","    in parsed_build_commits[\n","        \"NormalizedCommit\"\n","    ]\n","]\n","\n","\n","build_commit_map = (\n","    parsed_build_commits.copy()\n",")\n","\n","\n","for output_column in [\n","    \"MatchedCommit\",\n","    \"MatchStatus\",\n","    \"CandidateCount\",\n","    \"CandidateCommits\",\n","]:\n","    build_commit_map[\n","        output_column\n","    ] = [\n","        record[\n","            output_column\n","        ]\n","        for record\n","        in commit_match_records\n","    ]\n","\n","\n","# ---------------------------------------------------------\n","# 9. Map matched commits to changed entities\n","# ---------------------------------------------------------\n","\n","matched_build_commits = (\n","    build_commit_map[\n","        build_commit_map[\n","            \"MatchedCommit\"\n","        ].notna()\n","    ]\n","    .copy()\n",")\n","\n","\n","build_entity_map = (\n","    matched_build_commits[\n","        [\n","            \"Build\",\n","            \"BuildOrder\",\n","            \"Partition\",\n","            \"RawCommit\",\n","            \"NormalizedCommit\",\n","            \"MatchedCommit\",\n","            \"MatchStatus\",\n","        ]\n","    ]\n","    .merge(\n","        entity_commit_pairs,\n","        left_on=\"MatchedCommit\",\n","        right_on=\"HistoryCommit\",\n","        how=\"inner\",\n","        validate=\"many_to_many\",\n","    )\n",")\n","\n","\n","build_entity_map = (\n","    build_entity_map[\n","        [\n","            \"Build\",\n","            \"BuildOrder\",\n","            \"Partition\",\n","            \"RawCommit\",\n","            \"NormalizedCommit\",\n","            \"MatchedCommit\",\n","            \"MatchStatus\",\n","            \"EntityID\",\n","        ]\n","    ]\n","    .drop_duplicates(\n","        subset=[\n","            \"Build\",\n","            \"MatchedCommit\",\n","            \"EntityID\",\n","        ]\n","    )\n","    .sort_values(\n","        [\n","            \"BuildOrder\",\n","            \"MatchedCommit\",\n","            \"EntityID\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# Compatibility alias used by later REC cells.\n","mapped_rows = (\n","    build_entity_map.copy()\n",")\n","\n","\n","mapped_entity_ids = set(\n","    build_entity_map[\n","        \"EntityID\"\n","    ].unique()\n",")\n","\n","\n","unknown_mapped_entity_ids = sorted(\n","    mapped_entity_ids\n","    - known_entity_ids\n",")\n","\n","\n","if unknown_mapped_entity_ids:\n","    raise AssertionError(\n","        \"Mapped EntityIds are absent from id_map.value.\\n\"\n","        \"Examples:\\n\"\n","        + \"\\n\".join(\n","            unknown_mapped_entity_ids[:20]\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Complete changed-entity dictionary\n","# ---------------------------------------------------------\n","\n","changed_entities_by_build = {\n","    int(build_id): set()\n","    for build_id\n","    in builds[\n","        \"build\"\n","    ].astype(int)\n","}\n","\n","\n","for build_id, entity_group in (\n","    build_entity_map.groupby(\"Build\")\n","):\n","    changed_entities_by_build[\n","        int(build_id)\n","    ] = set(\n","        entity_group[\n","            \"EntityID\"\n","        ].astype(str)\n","    )\n","\n","\n","if set(\n","    changed_entities_by_build.keys()\n",") != set(\n","    builds[\n","        \"build\"\n","    ].astype(int)\n","):\n","    raise AssertionError(\n","        \"changed_entities_by_build does not contain \"\n","        \"all Titan builds.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. Per-build mapping summary\n","# ---------------------------------------------------------\n","\n","parsed_commit_counts = (\n","    build_commit_map\n","    .groupby(\"Build\")\n","    .size()\n","    .rename(\"ParsedCommitCount\")\n",")\n","\n","\n","matched_commit_counts = (\n","    build_commit_map[\n","        build_commit_map[\n","            \"MatchedCommit\"\n","        ].notna()\n","    ]\n","    .groupby(\"Build\")[\n","        \"MatchedCommit\"\n","    ]\n","    .nunique()\n","    .rename(\"MatchedCommitCount\")\n",")\n","\n","\n","exact_commit_counts = (\n","    build_commit_map[\n","        build_commit_map[\n","            \"MatchStatus\"\n","        ] == \"EXACT\"\n","    ]\n","    .groupby(\"Build\")\n","    .size()\n","    .rename(\"ExactCommitCount\")\n",")\n","\n","\n","prefix_commit_counts = (\n","    build_commit_map[\n","        build_commit_map[\n","            \"MatchStatus\"\n","        ] == \"UNIQUE_PREFIX\"\n","    ]\n","    .groupby(\"Build\")\n","    .size()\n","    .rename(\"UniquePrefixCommitCount\")\n",")\n","\n","\n","unmatched_commit_counts = (\n","    build_commit_map[\n","        build_commit_map[\n","            \"MatchedCommit\"\n","        ].isna()\n","    ]\n","    .groupby(\"Build\")\n","    .size()\n","    .rename(\"UnmatchedCommitCount\")\n",")\n","\n","\n","changed_entity_counts = (\n","    build_entity_map\n","    .groupby(\"Build\")[\n","        \"EntityID\"\n","    ]\n","    .nunique()\n","    .rename(\"ChangedEntityCount\")\n",")\n","\n","\n","build_mapping_summary = (\n","    builds[\n","        [\n","            \"build\",\n","            \"build_order\",\n","            \"partition\",\n","        ]\n","    ]\n","    .rename(\n","        columns={\n","            \"build\":\n","                \"Build\",\n","\n","            \"build_order\":\n","                \"BuildOrder\",\n","\n","            \"partition\":\n","                \"Partition\",\n","        }\n","    )\n","    .merge(\n","        parsed_commit_counts,\n","        left_on=\"Build\",\n","        right_index=True,\n","        how=\"left\",\n","    )\n","    .merge(\n","        matched_commit_counts,\n","        left_on=\"Build\",\n","        right_index=True,\n","        how=\"left\",\n","    )\n","    .merge(\n","        exact_commit_counts,\n","        left_on=\"Build\",\n","        right_index=True,\n","        how=\"left\",\n","    )\n","    .merge(\n","        prefix_commit_counts,\n","        left_on=\"Build\",\n","        right_index=True,\n","        how=\"left\",\n","    )\n","    .merge(\n","        unmatched_commit_counts,\n","        left_on=\"Build\",\n","        right_index=True,\n","        how=\"left\",\n","    )\n","    .merge(\n","        changed_entity_counts,\n","        left_on=\"Build\",\n","        right_index=True,\n","        how=\"left\",\n","    )\n",")\n","\n","\n","mapping_count_columns = [\n","    \"ParsedCommitCount\",\n","    \"MatchedCommitCount\",\n","    \"ExactCommitCount\",\n","    \"UniquePrefixCommitCount\",\n","    \"UnmatchedCommitCount\",\n","    \"ChangedEntityCount\",\n","]\n","\n","\n","for column in mapping_count_columns:\n","    build_mapping_summary[\n","        column\n","    ] = (\n","        build_mapping_summary[\n","            column\n","        ]\n","        .fillna(0)\n","        .astype(int)\n","    )\n","\n","\n","build_mapping_summary = (\n","    build_mapping_summary\n","    .sort_values(\n","        \"BuildOrder\",\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(build_mapping_summary) != len(builds):\n","    raise AssertionError(\n","        \"Build mapping summary does not contain \"\n","        \"all 384 Titan builds.\"\n","    )\n","\n","\n","if (\n","    build_mapping_summary[\n","        \"MatchedCommitCount\"\n","    ]\n","    \u003e build_mapping_summary[\n","        \"ParsedCommitCount\"\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Matched commit count exceeds parsed count.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. Unmatched-commit diagnostics\n","# ---------------------------------------------------------\n","\n","unmatched_build_commit_pairs = (\n","    build_commit_map[\n","        build_commit_map[\n","            \"MatchedCommit\"\n","        ].isna()\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","unmatched_build_ids = set(\n","    unmatched_build_commit_pairs[\n","        \"Build\"\n","    ].astype(int)\n",")\n","\n","\n","model_ready_build_ids = set(\n","    dataset_with_order[\n","        \"Build\"\n","    ].astype(int)\n",")\n","\n","\n","affected_model_ready_build_ids = sorted(\n","    unmatched_build_ids\n","    \