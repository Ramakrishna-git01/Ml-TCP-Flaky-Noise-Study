     errors=\"coerce\",\n","    ).to_numpy(\n","        dtype=float\n","    )\n","\n","\n","    unchanged = np.isclose(\n","        clean_values,\n","        noisy_values,\n","        rtol=1e-10,\n","        atol=1e-12,\n","        equal_nan=True,\n","    )\n","\n","\n","    five_rec_value_changes += int(\n","        (\n","            ~unchanged\n","        ).sum()\n","    )\n","\n","\n","if five_model_label_changes == 0:\n","    raise AssertionError(\n","        \"5% raw noise caused no model-ready \"\n","        \"label changes.\"\n","    )\n","\n","\n","if five_rec_value_changes == 0:\n","    raise AssertionError(\n","        \"5% raw noise caused no REC feature changes.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 15. Confirm clean evaluation remained unchanged\n","# ---------------------------------------------------------\n","\n","evaluation_hash_after = int(\n","    pd.util.hash_pandas_object(\n","        clean_evaluation_data[\n","            evaluation_hash_columns\n","        ],\n","        index=True,\n","    ).sum()\n",")\n","\n","\n","evaluation_unchanged = bool(\n","    evaluation_hash_before\n","    == evaluation_hash_after\n",")\n","\n","\n","if not evaluation_unchanged:\n","    raise AssertionError(\n","        \"Clean evaluation data was modified.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 16. Self-test APFD and APFDc formulas\n","# ---------------------------------------------------------\n","\n","manual_failures = [\n","    1,\n","    1,\n","    0,\n","    0,\n","    0,\n","]\n","\n","\n","manual_apfd = (\n","    calculate_apfd(\n","        manual_failures\n","    )\n",")\n","\n","\n","manual_apfdc_long_failure_first = (\n","    calculate_apfdc(\n","        manual_failures,\n","        [\n","            5,\n","            1,\n","            1,\n","            1,\n","            1,\n","        ],\n","    )\n",")\n","\n","\n","manual_apfdc_quick_failure_first = (\n","    calculate_apfdc(\n","        manual_failures,\n","        [\n","            1,\n","            5,\n","            1,\n","            1,\n","            1,\n","        ],\n","    )\n",")\n","\n","\n","if not np.isclose(\n","    manual_apfd,\n","    0.8,\n","):\n","    raise AssertionError(\n","        \"Manual APFD validation failed.\"\n","    )\n","\n","\n","if not np.isclose(\n","    manual_apfdc_long_failure_first,\n","    5.0 / 9.0,\n","):\n","    raise AssertionError(\n","        \"Long-failure-first APFDc validation failed.\"\n","    )\n","\n","\n","if not np.isclose(\n","    manual_apfdc_quick_failure_first,\n","    7.0 / 9.0,\n","):\n","    raise AssertionError(\n","        \"Quick-failure-first APFDc validation failed.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 17. Save validation evidence\n","# ---------------------------------------------------------\n","\n","HELPER_VALIDATION_PATH = (\n","    PROJECT_PREFLIGHT\n","    / \"paho_canonical_helper_validation.json\"\n",")\n","\n","NOISE_SELFTEST_PATH = (\n","    PROJECT_PREFLIGHT\n","    / \"paho_noise_selftest_summary.csv\"\n",")\n","\n","\n","noise_selftest_summary = pd.DataFrame([\n","    {\n","        \"Test\":\n","            \"0_percent\",\n","\n","        \"NoisePercent\":\n","            0,\n","\n","        \"NumberFlipped\":\n","            int(\n","                zero_noise_summary[\n","                    \"NumberFlipped\"\n","                ]\n","            ),\n","\n","        \"RealisedNoisePercent\":\n","            float(\n","                zero_noise_summary[\n","                    \"RealisedNoisePercent\"\n","                ]\n","            ),\n","\n","        \"PassToFailure\":\n","            int(\n","                zero_noise_summary[\n","                    \"PassToFailure\"\n","                ]\n","            ),\n","\n","        \"FailureToPass\":\n","            int(\n","                zero_noise_summary[\n"," 