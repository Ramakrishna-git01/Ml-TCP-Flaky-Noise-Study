      file_name\n","        for file_name in EXPECTED_FILES\n","        if not (\n","            condition_directory / file_name\n","        ).exists()\n","    ]\n","\n","    if missing_files:\n","        raise FileNotFoundError(\n","            f\"Noise {noise_percent}% is missing files: \"\n","            + \", \".join(missing_files)\n","        )\n","\n","\n","    with open(\n","        condition_directory / \"_SUCCESS.json\",\n","        \"r\",\n","        encoding=\"utf-8\",\n","    ) as success_file:\n","        success_metadata = json.load(\n","            success_file\n","        )\n","\n","\n","    manifest = pd.read_parquet(\n","        condition_directory\n","        / \"noise_manifest.parquet\"\n","    )\n","\n","    noise_summary = pd.read_csv(\n","        condition_directory\n","        / \"noise_summary.csv\"\n","    )\n","\n","    build_metrics = pd.read_parquet(\n","        condition_directory\n","        / \"build_metrics.parquet\"\n","    )\n","\n","    project_run_metrics = pd.read_csv(\n","        condition_directory\n","        / \"project_run_metrics.csv\"\n","    )\n","\n","    fit_times = pd.read_csv(\n","        condition_directory\n","        / \"fit_times.csv\"\n","    )\n","\n","    rankings = pd.read_parquet(\n","        condition_directory\n","        / \"rankings.parquet\"\n","    )\n","\n","\n","    # ---------------------------------------------\n","    # Structural checks\n","    # ---------------------------------------------\n","\n","    assert len(manifest) == EXPECTED_MANIFEST_ROWS\n","    assert len(rankings) == EXPECTED_RANKING_ROWS\n","    assert len(build_metrics) == EXPECTED_BUILD_METRIC_ROWS\n","    assert len(project_run_metrics) == EXPECTED_PROJECT_RUN_ROWS\n","    assert len(fit_times) == EXPECTED_FIT_ROWS\n","\n","    assert set(\n","        project_run_metrics[\"Technique\"]\n","    ) == EXPECTED_TECHNIQUES\n","\n","    assert set(\n","        rankings[\"Technique\"]\n","    ) == EXPECTED_TECHNIQUES\n","\n","    assert rankings[\"Build\"].nunique() == 28\n","    assert build_metrics[\"Build\"].nunique() == 28\n","\n","    assert success_metadata[\n","        \"CompletedSuccessfully\"\n","    ] is True\n","\n","    assert success_metadata[\n","        \"EvaluationHashUnchanged\"\n","    ] is True\n","\n","    assert success_metadata[\n","        \"RankingRows\"\n","    ] == EXPECTED_RANKING_ROWS\n","\n","    assert success_metadata[\n","        \"BuildMetricRows\"\n","    ] == EXPECTED_BUILD_METRIC_ROWS\n","\n","\n","    # ---------------------------------------------\n","    # Metric validity\n","    # ---------------------------------------------\n","\n","    assert not build_metrics[\n","        [\"APFD\", \"APFDc\"]\n","    ].isna().any().any()\n","\n","    assert build_metrics[\n","        \"APFD\"\n","    ].between(0, 1).all()\n","\n","    assert build_metrics[\n","        \"APFDc\"\n","    ].between(0, 1).all()\n","\n","\n","    # ---------------------------------------------\n","    # Manifest validity\n","    # ---------------------------------------------\n","\n","    manifest = (\n","        manifest\n","        .sort_values(\"NoiseRowID\")\n","        .reset_index(drop=True)\n","    )\n","\n","    actual_changes = (\n","        manifest[\"OriginalVerdict\"]\n","        != manifest[\"NoisyVerdict\"]\n","    )\n","\n","    assert np.array_equal(\n","        actual_changes.to_numpy(),\n","        manifest[\"Flipped\"].to_numpy(),\n","    )\n","\n","    flipped_count = int(\n","        manifest[\"Flipped\"].sum()\n","    )\n","\n","    assert flipped_count == int(\n","        noise_summary[\n","            \"NumberFlipped\"\n","        ].iloc[0]\n","    )\n","\n","    evaluation_builds_in_manifest = len(\n","        set(\n","            manifest[\"Build\"].astype(int)\n","        ).intersection(\n","            evaluation_build_ids\n","        )\n","    )\n","\n","    assert evaluation_builds_in_manifest == 0\n","\n","\n","    manifest_by_noise[\n","        noise_percent\n","    ] = manifest\n","\n","    project_run_frames.append(\n","        project_run_metrics\n","    )\n","\n","    condition_records.append({\n","        \"Project\": PROJECT_NAME,\n","        \"NoisePercent\": noise_percent,\n","        \"RepetitionSeed\": 1,\n","        \"RequestedNoisePercent\":\n","            float(\n","                noise_summary[\n","                    \"NoisePercentRequested\"\n","                ].iloc[0]\n","            ),\n","        \"RealisedNoisePercent\":\n","            float(\n","                noise_summary[\n","                    \"RealisedNoisePercent\"\n","                ].iloc[0]\n","            ),\n","        \"NumberFlipped\":\n","            flipped_count,\n","        \"PassToFailure\":\n","            int(\n","                noise_summary[\n","                    \"PassToFailure\"\n","                ].iloc[0]\n","            ),\n","        \"FailureToPass\":\n","            int(\n","                noise_summary[\n","                    \"FailureToPass\"\n","                ].iloc[0]\n","            ),\n","        \"RankingRows\":\n","            len(rankings),\n","        \"BuildMetricRows\":\n","            len(build_metrics),\n","        \"ProjectRunRows\":\n","            len(project_run_metrics),\n","        \"FitRows\":\n","            len(fit_times),\n","        \"EvaluationBuildsInManifest\":\n","            evaluation_builds_in_manifest,\n","        \"Status\": \"SUCCESS\",\n","    })\n","\n","\n","condition_audit = pd.DataFrame(\n","    condition_records\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. VERIFY IDENTICAL ROWS AND RANDOM STREAMS\n","# ---------------------------------------------------------\n","\n","reference_manifest = manifest_by_noise[0]\n","\n","for noise_percent in EXPECTED_NOISE_LEVELS:\n","\n","    current_manifest = (\n","        manifest_by_noise[\n","            noise_percent\n","        ]\n","    )\n","\n","    assert np.array_equal(\n"," 