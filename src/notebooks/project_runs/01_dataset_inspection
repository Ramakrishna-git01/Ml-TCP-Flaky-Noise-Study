CESS: Project 5 was selected correctly using EligibleForPilot.\n"]}],"source":["# =========================================================\n","# PROJECT 5 — CORRECTED ELIGIBILITY AND PROJECT SELECTION\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Restore canonical paths\n","# ---------------------------------------------------------\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n",")\n","\n","LOGS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Logs\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","SCREENING_PATH = (\n","    THESIS_DRIVE\n","    / \"Data\"\n","    / \"processed\"\n","    / \"tcp_ci_project_screening.csv\"\n",")\n","\n","REGISTRY_PATH = (\n","    NOTES_DRIVE\n","    / \"completed_project_registry.csv\"\n",")\n","\n","DATASETS_ROOT = Path(\n","    \"/content/working_data/tcp_ci_full/datasets\"\n",")\n","\n","\n","required_paths = [\n","    SCREENING_PATH,\n","    REGISTRY_PATH,\n","    DATASETS_ROOT,\n","]\n","\n","\n","missing_paths = [\n","    str(path)\n","    for path in required_paths\n","    if not path.exists()\n","]\n","\n","\n","if missing_paths:\n","    raise FileNotFoundError(\n","        \"Required restored paths are missing:\\n\"\n","        + \"\\n\".join(\n","            missing_paths\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Reload screening and registry\n","# ---------------------------------------------------------\n","\n","screening = pd.read_csv(\n","    SCREENING_PATH\n",")\n","\n","registry = pd.read_csv(\n","    REGISTRY_PATH\n",")\n","\n","\n","required_screening_columns = [\n","    \"Project\",\n","    \"ProjectPath\",\n","    \"ScreeningStatus\",\n","    \"EligibleForPilot\",\n","]\n","\n","\n","missing_screening_columns = [\n","    column\n","    for column in required_screening_columns\n","    if column not in screening.columns\n","]\n","\n","\n","if missing_screening_columns:\n","    raise KeyError(\n","        \"Screening table is missing required columns:\\n\"\n","        + \"\\n\".join(\n","            missing_screening_columns\n","        )\n","    )\n","\n","\n","if \"Project\" not in registry.columns:\n","    raise KeyError(\n","        \"Completion registry has no Project column.\"\n","    )\n","\n","\n","if \"Status\" not in registry.columns:\n","    raise KeyError(\n","        \"Completion registry has no Status column.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Correctly interpret EligibleForPilot\n","# ---------------------------------------------------------\n","\n","def parse_eligibility(value):\n","    \"\"\"\n","    Convert Boolean, numeric, and common textual\n","    representations into a reliable Boolean.\n","    \"\"\"\n","\n","    if pd.isna(value):\n","        return False\n","\n","    if isinstance(\n","        value,\n","        (\n","            bool,\n","            np.bool_,\n","        ),\n","    ):\n","        return bool(\n","            value\n","        )\n","\n","    if isinstance(\n","        value,\n","        (\n","            int,\n","            np.integer,\n","            float,\n","            np.floating,\n","        ),\n","    ):\n","        return bool(\n","            int(\n","                value\n","            )\n","        )\n","\n","\n","    text = (\n","        str(\n","            value\n","        )\n","        .strip()\n","        .lower()\n","    )\n","\n","\n","    true_values = {\n","        \"true\",\n","        \"1\",\n","        \"yes\",\n","        \"y\",\n","        \"eligible\",\n","        \"included\",\n","        \"include\",\n","        \"pass\",\n","        \"passed\",\n","    }\n","\n","\n","    false_values = {\n","        \"false\",\n","        \"0\",\n","        \"no\",\n","        \"n\",\n","        \"ineligible\",\n","        \"excluded\",\n","        \"exclude\",\n","        \"fail\",\n","        \"failed\",\n","    }\n","\n","\n","    if text in true_values:\n","        return True\n","\n","    if text in false_values:\n","        return False\n","\n","\n","    if any(\n","        token in text\n","        for token in [\n","            \"ineligible\",\n","            \"excluded\",\n","            \"not eligible\",\n","            \"false\",\n","        ]\n","    ):\n","        return False\n","\n","\n","    if any(\n","        token in text\n","        for token in [\n","            \"eligible\",\n","            \"included\",\n","            \"passed\",\n","            \"true\",\n","        ]\n","    ):\n","        return True\n","\n","\n","    raise ValueError(\n","        \"Unrecognised EligibleForPilot value: \"\n","        f\"{value!r}\"\n","    )\n","\n","\n","screening = screening.copy()\n","\n","\n","screening[\n","    \"_ScreeningOrder\"\n","] = np.arange(\n","    len(\n","        screening\n","    )\n",")\n","\n","\n","screening[\n","    \"_ProjectName\"\n","] = (\n","    screening[\n","        \"Project\"\n","    ]\n","    .astype(str)\n","    .str.strip()\n",")\n","\n","\n","screening[\n","    \"_EligibleForExperiment\"\n","] = (\n","    screening[\n","        \"EligibleForPilot\"\n","    ]\n","    .apply(\n","        parse_eligibility\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Validate the screening result\n","# ---------------------------------------------------------\n","\n","eligible_count = int(\n","    screening[\n","        \"_EligibleForExperiment\"\n","    ].sum()\n",")\n","\n","ineligible_count = int(\n","    (\n","        ~screening[\n","            \"_EligibleForExperiment\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","print(\n","    \"=== CORRECTED SCREENING INTERPRETATION ===\"\n",")\n","\n","print(\n","    \"Total projects:\",\n","    len(\n","        screening\n","    ),\n",")\n","\n","print(\n","    \"Eligible projects:\",\n","    eligible_count,\n",")\n","\n","print(\n","    \"Ineligible projects:\",\n","    ineligible_count,\n",")\n","\n","\n","print(\n","    \"\\nRaw EligibleForPilot values:\"\n",")\n","\n","display(\n","    screening[\n","        \"EligibleForPilot\"\n","    ]\n","    .value_counts(\n","        dropna=False\n","    )\n","    .rename_axis(\n","        \"EligibleForPilot\"\n","    )\n","    .reset_index(\n","        name=\"ProjectCount\"\n","    )\n",")\n","\n","\n","print(\n","    \"\\nIneligible projects:\"\n",")\n","\n","display(\n","    screening.loc[\n","        ~screening[\n","            \"_EligibleForExperiment\"\n","        ],\n","        [\n","            \"Project\",\n","            \"ScreeningStatus\",\n","            \"EligibleForPilot\",\n","            \"ExclusionReasons\",\n","            \"FailingTrainingBuilds\",\n","            \"FailingEvaluationBuilds\",\n","            \"ModelTrainingFailures\",\n","            \"ModelEvaluationFailures\",\n","        ],\n","    ]\n","    .reset_index(drop=True)\n",")\n","\n","\n","if eligible_count != 24:\n","    raise AssertionError(\n","        \"Expected 24 eligible projects, but found \"\n","        f\"{eligible_count}. Review the table displayed \"\n","        \"above before proceeding.\"\n","    )\n","\n","\n","if ineligible_count != 1:\n","    raise AssertionError(\n","        \"Expected one ineligible project, but found \"\n","        f\"{ineligible_count}.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Read the four frozen projects\n","# ---------------------------------------------------------\n","\n","completed_projects = set(\n","    registry.loc[\n","        registry[\n","            \"Status\"\n","        ]\n","        .astype(str)\n","        .str.contains(\n","            \"COMPLETE\",\n","            case=False,\n","            na=False,\n","        ),\n","        \"Project\",\n","    ]\n","    .astype(str)\n","    .str.strip()\n","    .tolist()\n",")\n","\n","\n","expected_frozen_projects = {\n","    \"Angel-ML@angel\",\n","    \"apache@airavata\",\n","    \"b2ihealthcare@snow-owl\",\n","    \"eclipse@paho.mqtt.java\",\n","}\n","\n","\n","missing_frozen_projects = (\n","    expected_frozen_projects\n","    - completed_projects\n",")\n","\n","\n","if missing_frozen_projects:\n","    raise AssertionError(\n","        \"The registry is missing frozen projects:\\n\"\n","        + \"\\n\".join(\n","            sorted(\n","                missing_frozen_projects\n","            )\n","        )\n","    )\n","\n","\n","print(\n","    \"\\nFrozen projects detected:\",\n","    len(\n","        completed_projects\n","    ),\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Select next eligible and unfinished project\n","# ---------------------------------------------------------\n","\n","candidate_projects = (\n","    screening.loc[\n","        screening[\n","            \"_EligibleForExperiment\"\n","        ]\n","        \u0026 ~screening[\n","            \"_ProjectName\"\n","        ].isin(\n","            completed_projects\n","        )\n","    ]\n","    .sort_values(\n","        \"_ScreeningOrder\",\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","if candidate_projects.empty:\n","    raise RuntimeError(\n","        \"No eligible unfinished projects remain.\"\n","    )\n","\n","\n","selected_screening_row = (\n","    candidate_projects.iloc[0]\n",")\n","\n","\n","PROJECT_NUMBER = 5\n","\n","PROJECT_NAME = str(\n","    selected_screening_