y import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Confirm Project 5 selection\n","# ---------------------------------------------------------\n","\n","EXPECTED_PROJECT_NUMBER = 5\n","EXPECTED_PROJECT_NAME = \"thinkaurelius@titan\"\n","EXPECTED_PROJECT_SLUG = \"thinkaurelius__titan\"\n","\n","\n","if PROJECT_NUMBER != EXPECTED_PROJECT_NUMBER:\n","    raise AssertionError(\n","        f\"Expected Project 5, found Project {PROJECT_NUMBER}.\"\n","    )\n","\n","if PROJECT_NAME != EXPECTED_PROJECT_NAME:\n","    raise AssertionError(\n","        f\"Expected {EXPECTED_PROJECT_NAME}, \"\n","        f\"found {PROJECT_NAME}.\"\n","    )\n","\n","if PROJECT_SLUG != EXPECTED_PROJECT_SLUG:\n","    raise AssertionError(\n","        f\"Expected slug {EXPECTED_PROJECT_SLUG}, \"\n","        f\"found {PROJECT_SLUG}.\"\n","    )\n","\n","if not PROJECT_PATH.exists():\n","    raise FileNotFoundError(\n","        f\"Project directory does not exist: {PROJECT_PATH}\"\n","    )\n","\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","SCREENING_PATH = (\n","    THESIS_DRIVE\n","    / \"Data\"\n","    / \"processed\"\n","    / \"tcp_ci_project_screening.csv\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","PROJECT_RAW_RESULTS = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_LOGS = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Logs\"\n","    / PROJECT_SLUG\n",")\n","\n","PREFLIGHT_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_preflight\"\n",")\n","\n","\n","for directory in [\n","    PROJECT_RAW_RESULTS,\n","    PROJECT_AGGREGATED_RESULTS,\n","    PROJECT_LOGS,\n","    PREFLIGHT_DIRECTORY,\n","]:\n","    directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","print(\n","    \"=== PROJECT 5: THINKAURELIUS TITAN \"\n","    \"CORRECTED PREFLIGHT ===\"\n",")\n","\n","print(\n","    \"Project path:\",\n","    PROJECT_PATH,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Load the six TCP-CI files\n","# ---------------------------------------------------------\n","\n","PROJECT_FILES = {\n","    \"builds\":\n","        PROJECT_PATH / \"builds.csv\",\n","\n","    \"executions\":\n","        PROJECT_PATH / \"exe.csv\",\n","\n","    \"dataset\":\n","        PROJECT_PATH / \"dataset.csv\",\n","\n","    \"entity_change_history\":\n","        PROJECT_PATH / \"entity_change_history.csv\",\n","\n","    \"id_map\":\n","        PROJECT_PATH / \"id_map.csv\",\n","\n","    \"contributors\":\n","        PROJECT_PATH / \"contributors.csv\",\n","}\n","\n","\n","missing_project_files = [\n","    str(path)\n","    for path in PROJECT_FILES.values()\n","    if not path.exists()\n","]\n","\n","\n","if missing_project_files:\n","    raise FileNotFoundError(\n","        \"Required project files are missing:\\n\"\n","        + \"\\n\".join(\n","            missing_project_files\n","        )\n","    )\n","\n","\n","def read_tcp_ci_csv(path):\n","    dataframe = pd.read_csv(\n","        path,\n","        low_memory=False,\n","    )\n","\n","    unnamed_columns = [\n","        column\n","        for column in dataframe.columns\n","        if str(column).startswith(\"Unnamed:\")\n","    ]\n","\n","    if unnamed_columns:\n","        dataframe = dataframe.drop(\n","            columns=unnamed_columns\n","        )\n","\n","    return dataframe\n","\n","\n","builds_raw = read_tcp_ci_csv(\n","    PROJECT_FILES[\"builds\"]\n",")\n","\n","exe_raw = read_tcp_ci_csv(\n","    PROJECT_FILES[\"executions\"]\n",")\n","\n","dataset_raw = read_tcp_ci_csv(\n","    PROJECT_FILES[\"dataset\"]\n",")\n","\n","entity_change_history = read_tcp_ci_csv(\n","    PROJECT_FILES[\"entity_change_history\"]\n",")\n","\n","id_map = read_tcp_ci_csv(\n","    PROJECT_FILES[\"id_map\"]\n",")\n","\n","contributors = read_tcp_ci_csv(\n","    PROJECT_FILES[\"contributors\"]\n",")\n","\n","\n","# Compatibility alias for later mapping/reconstruction.\n","entity_change = (\n","    entity_change_history.copy()\n",")\n","\n","\n","raw_file_inventory = pd.DataFrame([\n","    {\n","        \"LogicalName\": \"builds\",\n","        \"Rows\": len(builds_raw),\n","        \"Columns\": len(builds_raw.columns),\n","        \"ColumnNames\": str(builds_raw.columns.tolist()),\n","    },\n","    {\n","        \"LogicalName\": \"executions\",\n","        \"Rows\": len(exe_raw),\n","        \"Columns\": len(exe_raw.columns),\n","        \"ColumnNames\": str(exe_raw.columns.tolist()),\n","    },\n","    {\n","        \"LogicalName\": \"dataset\",\n","        \"Rows\": len(dataset_raw),\n","        \"Columns\": len(dataset_raw.columns),\n","        \"ColumnNames\": str(dataset_raw.columns.tolist()),\n","    },\n","    {\n","        \"LogicalName\": \"entity_change_history\",\n","        \"Rows\": len(entity_change_history),\n","        \"Columns\": len(entity_change_history.columns),\n","        \"ColumnNames\":\n","            str(entity_change_history.columns.tolist()),\n","    },\n","    {\n","        \"LogicalName\": \"id_map\",\n","        \"Rows\": len(id_map),\n","        \"Columns\": len(id_map.columns),\n","        \"ColumnNames\": str(id_map.columns.tolist()),\n","    },\n","    {\n","        \"LogicalName\": \"contributors\",\n","        \"Rows\": len(contributors),\n","        \"Columns\": len(contributors.columns),\n","        \"ColumnNames\":\n","            str(contributors.columns.tolist()),\n","    },\n","])\n","\n","\n","print(\n","    \"\\nRaw file shapes:\"\n",")\n","\n","display(\n","    raw_file_inventory[\n","        [\n","            \"LogicalName\",\n","            \"Rows\",\n","            \"Columns\",\n","        ]\n","    ]\n",")\n","\n","\n","print(\n","    \"\\nImportant raw schemas:\"\n",")\n","\n","print(\n","    \"builds.csv:\",\n","    builds_raw.columns.tolist(),\n",")\n","\n","print(\n","    \"exe.csv:\",\n","    exe_raw.columns.tolist(),\n",")\n","\n","print(\n","    \"dataset.csv first columns:\",\n","    dataset_raw.columns.tolist()[:12],\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Robust column-resolution helpers\n","# ---------------------------------------------------------\n","\n","def normalise_column_name(column_name):\n","    return \"\".join(\n","        character.lower()\n","        for character in str(column_name)\n","        if character.isalnum()\n","    )\n","\n","\n","def resolve_column(\n","    dataframe,\n","    aliases,\n","    description,\n","    required=True,\n","):\n","    lookup = {\n","        normalise_column_name(column):\n","            column\n","        for column in dataframe.columns\n","    }\n","\n","    for alias in aliases:\n","        normalised_alias = normalise_column_name(\n","            alias\n","        )\n","\n","        if normalised_alias in lookup:\n","            return lookup[\n","                normalised_alias\n","            ]\n","\n","    if required:\n","        raise KeyError(\n","            f\"Could not identify {description}.\\n\"\n","            f\"Aliases tried: {aliases}\\n\"\n","            f\"Available columns: \"\n","            f\"{dataframe.columns.tolist()}\"\n","        )\n","\n","    return None\n","\n","\n","def convert_integer_ids(\n","    series,\n","    description,\n","):\n","    numeric = pd.to_numeric(\n","        series,\n","        errors=\"raise\",\n","    )\n","\n","    values = numeric.to_numpy(\n","        dtype=float\n","    )\n","\n","    if not np.isfinite(values).all():\n","        raise ValueError(\n","            f\"{description} contains non-finite IDs.\"\n","        )\n","\n","    if not np.equal(\n","        values,\n","        np.floor(values),\n","    ).all():\n","        raise ValueError(\n","            f\"{description} contains non-integer IDs.\"\n","        )\n","\n","    return numeric.astype(\"int64\")\n","\n","\n","def convert_integer_verdicts(\n","    series,\n","    description,\n","):\n","    numeric = pd.to_numeric(\n","        series,\n","        errors=\"raise\",\n","    )\n","\n","    values = numeric.to_numpy(\n","        dtype=float\n","    )\n","\n","    if not np.isfinite(values).all():\n","        raise ValueError(\n","            f\"{description} contains invalid verdicts.\"\n","        )\n","\n","    if not np.equal(\n","        values,\n","        np.floor(values),\n","    ).all():\n","        raise ValueError(\n","            f\"{description} contains non-integer \"\n","            \"verdicts.\"\n","        )\n","\n","    return numeric.astype(\"int8\")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Canonicalise builds.csv\n","# ---------------------------------------------------------\n","\n","# Titan uses:\n","# ['id', 'commits', 'started_at']\n","BUILDS_BUILD_COLUMN = resolve_column(\n","    builds_raw,\n","    aliases=[\n","        \"id\",\n","        \"build\",\n","        \"Build\",\n","        \"build_id\",\n","        \"buildId\",\n","        \"travisBuildId\",\n","        \"travis_build_id\",\n","        \"tr_build_id\",\n","    ],\n","    description=\"builds.csv build-ID column\",\n",")\n","\n","\n","BUILDS_TIMESTAMP_COLUMN = resolve_column(\n","    builds_raw,\n","    aliases=[\n","        \"started_at\",\n","        \"StartedAt\",\n","        \"startedAt\",\n","        \"build_started_at\",\n","        \"BuildStartedAt\",\n","        \"timestamp\",\n","        \"created_at\",\n","    ],\n","    description=\"builds.csv timestamp column\",\n",")\n","\n","\n","builds_checked = (\n","    builds_raw\n","    .rename(\n","        columns={\n","            BUILDS_BUILD_COLUMN:\n","                \"build\",\n","\n","            BUILDS_TIMESTAMP_COLUMN:\n","                \"started_at\",\n","        }\n","    )\n","    .copy()\n",")\n","\n","\n","builds_checked[\n","    \"build\"\n","] = convert_integer_ids(\n","    builds_checked[\n","        \"build\"\n","    ],\n","    \"builds.csv\",\n",")\n","\n","\n","builds_checked[\n","    \"started_at\"\n","] = pd.to_datetime(\n","    builds_checked[\n","        \"started_at\"\n","    ],\n","    errors=\"coerce\",\n","    utc=True,\n",")\n","\n","\n","missing_build_timestamps = int(\n","    builds_checked[\n","        \"started_at\"\n","    ].isna().sum()\n",")\n","\n","\n","duplicate_build_ids = int(\n","    builds_checked[\n","        \"build\"\n","    ].duplicated().sum()\n",")\n","\n","\n","if missing_build_timestamps != 0:\n","    raise AssertionError(\n","        \"Missing or invalid build timestamps: \"\n","        f\"{missing_build_timestamps}\"\n","    )\n","\n","if duplicate_build_ids != 0:\n","    raise AssertionError(\n","        f\"Duplicate build IDs: {duplicate_build_ids}\"\n","    )\n","\n","\n","builds = (\n","    builds_checked\n","    .sort_values(\n","        [\n","            \"started_at\",\n","            \"build\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","builds[\n","    \"build_order\"\n","] = np.arange(\n","    1,\n","    len(builds) + 1,\n","    dtype=int,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Load Titan's screening expectations\n","# ---------------------------------------------------------\n","\n","screening = pd.read_csv(\n","    SCREENING_PATH\n",")\n","\n","\n","titan_screening_rows = (\n","    screening[\n","        screening[\n","            \"Project\"\n","        ].astype(str).str.strip()\n","        == PROJECT_NAME\n","    ]\n",")\n","\n","\n","if len(titan_screening_rows) != 1:\n","    raise AssertionError(\n","        \"Expected one Titan screening row, found \"\n","        f\"{len(titan_screening_rows)}.\"\n","    )\n","\n","\n","project_screening = (\n","    titan_screening_rows.iloc[0]\n",")\n","\n","\n","def expected_integer(column_name):\n","    value = project_screening[\n","        column_name\n","    ]\n","\n","    if pd.isna(value):\n","        raise ValueError(\n","            f\"Missing screening value: {column_name}\"\n","        )\n","\n","    return int(value)\n","\n","\n","EXPECTED_TOTAL_BUILDS = expected_integer(\n","    \"TotalBuilds\"\n",")\n","\n","EXPECTED_TRAINING_PERIOD_BUILDS = (\n","    expected_integer(\n","        \"TrainingPeriodBuilds\"\n","    )\n",")\n","\n","EXPECTED_EVALUATION_PERIOD_BUILDS = (\n","    expected_integer(\n","        \"EvaluationPeriodBuilds\"\n","    )\n",")\n","\n","EXPECTED_RAW_EXECUTION_ROWS = expected_integer(\n","    \"RawExecutionRows\"\n",")\n","\n","EXPECTED_TRAINING_EXECUTION_ROWS = (\n","    expected_integer(\n","        \"TrainingExecutionRows\"\n","    )\n",")\n","\n","EXPECTED_EVALUATION_EXECUTION_ROWS = (\n","    expected_integer(\n","        \"EvaluationExecutionRows\"\n","    )\n",")\n","\n","EXPECTED_UNIQUE_EXECUTION_TESTS = (\n","    expected_integer(\n","        \"UniqueExecutionTests\"\n","    )\n",")\n","\n","EXPECTED_FAILING_TRAINING_BUILDS = (\n","    expected_integer(\n","        \"FailingTrainingBuilds\"\n","    )\n",")\n","\n","EXPECTED_FAILING_EVALUATION_BUILDS = (\n","    expected_integer(\n","        \"FailingEvaluationBuilds\"\n","    )\n",")\n","\n","EXPECTED_TRAINING_FAILURE_EXECUTIONS = (\n","    expected_integer(\n","        \"TrainingFailureExecutions\"\n","    )\n",")\n","\n","EXPECTED_EVALUATION_FAILURE_EXECUTIONS = (\n","    expected_integer(\n","        \"EvaluationFailureExecutions\"\n","    )\n",")\n","\n","EXPECTED_MODEL_TRAINING_ROWS = (\n","    expected_integer(\n","        \"ModelTrainingRows\"\n","    )\n",")\n","\n","EXPECTED_MODEL_TRAINING_BUILDS = (\n","    expected_integer(\n","        \"ModelTrainingBuilds\"\n","    )\n",")\n","\n","EXPECTED_MODEL_EVALUATION_ROWS = (\n","    expected_integer(\n","        \"ModelEvaluationRows\"\n","    )\n",")\n","\n","EXPECTED_MODEL_EVALUATION_BUILDS = (\n","    expected_integer(\n","        \"ModelEvaluationBuilds\"\n","    )\n",")\n","\n","EXPECTED_MODEL_TRAINING_PASSES = (\n","    expected_integer(\n","        \"ModelTrainingPasses\"\n","    )\n",")\n","\n","EXPECTED_MODEL_TRAINING_FAILURES = (\n","    expected_integer(\n","        \"ModelTrainingFailures\"\n","    )\n",")\n","\n","EXPECTED_MODEL_EVALUATION_PASSES = (\n","    expected_integer(\n","        \"ModelEvaluationPasses\"\n","    )\n",")\n","\n","EXPECTED_MODEL_EVALUATION_FAILURES = (\n","    expected_integer(\n","        \"ModelEvaluationFailures\"\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Chronological 75/25 split\n","# ---------------------------------------------------------\n","\n","if len(builds) != EXPECTED_TOTAL_BUILDS:\n","    raise AssertionError(\n","        \"Total build count mismatch.\\n\"\n","        f\"Expected: {EXPECTED_TOTAL_BUILDS}\\n\"\n","        f\"Observed: {len(builds)}\"\n","    )\n","\n","\n","calculated_training_builds = int(\n","    np.floor(\n","        0.75 * len(builds)\n","    )\n",")\n","\n","\n","if calculated_training_builds != (\n","    EXPECTED_TRAINING_PERIOD_BUILDS\n","):\n","    raise AssertionError(\n","        \"75% training-build count mismatch.\\n\"\n","        f\"Calculated: {calculated_training_builds}\\n\"\n","        f\"Expected: \"\n","        f\"{EXPECTED_TRAINING_PERIOD_BUILDS}\"\n","    )\n","\n","\n","training_build_table = (\n","    builds.iloc[\n","        :EXPECTED_TRAINING_PERIOD_BUILDS\n","    ]\n","    .copy()\n",")\n","\n","\n","evaluation_build_table = (\n","    builds.iloc[\n","        EXPECTED_TRAINING_PERIOD_BUILDS:\n","    ]\n","    .copy()\n",")\n","\n","\n","if len(evaluation_build_table) != (\n","    EXPECTED_EVALUATION_PERIOD_BUILDS\n","):\n","    raise AssertionError(\n","        \"Evaluation build count mismatch.\"\n","    )\n","\n","\n","training_build_table[\n","    \"partition\"\n","] = \"training\"\n","\n","evaluation_build_table[\n","    \"partition\"\n","] = \"evaluation\"\n","\n","\n","builds = pd.concat(\n","    [\n","        training_build_table,\n","        evaluation_build_table,\n","    ],\n","    ignore_index=True,\n",")\n","\n","\n","training_build_ids = set(\n","    training_build_table[\n","        \"build\"\n","    ].astype(int)\n",")\n","\n","\n","evaluation_build_ids = set(\n","    evaluation_build_table[\n","        \"build\"\n","    ].astype(int)\n",")\n","\n","\n","if training_build_ids \u0026 evaluation_build_ids:\n","    raise AssertionError(\n","        \"Training and evaluation builds overlap.\"\n","    )\n","\n","\n","build_order_map = dict(\n","    zip(\n","        builds[\n","            \"build\"\n","        ].astype(int),\n","\n","        builds[\n","            \"build_order\"\n","        ].astype(int),\n","    )\n",")\n","\n","\n","partition_map = dict(\n","    zip(\n","        builds[\n","            \"build\"\n","        ].astype(int),\n","\n","        builds[\n","            \"partition\"\n","        ].astype(str),\n","    )\n",")\n","\n","\n","last_training_build = (\n","    training_build_table.iloc[-1]\n",")\n","\n","first_evaluation_build = (\n","    evaluation_build_table.iloc[0]\n",")\n","\n","\n","if not (\n","    last_training_build[\n","        \"started_at\"\n","    ]\n","    \u003c= first_evaluation_build[\n","        \"started_at\"\n","    ]\n","):\n","    raise AssertionError(\n","        \"Chronological split boundary is invalid.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Canonicalise exe.csv\n","# ---------------------------------------------------------\n","\n","EXE_BUILD_COLUMN = resolve_column(\n","    exe_raw,\n","    aliases=[\n","        \"build\",\n","        \"Build\",\n","        \"build_id\",\n","        \"buildId\",\n","        \"travisBuildId\",\n","        \"tra