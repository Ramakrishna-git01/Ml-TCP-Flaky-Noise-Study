\u003c/a\u003e'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","\n","    \u003c/div\u003e\n","  \u003c/div\u003e\n"],"text/plain":["    NoisePercent     Technique  Seeds  MeanAPFDc  SD_APFDc_AcrossSeeds  \\\n","0            0.0    LatestFail     30   0.742648              0.000000   \n","1            0.0       QTF-Avg     30   0.685582              0.000000   \n","2            0.0  RandomForest     30   0.621098              0.026881   \n","3            0.0       XGBoost     30   0.610992              0.000000   \n","4            0.0      LightGBM     30   0.589832              0.000000   \n","..           ...           ...    ...        ...                   ...   \n","58          50.0    NaiveBayes     30   0.505403              0.191992   \n","59          50.0      LightGBM     30   0.494780              0.166532   \n","60          50.0        Random     30   0.486074              0.100827   \n","61          50.0  RandomForest     30   0.481164              0.142273   \n","62          50.0       XGBoost     30   0.479562              0.186819   \n","\n","    MedianAPFDc  CI95Lower_APFDc  CI95Upper_APFDc  \n","0      0.742648         0.742648         0.742648  \n","1      0.685582         0.685582         0.685582  \n","2      0.616849         0.611479         0.630717  \n","3      0.610992         0.610992         0.610992  \n","4      0.589832         0.589832         0.589832  \n","..          ...              ...              ...  \n","58     0.538559         0.436700         0.574107  \n","59     0.505336         0.435188         0.554373  \n","60     0.501522         0.449993         0.522155  \n","61     0.465579         0.430252         0.532076  \n","62     0.476536         0.412709         0.546414  \n","\n","[63 rows x 8 columns]"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Final directory:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/thinkaurelius__titan/titan_30_seed_final\n","\n","Final audit report:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/thinkaurelius__titan/titan_30_seed_final/titan_final_audit_report.json\n","\n","Completion registry:\n","/content/drive/MyDrive/Thesis_Experiment/Notes/completed_project_registry.csv\n","\n","Audit elapsed minutes: 0.79\n","\n","SUCCESS: All 270 Titan conditions passed the final cross-condition audit.\n","SUCCESS: All 686,070 ranking rows were aggregated.\n","SUCCESS: All 18,900 APFD/APFDc rows were independently recomputed and validated.\n","SUCCESS: Random and QTF-Avg invariance rules passed.\n","SUCCESS: All nested noise masks and flip directions passed.\n","SUCCESS: Titan has been added as Project 5 in the completion registry.\n","SUCCESS: Titan is now COMPLETE_AND_FROZEN.\n"]}],"source":["# =========================================================\n","# PROJECT 5: THINKAURELIUS TITAN\n","# FINAL CROSS-CONDITION AUDIT, AGGREGATION AND FREEZE\n","#\n","# Reads all 270 completed condition directories directly\n","# from Google Drive.\n","#\n","# Final expected counts:\n","#   Conditions:              270\n","#   Ranking rows:        686,070\n","#   Build metrics:        18,900\n","#   Project-run rows:       1,890\n","#   Model-fit rows:         1,080\n","#\n","# Final output:\n","# Results/Aggregated/thinkaurelius__titan/\n","#     titan_30_seed_final/\n","#\n","# This cell:\n","#   - audits every condition and success marker\n","#   - aggregates all raw outputs\n","#   - validates clean evaluation consistency\n","#   - recomputes APFD and APFDc from rankings\n","#   - recomputes project-run summaries\n","#   - validates nested noise masks\n","#   - validates Random invariance across noise\n","#   - validates QTF-Avg invariance\n","#   - validates deterministic 0% baselines\n","#   - calculates seed-level aggregate summaries\n","#   - calculates paired degradation from 0%\n","#   - updates the completed-project registry\n","#   - marks Titan COMPLETE_AND_FROZEN\n","# =========================================================\n","\n","from pathlib import Path\n","import hashlib\n","import json\n","import math\n","import time\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Fixed project configuration\n","# ---------------------------------------------------------\n","\n","PROJECT_NUMBER = 5\n","PROJECT_NAME = \"thinkaurelius@titan\"\n","PROJECT_SLUG = \"thinkaurelius__titan\"\n","\n","NOISE_LEVELS = [\n","    0,\n","    5,\n","    10,\n","    15,\n","    20,\n","    25,\n","    30,\n","    40,\n","    50,\n","]\n","\n","REPETITION_SEEDS = list(\n","    range(1, 31)\n",")\n","\n","ML_TECHNIQUES = [\n","    \"RandomForest\",\n","    \"XGBoost\",\n","    \"LightGBM\",\n","    \"NaiveBayes\",\n","]\n","\n","BASELINE_TECHNIQUES = [\n","    \"Random\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","]\n","\n","ALL_TECHNIQUES = (\n","    ML_TECHNIQUES\n","    + BASELINE_TECHNIQUES\n",")\n","\n","EXPECTED_CONDITIONS = 270\n","\n","EXPECTED_EVALUATION_ROWS = 363\n","EXPECTED_EVALUATION_BUILDS = 10\n","EXPECTED_EVALUATION_FAILURES = 13\n","\n","EXPECTED_RANKING_ROWS_PER_CONDITION = 2541\n","EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION = 70\n","EXPECTED_PROJECT_RUN_ROWS_PER_CONDITION = 7\n","EXPECTED_MODEL_FIT_ROWS_PER_CONDITION = 4\n","\n","EXPECTED_TOTAL_RANKING_ROWS = 686070\n","EXPECTED_TOTAL_BUILD_METRIC_ROWS = 18900\n","EXPECTED_TOTAL_PROJECT_RUN_ROWS = 1890\n","EXPECTED_TOTAL_MODEL_FIT_ROWS = 1080\n","EXPECTED_TOTAL_NOISE_SUMMARY_ROWS = 270\n","\n","EXPECTED_RAW_TRAINING_ROWS = 12785\n","\n","ORIGINAL_PREDICTOR_COUNT = 150\n","ACTIVE_PREDICTOR_COUNT = 149\n","\n","ZERO_VARIANCE_FEATURES = [\n","    \"TES_COM_CountDeclMethodDefault\"\n","]\n","\n","\n","# ---------------------------------------------------------\n","# 2. Permanent paths\n","# ---------------------------------------------------------\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","RAW_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Raw\"\n",")\n","\n","AGGREGATED_RESULTS_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","PROJECT_RAW_RESULTS = (\n","    RAW_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","FULL_RUN_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_full_run\"\n",")\n","\n","FINAL_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_30_seed_final\"\n",")\n","\n","FINAL_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","COMPLETION_REGISTRY_PATH = (\n","    NOTES_DRIVE\n","    / \"completed_project_registry.csv\"\n",")\n","\n","SELECTION_CHECKPOINT_PATH = (\n","    NOTES_DRIVE\n","    / \"project_05_selection_checkpoint.json\"\n",")\n","\n","FULL_RUN_REPORT_PATH = (\n","    FULL_RUN_DIRECTORY\n","    / \"titan_full_run_execution_report.json\"\n",")\n","\n","\n","if not PROJECT_RAW_RESULTS.exists():\n","    raise FileNotFoundError(\n","        \"Titan raw-result directory does not exist:\\n\"\n","        f\"{PROJECT_RAW_RESULTS}\"\n","    )\n","\n","\n","print(\n","    \"=== TITAN FINAL CROSS-CONDITION AUDIT SETUP ===\"\n",")\n","\n","print(\n","    \"Raw results:\",\n","    PROJECT_RAW_RESULTS,\n",")\n","\n","print(\n","    \"Final directory:\",\n","    FINAL_DIRECTORY,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Expected condition keys\n","# ---------------------------------------------------------\n","\n","EXPECTED_CONDITION_KEYS = {\n","    (\n","        int(noise),\n","        int(seed),\n","    )\n","    for seed in REPETITION_SEEDS\n","    for noise in NOISE_LEVELS\n","}\n","\n","\n","if len(EXPECTED_CONDITION_KEYS) != 270:\n","    raise AssertionError(\n","        \"Expected condition-key construction failed.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Condition path helper\n","# ---------------------------------------------------------\n","\n","def get_condition_paths(\n","    noise_percent,\n","    repetition_seed,\n","):\n","    directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{int(noise_percent):03d}\"\n","        / f\"seed_{int(repetition_seed):02d}\"\n","    )\n","\n","    return {\n","        \"directory\":\n","            directory,\n","\n","        \"success\":\n","            directory\n","            / \"_SUCCESS.json\",\n","\n","        \"noise_manifest\":\n","            directory\n","            / \"noise_manifest.parquet\",\n","\n","        \"noise_summary\":\n","            directory\n","            / \"noise_summary.csv\",\n","\n","        \"fit_times\":\n","            directory\n","            / \"fit_times.csv\",\n","\n","        \"rankings\":\n","            directory\n","            / \"rankings.parquet\",\n","\n","        \"build_metrics\":\n","            directory\n","            / \"build_metrics.parquet\",\n","\n","        \"project_run_metrics\":\n","            directory\n","            / \"project_run_metrics.csv\",\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# 5. Metric helpers\n","# ---------------------------------------------------------\n","\n","def calculate_apfd_final(\n","    actual_failures,\n","):\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    number_of_tests = len(\n","        failures\n","    )\n","\n","    number_of_failures = int(\n","        failures.sum()\n","    )\n","\n","    if number_of_tests == 0:\n","        return np.nan\n","\n","    if number_of_failures == 0:\n","        return np.nan\n","\n","    failure_ranks = (\n","        np.flatnonzero(\n","            failures == 1\n","        )\n","        + 1\n","    )\n","\n","    return float(\n","        1.0\n","        - failure_ranks.sum()\n","        / (\n","            number_of_tests\n","            * number_of_failures\n","        )\n","        + 1.0\n","        / (\n","            2.0\n","            * number_of_tests\n","        )\n","    )\n","\n","\n","def calculate_apfdc_final(\n","    actual_failures,\n","    durations,\n","):\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    durations = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","    if len(failures) != len(durations):\n","        raise ValueError(\n","            \"Failure and duration arrays differ in length.\"\n","        )\n","\n","    if len(failures) == 0:\n","        return np.nan\n","\n","    if failures.sum() == 0:\n","        return np.nan\n","\n","    if not np.isfinite(\n","        durations\n","    ).all():\n","        raise ValueError(\n","            \"Non-finite duration encountered.\"\n","        )\n","\n","    if (\n","        durations \u003c 0\n","    ).any():\n","        raise ValueError(\n","            \"Negative duration encountered.\"\n","        )\n","\n","    total_duration = float(\n","        durations.sum()\n","    )\n","\n","    if total_duration \u003c= 0:\n","        return np.nan\n","\n","    cumulative_before = np.concatenate([\n","        np.array(\n","            [0.0]\n","        ),\n","        np.cumsum(\n","            durations\n","        )[:-1],\n","    ])\n","\n","    failure_mask = (\n","        failures == 1\n","    )\n","\n","    midpoint_detection_times = (\n","        cumulative_before[\n","            failure_mask\n","        ]\n","        + 0.5\n","        * durations[\n","            failure_mask\n","        ]\n","    )\n","\n","    return float(\n","        1.0\n","        - np.mean(\n","            midpoint_detection_times\n","            / total_duration\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Stable ranking signature\n","# ---------------------------------------------------------\n","\n","def ranking_signature(\n","    ranking_rows,\n","):\n","    signature_frame = (\n","        ranking_rows[\n","            [\n","                \"Build\",\n","                \"Rank\",\n","                \"Test\",\n","                \"Score\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","    signature_frame[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        signature_frame[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","    signature_frame[\n","        \"Rank\"\n","    ] = pd.to_numeric(\n","        signature_frame[\n","            \"Rank\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","    signature_frame[\n","        \"Test\"\n","    ] = (\n","        signature_frame[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","    signature_frame = (\n","        signature_frame\n","        .sort_values(\n","            [\n","                \"Build\",\n","                \"Rank\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    hashed = (\n","        pd.util.hash_pandas_object(\n","            signature_frame,\n","            index=False,\n","        )\n","        .to_numpy(dtype=np.uint64)\n","    )\n","\n","    return hashlib.sha256(\n","        hashed.tobytes()\n","    ).hexdigest()\n","\n","\n","# ---------------------------------------------------------\n","# 7. Load and validate all 270 conditions\n","# ---------------------------------------------------------\n","\n","audit_start_time = time.time()\n","\n","ranking_frames = []\n","build_metric_frames = []\n","project_run_frames = []\n","fit_time_frames = []\n","noise_summary_frames = []\n","\n","condition_inventory_records = []\n","success_marker_records = []\n","\n","missing_files = []\n","invalid_marker_records = []\n","\n","\n","print(\n","    \"\\n=== LOADING 270 CONDITIONS ===\"\n",")\n","\n","\n","for seed in REPETITION_SEEDS:\n","    for noise in NOISE_LEVELS:\n","        paths = get_condition_paths(\n","            noise,\n","            seed,\n","        )\n","\n","        required_paths = {\n","            key:\n","                paths[key]\n","            for key in [\n","                \"success\",\n","                \"noise_manifest\",\n","                \"noise_summary\",\n","                \"fit_times\",\n","                \"rankings\",\n","                \"build_metrics\",\n","                \"project_run_metrics\",\n","            ]\n","        }\n","\n","        condition_missing = [\n","            str(path)\n","            for path in required_paths.values()\n","            if not path.exists()\n","        ]\n","\n","        if condition_missing:\n","            missing_files.extend(\n","                condition_missing\n","            )\n","\n","            continue\n","\n","        with open(\n","            paths[\n","                \"success\"\n","            ],\n","            \"r\",\n","            encoding=\"utf-8\",\n","        ) as marker_file:\n","            marker = json.load(\n","                marker_file\n","            )\n","\n","        marker_valid = bool(\n","            marker.get(\n","                \"Project\"\n","            ) == PROJECT_NAME\n","            and float(\n","                marker.get(\n","                    \"NoisePercent\"\n","                )\n","            ) == float(noise)\n","            and int(\n","                marker.get(\n","                    \"RepetitionSeed\"\n","                )\n","            ) == int(seed)\n","            and bool(\n","                marker.get(\n","                    \"CompletedSuccessfully\",\n","                    False,\n","                )\n","            )\n","        )\n","\n","        if not marker_valid:\n","            invalid_marker_records.append({\n","                \"NoisePercent\":\n","                    noise,\n","\n","                \"RepetitionSeed\":\n","                    seed,\n","\n","                \"MarkerPath\":\n","                    str(\n","                        paths[\n","                            \"success\"\n","                        ]\n","                    ),\n","            })\n","\n","        success_marker_records.append({\n","            \"NoisePercent\":\n","                int(noise),\n","\n","            \"RepetitionSeed\":\n","                int(seed),\n","\n","            \"MarkerValid\":\n","                marker_valid,\n","\n","            \"CompletedAtUTC\":\n","                marker.get(\n","                    \"CompletedAtUTC\"\n","                ),\n","\n","            \"ElapsedSeconds\":\n","                marker.get(\n","                    \"ElapsedSeconds\"\n","                ),\n","\n","            \"SuccessMarker\":\n","                str(\n","                    paths[\n","                        \"success\"\n","                    ]\n","                ),\n","        })\n","\n","        rankings = pd.read_parquet(\n","            paths[\n","                \"rankings\"\n","            ]\n","        )\n","\n","        build_metrics = pd.read_parquet(\n","            paths[\n","                \"build_metrics\"\n","            ]\n","        )\n","\n","        project_run = pd.read_csv(\n","            paths[\n","                \"project_run_metrics\"\n","            ]\n","        )\n","\n","        fit_times = pd.read_csv(\n","            paths[\n","                \"fit_times\"\n","            ]\n","        )\n","\n","        noise_summary = pd.read_csv(\n","            paths[\n","                \"noise_summary\"\n","            ]\n","        )\n","\n","        for dataframe in [\n","            rankings,\n","            build_metrics,\n","            project_run,\n","            fit_times,\n","        ]:\n","            dataframe[\n","                \"NoisePercent\"\n","            ] = pd.to_numeric(\n","                dataframe[\n","                    \"NoisePercent\"\n","                ],\n","                errors=\"raise\",\n","            ).astype(float)\n","\n","            dataframe[\n","                \"RepetitionSeed\"\n","            ] = pd.to_numeric(\n","                dataframe[\n","                    \"RepetitionSeed\"\n","                ],\n","                errors=\"raise\",\n","            ).astype(int)\n","\n","        rankings[\n","            \"Build\"\n","        ] = pd.to_numeric(\n","            rankings[\n","                \"Build\"\n","            ],\n","            errors=\"raise\",\n","        ).astype(\"int64\")\n","\n","        rankings[\n","            \"Test\"\n","        ] = (\n","            rankings[\n","                \"Test\"\n","            ]\n","            .astype(str)\n","        )\n","\n","        rankings[\n","            \"Rank\"\n","        ] = pd.to_numeric(\n","            rankings[\n","                \"Rank\"\n","            ],\n","            errors=\"raise\",\n","        ).astype(\"int64\")\n","\n","        rankings[\n","            \"Verdict\"\n","        ] = pd.to_numeric(\n","            rankings[\n","                \"Verdict\"\n","            ],\n","            errors=\"raise\",\n","        ).astype(\"int8\")\n","\n","        rankings[\n","            \"ActualFailure\"\n","        ] = pd.to_numeric(\n","            rankings[\n","                \"ActualFailure\"\n","            ],\n","            errors=\"raise\",\n","        ).astype(\"int8\")\n","\n","        rankings[\n","            \"Duration\"\n","        ] = pd.to_numeric(\n","            rankings[\n","                \"Duration\"\n","            ],\n","            errors=\"raise\",\n","        ).astype(float)\n","\n","        rankings[\n","            \"Score\"\n","        ] = pd.to_numeric(\n","            rankings[\n","                \"Score\"\n","            ],\n","            errors=\"coerce\",\n","        )\n","\n","        if len(rankings) != (\n","            EXPECTED_RANKING_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Incorrect ranking count for \"\n","                f\"noise={noise}, seed={seed}.\"\n","            )\n","\n","        if len(build_metrics) != (\n","            EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Incorrect build-metric count for \"\n","                f\"noise={noise}, seed={seed}.\"\n","            )\n","\n","        if len(project_run) != (\n","            EXPECTED_PROJECT_RUN_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Incorrect project-run count for \"\n","                f\"noise={noise}, seed={seed}.\"\n","            )\n","\n","        if len(fit_times) != (\n","            EXPECTED_MODEL_FIT_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Incorrect fit-time count for \"\n","                f\"noise={noise}, seed={seed}.\"\n","            )\n","\n","        if len(noise_summary) != 1:\n","            raise AssertionError(\n","                \"Noise summary does not contain one row \"\n","                f\"for noise={noise}, seed={seed}.\"\n","            )\n","\n","        observed_techniques = set(\n","            project_run[\n","                \"Technique\"\n","            ].astype(str)\n","        )\n","\n","        if observed_techniques != set(\n","            ALL_TECHNIQUES\n","        ):\n","            raise AssertionError(\n","                \"Technique-set mismatch for \"\n","                f\"noise={noise}, seed={seed}.\"\n","            )\n","\n","        condition_inventory_records.append({\n","            \"NoisePercent\":\n","                int(noise),\n","\n","            \"RepetitionSeed\":\n","                int(seed),\n","\n","            \"RankingRows\":\n","                int(\n","                    len(rankings)\n","                ),\n","\n","            \"BuildMetricRows\":\n","                int(\n","                    len(build_metrics)\n","                ),\n","\n","            \"ProjectRunRows\":\n","                int(\n","                    len(project_run)\n","                ),\n","\n","            \"ModelFitRows\":\n","                int(\n","                    len(fit_times)\n","                ),\n","\n","            \"NoiseFlips\":\n","                int(\n","                    noise_summary[\n","                        \"NumberFlipped\"\n","                    ].iloc[0]\n","                ),\n","\n","            \"RealisedNoisePercent\":\n","                float(\n","                    noise_summary[\n","                        \"RealisedNoisePercent\"\n","                    ].iloc[0]\n","                ),\n","\n","            \"ConditionDirectory\":\n","                str(\n","                    paths[\n","                        \"directory\"\n","                    ]\n","                ),\n","        })\n","\n","        noise_summary[\n","            \"NoisePercent\"\n","        ] = float(noise)\n","\n","        noise_summary[\n","            \"RepetitionSeed\"\n","        ] = int(seed)\n","\n","        ranking_frames.append(\n","            rankings\n","        )\n","\n","        build_metric_frames.append(\n","            build_metrics\n","        )\n","\n","        project_run_frames.append(\n","            project_run\n","        )\n","\n","        fit_time_frames.append(\n","            fit_times\n","        )\n","\n","        noise_summary_frames.append(\n","            noise_summary\n","        )\n","\n","    print(\n","        f\"Loaded seed {seed:02d}/30\"\n","    )\n","\n","\n","if missing_files:\n","    raise FileNotFoundError(\n","        \"Some Titan condition files are missing:\\n\"\n","        + \"\\n\".join(\n","            missing_files[:100]\n","        )\n","    )\n","\n","\n","if invalid_marker_records:\n","    display(\n","        pd.DataFrame(\n","            invalid_marker_records\n","        )\n","    )\n","\n","    raise AssertionError(\n","        \"At least one Titan success marker is invalid.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Concatenate all condition outputs\n","# ---------------------------------------------------------\n","\n","all_rankings = pd.concat(\n","    ranking_frames,\n","    ignore_index=True,\n",")\n","\n","all_build_metrics = pd.concat(\n","    build_metric_frames,\n","    ignore_index=True,\n",")\n","\n","all_project_run_metrics = pd.concat(\n","    project_run_frames,\n","    ignore_index=True,\n",")\n","\n","all_fit_times = pd.concat(\n","    fit_time_frames,\n","    ignore_index=True,\n",")\n","\n","all_noise_summaries = pd.concat(\n","    noise_summary_frames,\n","    ignore_index=True,\n",")\n","\n","condition_inventory = pd.DataFrame(\n","    condition_inventory_records\n",")\n","\n","success_marker_audit = pd.DataFrame(\n","    success_marker_records\n",")\n","\n","\n","observed_condition_keys = set(\n","    zip(\n","        condition_inventory[\n","            \"NoisePercent\"\n","        ].astype(int),\n","\n","        condition_inventory[\n","            \"RepetitionSeed\"\n","        ].astype(int),\n","    )\n",")\n","\n","\n","if observed_condition_keys != (\n","    EXPECTED_CONDITION_KEYS\n","):\n","    missing_keys = sorted(\n","        EXPECTED_CONDITION_KEYS\n","        - observed_condition_keys\n","    )\n","\n","    extra_keys = sorted(\n","        observed_condition_keys\n","        - EXPECTED_CONDITION_KEYS\n","    )\n","\n","    raise AssertionError(\n","        \"Condition-key mismatch.\\n\"\n","        f\"Missing: {missing_keys}\\n\"\n","        f\"Extra: {extra_keys}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Global output-count audit\n","# ---------------------------------------------------------\n","\n","count_audit = pd.DataFrame([\n","    {\n","        \"Output\":\n","            \"Conditions\",\n","\n","        \"Expected\":\n","            EXPECTED_CONDITIONS,\n","\n","        \"Observed\":\n","            len(\n","                condition_inventory\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Ranking rows\",\n","\n","        \"Expected\":\n","            EXPECTED_TOTAL_RANKING_ROWS,\n","\n","        \"Observed\":\n","            len(\n","                all_rankings\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Build-metric rows\",\n","\n","        \"Expected\":\n","            EXPECTED_TOTAL_BUILD_METRIC_ROWS,\n","\n","        \"Observed\":\n","            len(\n","                all_build_metrics\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Project-run rows\",\n","\n","        \"Expected\":\n","            EXPECTED_TOTAL_PROJECT_RUN_ROWS,\n","\n","        \"Observed\":\n","            len(\n","                all_project_run_metrics\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Model-fit rows\",\n","\n","        \"Expected\":\n","            EXPECTED_TOTAL_MODEL_FIT_ROWS,\n","\n","        \"Observed\":\n","            len(\n","                all_fit_times\n","            ),\n","    },\n","    {\n","        \"Output\":\n","            \"Noise-summary rows\",\n","\n","        \"Expected\":\n","            EXPECTED_TOTAL_NOISE_SUMMARY_ROWS,\n","\n","        \"Observed\":\n","            len(\n","                all_noise_summaries\n","            ),\n","    },\n","])\n","\n","\n","count_audit[\n","    \"Matches\"\n","] = (\n","    count_audit[\n","        \"Expected\"\n","    ]\n","    == count_audit[\n","        \"Observed\"\n","    ]\n",")\n","\n","\n","if not count_audit[\n","    \"Matches\"\n","].all():\n","    display(\n","        count_audit\n","    )\n","\n","    raise AssertionError(\n","        \"Final Titan count audit failed.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Duplicate-key audits\n","# ---------------------------------------------------------\n","\n","duplicate_condition_rows = int(\n","    condition_inventory.duplicated(\n","        subset=[\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","        ]\n","    ).sum()\n",")\n","\n","\n","duplicate_ranking_rows = int(\n","    all_rankings.duplicated(\n","        subset=[\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ).sum()\n",")\n","\n","\n","duplicate_build_metric_rows = int(\n","    all_build_metrics.duplicated(\n","        subset=[\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","            \"Build\",\n","        ]\n","    ).sum()\n",")\n","\n","\n","duplicate_project_run_rows = int(\n","    all_project_run_metrics.duplicated(\n","        subset=[\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","        ]\n","    ).sum()\n",")\n","\n","\n","duplicate_fit_rows = int(\n","    all_fit_times.duplicated(\n","        subset=[\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","        ]\n","    ).sum()\n",")\n","\n","\n","if any([\n","    duplicate_condition_rows,\n","    duplicate_ranking_rows,\n","    duplicate_build_metric_rows,\n","    duplicate_project_run_rows,\n","    duplicate_fit_rows,\n","]):\n","    raise AssertionError(\n","        \"Duplicate-key audit failed.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. Ranking completeness and rank-sequence audit\n","# ---------------------------------------------------------\n","\n","ranking_group_columns = [\n","    \"NoisePercent\",\n","    \"RepetitionSeed\",\n","    \"Technique\",\n","    \"Build\",\n","]\n","\n","\n","ranking_group_summary = (\n","    all_rankings\n","    .groupby(\n","        ranking_group_columns,\n","        as_index=False,\n","    )\n","    .agg(\n","        RankingRows=(\n","            \"Test\",\n","            \"size\",\n","        ),\n","\n","        UniqueTests=(\n","            \"Test\",\n","            \"nunique\",\n","        ),\n","\n","        MinimumRank=(\n","            \"Rank\",\n","            \"min\",\n","        ),\n","\n","        MaximumRank=(\n","            \"Rank\",\n","            \"max\",\n","        ),\n","\n","        UniqueRanks=(\n","            \"Rank\",\n","            \"nunique\",\n","        ),\n","\n","        FailureCount=(\n","            \"ActualFailure\",\n","            \"sum\",\n","        ),\n","    )\n",")\n","\n","\n","if len(\n","    ranking_group_summary\n",") != 18900:\n","    raise AssertionError(\n","        \"Unexpected number of ranked \"\n","        \"Technique-Build groups.\"\n","    )\n","\n","\n","all_rankings_rank_sorted = (\n","    all_rankings\n","    .sort_values(\n","        ranking_group_columns\n","        + [\n","            \"Rank\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .copy()\n",")\n","\n","\n","all_rankings_rank_sorted[\n","    \"_ExpectedRank\"\n","] = (\n","    all_rankings_rank_sorted\n","    .groupby(\n","        ranking_group_columns,\n","        sort=False,\n","    )\n","    .cumcount()\n","    + 1\n",")\n","\n","\n","rank_sequence_violations = int(\n","    (\n","        all_rankings_rank_sorted[\n","            \"Rank\"\n","        ]\n","        != all_rankings_rank_sorted[\n","            \"_ExpectedRank\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","duplicate_test_within_ranking = int(\n","    all_rankings.duplicated(\n","        subset=(\n","            ranking_group_columns\n","            + [\n","                \"Test\",\n","            ]\n","        )\n","    ).sum()\n",")\n","\n","\n","if rank_sequence_violations != 0:\n","    raise AssertionError(\n","        \"Ranking sequences contain gaps or duplicates.\"\n","    )\n","\n","\n","if duplicate_test_within_ranking != 0:\n","    raise AssertionError(\n","        \"A ranking contains duplicate tests.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. Tie-breaking and score-order audit\n","# ---------------------------------------------------------\n","\n","expected_order_frames = []\n","\n","\n","non_qtf_rankings = (\n","    all_rankings[\n","        all_rankings[\n","            \"Technique\"\n","        ] != \"QTF-Avg\"\n","    ]\n","    .copy()\n",")\n","\n","\n","non_qtf_rankings = (\n","    non_qtf_rankings\n","    .sort_values(\n","        ranking_group_columns\n","        + [\n","            \"Score\",\n","            \"Test\",\n","        ],\n","        ascending=[\n","            True,\n","            True,\n","            True,\n","            True,\n","            False,\n","            True,\n","        ],\n","        kind=\"mergesort\",\n","    )\n",")\n","\n","\n","non_qtf_rankings[\n","    \"_ExpectedRankFromScore\"\n","] = (\n","    non_qtf_rankings\n","    .groupby(\n","        ranking_group_columns,\n","        sort=False,\n","    )\n","    .cumcount()\n","    + 1\n",")\n","\n","\n","qtf_rankings = (\n","    all_rankings[\n","        all_rankings[\n","            \"Technique\"\n","        ] == \"QTF-Avg\"\n","    ]\n","    .copy()\n",")\n","\n","\n","qtf_rankings = (\n","    qtf_rankings\n","    .sort_values(\n","        ranking_group_columns\n","        + [\n","            \"Score\",\n","            \"Test\",\n","        ],\n","        ascending=[\n","            True,\n","            True,\n","            True,\n","            True,\n","            True,\n","            True,\n","        ],\n","        kind=\"mergesort\",\n","    )\n",")\n","\n","\n","qtf_rankings[\n","    \"_ExpectedRankFromScore\"\n","] = (\n","    qtf_rankings\n","    .groupby(\n","        ranking_group_columns,\n","        sort=False,\n","    )\n","    .cumcount()\n","    + 1\n",")\n","\n","\n","expected_score_order = pd.concat(\n","    [\n","        non_qtf_rankings[\n","            ranking_group_columns\n","            + [\n","                \"Test\",\n","                \"_ExpectedRankFromScore\",\n","            ]\n","        ],\n","\n","        qtf_rankings[\n","            ranking_group_columns\n","            + [\n","                \"Test\",\n","                \"_ExpectedRankFromScore\",\n","            ]\n","        ],\n","    ],\n","    ignore_index=True,\n",")\n","\n","\n","score_order_audit = (\n","    all_rankings[\n","        ranking_group_columns\n","        + [\n","            \"Test\",\n","            \"Rank\",\n","        ]\n","    ]\n","    .merge(\n","        expected_score_order,\n","        on=(\n","            ranking_group_columns\n","            + [\n","                \"Test\",\n","            ]\n","        ),\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","\n","score_order_violations = int(\n","    (\n","        score_order_audit[\n","            \"Rank\"\n","        ]\n","        != score_order_audit[\n","            \"_ExpectedRankFromScore\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","if score_order_violations != 0:\n","    raise AssertionError(\n","        \"Score ordering or Test tie-breaking failed.\"\n","    )\n","\n","\n","non_qtf_nonfinite_scores = int(\n","    (\n","        ~np.isfinite(\n","            pd.to_numeric(\n","                all_rankings.loc[\n","                    all_rankings[\n","                        \"Technique\"\n","                    ] != \"QTF-Avg\",\n","                    \"Score\",\n","                ],\n","                errors=\"coerce\",\n","            ).to_numpy(dtype=float)\n","        )\n","    ).sum()\n",")\n","\n","\n","missing_scores = int(\n","    all_rankings[\n","        \"Score\"\n","    ].isna().sum()\n",")\n","\n","\n","if missing_scores != 0:\n","    raise AssertionError(\n","        \"Ranking scores contain missing values.\"\n","    )\n","\n","\n","if non_qtf_nonfinite_scores != 0:\n","    raise AssertionError(\n","        \"A non-QTF technique contains a non-finite score.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. Clean evaluation consistency across all conditions\n","# ---------------------------------------------------------\n","\n","reference_evaluation = (\n","    all_rankings[\n","        (\n","            all_rankings[\n","                \"NoisePercent\"\n","            ] == 0\n","        )\n","        \u0026 (\n","            all_rankings[\n","                \"RepetitionSeed\"\n","            ] == 1\n","        )\n","        \u0026 (\n","            all_rankings[\n","                \"Technique\"\n","            ] == \"RandomForest\"\n","        )\n","    ][\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"Verdict\",\n","            \"Duration\",\n","            \"ActualFailure\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .drop_duplicates(\n","        subset=[\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    )\n","    .copy()\n",")\n","\n","\n","if len(\n","    reference_evaluation\n",") != EXPECTED_EVALUATION_ROWS:\n","    raise AssertionError(\n","        \"Reference evaluation cohort does not \"\n","        \"contain 363 Build-Test rows.\"\n","    )\n","\n","\n","if reference_evaluation[\n","    \"Build\"\n","].nunique() != EXPECTED_EVALUATION_BUILDS:\n","    raise AssertionError(\n","        \"Reference evaluation cohort does not \"\n","        \"contain 10 builds.\"\n","    )\n","\n","\n","if int(\n","    reference_evaluation[\n","        \"ActualFailure\"\n","    ].sum()\n",") != EXPECTED_EVALUATION_FAILURES:\n","    raise AssertionError(\n","        \"Reference evaluation cohort does not \"\n","        \"contain 13 failures.\"\n","    )\n","\n","\n","evaluation_consistency = (\n","    all_rankings[\n","        [\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","            \"Build\",\n","            \"Test\",\n","            \"Verdict\",\n","            \"Duration\",\n","            \"ActualFailure\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .merge(\n","        reference_evaluation,\n","        on=[\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        how=\"left\",\n","        validate=\"many_to_one\",\n","        suffixes=(\n","            \"_Observed\",\n","            \"_Reference\",\n","        ),\n","        indicator=True,\n","    )\n",")\n","\n","\n","evaluation_missing_reference_rows = int(\n","    (\n","        evaluation_consistency[\n","            \"_merge\"\n","        ] != \"both\"\n","    ).sum()\n",")\n","\n","\n","evaluation_verdict_mismatches = int(\n","    (\n","        evaluation_consistency[\n","            \"Verdict_Observed\"\n","        ]\n","        != evaluation_consistency[\n","            \"Verdict_Reference\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","evaluation_failure_mismatches = int(\n","    (\n","        evaluation_consistency[\n","            \"ActualFailure_Observed\"\n","        ]\n","        != evaluation_consistency[\n","            \"ActualFailure_Reference\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","evaluation_duration_mismatches = int(\n","    (\n","        ~np.isclose(\n","            evaluation_consistency[\n","                \"Duration_Observed\"\n","            ].to_numpy(dtype=float),\n","\n","            evaluation_consistency[\n","                \"Duration_Reference\"\n","            ].to_numpy(dtype=float),\n","\n","            rtol=0.0,\n","            atol=0.0,\n","            equal_nan=True,\n","        )\n","    ).sum()\n",")\n","\n","\n","evaluation_build_order_mismatches = int(\n","    (\n","        evaluation_consistency[\n","            \"build_order_Observed\"\n","        ]\n","        != evaluation_consistency[\n","            \"build_order_Reference\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","if any([\n","    evaluation_missing_reference_rows,\n","    evaluation_verdict_mismatches,\n","    evaluation_failure_mismatches,\n","    evaluation_duration_mismatches,\n","    evaluation_build_order_mismatches,\n","]):\n","    raise AssertionError(\n","        \"Clean evaluation consistency audit failed.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 14. Recompute APFD and APFDc from every ranking\n","# ---------------------------------------------------------\n","\n","print(\n","    \"\\n=== RECOMPUTING ALL 18,900 BUILD METRICS ===\"\n",")\n","\n","\n","recomputed_metric_records = []\n","\n","\n","for (\n","    noise,\n","    seed,\n","    technique,\n","    build_id,\n","), ranked_build in (\n","    all_rankings.groupby(\n","        ranking_group_columns,\n","        sort=False,\n","    )\n","):\n","    ranked_build = (\n","        ranked_build\n","        .sort_values(\n","            \"Rank\",\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    failures = (\n","        ranked_build[\n","            \"ActualFailure\"\n","        ]\n","        .to_numpy(dtype=int)\n","    )\n","\n","    durations = (\n","        ranked_build[\n","            \"Duration\"\n","        ]\n","        .to_numpy(dtype=float)\n","    )\n","\n","    recomputed_metric_records.append({\n","        \"NoisePercent\":\n","            float(noise),\n","\n","        \"RepetitionSeed\":\n","            int(seed),\n","\n","        \"Technique\":\n","            str(technique),\n","\n","        \"Build\":\n","            int(build_id),\n","\n","        \"RecomputedNumberOfTests\":\n","            int(\n","                len(ranked_build)\n","            ),\n","\n","        \"RecomputedNumberOfFailures\":\n","            int(\n","                failures.sum()\n","            ),\n","\n","        \"RecomputedAPFD\":\n","            calculate_apfd_final(\n","                failures\n","            ),\n","\n","        \"RecomputedAPFDc\":\n","            calculate_apfdc_final(\n","                failures,\n","                durations,\n","            ),\n","    })\n","\n","\n","recomputed_build_metrics = pd.DataFrame(\n","    recomputed_metric_records\n",")\n","\n","\n","metric_comparison = (\n","    all_build_metrics\n","    .merge(\n","        recomputed_build_metrics,\n","        on=[\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","            \"Build\",\n","        ],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","\n","metric_test_count_mismatches = int(\n","    (\n","        metric_comparison[\n","            \"NumberOfTests\"\n","        ]\n","        != metric_comparison[\n","            \"RecomputedNumberOfTests\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","metric_failure_count_mismatches = int(\n","    (\n","        metric_comparison[\n","            \"NumberOfFailures\"\n","        ]\n","        != metric_comparison[\n","            \"RecomputedNumberOfFailures\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","metric_apfd_mismatches = int(\n","    (\n","        ~np.isclose(\n","            metric_comparison[\n","                \"APFD\"\n","            ].to_numpy(dtype=float),\n","\n","            metric_comparison[\n","                \"RecomputedAPFD\"\n","            ].to_numpy(dtype=float),\n","\n","            rtol=1e-12,\n","            atol=1e-12,\n","            equal_nan=True,\n","        )\n","    ).sum()\n",")\n","\n","\n","metric_apfdc_mismatches = int(\n","    (\n","        ~np.isclose(\n","            metric_comparison[\n","                \"APFDc\"\n","            ].to_numpy(dtype=float),\n","\n","            metric_comparison[\n","                \"RecomputedAPFDc\"\n","            ].to_numpy(dtype=float),\n","\n","            rtol=1e-12,\n","            atol=1e-12,\n","            equal_nan=True,\n","        )\n","    ).sum()\n",")\n","\n","\n","if any([\n","    metric_test_count_mismatches,\n","    metric_failure_count_mismatches,\n","    metric_apfd_mismatches,\n","    metric_apfdc_mismatches,\n","]):\n","    raise AssertionError(\n","        \"Stored build metrics do not match \"\n","        \"metrics recomputed from rankings.\"\n","    )\n","\n","\n","if not all_build_metrics[\n","    \"APFD\"\n","].between(\n","    0.0,\n","    1.0,\n","    inclusive=\"both\",\n",").all():\n","    raise AssertionError(\n","        \"Stored APFD values lie outside [0, 1].\"\n","    )\n","\n","\n","if not all_build_metrics[\n","    \"APFDc\"\n","].between(\n","    0.0,\n","    1.0,\n","    inclusive=\"both\",\n",").all():\n","    raise AssertionError(\n","        \"Stored APFDc values lie outside [0, 1].\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 15. Recompute project-run aggregation\n","# ---------------------------------------------------------\n","\n","recomputed_project_runs = (\n","    all_build_metrics\n","    .groupby(\n","        [\n","            \"Project\",\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","        ],\n","        as_index=False,\n","    )\n","    .agg(\n","        RecomputedMeanAPFD=(\n","            \"APFD\",\n","            \"mean\",\n","        ),\n","\n","        RecomputedMeanAPFDc=(\n","            \"APFDc\",\n","            \"mean\",\n","        ),\n","\n","        RecomputedSD_APFD=(\n","            \"APFD\",\n","            \"std\",\n","        ),\n","\n","        RecomputedSD_APFDc=(\n","            \"APFDc\",\n","            \"std\",\n","        ),\n","\n","        RecomputedEvaluatedBuilds=(\n","            \"Build\",\n","            \"nunique\",\n","        ),\n","\n","        RecomputedTotalRankedTests=(\n","            \"NumberOfTests\",\n","            \"sum\",\n","        ),\n","\n","        RecomputedTotalFailures=(\n","            \"NumberOfFailures\",\n","            \"sum\",\n","        ),\n","    )\n",")\n","\n","\n","project_run_comparison = (\n","    all_project_run_metrics\n","    .merge(\n","        recomputed_project_runs,\n","        on=[\n","            \"Project\",\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","        ],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","\n","project_run_count_mismatches = int(\n","    (\n","        project_run_comparison[\n","            \"EvaluatedBuilds\"\n","        ]\n","        != project_run_comparison[\n","            \"RecomputedEvaluatedBuilds\"\n","        ]\n","    ).sum()\n","    + (\n","        project_run_comparison[\n","            \"TotalRankedTests\"\n","        ]\n","        != project_run_comparison[\n","            \"RecomputedTotalRankedTests\"\n","        ]\n","    ).sum()\n","    + (\n","        project_run_comparison[\n","            \"TotalFailures\"\n","        ]\n","        != project_run_comparison[\n","            \"RecomputedTotalFailures\"\n","        ]\n","    ).sum()\n",")\n","\n","\n","project_run_metric_mismatches = 0\n","\n","\n","for stored_column, recomputed_column in [\n","    (\n","        \"MeanAPFD\",\n","        \"RecomputedMeanAPFD\",\n","    ),\n","    (\n","        \"MeanAPFDc\",\n","        \"RecomputedMeanAPFDc\",\n","    ),\n","    (\n","        \"SD_APFD\",\n","        \"RecomputedSD_APFD\",\n","    ),\n","    (\n","        \"SD_APFDc\",\n","        \"RecomputedSD_APFDc\",\n","    ),\n","]:\n","    project_run_metric_mismatches += int(\n","        (\n","            ~np.isclose(\n","                project_run_comparison[\n","                    stored_column\n","                ].to_numpy(dtype=float),\n","\n","                project_run_comparison[\n","                    recomputed_column\n","                ].to_numpy(dtype=float),\n","\n","                rtol=1e-12,\n","                atol=1e-12,\n","                equal_nan=True,\n","            )\n","        ).sum()\n","    )\n","\n","\n","if project_run_count_mismatches != 0:\n","    raise AssertionError(\n","        \"Project-run count aggregation mismatch.\"\n","    )\n","\n","\n","if project_run_metric_mismatches != 0:\n","    raise AssertionError(\n","        \"Project-run metric aggregation mismatch.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 16. Ranking-signature audit\n","# ---------------------------------------------------------\n","\n","print(\n","    \"\\n=== CROSS-CONDITION RANKING INVARIANCE AUDIT ===\"\n",")\n","\n","\n","signature_records = []\n","\n","\n","for (\n","    noise,\n","    seed,\n","    technique,\n","), technique_rows in (\n","    all_rankings.groupby(\n","        [\n","            \"NoisePercent\",\n","            \"RepetitionSeed\",\n","            \"Technique\",\n","        ],\n","        sort=False,\n","    )\n","):\n","    signature_records.append({\n","        \"NoisePercent\":\n","            int(noise),\n","\n","        \"RepetitionSeed\":\n","            int(seed),\n","\n","        \"Technique\":\n","            str(technique),\n","\n","        \"RankingSignature\":\n","            ranking_signature(\n","                technique_rows\n","            ),\n","    })\n","\n","\n","ranking_signatures = pd.DataFrame(\n","    signature_records\n",")\n","\n","\n","# Random must be identical across noise levels\n","# for the same seed.\n","random_signature_audit = (\n","    ranking_signatures[\n","        ranking_signatures[\n","            \"Technique\"\n","        ] == \"Random\"\n","    ]\n","    .groupby(\n","        \"RepetitionSeed\",\n","        as_index=False,\n","    )\n","    .agg(\n","        NoiseConditions=(\n","            \"NoisePercent\",\n","            \"nunique\",\n","        ),\n","\n","        UniqueRankingSignatures=(\n","            \"RankingSignature\",\n","            \"nunique\",\n","        ),\n","    )\n",")\n","\n","\n","random_noise_invariance_violations = int(\n","    (\n","        random_signature_audit[\n","            \"UniqueRankingSignatures\"\n","        ] != 1\n","    ).sum()\n",")\n","\n","\n","random_unique_seed_signatures = int(\n","    ranking_signatures[\n","        ranking_signatures[\n","            \"Technique\"\n","        ] == \"Random\"\n","    ][\n","        [\n","            \"RepetitionSeed\",\n","            \"RankingSignature\",\n","        ]\n","    ]\n","    .drop_duplicates()[\n","        \"RankingSignature\"\n","    ]\n","    .nunique()\n",")\n","\n","\n","if random_noise_invariance_violations != 0:\n","    raise AssertionError(\n","        \"Random rankings changed across noise levels \"\n","        \"for the same seed.\"\n","    )\n","\n","\n","if random_unique_seed_signatures \u003c= 1:\n","    raise AssertionError(\n","        \"Random rankings did not vary across seeds.\"\n","    )\n","\n","\n","# QTF-Avg must be identical across every noise and seed.\n","qtf_unique_signatures = int(\n","    ranking_signatures[\n","        ranking_signatures[\n","            \"Technique\"\n","        ] == \"QTF-Avg\"\n","    ][\n","        \"RankingSignature\"\n","    ].nunique()\n",")\n","\n","\n","if qtf_unique_signatures != 1:\n","    raise AssertionError(\n","        \"QTF-Avg rankings changed across conditions.\"\n","    )\n","\n","\n","# At 0% noise, deterministic Naive Bayes,\n","# LatestFail and QTF-Avg must be identical across seeds.\n","zero_percent_deterministic_records = []\n","\n","\n","for technique in [\n","    \"NaiveBayes\",\n","    \"LatestFail\",\n","    \"QTF-Avg\",\n","]:\n","    unique_signatures = int(\n","        ranking_signatures[\n","            (\n","                ranking_signatures[\n","                    \"NoisePercent\"\n","                ] == 0\n","            )\n","            \u0026 (\n","                ranking_signatures[\n","                    \"Technique\"\n","                ] == technique\n","            )\n","        ][\n","            \"RankingSignature\"\n","        ].nunique()\n","    )\n","\n","    zero_percent_deterministic_records.append({\n","        \"Technique\":\n","            technique,\n","\n","        \"UniqueZeroPercentSignatures\":\n","            unique_signatures,\n","\n","        \"Expected\":\n","            1,\n","\n","        \"Matches\":\n","            bool(\n","                unique_signatures == 1\n","            ),\n","    })\n","\n","\n","zero_percent_deterministic_audit = pd.DataFrame(\n","    zero_percent_deterministic_records\n",")\n","\n","\n","if not zero_percent_deterministic_audit[\n","    \"Matches\"\n","].all():\n","    raise AssertionError(\n","        \"A deterministic 0% technique changed \"\n","        \"across seeds.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 17. Full nested-mask and manifest audit\n","# ---------------------------------------------------------\n","\n","print(\n","    \"\\n=== VALIDATING 270 NOISE MANIFESTS ===\"\n",")\n","\n","\n","manifest_audit_records = []\n","nested_mask_records = []\n","\n","total_nested_mask_violations = 0\n","total_manifest_direction_violations = 0\n","total_manifest_threshold_violations = 0\n","total_manifest_identity_violations = 0\n","total_summary_flip_mismatches = 0\n","\n","\n","for seed in REPETITION_SEEDS:\n","    reference_manifest = None\n","    previous_mask = None\n","    previous_noise = None\n","\n","    for noise in NOISE_LEVELS:\n","        paths = get_condition_paths(\n","            noise,\n","            seed,\n","        )\n","\n","        manifest = pd.read_parquet(\n","            paths[\n","                \"noise_manifest\"\n","            ]\n","        )\n","\n","        summary = pd.read_csv(\n","            paths[\n","                \"noise_summary\"\n","            ]\n","        )\n","\n","        if len(manifest) != (\n","            EXPECTED_RAW_TRAINING_ROWS\n","        ):\n","            raise AssertionError(\n","                \"Manifest row count mismatch for \"\n","                f\"noise={noise}, seed={seed}.\"\n","            )\n","\n","        required_manifest_columns = [\n","            \"NoiseRowID\",\n","            \"Build\",\n","            \"Test\",\n","            \"OriginalVerdict\",\n","            \"NoisyVerdict\",\n","            \"FlipUniform\",\n","            \"SampledFailureSubtype\",\n","            \"Flipped\",\n","            \"PassToFailure\",\n","            \"FailureToPass\",\n","        ]\n","\n","        missing_manifest_columns = [\n","            column\n","            for column\n","            in required_manifest_columns\n","            if column not in manifest.columns\n","        ]\n","\n","        if missing_manifest_columns:\n","            raise KeyError(\n","                \"Manifest is missing columns:\\n\"\n","                + \"\\n\".join(\n","                    missing_manifest_columns\n","                )\n","            )\n","\n","        manifest[\n","            \"Test\"\n","        ] = (\n","            manifest[\n","                \"Test\"\n","            ]\n","            .astype(str)\n","        )\n","\n","        original_verdicts = (\n","            pd.to_numeric(\n","                manifest[\n","                    \"OriginalVerdict\"\n","                ],\n","                errors=\"raise\",\n","            )\n","            .astype(int)\n","            .to_numpy()\n","        )\n","\n","        noisy_verdicts = (\n","            pd.to_numeric(\n","                manifest[\n","                    \"NoisyVerdict\"\n","                ],\n","                errors=\"raise\",\n","            )\n","            .astype(int)\n","            .to_numpy()\n","        )\n","\n","        uniforms = (\n","            pd.to_numeric(\n","                manifest[\n","                    \"FlipUniform\"\n","                ],\n","                errors=\"raise\",\n","            )\n","            .astype(float)\n","            .to_numpy()\n","        )\n","\n","        flipped = (\n","            manifest[\n","                \"Flipped\"\n","            ]\n","            .astype(bool)\n","            .to_numpy()\n","        )\n","\n","        expected_flipped = (\n","            uniforms\n","            \u003c float(noise) / 100.0\n","        )\n","\n","        threshold_violations = int(\n","            (\n","                flipped\n","                != expected_flipped\n","            ).sum()\n","        )\n","\n","        total_manifest_threshold_violations += (\n","            threshold_violations\n","        )\n","\n","        selected_failure = (\n","            flipped\n","            \u0026 (\n","                original_verdicts != 0\n","            )\n","        )\n","\n","        selected_pass = (\n","            flipped\n","            \u0026 (\n","                original_verdicts == 0\n","            )\n","        )\n","\n","        unselected = (\n","            ~flipped\n","        )\n","\n","        failure_to_pass_violations = int(\n","            (\n","                noisy_verdicts[\n","                    selected_failure\n","                ]\n","                != 0\n","            ).sum()\n","        )\n","\n","        pass_to_failure_violations = int(\n","            (\n","                noisy_verdicts[\n","                    selected_pass\n","                ]\n","                == 0\n","            ).sum()\n","        )\n","\n","        unselected_change_violations = int(\n","            (\n","                noisy_verdicts[\n","                    unselected\n","                ]\n","                != original_verdicts[\n","                    unselected\n","                ]\n","            ).sum()\n","        )\n","\n","        direction_violations = int(\n","            failure_to_pass_violations\n","            + pass_to_failure_violations\n","            + unselected_change_violations\n","        )\n","\n","        total_manifest_direction_violations += (\n","            direction_violations\n","        )\n","\n","        summary_flip_count = int(\n","            summary[\n","                \"NumberFlipped\"\n","            ].iloc[0]\n","        )\n","\n","        actual_flip_count = int(\n","            flipped.sum()\n","        )\n","\n","        summary_flip_mismatch = int(\n","            summary_flip_count\n","            != actual_flip_count\n","        )\n","\n","        total_summary_flip_mismatches += (\n","            summary_flip_mismatch\n","        )\n","\n","        if reference_manifest is None:\n","            reference_manifest = (\n","                manifest[\n","                    [\n","                        \"NoiseRowID\",\n","                        \"Build\",\n","                        \"Test\",\n","                        \"OriginalVerdict\",\n","                        \"FlipUniform\",\n","                        \"SampledFailureSubtype\",\n","                    ]\n","                ]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","        else:\n","            current_identity = (\n","                manifest[\n","                    [\n","                        \"NoiseRowID\",\n","                        \"Build\",\n","                        \"Test\",\n","                        \"OriginalVerdict\",\n","                        \"FlipUniform\",\n","                        \"SampledFailureSubtype\",\n","                    ]\n","                ]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","            identity_equal = bool(\n","                reference_manifest.equals(\n","                    current_identity\n","                )\n","            )\n","\n","            identity_violation = int(\n","                not identity_equal\n","            )\n","\n","            total_manifest_identity_violations += (\n","                identity_violation\n","            )\n","\n","        if previous_mask is not None:\n","            nested_violations = int(\n","                (\n","                    previous_mask\n","                    \u0026 ~flipped\n","                ).sum()\n","            )\n","\n","            total_nested_mask_violations += (\n","                nested_violations\n","            )\n","\n","            nested_mask_records.append({\n","                \"RepetitionSeed\":\n","                    int(seed),\n","\n","                \"LowerNoisePercent\":\n","                    int(\n","                        previous_noise\n","                    ),\n","\n","                \"HigherNoisePercent\":\n","                    int(noise),\n","\n","                \"LowerFlippedRows\":\n","                    int(\n","                        previous_mask.sum()\n","                    ),\n","\n","                \"HigherFlippedRows\":\n","                    int(\n","                        flipped.sum()\n","                    ),\n","\n","                \"NestedMaskViolations\":\n","                    nested_violations,\n","\n","                \"Nested\":\n","                    bool(\n","                        nested_violations == 0\n","                    ),\n","            })\n","\n","        previous_mask = (\n","            flipped.copy()\n","        )\n","\n","        previous_noise = (\n","            noise\n","        )\n","\n","        manifest_audit_records.append({\n","            \"NoisePercent\":\n","                int(noise),\n","\n","            \"RepetitionSeed\":\n","                int(seed),\n","\n","            \"Rows\":\n","                int(\n","                    len(manifest)\n","                ),\n","\n","            \"NumberFlipped\":\n","                actual_flip_count,\n","\n","            \"RealisedNoisePercent\":\n","                float(\n","                    100.0\n","                    * actual_flip_count\n","                    / len(manifest)\n","                ),\n","\n","            \"ThresholdViolations\":\n","                threshold_violations,\n","\n","            \"DirectionViolations\":\n","                direction_violations,\n","\n","            \"SummaryFlipMismatch\":\n","                summary_flip_mismatch,\n","        })\n","\n","    print(\n","        f\"Validated manifest seed {seed:02d}/30\"\n","    )\n","\n","\n","manifest_audit = pd.DataFrame(\n","    manifest_audit_records\n",")\n","\n","nested_mask_audit = pd.DataFrame(\n","    nested_mask_records\n",")\n","\n","\n","if total_nested_mask_violations != 0:\n","    raise AssertionError(\n","        \"Nested-mask audit failed.\"\n","    )\n","\n","\n","if total_manifest_direction_violations != 0:\n","    raise AssertionError(\n","        \"Manifest flip-direction audit failed.\"\n","    )\n","\n","\n","if total_manifest_threshold_violations != 0:\n","    raise AssertionError(\n","        \"Manifest threshold audit failed.\"\n","    )\n","\n","\n","if total_manifest_identity_violations != 0:\n","    raise AssertionError(\n","        \"Common-uniform identity audit failed.\"\n","    )\n","\n","\n","if total_summary_flip_mismatches != 0:\n","    raise AssertionErro