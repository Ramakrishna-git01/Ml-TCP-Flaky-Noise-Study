       )\n","            ),\n","\n","        \"scored_evaluation_builds\":\n","            int(\n","                clean_evaluation_data[\n","                    \"Build\"\n","                ].nunique()\n","            ),\n","    },\n","\n","    \"noise_levels_percent\":\n","        NOISE_LEVELS,\n","\n","    \"repetition_seeds\":\n","        REPETITION_SEEDS,\n","\n","    \"recent_window\":\n","        RECENT_WINDOW,\n","\n","    \"noise_partition\":\n","        \"training raw execution history only\",\n","\n","    \"evaluation_partition\":\n","        \"clean and immutable\",\n","\n","    \"noise_unit\":\n","        \"individual raw training execution verdict\",\n","\n","    \"flip_rule\": {\n","        \"pass_to_failure\": (\n","            \"verdict 0 becomes a failure subtype sampled \"\n","            \"from the clean project-specific failure \"\n","            \"subtype distribution\"\n","        ),\n","\n","        \"failure_to_pass\": (\n","            \"every non-zero verdict becomes verdict 0\"\n","        ),\n","    },\n","\n","    \"randomisation\": (\n","        \"deterministic project-specific streams; the \"\n","        \"same seed uses one common uniform stream across \"\n","        \"all noise levels, producing nested masks\"\n","    ),\n","\n","    \"feature_handling\": (\n","        \"recompute all 19 REC features from the \"\n","        \"corrupted raw training history\"\n","    ),\n","\n","    \"training_instance_cohort\": (\n","        \"preserve the fixed TCP-CI model-ready \"\n","        \"Build-Test training rows\"\n","    ),\n","\n","    \"unmatched_mapping_resolution\": {\n","        \"unmatched_build_commit_pairs\":\n","            3,\n","\n","        \"affected_builds\":\n","            3,\n","\n","        \"affected_model_ready_rows\":\n","            0,\n","\n","        \"treatment\": (\n","            \"preserve the builds in execution history \"\n","            \"with empty changed-entity sets\"\n","        ),\n","\n","        \"clean_rec_validation\":\n","            \"all 19 REC features matched dataset.csv\",\n","    },\n","\n","    \"model_training\": (\n","        \"one model per project, noise level, \"\n","        \"repetition seed and ML technique\"\n","    ),\n","\n","    \"rolling_ml_retraining\":\n","        False,\n","\n","    \"primary_metric\":\n","        \"APFDc\",\n","\n","    \"secondary_metric\":\n","        \"APFD\",\n","\n","    \"ml_techniques\":\n","        ML_TECHNIQUES,\n","\n","    \"baselines\":\n","        BASELINE_TECHNIQUES,\n","\n","    \"tie_rule\":\n","        \"score first, Test ascending\",\n","\n","    \"status\":\n","        \"frozen\",\n","}\n","\n","\n","PROTOCOL_PATH = (\n","    NOTES_DRIVE\n","    / (\n","        \"eclipse__paho.mqtt.java_\"\n","        \"experiment_protocol_v1.json\"\n","    )\n",")\n","\n","\n","with open(\n","    PROTOCOL_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as protocol_file:\n","\n","    json.dump(\n","        EXPERIMENT_PROTOCOL,\n","        protocol_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Recreate clean raw history partitions\n","# ---------------------------------------------------------\n","\n","clean_training_history = (\n","    exe_for_rec[\n","        exe_for_rec[\n","            \"build\"\n","        ].isin(\n","            training_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","clean_evaluation_history = (\n","    exe_for_rec[\n","        exe_for_rec[\n","            \"build\"\n","        ].isin(\n","            evaluation_build_ids\n","        )\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","EXPECTED_TRAINING_EXECUTION_ROWS = 9422\n","EXPECTED_EVALUATION_EXECUTION_ROWS = 4635\n","\n","\n","if len(\n","    clean_training_history\n",") != EXPECTED_TRAINING_EXECUTION_ROWS:\n","\n","    raise AssertionError(\n","        \"Unexpected raw training-history row count: \"\n","        f\"{len(clean_training_history)}\"\n","    )\n","\n","\n","if len(\n","    clean_evaluation_history\n",") != EXPECTED_EVALUATION_EXECUTION_ROWS:\n","\n","    raise AssertionError(\n","        \"Unexpected raw evaluation-history row count: \"\n","        f\"{len(clean_evaluation_history)}\"\n","    )\n","\n","\n","clean_training_history[\n","    \"verdict\"\n","] = pd.to_numeric(\n","    clean_training_history[\n","        \"verdict\"\n","    ],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","clean_evaluation_history[\n","    \"verdict\"\n","] = pd.to_numeric(\n","    clean_evaluation_history[\n","        \"verdict\"\n","    ],\n","    errors=\"raise\",\n",").astype(int)\n","\n","\n","clean_failure_subtype_distribution = (\n","    clean_training_history.loc[\n","        clean_training_history[\n","            \"verdict\"\n","        ] != 0,\n","        \"verdict\",\n","    ]\n","    .value_counts()\n","    .sort_index()\n",")\n","\n","\n","if clean_failure_subtype_distribution.empty:\n","    raise AssertionError(\n","        \"No raw training failure subtype exists.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Deterministic project-specific random seeds\n","# ---------------------------------------------------------\n","\n","def stable_project_seed(\n","    project_name,\n","    repetition_seed,\n","    random_stream,\n","):\n","    \"\"\"\n","    Generate one reproducible 32-bit seed using the\n","    project, repetition seed and random-stream name.\n","    \"\"\"\n","\n","    seed_text = (\n","        f\"{project_name}|\"\n","        f\"{int(repetition_seed)}|\"\n","        f\"{random_stream}\"\n","    )\n","\n","    digest = hashlib.sha256(\n","        seed_text.encode(\n","            \"utf-8\"\n","        )\n","    ).digest()\n","\n","    return int.from_bytes(\n","        digest[:8],\n","        byteorder=\"little\",\n","        signed=False,\n","    ) % (\n","        2 ** 32\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Inject verdict noise into raw training history\n","# ---------------------------------------------------------\n","\n","def inject_training_verdict_noise(\n","    execution_history,\n","    noise_percent,\n","    repetition_seed,\n","    project_name=PROJECT_NAME,\n","):\n","    \"\"\"\n","    Flip each raw training verdict independently with\n","    probability noise_percent / 100.\n","\n","    The flip-uniform stream depends on project and seed,\n","    but not on the noise percentage. Therefore, masks are\n","    nested as noise increases within a seed.\n","    \"\"\"\n","\n","    noise_percent = float(\n","        noise_percent\n","    )\n","\n","    if not (\n","        0.0\n","        \u003c= noise_percent\n","        \u003c= 100.0\n","    ):\n","        raise ValueError(\n","            \"noise_percent must be between 0 and 100.\"\n","        )\n","\n","\n","    noisy_history = (\n","        execution_history\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    original_verdict = pd.to_numeric(\n","        noisy_history[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\n","        int\n","    ).to_numpy()\n","\n","\n","    number_of_rows = len(\n","        noisy_history\n","    )\n","\n","    if number_of_rows == 0:\n","        raise ValueError(\n","            \"execution_history is empty.\"\n","        )\n","\n","\n","    clean_failure_verdicts = (\n","        pd.Series(\n","            original_verdict[\n","                original_verdict != 0\n","            ]\n","        )\n","        .value_counts()\n","        .sort_index()\n","    )\n","\n","\n","    if clean_failure_verdicts.empty:\n","        raise ValueError(\n","            \"No clean failure subtype exists.\"\n","        )\n","\n","\n","    failure_subtypes = (\n","        clean_failure_verdicts\n","        .index\n","        .to_numpy(\n","            dtype=int\n","        )\n","    )\n","\n","    failure_subtype_probabilities = (\n","        clean_failure_verdicts\n","        .to_numpy(\n","            dtype=float\n","        )\n","    )\n","\n","    failure_subtype_probabilities = (\n","        failure_subtype_probabilities\n","        / failure_subtype_probabilities.sum()\n","    )\n","\n","\n","    flip_rng = np.random.default_rng(\n","        stable_project_seed(\n","            project_name,\n","            repetition_seed,\n","            \"flip_mask\",\n","        )\n","    )\n","\n","    subtype_rng = np.random.default_rng(\n","        stable_project_seed(\n","            project_name,\n","            repetition_seed,\n","            \"failure_subtype\",\n","        )\n","    )\n","\n","\n","    row_uniforms = (\n","        flip_rng.random(\n","            number_of_rows\n","        )\n","    )\n","\n","    flip_mask = (\n","        row_uniforms\n","        \u003c noise_percent / 100.0\n","    )\n","\n","\n","    sampled_failure_subtypes = (\n","        subtype_rng.choice(\n","            failure_subtypes,\n","            size=number_of_rows,\n","            replace=True,\n","            p=(\n","                failure_subtype_probabilities\n","            ),\n","        )\n","    )\n","\n","\n","    noisy_verdict = (\n","        original_verdict.copy()\n","    )\n","\n","\n","    pass_to_failure_mask = (\n","        flip_mask\n","        \u0026 (\n","            original_verdict == 0\n","        )\n","    )\n","\n","    failure_to_pass_mask = (\n","        flip_mask\n","        \u0026 (\n","            original_verdict != 0\n","        )\n","    )\n","\n","\n","    noisy_verdict[\n","        pass_to_failure_mask\n","    ] = sampled_failure_subtypes[\n","        pass_to_failure_mask\n","    ]\n","\n","\n","    noisy_verdict[\n","        failure_to_pass_mask\n","    ] = 0\n","\n","\n","    noisy_history[\n","        \"verdict\"\n","    ] = noisy_verdict\n","\n","\n","    manifest = pd.DataFrame({\n","        \"NoiseRowID\":\n","            np.arange(\n","                number_of_rows\n","            ),\n","\n","        \"Build\":\n","            noisy_history[\n","                \"build\"\n","            ].to_numpy(),\n","\n","        \"Test\":\n","            noisy_history[\n","                \"test\"\n","            ].to_numpy(),\n","\n","        \"OriginalVerdict\":\n","            original_verdict,\n","\n","        \"NoisyVerdict\":\n","            noisy_verdict,\n","\n","        \"FlipUniform\":\n","            row_uniforms,\n","\n","        \"Flipped\":\n","            flip_mask,\n","\n","        \"PassToFailure\":\n","            pass_to_failure_mask,\n","\n","        \"FailureToPass\":\n","            failure_to_pass_mask,\n","    })\n","\n","\n","    if \"job\" in (\n","        noisy_history.columns\n","    ):\n","        manifest[\n","            \"Job\"\n","        ] = noisy_history[\n","            \"job\"\n","        ].to_numpy()\n","\n","\n","    number_flipped = int(\n","        flip_mask.sum()\n","    )\n","\n","\n","    summary = {\n","        \"Project\":\n","            project_name,\n","\n","        \"NoisePercentRequested\":\n","            noise_percent,\n","\n","        \"RepetitionSeed\":\n","            int(\n","                repetition_seed\n","            ),\n","\n","        \"TrainingExecutionRows\":\n","            int(\n","                number_of_rows\n","            ),\n","\n","        \"NumberFlipped\":\n","            number_flipped,\n","\n","        \"RealisedNoisePercent\":\n","            float(\n","                100.0\n","                * number_flipped\n","                / number_of_rows\n","            ),\n","\n","        \"PassToFailure\":\n","            int(\n","                pass_to_failure_mask.sum()\n","            ),\n","\n","        \"FailureToPass\":\n","            int(\n","                failure_to_pass_mask.sum()\n","            ),\n","    }\n","\n","\n","    return (\n","        noisy_history,\n","        manifest,\n","        summary,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 6. Align reconstructed REC features\n","# ---------------------------------------------------------\n","\n","def align_reconstructed_rec_features(\n","    reconstructed,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Return all REC columns in exactly the same row order\n","    as the requested model-ready Build-Test rows.\n","    \"\"\"\n","\n","    reconstructed = (\n","        reconstructed.copy()\n","    )\n","\n","    requested_rows = (\n","        requested_rows\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    missing_rec_columns = [\n","        column\n","        for column in (\n","            REC_FEATURE_COLUMNS\n","        )\n","        if column not in (\n","            reconstructed.columns\n","        )\n","    ]\n","\n","\n","    if missing_rec_columns:\n","        raise ValueError(\n","            \"Reconstruction is missing REC columns: \"\n","            + \", \".join(\n","                missing_rec_columns\n","            )\n","        )\n","\n","\n","    if {\n","        \"Build\",\n","        \"Test\",\n","    }.issubset(\n","        reconstructed.columns\n","    ):\n","\n","        requested_with_order = (\n","            requested_rows[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                ]\n","            ]\n","            .copy()\n","        )\n","\n","        requested_with_order[\n","            \"_requested_row_order\"\n","        ] = np.arange(\n","            len(\n","                requested_with_order\n","            )\n","        )\n","\n","\n","        reconstructed_subset = (\n","            reconstructed[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    *REC_FEATURE_COLUMNS,\n","                ]\n","            ]\n","            .copy()\n","        )\n","\n","\n","        if reconstructed_subset.duplicated(\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ).any():\n","\n","            raise ValueError(\n","                \"Reconstructed REC data contains \"\n","                \"duplicate Build-Test rows.\"\n","            )\n","\n","\n","        aligned = (\n","            requested_with_order\n","            .merge(\n","                reconstructed_subset,\n","                on=[\n","                    \"Build\",\n","                    \"Test\",\n","                ],\n","                how=\"left\",\n","                validate=\"one_to_one\",\n","            )\n","            .sort_values(\n","                \"_requested_row_order\"\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        if aligned[\n","            REC_FEATURE_COLUMNS\n","        ].isna().all(\n","            axis=1\n","        ).any():\n","\n","            raise ValueError(\n","                \"At least one requested Build-Test row \"\n","                \"did not receive reconstructed features.\"\n","            )\n","\n","\n","        return aligned[\n","            REC_FEATURE_COLUMNS\n","        ].copy()\n","\n","\n","    if len(\n","        reconstructed\n","    ) != len(\n","        requested_rows\n","    ):\n","\n","        raise ValueError(\n","            \"Reconstructed rows cannot be aligned: \"\n","            f\"{len(reconstructed)} reconstructed versus \"\n","            f\"{len(requested_rows)} requested.\"\n","        )\n","\n","\n","    return (\n","        reconstructed[\n","            REC_FEATURE_COLUMNS\n","        ]\n","        .reset_index(drop=True)\n","        .copy()\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 7. Map raw noisy verdicts to fixed model-ready rows\n","# ---------------------------------------------------------\n","\n","def extract_model_ready_verdicts(\n","    noisy_execution_history,\n","    requested_rows,\n","):\n","    \"\"\"\n","    Obtain the noisy verdict for every fixed model-ready\n","    Build-Test training row.\n","    \"\"\"\n","\n","    verdict_rows = (\n","        noisy_execution_history[\n","            [\n","                \"build\",\n","                \"test\",\n","                \"verdict\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","\n","    duplicate_groups = (\n","        verdict_rows\n","        .groupby(\n","            [\n","                \"build\",\n","                \"test\",\n","            ],\n","            sort=False,\n","        )[\n","            \"verdict\"\n","        ]\n","        .nunique()\n","    )\n","\n","\n","    conflicting_duplicates = (\n","        duplicate_groups[\n","            duplicate_groups \u003e 1\n","        ]\n","    )\n","\n","\n","    if len(\n","        conflicting_duplicates\n","    ) \u003e 0:\n","\n","        raise ValueError(\n","            \"Noisy raw history contains conflicting \"\n","            \"verdicts for duplicate Build-Test pairs.\"\n","        )\n","\n","\n","    verdict_rows = (\n","        verdict_rows\n","        .drop_duplicates(\n","            [\n","                \"build\",\n","                \"test\",\n","            ],\n","            keep=\"last\",\n","        )\n","        .rename(\n","            columns={\n","                \"build\":\n","                    \"Build\",\n","\n","                \"test\":\n","                    \"Test\",\n","\n","                \"verdict\":\n","                    \"NoisyVerdict\",\n","            }\n","        )\n","    )\n","\n","\n","    requested_with_order = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested_with_order[\n","        \"_requested_row_order\"\n","    ] = np.arange(\n","        len(\n","            requested_with_order\n","        )\n","    )\n","\n","\n","    aligned = (\n","        requested_with_order\n","        .merge(\n","            verdict_rows,\n","            on=[\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","        .sort_values(\n","            \"_requested_row_order\"\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    if aligned[\n","        \"NoisyVerdict\"\n","    ].isna().any():\n","\n","        missing_count = int(\n","            aligned[\n","                \"NoisyVerdict\"\n","            ].isna().sum()\n","        )\n","\n","        raise ValueError(\n","            f\"{missing_count} model-ready training rows \"\n","            \"could not be linked to noisy raw verdicts.\"\n","        )\n","\n","\n","    return (\n","        aligned[\n","            \"NoisyVerdict\"\n","        ]\n","        .astype(int)\n","        .reset_index(drop=True)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Create one noisy model-ready training dataset\n","# ---------------------------------------------------------\n","\n","def create_noisy_model_training_data(\n","    clean_model_training_data,\n","    noisy_execution_history,\n","):\n","    \"\"\"\n","    Preserve all fixed model-ready rows and non-REC\n","    predictors, then replace:\n","\n","    1. all 19 REC features with noisy-history values;\n","    2. Verdict with the corresponding noisy raw verdict.\n","    \"\"\"\n","\n","    noisy_model_data = (\n","        clean_model_training_data\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested_rows = (\n","        noisy_model_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","\n","    reconstructed = (\n","        reconstruct_rec_features(\n","            execution_history=(\n","                noisy_execution_history\n","            ),\n","            requested_rows=(\n","                requested_rows\n","            ),\n","            recent_window=(\n","                RECENT_WINDOW\n","            ),\n","        )\n","    )\n","\n","\n","    aligned_rec = (\n","        align_reconstructed_rec_features(\n","            reconstructed=(\n","                reconstructed\n","            ),\n","            requested_rows=(\n","                requested_rows\n","            ),\n","        )\n","    )\n","\n","\n","    noisy_model_data.loc[\n","        :,\n","        REC_FEATURE_COLUMNS,\n","    ] = aligned_rec.to_numpy()\n","\n","\n","    noisy_model_data[\n","        \"Verdict\"\n","    ] = (\n","        extract_model_ready_verdicts(\n","            noisy_execution_history=(\n","                noisy_execution_history\n","            ),\n","            requested_rows=(\n","                requested_rows\n","            ),\n","        )\n","        .to_numpy()\n","    )\n","\n","\n","    if len(\n","        noisy_model_data\n","    ) != len(\n","        clean_model_training_data\n","    ):\n","        raise AssertionError(\n","            \"Fixed model-ready cohort changed size.\"\n","        )\n","\n","\n","    if not noisy_model_data[\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ].equals(\n","        clean_model_training_data[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ].reset_index(\n","            drop=True\n","        )\n","    ):\n","        raise AssertionError(\n","            \"Fixed Build-Test training cohort changed.\"\n","        )\n","\n","\n","    return noisy_model_data\n","\n","\n","# ---------------------------------------------------------\n","# 9. APFD and APFDc\n","# ---------------------------------------------------------\n","\n","def calculate_apfd(\n","    actual_failures,\n","):\n","    \"\"\"\n","    Calculate APFD for one already-ranked build.\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","\n","    number_of_tests = len(\n","        failures\n","    )\n","\n","    number_of_failures = int(\n","        failures.sum()\n","    )\n","\n","\n","    if number_of_tests == 0:\n","        return np.nan\n","\n","    if number_of_failures == 0:\n","        return np.nan\n","\n","\n","    failure_ranks = (\n","        np.flatnonzero(\n","            failures == 1\n","        )\n","        + 1\n","    )\n","\n","\n","    apfd = (\n","        1.0\n","        - failure_ranks.sum()\n","        / (\n","            number_of_tests\n","            * number_of_failures\n","        )\n","        + 1.0\n","        / (\n","            2.0\n","            * number_of_tests\n","        )\n","    )\n","\n","\n","    return float(\n","        apfd\n","    )\n","\n","\n","def calculate_apfdc(\n","    actual_failures,\n","    durations,\n","):\n","    \"\"\"\n","    Calculate cost-aware APFD using midpoint\n","    failure-detection time.\n","    \"\"\"\n","\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    durations = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","\n","    if len(\n","        failures\n","    ) != len(\n","        durations\n","    ):\n","\n","        raise ValueError(\n","            \"actual_failures and durations must \"\n","            \"have the same length.\"\n","        )\n","\n","\n","    if len(\n","        failures\n","    ) == 0:\n","        return np.nan\n","\n","    if failures.sum() == 0:\n","        return np.nan\n","\n","\n","    if not np.isfinite(\n","        durations\n","    ).all():\n","\n","        raise ValueError(\n","            \"Durations contain missing or \"\n","            \"infinite values.\"\n","        )\n","\n","\n","    if (\n","        durations \u003c 0\n","    ).any():\n","\n","        raise ValueError(\n","            \"Durations cannot be negative.\"\n","        )\n","\n","\n","    total_duration = float(\n","        durations.sum()\n","    )\n","\n","\n","    if total_duration \u003c= 0:\n","        return np.nan\n","\n","\n","    cumulative_before = np.concatenate([\n","        np.array([\n","            0.0\n","        ]),\n","        np.cumsum(\n","            durations\n","        )[:-1],\n","    ])\n","\n","\n","    failure_mask = (\n","        failures == 1\n","    )\n","\n","\n","    midpoint_detection_times = (\n","        cumulative_before[\n","            failure_mask\n","        ]\n","        + 0.5\n","        * durations[\n","            failure_mask\n","        ]\n","    )\n","\n","\n","    apfdc = (\n","        1.0\n","        - np.mean(\n","            midpoint_detection_times\n","            / total_duration\n","        )\n","    )\n","\n","\n","    return float(\n","        apfdc\n","    )\n","\n","\n","# Compatibility aliases.\n","compute_apfd = (\n","    calculate_apfd\n",")\n","\n","compute_apfdc = (\n","    calculate_apfdc\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 10. Protect clean evaluation data\n","# ---------------------------------------------------------\n","\n","evaluation_hash_columns = [\n","    \"Build\",\n","    \"Test\",\n","    \"Verdict\",\n","    \"Duration\",\n","    *REC_FEATURE_COLUMNS,\n","]\n","\n","\n","evaluation_hash_before = int(\n","    pd.util.hash_pandas_object(\n","        clean_evaluation_data[\n","            evaluation_hash_columns\n","        ],\n","        index=True,\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 11. Self-test: 0% must reproduce clean training data\n","# ---------------------------------------------------------\n","\n","(\n","    zero_noise_history,\n","    zero_noise_manifest,\n","    zero_noise_summary,\n",") = inject_training_verdict_noise(\n","    execution_history=(\n","        clean_training_history\n","    ),\n","    noise_percent=0,\n","    repetition_seed=1,\n",")\n","\n","\n","zero_noise_model_data = (\n","    create_noisy_model_training_data(\n","        clean_model_training_data=(\n","            clean_training_data\n","        ),\n","        noisy_execution_history=(\n","            zero_noise_history\n","        ),\n","    )\n",")\n","\n","\n","zero_label_mismatches = int(\n","    (\n","        zero_noise_model_data[\n","            \"Verdict\"\n","        ].to_numpy()\n","        != clean_training_data[\n","            \"Verdict\"\n","        ].to_numpy()\n","    ).sum()\n",")\n","\n","\n","zero_rec_mismatches = 0\n","\n","\n","for rec_column in (\n","    REC_FEATURE_COLUMNS\n","):\n","\n","    reconstructed_values = pd.to_numeric(\n","        zero_noise_model_data[\n","            rec_column\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(\n","        dtype=float\n","    )\n","\n","    original_values = pd.to_numeric(\n","        clean_training_data[\n","            rec_column\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(\n","        dtype=float\n","    )\n","\n","\n","    equal_mask = np.isclose(\n","        reconstructed_values,\n","        original_values,\n","        rtol=1e-10,\n","        atol=1e-12,\n","        equal_nan=True,\n","    )\n","\n","\n","    zero_rec_mismatches += int(\n","        (\n","            ~equal_mask\n","        ).sum()\n","    )\n","\n","\n","if zero_noise_summary[\n","    \"NumberFlipped\"\n","] != 0:\n","\n","    raise AssertionError(\n","        \"0% noise unexpectedly flipped verdicts.\"\n","    )\n","\n","\n","if zero_label_mismatches != 0:\n","    raise AssertionError(\n","        \"0% reconstruction changed training labels.\"\n","    )\n","\n","\n","if zero_rec_mismatches != 0:\n","    raise AssertionError(\n","        \"0% reconstruction changed REC features.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. Self-test: 5% same-seed reproducibility\n","# ---------------------------------------------------------\n","\n","(\n","    five_history_a,\n","    five_manifest_a,\n","    five_summary_a,\n",") = inject_training_verdict_noise(\n","    execution_history=(\n","        clean_training_history\n","    ),\n","    noise_percent=5,\n","    repetition_seed=1,\n",")\n","\n","\n","(\n","    five_history_b,\n","    five_manifest_b,\n","    five_summary_b,\n",") = inject_training_verdict_noise(\n","    execution_history=(\n","        clean_training_history\n","    ),\n","    noise_percent=5,\n","    repetition_seed=1,\n",")\n","\n","\n","same_seed_reproducible = bool(\n","    np.array_equal(\n","        five_history_a[\n","            \"verdict\"\n","        ].to_numpy(),\n","        five_history_b[\n","            \"verdict\"\n","        ].to_numpy(),\n","    )\n","    and np.array_equal(\n","        five_manifest_a[\n","            \"FlipUniform\"\n","        ].to_numpy(),\n","        five_manifest_b[\n","            \"FlipUniform\"\n","        ].to_numpy(),\n","    )\n",")\n","\n","\n","if not same_seed_reproducible:\n","    raise AssertionError(\n","        \"Same project, seed and noise level did \"\n","        \"not reproduce the same corruption.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. Self-test: nested 5% and 10% masks\n","# ---------------------------------------------------------\n","\n","(\n","    ten_history,\n","    ten_manifest,\n","    ten_summary,\n",") = inject_training_verdict_noise(\n","    execution_history=(\n","        clean_training_history\n","    ),\n","    noise_percent=10,\n","    repetition_seed=1,\n",")\n","\n","\n","same_five_ten_uniform_stream = bool(\n","    np.array_equal(\n","        five_manifest_a[\n","            \"FlipUniform\"\n","        ].