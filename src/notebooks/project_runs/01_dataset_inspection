d_build_ids = set(\n","    unmatched_commit_rows[\n","        \"id\"\n","    ].astype(int)\n",")\n","\n","unmatched_commits = (\n","    unmatched_commit_rows[\n","        \"Commit\"\n","    ]\n","    .astype(str)\n","    .drop_duplicates()\n","    .tolist()\n",")\n","\n","\n","print(\n","    \"Unmatched build/commit pairs:\",\n","    len(unmatched_commit_rows),\n",")\n","\n","print(\n","    \"Affected builds:\",\n","    len(unmatched_build_ids),\n",")\n","\n","print(\n","    \"Distinct unmatched commits:\",\n","    len(unmatched_commits),\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Add chronological partition information\n","# ---------------------------------------------------------\n","\n","def classify_build_period(\n","    build_id,\n","):\n","    build_id = int(\n","        build_id\n","    )\n","\n","    if build_id in training_build_ids:\n","        return \"Training\"\n","\n","    if build_id in evaluation_build_ids:\n","        return \"Evaluation\"\n","\n","    return \"Unknown\"\n","\n","\n","unmatched_commit_rows[\n","    \"SplitPeriod\"\n","] = (\n","    unmatched_commit_rows[\n","        \"id\"\n","    ].map(\n","        classify_build_period\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Summarise raw executions in affected builds\n","# ---------------------------------------------------------\n","\n","affected_raw_executions = (\n","    exe_for_rec[\n","        exe_for_rec[\n","            \"build\"\n","        ].isin(\n","            unmatched_build_ids\n","        )\n","    ]\n","    .copy()\n",")\n","\n","\n","raw_execution_summary = (\n","    affected_raw_executions\n","    .groupby(\n","        \"build\",\n","        as_index=False,\n","    )\n","    .agg(\n","        RawExecutionRows=(\n","            \"test\",\n","            \"size\",\n","        ),\n","        RawUniqueTests=(\n","            \"test\",\n","            \"nunique\",\n","        ),\n","        RawPassingExecutions=(\n","            \"verdict\",\n","            lambda values: int(\n","                (\n","                    pd.to_numeric(\n","                        values,\n","                        errors=\"raise\",\n","                    ) == 0\n","                ).sum()\n","            ),\n","        ),\n","        RawFailingExecutions=(\n","            \"verdict\",\n","            lambda values: int(\n","                (\n","                    pd.to_numeric(\n","                        values,\n","                        errors=\"raise\",\n","                    ) != 0\n","                ).sum()\n","            ),\n","        ),\n","    )\n","    .rename(\n","        columns={\n","            \"build\": \"id\",\n","        }\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Summarise model-ready rows in affected builds\n","# ---------------------------------------------------------\n","\n","affected_model_rows = (\n","    dataset_with_order[\n","        dataset_with_order[\n","            \"Build\"\n","        ].isin(\n","            unmatched_build_ids\n","        )\n","    ]\n","    .copy()\n",")\n","\n","\n","model_ready_summary = (\n","    affected_model_rows\n","    .groupby(\n","        \"Build\",\n","        as_index=False,\n","    )\n","    .agg(\n","        ModelReadyRows=(\n","            \"Test\",\n","            \"size\",\n","        ),\n","        ModelReadyUniqueTests=(\n","            \"Test\",\n","            \"nunique\",\n","        ),\n","        ModelReadyPasses=(\n","            \"Verdict\",\n","            lambda values: int(\n","                (\n","                    pd.to_numeric(\n","                        values,\n","                        errors=\"raise\",\n","                    ) == 0\n","                ).sum()\n","            ),\n","        ),\n","        ModelReadyFailures=(\n","            \"Verdict\",\n","            lambda values: int(\n","                (\n","                    pd.to_numeric(\n","                        values,\n","                        errors=\"raise\",\n","                    ) != 0\n","                ).sum()\n","            ),\n","        ),\n","    )\n","    .rename(\n","        columns={\n","            \"Build\": \"id\",\n","        }\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Build one detailed affected-build table\n","# ---------------------------------------------------------\n","\n","unmatched_build_details = (\n","    unmatched_commit_rows[\n","        [\n","            \"id\",\n","            \"build_order\",\n","            \"started_at\",\n","            \"SplitPeriod\",\n","            \"commits\",\n","            \"Commit\",\n","        ]\n","    ]\n","    .merge(\n","        raw_execution_summary,\n","        on=\"id\",\n","        how=\"left\",\n","        validate=\"many_to_one\",\n","    )\n","    .merge(\n","        model_ready_summary,\n","        on=\"id\",\n","        how=\"left\",\n","        validate=\"many_to_one\",\n","    )\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"Commit\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","count_columns = [\n","    \"RawExecutionRows\",\n","    \"RawUniqueTests\",\n","    \"RawPassingExecutions\",\n","    \"RawFailingExecutions\",\n","    \"ModelReadyRows\",\n","    \"ModelReadyUniqueTests\",\n","    \"ModelReadyPasses\",\n","    \"ModelReadyFailures\",\n","]\n","\n","for column in count_columns:\n","    unmatched_build_details[\n","        column\n","    ] = (\n","        unmatched_build_details[\n","            column\n","        ]\n","        .fillna(0)\n","        .astype(int)\n","    )\n","\n","\n","unmatched_build_details[\n","    \"AppearsInModelReadyDataset\"\n","] = (\n","    unmatched_build_details[\n","        \"ModelReadyRows\"\n","    ] \u003e 0\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 6. Look for abbreviated or prefix-matching hashes\n","# ---------------------------------------------------------\n","\n","known_entity_commit_list = sorted(\n","    entity_commit_pairs[\n","        \"Commit\"\n","    ]\n","    .astype(str)\n","    .drop_duplicates()\n","    .tolist()\n",")\n","\n","\n","candidate_records = []\n","\n","for unmatched_commit in unmatched_commits:\n","\n","    unmatched_commit = str(\n","        unmatched_commit\n","    )\n","\n","    prefix_candidates = [\n","        known_commit\n","        for known_commit\n","        in known_entity_commit_list\n","        if (\n","            known_commit.startswith(\n","                unmatched_commit\n","            )\n","            or unmatched_commit.startswith(\n","                known_commit\n","            )\n","        )\n","    ]\n","\n","    suffix_candidates = [\n","        known_commit\n","        for known_commit\n","        in known_entity_commit_list\n","        if (\n","            known_commit.endswith(\n","                unmatched_commit\n","            )\n","            or unmatched_commit.endswith(\n","                known_commit\n","            )\n","        )\n","    ]\n","\n","    all_candidates = sorted(\n","        set(\n","            prefix_candidates\n","            + suffix_candidates\n","        )\n","    )\n","\n","    candidate_records.append({\n","        \"UnmatchedCommit\":\n","            unmatched_commit,\n","        \"UnmatchedCommitLength\":\n","            len(unmatched_commit),\n","        \"PrefixCandidateCount\":\n","            len(prefix_candidates),\n","        \"SuffixCandidateCount\":\n","            len(suffix_candidates),\n","        \"AnyCandidateCount\":\n","            len(all_candidates),\n","        \"CandidateExamples\":\n","            \" | \".join(\n","                all_candidates[:10]\n","            ),\n","        \"UniqueCandidate\":\n","            (\n","                all_candidates[0]\n","                if len(all_candidates) == 1\n","                else \"\"\n","            ),\n","    })\n","\n","\n","commit_candidate_audit = pd.DataFrame(\n","    candidate_records\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 7. Compare commit-length distributions\n","# ---------------------------------------------------------\n","\n","known_commit_lengths = (\n","    entity_commit_pairs[\n","        \"Commit\"\n","    ]\n","    .astype(str)\n","    .str.len()\n","    .value_counts()\n","    .sort_index()\n","    .rename_axis(\n","        \"CommitLength\"\n","    )\n","    .reset_index(\n","        name=\"KnownEntityCommitCount\"\n","    )\n",")\n","\n","unmatched_commit_lengths = (\n","    pd.Series(\n","        unmatched_commits,\n","        name=\"Commit\",\n","    )\n","    .astype(str)\n","    .str.len()\n","    .value_counts()\n","    .sort_index()\n","    .rename_axis(\n","        \"CommitLength\"\n","    )\n","    .reset_index(\n","        name=\"UnmatchedCommitCount\"\n","    )\n",")\n","\n","\n","commit_length_comparison = (\n","    known_commit_lengths\n","    .merge(\n","        unmatched_commit_lengths,\n","        on=\"CommitLength\",\n","        how=\"outer\",\n","    )\n","    .fillna(0)\n","    .sort_values(\n","        \"CommitLength\"\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","commit_length_comparison[\n","    [\n","        \"KnownEntityCommitCount\",\n","        \"UnmatchedCommitCount\",\n","    ]\n","] = (\n","    commit_length_comparison[\n","        [\n","            \"KnownEntityCommitCount\",\n","            \"UnmatchedCommitCount\",\n","        ]\n","    ]\n","    .astype(int)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 8. Inspect stored file-history REC values for affected\n","#    model-ready rows\n","# ---------------------------------------------------------\n","\n","stored_file_rec_rows = (\n","    affected_model_rows[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"Verdict\",\n","            \"REC_MaxTestFileFailRate\",\n","            \"REC_MaxTestFileTransitionRate\",\n","        ]\n","    ]\n","    .sort_values(\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(stored_file_rec_rows) \u003e 0:\n","\n","    stored_file_rec_summary = (\n","        stored_file_rec_rows\n","        .groupby(\n","            \"Build\",\n","            as_index=False,\n","        )\n","        .agg(\n","            ModelReadyRows=(\n","                \"Test\",\n","                \"size\",\n","            ),\n","            Failures=(\n","                \"Verdict\",\n","                lambda values: int(\n","                    (\n","                        pd.to_numeric(\n","                            values,\n","                            errors=\"raise\",\n","                        ) != 0\n","                    ).sum()\n","                ),\n","            ),\n","            MinimumStoredFileFailRate=(\n","                \"REC_MaxTestFileFailRate\",\n","                \"min\",\n","            ),\n","            MaximumStoredFileFailRate=(\n","                \"REC_MaxTestFileFailRate\",\n","                \"max\",\n","            ),\n","            MinimumStoredFileTransitionRate=(\n","                \"REC_MaxTestFileTransitionRate\",\n","                \"min\",\n","            ),\n","            MaximumStoredFileTransitionRate=(\n","                \"REC_MaxTestFileTransitionRate\",\n","                \"max\",\n","            ),\n","        )\n","    )\n","\n","else:\n","\n","    stored_file_rec_summary = pd.DataFrame(\n","        columns=[\n","            \"Build\",\n","            \"ModelReadyRows\",\n","            \"Failures\",\n","            \"MinimumStoredFileFailRate\",\n","            \"MaximumStoredFileFailRate\",\n","            \"MinimumStoredFileTransitionRate\",\n","            \"MaximumStoredFileTransitionRate\",\n","        ]\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Determine diagnostic category\n","# ---------------------------------------------------------\n","\n","unique_candidate_count = int(\n","    (\n","        commit_candidate_audit[\n","            \"AnyCandidateCount\"\n","        ] == 1\n","    ).sum()\n",")\n","\n","ambiguous_candidate_count = int(\n","    (\n","        commit_candidate_audit[\n","            \"AnyCandidateCount\"\n","        ] \u003e 1\n","    ).sum()\n",")\n","\n","no_candidate_count = int(\n","    (\n","        commit_candidate_audit[\n","            \"AnyCandidateCount\"\n","        ] == 0\n","    ).sum()\n",")\n","\n","affected_model_ready_builds = int(\n","    unmatched_build_details.loc[\n","        unmatched_build_details[\n","            \"AppearsInModelReadyDataset\"\n","        ],\n","        \"id\",\n","    ].nunique()\n",")\n","\n","\n","if unique_candidate_count == len(\n","    unmatched_commits\n","):\n","    diagnostic_status = (\n","        \"ALL_UNMATCHED_COMMITS_HAVE_UNIQUE_HASH_CANDIDATES\"\n","    )\n","\n","elif affected_model_ready_builds == 0:\n","    diagnostic_status = (\n","        \"NO_HASH_REPAIR_FOUND_BUT_BUILDS_ARE_NOT_MODEL_READY\"\n","    )\n","\n","else:\n","    diagnostic_status = (\n","        \"KEEP_EMPTY_ENTITY_SETS_AND_VALIDATE_WITH_0_PERCENT_REC\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Save diagnostic evidence\n","# ---------------------------------------------------------\n","\n","details_path = (\n","    DIAGNOSTIC_DIRECTORY\n","    / \"unmatched_build_commit_details.csv\"\n",")\n","\n","candidate_path = (\n","    DIAGNOSTIC_DIRECTORY\n","    / \"unmatched_commit_candidate_audit.csv\"\n",")\n","\n","length_path = (\n","    DIAGNOSTIC_DIRECTORY\n","    / \"commit_length_comparison.csv\"\n",")\n","\n","stored_rec_path = (\n","    DIAGNOSTIC_DIRECTORY\n","    / \"unmatched_build_stored_file_rec_rows.csv\"\n",")\n","\n","report_path = (\n","    DIAGNOSTIC_DIRECTORY\n","    / \"unmatched_mapping_diagnostic.json\"\n",")\n","\n","\n","unmatched_build_details.to_csv(\n","    details_path,\n","    index=False,\n",")\n","\n","commit_candidate_audit.to_csv(\n","    candidate_path,\n","    index=False,\n",")\n","\n","commit_length_comparison.to_csv(\n","    length_path,\n","    index=False,\n",")\n","\n","stored_file_rec_rows.to_csv(\n","    stored_rec_path,\n","    index=False,\n",")\n","\n","\n","diagnostic_report = {\n","    \"Project\":\n","        PROJECT_NAME,\n","    \"UnmatchedBuildCommitPairs\":\n","        int(len(unmatched_commit_rows)),\n","    \"AffectedBuilds\":\n","        int(len(unmatched_build_ids)),\n","    \"DistinctUnmatchedCommits\":\n","        int(len(unmatched_commits)),\n","    \"UniqueHashCandidateCommits\":\n","        unique_candidate_count,\n","    \"AmbiguousHashCandidateCommits\":\n","        ambiguous_candidate_count,\n","    \"NoHashCandidateCommits\":\n","        no_candidate_count,\n","    \"AffectedModelReadyBuilds\":\n","        affected_model_ready_builds,\n","    \"DiagnosticStatus\":\n","        diagnostic_status,\n","}\n","\n","\n","with open(\n","    report_path,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as report_file:\n","\n","    json.dump(\n","        diagnostic_report,\n","        report_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. Final output\n","# ---------------------------------------------------------\n","\n","print(\n","    \"\\nAffected build details:\"\n",")\n","\n","display(\n","    unmatched_build_details\n",")\n","\n","\n","print(\n","    \"\\nHash candidate audit:\"\n",")\n","\n","display(\n","    commit_candidate_audit\n",")\n","\n","\n","print(\n","    \"\\nCommit-length comparison:\"\n",")\n","\n","display(\n","    commit_length_comparison\n",")\n","\n","