ing_rec_columns:\n","    raise KeyError(\n","        \"Titan dataset is missing REC columns:\\n\"\n","        + \"\\n\".join(missing_rec_columns)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Prepare deterministic execution history\n","# ---------------------------------------------------------\n","\n","rec_execution_history = (\n","    exe_for_rec.copy()\n",")\n","\n","\n","required_execution_columns = [\n","    \"build\",\n","    \"test\",\n","    \"verdict\",\n","    \"duration\",\n","    \"build_order\",\n","]\n","\n","\n","missing_execution_columns = [\n","    column\n","    for column in required_execution_columns\n","    if column not in rec_execution_history.columns\n","]\n","\n","\n","if missing_execution_columns:\n","    raise KeyError(\n","        \"Execution history is missing columns:\\n\"\n","        + \"\\n\".join(missing_execution_columns)\n","    )\n","\n","\n","rec_execution_history[\n","    \"build\"\n","] = pd.to_numeric(\n","    rec_execution_history[\n","        \"build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","rec_execution_history[\n","    \"build_order\"\n","] = pd.to_numeric(\n","    rec_execution_history[\n","        \"build_order\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","rec_execution_history[\n","    \"test\"\n","] = (\n","    rec_execution_history[\n","        \"test\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","rec_execution_history[\n","    \"verdict\"\n","] = pd.to_numeric(\n","    rec_execution_history[\n","        \"verdict\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int8\")\n","\n","\n","rec_execution_history[\n","    \"duration\"\n","] = pd.to_numeric(\n","    rec_execution_history[\n","        \"duration\"\n","    ],\n","    errors=\"raise\",\n",").astype(float)\n","\n","\n","if not np.isfinite(\n","    rec_execution_history[\n","        \"duration\"\n","    ].to_numpy(dtype=float)\n",").all():\n","    raise AssertionError(\n","        \"Execution history contains non-finite durations.\"\n","    )\n","\n","\n","if (\n","    rec_execution_history[\n","        \"duration\"\n","    ] \u003c 0\n",").any():\n","    raise AssertionError(\n","        \"Execution history contains negative durations.\"\n","    )\n","\n","\n","unexpected_verdicts = sorted(\n","    set(\n","        rec_execution_history[\n","            \"verdict\"\n","        ].astype(int).unique()\n","    )\n","    - {\n","        0,\n","        1,\n","        2,\n","        3,\n","    }\n",")\n","\n","\n","if unexpected_verdicts:\n","    raise AssertionError(\n","        \"Unexpected verdict values: \"\n","        f\"{unexpected_verdicts}\"\n","    )\n","\n","\n","rec_execution_history[\n","    \"_OriginalExecutionOrder\"\n","] = np.arange(\n","    len(rec_execution_history),\n","    dtype=np.int64,\n",")\n","\n","\n","if \"job\" in rec_execution_history.columns:\n","    rec_execution_history[\n","        \"_JobSort\"\n","    ] = (\n","        rec_execution_history[\n","            \"job\"\n","        ].astype(str)\n","    )\n","\n","else:\n","    rec_execution_history[\n","        \"_JobSort\"\n","    ] = \"\"\n","\n","\n","rec_execution_history = (\n","    rec_execution_history\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"_JobSort\",\n","            \"test\",\n","            \"_OriginalExecutionOrder\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 4. Prepare entity-to-build change history\n","# ---------------------------------------------------------\n","\n","required_entity_columns = [\n","    \"Build\",\n","    \"EntityID\",\n","]\n","\n","\n","missing_entity_columns = [\n","    column\n","    for column in required_entity_columns\n","    if column not in build_entity_map.columns\n","]\n","\n","\n","if missing_entity_columns:\n","    raise KeyError(\n","        \"Build-entity mapping is missing columns:\\n\"\n","        + \"\\n\".join(missing_entity_columns)\n","    )\n","\n","\n","entity_build_pairs = (\n","    build_entity_map[\n","        [\n","            \"Build\",\n","            \"EntityID\",\n","        ]\n","    ]\n","    .dropna(\n","        subset=[\n","            \"Build\",\n","            \"EntityID\",\n","        ]\n","    )\n","    .drop_duplicates()\n","    .copy()\n",")\n","\n","\n","entity_build_pairs[\n","    \"Build\"\n","] = pd.to_numeric(\n","    entity_build_pairs[\n","        \"Build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","entity_build_pairs[\n","    \"EntityID\"\n","] = (\n","    entity_build_pairs[\n","        \"EntityID\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","entity_changed_builds = (\n","    entity_build_pairs\n","    .groupby(\n","        \"EntityID\",\n","        sort=False,\n","    )[\n","        \"Build\"\n","    ]\n","    .apply(\n","        lambda values:\n","            set(\n","                values.astype(int).tolist()\n","            )\n","    )\n","    .to_dict()\n",")\n","\n","\n","clean_changed_entities_by_build = {\n","    int(build_id):\n","        {\n","            str(entity_id)\n","            for entity_id\n","            in changed_entities_by_build.get(\n","                int(build_id),\n","                set(),\n","            )\n","        }\n","\n","    for build_id\n","    in builds[\n","        \"build\"\n","    ].astype(int)\n","}\n","\n","\n","if set(\n","    clean_changed_entities_by_build.keys()\n",") != set(\n","    builds[\n","        \"build\"\n","    ].astype(int)\n","):\n","    raise AssertionError(\n","        \"The changed-entity dictionary does not contain \"\n","        \"all Titan builds.\"\n","    )\n","\n","\n","DOCUMENTED_UNMATCHED_BUILDS = [\n","    1724328,\n","    5889934,\n","]\n","\n","\n","for build_id in DOCUMENTED_UNMATCHED_BUILDS:\n","    if clean_changed_entities_by_build[\n","        build_id\n","    ] != set():\n","        raise AssertionError(\n","            \"A documented unmatched build unexpectedly \"\n","            \"has changed entities.\\n\"\n","            f\"Build: {build_id}\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Verdict-rate helpers\n","# ---------------------------------------------------------\n","\n","def calculate_rec_rates(\n","    history,\n","):\n","    \"\"\"\n","    Calculate historical failure, assertion,\n","    exception and transition rates.\n","    \"\"\"\n","\n","    history_length = len(history)\n","\n","\n","    if history_length == 0:\n","        raise ValueError(\n","            \"Rate calculation requires non-empty history.\"\n","        )\n","\n","\n","    verdicts = pd.to_numeric(\n","        history[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    )\n","\n","\n","    return (\n","        float(\n","            (\n","                verdicts != 0\n","            ).sum()\n","            / history_length\n","        ),\n","\n","        float(\n","            (\n","                verdicts == 2\n","            ).sum()\n","            / history_length\n","        ),\n","\n","        float(\n","            (\n","                verdicts == 1\n","            ).sum()\n","            / history_length\n","        ),\n","\n","        float(\n","            (\n","                history[\n","                    \"transition\"\n","                ] == 1\n","            ).sum()\n","            / history_length\n","        ),\n","    )\n","\n","\n","def calculate_max_test_file_rate(\n","    history,\n","    target_column,\n","    current_changed_entities,\n","):\n","    \"\"\"\n","    Calculate the maximum changed-entity overlap rate\n","    for earlier failure or transition builds.\n","    \"\"\"\n","\n","    if target_column not in {\n","        \"verdict\",\n","        \"transition\",\n","    }:\n","        raise ValueError(\n","            \"target_column must be verdict or transition.\"\n","        )\n","\n","\n","    target_builds = (\n","        history.loc[\n","            history[\n","                target_column\n","            ] \u003e 0,\n","            \"build\",\n","        ]\n","        .drop_duplicates()\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","\n","    if len(target_builds) == 0:\n","        return -1.0\n","\n","\n","    target_build_set = set(\n","        target_builds\n","    )\n","\n","\n","    maximum_frequency = 0\n","\n","\n","    for entity_id in current_changed_entities:\n","        entity_builds = (\n","            entity_changed_builds.get(\n","                str(entity_id),\n","                set(),\n","            )\n","        )\n","\n","\n","        overlap_count = len(\n","            entity_builds.intersection(\n","                target_build_set\n","            )\n","        )\n","\n","\n","        maximum_frequency = max(\n","            maximum_frequency,\n","            overlap_count,\n","        )\n","\n","\n","    if maximum_frequency == 0:\n","        return 0.0\n","\n","\n","    return float(\n","        maximum_frequency\n","        / len(target_builds)\n","    )\n","\n","\n","# Compatibility alias for later stages.\n","calculate_rates = calculate_rec_rates\n","\n","\n","# ---------------------------------------------------------\n","# 6. Canonical verdict-dependent reconstruction\n","# ---------------------------------------------------------\n","\n","def reconstruct_verdict_dependent_rec_features(\n","    execution_history,\n","    requested_rows,\n","    recent_window=6,\n","):\n","    \"\"\"\n","    Reconstruct only the 13 REC features that depend\n","    on historical verdicts.\n","\n","    Age and duration features are deliberately excluded\n","    because verdict noise does not modify them.\n","    \"\"\"\n","\n","    if recent_window \u003c= 0:\n","        raise ValueError(\n","            \"recent_window must be positive.\"\n","        )\n","\n","\n","    history_input = (\n","        execution_history.copy()\n","    )\n","\n","\n","    history_input[\n","        \"build\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    history_input[\n","        \"build_order\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"build_order\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    history_input[\n","        \"test\"\n","    ] = (\n","        history_input[\n","            \"test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    history_input[\n","        \"verdict\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int8\")\n","\n","\n","    if \"_OriginalExecutionOrder\" not in (\n","        history_input.columns\n","    ):\n","        history_input[\n","            \"_OriginalExecutionOrder\"\n","        ] = np.arange(\n","            len(history_input),\n","            dtype=np.int64,\n","        )\n","\n","\n","    if \"_JobSort\" not in history_input.columns:\n","        if \"job\" in history_input.columns:\n","            history_input[\n","                \"_JobSort\"\n","            ] = (\n","                history_input[\n","                    \"job\"\n","                ].astype(str)\n","            )\n","\n","        else:\n","            history_input[\n","                \"_JobSort\"\n","            ] = \"\"\n","\n","\n","    history_input = (\n","        history_input\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"_JobSort\",\n","                \"test\",\n","                \"_OriginalExecutionOrder\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested_rows_checked = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","\n","    requested_rows_checked[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        requested_rows_checked[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    requested_rows_checked[\n","        \"Test\"\n","    ] = (\n","        requested_rows_checked[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    if requested_rows_checked.duplicated(\n","        subset=[\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ).any():\n","        raise AssertionError(\n","            \"Requested rows contain duplicate \"\n","            \"Build-Test pairs.\"\n","        )\n","\n","\n","    requested_pairs = set(\n","        zip(\n","            requested_rows_checked[\n","                \"Build\"\n","            ].astype(int),\n","\n","            requested_rows_checked[\n","                \"Test\"\n","            ].astype(str),\n","        )\n","    )\n","\n","\n","    reconstructed_records = []\n","\n","\n","    for test_id, test_history in (\n","        history_input.groupby(\n","            \"test\",\n","            sort=False,\n","        )\n","    ):\n","        test_id = str(\n","            test_id\n","        )\n","\n","\n","        test_history = (\n","            test_history\n","            .sort_values(\n","                [\n","                    \"build_order\",\n","                    \"_JobSort\",\n","                    \"_OriginalExecutionOrder\",\n","                ],\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","            .copy()\n","        )\n","\n","\n","        test_history[\n","            \"transition\"\n","        ] = (\n","            test_history[\n","                \"verdict\"\n","            ]\n","            .diff()\n","            .fillna(0)\n","            .ne(0)\n","            .astype(int)\n","        )\n","\n","\n","        for current_position in range(\n","            len(test_history)\n","        ):\n","            current_row = (\n","                test_history.iloc[\n","                    current_position\n","                ]\n","            )\n","\n","\n","            current_build = int(\n","                current_row[\n","                    \"build\"\n","                ]\n","            )\n","\n","\n","            pair = (\n","                current_build,\n","                test_id,\n","            )\n","\n","\n","            if pair not in requested_pairs:\n","                continue\n","\n","\n","            history = (\n","                test_history\n","                .iloc[\n","                    :current_position\n","                ]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","\n","            record = {\n","                \"Build\":\n","                    current_build,\n","\n","                \"Test\":\n","                    test_id,\n","            }\n","\n","\n","            if history.empty:\n","                for column in (\n","                    VERDICT_DEPENDENT_REC_COLUMNS\n","                ):\n","                    record[\n","                        column\n","                    ] = -1.0\n","\n","\n","                reconstructed_records.append(\n","                    record\n","                )\n","\n","                continue\n","\n","\n","            recent_history = (\n","                history\n","                .tail(\n","                    recent_window\n","                )\n","                .copy()\n","            )\n","\n","\n","            failure_positions = np.flatnonzero(\n","                history[\n","                    \"verdict\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","\n","            if len(failure_positions) == 0:\n","                last_failure_age = -1\n","\n","            else:\n","                last_failure_age = int(\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        failure_positions[-1]\n","                    )\n","                )\n","\n","\n","            transition_positions = np.flatnonzero(\n","                history[\n","                    \"transition\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","\n","            if len(transition_positions) == 0:\n","                last_transition_age = -1\n","\n","            else:\n","                last_transition_age = int(\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        transition_positions[-1]\n","                    )\n","                )\n","\n","\n","            (\n","                recent_fail_rate,\n","                recent_assert_rate,\n","                recent_exc_rate,\n","                recent_transition_rate,\n","            ) = calculate_rec_rates(\n","                recent_history\n","            )\n","\n","\n","            (\n","                total_fail_rate,\n","                total_assert_rate,\n","                total_exc_rate,\n","                total_transition_rate,\n","            ) = calculate_rec_rates(\n","                history\n","            )\n","\n","\n","            current_changed_entities = (\n","                clean_changed_entities_by_build.get(\n","                    current_build,\n","                    set(),\n","                )\n","            )\n","\n","\n","            record.update({\n","                \"REC_LastFailureAge\":\n","                    float(\n","                        last_failure_age\n","                    ),\n","\n","                \"REC_LastTransitionAge\":\n","                    float(\n","                        last_transition_age\n","                    ),\n","\n","                \"REC_RecentFailRate\":\n","                    recent_fail_rate,\n","\n","                \"REC_RecentAssertRate\":\n","                    recent_assert_rate,\n","\n","                \"REC_RecentExcRate\":\n","                    recent_exc_rate,\n","\n","                \"REC_RecentTransitionRate\":\n","                    recent_transition_rate,\n","\n","                \"REC_TotalFailRate\":\n","                    total_fail_rate,\n","\n","                \"REC_TotalAssertRate\":\n","                    total_assert_rate,\n","\n","                \"REC_TotalExcRate\":\n","                    total_exc_rate,\n","\n","                \"REC_TotalTransitionRate\":\n","                    total_transition_rate,\n","\n","                \"REC_LastVerdict\":\n","                    float(\n","                        recent_history.iloc[-1][\n","                            \"verdict\"\n","                        ]\n","                    ),\n","\n","                \"REC_MaxTestFileFailRate\":\n","                    calculate_max_test_file_rate(\n","                        history=history,\n","                        target_column=\"verdict\",\n","                        current_changed_entities=(\n","                            current_changed_entities\n","                        ),\n","                    ),\n","\n","                \"REC_MaxTestFileTransitionRate\":\n","                    calculate_max_test_file_rate(\n","                        history=history,\n","                        target_column=\"transition\",\n","                        current_changed_entities=(\n","                            current_changed_entities\n","                        ),\n","                    ),\n","            })\n","\n","\n","            reconstructed_records.append(\n","                record\n","            )\n","\n","\n","    reconstructed = pd.DataFrame(\n","        reconstructed_records\n","    )\n","\n","\n","    expected_columns = (\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","        + VERDICT_DEPENDENT_REC_COLUMNS\n","    )\n","\n","\n","    if reconstructed.empty:\n","        reconstructed = pd.DataFrame(\n","            columns=expected_columns\n","        )\n","\n","\n","    missing_output_columns = [\n","        column\n","        for column in expected_columns\n","        if column not in reconstructed.columns\n","    ]\n","\n","\n","    if missing_output_columns:\n","        raise AssertionError(\n","            \"Reconstruction is missing columns:\\n\"\n","            + \"\\n\".join(\n","                missing_output_columns\n","            )\n","        )\n","\n","\n","    reconstructed = (\n","        reconstructed[\n","            expected_columns\n","        ]\n","        .sort_values(\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    duplicate_pairs = int(\n","        reconstructed.duplicated(\n","            subset=[\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ).sum()\n","    )\n","\n","\n","    if duplicate_pairs != 0:\n","        raise AssertionError(\n","            \"Verdict-dependent reconstruction produced \"\n","            f\"{duplicate_pairs} duplicate pairs.\"\n","        )\n","\n","\n","    return reconstructed\n","\n","\n","# ---------------------------------------------------------\n","# 7. Reconstruct all clean verdict-dependent features\n","# ---------------------------------------------------------\n","\n","requested_clean_rows = (\n","    dataset_with_order[\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","clean_verdict_rec_reconstructed = (\n","    reconstruct_verdict_dependent_rec_features(\n","        execution_history=(\n","            rec_execution_history\n","        ),\n","\n","        requested_rows=(\n","            requested_clean_rows\n","        ),\n","\n","        recent_window=(\n","            RECENT_WINDOW\n","        ),\n","    )\n",")\n","\n","\n","if len(clean_verdict_rec_reconstructed) != len(\n","    dataset_with_order\n","):\n","    raise AssertionError(\n","        \"Verdict-dependent reconstruction row count \"\n","        \"mismatch.\\n\"\n","        f\"Expected: {len(dataset_with_order)}\\n\"\n","        \"Observed: \"\n","        f\"{len(clean_verdict_rec_reconstructed)}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 8. Exact comparison of all 13 relevant features\n","# ---------------------------------------------------------\n","\n","original_verdict_rec = (\n","    dataset_with_order[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"partition\",\n","        ]\n","        + VERDICT_DEPENDENT_REC_COLUMNS\n","    ]\n","    .copy()\n",")\n","\n","\n","original_verdict_rec[\n","    \"Build\"\n","] = pd.to_numeric(\n","    original_verdict_rec[\n","        \"Build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","original_verdict_rec[\n","    \"Test\"\n","] = (\n","    original_verdict_rec[\n","        \"Test\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","verdict_comparison = (\n","    original_verdict_rec\n","    .merge(\n","        clean_verdict_rec_reconstructed,\n","        on=[\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        how=\"left\",\n","        validate=\"one_to-one\",\n","        suffixes=(\n","            \"_Original\",\n","            \"_Reconstructed\",\n","        ),\n","        indicator=True,\n","    )\n",")\n","\n","\n","if not (\n","    verdict_comparison[\n","        \"_merge\"\n","    ] == \"both\"\n",").all():\n","    raise AssertionError(\n","        \"Some requested rows were not reconstructed.\"\n","    )\n","\n","\n","verdict_feature_results = []\n","verdict_mismatch_records = []\n","\n","\n","for feature in VERDICT_DEPENDENT_REC_COLUMNS:\n","    original_values = pd.to_numeric(\n","        verdict_comparison[\n","            f\"{feature}_Original\"\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","\n","    reconstructed_values = pd.to_numeric(\n","        verdict_comparison[\n","            f\"{feature}_Reconstructed\"\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","\n","    equal_mask = np.isclose(\n","        original_values,\n","        reconstructed_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","\n","    absolute_difference = np.abs(\n","        original_values\n","        - reconstructed_values\n","    )\n","\n","\n","    finite_differences = (\n","        absolute_difference[\n","            np.isfinite(\n","                absolute_difference\n","            )\n","        ]\n","    )\n","\n","\n","    mismatch_count = int(\n","        (\n","            ~equal_mask\n","        ).sum()\n","    )\n","\n","\n","    verdict_feature_results.append({\n","        \"Feature\":\n","            feature,\n","\n","        \"RowsCompared\":\n","            int(\n","                len(equal_mask)\n","            ),\n","\n","        \"MatchingRows\":\n","            int(\n","                equal_mask.sum()\n","            ),\n","\n","        \"MismatchingRows\":\n","            mismatch_count,\n","\n","        \"MaximumAbsoluteDifference\":\n","            (\n","                float(\n","                    finite_differences.max()\n","                )\n","                if len(\n","                    finite_differences\n","                ) \u003e 0\n","                else 0.0\n","            ),\n","    })\n","\n","\n","    for position in np.flatnonzero(\n","        ~equal_mask\n","    ):\n","        verdict_mismatch_records.append({\n","            \"Feature\":\n","                feature,\n","\n","            \"Build\":\n","                int(\n","                    verdict_comparison.iloc[\n","                        position\n","                    ][\n","                        \"Build\"\n","                    ]\n","                ),\n","\n","            \"Test\":\n","                str(\n","                    verdict_comparison.iloc[\n","                        position\n","                    ][\n","                        \"Test\"\n","                    ]\n","                ),\n","\n","            \"OriginalValue\":\n","                float(\n","                    original_values[\n","                        position\n","                    ]\n","                ),\n","\n","            \"ReconstructedValue\":\n","                float(\n","                    reconstructed_values[\n","                        position\n","                    ]\n","                ),\n","        })\n","\n","\n","verdict_feature_summary = pd.DataFrame(\n","    verdict_feature_results\n",")\n","\n","\n","verdict_mismatch_details = pd.DataFrame(\n","    verdict_mismatch_records,\n","    columns=[\n","        \"Feature\",\n","        \"Build\",\n","        \"Test\",\n","        \"OriginalValue\",\n","        \"ReconstructedValue\",\n","    ],\n",")\n","\n","\n","total_verdict_values_compared = int(\n","    len(dataset_with_order)\n","    * len(\n","        VERDICT_DEPENDENT_REC_COLUMNS\n","    )\n",")\n","\n","\n","total_verdict_mismatches = int(\n","    verdict_feature_summary[\n","        \"MismatchingRows\"\n","    ].sum()\n",")\n","\n","\n","verdict_features_with_mismatches = int(\n","    (\n","        verdict_feature_summary[\n","            \"MismatchingRows\"\n","        ] \u003e 0\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 9. Partition-specific verdict validation\n","# ---------------------------------------------------------\n","\n","verdict_partition_records = []\n","\n","\n","for partition_name, partition_rows in (\n","    verdict_comparison.groupby(\n","        \"partition\",\n","        sort=False,\n","    )\n","):\n","    partition_mismatches = 0\n","\n","\n","    for feature in (\n","        VERDICT_DEPENDENT_REC_COLUMNS\n","    ):\n","        original_values = pd.to_numeric(\n","            partition_rows[\n","                f\"{feature}_Original\"\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        reconstructed_values = pd.to_numeric(\n","            partition_rows[\n","                f\"{feature}_Reconstructed\"\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        partition_mismatches += int(\n","            (\n","                ~np.isclose(\n","                    original_values,\n","                    reconstructed_values,\n","                    rtol=1e-9,\n","                    atol=1e-9,\n","                    equal_nan=True,\n","                )\n","            ).sum()\n","        )\n","\n","\n","    verdict_partition_records.append({\n","        \"Partition\":\n","            str(\n","                partition_name\n","            ),\n","\n","        \"Rows\":\n","            int(\n","                len(partition_rows)\n","            ),\n","\n","        \"FeatureValuesCompared\":\n","            int(\n","                len(partition_rows)\n","                * len(\n","                    VERDICT_DEPENDENT_REC_COLUMNS\n","                )\n","            ),\n","\n","        \"MismatchingFeatureValues\":\n","            int(\n","                partition_mismatches\n","            ),\n","    })\n","\n","\n","verdict_partition_validation = pd.DataFrame(\n","    verdict_partition_records\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 10. Independently document raw TotalAvg discrepancy\n","# ---------------------------------------------------------\n","\n","requested_pair_set = set(\n","    zip(\n","        dataset_with_order[\n","            \"Build\"\n","        ].astype(int),\n","\n","        dataset_with_order[\n","            \"Test\"\n","        ].astype(str),\n","    )\n",")\n","\n","\n","raw_total_average_records = []\n","\n","\n","for test_id, test_history in (\n","    rec_execution_history.groupby(\n","        \"test\",\n","        sort=False,\n","    )\n","):\n","    test_id = str(\n","        test_id\n","    )\n","\n","\n","    test_history = (\n","        test_history\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"_JobSort\",\n","                \"_OriginalExecutionOrder\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    for current_position in range(\n","        len(test_history)\n","    ):\n","        current_row = (\n","            test_history.iloc[\n","                current_position\n","            ]\n","        )\n","\n","\n","        current_build = int(\n","            current_row[\n","                \"build\"\n","            ]\n","        )\n","\n","\n","        pair = (\n","            current_build,\n","            test_id,\n","        )\n","\n","\n","        if pair not in requested_pair_set:\n","            continue\n","\n","\n","        history = (\n","            test_history.iloc[\n","                :current_position\n","            ]\n","        )\n","\n","\n","        raw_total_average = (\n","            -1.0\n","            if history.empty\n","            else float(\n","                history[\n","                    \"duration\"\n","                ].mean()\n","            )\n","        )\n","\n","\n","        raw_total_average_records.append({\n","            \"Build\":\n","                current_build,\n","\n","            \"Test\":\n","                test_id,\n","\n","            \"RawReconstructedTotalAvg\":\n","                raw_total_average,\n","\n","            \"PriorExecutionCount\":\n","                int(\n","                    len(history)\n","                ),\n","        })\n","\n","\n","raw_total_average_reconstruction = pd.DataFrame(\n","    raw_total_average_records\n",")\n","\n","\n","if raw_total_average_reconstruction.duplicated(\n","    subset=[\n","        \"Build\",\n","        \"Test\",\n","    ]\n",").any():\n","    raise AssertionError(\n","        \"Raw TotalAvg reconstruction contains \"\n","        \"duplicate Build-Test pairs.\"\n","    )\n","\n","\n","raw_total_average_comparison = (\n","    dataset_with_order[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"build_order\",\n","            \"partition\",\n","            \"REC_TotalAvgExeTime\",\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","raw_total_average_comparison[\n","    \"Build\"\n","] = pd.to_numeric(\n","    raw_total_average_comparison[\n","        \"Build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","raw_total_average_comparison[\n","    \"Test\"\n","] = (\n","    raw_total_average_comparison[\n","        \"Test\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","raw_total_average_comparison = (\n","    raw_total_average_comparison\n","    .merge(\n","        raw_total_average_reconstruction,\n","        on=[\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        how=\"left\",\n","        validate=\"one-to-one\",\n","    )\n",")\n","\n","\n","raw_total_average_comparison[\n","    \"AbsoluteDifference\"\n","] = (\n","    raw_total_average_comparison[\n","        \"REC_TotalAvgExeTime\"\n","    ].astype(float)\n","    - raw_total_average_comparison[\n","        \"RawReconstructedTotalAvg\"\n","    ].astype(float)\n",").abs()\n","\n","\n","raw_total_average_comparison[\n","    \"Matches\"\n","] = np.isclose(\n","    raw_total_average_comparison[\n","        \"REC_TotalAvgExeTime\"\n","    ].to_numpy(dtype=float),\n","\n","    raw_total_average_comparison[\n","        \"RawReconstructedTotalAvg\"\n","    ].to_numpy(dtype=float),\n","\n","    rtol=1e-9,\n","    atol=1e-9,\n","    equal_nan=True,\n",")\n","\n","\n","raw_total_average_mismatches = (\n","    raw_total_average_comparison[\n","        ~raw_total_average_comparison[\n","            \"Matches\"\n","        ]\n","    ]\n","    .copy()\n","    .reset_index(drop=True)\n",")\n","\n","\n","raw_total_average_mismatch_count = int(\n","    len(\n","        raw_total_average_mismatches\n","    )\n",")\n","\n","\n","raw_total_average_affected_tests = sorted(\n","    raw_total_average_mismatches[\n","        \"Test\"\n","    ]\n","    .astype(str)\n","    .unique()\n","    .tolist()\n",")\n","\n","\n","raw_total_average_affected_partitions = sorted(\n","    raw_total_average_mismatches[\n","        \"partition\"\n","    ]\n","    .astype(str)\n","    .unique()\n","    .tolist()\n",")\n","\n","\n","# Validate the exact discrepancy already observed.\n","if raw_total_average_mismatch_count != 50:\n","    raise AssertionError(\n","        \"Expected 50 documented raw \"\n","        \"REC_TotalAvgExeTime discrepancies.\\n\"\n","        f\"Observed: {raw_total_average_mismatch_count}\"\n","    )\n","\n","\n","if raw_total_average_affected_tests != [\n","    \"619\",\n","    \"785\",\n","]:\n","    raise AssertionError(\n","        \"Unexpected tests are affected by the raw \"\n","        \"TotalAvg discrepancy.\\n\"\n","        f\"Observed: {raw_total_average_affected_tests}\"\n","    )\n","\n","\n","if raw_total_average_affected_partitions != [\n","    \"training\",\n","]:\n","    raise AssertionError(\n","        \"The TotalAvg discrepancy is not isolated \"\n","        \"to the training partition.\\n\"\n","        f\"Observed: \"\n","        f\"{raw_total_average_af