nel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () =\u003e {\n","        google.colab.notebook.generateWithVariable('seed1_noise_comparison');\n","      }\n","      })();\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","    \u003c/div\u003e\n","  \u003c/div\u003e\n"],"text/plain":["   NoiseLevel  ActualFlips  RealisedNoisePercentage  TrainingPasses  \\\n","0           0            0                 0.000000            2725   \n","1           5          382                 4.966844            2630   \n","2          10          775                10.076713            2527   \n","\n","   TrainingFailures  MeanAPFD  MeanAPFDc  \n","0               256  0.854973   0.862230  \n","1               351  0.688840   0.699331  \n","2               454  0.470408   0.476458  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","10% evaluation-build results: 28\n","10% ranking rows: 702\n"]}],"source":["# ---------------------------------------------------------\n","# CORRECTED 10% NOISE VALIDATION — SEED 1\n","# ---------------------------------------------------------\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","RF_10PCT_NOISE_PROBABILITY = 0.10\n","RF_10PCT_NOISE_LEVEL = 10\n","VALIDATION_SEED = 1\n","\n","\n","# ---------------------------------------------------------\n","# CHECK THAT REQUIRED OBJECTS EXIST\n","# ---------------------------------------------------------\n","\n","required_objects = [\n","    \"exe_for_rec\",\n","    \"clean_training_data\",\n","    \"clean_evaluation_data\",\n","    \"training_build_ids\",\n","    \"evaluation_build_ids\",\n","    \"RECENT_WINDOW\",\n","    \"REC_FEATURE_COLUMNS\",\n","    \"final_model_feature_columns\",\n","    \"inject_training_verdict_noise\",\n","    \"reconstruct_rec_features\",\n","    \"run_random_forest_repetition\",\n","    \"rf_0pct_project_results\",\n","    \"rf_5pct_project_results\",\n","    \"dataset\",\n","]\n","\n","missing_objects = [\n","    name\n","    for name in required_objects\n","    if name not in globals()\n","]\n","\n","if missing_objects:\n","    raise NameError(\n","        \"The following required objects are missing: \"\n","        + \", \".join(missing_objects)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# CORRECTED REUSABLE NOISY-DATA FUNCTION\n","# ---------------------------------------------------------\n","\n","def create_noisy_model_training_data(\n","    clean_execution_history,\n","    clean_model_training_data,\n","    training_ids,\n","    noise_probability,\n","    seed,\n","):\n","    \"\"\"\n","    Inject training-only verdict noise, recompute all REC_*\n","    features, and create the fixed model-ready training set.\n","\n","    The Build-Test rows remain fixed across conditions.\n","    \"\"\"\n","\n","    (\n","        noisy_execution_history,\n","        noise_audit,\n","        failure_type_counts,\n","    ) = inject_training_verdict_noise(\n","        clean_execution_history=clean_execution_history,\n","        training_ids=training_ids,\n","        noise_probability=noise_probability,\n","        seed=seed,\n","    )\n","\n","    # ---------------------------------------------\n","    # RECONSTRUCT THE REC_* FEATURES\n","    # ---------------------------------------------\n","\n","    requested_rows = (\n","        clean_model_training_data[\n","            [\"Build\", \"Test\"]\n","        ]\n","        .copy()\n","    )\n","\n","    if requested_rows.duplicated(\n","        subset=[\"Build\", \"Test\"]\n","    ).any():\n","        raise ValueError(\n","            f\"Seed {seed}: clean model data contains \"\n","            \"duplicate Build-Test rows.\"\n","        )\n","\n","    reconstructed_rec = reconstruct_rec_features(\n","        execution_history=noisy_execution_history,\n","        requested_rows=requested_rows,\n","        recent_window=RECENT_WINDOW,\n","    )\n","\n","    if len(reconstructed_rec) != len(\n","        clean_model_training_data\n","    ):\n","        raise ValueError(\n","            f\"Seed {seed}: expected \"\n","            f\"{len(clean_model_training_data)} reconstructed \"\n","            f\"rows but obtained {len(reconstructed_rec)}.\"\n","        )\n","\n","    if reconstructed_rec.duplicated(\n","        subset=[\"Build\", \"Test\"]\n","    ).any():\n","        raise ValueError(\n","            f\"Seed {seed}: reconstructed REC data contains \"\n","            \"duplicate Build-Test rows.\"\n","        )\n","\n","    if reconstructed_rec[\n","        REC_FEATURE_COLUMNS\n","    ].isna().any().any():\n","        raise ValueError(\n","            f\"Seed {seed}: reconstructed REC features \"\n","            \"contain missing values.\"\n","        )\n","\n","    if not np.isfinite(\n","        reconstructed_rec[\n","            REC_FEATURE_COLUMNS\n","        ].to_numpy(dtype=float)\n","    ).all():\n","        raise ValueError(\n","            f\"Seed {seed}: reconstructed REC features \"\n","            \"contain non-finite values.\"\n","        )\n","\n","    # ---------------------------------------------\n","    # OBTAIN THE NOISY CURRENT LABELS\n","    # ---------------------------------------------\n","\n","    noisy_label_lookup = (\n","        noisy_execution_history[\n","            noisy_execution_history[\"build\"].isin(\n","                training_ids\n","            )\n","        ][\n","            [\"build\", \"test\", \"verdict\"]\n","        ]\n","        .rename(\n","            columns={\n","                \"build\": \"Build\",\n","                \"test\": \"Test\",\n","                \"verdict\": \"NoisyVerdict\",\n","            }\n","        )\n","        .copy()\n","    )\n","\n","    if noisy_label_lookup.duplicated(\n","        subset=[\"Build\", \"Test\"]\n","    ).any():\n","        raise ValueError(\n","            f\"Seed {seed}: noisy execution history contains \"\n","            \"duplicate Build-Test labels.\"\n","        )\n","\n","    noisy_training_data = (\n","        clean_model_training_data\n","        .copy()\n","        .merge(\n","            noisy_label_lookup,\n","            on=[\"Build\", \"Test\"],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","    )\n","\n","    if noisy_training_data[\n","        \"NoisyVerdict\"\n","    ].isna().any():\n","        raise ValueError(\n","            f\"Seed {seed}: some model-ready rows lack \"\n","            \"a noisy verdict.\"\n","        )\n","\n","    noisy_training_data[\"Verdict\"] = (\n","        noisy_training_data[\n","            \"NoisyVerdict\"\n","        ].astype(int)\n","    )\n","\n","    noisy_training_data = (\n","        noisy_training_data\n","        .drop(\n","            columns=[\n","                \"NoisyVerdict\",\n","                *REC_FEATURE_COLUMNS,\n","            ]\n","        )\n","        .merge(\n","            reconstructed_rec,\n","            on=[\"Build\", \"Test\"],\n","            how=\"left\",\n","            validate=\"one_to_one\",\n","        )\n","    )\n","\n","    # Restore the original model-data column order.\n","    expected_columns = (\n","        list(dataset.columns)\n","        + [\"build_order\"]\n","    )\n","\n","    missing_columns = [\n","        column\n","        for column in expected_columns\n","        if column not in noisy_training_data.columns\n","    ]\n","\n","    if missing_columns:\n","        raise ValueError(\n","            f\"Seed {seed}: noisy model dataset is missing: \"\n","            + \", \".join(missing_columns)\n","        )\n","\n","    noisy_training_data = (\n","        noisy_training_data[\n","            expected_columns\n","        ]\n","        .sort_values(\n","            [\"build_order\", \"Test\"]\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    # ---------------------------------------------\n","    # KEY-BASED LABEL-COMPARISON AUDIT\n","    # ---------------------------------------------\n","\n","    clean_labels = (\n","        clean_model_training_data[\n","            [\"Build\", \"Test\", \"Verdict\"]\n","        ]\n","        .rename(\n","            columns={\n","                \"Verdict\": \"CleanModelVerdict\"\n","            }\n","        )\n","    )\n","\n","    noisy_labels = (\n","        noisy_training_data[\n","            [\"Build\", \"Test\", \"Verdict\"]\n","        ]\n","        .rename(\n","            columns={\n","                \"Verdict\": \"NoisyModelVerdict\"\n","            }\n","        )\n","    )\n","\n","    label_comparison = (\n","        clean_labels.merge(\n","            noisy_labels,\n","            on=[\"Build\", \"Test\"],\n","            how=\"outer\",\n","            validate=\"one_to_one\",\n","            indicator=True,\n","        )\n","    )\n","\n","    if not (\n","        label_comparison[\"_merge\"] == \"both\"\n","    ).all():\n","        raise ValueError(\n","            f\"Seed {seed}: clean and noisy model datasets \"\n","            \"do not contain identical Build-Test rows.\"\n","        )\n","\n","    model_label_changes = int(\n","        (\n","            label_comparison[\n","                \"CleanModelVerdict\"\n","            ]\n","            !=\n","            label_comparison[\n","                \"NoisyModelVerdict\"\n","            ]\n","        ).sum()\n","    )\n","\n","    # ---------------------------------------------\n","    # NOISE AUDIT SUMMARY\n","    # ---------------------------------------------\n","\n","    flipped_rows = noise_audit[\n","        noise_audit[\"WasFlipped\"]\n","    ]\n","\n","    pass_to_failure = int(\n","        (\n","            flipped_rows[\"FlipDirection\"]\n","            == \"PassToFailure\"\n","        ).sum()\n","    )\n","\n","    failure_to_pass = int(\n","        (\n","            flipped_rows[\"FlipDirection\"]\n","            == \"FailureToPass\"\n","        ).sum()\n","    )\n","\n","    noise_summary = {\n","        \"NoiseSeed\": seed,\n","        \"NoiseLevel\": noise_probability * 100,\n","        \"EligibleExecutionRows\": len(noise_audit),\n","        \"ActualFlips\": int(\n","            noise_audit[\"WasFlipped\"].sum()\n","        ),\n","        \"RealisedNoisePercentage\": float(\n","            noise_audit[\"WasFlipped\"].mean()\n","            * 100\n","        ),\n","        \"PassToFailureFlips\": pass_to_failure,\n","        \"FailureToPassFlips\": failure_to_pass,\n","        \"ModelRowLabelChanges\": model_label_changes,\n","        \"NoisyModelPasses\": int(\n","            (\n","                noisy_training_data[\"Verdict\"] == 0\n","            ).sum()\n","        ),\n","        \"NoisyModelFailures\": int(\n","            (\n","                noisy_training_data[\"Verdict\"] != 0\n","            ).sum()\n","        ),\n","    }\n","\n","    return (\n","        noisy_training_data,\n","        noisy_execution_history,\n","        noise_audit,\n","        noise_summary,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# RECREATE THE 5% SEED-1 AUDIT IN THIS CELL\n","# ---------------------------------------------------------\n","# This avoids relying on an old/stale notebook variable.\n","\n","(\n","    _,\n","    recreated_noise_audit_5_seed1,\n","    _,\n",") = inject_training_verdict_noise(\n","    clean_execution_history=exe_for_rec,\n","    training_ids=training_build_ids,\n","    noise_probability=0.05,\n","    seed=VALIDATION_SEED,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# CREATE 10% NOISY TRAINING DATA\n","# ---------------------------------------------------------\n","\n","(\n","    noisy_training_data_10_seed1,\n","    noisy_exe_10_seed1,\n","    noise_audit_10_seed1,\n","    noise_summary_10_seed1,\n",") = create_noisy_model_training_data(\n","    clean_execution_history=exe_for_rec,\n","    clean_model_training_data=cl