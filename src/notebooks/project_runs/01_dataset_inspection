ed-level Mean APFDc: 0.8648870556210881\n","Standard deviation across seeds for Mean APFD: 0.0016789272663565355\n","Standard deviation across seeds for Mean APFDc: 0.009791878214263356\n","\n","=== SAVED FILES ===\n","/content/formal_results/angel_rf_0pct_project_level.csv\n","/content/formal_results/angel_rf_0pct_build_level.csv\n","/content/formal_results/angel_rf_0pct_rankings.csv.gz\n","/content/formal_results/angel_rf_experiment_configuration.json\n","/content/formal_results/angel_rf_feature_columns.txt\n"]}],"source":["# ---------------------------------------------------------\n","# FORMAL RANDOM FOREST EXPERIMENT:\n","# 30 REPETITIONS AT 0% NOISE\n","# ---------------------------------------------------------\n","\n","from pathlib import Path\n","import gc\n","import json\n","import time\n","\n","import numpy as np\n","import pandas as pd\n","\n","from sklearn.ensemble import RandomForestClassifier\n","\n","\n","# ---------------------------------------------------------\n","# FREEZE THE RANDOM FOREST CONFIGURATION\n","# ---------------------------------------------------------\n","\n","RF_FIXED_CONFIG = {\n","    \"n_estimators\": 100,\n","    \"criterion\": \"gini\",\n","    \"max_depth\": None,\n","    \"min_samples_split\": 2,\n","    \"min_samples_leaf\": 1,\n","    \"max_features\": \"sqrt\",\n","    \"bootstrap\": True,\n","    \"class_weight\": None,\n","    \"n_jobs\": -1,\n","}\n","\n","REPETITION_SEEDS = list(range(1, 31))\n","\n","PROJECT_NAME = \"Angel-ML@angel\"\n","MODEL_NAME = \"RandomForest\"\n","NOISE_LEVEL = 0\n","\n","\n","# ---------------------------------------------------------\n","# SINGLE-REPETITION FUNCTION\n","# ---------------------------------------------------------\n","\n","def run_random_forest_repetition(\n","    training_data,\n","    repetition_seed,\n","    noise_level,\n","):\n","    \"\"\"\n","    Train and evaluate one Random Forest repetition.\n","\n","    Parameters\n","    ----------\n","    training_data:\n","        Model-ready training rows. At 0% this is the\n","        original clean training dataset. At later noise\n","        levels this will contain corrupted labels and\n","        reconstructed REC_* features.\n","\n","    repetition_seed:\n","        Seed controlling Random Forest randomness.\n","\n","    noise_level:\n","        Percentage of training verdicts corrupted.\n","        This function currently receives 0.\n","\n","    Returns\n","    -------\n","    project_result:\n","        One project-level result for this repetition.\n","\n","    build_results:\n","        APFD and APFDc for every evaluation build.\n","\n","    ranking_results:\n","        Ranked test cases for every evaluation build.\n","    \"\"\"\n","\n","    repetition_start = time.perf_counter()\n","\n","    # ---------------------------------------------\n","    # PREPARE TRAINING DATA\n","    # ---------------------------------------------\n","\n","    X_training = (\n","        training_data[\n","            final_model_feature_columns\n","        ]\n","        .astype(float)\n","        .copy()\n","    )\n","\n","    y_training = (\n","        training_data[\"Verdict\"] != 0\n","    ).astype(int)\n","\n","    if not np.isfinite(\n","        X_training.to_numpy()\n","    ).all():\n","        raise ValueError(\n","            f\"Seed {repetition_seed}: \"\n","            \"training predictors contain NaN or infinity.\"\n","        )\n","\n","    if y_training.nunique() != 2:\n","        raise ValueError(\n","            f\"Seed {repetition_seed}: \"\n","            \"training data does not contain both classes.\"\n","        )\n","\n","    # Evaluation remains completely clean.\n","    X_clean_evaluation = (\n","        clean_evaluation_data[\n","            final_model_feature_columns\n","        ]\n","        .astype(float)\n","        .copy()\n","    )\n","\n","    # ---------------------------------------------\n","    # TRAIN MODEL\n","    # ---------------------------------------------\n","\n","    model = RandomForestClassifier(\n","        **RF_FIXED_CONFIG,\n","        random_state=repetition_seed,\n","    )\n","\n","    model.fit(\n","        X_training,\n","        y_training,\n","    )\n","\n","    if 1 not in model.classes_:\n","        raise ValueError(\n","            f\"Seed {repetition_seed}: \"\n","            \"the model did not learn the failure class.\"\n","        )\n","\n","    failure_class_index = int(\n","        np.where(model.classes_ == 1)[0][0]\n","    )\n","\n","    predicted_failure_probabilities = (\n","        model.predict_proba(\n","            X_clean_evaluation\n","        )[:, failure_class_index]\n","    )\n","\n","    if not np.isfinite(\n","        predicted_failure_probabilities\n","    ).all():\n","        raise ValueError(\n","            f\"Seed {repetition_seed}: \"\n","            \"predictions contain NaN or infinity.\"\n","        )\n","\n","    # ---------------------------------------------\n","    # RANK TESTS WITHIN EACH EVALUATION BUILD\n","    # ---------------------------------------------\n","\n","    ranking_results = (\n","        evaluation_metadata\n","        .reset_index(drop=True)\n","        .copy()\n","    )\n","\n","    ranking_results[\"BinaryFailure\"] = (\n","        y_evaluation\n","        .reset_index(drop=True)\n","        .to_numpy()\n","    )\n","\n","    ranking_results[\n","        \"PredictedFailureProbability\"\n","    ] = predicted_failure_probabilities\n","\n","    ranking_results = (\n","        ranking_results\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"PredictedFailureProbability\",\n","                \"Test\",\n","            ],\n","            ascending=[\n","                True,\n","                False,\n","                True,\n","            ],\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    ranking_results[\"RF_Rank\"] = (\n","        ranking_results\n","        .groupby(\"