luation_unchanged,\n",")\n","\n","\n","print(\n","    \"\\nMetric validation:\"\n",")\n","\n","print(\n","    \"APFD:\",\n","    round(\n","        manual_apfd,\n","        6,\n","    ),\n",")\n","\n","print(\n","    \"APFDc long failure first:\",\n","    round(\n","        manual_apfdc_long_failure_first,\n","        6,\n","    ),\n",")\n","\n","print(\n","    \"APFDc quick failure first:\",\n","    round(\n","        manual_apfdc_quick_failure_first,\n","        6,\n","    ),\n",")\n","\n","\n","print(\n","    \"\\nValidation files saved:\"\n",")\n","\n","print(\n","    HELPER_VALIDATION_PATH\n",")\n","\n","print(\n","    NOISE_SELFTEST_PATH\n",")\n","\n","\n","print(\n","    \"\\nSUCCESS: Paho MQTT canonical noise \"\n","    \"helpers are ready.\"\n",")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":1004,"status":"ok","timestamp":1784907754587,"user":{"displayName":"2OO11M22O3 Ramakrishna","userId":"04172343459538840215"},"user_tz":-120},"id":"tarpbu4GyixE","outputId":"c3eb0ba5-8b2b-49d6-b9ae-d31ad22ec2cb"},"outputs":[{"name":"stdout","output_type":"stream","text":["=== PAHO MQTT FEATURE PROTOCOL ===\n","Original predictor columns: 150\n","Frozen zero-variance columns: 1\n","Active predictor columns: 149\n","\n","Zero-variance columns:\n"," - TES_COM_CountDeclMethodProtected\n","\n","Model configuration saved:\n","/content/drive/MyDrive/Thesis_Experiment/Notes/eclipse__paho.mqtt.java_model_configuration_v1.json\n","\n","Expected rows for one condition:\n","Ranking rows: 6860\n","Build-metric rows: 140\n","Project-run rows: 7\n","\n","SUCCESS: Paho MQTT unified condition runner is defined.\n"]}],"source":["# =========================================================\n","# PROJECT 4: PAHO MQTT\n","# UNIFIED EXPERIMENT CONDITION RUNNER\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","import time\n","import warnings\n","\n","import numpy as np\n","import pandas as pd\n","\n","from sklearn.ensemble import RandomForestClassifier\n","from sklearn.naive_bayes import GaussianNB\n","\n","from xgboost import XGBClassifier\n","from lightgbm import LGBMClassifier\n","\n","\n","# ---------------------------------------------------------\n","# 1. Confirm project configuration\n","# ---------------------------------------------------------\n","\n","PROJECT_NAME = \"eclipse@paho.mqtt.java\"\n","PROJECT_SLUG = \"eclipse__paho.mqtt.java\"\n","\n","PROJECT_RAW_RESULTS = (\n","    RAW_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    AGGREGATED_RESULTS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","PROJECT_LOGS = (\n","    LOGS_DRIVE\n","    / PROJECT_SLUG\n",")\n","\n","\n","for directory in [\n","    PROJECT_RAW_RESULTS,\n","    PROJECT_AGGREGATED_RESULTS,\n","    PROJECT_LOGS,\n","]:\n","    directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","if len(clean_training_data) != 2320:\n","    raise AssertionError(\n","        \"Unexpected model-ready training row count.\"\n","    )\n","\n","if len(clean_evaluation_data) != 980:\n","    raise AssertionError(\n","        \"Unexpected model-ready evaluation row count.\"\n","    )\n","\n","if clean_evaluation_data[\n","    \"Build\"\n","].nunique() != 20:\n","    raise AssertionError(\n","        \"Expected 20 scored evaluation builds.\"\n","    )\n","\n","if len(MODEL_FEATURE_COLUMNS) != 150:\n","    raise AssertionError(\n","        \"Expected exactly 150 model predictors.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 2. Freeze feature preprocessing\n","# ---------------------------------------------------------\n","\n","clean_feature_frame = (\n","    clean_training_data[\n","        MODEL_FEATURE_COLUMNS\n","    ]\n","    .apply(\n","        pd.to_numeric,\n","        errors=\"coerce\",\n","    )\n","    .replace(\n","        [\n","            np.inf,\n","            -np.inf,\n","        ],\n","        np.nan,\n","    )\n",")\n","\n","\n","# Zero-variance predictors are identified only from the\n","# clean training partition. The same predictor set is used\n","# for every noise level, seed and supervised model.\n","feature_variation = (\n","    clean_feature_frame\n","    .nunique(\n","        dropna=False\n","    )\n",")\n","\n","\n","ZERO_VARIANCE_FEATURES = (\n","    feature_variation[\n","        feature_variation \u003c= 1\n","    ]\n","    .index\n","    .tolist()\n",")\n","\n","\n","ACTIVE_FEATURE_COLUMNS = [\n","    column\n","    for column in MODEL_FEATURE_COLUMNS\n","    if column not in ZERO_VARIANCE_FEATURES\n","]\n","\n","\n","if len(ACTIVE_FEATURE_COLUMNS) == 0:\n","    raise AssertionError(\n","        \"No active predictors remain.\"\n","    )\n","\n","if (\n","    len(ACTIVE_FEATURE_COLUMNS)\n","    + len(ZERO_VARIANCE_FEATURES)\n","    != len(MODEL_FEATURE_COLUMNS)\n","):\n","    raise AssertionError(\n","        \"Feature partition is inconsistent.\"\n","    )\n","\n","\n","print(\"=== PAHO MQTT FEATURE PROTOCOL ===\")\n","\n","print(\n","    \"Original predictor columns:\",\n","    len(MODEL_FEATURE_COLUMNS),\n",")\n","\n","print(\n","    \"Frozen zero-variance columns:\",\n","    len(ZERO_VARIANCE_FEATURES),\n",")\n","\n","print(\n","    \"Active predictor columns:\",\n","    len(ACTIVE_FEATURE_COLUMNS),\n",")\n","\n","print(\"\\nZero-variance columns:\")\n","\n","for column in ZERO_VARIANCE_FEATURES:\n","    print(\" -\", column)\n","\n","\n","# ---------------------------------------------------------\n","# 3. Frozen model configuration\n","# ---------------------------------------------------------\n","\n","MODEL_CONFIG = {\n","    \"RandomForest\": {\n","        \"n_estimators\": 100,\n","        \"criterion\": \"gini\",\n","        \"max_depth\": None,\n","        \"min_samples_split\": 2,\n","        \"min_samples_leaf\": 1,\n","        \"max_features\": \"sqrt\",\n","        \"bootstrap\": True,\n","        \"class_weight\": None,\n","    },\n","\n","    \"XGBoost\": {\n","        \"n_estimators\": 100,\n","        \"max_depth\": 6,\n","        \"learning_rate\": 0.1,\n","        \"subsample\": 1.0,\n","        \"colsample_bytree\": 1.0,\n","        \"objective\": \"binary:logistic\",\n","        \"eval_metric\": \"logloss\",\n","        \"tree_method\": \"hist\",\n","    },\n","\n","    \"LightGBM\": {\n","        \"n_estimators\": 100,\n","        \"learning_rate\": 0.1,\n","        \"num_leaves\": 31,\n","        \"objective\": \"binary\",\n","    },\n","\n","    \"NaiveBayes\": {\n","        \"variant\": \"GaussianNB\",\n","        \"var_smoothing\": 1e-9,\n","    },\n","}\n","\n","\n","MODEL_CONFIGURATION_PATH = (\n","    NOTES_DRIVE\n","    / (\n","        \"eclipse__paho.mqtt.java_\"\n","        \"model_configuration_v1.json\"\n","    )\n",")\n","\n","\n","with open(\n","    MODEL_CONFIGURATION_PATH,\n","    \"w\",\n","    encoding=\"utf-8\",\n",") as configuration_file:\n","\n","    json.dump(\n","        {\n","            \"project\":\n","                PROJECT_NAME,\n","\n","            \"original_feature_count\":\n","                len(MODEL_FEATURE_COLUMNS),\n","\n","            \"active_feature_count\":\n","                len(ACTIVE_FEATURE_COLUMNS),\n","\n","            \"zero_variance_feature_count\":\n","                len(ZERO_VARIANCE_FEATURES),\n","\n","            \"active_features\":\n","                ACTIVE_FEATURE_COLUMNS,\n","\n","            \"zero_variance_features\":\n","                ZERO_VARIANCE_FEATURES,\n","\n","            \"feature_selection_rule\": (\n","                \"zero-variance predictors identified \"\n","                \"using only the clean training partition \"\n","                \"and frozen across all conditions\"\n","            ),\n","\n","            \"missing_value_rule\": (\n","                \"condition-specific training median; \"\n","                \"the same learned medians are applied \"\n","                \"to training and clean evaluation data\"\n","            ),\n","\n","            \"infinite_value_rule\": (\n","                \"replace positive and negative infinity \"\n","                \"with missing before median imputation\"\n","            ),\n","\n","            \"tie_rule\":\n","                \"score first, Test ascending\",\n","\n","            \"models\":\n","                MODEL_CONFIG,\n","        },\n","        configuration_file,\n","        indent=2,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Prepare shared ML matrices\n","# ---------------------------------------------------------\n","\n","def prepare_ml_matrices(\n","    noisy_training_data,\n","    evaluation_data,\n","):\n","    \"\"\"\n","    Create the common train/evaluation matrices used by\n","    all four supervised ML models.\n","\n","    Training medians are learned independently for the\n","    current project×noise×seed condition.\n","    \"\"\"\n","\n","    X_train = (\n","        noisy_training_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [\n","                np.inf,\n","                -np.inf,\n","            ],\n","            np.nan,\n","        )\n","    )\n","\n","\n","    X_evaluation = (\n","        evaluation_data[\n","            ACTIVE_FEATURE_COLUMNS\n","        ]\n","        .apply(\n","            pd.to_numeric,\n","            errors=\"coerce\",\n","        )\n","        .replace(\n","            [\n","                np.inf,\n","                -np.inf,\n","            ],\n","            np.nan,\n","        )\n","    )\n","\n","\n","    if list(\n","        X_train.columns\n","    ) != ACTIVE_FEATURE_COLUMNS:\n","        raise AssertionError(\n","            \"Training feature order changed.\"\n","        )\n","\n","    if list(\n","        X_evaluation.columns\n","    ) != ACTIVE_FEATURE_COLUMNS:\n","        raise AssertionError(\n","            \"Evaluation feature order changed.\"\n","        )\n","\n","\n","    training_medians = (\n","        X_train\n","        .median(axis=0)\n","        .fillna(0.0)\n","    )\n","\n","\n","    X_train = (\n","        X_train\n","        .fillna(\n","            training_medians\n","        )\n","        .astype(float)\n","    )\n","\n","\n","    X_evaluation = (\n","        X_evaluation\n","        .fillna(\n","            training_medians\n","        )\n","        .astype(float)\n","    )\n","\n","\n","    y_train = (\n","        noisy_training_data[\n","            \"Verdict\"\n","        ] != 0\n","    ).astype(int)\n","\n","\n","    if len(X_train) != len(\n","        noisy_training_data\n","    ):\n","        raise AssertionError(\n","            \"Training matrix row count changed.\"\n","        )\n","\n","    if len(X_evaluation) != len(\n","        evaluation_data\n","    ):\n","        raise AssertionError(\n","            \"Evaluation matrix row count changed.\"\n","        )\n","\n","    if y_train.nunique() != 2:\n","        raise ValueError(\n","            \"The noisy training labels do not contain \"\n","            \"both classes.\"\n","        )\n","\n","    if X_train.isna().any().any():\n","        raise ValueError(\n","            \"Training features still contain \"\n","            \"missing values.\"\n","        )\n","\n","    if X_evaluation.isna().any().any():\n","        raise ValueError(\n","            \"Evaluation features still contain \"\n","            \"missing values.\"\n","        )\n","\n","    if not np.isfinite(\n","        X_train.to_numpy(\n","            dtype=float\n","        )\n","    ).all():\n","        raise ValueError(\n","            \"Training features contain invalid values.\"\n","        )\n","\n","    if not np.isfinite(\n","        X_evaluation.to_numpy(\n","            dtype=float\n","        )\n","    ).all():\n","        raise ValueError(\n","            \"Evaluation features contain invalid values.\"\n","        )\n","\n","\n","    return (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 5. Create the four supervised models\n","# ---------------------------------------------------------\n","\n","def create_ml_models(\n","    repetition_seed,\n","):\n","    \"\"\"\n","    Create all four models using reproducible,\n","    project-specific model seeds.\n","    \"\"\"\n","\n","    rf_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"RandomForest_model\",\n","    )\n","\n","    xgb_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"XGBoost_model\",\n","    )\n","\n","    lgbm_seed = stable_project_seed(\n","        PROJECT_NAME,\n","        repetition_seed,\n","        \"LightGBM_model\",\n","    )\n","\n","\n","    return {\n","        \"RandomForest\":\n","            RandomForestClassifier(\n","                **MODEL_CONFIG[\n","                    \"RandomForest\"\n","                ],\n","                random_state=rf_seed,\n","                n_jobs=-1,\n","            ),\n","\n","        \"XGBoost\":\n","            XGBClassifier(\n","                **MODEL_CONFIG[\n","                    \"XGBoost\"\n","                ],\n","                random_state=xgb_seed,\n","                n_jobs=-1,\n","                verbosity=0,\n","            ),\n","\n","        \"LightGBM\":\n","            LGBMClassifier(\n","                **MODEL_CONFIG[\n","                    \"LightGBM\"\n","                ],\n","                random_state=lgbm_seed,\n","                n_jobs=-1,\n","                verbosity=-1,\n","                deterministic=True,\n","                force_col_wise=True,\n","            ),\n","\n","        \"NaiveBayes\":\n","            GaussianNB(\n","                var_smoothing=(\n","                    MODEL_CONFIG[\n","                        \"NaiveBayes\"\n","                    ][\n","                        \"var_smoothing\"\n","                    ]\n","                )\n","            ),\n","    }\n","\n","\n","# ---------------------------------------------------------\n","# 6. Extract positive-class probabilities\n","# ---------------------------------------------------------\n","\n","def get_failure_probability(\n","    fitted_model,\n","    feature_matrix,\n","):\n","    \"\"\"\n","    Extract P(failure=1) from a fitted binary classifier.\n","    \"\"\"\n","\n","    probabilities = (\n","        fitted_model\n","        .predict_proba(\n","            feature_matrix\n","        )\n","    )\n","\n","\n","    classes = np.asarray(\n","        fitted_model.classes_\n","    )\n","\n","\n","    positive_positions = np.where(\n","        classes == 1\n","    )[0]\n","\n","\n","    if len(\n","        positive_positions\n","    ) != 1:\n","        raise ValueError(\n","            \"Could not identify failure class 1.\"\n","        )\n","\n","\n","    failure_probabilities = (\n","        probabilities[\n","            :,\n","            positive_positions[0],\n","        ]\n","    )\n","\n","\n","    if len(\n","        failure_probabilities\n","    ) != len(\n","        feature_matrix\n","    ):\n","        raise AssertionError(\n","            \"Probability row count mismatch.\"\n","        )\n","\n","\n","    if not np.isfinite(\n","        failure_probabilities\n","    ).all():\n","        raise ValueError(\n","            \"Predicted probabilities contain \"\n","            \"invalid values.\"\n","        )\n","\n","\n","    if (\n","        (\n","            failure_probabilities \u003c 0.0\n","        ).any()\n","        or (\n","            failure_probabilities \u003e 1.0\n","        ).any()\n","    ):\n","        raise ValueError(\n","            \"Predicted probabilities are outside [0, 1].\"\n","        )\n","\n","\n","    return failure_probabilities\n","\n","\n","# ---------------------------------------------------------\n","# 7. Rank one evaluation build\n","# ---------------------------------------------------------\n","\n","def rank_build_rows(\n","    build_rows,\n","    scores,\n","    technique,\n","    score_direction=\"descending\",\n","):\n","    \"\"\"\n","    Rank one evaluation build.\n","\n","    ML, Random and LatestFail use descending scores.\n","    QTF-Avg uses ascending average duration.\n","    \"\"\"\n","\n","    ranked = (\n","        build_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"Duration\",\n","                \"build_order\",\n","            ]\n","        ]\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    scores = np.asarray(\n","        scores,\n","        dtype=float,\n","    )\n","\n","\n","    if len(ranked) != len(\n","        scores\n","    ):\n","        raise ValueError(\n","            \"Number of scores does not match the \"\n","            \"number of evaluation tests.\"\n","        )\n","\n","\n","    if np.isnan(\n","        scores\n","    ).any():\n","        raise ValueError(\n","            \"Ranking scores contain missing values.\"\n","        )\n","\n","\n","    ranked[\n","        \"Technique\"\n","    ] = technique\n","\n","    ranked[\n","        \"Score\"\n","    ] = scores\n","\n","    ranked[\n","        \"ActualFailure\"\n","    ] = (\n","        ranked[\n","            \"Verdict\"\n","        ] != 0\n","    ).astype(int)\n","\n","\n","    ranked[\n","        \"Duration\"\n","    ] = pd.to_numeric(\n","        ranked[\n","            \"Duration\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(float)\n","\n","\n","    if score_direction == \"descending\":\n","\n","        ascending = [\n","            False,\n","            True,\n","        ]\n","\n","    elif score_direction == \"ascending\":\n","\n","        ascending = [\n","            True,\n","            True,\n","        ]\n","\n","    else:\n","\n","        raise ValueError(\n","            \"score_direction must be ascending \"\n","            \"or descending.\"\n","        )\n","\n","\n","    ranked = (\n","        ranked\n","        .sort_values(\n","            [\n","                \"Score\",\n","                \"Test\",\n","            ],\n","            ascending=ascending,\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    ranked[\n","        \"Rank\"\n","    ] = np.arange(\n","        1,\n","        len(ranked) + 1,\n","    )\n","\n","\n","    return ranked\n","\n","\n","# ---------------------------------------------------------\n","# 8. Create ML rankings\n","# ---------------------------------------------------------\n","\n","def create_ml_rankings(\n","    evaluation_data,\n","    technique,\n","    failure_probabilities,\n","):\n","    \"\"\"\n","    Create one ranked test sequence for every model-ready\n","    evaluation build.\n","    \"\"\"\n","\n","    scored_data = (\n","        evaluation_data\n","        .copy()\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    scored_data[\n","        \"_FailureProbability\"\n","    ] = failure_probabilities\n","\n","\n","    ranking_frames = []\n","\n","\n","    for build_id, build_rows in (\n","        scored_data\n","        .groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","\n","        ranking_frames.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","\n","                scores=(\n","                    build_rows[\n","                        \"_FailureProbability\"\n","                    ].to_numpy()\n","                ),\n","\n","                technique=technique,\n","\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","\n","    if not ranking_frames:\n","        raise RuntimeError(\n","            \"No ML evaluation rankings were produced.\"\n","        )\n","\n","\n","    return pd.concat(\n","        ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Random baseline\n","# ---------------------------------------------------------\n","\n","def create_random_rankings(\n","    evaluation_data,\n","    repetition_seed,\n","):\n","    \"\"\"\n","    Generate one project-, build- and seed-specific Random\n","    ordering. The same seed's ordering is reused across\n","    every noise level.\n","    \"\"\"\n","\n","    ranking_frames = []\n","\n","\n","    for build_id, build_rows in (\n","        evaluation_data\n","        .groupby(\n","            \"Build\",\n","            sort=False,\n","        )\n","    ):\n","\n","        random_rng = np.random.default_rng(\n","            stable_project_seed(\n","                PROJECT_NAME,\n","                repetition_seed,\n","                (\n","                    \"Random_baseline_\"\n","                    f\"build_{int(build_id)}\"\n","                ),\n","            )\n","        )\n","\n","\n","        random_scores = (\n","            random_rng.random(\n","                len(build_rows)\n","            )\n","        )\n","\n","\n","        ranking_frames.append(\n","            rank_build_rows(\n","                build_rows=build_rows,\n","                scores=random_scores,\n","                technique=\"Random\",\n","                score_direction=\"descending\",\n","            )\n","        )\n","\n","\n","    return pd.concat(\n","        ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 10. Initialise history-based baselines\n","# ---------------------------------------------------------\n","\n","def initialise_history_baselines(\n","    noisy_training_history,\n","):\n","    \"\"\"\n","    LatestFail starts from the corrupted training verdicts.\n","\n","    QTF-Avg starts from clean historical durations because\n","    verdict flipping does not modify execution duration.\n","    \"\"\"\n","\n","    latest_failure_order = {}\n","\n","\n","    training_sort_columns = [\n","        \"build_order\",\n","    ]\n","\n","    if \"job\" in (\n","        noisy_training_history.columns\n","    ):\n","        training_sort_columns.append(\n","            \"job\"\n","        )\n","\n","    training_sort_columns.append(\n","        \"test\"\n","    )\n","\n","\n","    noisy_history_sorted = (\n","        noisy_training_history\n","        .sort_values(\n","            training_sort_columns,\n","            kind=\"mergesort\",\n","        )\n","    )\n","\n","\n","    for row in (\n","        noisy_history_sorted\n","        .itertuples(\n","            index=False\n","        )\n","    ):\n","\n","        test_key = str(\n","            row.test\n","        )\n","\n","        if int(\n","            row.verdict\n","        ) != 0:\n","\n","            latest_failure_order[\n","                test_key\n","            ] = int(\n","                row.build_order\n","            )\n","\n","\n","    duration_sum = {}\n","    duration_count = {}\n","\n","\n","    clean_duration_history = (\n","        clean_training_history\n","        .sort_values(\n","            training_sort_columns,\n","            kind=\"mergesort\",\n","        )\n","    )\n","\n","\n","    for row in (\n","        clean_duration_history\n","        .itertuples(\n","            index=False\n","        )\n","    ):\n","\n","        test_key = str(\n","            row.test\n","        )\n","\n","        duration = float(\n","            row.duration\n","        )\n","\n","\n","        if not np.isfinite(\n","            duration\n","        ):\n","            continue\n","\n","\n","        duration_sum[\n","            test_key\n","        ] = (\n","            duration_sum.get(\n","                test_key,\n","                0.0,\n","            )\n","            + duration\n","        )\n","\n","\n","        duration_count[\n","            test_key\n","        ] = (\n","            duration_count.get(\n","                test_key,\n","                0,\n","            )\n","            + 1\n","        )\n","\n","\n","    return (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 11. LatestFail and QTF-Avg rankings\n","# ---------------------------------------------------------\n","\n","def create_history_baseline_rankings(\n","    noisy_training_history,\n","):\n","    \"\"\"\n","    Process the clean evaluation period chronologically.\n","\n","    Ranking happens before observing each current build.\n","    Clean evaluation executions then update both baseline\n","    histories for subsequent builds.\n","\n","    Pass-only intermediate evaluation builds update the\n","    histories even when they are absent from dataset.csv.\n","    \"\"\"\n","\n","    (\n","        latest_failure_order,\n","        duration_sum,\n","        duration_count,\n","    ) = initialise_history_baselines(\n","        noisy_training_history\n","    )\n","\n","\n","    target_build_ids = set(\n","        clean_evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","\n","    raw_eval_by_build = {\n","        int(build_id):\n","            rows.copy()\n","\n","        for build_id, rows in (\n","            clean_evaluation_history\n","            .groupby(\n","                \"build\",\n","                sort=False,\n","            )\n","        )\n","    }\n","\n","\n","    model_eval_by_build = {\n","        int(build_id):\n","            rows.copy()\n","\n","        for build_id, rows in (\n","            clean_evaluation_data\n","            .groupby(\n","                \"Build\",\n","                sort=False,\n","            )\n","        )\n","    }\n","\n","\n","    latest_fail_rankings = []\n","    qtf_rankings = []\n","\n","\n","    ordered_evaluation_builds = (\n","        evaluation_build_table\n","        .sort_values(\n","            \"build_order\",\n","            kind=\"mergesort\",\n","        )\n","    )\n","\n","\n","    for build_row in (\n","        ordered_evaluation_builds\n","        .itertuples(\n","            index=False\n","        )\n","    ):\n","\n","        build_id = int(\n","            build_row.id\n","        )\n","\n","\n","        # Rank before observing this build's verdicts\n","        # or durations.\n","        if build_id in target_build_ids:\n","\n","            build_tests = (\n","                model_eval_by_build[\n","                    build_id\n","                ]\n","                .copy()\n","            )\n","\n","\n","            latest_scores = []\n","            qtf_average_scores = []\n","\n","\n","            for test_value in (\n","                build_tests[\n","                    \"Test\"\n","                ]\n","            ):\n","\n","                test_key = str(\n","                    test_value\n","                )\n","\n","\n","                latest_scores.append(\n","                    float(\n","                        latest_failure_order.get(\n","                            test_key,\n","                            -1,\n","                        )\n","                    )\n","                )\n","\n","\n","                historical_count = (\n","                    duration_count.get(\n","                        test_key,\n","                        0,\n","                    )\n","                )\n","\n","\n","                if historical_count \u003e 0:\n","\n","                    average_duration = (\n","                        duration_sum[\n","                            test_key\n","                        ]\n","                        / historical_count\n","                    )\n","\n","                else:\n","\n","                    average_duration = (\n","                        np.inf\n","                    )\n","\n","\n","                qtf_average_scores.append(\n","                    float(\n","                        average_duration\n","                    )\n","                )\n","\n","\n","            latest_fail_rankings.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","                    scores=latest_scores,\n","                    technique=\"LatestFail\",\n","                    score_direction=\"descending\",\n","                )\n","            )\n","\n","\n","            qtf_rankings.append(\n","                rank_build_rows(\n","                    build_rows=build_tests,\n","                    scores=qtf_average_scores,\n","                    technique=\"QTF-Avg\",\n","                    score_direction=\"ascending\",\n","                )\n","            )\n","\n","\n","        # Update histories after ranking.\n","        current_raw_rows = (\n","            raw_eval_by_build.get(\n","                build_id\n","            )\n","        )\n","\n","\n","        if current_raw_rows is None:\n","            continue\n","\n","\n","        update_sort_columns = []\n","\n","        if \"job\" in (\n","            current_raw_rows.columns\n","        ):\n","            update_sort_columns.append(\n","                \"job\"\n","            )\n","\n","        update_sort_columns.append(\n","            \"test\"\n","        )\n","\n","\n","        current_raw_rows = (\n","            current_raw_rows\n","            .sort_values(\n","                update_sort_columns,\n","                kind=\"mergesort\",\n","            )\n","        )\n","\n","\n","        for execution_row in (\n","            current_raw_rows\n","            .itertuples(\n","                index=False\n","            )\n","        ):\n","\n","            test_key = str(\n","                execution_row.test\n","            )\n","\n","\n","            if int(\n","                execution_row.verdict\n","            ) != 0:\n","\n","                latest_failure_order[\n","                    test_key\n","                ] = int(\n","                    execution_row.build_order\n","                )\n","\n","\n","            duration = float(\n","                execution_row.duration\n","            )\n","\n","\n","            if np.isfinite(\n","                duration\n","            ):\n","\n","                duration_sum[\n","                    test_key\n","                ] = (\n","                    duration_sum.get(\n","                        test_key,\n","                        0.0,\n","                    )\n","                    + duration\n","                )\n","\n","\n","                duration_count[\n","                    test_key\n","                ] = (\n","                    duration_count.get(\n","                        test_key,\n","                        0,\n","                    )\n","                    + 1\n","                )\n","\n","\n","    if len(\n","        latest_fail_rankings\n","    ) != clean_evaluation_data[\n","        \"Build\"\n","    ].nunique():\n","        raise AssertionError(\n","            \"LatestFail did not rank every scored build.\"\n","        )\n","\n","\n","    if len(\n","        qtf_rankings\n","    ) != clean_evaluation_data[\n","        \"Build\"\n","    ].nunique():\n","        raise AssertionError(\n","            \"QTF-Avg did not rank every scored build.\"\n","        )\n","\n","\n","    return (\n","        pd.concat(\n","            latest_fail_rankings,\n","            ignore_index=True,\n","        ),\n","\n","        pd.concat(\n","            qtf_rankings,\n","            ignore_index=True,\n","        ),\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 12. Calculate build-level APFD and APFDc\n","# ---------------------------------------------------------\n","\n","def calculate_build_metrics(\n","    all_rankings,\n","    noise_percent,\n","    repetition_seed,\n","):\n","    \"\"\"\n","    Calculate APFD and APFDc independently for each\n","    technique and clean evaluation build.\n","    \"\"\"\n","\n","    metric_records = []\n","\n","\n","    grouped_rankings = (\n","        all_rankings\n","        .groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ],\n","            sort=False,\n","        )\n","    )\n","\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in (\n","        grouped_rankings\n","    ):\n","\n","        ranked_build = (\n","            ranked_build\n","            .sort_values(\n","                \"Rank\",\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        actual_failures = (\n","            ranked_build[\n","                \"ActualFailure\"\n","            ]\n","            .to_numpy(\n","                dtype=int\n","            )\n","        )\n","\n","\n","        durations = (\n","            ranked_build[\n","                \"Duration\"\n","            ]\n","            .to_numpy(\n","                dtype=float\n","            )\n","        )\n","\n","\n","        number_of_tests = len(\n","            ranked_build\n","        )\n","\n","        number_of_failures = int(\n","            actual_failures.sum()\n","        )\n","\n","\n","        apfd = calculate_apfd(\n","            actual_failures\n","        )\n","\n","        apfdc = calculate_apfdc(\n","            actual_failures,\n","            durations,\n","        )\n","\n","\n","        metric_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"NoisePercent\":\n","                float(\n","                    noise_percent\n","                ),\n","\n","            \"RepetitionSeed\":\n","                int(\n","                    repetition_seed\n","                ),\n","\n","            \"Technique\":\n","                technique,\n","\n","            \"Build\":\n","                int(\n","                    build_id\n","                ),\n","\n","            \"BuildOrder\":\n","                int(\n","                    ranked_build[\n","                        \"build_order\"\n","                    ].iloc[0]\n","                ),\n","\n","            \"NumberOfTests\":\n","                number_of_tests,\n","\n","            \"NumberOfFailures\":\n","                number_of_failures,\n","\n","            \"APFD\":\n","                apfd,\n","\n","            \"APFDc\":\n","                apfdc,\n","        })\n","\n","\n","    return pd.DataFrame(\n","        metric_records\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 13. Validate one complete condition\n","# ---------------------------------------------------------\n","\n","def validate_condition_outputs(\n","    rankings,\n","    build_metrics,\n","):\n","    \"\"\"\n","    Apply strict structural, metric and ranking checks.\n","    \"\"\"\n","\n","    expected_techniques = set(\n","        ML_TECHNIQUES\n","        + BASELINE_TECHNIQUES\n","    )\n","\n","\n","    actual_techniques = set(\n","        rankings[\n","            \"Technique\"\n","        ].unique()\n","    )\n","\n","\n","    if actual_techniques != (\n","        expected_techniques\n","    ):\n","        raise AssertionError(\n","            \"Technique mismatch.\\n\"\n","            f\"Expected: {expected_techniques}\\n\"\n","            f\"Observed: {actual_techniques}\"\n","        )\n","\n","\n","    expected_builds = set(\n","        clean_evaluation_data[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","\n","    ranking_builds = set(\n","        rankings[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","\n","    metric_builds = set(\n","        build_metrics[\n","            \"Build\"\n","        ].astype(int)\n","    )\n","\n","\n","    if ranking_builds != expected_builds:\n","        raise AssertionError(\n","            \"Not all clean evaluation builds received \"\n","            \"rankings.\"\n","        )\n","\n","\n","    if metric_builds != expected_builds:\n","        raise AssertionError(\n","            \"Not all clean evaluation builds received \"\n","            \"metrics.\"\n","        )\n","\n","\n","    expected_ranking_rows = (\n","        len(clean_evaluation_data)\n","        * len(expected_techniques)\n","    )\n","\n","\n","    expected_metric_rows = (\n","        len(expected_builds)\n","        * len(expected_techniques)\n","    )\n","\n","\n","    if len(rankings) != (\n","        expected_ranking_rows\n","    ):\n","        raise AssertionError(\n","            \"Unexpected number of ranking rows: \"\n","            f\"{len(rankings)} instead of \"\n","            f\"{expected_ranking_rows}.\"\n","        )\n","\n","\n","    if len(build_metrics) != (\n","        expected_metric_rows\n","    ):\n","        raise AssertionError(\n","            \"Unexpected number of build-metric rows: \"\n","            f\"{len(build_metrics)} instead of \"\n","            f\"{expected_metric_rows}.\"\n","        )\n","\n","\n","    if build_metrics[\n","        [\n","            \"APFD\",\n","            \"APFDc\",\n","        ]\n","    ].isna().any().any():\n","        raise AssertionError(\n","            \"APFD or APFDc contains missing values.\"\n","        )\n","\n","\n","    for metric_column in [\n","        \"APFD\",\n","        \"APFDc\",\n","    ]:\n","\n","        if not build_metrics[\n","            metric_column\n","        ].between(\n","            0.0,\n","            1.0,\n","            inclusive=\"both\",\n","        ).all():\n","\n","            raise AssertionError(\n","                f\"{metric_column} contains values \"\n","                \"outside [0, 1].\"\n","            )\n","\n","\n","    if rankings.duplicated(\n","        [\n","            \"Technique\",\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ).any():\n","        raise AssertionError(\n","            \"Duplicate technique/build/test rankings \"\n","            \"were produced.\"\n","        )\n","\n","\n","    if build_metrics.duplicated(\n","        [\n","            \"Technique\",\n","            \"Build\",\n","        ]\n","    ).any():\n","        raise AssertionError(\n","            \"Duplicate technique/build metrics \"\n","            \"were produced.\"\n","        )\n","\n","\n","    rows_per_technique = (\n","        rankings\n","        .groupby(\n","            \"Technique\"\n","        )\n","        .size()\n","    )\n","\n","\n","    if not (\n","        rows_per_technique\n","        == len(\n","            clean_evaluation_data\n","        )\n","    ).all():\n","        raise AssertionError(\n","            \"At least one technique did not rank all \"\n","            \"evaluation rows.\"\n","        )\n","\n","\n","    builds_per_technique = (\n","        build_metrics\n","        .groupby(\n","            \"Technique\"\n","        )[\n","            \"Build\"\n","        ]\n","        .nunique()\n","    )\n","\n","\n","    if not (\n","        builds_per_technique\n","        == len(\n","            expected_builds\n","        )\n","    ).all():\n","        raise AssertionError(\n","            \"At least one technique is missing \"\n","            \"evaluation-build metrics.\"\n","        )\n","\n","\n","    for (\n","        technique,\n","        build_id,\n","    ), ranked_build in (\n","        rankings\n","        .groupby(\n","            [\n","                \"Technique\",\n","                \"Build\",\n","            ]\n","        )\n","    ):\n","\n","        ranked_build = (\n","            ranked_build\n","            .sort_values(\n","                \"Rank\",\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        expected_ranks = np.arange(\n","            1,\n","            len(ranked_build) + 1,\n","        )\n","\n","\n","        if not np.array_equal(\n","            ranked_build[\n","                \"Rank\"\n","            ].to_numpy(),\n","            expected_ranks,\n","        ):\n","            raise AssertionError(\n","                \"Invalid ranking sequence for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","\n","        score_ascending = (\n","            technique == \"QTF-Avg\"\n","        )\n","\n","\n","        expected_order = (\n","            ranked_build\n","            .sort_values(\n","                [\n","                    \"Score\",\n","                    \"Test\",\n","                ],\n","                ascending=[\n","                    score_ascending,\n","                    True,\n","                ],\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        if not np.array_equal(\n","            ranked_build[\n","                \"Test\"\n","            ].to_numpy(),\n","            expected_order[\n","                \"Test\"\n","            ].to_numpy(),\n","        ):\n","            raise AssertionError(\n","                \"Score/Test tie rule was violated for \"\n","                f\"{technique}, build {build_id}.\"\n","            )\n","\n","\n","    return True\n","\n","\n","# ---------------------------------------------------------\n","# 14. Run one complete project×noise×seed condition\n","# ---------------------------------------------------------\n","\n","def run_unified_condition(\n","    noise_percent,\n","    repetition_seed,\n","    save_rankings=True,\n","    overwrite=False,\n","):\n","    \"\"\"\n","    Run one complete Paho project×noise×seed condition.\n","\n","    The same corrupted training history is shared by all\n","    four supervised models and LatestFail.\n","    \"\"\"\n","\n","    noise_percent = int(\n","        noise_percent\n","    )\n","\n","    repetition_seed = int(\n","        repetition_seed\n","    )\n","\n","\n","    if noise_percent not in (\n","        NOISE_LEVELS\n","    ):\n","        raise ValueError(\n","            \"noise_percent is not part of the frozen \"\n","            \"experiment protocol.\"\n","        )\n","\n","\n","    if repetition_seed not in (\n","        REPETITION_SEEDS\n","    ):\n","        raise ValueError(\n","            \"repetition_seed must be between 1 and 30.\"\n","        )\n","\n","\n","    condition_start_time = (\n","        time.time()\n","    )\n","\n","\n","    condition_directory = (\n","        PROJECT_RAW_RESULTS\n","        / f\"noise_{noise_percent:03d}\"\n","        / f\"seed_{repetition_seed:02d}\"\n","    )\n","\n","\n","    condition_directory.mkdir(\n","        parents=True,\n","        exist_ok=True,\n","    )\n","\n","\n","    completion_marker = (\n","        condition_directory\n","        / \"_SUCCESS.json\"\n","    )\n","\n","\n","    if (\n","        completion_marker.exists()\n","        and not overwrite\n","    ):\n","        raise FileExistsError(\n","            \"This condition already has a success \"\n","            \"marker:\\n\"\n","            f\"{completion_marker}\\n\"\n","            \"Use overwrite=True only for an intentional \"\n","            \"and documented rerun.\"\n","        )\n","\n","\n","    evaluation_hash_before = int(\n","        pd.util.hash_pandas_object(\n","            clean_evaluation_data[\n","                [\n","                    \"Build\",\n","                    \"Test\",\n","                    \"Verdict\",\n","                    \"Duration\",\n","                    *REC_FEATURE_COLUMNS,\n","                ]\n","            ],\n","            index=True,\n","        ).sum()\n","    )\n","\n","\n","    # One shared corrupted raw training history.\n","    (\n","        noisy_training_history,\n","        noise_manifest,\n","        noise_summary,\n","    ) = inject_training_verdict_noise(\n","        execution_history=(\n","            clean_training_history\n","        ),\n","        noise_percent=(\n","            noise_percent\n","        ),\n","        repetition_seed=(\n","            repetition_seed\n","        ),\n","    )\n","\n","\n","    # One shared reconstructed model-ready dataset.\n","    noisy_training_data = (\n","        create_noisy_model_training_data(\n","            clean_model_training_data=(\n","                clean_training_data\n","            ),\n","            noisy_execution_history=(\n","                noisy_training_history\n","            ),\n","        )\n","    )\n","\n","\n","    (\n","        X_train,\n","        y_train,\n","        X_evaluation,\n","        training_medians,\n","    ) = prepare_ml_matrices(\n","        noisy_training_data=(\n","            noisy_training_data\n","        ),\n","        evaluation_data=(\n","            clean_evaluation_data\n","        ),\n","    )\n","\n","\n","    all_ranking_frames = []\n","    fit_records = []\n","\n","\n","    models = create_ml_models(\n","        repetition_seed\n","    )\n","\n","\n","    # Four supervised ML methods.\n","    for technique, model in (\n","        models.items()\n","    ):\n","\n","        model_start_time = (\n","            time.time()\n","        )\n","\n","\n","        with warnings.catch_warnings():\n","\n","            warnings.simplefilter(\n","                \"ignore\"\n","            )\n","\n","            model.fit(\n","                X_train,\n","                y_train,\n","            )\n","\n","\n","        failure_probabilities = (\n","            get_failure_probability(\n","                fitted_model=model,\n","                feature_matrix=(\n","                    X_evaluation\n","                ),\n","            )\n","        )\n","\n","\n","        model_rankings = (\n","            create_ml_rankings(\n","                evaluation_data=(\n","                    clean_evaluation_data\n","                ),\n","                technique=(\n","                    technique\n","                ),\n","                failure_probabilities=(\n","                    failure_probabilities\n","                ),\n","            )\n","        )\n","\n","\n","        all_ranking_frames.append(\n","            model_rankings\n","        )\n","\n","\n","        fit_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"NoisePercent\":\n","                float(\n","                    noise_percent\n","                ),\n","\n","            \"RepetitionSeed\":\n","                repetition_seed,\n","\n","            \"Technique\":\n","                technique,\n","\n","            \"FitSeconds\":\n","                float(\n","                    time.time()\n","                    - model_start_time\n","                ),\n","\n","            \"TrainingRows\":\n","                int(\n","                    len(X_train)\n","                ),\n","\n","            \"TrainingFailures\":\n","                int(\n","                    y_train.sum()\n","                ),\n","\n","            \"TrainingPasses\":\n","                int(\n","                    len(y_train)\n","                    - y_train.sum()\n","                ),\n","\n","            \"ActiveFeatures\":\n","                int(\n","                    len(\n","                        ACTIVE_FEATURE_COLUMNS\n","                    )\n","                ),\n","        })\n","\n","\n","    # Random baseline.\n","    random_rankings = (\n","        create_random_rankings(\n","            evaluation_data=(\n","                clean_evaluation_data\n","            ),\n","            repetition_seed=(\n","                repetition_seed\n","            ),\n","        )\n","    )\n","\n","\n","    all_ranking_frames.append(\n","        random_rankings\n","    )\n","\n","\n","    # LatestFail and QTF-Avg baselines.\n","    (\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ) = create_history_baseline_rankings(\n","        noisy_training_history=(\n","            noisy_training_history\n","        )\n","    )\n","\n","\n","    all_ranking_frames.extend([\n","        latest_fail_rankings,\n","        qtf_rankings,\n","    ])\n","\n","\n","    all_rankings = pd.concat(\n","        all_ranking_frames,\n","        ignore_index=True,\n","    )\n","\n","\n","    all_rankings.insert(\n","        0,\n","        \"Project\",\n","        PROJECT_NAME,\n","    )\n","\n","    all_rankings.insert(\n","        1,\n","        \"NoisePercent\",\n","        float(\n","            noise_percent\n","        ),\n","    )\n","\n","    all_rankings.insert(\n","        2,\n","        \"RepetitionSeed\",\n","        repetition_seed,\n","    )\n","\n","\n","    build_metrics = (\n","        calculate_build_metrics(\n","            all_rankings=(\n","                all_rankings\n","            ),\n","            noise_percent=(\n","                noise_percent\n","            ),\n","            repetition_seed=(\n","                repetition_seed\n","            ),\n","        )\n","    )\n","\n","\n","    validate_condition_outputs(\n","        rankings=(\n","            all_rankings\n","        ),\n","        build_metrics=(\n","            build_metrics\n","        ),\n","    )\n","\n","\n","    project_run_metrics = (\n","        build_metrics\n","        .groupby(\n","            [\n","                \"Project\",\n","                \"NoisePercent\",\n","                \"RepetitionSeed\",\n","                \"Technique\",\n","            ],\n","            as_index=False,\n","        )\n