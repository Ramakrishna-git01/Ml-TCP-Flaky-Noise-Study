     5             0        1   \n","176  2757  570817138  570817139            8             0        1   \n","184  2960  570817138  570817139            8             1        0   \n","194   510  571173535  571173536            9             0        1   \n","216  2956  571173535  571173536            9             0        1   \n","228   506  571734323  571734324           10             0        1   \n","239  2720  571734323  571734324           10             0        1   \n","251  2955  571734323  571734324           10             1        0   \n","256  2960  571734323  571734324           10             1        0   \n","263  4821  571734323  571734324           10             0        1   \n","284  2757  571734935  571734936           11             0        1   \n","291  2959  571734935  571734936           11             1        0   \n","323  2955  571827697  571827701           12             1        0   \n","327  2959  571827697  571827701           12             1        0   \n","359  2955  571829234  571829235           13             0        1   \n","413  2953  572118894  572118895           15             1        0   \n","\n","     RandomUniform  WasFlipped  FlipDirection  \n","9         0.027559        True  PassToFailure  \n","36        0.039593        True  PassToFailure  \n","61        0.007092        True  PassToFailure  \n","75        0.024491        True  FailureToPass  \n","93        0.005825        True  PassToFailure  \n","176       0.016723        True  PassToFailure  \n","184       0.016827        True  FailureToPass  \n","194       0.026485        True  PassToFailure  \n","216       0.033892        True  PassToFailure  \n","228       0.045987        True  PassToFailure  \n","239       0.022618        True  PassToFailure  \n","251       0.034046        True  FailureToPass  \n","256       0.019834        True  FailureToPass  \n","263       0.021464        True  PassToFailure  \n","284       0.032081        True  PassToFailure  \n","291       0.023889        True  FailureToPass  \n","323       0.002747        True  FailureToPass  \n","327       0.046533        True  FailureToPass  \n","359       0.036960        True  PassToFailure  \n","413       0.038541        True  FailureToPass  "]},"metadata":{},"output_type":"display_data"}],"source":["# ---------------------------------------------------------\n","# VALIDATE 5% TRAINING NOISE — SEED 1\n","# ---------------------------------------------------------\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","NOISE_PROBABILITY = 0.05\n","VALIDATION_SEED = 1\n","\n","\n","# ---------------------------------------------------------\n","# REUSABLE VERDICT-NOISE FUNCTION\n","# ---------------------------------------------------------\n","\n","def inject_training_verdict_noise(\n","    clean_execution_history,\n","    training_ids,\n","    noise_probability,\n","    seed,\n","):\n","    \"\"\"\n","    Independently flip each training execution verdict\n","    with probability p.\n","\n","    Binary flipping:\n","        pass (0)          -\u003e failure subtype (1/2/3)\n","        failure (1/2/3) -\u003e pass (0)\n","\n","    Synthetic failure subtypes are sampled according to\n","    their observed clean-training proportions.\n","\n","    Evaluation verdicts are never changed.\n","    \"\"\"\n","\n","    if not 0 \u003c= noise_probability \u003c= 1:\n","        raise ValueError(\n","            \"noise_probability must be between 0 and 1.\"\n","        )\n","\n","    noisy_history = (\n","        clean_execution_history\n","        .copy()\n","        .sort_values(\n","            [\"build_order\", \"job\", \"test\"]\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    noisy_history[\"CleanVerdict\"] = (\n","        noisy_history[\"verdict\"].astype(int)\n","    )\n","\n","    training_mask = (\n","        noisy_history[\"build\"].isin(training_ids)\n","    )\n","\n","    training_positions = np.flatnonzero(\n","        training_mask.to_numpy()\n","    )\n","\n","    clean_training_verdicts = (\n","        noisy_history.loc[\n","            training_mask,\n","            \"CleanVerdict\"\n","        ]\n","        .to_numpy(dtype=int)\n","    )\n","\n","    # Learn the clean failure-subtype distribution.\n","    clean_failure_verdicts = (\n","        clean_training_verdicts[\n","            clean_training_verdicts != 0\n","        ]\n","    )\n","\n","    failure_type_counts = (\n","        pd.Series(clean_failure_verdicts)\n","        .value_counts()\n","        .sort_index()\n","    )\n","\n","    if failure_type_counts.empty:\n","        raise ValueError(\n","            \"No clean training failures are available.\"\n","        )\n","\n","    failure_types = (\n","        failure_type_counts.index\n","        .to_numpy(dtype=int)\n","    )\n","\n","    failure_type_probabilities = (\n","        failure_type_counts\n","        / failure_type_counts.sum()\n","    ).to_numpy(dtype=float)\n","\n","    rng = np.random.default_rng(seed)\n","\n","    # Using the same seed and row ordering at every noise\n","    # level creates nested masks: the 5% flips are contained\n","    # within the 10% flips for the corresponding seed.\n","    random_uniforms = rng.random(\n","        len(training_positions)\n","    )\n","\n","    flip_mask = (\n","        random_uniforms\n","        \u003c noise_probability\n","    )\n","\n","    # Generate a potential synthetic failure subtype for\n","    # every training row. This keeps subtype assignments\n","    # reproducible across noise levels.\n","    candidate_failure_types = rng.choice(\n","        failure_types,\n","        size=len(training_positions),\n","        replace=True,\n","        p=failure_type_probabilities,\n","    )\n","\n","    noisy_training_verdicts = (\n","        clean_training_verdicts.copy()\n","    )\n","\n","    pass_to_failure_mask = (\n","        flip_mask\n","        \u0026 (clean_training_verdicts == 0)\n","    )\n","\n","    failure_to_pass_mask = (\n","        flip_mask\n","        \u0026 (clean_training_verdicts != 0)\n","    )\n","\n","    noisy_training_verdicts[\n","        pass_to_failure_mask\n","    ] = candidate_failure_types[\n","        pass_to_failure_mask\n","    ]\n","\n","    noisy_training_verdicts[\n","        failure_to_pass_mask\n","    ] = 0\n","\n","    noisy_history.loc[\n","        training_mask,\n","        \"verdict\"\n","    ] = noisy_training_verdicts\n","\n","    noisy_history[\"verdict\"] = (\n","        noisy_history[\"verdict\"].astype(int)\n","    )\n","\n","    noise_audit = (\n","        noisy_history.loc[\n","            training_mask,\n","            [\n","                \"test\",\n","                \"build\",\n","                \"job\",\n","                \"build_order\",\n","                \"CleanVerdict\",\n","                \"verdict\",\n","            ]\n","        ]\n","        .reset_index(drop=True)\n","        .copy()\n","    )\n","\n","    noise_audit[\"RandomUniform\"] = (\n","        random_uniforms\n","    )\n","\n","    noise_audit[\"WasFlipped\"] = (\n","        flip_mask\n","    )\n","\n","    noise_audit[\"FlipDirection\"] = (\n","        np.select(\n","            [\n","                pass_to_failure_mask,\n","                failure_to_pass_mask,\n","            ],\n","            [\n","                \"PassToFailure\",\n","                \"FailureToPass\",\n","            ],\n","            default=\"NotFlipped\",\n","        )\n","    )\n","\n","    return (\n","        noisy_history,\n","        noise_audit,\n","        failure_type_counts,\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# INJECT 5% NOISE INTO SEED 1\n","# ---------------------------------------------------------\n","\n","(\n","    noisy_exe_5_seed1,\n","    noise_audit_5_seed1,\n","    failure_type_counts,\n",") = inject_training_verdict_noise(\n","    clean_execution_history=exe_for_rec,\n","    training_ids=training_build_ids,\n","    noise_probability=NOISE_PROBABILITY,\n","    seed=VALIDATION_SEED,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# RECONSTRUCT ALL REC_* FEATURES\n","# ---------------------------------------------------------\n","\n","reconstructed_rec_5_seed1 = (\n","    reconstruct_rec_features(\n","        execution_history=noisy_exe_5_seed1,\n","        requested_rows=clean_training_data[\n","            [\"Build\", \"Test\"]\n","        ],\n","        recent_window=RECENT_WINDOW,\n","    )\n",")\n","\n","if len(reconstructed_rec_5_seed1) != len(\n","    clean_training_data\n","):\n","    raise ValueError(\n","        \"Incorrect number of reconstructed rows.\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# BUILD THE NOISY MODEL-READY TRAINING DATASET\n","# ---------------------------------------------------------\n","\n","noisy_training_data_5_seed1 = (\n","    clean_training_data.copy()\n",")\n","\n","# Obtain noisy current labels for the fixed Build-Test rows.\n","noisy_label_lookup = (\n","    noisy_exe_5_seed1[\n","        noisy_exe_5_seed1[\"build\"].isin(\n","            training_build_ids\n","        )\n","    ][\n","        [\"build\", \"test\", \"verdict\"]\n","    ]\n","    .rename(\n","        columns={\n","            \"build\": \"Build\",\n","            \"test\": \"Test\",\n","            \"verdict\": \"NoisyVerdict\",\n","        }\n","    )\n",")\n","\n","if noisy_label_lookup.duplicated(\n","    [\"Build\", \"Test\"]\n",").any():\n","    raise ValueError(\n","        \"Duplicate Build-Test labels were found.\"\n","    )\n","\n","noisy_training_data_5_seed1 = (\n","    noisy_training_data_5_seed1\n","    .merge(\n","        noisy_label_lookup,\n","        on=[\"Build\", \"Test\"],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","if noisy_training_data_5_seed1[\n","    \"NoisyVerdict\"\n","].isna().any():\n","    raise ValueError(\n","        \"Some training rows lack noisy verdicts.\"\n","    )\n","\n","noisy_training_data_5_seed1[\"Verdict\"] = (\n","    noisy_training_data_5_seed1[\n","        \"NoisyVerdict\"\n","    ].astype(int)\n",")\n","\n","noisy_training_data_5_seed1 = (\n","    noisy_training_data_5_seed1\n","    .drop(columns=[\"NoisyVerdict\"])\n",")\n","\n","\n","# Replace all original REC_* values.\n","noisy_training_data_5_seed1 = (\n","    noisy_training_data_5_seed1\n","    .drop(columns=REC_FEATURE_COLUMNS)\n","    .merge(\n","        reconstructed_rec_5_seed1,\n","        on=[\"Build\", \"Test\"],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","    )\n",")\n","\n","# Restore original column order plus build_order.\n","ordered_columns = (\n","    list(dataset.columns)\n","    + [\"build_order\"]\n",")\n","\n","noisy_training_data_5_seed1 = (\n","    noisy_training_data_5_seed1[\n","        ordered_columns\n","    ]\n","    .sort_values([\"build_order\", \"Test\"])\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION 1: NOISE COUNTS\n","# ---------------------------------------------------------\n","\n","number_training_executions = len(\n","    noise_audit_5_seed1\n",")\n","\n","number_flipped = int(\n","    noise_audit_5_seed1[\n","        \"WasFlipped\"\n","    ].sum()\n",")\n","\n","realised_noise_percentage = (\n","    number_flipped\n","    / number_training_executions\n","    * 100\n",")\n","\n","pass_to_failure_count = int(\n","    (\n","        noise_audit_5_seed1[\n","            \"FlipDirection\"\n","        ] == \"PassToFailure\"\n","    ).sum()\n",")\n","\n","failure_to_pass_count = int(\n","    (\n","        noise_audit_5_seed1[\n","            \"FlipDirection\"\n","        ] == \"FailureToPass\"\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION 2: MODEL-READY LABEL CHANGES\n","# ---------------------------------------------------------\n","\n","clean_training_labels = (\n","    clean_training_data[\n","        [\"Build\", \"Test\", \"Verdict\"]\n","    ]\n","    .sort_values([\"Build\", \"Test\"])\n","    .reset_index(drop=True)\n",")\n","\n","noisy_training_labels = (\n","    noisy_training_data_5_seed1[\n","        [\"Build\", \"Test\", \"Verdict\"]\n","    ]\n","    .sort_values([\"Build\", \"Test\"])\n","    .reset_index(drop=True)\n",")\n","\n","model_row_label_changes = int(\n","    (\n","        clean_training_labels[\"Verdict\"]\n","        != noisy_training_labels[\"Verdict\"]\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION 3: REC FEATURE CHANGES\n","# ---------------------------------------------------------\n","\n","rec_change_records = []\n","\n","for feature in REC_FEATURE_COLUMNS:\n","\n","    clean_values = (\n","        clean_training_data[\n","            [\"Build\", \"Test\", feature]\n","        ]\n","        .sort_values([\"Build\", \"Test\"])[feature]\n","        .to_numpy(dtype=float)\n","    )\n","\n","    noisy_values = (\n","        noisy_training_data_5_seed1[\n","            [\"Build\", \"Test\", feature]\n","        ]\n","        .sort_values([\"Build\", \"Test\"])[feature]\n","        .to_numpy(dtype=float)\n","    )\n","\n","    changed = ~np.isclose(\n","        clean_values,\n","        noisy_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","    rec_change_records.append({\n","        \"Feature\": feature,\n","        \"ChangedRows\": int(changed.sum()),\n","        \"UnchangedRows\": int((~changed).sum()),\n","    })\n","\n","rec_feature_change_summary = pd.DataFrame(\n","    rec_change_records\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION 4: NON-REC FEATURES REMAIN UNCHANGED\n","# ---------------------------------------------------------\n","\n","unchanged_columns = [\n","    column\n","    for column in dataset.columns\n","    if (\n","        column not in REC_FEATURE_COLUMNS\n","        and column != \"Verdict\"\n","    )\n","]\n","\n","clean_non_rec = (\n","    clean_training_data\n","    .sort_values([\"Build\", \"Test\"])\n","    [unchanged_columns]\n","    .reset_index(drop=True)\n",")\n","\n","noisy_non_rec = (\n","    noisy_training_data_5_seed1\n","    .sort_values([\"Build\", \"Test\"])\n","    [unchanged_columns]\n","    .reset_index(drop=True)\n",")\n","\n","non_rec_features_unchanged = (\n","    clean_non_rec.equals(noisy_non_rec)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION 5: EVALUATION REMAINS CLEAN\n","# ---------------------------------------------------------\n","\n","clean_evaluation_history = (\n","    exe_for_rec[\n","        exe_for_rec[\"build\"].isin(\n","            evaluation_build_ids\n","        )\n","    ][\n","        [\"build\", \"test\", \"job\", \"verdict\", \"duration\"]\n","    ]\n","    .sort_values([\"build\", \"job\", \"test\"])\n","    .reset_index(drop=True)\n",")\n","\n","noisy_copy_evaluation_history = (\n","    noisy_exe_5_seed1[\n","        noisy_exe_5_seed1[\"build\"].isin(\n","            evaluation_build_ids\n","        )\n","    ][\n","        [\"build\", \"test\", \"job\", \"verdict\", \"duration\"]\n","    ]\n","    .sort_values([\"build\", \"job\", \"test\"])\n","    .reset_index(drop=True)\n",")\n","\n","evaluation_completely_unchanged = (\n","    clean_evaluation_history.equals(\n","        noisy_copy_evaluation_history\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION 6: REPRODUCIBILITY\n","# ---------------------------------------------------------\n","\n","(\n","    repeated_noisy_exe,\n","    repeated_noise_audit,\n","    _,\n",") = inject_training_verdict_noise(\n","    clean_execution_history=exe_for_rec,\n","    training_ids=training_build_ids,\n","    noise_probability=NOISE_PROBABILITY,\n","    seed=VALIDATION_SEED,\n",")\n","\n","same_seed_reproduces_verdicts = (\n","    noisy_exe_5_seed1[\"verdict\"]\n","    .equals(\n","        repeated_noisy_exe[\"verdict\"]\n","    )\n",")\n","\n","same_seed_reproduces_mask = (\n","    noise_audit_5_seed1[\n","        \"WasFlipped\"\n","    ]\n","    .equals(\n","        repeated_noise_audit[\n","            \"WasFlipped\"\n","        ]\n","    )\n",")\n","\n","\n","# ---------------------------------------------------------\n","# VALIDATION 7: BUILD FAILURE-STATUS CHANGES\n","# ---------------------------------------------------------\n","\n","clean_training_build_status = (\n","    noise_audit_5_seed1\n","    .assign(\n","        CleanFailure=lambda frame:\n","        frame[\"CleanVerdict\"] != 0\n","    )\n","    .groupby(\"build\")[\"CleanFailure\"]\n","    .any()\n",")\n","\n","noisy_training_build_status = (\n","    noise_audit_5_seed1\n","    .assign(\n","        NoisyFailure=lambda frame:\n","        frame[\"verdict\"] != 0\n","    )\n","    .groupby(\"build\")[\"NoisyFailure\"]\n","    .any()\n",")\n","\n","passing_to_failed_builds = int(\n","    (\n","        (~clean_training_build_status)\n","        \u0026 noisy_training_build_status\n","    ).sum()\n",")\n","\n","failed_to_passing_builds = int(\n","    (\n","        clean_training_build_status\n","        \u0026 (~noisy_training_build_status)\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# DISPLAY THE VALIDATION RESULT\n","# ---------------------------------------------------------\n","\n","print(\"=== 5% NOISE VALIDATION — SEED 1 ===\")\n","\n","print(\"\\nNoise population:\")\n","print(\n","    \"Training execution rows:\",\n","    number_training_executions\n",")\n","print(\n","    \"Expected number of flips:\",\n","    number_training_executions\n","    * NOISE_PROBABILITY\n",")\n","print(\"Actual number of flips:\", number_flipped)\n","print(\n","    \"Realised noise percentage:\",\n","    round(realised_noise_percentage, 4),\n","    \"%\"\n",")\n","\n","print(\"\\nFlip directions:\")\n","print(\n","    \"Pass → failure:\",\n","    pass_to_failure_count\n",")\n","print(\n","    \"Failure → pass:\",\n","    failure_to_pass_count\n",")\n","\n","print(\"\\nClean failure-subtype distribution:\")\n","print(failure_type_counts)\n","\n","print(\"\\nModel-ready training data:\")\n","print(\n","    \"Rows:\",\n","    len(noisy_training_data_5_seed1)\n",")\n","print(\n","    \"Builds:\",\n","    noisy_training_data_5_seed1[\n","        \"Build\"\n","    ].nunique()\n",")\n","print(\n","    \"Model-row labels changed:\",\n","    model_row_label_changes\n",")\n","\n","print(\"\\nNoisy binary target distribution:\")\n","print(\n","    (\n","        noisy_training_data_5_seed1[\n","            \"Verdict\"\n","        ] != 0\n","    )\n","    .astype(int)\n","    .value_counts()\n","    .sort_index()\n","    .rename(\n","        index={\n","            0: \"Pass\",\n","            1: \"Non-passing\",\n","        }\n","    )\n",")\n","\n","print(\"\\nFeature checks:\")\n","print(\n","    \"Non-REC columns unchanged:\",\n","    non_rec_features_unchanged\n",")\n","print(\n","    \"Evaluation data unchanged:\",\n","    evaluation_completely_unchanged\n",")\n","print(\n","    \"Same seed reproduces verdicts:\",\n","    same_seed_reproduces_verdicts\n",")\n","print(\n","    \"Same seed reproduces flip mask:\",\n","    same_seed_reproduces_mask\n",")\n","\n","print(\"\\nBuild-status effects in raw history:\")\n","print(\n","    \"Passing-only builds becoming failed:\",\n","    passing_to_failed_builds\n",")\n","print(\n","    \"Failed builds becoming passing-only:\",\n","    failed_to_passing_builds\n",")\n","\n","print(\"\\nREC_* feature changes:\")\n","display(\n","    rec_feature_change_summary\n","    .sort_values(\n","        \"ChangedRows\",\n","        ascending=False\n","    )\n","    .reset_index(drop=True)\n",")\n","\n",