ut_type":"stream","text":["\n","Final directory:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/eclipse__paho.mqtt.java/paho_30_seed_final\n","Audit elapsed minutes: 1.502\n","\n","SUCCESS: Paho MQTT completed the full 30-seed experiment and passed every final audit.\n"]}],"source":["# =========================================================\n","# PROJECT 4: PAHO MQTT\n","# FINAL 30-SEED AUDIT AND AGGREGATION\n","# =========================================================\n","\n","from pathlib import Path\n","from IPython.display import display\n","\n","import hashlib\n","import json\n","import time\n","\n","import numpy as np\n","import pandas as pd\n","\n","\n","# ---------------------------------------------------------\n","# 1. Final configuration\n","# ---------------------------------------------------------\n","\n","FINAL_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"paho_30_seed_final\"\n",")\n","\n","FINAL_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","EXPECTED_CONDITIONS = 270\n","EXPECTED_SEEDS = 30\n","EXPECTED_NOISE_LEVELS = 9\n","EXPECTED_TECHNIQUES = 7\n","\n","EXPECTED_TRAINING_EXECUTION_ROWS = 9422\n","EXPECTED_EVALUATION_ROWS = 980\n","EXPECTED_EVALUATION_BUILDS = 20\n","EXPECTED_EVALUATION_FAILURES = 22\n","\n","EXPECTED_RANKING_ROWS_PER_CONDITION = 6860\n","EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION = 140\n","EXPECTED_PROJECT_RUN_ROWS_PER_CONDITION = 7\n","EXPECTED_FIT_TIME_ROWS_PER_CONDITION = 4\n","\n","EXPECTED_PROJECT_RUN_ROWS = 1890\n","EXPECTED_BUILD_METRIC_ROWS = 37800\n","EXPECTED_RANKING_ROWS = 1852200\n","EXPECTED_FIT_TIME_ROWS = 1080\n","\n","EXPECTED_NESTED_COMPARISONS = 240\n","\n","\n","EXPECTED_TECHNIQUE_NAMES = (\n","    ML_TECHNIQUES\n","    + BASELINE_TECHNIQUES\n",")\n","\n","\n","REQUIRED_CONDITION_FILES = [\n","    \"_SUCCESS.json\",\n","    \"noise_manifest.parquet\",\n","    \"noise_summary.csv\",\n","    \"rankings.parquet\",\n","    \"build_metrics.parquet\",\n","    \"project_run_metrics.csv\",\n","    \"fit_times.csv\",\n","]\n","\n","\n","print(\n","    \"=== PAHO MQTT FINAL 30-SEED AUDIT ===\"\n",")\n","\n","print(\n","    \"Expected conditions:\",\n","    EXPECTED_CONDITIONS,\n",")\n","\n","print(\n","    \"Expected ranking rows:\",\n","    EXPECTED_RANKING_ROWS,\n",")\n","\n","\n","audit_start_time = time.time()\n","\n","\n","# ---------------------------------------------------------\n","# 2. Independent APFD and APFDc formulas\n","# ---------------------------------------------------------\n","\n","def audit_apfd(\n","    actual_failures,\n","):\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    number_of_tests = len(\n","        failures\n","    )\n","\n","    number_of_failures = int(\n","        failures.sum()\n","    )\n","\n","    if (\n","        number_of_tests == 0\n","        or number_of_failures == 0\n","    ):\n","        return np.nan\n","\n","    failure_ranks = (\n","        np.flatnonzero(\n","            failures == 1\n","        )\n","        + 1\n","    )\n","\n","    return float(\n","        1.0\n","        - failure_ranks.sum()\n","        / (\n","            number_of_tests\n","            * number_of_failures\n","        )\n","        + 1.0\n","        / (\n","            2.0\n","            * number_of_tests\n","        )\n","    )\n","\n","\n","def audit_apfdc(\n","    actual_failures,\n","    durations,\n","):\n","    failures = np.asarray(\n","        actual_failures,\n","        dtype=int,\n","    )\n","\n","    costs = np.asarray(\n","        durations,\n","        dtype=float,\n","    )\n","\n","    if len(failures) != len(costs):\n","        raise ValueError(\n","            \"Failure and duration lengths differ.\"\n","        )\n","\n","    if (\n","        len(failures) == 0\n","        or failures.sum() == 0\n","    ):\n","        return np.nan\n","\n","    if not np.isfinite(\n","        costs\n","    ).all():\n","        raise ValueError(\n","            \"Invalid duration encountered.\"\n","        )\n","\n","    if (\n","        costs \u003c 0\n","    ).any():\n","        raise ValueError(\n","            \"Negative duration encountered.\"\n","        )\n","\n","    total_cost = float(\n","        costs.sum()\n","    )\n","\n","    if total_cost \u003c= 0:\n","        return np.nan\n","\n","    cumulative_before = np.concatenate([\n","        np.array([0.0]),\n","        np.cumsum(costs)[:-1],\n","    ])\n","\n","    failure_mask = (\n","        failures == 1\n","    )\n","\n","    midpoint_times = (\n","        cumulative_before[\n","            failure_mask\n","        ]\n","        + 0.5\n","        * costs[\n","            failure_mask\n","        ]\n","    )\n","\n","    return float(\n","        1.0\n","        - np.mean(\n","            midpoint_times\n","            / total_cost\n","        )\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 3. Stable dataframe signatures\n","# ---------------------------------------------------------\n","\n","def dataframe_signature(\n","    dataframe,\n","    columns,\n","    sort_columns,\n","):\n","    normalized = (\n","        dataframe[\n","            columns\n","        ]\n","        .sort_values(\n","            sort_columns,\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","    hash_values = (\n","        pd.util.hash_pandas_object(\n","            normalized,\n","            index=False,\n","        )\n","        .to_numpy()\n","    )\n","\n","    return hashlib.sha256(\n","        hash_values.tobytes()\n","    ).hexdigest()\n","\n","\n","def technique_signature(\n","    rankings,\n","    technique,\n","):\n","    technique_rows = (\n","        rankings[\n","            rankings[\n","                \"Technique\"\n","            ] == technique\n","        ]\n","    )\n","\n","    return dataframe_signature(\n","        technique_rows,\n","        columns=[\n","            \"Build\",\n","            \"Test\",\n","            \"Rank\",\n","            \"Score\",\n","        ],\n","        sort_columns=[\n","            \"Build\",\n","            \"Rank\",\n","        ],\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Clean evaluation reference\n","# ---------------------------------------------------------\n","\n","evaluation_reference = (\n","    clean_evaluation_data[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"Verdict\",\n","            \"Duration\",\n","            \"build_order\",\n","        ]\n","    ]\n","    .sort_values(\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","if len(\n","    evaluation_reference\n",") != EXPECTED_EVALUATION_ROWS:\n","    raise AssertionError(\n","        \"Unexpected clean evaluation row count.\"\n","    )\n","\n","\n","if evaluation_reference[\n","    \"Build\"\n","].nunique() != EXPECTED_EVALUATION_BUILDS:\n","    raise AssertionError(\n","        \"Unexpected clean evaluation build count.\"\n","    )\n","\n","\n","if int(\n","    (\n","        evaluation_reference[\n","            \"Verdict\"\n","        ] != 0\n","    ).sum()\n",") != EXPECTED_EVALUATION_FAILURES:\n","    raise AssertionError(\n","        \"Unexpected clean evaluation failure count.\"\n","    )\n","\n","\n","allowed_failure_subtypes = set(\n","    clean_training_history.loc[\n","        clean_training_history[\n","            \"verdict\"\n","        ] != 0,\n","        \"verdict\",\n","    ]\n","    .astype(int)\n","    .unique()\n",")\n","\n","\n","allowed_noisy_verdicts = (\n","    {0}\n","    | allowed_failure_subtypes\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Audit containers\n","# ---------------------------------------------------------\n","\n","condition_audit_records = []\n","uniform_audit_records = []\n","nested_mask_records = []\n","baseline_invariance_records = []\n","\n","project_run_frames = []\n","build_metric_frames = []\n","ranking_frames = []\n","noise_summary_frames = []\n","fit_time_frames = []\n","\n","uniform_seed_signatures = {}\n","random_seed_signatures = {}\n","\n","global_identity_signatures = set()\n","global_qtf_signature = None\n","\n","zero_noise_signatures = {\n","    technique: []\n","    for technique\n","    in EXPECTED_TECHNIQUE_NAMES\n","}\n","\n","\n","metric_recalculation_mismatches = 0\n","ranking_tie_violations = 0\n","evaluation_data_mismatches = 0\n","project_run_aggregation_mismatches = 0\n","\n","processed_conditions = 0\n","\n","\n","# ---------------------------------------------------------\n","# 6. Audit all 30 × 9 conditions\n","# ---------------------------------------------------------\n","\n","for repetition_seed in REPETITION_SEEDS:\n","\n","    reference_identity_frame = None\n","    reference_uniforms = None\n","\n","    random_reference_signature = None\n","    qtf_seed_reference_signature = None\n","\n","    previous_mask = None\n","    previous_noise = None\n","\n","\n","    for noise_percent in NOISE_LEVELS:\n","\n","        condition_directory = (\n","            PROJECT_RAW_RESULTS\n","            / f\"noise_{int(noise_percent):03d}\"\n","            / f\"seed_{int(repetition_seed):02d}\"\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # 6A. Required files and completion marker\n","        # -------------------------------------------------\n","\n","        missing_files = [\n","            file_name\n","            for file_name\n","            in REQUIRED_CONDITION_FILES\n","            if not (\n","                condition_directory\n","                / file_name\n","            ).exists()\n","        ]\n","\n","        if missing_files:\n","            raise FileNotFoundError(\n","                \"Condition is missing files.\\n\"\n","                f\"Seed: {repetition_seed}\\n\"\n","                f\"Noise: {noise_percent}%\\n\"\n","                + \"\\n\".join(\n","                    missing_files\n","                )\n","            )\n","\n","\n","        with open(\n","            condition_directory\n","            / \"_SUCCESS.json\",\n","            \"r\",\n","            encoding=\"utf-8\",\n","        ) as marker_file:\n","\n","            metadata = json.load(\n","                marker_file\n","            )\n","\n","\n","        expected_marker_values = {\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"NoisePercent\":\n","                float(\n","                    noise_percent\n","                ),\n","\n","            \"RepetitionSeed\":\n","                int(\n","                    repetition_seed\n","                ),\n","\n","            \"TrainingExecutionRows\":\n","                EXPECTED_TRAINING_EXECUTION_ROWS,\n","\n","            \"TrainingModelRows\":\n","                2320,\n","\n","            \"EvaluationModelRows\":\n","                EXPECTED_EVALUATION_ROWS,\n","\n","            \"EvaluatedBuilds\":\n","                EXPECTED_EVALUATION_BUILDS,\n","\n","            \"TechniqueCount\":\n","                EXPECTED_TECHNIQUES,\n","\n","            \"RankingRows\":\n","                EXPECTED_RANKING_ROWS_PER_CONDITION,\n","\n","            \"BuildMetricRows\":\n","                EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION,\n","\n","            \"EvaluationHashUnchanged\":\n","                True,\n","\n","            \"CompletedSuccessfully\":\n","                True,\n","        }\n","\n","\n","        for marker_key, expected_value in (\n","            expected_marker_values.items()\n","        ):\n","\n","            actual_value = metadata.get(\n","                marker_key\n","            )\n","\n","            if actual_value != expected_value:\n","                raise AssertionError(\n","                    \"Completion-marker mismatch.\\n\"\n","                    f\"Seed: {repetition_seed}\\n\"\n","                    f\"Noise: {noise_percent}%\\n\"\n","                    f\"Field: {marker_key}\\n\"\n","                    f\"Expected: {expected_value}\\n\"\n","                    f\"Observed: {actual_value}\"\n","                )\n","\n","\n","        # -------------------------------------------------\n","        # 6B. Load condition outputs\n","        # -------------------------------------------------\n","\n","        manifest = pd.read_parquet(\n","            condition_directory\n","            / \"noise_manifest.parquet\"\n","        )\n","\n","        noise_summary = pd.read_csv(\n","            condition_directory\n","            / \"noise_summary.csv\"\n","        )\n","\n","        rankings = pd.read_parquet(\n","            condition_directory\n","            / \"rankings.parquet\"\n","        )\n","\n","        build_metrics = pd.read_parquet(\n","            condition_directory\n","            / \"build_metrics.parquet\"\n","        )\n","\n","        project_run_metrics = pd.read_csv(\n","            condition_directory\n","            / \"project_run_metrics.csv\"\n","        )\n","\n","        fit_times = pd.read_csv(\n","            condition_directory\n","            / \"fit_times.csv\"\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # 6C. Basic table structure\n","        # -------------------------------------------------\n","\n","        if len(manifest) != (\n","            EXPECTED_TRAINING_EXECUTION_ROWS\n","        ):\n","            raise AssertionError(\n","                \"Unexpected manifest row count.\"\n","            )\n","\n","        if len(noise_summary) != 1:\n","            raise AssertionError(\n","                \"Noise summary must contain one row.\"\n","            )\n","\n","        if len(rankings) != (\n","            EXPECTED_RANKING_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Unexpected condition ranking count.\"\n","            )\n","\n","        if len(build_metrics) != (\n","            EXPECTED_BUILD_METRIC_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Unexpected condition metric count.\"\n","            )\n","\n","        if len(project_run_metrics) != (\n","            EXPECTED_PROJECT_RUN_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Unexpected project-run count.\"\n","            )\n","\n","        if len(fit_times) != (\n","            EXPECTED_FIT_TIME_ROWS_PER_CONDITION\n","        ):\n","            raise AssertionError(\n","                \"Unexpected ML fit-time count.\"\n","            )\n","\n","\n","        for condition_frame in [\n","            rankings,\n","            build_metrics,\n","            project_run_metrics,\n","            fit_times,\n","        ]:\n","\n","            if not (\n","                condition_frame[\n","                    \"Project\"\n","                ] == PROJECT_NAME\n","            ).all():\n","                raise AssertionError(\n","                    \"Project identifier mismatch.\"\n","                )\n","\n","            if not np.isclose(\n","                pd.to_numeric(\n","                    condition_frame[\n","                        \"NoisePercent\"\n","                    ],\n","                    errors=\"raise\",\n","                ).to_numpy(\n","                    dtype=float\n","                ),\n","                float(\n","                    noise_percent\n","                ),\n","                rtol=0.0,\n","                atol=0.0,\n","            ).all():\n","                raise AssertionError(\n","                    \"Noise identifier mismatch.\"\n","                )\n","\n","            if not (\n","                pd.to_numeric(\n","                    condition_frame[\n","                        \"RepetitionSeed\"\n","                    ],\n","                    errors=\"raise\",\n","                ).astype(int)\n","                == int(\n","                    repetition_seed\n","                )\n","            ).all():\n","                raise AssertionError(\n","                    \"Seed identifier mismatch.\"\n","                )\n","\n","\n","        actual_techniques = set(\n","            rankings[\n","                \"Technique\"\n","            ].unique()\n","        )\n","\n","        if actual_techniques != set(\n","            EXPECTED_TECHNIQUE_NAMES\n","        ):\n","            raise AssertionError(\n","                \"Condition technique set is incomplete.\"\n","            )\n","\n","\n","        if set(\n","            fit_times[\n","                \"Technique\"\n","            ].unique()\n","        ) != set(\n","            ML_TECHNIQUES\n","        ):\n","            raise AssertionError(\n","                \"Fit-time technique set is invalid.\"\n","            )\n","\n","\n","        if not (\n","            fit_times[\n","                \"TrainingRows\"\n","            ] == 2320\n","        ).all():\n","            raise AssertionError(\n","                \"Fit-time training-row count mismatch.\"\n","            )\n","\n","\n","        if not (\n","            fit_times[\n","                \"ActiveFeatures\"\n","            ] == len(\n","                ACTIVE_FEATURE_COLUMNS\n","            )\n","        ).all():\n","            raise AssertionError(\n","                \"Fit-time active-feature count mismatch.\"\n","            )\n","\n","\n","        if not (\n","            fit_times[\n","                \"TrainingFailures\"\n","            ]\n","            + fit_times[\n","                \"TrainingPasses\"\n","            ]\n","            == 2320\n","        ).all():\n","            raise AssertionError(\n","                \"Training class counts do not sum \"\n","                \"to 2,320.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6D. Noise-manifest audit\n","        # -------------------------------------------------\n","\n","        manifest = (\n","            manifest\n","            .sort_values(\n","                \"NoiseRowID\",\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","        )\n","\n","\n","        expected_noise_row_ids = np.arange(\n","            EXPECTED_TRAINING_EXECUTION_ROWS\n","        )\n","\n","\n","        if not np.array_equal(\n","            manifest[\n","                \"NoiseRowID\"\n","            ].to_numpy(),\n","            expected_noise_row_ids,\n","        ):\n","            raise AssertionError(\n","                \"NoiseRowID sequence is invalid.\"\n","            )\n","\n","\n","        identity_columns = [\n","            \"NoiseRowID\",\n","            \"Build\",\n","            \"Test\",\n","            \"OriginalVerdict\",\n","        ]\n","\n","        if \"Job\" in manifest.columns:\n","            identity_columns.append(\n","                \"Job\"\n","            )\n","\n","\n","        identity_signature = (\n","            dataframe_signature(\n","                manifest,\n","                columns=identity_columns,\n","                sort_columns=[\n","                    \"NoiseRowID\",\n","                ],\n","            )\n","        )\n","\n","\n","        global_identity_signatures.add(\n","            identity_signature\n","        )\n","\n","\n","        uniforms = (\n","            manifest[\n","                \"FlipUniform\"\n","            ]\n","            .to_numpy(\n","                dtype=float\n","            )\n","        )\n","\n","\n","        flipped_mask = (\n","            manifest[\n","                \"Flipped\"\n","            ]\n","            .to_numpy(\n","                dtype=bool\n","            )\n","        )\n","\n","\n","        original_verdicts = (\n","            manifest[\n","                \"OriginalVerdict\"\n","            ]\n","            .to_numpy(\n","                dtype=int\n","            )\n","        )\n","\n","\n","        noisy_verdicts = (\n","            manifest[\n","                \"NoisyVerdict\"\n","            ]\n","            .to_numpy(\n","                dtype=int\n","            )\n","        )\n","\n","\n","        if not set(\n","            np.unique(\n","                noisy_verdicts\n","            ).tolist()\n","        ).issubset(\n","            allowed_noisy_verdicts\n","        ):\n","            raise AssertionError(\n","                \"Unexpected noisy verdict subtype.\"\n","            )\n","\n","\n","        expected_flip_mask = (\n","            uniforms\n","            \u003c float(\n","                noise_percent\n","            ) / 100.0\n","        )\n","\n","\n","        mask_matches_threshold = bool(\n","            np.array_equal(\n","                flipped_mask,\n","                expected_flip_mask,\n","            )\n","        )\n","\n","\n","        if not mask_matches_threshold:\n","            raise AssertionError(\n","                \"Flip mask does not match the \"\n","                \"common-uniform threshold.\"\n","            )\n","\n","\n","        unchanged_mask = (\n","            ~flipped_mask\n","        )\n","\n","\n","        pass_to_failure_mask = (\n","            flipped_mask\n","            \u0026 (\n","                original_verdicts == 0\n","            )\n","        )\n","\n","\n","        failure_to_pass_mask = (\n","            flipped_mask\n","            \u0026 (\n","                original_verdicts != 0\n","            )\n","        )\n","\n","\n","        if not np.array_equal(\n","            noisy_verdicts[\n","                unchanged_mask\n","            ],\n","            original_verdicts[\n","                unchanged_mask\n","            ],\n","        ):\n","            raise AssertionError(\n","                \"An unflipped verdict changed.\"\n","            )\n","\n","\n","        if (\n","            noisy_verdicts[\n","                pass_to_failure_mask\n","            ] == 0\n","        ).any():\n","            raise AssertionError(\n","                \"A flipped pass remained a pass.\"\n","            )\n","\n","\n","        if (\n","            noisy_verdicts[\n","                failure_to_pass_mask\n","            ] != 0\n","        ).any():\n","            raise AssertionError(\n","                \"A flipped failure did not become \"\n","                \"a pass.\"\n","            )\n","\n","\n","        if not np.array_equal(\n","            manifest[\n","                \"PassToFailure\"\n","            ].to_numpy(\n","                dtype=bool\n","            ),\n","            pass_to_failure_mask,\n","        ):\n","            raise AssertionError(\n","                \"PassToFailure flags are invalid.\"\n","            )\n","\n","\n","        if not np.array_equal(\n","            manifest[\n","                \"FailureToPass\"\n","            ].to_numpy(\n","                dtype=bool\n","            ),\n","            failure_to_pass_mask,\n","        ):\n","            raise AssertionError(\n","                \"FailureToPass flags are invalid.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6E. Noise-summary consistency\n","        # -------------------------------------------------\n","\n","        summary_row = (\n","            noise_summary.iloc[0]\n","        )\n","\n","\n","        if summary_row[\n","            \"Project\"\n","        ] != PROJECT_NAME:\n","            raise AssertionError(\n","                \"Noise-summary project mismatch.\"\n","            )\n","\n","\n","        if int(\n","            summary_row[\n","                \"RepetitionSeed\"\n","            ]\n","        ) != int(\n","            repetition_seed\n","        ):\n","            raise AssertionError(\n","                \"Noise-summary seed mismatch.\"\n","            )\n","\n","\n","        if not np.isclose(\n","            float(\n","                summary_row[\n","                    \"NoisePercentRequested\"\n","                ]\n","            ),\n","            float(\n","                noise_percent\n","            ),\n","            rtol=0.0,\n","            atol=0.0,\n","        ):\n","            raise AssertionError(\n","                \"Noise-summary requested level mismatch.\"\n","            )\n","\n","\n","        number_flipped = int(\n","            flipped_mask.sum()\n","        )\n","\n","        pass_to_failure_count = int(\n","            pass_to_failure_mask.sum()\n","        )\n","\n","        failure_to_pass_count = int(\n","            failure_to_pass_mask.sum()\n","        )\n","\n","\n","        realised_noise = float(\n","            100.0\n","            * number_flipped\n","            / EXPECTED_TRAINING_EXECUTION_ROWS\n","        )\n","\n","\n","        if int(\n","            summary_row[\n","                \"TrainingExecutionRows\"\n","            ]\n","        ) != EXPECTED_TRAINING_EXECUTION_ROWS:\n","            raise AssertionError(\n","                \"Noise-summary training-row mismatch.\"\n","            )\n","\n","\n","        if int(\n","            summary_row[\n","                \"NumberFlipped\"\n","            ]\n","        ) != number_flipped:\n","            raise AssertionError(\n","                \"Noise-summary flip-count mismatch.\"\n","            )\n","\n","\n","        if int(\n","            summary_row[\n","                \"PassToFailure\"\n","            ]\n","        ) != pass_to_failure_count:\n","            raise AssertionError(\n","                \"Pass-to-failure count mismatch.\"\n","            )\n","\n","\n","        if int(\n","            summary_row[\n","                \"FailureToPass\"\n","            ]\n","        ) != failure_to_pass_count:\n","            raise AssertionError(\n","                \"Failure-to-pass count mismatch.\"\n","            )\n","\n","\n","        if not np.isclose(\n","            float(\n","                summary_row[\n","                    \"RealisedNoisePercent\"\n","                ]\n","            ),\n","            realised_noise,\n","            rtol=1e-12,\n","            atol=1e-12,\n","        ):\n","            raise AssertionError(\n","                \"Realised noise percentage mismatch.\"\n","            )\n","\n","\n","        # -------------------------------------------------\n","        # 6F. Common uniforms and nested masks\n","        # -------------------------------------------------\n","\n","        if reference_identity_frame is None:\n","\n","            reference_identity_frame = (\n","                manifest[\n","                    identity_columns\n","                ].copy()\n","            )\n","\n","            reference_uniforms = (\n","                uniforms.copy()\n","            )\n","\n","            uniform_seed_signatures[\n","                int(\n","                    repetition_seed\n","                )\n","            ] = hashlib.sha256(\n","                reference_uniforms.tobytes()\n","            ).hexdigest()\n","\n","            same_identity_as_zero = True\n","            same_uniforms_as_zero = True\n","\n","\n","        else:\n","\n","            same_identity_as_zero = bool(\n","                reference_identity_frame.equals(\n","                    manifest[\n","                        identity_columns\n","                    ]\n","                )\n","            )\n","\n","            same_uniforms_as_zero = bool(\n","                np.array_equal(\n","                    reference_uniforms,\n","                    uniforms,\n","                )\n","            )\n","\n","\n","            if not same_identity_as_zero:\n","                raise AssertionError(\n","                    \"Training-row identity changed \"\n","                    \"across noise levels.\"\n","                )\n","\n","            if not same_uniforms_as_zero:\n","                raise AssertionError(\n","                    \"Uniform stream changed across \"\n","                    \"noise levels within a seed.\"\n","                )\n","\n","\n","        uniform_audit_records.append({\n","            \"Project\":\n","                PROJECT_NAME,\n","\n","            \"RepetitionSeed\":\n","                int(\n","                    repetition_seed\n","                ),\n","\n","            \"NoisePercent\":\n","                int(\n","                    noise_percent\n","                ),\n","\n","            \"SameIdentityAsZeroPercent\":\n","                same_identity_as_zero,\n","\n","            \"SameUniformStreamAsZeroPercent\":\n","                same_uniforms_as_zero,\n","\n","            \"MaskMatchesThreshold\":\n","                mask_matches_threshold,\n","\n","            \"NumberFlipped\":\n","                number_flipped,\n","\n","            \"RealisedNoisePercent\":\n","                realised_noise,\n","        })\n","\n","\n","        if previous_mask is not None:\n","\n","            lower_subset_of_upper = bool(\n","                np.all(\n","                    ~previous_mask\n","                    | flipped_mask\n","                )\n","            )\n","\n","\n","            nested_mask_records.append({\n","                \"Project\":\n","                    PROJECT_NAME,\n","\n","                \"RepetitionSeed\":\n","                    int(\n","                        repetition_seed\n","                    ),\n","\n","                \"LowerNoisePercent\":\n","                    int(\n","                        previous_noise\n","                    ),\n","\n","                \"UpperNoisePercent\":\n","                    int(\n","                        noise_percent\n","                    ),\n","\n","                \"LowerFlippedRows\":\n","                    int(\n","                        previous_mask.sum()\n","                    ),\n","\n","                \"UpperFlippedRows\":\n","                    int(\n","                        flipped_mask.sum()\n","                    ),\n","\n","                \"LowerMaskSubsetOfUpper\":\n","                    lower_subset_of_upper,\n","            })\n","\n","\n","        previous_mask = (\n","            flipped_mask.copy()\n","        )\n","\n","        previous_noise = int(\n","            noise_percent\n","        )\n","\n","\n","        # -------------------------------------------------\n","        # 6G. Evaluation data must remain identical\n","        # -------------------------------------------------\n","\n","        for technique in (\n","            EXPECTED_TECHNIQUE_NAMES\n","        ):\n","\n","            technique_rankings = (\n","                rankings[\n","                    rankings[\n","                        \"Technique\"\n","                    ] == technique\n","                ]\n","                .sort_values(\n","                    [\n","                        \"Build\",\n","                        \"Test\",\n","                    ],\n","                    kind=\"mergesort\",\n","                )\n","                .reset_index(drop=True)\n","            )\n","\n","\n","            if len(\n","                technique_rankings\n","            ) != EXPECTED_EVALUATION_ROWS:\n","\n","                evaluation_data_mismatches += 1\n","\n","                raise AssertionError(\n","                    f\"{technique} did not contain \"\n","                    \"all evaluation rows.\"\n","                )\n","\n","\n","            for identifier_column in [\n","                \"Build\",\n","                \"Test\",\n","                \"Verdict\",\n","                \"build_order\",\n","            ]:\n","\n","                if not np.array_equal(\n","                    technique_rankings[\n","                        identifier_column\n","                    ].to_numpy(),\n","                    evaluation_reference[\n","                        identifier_column\n","                    ].to_numpy(),\n","                ):\n","\n","                    evaluation_data_mismatches += 1\n","\n","                    raise AssertionError(\n","                        \"Evaluation identifier or verdict \"\n","                        f\"changed for {technique}.\"\n","                    )\n","\n","\n","            if not np.allclose(\n","                technique_rankings[\n","                    \"Duration\"\n","                ].to_numpy(\n","                    dtype=float\n","                ),\n","                evaluation_reference[\n","                    \"Duration\"\n","                ].to_numpy(\n","                    dtype=float\n","                ),\n","                rtol=0.0,\n","                atol=0.0,\n","                equal_nan=True,\n","            ):\n","\n","                evaluation_data_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"Evaluation durations changed.\"\n","                )\n","\n","\n","            expected_actual_failure = (\n","                technique_rankings[\n","                    \"Verdict\"\n","                ].to_numpy(\n","                    dtype=int\n","                ) != 0\n","            ).astype(int)\n","\n","\n","            if not np.array_equal(\n","                technique_rankings[\n","                    \"ActualFailure\"\n","                ].to_numpy(\n","                    dtype=int\n","                ),\n","                expected_actual_failure,\n","            ):\n","\n","                evaluation_data_mismatches += 1\n","\n","                raise AssertionError(\n","                    \"ActualFailure does not match Verdict.\"\n","                )\n","\n","\n","            if technique_rankings[\