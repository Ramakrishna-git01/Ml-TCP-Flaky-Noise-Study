le.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      async function convertToInteractive(key) {\n","        const element = document.querySelector('#df-b0361476-6c85-4458-90a7-1a9db2270600');\n","        const dataTable =\n","          await google.colab.kernel.invokeFunction('convertToInteractive',\n","                                                    [key], {});\n","        if (!dataTable) return;\n","\n","        const docLinkHtml = 'Like what you see? Visit the ' +\n","          '\u003ca target=\"_blank\" href=https://colab.research.google.com/notebooks/data_table.ipynb\u003edata table notebook\u003c/a\u003e'\n","          + ' to learn more about interactive tables.';\n","        element.innerHTML = '';\n","        dataTable['output_type'] = 'display_data';\n","        await google.colab.output.renderOutput(dataTable, element);\n","        const docLink = document.createElement('div');\n","        docLink.innerHTML = docLinkHtml;\n","        element.appendChild(docLink);\n","      }\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","\n","  \u003cdiv id=\"id_fdfff722-dcf0-45c9-b40b-7797f3e7781a\"\u003e\n","    \u003cstyle\u003e\n","      .colab-df-generate {\n","        background-color: #E8F0FE;\n","        border: none;\n","        border-radius: 50%;\n","        cursor: pointer;\n","        display: none;\n","        fill: #1967D2;\n","        height: 32px;\n","        padding: 0 0 0 0;\n","        width: 32px;\n","      }\n","\n","      .colab-df-generate:hover {\n","        background-color: #E2EBFA;\n","        box-shadow: 0px 1px 2px rgba(60, 64, 67, 0.3), 0px 1px 3px 1px rgba(60, 64, 67, 0.15);\n","        fill: #174EA6;\n","      }\n","\n","      [theme=dark] .colab-df-generate {\n","        background-color: #3B4455;\n","        fill: #D2E3FC;\n","      }\n","\n","      [theme=dark] .colab-df-generate:hover {\n","        background-color: #434B5C;\n","        box-shadow: 0px 1px 3px 1px rgba(0, 0, 0, 0.15);\n","        filter: drop-shadow(0px 1px 2px rgba(0, 0, 0, 0.3));\n","        fill: #FFFFFF;\n","      }\n","    \u003c/style\u003e\n","    \u003cbutton class=\"colab-df-generate\" onclick=\"generateWithVariable('feature_classification')\"\n","            title=\"Generate code using this dataframe.\"\n","            style=\"display:none;\"\u003e\n","\n","  \u003csvg xmlns=\"http://www.w3.org/2000/svg\" height=\"24px\"viewBox=\"0 0 24 24\"\n","       width=\"24px\"\u003e\n","    \u003cpath d=\"M7,19H8.4L18.45,9,17,7.55,7,17.6ZM5,21V16.75L18.45,3.32a2,2,0,0,1,2.83,0l1.4,1.43a1.91,1.91,0,0,1,.58,1.4,1.91,1.91,0,0,1-.58,1.4L9.25,21ZM18.45,9,17,7.55Zm-12,3A5.31,5.31,0,0,0,4.9,8.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\"/\u003e\n","  \u003c/svg\u003e\n","    \u003c/button\u003e\n","    \u003cscript\u003e\n","      (() =\u003e {\n","      const buttonEl =\n","        document.querySelector('#id_fdfff722-dcf0-45c9-b40b-7797f3e7781a button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () =\u003e {\n","        google.colab.notebook.generateWithVariable('feature_classification');\n","      }\n","      })();\n","    \u003c/script\u003e\n","  \u003c/div\u003e\n","\n","    \u003c/div\u003e\n","  \u003c/div\u003e\n"],"text/plain":["                          Feature                 FeatureClass  \\\n","0                         REC_Age   NOISE_INDEPENDENT_PRESERVE   \n","1              REC_LastFailureAge  VERDICT_DEPENDENT_RECOMPUTE   \n","2           REC_LastTransitionAge  VERDICT_DEPENDENT_RECOMPUTE   \n","3            REC_RecentAvgExeTime   NOISE_INDEPENDENT_PRESERVE   \n","4            REC_RecentMaxExeTime   NOISE_INDEPENDENT_PRESERVE   \n","5              REC_RecentFailRate  VERDICT_DEPENDENT_RECOMPUTE   \n","6            REC_RecentAssertRate  VERDICT_DEPENDENT_RECOMPUTE   \n","7               REC_RecentExcRate  VERDICT_DEPENDENT_RECOMPUTE   \n","8        REC_RecentTransitionRate  VERDICT_DEPENDENT_RECOMPUTE   \n","9             REC_TotalAvgExeTime   NOISE_INDEPENDENT_PRESERVE   \n","10            REC_TotalMaxExeTime   NOISE_INDEPENDENT_PRESERVE   \n","11              REC_TotalFailRate  VERDICT_DEPENDENT_RECOMPUTE   \n","12            REC_TotalAssertRate  VERDICT_DEPENDENT_RECOMPUTE   \n","13               REC_TotalExcRate  VERDICT_DEPENDENT_RECOMPUTE   \n","14        REC_TotalTransitionRate  VERDICT_DEPENDENT_RECOMPUTE   \n","15                REC_LastVerdict  VERDICT_DEPENDENT_RECOMPUTE   \n","16                REC_LastExeTime   NOISE_INDEPENDENT_PRESERVE   \n","17        REC_MaxTestFileFailRate  VERDICT_DEPENDENT_RECOMPUTE   \n","18  REC_MaxTestFileTransitionRate  VERDICT_DEPENDENT_RECOMPUTE   \n","\n","    RecomputedAfterNoise  \n","0                  False  \n","1                   True  \n","2                   True  \n","3                  False  \n","4                  False  \n","5                   True  \n","6                   True  \n","7                   True  \n","8                   True  \n","9                  False  \n","10                 False  \n","11                  True  \n","12                  True  \n","13                  True  \n","14                  True  \n","15                  True  \n","16                 False  \n","17                  True  \n","18                  True  "]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["\n","Validation report:\n","/content/drive/MyDrive/Thesis_Experiment/Results/Aggregated/thinkaurelius__titan/titan_preflight/titan_final_rec_protocol_validation.json\n","\n","SUCCESS: All 13 verdict-dependent REC features match dataset.csv across all 2,391 rows.\n","SUCCESS: All 31,083 verdict-dependent REC values match.\n","SUCCESS: The complete canonical 19-feature matrix contains 45,429 matching values and zero mismatches.\n","SUCCESS: Titan is ready for verdict-noise injection and helper validation.\n"]}],"source":["# =========================================================\n","# PROJECT 5: THINKAURELIUS TITAN\n","# FINAL CLEAN REC PROTOCOL VALIDATION\n","#\n","# Method:\n","#   1. Reconstruct the 13 verdict-dependent REC features.\n","#   2. Require exact agreement with dataset.csv.\n","#   3. Preserve the six noise-independent REC features.\n","#   4. Build and validate the complete 19-feature matrix.\n","# =========================================================\n","\n","from pathlib import Path\n","import json\n","\n","import numpy as np\n","import pandas as pd\n","from IPython.display import display\n","\n","\n","# ---------------------------------------------------------\n","# 1. Restore permanent paths\n","# ---------------------------------------------------------\n","\n","THESIS_DRIVE = Path(\n","    \"/content/drive/MyDrive/Thesis_Experiment\"\n",")\n","\n","NOTES_DRIVE = (\n","    THESIS_DRIVE\n","    / \"Notes\"\n",")\n","\n","PROJECT_NUMBER = 5\n","PROJECT_NAME = \"thinkaurelius@titan\"\n","PROJECT_SLUG = \"thinkaurelius__titan\"\n","\n","PROJECT_AGGREGATED_RESULTS = (\n","    THESIS_DRIVE\n","    / \"Results\"\n","    / \"Aggregated\"\n","    / PROJECT_SLUG\n",")\n","\n","VALIDATION_DIRECTORY = (\n","    PROJECT_AGGREGATED_RESULTS\n","    / \"titan_preflight\"\n",")\n","\n","VALIDATION_DIRECTORY.mkdir(\n","    parents=True,\n","    exist_ok=True,\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 2. Confirm required runtime variables\n","# ---------------------------------------------------------\n","\n","REQUIRED_VARIABLES = [\n","    \"builds\",\n","    \"exe_for_rec\",\n","    \"dataset_with_order\",\n","    \"clean_training_data\",\n","    \"clean_evaluation_data\",\n","    \"build_entity_map\",\n","    \"changed_entities_by_build\",\n","]\n","\n","\n","missing_variables = [\n","    variable_name\n","    for variable_name in REQUIRED_VARIABLES\n","    if variable_name not in globals()\n","]\n","\n","\n","if missing_variables:\n","    raise RuntimeError(\n","        \"Required Titan variables are missing:\\n\"\n","        + \"\\n\".join(missing_variables)\n","        + \"\\n\\nRerun the successful Titan preflight and \"\n","        \"entity-mapping cells first.\"\n","    )\n","\n","\n","if len(dataset_with_order) != 2391:\n","    raise AssertionError(\n","        \"Unexpected Titan model-ready row count.\\n\"\n","        f\"Expected: 2391\\n\"\n","        f\"Observed: {len(dataset_with_order)}\"\n","    )\n","\n","\n","print(\n","    \"=== TITAN FINAL CLEAN REC PROTOCOL VALIDATION ===\"\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 3. Freeze REC feature classification\n","# ---------------------------------------------------------\n","\n","RECENT_WINDOW = 6\n","\n","\n","REC_FEATURE_COLUMNS = [\n","    \"REC_Age\",\n","    \"REC_LastFailureAge\",\n","    \"REC_LastTransitionAge\",\n","    \"REC_RecentAvgExeTime\",\n","    \"REC_RecentMaxExeTime\",\n","    \"REC_RecentFailRate\",\n","    \"REC_RecentAssertRate\",\n","    \"REC_RecentExcRate\",\n","    \"REC_RecentTransitionRate\",\n","    \"REC_TotalAvgExeTime\",\n","    \"REC_TotalMaxExeTime\",\n","    \"REC_TotalFailRate\",\n","    \"REC_TotalAssertRate\",\n","    \"REC_TotalExcRate\",\n","    \"REC_TotalTransitionRate\",\n","    \"REC_LastVerdict\",\n","    \"REC_LastExeTime\",\n","    \"REC_MaxTestFileFailRate\",\n","    \"REC_MaxTestFileTransitionRate\",\n","]\n","\n","\n","# These 13 features can change when historical\n","# verdicts are corrupted.\n","VERDICT_DEPENDENT_REC_COLUMNS = [\n","    \"REC_LastFailureAge\",\n","    \"REC_LastTransitionAge\",\n","    \"REC_RecentFailRate\",\n","    \"REC_RecentAssertRate\",\n","    \"REC_RecentExcRate\",\n","    \"REC_RecentTransitionRate\",\n","    \"REC_TotalFailRate\",\n","    \"REC_TotalAssertRate\",\n","    \"REC_TotalExcRate\",\n","    \"REC_TotalTransitionRate\",\n","    \"REC_LastVerdict\",\n","    \"REC_MaxTestFileFailRate\",\n","    \"REC_MaxTestFileTransitionRate\",\n","]\n","\n","\n","# These six features do not change when only verdicts\n","# are corrupted.\n","NOISE_INDEPENDENT_REC_COLUMNS = [\n","    \"REC_Age\",\n","    \"REC_RecentAvgExeTime\",\n","    \"REC_RecentMaxExeTime\",\n","    \"REC_TotalAvgExeTime\",\n","    \"REC_TotalMaxExeTime\",\n","    \"REC_LastExeTime\",\n","]\n","\n","\n","if len(REC_FEATURE_COLUMNS) != 19:\n","    raise AssertionError(\n","        \"Expected exactly 19 REC features.\"\n","    )\n","\n","\n","if len(VERDICT_DEPENDENT_REC_COLUMNS) != 13:\n","    raise AssertionError(\n","        \"Expected 13 verdict-dependent REC features.\"\n","    )\n","\n","\n","if len(NOISE_INDEPENDENT_REC_COLUMNS) != 6:\n","    raise AssertionError(\n","        \"Expected six noise-independent REC features.\"\n","    )\n","\n","\n","if (\n","    set(VERDICT_DEPENDENT_REC_COLUMNS)\n","    \u0026 set(NOISE_INDEPENDENT_REC_COLUMNS)\n","):\n","    raise AssertionError(\n","        \"The REC feature groups overlap.\"\n","    )\n","\n","\n","if (\n","    set(VERDICT_DEPENDENT_REC_COLUMNS)\n","    | set(NOISE_INDEPENDENT_REC_COLUMNS)\n",") != set(REC_FEATURE_COLUMNS):\n","    raise AssertionError(\n","        \"The REC feature groups do not cover all \"\n","        \"19 REC features.\"\n","    )\n","\n","\n","missing_dataset_rec_columns = [\n","    column\n","    for column in REC_FEATURE_COLUMNS\n","    if column not in dataset_with_order.columns\n","]\n","\n","\n","if missing_dataset_rec_columns:\n","    raise KeyError(\n","        \"dataset.csv is missing REC features:\\n\"\n","        + \"\\n\".join(missing_dataset_rec_columns)\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 4. Prepare deterministic raw execution history\n","# ---------------------------------------------------------\n","\n","execution_history_clean = (\n","    exe_for_rec.copy()\n",")\n","\n","\n","required_execution_columns = [\n","    \"build\",\n","    \"test\",\n","    \"verdict\",\n","    \"duration\",\n","    \"build_order\",\n","]\n","\n","\n","missing_execution_columns = [\n","    column\n","    for column in required_execution_columns\n","    if column not in execution_history_clean.columns\n","]\n","\n","\n","if missing_execution_columns:\n","    raise KeyError(\n","        \"Execution history is missing columns:\\n\"\n","        + \"\\n\".join(missing_execution_columns)\n","    )\n","\n","\n","execution_history_clean[\n","    \"build\"\n","] = pd.to_numeric(\n","    execution_history_clean[\n","        \"build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","execution_history_clean[\n","    \"build_order\"\n","] = pd.to_numeric(\n","    execution_history_clean[\n","        \"build_order\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","execution_history_clean[\n","    \"test\"\n","] = (\n","    execution_history_clean[\n","        \"test\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","execution_history_clean[\n","    \"verdict\"\n","] = pd.to_numeric(\n","    execution_history_clean[\n","        \"verdict\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int8\")\n","\n","\n","execution_history_clean[\n","    \"duration\"\n","] = pd.to_numeric(\n","    execution_history_clean[\n","        \"duration\"\n","    ],\n","    errors=\"raise\",\n",").astype(float)\n","\n","\n","if not np.isfinite(\n","    execution_history_clean[\n","        \"duration\"\n","    ].to_numpy(dtype=float)\n",").all():\n","    raise AssertionError(\n","        \"Execution history contains non-finite durations.\"\n","    )\n","\n","\n","if (\n","    execution_history_clean[\n","        \"duration\"\n","    ] \u003c 0\n",").any():\n","    raise AssertionError(\n","        \"Execution history contains negative durations.\"\n","    )\n","\n","\n","allowed_verdicts = {\n","    0,\n","    1,\n","    2,\n","    3,\n","}\n","\n","\n","observed_verdicts = set(\n","    execution_history_clean[\n","        \"verdict\"\n","    ]\n","    .astype(int)\n","    .unique()\n","    .tolist()\n",")\n","\n","\n","if not observed_verdicts.issubset(\n","    allowed_verdicts\n","):\n","    raise AssertionError(\n","        \"Unexpected verdict values: \"\n","        f\"{sorted(observed_verdicts)}\"\n","    )\n","\n","\n","execution_history_clean[\n","    \"_OriginalExecutionOrder\"\n","] = np.arange(\n","    len(execution_history_clean),\n","    dtype=np.int64,\n",")\n","\n","\n","if \"job\" in execution_history_clean.columns:\n","    execution_history_clean[\n","        \"_JobSort\"\n","    ] = (\n","        execution_history_clean[\n","            \"job\"\n","        ].astype(str)\n","    )\n","\n","else:\n","    execution_history_clean[\n","        \"_JobSort\"\n","    ] = \"\"\n","\n","\n","execution_history_clean = (\n","    execution_history_clean\n","    .sort_values(\n","        [\n","            \"build_order\",\n","            \"_JobSort\",\n","            \"test\",\n","            \"_OriginalExecutionOrder\",\n","        ],\n","        kind=\"mergesort\",\n","    )\n","    .reset_index(drop=True)\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 5. Prepare changed-entity history\n","# ---------------------------------------------------------\n","\n","required_entity_columns = [\n","    \"Build\",\n","    \"EntityID\",\n","]\n","\n","\n","missing_entity_columns = [\n","    column\n","    for column in required_entity_columns\n","    if column not in build_entity_map.columns\n","]\n","\n","\n","if missing_entity_columns:\n","    raise KeyError(\n","        \"build_entity_map is missing columns:\\n\"\n","        + \"\\n\".join(missing_entity_columns)\n","    )\n","\n","\n","entity_build_pairs = (\n","    build_entity_map[\n","        [\n","            \"Build\",\n","            \"EntityID\",\n","        ]\n","    ]\n","    .dropna(\n","        subset=[\n","            \"Build\",\n","            \"EntityID\",\n","        ]\n","    )\n","    .drop_duplicates()\n","    .copy()\n",")\n","\n","\n","entity_build_pairs[\n","    \"Build\"\n","] = pd.to_numeric(\n","    entity_build_pairs[\n","        \"Build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","entity_build_pairs[\n","    \"EntityID\"\n","] = (\n","    entity_build_pairs[\n","        \"EntityID\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","entity_changed_builds = (\n","    entity_build_pairs\n","    .groupby(\n","        \"EntityID\",\n","        sort=False,\n","    )[\n","        \"Build\"\n","    ]\n","    .apply(\n","        lambda values:\n","            set(\n","                values.astype(int).tolist()\n","            )\n","    )\n","    .to_dict()\n",")\n","\n","\n","clean_changed_entities_by_build = {\n","    int(build_id):\n","        {\n","            str(entity_id)\n","            for entity_id\n","            in changed_entities_by_build.get(\n","                int(build_id),\n","                set(),\n","            )\n","        }\n","\n","    for build_id\n","    in builds[\n","        \"build\"\n","    ].astype(int)\n","}\n","\n","\n","if set(\n","    clean_changed_entities_by_build.keys()\n",") != set(\n","    builds[\n","        \"build\"\n","    ].astype(int)\n","):\n","    raise AssertionError(\n","        \"Changed-entity dictionary does not contain \"\n","        \"every Titan build.\"\n","    )\n","\n","\n","DOCUMENTED_UNMATCHED_BUILDS = [\n","    1724328,\n","    5889934,\n","]\n","\n","\n","for unmatched_build in DOCUMENTED_UNMATCHED_BUILDS:\n","    if clean_changed_entities_by_build[\n","        unmatched_build\n","    ] != set():\n","        raise AssertionError(\n","            \"A documented unmatched build unexpectedly \"\n","            \"contains mapped entities.\\n\"\n","            f\"Build: {unmatched_build}\"\n","        )\n","\n","\n","# ---------------------------------------------------------\n","# 6. REC calculation helpers\n","# ---------------------------------------------------------\n","\n","def calculate_rec_rates(\n","    history,\n","):\n","    \"\"\"\n","    Calculate verdict-dependent historical rates.\n","    \"\"\"\n","\n","    history_length = len(history)\n","\n","\n","    if history_length == 0:\n","        raise ValueError(\n","            \"Rate calculation requires non-empty history.\"\n","        )\n","\n","\n","    verdicts = pd.to_numeric(\n","        history[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    )\n","\n","\n","    failure_rate = float(\n","        (\n","            verdicts != 0\n","        ).sum()\n","        / history_length\n","    )\n","\n","\n","    assertion_rate = float(\n","        (\n","            verdicts == 2\n","        ).sum()\n","        / history_length\n","    )\n","\n","\n","    exception_rate = float(\n","        (\n","            verdicts == 1\n","        ).sum()\n","        / history_length\n","    )\n","\n","\n","    transition_rate = float(\n","        (\n","            history[\n","                \"transition\"\n","            ] == 1\n","        ).sum()\n","        / history_length\n","    )\n","\n","\n","    return (\n","        failure_rate,\n","        assertion_rate,\n","        exception_rate,\n","        transition_rate,\n","    )\n","\n","\n","def calculate_max_test_file_rate(\n","    history,\n","    target_column,\n","    current_changed_entities,\n","):\n","    \"\"\"\n","    Reproduce the changed-test-file failure or\n","    transition overlap rate.\n","    \"\"\"\n","\n","    if target_column not in {\n","        \"verdict\",\n","        \"transition\",\n","    }:\n","        raise ValueError(\n","            \"target_column must be verdict or transition.\"\n","        )\n","\n","\n","    target_builds = (\n","        history.loc[\n","            history[\n","                target_column\n","            ] \u003e 0,\n","            \"build\",\n","        ]\n","        .drop_duplicates()\n","        .astype(int)\n","        .tolist()\n","    )\n","\n","\n","    if len(target_builds) == 0:\n","        return -1.0\n","\n","\n","    target_build_set = set(\n","        target_builds\n","    )\n","\n","\n","    maximum_overlap = 0\n","\n","\n","    for entity_id in current_changed_entities:\n","        changed_builds = (\n","            entity_changed_builds.get(\n","                str(entity_id),\n","                set(),\n","            )\n","        )\n","\n","\n","        overlap = len(\n","            changed_builds.intersection(\n","                target_build_set\n","            )\n","        )\n","\n","\n","        maximum_overlap = max(\n","            maximum_overlap,\n","            overlap,\n","        )\n","\n","\n","    if maximum_overlap == 0:\n","        return 0.0\n","\n","\n","    return float(\n","        maximum_overlap\n","        / len(target_builds)\n","    )\n","\n","\n","# Compatibility alias for later experiment cells.\n","calculate_rates = calculate_rec_rates\n","\n","\n","# ---------------------------------------------------------\n","# 7. Reconstruct the 13 verdict-dependent features\n","# ---------------------------------------------------------\n","\n","def reconstruct_verdict_dependent_rec_features(\n","    execution_history,\n","    requested_rows,\n","    recent_window=6,\n","):\n","    \"\"\"\n","    Reconstruct the 13 REC features affected by\n","    historical verdict corruption.\n","    \"\"\"\n","\n","    if recent_window \u003c= 0:\n","        raise ValueError(\n","            \"recent_window must be positive.\"\n","        )\n","\n","\n","    history_input = (\n","        execution_history.copy()\n","    )\n","\n","\n","    history_input[\n","        \"build\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    history_input[\n","        \"build_order\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"build_order\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    history_input[\n","        \"test\"\n","    ] = (\n","        history_input[\n","            \"test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    history_input[\n","        \"verdict\"\n","    ] = pd.to_numeric(\n","        history_input[\n","            \"verdict\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int8\")\n","\n","\n","    if \"_OriginalExecutionOrder\" not in (\n","        history_input.columns\n","    ):\n","        history_input[\n","            \"_OriginalExecutionOrder\"\n","        ] = np.arange(\n","            len(history_input),\n","            dtype=np.int64,\n","        )\n","\n","\n","    if \"_JobSort\" not in history_input.columns:\n","        if \"job\" in history_input.columns:\n","            history_input[\n","                \"_JobSort\"\n","            ] = (\n","                history_input[\n","                    \"job\"\n","                ].astype(str)\n","            )\n","\n","        else:\n","            history_input[\n","                \"_JobSort\"\n","            ] = \"\"\n","\n","\n","    history_input = (\n","        history_input\n","        .sort_values(\n","            [\n","                \"build_order\",\n","                \"_JobSort\",\n","                \"test\",\n","                \"_OriginalExecutionOrder\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    requested = (\n","        requested_rows[\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ]\n","        ]\n","        .copy()\n","    )\n","\n","\n","    requested[\n","        \"Build\"\n","    ] = pd.to_numeric(\n","        requested[\n","            \"Build\"\n","        ],\n","        errors=\"raise\",\n","    ).astype(\"int64\")\n","\n","\n","    requested[\n","        \"Test\"\n","    ] = (\n","        requested[\n","            \"Test\"\n","        ]\n","        .astype(str)\n","    )\n","\n","\n","    if requested.duplicated(\n","        subset=[\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ).any():\n","        raise AssertionError(\n","            \"Requested Build-Test pairs contain \"\n","            \"duplicates.\"\n","        )\n","\n","\n","    requested_pairs = set(\n","        zip(\n","            requested[\n","                \"Build\"\n","            ].astype(int),\n","\n","            requested[\n","                \"Test\"\n","            ].astype(str),\n","        )\n","    )\n","\n","\n","    reconstructed_records = []\n","    reconstructed_pairs = set()\n","\n","\n","    for test_id, test_history in (\n","        history_input.groupby(\n","            \"test\",\n","            sort=False,\n","        )\n","    ):\n","        test_id = str(\n","            test_id\n","        )\n","\n","\n","        test_history = (\n","            test_history\n","            .sort_values(\n","                [\n","                    \"build_order\",\n","                    \"_JobSort\",\n","                    \"_OriginalExecutionOrder\",\n","                ],\n","                kind=\"mergesort\",\n","            )\n","            .reset_index(drop=True)\n","            .copy()\n","        )\n","\n","\n","        test_history[\n","            \"transition\"\n","        ] = (\n","            test_history[\n","                \"verdict\"\n","            ]\n","            .diff()\n","            .fillna(0)\n","            .ne(0)\n","            .astype(int)\n","        )\n","\n","\n","        for current_position in range(\n","            len(test_history)\n","        ):\n","            current_row = (\n","                test_history.iloc[\n","                    current_position\n","                ]\n","            )\n","\n","\n","            current_build = int(\n","                current_row[\n","                    \"build\"\n","                ]\n","            )\n","\n","\n","            pair = (\n","                current_build,\n","                test_id,\n","            )\n","\n","\n","            if pair not in requested_pairs:\n","                continue\n","\n","\n","            if pair in reconstructed_pairs:\n","                raise AssertionError(\n","                    \"Multiple execution rows were found \"\n","                    \"for one requested Build-Test pair.\\n\"\n","                    f\"Pair: {pair}\"\n","                )\n","\n","\n","            reconstructed_pairs.add(\n","                pair\n","            )\n","\n","\n","            history = (\n","                test_history\n","                .iloc[\n","                    :current_position\n","                ]\n","                .copy()\n","                .reset_index(drop=True)\n","            )\n","\n","\n","            record = {\n","                \"Build\":\n","                    current_build,\n","\n","                \"Test\":\n","                    test_id,\n","            }\n","\n","\n","            if history.empty:\n","                for feature in (\n","                    VERDICT_DEPENDENT_REC_COLUMNS\n","                ):\n","                    record[\n","                        feature\n","                    ] = -1.0\n","\n","\n","                reconstructed_records.append(\n","                    record\n","                )\n","\n","                continue\n","\n","\n","            recent_history = (\n","                history\n","                .tail(\n","                    recent_window\n","                )\n","                .copy()\n","            )\n","\n","\n","            failure_positions = np.flatnonzero(\n","                history[\n","                    \"verdict\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","\n","            if len(failure_positions) == 0:\n","                last_failure_age = -1\n","\n","            else:\n","                last_failure_age = int(\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        failure_positions[-1]\n","                    )\n","                )\n","\n","\n","            transition_positions = np.flatnonzero(\n","                history[\n","                    \"transition\"\n","                ].to_numpy() \u003e 0\n","            )\n","\n","\n","            if len(transition_positions) == 0:\n","                last_transition_age = -1\n","\n","            else:\n","                last_transition_age = int(\n","                    len(history)\n","                    - 1\n","                    - int(\n","                        transition_positions[-1]\n","                    )\n","                )\n","\n","\n","            (\n","                recent_fail_rate,\n","                recent_assert_rate,\n","                recent_exception_rate,\n","                recent_transition_rate,\n","            ) = calculate_rec_rates(\n","                recent_history\n","            )\n","\n","\n","            (\n","                total_fail_rate,\n","                total_assert_rate,\n","                total_exception_rate,\n","                total_transition_rate,\n","            ) = calculate_rec_rates(\n","                history\n","            )\n","\n","\n","            current_changed_entities = (\n","                clean_changed_entities_by_build.get(\n","                    current_build,\n","                    set(),\n","                )\n","            )\n","\n","\n","            record.update({\n","                \"REC_LastFailureAge\":\n","                    float(\n","                        last_failure_age\n","                    ),\n","\n","                \"REC_LastTransitionAge\":\n","                    float(\n","                        last_transition_age\n","                    ),\n","\n","                \"REC_RecentFailRate\":\n","                    recent_fail_rate,\n","\n","                \"REC_RecentAssertRate\":\n","                    recent_assert_rate,\n","\n","                \"REC_RecentExcRate\":\n","                    recent_exception_rate,\n","\n","                \"REC_RecentTransitionRate\":\n","                    recent_transition_rate,\n","\n","                \"REC_TotalFailRate\":\n","                    total_fail_rate,\n","\n","                \"REC_TotalAssertRate\":\n","                    total_assert_rate,\n","\n","                \"REC_TotalExcRate\":\n","                    total_exception_rate,\n","\n","                \"REC_TotalTransitionRate\":\n","                    total_transition_rate,\n","\n","                \"REC_LastVerdict\":\n","                    float(\n","                        recent_history.iloc[-1][\n","                            \"verdict\"\n","                        ]\n","                    ),\n","\n","                \"REC_MaxTestFileFailRate\":\n","                    calculate_max_test_file_rate(\n","                        history=history,\n","                        target_column=\"verdict\",\n","                        current_changed_entities=(\n","                            current_changed_entities\n","                        ),\n","                    ),\n","\n","                \"REC_MaxTestFileTransitionRate\":\n","                    calculate_max_test_file_rate(\n","                        history=history,\n","                        target_column=\"transition\",\n","                        current_changed_entities=(\n","                            current_changed_entities\n","                        ),\n","                    ),\n","            })\n","\n","\n","            reconstructed_records.append(\n","                record\n","            )\n","\n","\n","    reconstructed = pd.DataFrame(\n","        reconstructed_records\n","    )\n","\n","\n","    expected_columns = (\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","        + VERDICT_DEPENDENT_REC_COLUMNS\n","    )\n","\n","\n","    if reconstructed.empty:\n","        reconstructed = pd.DataFrame(\n","            columns=expected_columns\n","        )\n","\n","\n","    missing_columns = [\n","        column\n","        for column in expected_columns\n","        if column not in reconstructed.columns\n","    ]\n","\n","\n","    if missing_columns:\n","        raise AssertionError(\n","            \"Reconstruction is missing columns:\\n\"\n","            + \"\\n\".join(missing_columns)\n","        )\n","\n","\n","    reconstructed = (\n","        reconstructed[\n","            expected_columns\n","        ]\n","        .sort_values(\n","            [\n","                \"Build\",\n","                \"Test\",\n","            ],\n","            kind=\"mergesort\",\n","        )\n","        .reset_index(drop=True)\n","    )\n","\n","\n","    output_pairs = set(\n","        zip(\n","            reconstructed[\n","                \"Build\"\n","            ].astype(int),\n","\n","            reconstructed[\n","                \"Test\"\n","            ].astype(str),\n","        )\n","    )\n","\n","\n","    missing_pairs = sorted(\n","        requested_pairs\n","        - output_pairs\n","    )\n","\n","\n","    extra_pairs = sorted(\n","        output_pairs\n","        - requested_pairs\n","    )\n","\n","\n","    if missing_pairs:\n","        raise AssertionError(\n","            \"Some requested Build-Test pairs were not \"\n","            \"reconstructed.\\n\"\n","            f\"Examples: {missing_pairs[:10]}\"\n","        )\n","\n","\n","    if extra_pairs:\n","        raise AssertionError(\n","            \"Unexpected Build-Test pairs were \"\n","            \"reconstructed.\\n\"\n","            f\"Examples: {extra_pairs[:10]}\"\n","        )\n","\n","\n","    return reconstructed\n","\n","\n","# ---------------------------------------------------------\n","# 8. Clean reconstruction\n","# ---------------------------------------------------------\n","\n","requested_clean_rows = (\n","    dataset_with_order[\n","        [\n","            \"Build\",\n","            \"Test\",\n","        ]\n","    ]\n","    .copy()\n",")\n","\n","\n","clean_verdict_rec_reconstructed = (\n","    reconstruct_verdict_dependent_rec_features(\n","        execution_history=(\n","            execution_history_clean\n","        ),\n","\n","        requested_rows=(\n","            requested_clean_rows\n","        ),\n","\n","        recent_window=(\n","            RECENT_WINDOW\n","        ),\n","    )\n",")\n","\n","\n","if len(clean_verdict_rec_reconstructed) != 2391:\n","    raise AssertionError(\n","        \"Verdict-dependent reconstruction row mismatch.\\n\"\n","        f\"Expected: 2391\\n\"\n","        \"Observed: \"\n","        f\"{len(clean_verdict_rec_reconstructed)}\"\n","    )\n","\n","\n","# ---------------------------------------------------------\n","# 9. Compare the 13 recomputed features\n","# ---------------------------------------------------------\n","\n","original_verdict_rec = (\n","    dataset_with_order[\n","        [\n","            \"Build\",\n","            \"Test\",\n","            \"partition\",\n","        ]\n","        + VERDICT_DEPENDENT_REC_COLUMNS\n","    ]\n","    .copy()\n",")\n","\n","\n","original_verdict_rec[\n","    \"Build\"\n","] = pd.to_numeric(\n","    original_verdict_rec[\n","        \"Build\"\n","    ],\n","    errors=\"raise\",\n",").astype(\"int64\")\n","\n","\n","original_verdict_rec[\n","    \"Test\"\n","] = (\n","    original_verdict_rec[\n","        \"Test\"\n","    ]\n","    .astype(str)\n",")\n","\n","\n","verdict_comparison = (\n","    original_verdict_rec\n","    .merge(\n","        clean_verdict_rec_reconstructed,\n","        on=[\n","            \"Build\",\n","            \"Test\",\n","        ],\n","        how=\"left\",\n","        validate=\"one_to_one\",\n","        suffixes=(\n","            \"_Original\",\n","            \"_Reconstructed\",\n","        ),\n","        indicator=True,\n","    )\n",")\n","\n","\n","if not (\n","    verdict_comparison[\n","        \"_merge\"\n","    ] == \"both\"\n",").all():\n","    raise AssertionError(\n","        \"Not every model-ready row was reconstructed.\"\n","    )\n","\n","\n","feature_comparison_records = []\n","mismatch_records = []\n","\n","\n","for feature in VERDICT_DEPENDENT_REC_COLUMNS:\n","    original_values = pd.to_numeric(\n","        verdict_comparison[\n","            f\"{feature}_Original\"\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","\n","    reconstructed_values = pd.to_numeric(\n","        verdict_comparison[\n","            f\"{feature}_Reconstructed\"\n","        ],\n","        errors=\"coerce\",\n","    ).to_numpy(dtype=float)\n","\n","\n","    matches = np.isclose(\n","        original_values,\n","        reconstructed_values,\n","        rtol=1e-9,\n","        atol=1e-9,\n","        equal_nan=True,\n","    )\n","\n","\n","    absolute_difference = np.abs(\n","        original_values\n","        - reconstructed_values\n","    )\n","\n","\n","    finite_differences = (\n","        absolute_difference[\n","            np.isfinite(\n","                absolute_difference\n","            )\n","        ]\n","    )\n","\n","\n","    feature_comparison_records.append({\n","        \"Feature\":\n","            feature,\n","\n","        \"RowsCompared\":\n","            int(\n","                len(matches)\n","            ),\n","\n","        \"MatchingRows\":\n","            int(\n","                matches.sum()\n","            ),\n","\n","        \"MismatchingRows\":\n","            int(\n","                (\n","                    ~matches\n","                ).sum()\n","            ),\n","\n","        \"MaximumAbsoluteDifference\":\n","            (\n","                float(\n","                    finite_differences.max()\n","                )\n","                if len(\n","                    finite_differences\n","                ) \u003e 0\n","                else 0.0\n","            ),\n","    })\n","\n","\n","    for mismatch_position in np.flatnonzero(\n","        ~matches\n","    ):\n","        mismatch_records.append({\n","            \"Feature\":\n","                feature,\n","\n","            \"Build\":\n","                int(\n","                    verdict_comparison.iloc[\n","                        mismatch_position\n","                    ][\n","                        \"Build\"\n","                    ]\n","                ),\n","\n","            \"Test\":\n","                str(\n","                    verdict_comparison.iloc[\n","                        mismatch_position\n","                    ][\n","                        \"Test\"\n","                    ]\n","                ),\n","\n","            \"OriginalValue\":\n","                float(\n","                    original_values[\n","                        mismatch_position\n","                    ]\n","                ),\n","\n","            \"ReconstructedValue\":\n","                float(\n","                    reconstructed_values[\n","                        mismatch_position\n","                    ]\n","                ),\n","        })\n","\n","\n","verdict_feature_comparison = pd.DataFrame(\n","    feature_comparison_records\n",")\n","\n","\n","verdict_mismatch_details = pd.DataFrame(\n","    mismatch_records,\n","    columns=[\n","        \"Feature\",\n","        \"Build\",\n","        \"Test\",\n","        \"OriginalValue\",\n","        \"ReconstructedValue\",\n","    ],\n",")\n","\n","\n","total_verdict_values_compared = int(\n","    2391\n","    * len(\n","        VERDICT_DEPENDENT_REC_COLUMNS\n","    )\n",")\n","\n","\n","total_verdict_mismatches = int(\n","    verdict_feature_comparison[\n","        \"MismatchingRows\"\n","    ].sum()\n",")\n","\n","\n","features_with_verdict_mismatches = int(\n","    (\n","        verdict_feature_comparison[\n","            \"MismatchingRows\"\n","        ] \u003e 0\n","    ).sum()\n",")\n","\n","\n","# ---------------------------------------------------------\n","# 10. Partition-specific validation\n","# ---------------------------------------------------------\n","\n","partition_validation_records = []\n","\n","\n","for partition_name, partition_rows in (\n","    verdict_comparison.groupby(\n","        \"partition\",\n","        sort=False,\n","    )\n","):\n","    partition_mismatches = 0\n","\n","\n","    for feature in VERDICT_DEPENDENT_REC_COLUMNS:\n","        original_values = pd.to_numeric(\n","            partition_rows[\n","                f\"{feature}_Original\"\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        reconstructed_values = pd.to_numeric(\n","            partition_rows[\n","                f\"{feature}_Reconstructed\"\n","            ],\n","            errors=\"coerce\",\n","        ).to_numpy(dtype=float)\n","\n","\n","        partition_mismatches += int(\n","            (\n","                ~np.isclose(\n","                    original_values,\n","                    reconstructed_values,\n","                    rtol=1e-9,\n","                    atol=1e-9,\n","                    equal_nan=True,\n","                )\n","            ).sum()\n","        )\n","\n","\n","    partition_validation_records.append({\n","        \"Partition\":\n","            str(\n","                partition_name\n","            ),\n","\n","        \"Rows\":\n","            int(\n","                len(partition_rows)\n","            ),\n","\n","        \"FeatureValuesCompared\":\n","            int(\n","                len(partition_rows)\n","                * len(\n","                    VERDICT_DEPENDENT_REC_COLUMNS\n","                )\n","            ),\n","\n","        \"MismatchingFeatureValues\":\n","            